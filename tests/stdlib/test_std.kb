mod tests.stdlib.test_std;
mod test.std_demo;

use std.ascii.*;
use std.str.*;

use std.io.print;
use std.io.println;
use std.io.write_file;
use std.io.append_file;
use std.io.read_file;
use std.io.file_exists;

use std.mem.arena.Arena;

use std.collections.list.List;

use std.collections.hash_map.HashMap;
use std.collections.hash_set.HashSet;

use std.collections.string_builder.StringBuilder;

fn test_ascii(): bool {
	if (!'5'.is_digit()) return false;
	if ('a'.is_digit()) return false;
	if (!'Z'.is_alpha()) return false;
	if (!'9'.is_alphanumeric()) return false;
	if (!' '.is_whitespace()) return false;
	if (!'f'.is_hex_digit()) return false;
	if ('G'.to_lower() != 'g') return false;
	if ('m'.to_upper() != 'M') return false;
	return true;
}

fn test_arena(): bool {
	var arena: Arena = Arena(1024UZ);
	defer arena.delete();
	val p1: &u8 = arena.alloc_bytes(64UZ, 8UZ);
	val p2: &u8 = arena.alloc_bytes(128UZ, 8UZ);
	if (p1 == null || p2 == null) return false;
	arena.reset();
	val p3: &u8 = arena.alloc_bytes(32UZ, 8UZ);
	if (p3 == null) return false;
	return true;
}

fn test_collections(): bool {
	// 1. List
	var list: List<i32> = List<i32>();
	defer list.delete();
	list += 10;
	list += 20;
	list += 30;
	if (list.len != 3UZ) return false;
	if (list[1UZ] != 20) return false;
	// test insert
	list.insert(1UZ, 15); // [10, 15, 20, 30]
	if (list.len != 4UZ || list[1UZ] != 15 || list[2UZ] != 20) return false;

	// test remove_at
	val rem: i32 = list.remove_at(1UZ); // [10, 20, 30]
	if (rem != 15 || list.len != 3UZ || list[1UZ] != 20) return false;

	// test clone
	{
		var cloned = list.clone();
		defer cloned.delete();
		if (cloned.len != 3UZ || cloned[2UZ] != 30) return false;
	}

	val pop_val: i32 = list.pop();
	if (pop_val != 30 || list.len != 2UZ) return false;

	// test extend, in/contains, index_of, remove, reverse, pop_or
	{
		var ext_list = List<i32>();
		defer ext_list.delete();
		ext_list += 40;
		ext_list += 50;
		list.extend(ext_list); // [10, 20, 40, 50]
		if (list.len != 4UZ || !(40 in list) || list.contains(99)) return false;
		if (list.index_of(40) != 2 || list.index_of(99) != -1) return false;
		if (!list.remove(40) || (40 in list) || list.len != 3UZ) return false;
		list.reverse(); // [50, 20, 10]
		if (list[0UZ] != 50 || list[2UZ] != 10) return false;
		if (list.pop_or(0) != 10) return false;
	}

	// 2. HashMap
	var map: HashMap<str, i32> = HashMap<str, i32>();
	defer map.delete();
	if (!map.empty() || map.count() != 0UZ) return false;

	map["first"] = 100;
	map["second"] = 200; // tests map[k] = v (set)
	map["third"] = 300;

	if (map.empty() || map.len != 3UZ || map.count() != 3UZ) return false;
	if (!("second" in map) || !("first" in map) || !("third" in map)) return false;
	if ("not_found" in map) return false;

	// test get and get_or
	val p_first = map["first"];
	if (p_first == null || *p_first != 100) return false;
	val p_sec = map["second"];
	if (p_sec == null || *p_sec != 200) return false;
	if (map["missing"] != null) return false;

	if (map.get_or("first", 0) != 100) return false;
	if (map.get_or("third", 0) != 300) return false;
	if (map.get_or("missing", -1) != -1) return false;

	// test overwrite via indexing
	map["first"] = 101;
	if (map.len != 3UZ) return false;
	val p_first_upd = map["first"];
	if (p_first_upd == null || *p_first_upd != 101) return false;

	// test keys and values
	{
		val all_keys = map.keys();
		defer all_keys.delete();
		if (all_keys.len != 3UZ) return false;
	}

	{
		val all_vals = map.values();
		defer all_vals.delete();
		if (all_vals.len != 3UZ) return false;
	}

	// test remove
	if (!map.remove("second")) return false;
	if ("second" in map) return false;
	if (map.len != 2UZ) return false;
	if (map.remove("second")) return false; // already removed
	if (map.remove("nonexistent")) return false;

	// test clear
	map.clear();
	if (!map.empty() || map.len != 0UZ) return false;
	if ("first" in map || "third" in map) return false;

	// 3. StringBuilder
	{
		var sb: StringBuilder = StringBuilder();
		defer sb.delete();
		if (!sb.empty()) return false;
		sb += "Kobel";
		if (sb.empty()) return false;
		if (sb.last_char() != 'l') return false;
		sb += ' ';
		sb += "Compiler v";
		sb += 1;
		sb += " ";
		sb += true;
		sb.append_line("!");
		val result_str: str = sb.to_str();
		if (result_str != "Kobel Compiler v1 true!\n") return false;
		if (sb.last_char() != '\n') return false;
	}

	// 4. append_repeat / append_escaped
	{
		var sb2: StringBuilder = StringBuilder();
		defer sb2.delete();
		sb2.append_repeat(' ', 3UZ);
		sb2 += "x";
		sb2.append_escaped("a\"b\\c\nd");
		if (sb2.to_str() != "   xa\\\"b\\\\c\\nd") return false;
		sb2.clear();
		sb2.append_repeat('x', 100UZ);
		if (sb2.len != 100UZ || sb2.last_char() != 'x') return false;
	}

	// 5. HashSet
	{
		var set: HashSet = HashSet();
		defer set.delete();
		if (!set.empty() || set.count() != 0UZ) return false;
		if (!set.add("apple")) return false;
		if (!set.add("banana")) return false;
		if (set.add("apple")) return false;
		if (set.len != 2UZ || !("apple" in set) || !("banana" in set)) return false;
		if ("orange" in set) return false;
		{
			val set_list = set.to_list();
			defer set_list.delete();
			if (set_list.len != 2UZ) return false;
		}
		if (!set.remove("apple")) return false;
		if ("apple" in set) return false;
		if (set.len != 1UZ) return false;
		set.clear();
		if (!set.empty() || set.len != 0UZ) return false;
	}

	// 6. str.replace_char & str.join
	val orig_path = "a.b.c";
	if (orig_path.replace_char('.', '/') != "a/b/c") return false;
	{
		var parts = List<str>();
		defer parts.delete();
		parts += "hello";
		parts += "world";
		parts += "kobel";
		val joined = ", ".join(parts);
		if (joined != "hello, world, kobel") return false;
		val dot_joined = ".".join(parts);
		if (dot_joined != "hello.world.kobel") return false;
	}

	return true;
}

fn test_io(): bool {
	val tmp_file: str = "build/tmp_std_test.txt";
	val content: str = "Testing Kobel standard library I/O!";
	val written: bool = write_file(tmp_file, content);
	if (!written) return false;
	if (!file_exists(tmp_file)) return false;
	if (file_exists("non_existent_file_xyz_123.txt")) return false;

	val extra: str = "\nAppended line.";
	val appended: bool = append_file(tmp_file, extra);
	if (!appended) return false;

	val read_back: str = read_file(tmp_file);
	if (read_back != "Testing Kobel standard library I/O!\nAppended line.") return false;

	return true;
}

fn test_str(): bool {
	val s: str = "Hello, Kobel World!";
	if (s.empty()) return false;
	if (!"".empty()) return false;
	if (s.empty()) return false;
	if (!"".empty()) return false;

	if (!s.starts_with("Hello")) return false;
	if (s.starts_with("World")) return false;

	if (!s.ends_with("World!")) return false;
	if (s.ends_with("Hello")) return false;

	if ("Kobel" !in s) return false;
	if ("Python" in s) return false;

	if (s.index_of("Kobel") != 7) return false;
	if (s.index_of("Missing") != -1) return false;

	if (s.strip_suffix(7UZ) != "Hello, Kobel") return false;

	if ("ab".repeat(3UZ) != "ababab") return false;
	if ("ab".repeat(0UZ) != "") return false;
	if (s.repeat(1UZ) != s) return false;
	if ("".repeat(4UZ) != "") return false;

	return true;
}

fn main(): i32 {
	if (!test_ascii()) {
		println("FAIL: test_ascii");
		return 1;
	}
	println("PASS: std.ascii");

	if (!test_str()) {
		println("FAIL: test_str");
		return 1;
	}
	println("PASS: std.str");

	if (!test_arena()) {
		println("FAIL: test_arena");
		return 1;
	}
	println("PASS: std.mem.arena");

	if (!test_collections()) {
		println("FAIL: test_collections");
		return 1;
	}
	println("PASS: std.collections (List, HashMap, StringBuilder)");

	if (!test_io()) {
		println("FAIL: test_io");
		return 1;
	}
	println("PASS: std.io");

	println("=== ALL STANDARD LIBRARY TESTS PASSED! ===");
	return 0;
}

