mod tests.stdlib.test_std;

use std.ascii.*;
use std.string.*;

use std.io.print;
use std.io.println;






use std.memory.*;

use std.collections.List;

use std.collections.HashMap;
use std.collections.HashSet;

use std.filesystem.Path;
use std.filesystem.File;
use std.system.System;
use std.process.Process;




fn test_ascii(): bool {
	if (!'5'.is_digit()) return false;
	if ('a'.is_digit()) return false;
	if (!'Z'.is_alpha()) return false;
	if (!'9'.is_alphanumeric()) return false;
	if (!' '.is_whitespace()) return false;
	if (!'f'.is_hex_digit()) return false;
	if ('G'.to_lower() != 'g') return false;
	if ('m'.to_upper() != 'M') return false;
	return true;
}

fn test_arena(): bool {
	var arena: Arena = Arena(1024);
	defer arena.free();
	val p1: &u8 = arena.alloc_bytes(64, 8);
	val p2: &u8 = arena.alloc_bytes(128, 8);
	if (p1 == null || p2 == null) return false;
	val p_val = arena.create_val<i32>(42);
	if (p_val.read() != 42) return false;
	arena.reset();
	val p3: &u8 = arena.alloc_bytes(32, 8);
	if (p3 == null) return false;

	// Heap create / free
	val h_val = Heap.create_val<i32>(100);
	if (h_val.read() != 100) return false;
	Heap.free(h_val);

	val arr = Heap.alloc<i32>(5);
	arr[0] = 10;
	arr[4] = 50;
	if (arr[0] != 10 || arr[4] != 50) return false;
	val arr2 = Heap.resize<i32>(arr, 10);
	if (arr2[0] != 10 || arr2[4] != 50) return false;
	Heap.free(arr2);

	return true;
}

fn test_collections(): bool {
	// 1. List
	var list: List<i32> = List<i32>();
	defer list.free();
	list += 10;
	list += 20;
	list += 30;
	if (list.len != 3) return false;
	if (list[1] != 20) return false;
	// test insert
	list.insert(1, 15); // [10, 15, 20, 30]
	if (list.len != 4 || list[1] != 15 || list[2] != 20) return false;

	// test remove_at
	val rem: i32 = list.remove_at(1); // [10, 20, 30]
	if (rem != 15 || list.len != 3 || list[1] != 20) return false;

	// test clone
	{
		var cloned = list.clone();
		defer cloned.free();
		if (cloned.len != 3 || cloned[2] != 30) return false;
	}

	val pop_val: i32 = list.pop();
	if (pop_val != 30 || list.len != 2) return false;

	// test extend, in/contains, index_of, remove, reverse, pop_or, lambda methods
	{
		var ext_list = List<i32>();
		defer ext_list.free();
		ext_list += 40;
		ext_list += 50;
		list.extend(ext_list); // [10, 20, 40, 50]
		if (list.len != 4 || !(40 in list) || list.contains(99)) return false;
		if (list.index_of(40) != 2 || list.index_of(99) != -1) return false;
		if (list.index_where { x -> x >= 35 } != 2) return false;
		if (list.last_index_where { x -> x >= 20 } != 3) return false;
		if (list.first_or(-1) { x -> x > 25 } != 40) return false;
		if (list.first_or(-1) { x -> x > 100 } != -1) return false;
		val p40 = list.find_ptr { x -> x == 40 };
		if (p40 == null || p40.read() != 40) return false;
		if (list.find_ptr { x -> x == 999 } != null) return false;
		if (!list.remove(40) || (40 in list) || list.len != 3) return false;
		list.reverse(); // [50, 20, 10]
		if (list[0] != 50 || list[2] != 10) return false;
		if (list.pop_or(0) != 10) return false;

		var rlist = List<i32>();
		defer rlist.free();
		for (v in 1..6) rlist += v;
		if (rlist.remove_where { x -> x % 2 == 0 } != 3 || rlist.len != 3) return false;
		if (rlist[0] != 1 || rlist[1] != 3 || rlist[2] != 5) return false;
		if (rlist.retain { x -> x > 1 } != 1 || rlist.len != 2) return false;
		if (rlist[0] != 3 || rlist[1] != 5) return false;
	}

	// 2. HashMap
	var map: HashMap<str, i32> = HashMap<str, i32>();
	defer map.free();
	if (!map.empty() || map.count() != 0) return false;

	map["first"] = 100;
	map["second"] = 200; // tests map[k] = v (set)
	map["third"] = 300;

	if (map.empty() || map.len != 3 || map.count() != 3) return false;
	if (!("second" in map) || !("first" in map) || !("third" in map)) return false;
	if ("not_found" in map) return false;

	// test get and get_or
	val p_first = map["first"];
	if (p_first == null || *p_first != 100) return false;
	val p_sec = map["second"];
	if (p_sec == null || *p_sec != 200) return false;
	if (map["missing"] != null) return false;

	if (map.get_or("first", 0) != 100) return false;
	if (map.get_or("third", 0) != 300) return false;
	if (map.get_or("missing", -1) != -1) return false;

	// test overwrite via indexing
	map["first"] = 101;
	if (map.len != 3) return false;
	val p_first_upd = map["first"];
	if (p_first_upd == null || *p_first_upd != 101) return false;

	// test keys and values
	{
		val all_keys = map.keys();
		defer all_keys.free();
		if (all_keys.len != 3) return false;
	}

	{
		val all_vals = map.values();
		defer all_vals.free();
		if (all_vals.len != 3) return false;
	}

	// test HashMap higher-order methods
	{
		var sum = 0;
		map.each { k, v -> sum += v };
		if (sum != 601) return false;
		if (!map.any { k, v -> k == "second" && v == 200 }) return false;
		if (map.any { k, v -> v > 500 }) return false;
		if (!map.all { k, v -> v >= 100 }) return false;
		if (map.all { k, v -> v > 150 }) return false;
		if (map.count_where { k, v -> v >= 200 } != 2) return false;
	}

	// test remove
	if (!map.remove("second")) return false;
	if ("second" in map) return false;
	if (map.len != 2) return false;
	if (map.remove("second")) return false; // already removed
	if (map.remove("nonexistent")) return false;

	// test clear
	map.clear();
	if (!map.empty() || map.len != 0) return false;
	if ("first" in map || "third" in map) return false;

	// 3. StringBuilder
	{
		var sb: StringBuilder = StringBuilder(64);
		defer sb.free();
		sb.reserve(128);
		if (!sb.empty()) return false;
		sb += "Kobel";
		if (sb.empty()) return false;
		if (sb.last_char() != 'l') return false;
		sb += ' ';
		sb += "Compiler v";
		sb += 1;
		sb += " ";
		sb += true;
		sb.append_line("!");
		if (sb.as_view() != "Kobel Compiler v1 true!\n") return false;
		val result_str: str = sb.to_str();
		if (result_str != "Kobel Compiler v1 true!\n") return false;
		if (sb.last_char() != '\n') return false;
	}

	// 4. append_repeat / append_escaped
	{
		var sb2: StringBuilder = StringBuilder();
		defer sb2.free();
		sb2.append_repeat(' ', 3);
		sb2 += "x";
		sb2.append_escaped("a\"b\\c\nd");
		if (sb2.to_str() != "   xa\\\"b\\\\c\\nd") return false;
		sb2.clear();
		sb2.append_repeat('x', 100);
		if (sb2.len != 100 || sb2.last_char() != 'x') return false;
	}

	// 5. HashSet<T>
	{
		var set: HashSet<str> = HashSet<str>();
		defer set.free();
		if (!set.empty() || set.count() != 0) return false;
		if (!set.add("apple")) return false;
		if (!set.add("banana")) return false;
		if (set.add("apple")) return false;
		if (set.len != 2 || !("apple" in set) || !("banana" in set)) return false;
		if ("orange" in set) return false;
		{
			val set_list = set.to_list();
			defer set_list.free();
			if (set_list.len != 2) return false;
		}
		{
			val cloned = set.clone();
			defer cloned.free();
			if (cloned.len != 2 || !("apple" in cloned) || !("banana" in cloned)) return false;
		}
		if (!set.remove("apple")) return false;
		if ("apple" in set) return false;
		if (set.len != 1) return false;
		set.clear();
		if (!set.empty() || set.len != 0) return false;

		var iset = HashSet<i32>(8);
		defer iset.free();
		iset.reserve(32);
		iset += 10;
		iset += 20;
		iset += 30;
		iset += 10;
		if (iset.len != 3 || !(10 in iset) || !(20 in iset) || !(30 in iset)) return false;
		if (!iset.remove(20) || (20 in iset) || iset.len != 2) return false;
		var set_sum = 0;
		iset.each { x -> set_sum += x };
		if (set_sum != 40) return false;
		if (!iset.any { x -> x == 30 } || iset.any { x -> x == 20 }) return false;
		if (!iset.all { x -> x >= 10 } || iset.all { x -> x > 10 }) return false;
		if (iset.count_where { x -> x > 15 } != 1) return false;
		val fset = iset.filter { x -> x > 15 };
		defer fset.free();
		if (fset.len != 1 || !(30 in fset) || (10 in fset)) return false;
	}

	// 6. str.replace_char & str.join
	val orig_path = "a.b.c";
	if (orig_path.replace_char('.', '/') != "a/b/c") return false;
	{
		var parts = List<str>();
		defer parts.free();
		parts += "hello";
		parts += "world";
		parts += "kobel";
		val joined = ", ".join(parts);
		if (joined != "hello, world, kobel") return false;
		val dot_joined = ".".join(parts);
		if (dot_joined != "hello.world.kobel") return false;
	}

	return true;
}

fn test_io(): bool {
	val tmp_file: str = "build/tmp_std_test.txt";
	val p = Path(tmp_file);
	val content: str = "Testing Kobel standard library I/O!";
	val written: bool = p.write_text(content);
	if (!written) return false;
	if (!p.exists()) return false;
	val non_exist = Path("non_existent_file_xyz_123.txt");
	if (non_exist.exists()) return false;

	val extra: str = "\nAppended line.";
	val appended: bool = p.append_text(extra);
	if (!appended) return false;

	val read_back: str = p.read_text();
	if (read_back != "Testing Kobel standard library I/O!\nAppended line.") return false;

	return true;
}

fn test_str(): bool {
	val s: str = "Hello, Kobel World!";
	if (s.empty()) return false;
	if (!"".empty()) return false;
	if (s.empty()) return false;
	if (!"".empty()) return false;

	if (!s.starts_with("Hello")) return false;
	if (s.starts_with("World")) return false;

	if (!s.ends_with("World!")) return false;
	if (s.ends_with("Hello")) return false;

	if ("Kobel" !in s) return false;
	if ("Python" in s) return false;

	if (s.index_of("Kobel") != 7) return false;
	if (s.index_of("Missing") != -1) return false;

	if (s.strip_suffix(7) != "Hello, Kobel") return false;

	if ("ab".repeat(3) != "ababab") return false;
	if ("ab".repeat(0) != "") return false;
	if (s.repeat(1) != s) return false;
	if ("".repeat(4) != "") return false;

	if ("  hello world  \n".trim() != "hello world") return false;
	if (!"   \t\r".blank()) return false;
	if (!"".blank()) return false;
	if ("  x  ".blank()) return false;

	val cptr = "kobel_cstr_test".c_str();
	if (str(cptr) != "kobel_cstr_test") return false;

	val split_parts = "a.b.c".split('.');
	defer split_parts.free();
	if (split_parts.len != 3 || split_parts[0] != "a" || split_parts[1] != "b" || split_parts[2] != "c") {
		return false;
	}

	val indented = "\n    line1\n      line2\n    line3\n  ";
	if (indented.trim_indent() != "line1\n  line2\nline3") return false;
	if (indented.multiline_trim_indent() != "line1\n  line2\nline3") return false;
	val lines = "a\nb\nc".split_lines();
	if (lines.len != 3 || lines[0] != "a" || lines[1] != "b" || lines[2] != "c") return false;

	// test str higher-order methods
	val digits = "a1b2c3".filter { c -> c.is_digit() };
	if (digits != "123") return false;
	if ("abc".map_chars { c -> c.to_upper() } != "ABC") return false;
	if (!"a1b".any { c -> c.is_digit() } || "abc".any { c -> c.is_digit() }) return false;
	if (!"123".all { c -> c.is_digit() } || "12a".all { c -> c.is_digit() }) return false;
	if ("a1b2c3".count_where { c -> c.is_digit() } != 3) return false;
	if ("abc123".index_where { c -> c.is_digit() } != 3) return false;
	if ("abc123".last_index_where { c -> c.is_digit() } != 5) return false;
	var char_count = 0;
	"kobel".each { c -> char_count++ };
	if (char_count != 5) return false;

	return true;
}

fn test_filesystem(): bool {
	val p = Path("src/compiler/main.kb");
	if (p.file_name() != "main.kb") return false;
	if (p.extension() != "kb") return false;
	if (p.stem() != "main") return false;
	val parent_dir = p.parent();
	if (parent_dir.to_str() != "src/compiler") return false;

	val dir = Path("dir");
	val sub = dir.join("sub");
	val joined = sub.join("file.txt");
	if (joined.to_str() != "dir/sub/file.txt") return false;
	if (joined.extension() != "txt") return false;

	val fs_dir = Path("lib/std/filesystem");
	val entries = fs_dir.list_dir();
	defer entries.free();
	if (entries.empty()) return false;

	val tmp = Path("build/tmp_fs_test.txt");
	if (tmp.exists()) tmp.remove();

	if (!tmp.write_text("Hello Filesystem!")) return false;
	if (!tmp.exists()) return false;
	if (tmp.read_text() != "Hello Filesystem!") return false;

	var f = tmp.open_read();
	if (!f.is_valid()) return false;
	if (f.read_all() != "Hello Filesystem!") return false;
	f.close();

	val moved = Path("build/tmp_fs_test_moved.txt");
	if (!tmp.rename_to(moved)) return false;
	if (tmp.exists() || !moved.exists()) return false;

	if (!moved.remove()) return false;
	if (moved.exists()) return false;

	// Test OOP Path and File APIs
	val nested_dir = Path("build/test_oop_fs/sub1/sub2");
	if (!nested_dir.create_dir_all()) return false;
	if (!nested_dir.exists() || !nested_dir.is_dir()) return false;

	val oop_file = nested_dir.join("hello.txt");
	if (oop_file.exists()) oop_file.remove();
	if (!oop_file.write_text("Kobel OOP Filesystem")) return false;
	if (!oop_file.exists() || !oop_file.is_file()) return false;
	if (oop_file.read_text() != "Kobel OOP Filesystem") return false;

	if (!oop_file.append_text(" - Appended")) return false;
	if (oop_file.read_text() != "Kobel OOP Filesystem - Appended") return false;

	var oop_stream = oop_file.open_read();
	if (!oop_stream.is_valid()) return false;
	if (oop_stream.size() <= 0) return false;
	oop_stream.seek(0, 0);
	if (oop_stream.tell() != 0) return false;
	if (oop_stream.read_all() != "Kobel OOP Filesystem - Appended") return false;
	oop_stream.close();

	if (!oop_file.remove()) return false;
	if (oop_file.exists()) return false;

	return true;
}

fn test_system(): bool {
	val win = System.is_windows();
	if (win) {
		if (!System.has_env("SystemRoot") && !System.has_env("WINDIR")) return false;
		val sys_root = System.get_env("SystemRoot");
		val win_dir = System.get_env("WINDIR");
		if (sys_root.empty() && win_dir.empty()) return false;
	}
	if (System.has_env("__KOBEL_NON_EXISTENT_ENV_VAR_12345__")) return false;
	if (!System.get_env("__KOBEL_NON_EXISTENT_ENV_VAR_12345__").empty()) return false;
	return true;
}

fn main(): i32 {
	if (!test_ascii()) {
		println("FAIL: test_ascii");
		return 1;
	}
	println("PASS: std.ascii");

	if (!test_str()) {
		println("FAIL: test_str");
		return 1;
	}
	println("PASS: std.string");

	if (!test_arena()) {
		println("FAIL: test_arena");
		return 1;
	}
	println("PASS: std.memory.arena");

	if (!test_collections()) {
		println("FAIL: test_collections");
		return 1;
	}
	println("PASS: std.collections (List, HashMap, HashSet)");

	if (!test_filesystem()) {
		println("FAIL: test_filesystem");
		return 1;
	}
	println("PASS: std.filesystem");

	if (!test_io()) {
		println("FAIL: test_io");
		return 1;
	}
	println("PASS: std.io");

	if (!test_system()) {
		println("FAIL: test_system");
		return 1;
	}
	println("PASS: std.system");

	println("=== ALL STANDARD LIBRARY TESTS PASSED! ===");
	return 0;
}

