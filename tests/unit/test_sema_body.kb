}

// ============================================================================
// Test 6: Immutability Enforcement (val vs var)
// ============================================================================

fn test_val_immutability() {
	// 6a: Reassigning val variable
	val src1 = """
		fn test(): none {
		    val x = 10;
		    x = 20;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Must catch assignment to val variable");

	// 6b: Compound assignment to val variable
	val src2 = """
		fn test(): none {
		    val x = 10;
		    x += 5;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Must catch compound assignment to val variable");

	// 6c: Update (increment) on val variable
	val src3 = """
		fn test(): none {
		    val x = 10;
		    x++;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Must catch update on val variable");

	// 6d: Reassigning immutable parameter
	val src4 = """
		fn test(a: i32): none {
		    a = 20;
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Must catch assignment to immutable parameter");

	// 6e: Mutating field on *self receiver
	val src5 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(*self): none {
		        self.x = 20;
		    }
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Must catch field mutation on *self");

	// 6f: Mutations on local var and &self are allowed without errors
	val src6 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(&self, p: &i32): none {
		        var x = 10;
		        x = 20;
		        x += 5;
		        x++;
		        var q = *p;
		        q = 30;
		        q++;
		        self.x = 40;
		    }
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_eq_usz(bp6.errors.len, 0, "Mutations on var must produce 0 errors");

	// 6g: Calling mutating method on val variable
	val src7 = """
		struct Counter {
		    pub count: i32
		}
		impl Counter {
		    pub fn increment(&self) { self.count++; }
		}
		fn test(): none {
		    val c = Counter();
		    c.increment();
		}
	""";
	var l7 = Lexer(src7);
	var p7 = Parser(l7.tokenize());
	var bp7 = BodyChecker();
	bp7.check_program(p7.parse_program());
	assert_true(bp7.errors.len >= 1, "Must catch mutating method call on val variable");

	// 6h: Mutating field on val variable
	val src8 = """
		struct Point { pub x: i32 }
		fn test(): none {
		    val p = Point();
		    p.x = 10;
		}
	""";
	var l8 = Lexer(src8);
	var p8 = Parser(l8.tokenize());
	var bp8 = BodyChecker();
	bp8.check_program(p8.parse_program());
	assert_true(bp8.errors.len >= 1, "Must catch field mutation on val variable");

	// 6i: Calling write on read-only pointer
	val src9 = """
		fn test(p: *i32): none {
		    p.write(10);
		}
	""";
	var l9 = Lexer(src9);
	var p9 = Parser(l9.tokenize());
	var bp9 = BodyChecker();
	bp9.check_program(p9.parse_program());
	assert_true(bp9.errors.len >= 1, "Must catch write call on read-only pointer");

	// 6j: Calling method on moved value
	val src10 = """
		struct Resource { pub id: i32 }
		impl Resource {
		    pub fn consume(self): i32 => self.id;
		    pub fn peek(*self): i32 => self.id;
		}
		fn test(): none {
		    val r = Resource(1);
		    r.consume();
		    r.peek();
		}
	""";
	var l10 = Lexer(src10);
	var p10 = Parser(l10.tokenize());
	var bp10 = BodyChecker();
	bp10.check_program(p10.parse_program());
	assert_true(bp10.errors.len >= 1, "Must catch use of moved value");

	// 6k: Calling move method on pointer receiver
	val src11 = """
		struct Resource { pub id: i32 }
		impl Resource {
		    pub fn consume(self): i32 => self.id;
		}
		fn test(p: *Resource): none {
		    p.consume();
		}
	""";
	var l11 = Lexer(src11);
	var p11 = Parser(l11.tokenize());
	var bp11 = BodyChecker();
	bp11.check_program(p11.parse_program());
	assert_true(bp11.errors.len >= 1, "Must catch move method call on pointer receiver");

	println("  [PASS] test_val_immutability");
}

fn test_elvis_jump_restriction() {
	// 1. Allowed in variable declaration: val x = p ?: return;
	val src1 = """
		fn test(p: ?*i32): i32 {
		    val x = p ?: return 0;
		    return *x;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_eq_usz(bp1.errors.len, 0, "Elvis with return in variable declaration must be allowed");

	// 2. Allowed in assignment: x = p ?: return;
	val src2 = """
		fn test(p: ?*i32): i32 {
		    var x: ?*i32 = null;
		    x = p ?: return 0;
		    return *x!;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_eq_usz(bp2.errors.len, 0, "Elvis with return in assignment must be allowed");

	// 3. Allowed in statement expression: p ?: return;
	val src3 = """
		fn test(p: ?*i32): i32 {
		    p ?: return 0;
		    return 1;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_eq_usz(bp3.errors.len, 0, "Elvis with return in statement expression must be allowed");

	// 4. Disallowed in call argument: foo(p ?: return)
	val src4 = """
		fn foo(x: *i32): none {}
		fn test(p: ?*i32): none {
		    foo(p ?: return);
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Elvis with return in call argument must be rejected");

	// 5. Disallowed in binary expression: 1 + (p ?: return)
	val src5 = """
		fn test(p: ?*i32): i32 {
		    val x = 1 + *(p ?: return 0);
		    return x;
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Elvis with return in binary sub-expression must be rejected");

	// 6. Disallowed in condition: if (p ?: return)
	val src6 = """
		fn test(p: ?*bool): none {
		    if (p ?: return) {}
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_true(bp6.errors.len >= 1, "Elvis with return in if condition must be rejected");

	println("  [PASS] test_elvis_jump_restriction");
}

fn test_defer_restrictions() {
	// 1. Disallow return inside defer
	val src1 = """
		fn test(): none {
		    defer return;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Return inside defer must be rejected");

	// 2. Disallow break inside defer
	val src2 = """
		fn test(): none {
		    while (true) {
		        defer break;
		    }
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Break inside defer must be rejected");

	// 3. Disallow continue inside defer
	val src3 = """
		fn test(): none {
		    while (true) {
		        defer continue;
		    }
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Continue inside defer must be rejected");

	// 4. Disallow nested defer inside defer
	val src4 = """
		fn test(): none {
		    defer {
		        defer 1 + 2;
		    }
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Nested defer inside defer must be rejected");

	println("  [PASS] test_defer_restrictions");
}

fn test_interpolation_requires_to_str() {
	val src1 = """
		struct NoString {
		    pub x: i32
		}
		fn test(): str {
		    val ns = NoString(1);
		    return "\${ns}";
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Interpolation of struct without Stringer must be rejected");

	val src2 = """
		struct AdHoc {
		    pub x: i32
		}
		impl AdHoc {
		    fn to_str(*self): str => "adhoc";
		}
		fn test(): str {
		    val a = AdHoc(1);
		    return "\${a}";
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Interpolation with ad-hoc to_str without Stringer trait must be rejected");

	println("  [PASS] test_interpolation_requires_to_str");
}


fn test_cast_null_to_non_null_pointer_rejected() {
	val src = """
		struct Node {
		    pub id: i32
		}
		fn test_cast(p: ?*Node) {
		    val a = null as *Node;
		    val b = p as *Node;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_true(bp.errors.len >= 2, "Casting null or nullable pointer to non-nullable pointer must be rejected");
	println("  [PASS] test_cast_null_to_non_null_pointer_rejected");
}

fn test_unused_mutability_warning() {
	val src = """
		struct Item {
		    pub val: i32
		}
		impl Item {
		    pub fn query(&self): i32 => self.val;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_eq_usz(bp.errors.len, 0, "No errors expected");
	assert_eq_usz(bp.warnings.len, 1, "Must emit 1 warning for unused &self");
	println("  [PASS] test_unused_mutability_warning");
}

fn test_destructure_nullable_pointer_error() {
	val src = """
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		impl Point {
		    pub op unpack(*self, x: &i32, y: &i32) {
		        x.write(self.x);
		        y.write(self.y);
		    }
		}
		fn test(p: ?*Point) {
		    val (x, y) = p;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_true(bp.errors.len > 0, "Destructuring nullable pointer must produce an error");
	println("  [PASS] test_destructure_nullable_pointer_error");
}

fn test_when_subject_and_implicit_dot_restrictions() {
	// 1. Disallow function/method call in when subject
	val src1 = """
		fn get_str(): str => "hello";
		fn test(): i32 => when (get_str()) {
		    "hello" -> 1;
		    else -> 0;
		};
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Function call in when subject must be rejected");

	// 2. Disallow leading '.' outside when (subject)
	val src2 = """
		fn test(s: str): bool => .empty();
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Leading '.' outside when subject must be rejected");

	// 3. Disallow non-bool implicit subject pattern in when (subject)
	val src3 = """
		fn test(s: str): i32 => when (s) {
		    .len -> 1;
		    else -> 0;
		};
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Non-bool implicit subject pattern in when must be rejected");

	println("  [PASS] test_when_subject_and_implicit_dot_restrictions");
}

fn check_single_error(src: str, desc: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());
	val total_errs = p.errors.len + bp.errors.len;
	assert_true(total_errs >= 1, desc);
}

fn test_lambda_body_and_call_restrictions() {
	// 1. Passing lambda inside parentheses: fn({ x -> ... })
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply({ x -> x + 1 });
		""",
		"Lambda inside parentheses must be rejected"
	);

	// 2. Empty parentheses before trailing lambda: fn() { x -> ... }
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply() { x -> x + 1 };
		""",
		"Empty parens before single-arg trailing lambda must be rejected"
	);

	// 3. Storing lambda literal in a local variable
	check_single_error(
		"""
		fn test() {
		    val f = { x: i32 -> x + 1 };
		}
		""",
		"Storing lambda literal in variable must be rejected"
	);

	// 4. Escaping a lambda parameter by assigning to a variable
	check_single_error(
		"""
		fn test(f: (i32) -> i32) {
		    val saved = f;
		}
		""",
		"Escaping lambda parameter into local variable must be rejected"
	);

	// 5. Mutating captured outer `val` inside lambda
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 {
		    val limit = 10;
		    return apply { x ->
		        limit = 20;
		        yield x;
		    };
		}
		""",
		"Mutating captured outer val inside lambda must be rejected"
	);

	// 6. Shadowing outer local variable with lambda parameter
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 {
		    val x = 5;
		    return apply { x -> x + 1 };
		}
		""",
		"Shadowing outer local variable with lambda parameter must be rejected"
	);

	// 7. Using `return` inside a lambda
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { x ->
		    return x + 1;
		};
		""",
		"Using return inside lambda must be rejected"
	);

	// 8. Using `break` inside lambda to exit outer loop
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test() {
		    while (true) {
		        apply { x ->
		            break;
		            yield x;
		        };
		    }
		}
		""",
		"Using break inside lambda targeting outer loop must be rejected"
	);

	// 9. Multi-statement value-returning lambda missing `yield`
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { x ->
		    val y = x + 1;
		};
		""",
		"Multi-statement lambda without yield must be rejected"
	);

	// 10. Lambda parameter count mismatch
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { a, b -> a + b };
		""",
		"Lambda parameter count mismatch must be rejected"
	);

	println("  [PASS] test_lambda_body_and_call_restrictions");
}

fn test_in_candidate_list_restrictions() {
	// 1. Standalone '[...]' array literal is rejected
	check_single_error(
		"""
		fn test() {
		    val x = [1, 2, 3];
		}
		""",
		"Standalone '[...]' array literal must be rejected"
	);

	// 2. Empty candidate list in 'in' is rejected
	check_single_error(
		"""
		fn test() {
		    if (1 in []) {}
		}
		""",
		"Empty candidate list in 'in' must be rejected"
	);

	// 3. Mismatched element type in 'in' candidate list is rejected
	check_single_error(
		"""
		fn test() {
		    if (1 in ["a", "b"]) {}
		}
		""",
		"Mismatched element type in 'in' candidate list must be rejected"
	);

	println("  [PASS] test_in_candidate_list_restrictions");
}

fn test_not_is_semantics() {
	val valid_prog =
		"""
		enum SemaShape {
		    Circle(radius: f64),
		    Empty
		}
		fn f(s: SemaShape): f64 {
		    if (s !is SemaShape.Circle) {
		        return 0.0;
		    } else {
		        return s.radius;
		    }
		}
		fn g(s: SemaShape): bool {
		    return when (s) {
		        !is SemaShape.Circle -> true;
		        else -> false;
		    };
		}
		""";
	var l = Lexer(valid_prog);
	var p = Parser(l.tokenize());
	val prog = p.parse_program();
	assert_eq_usz(p.errors.len, 0, "Parse errors in valid !is program");

	var bp = BodyChecker();
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "Sema errors in valid !is program with else smart cast");

	// `!is` must NOT smart-cast into the 'then' branch.
	check_single_error(
		"""
		enum SemaShape2 {
		    Circle(radius: f64),
		    Empty
		}
		fn f(s: SemaShape2): f64 {
		    if (s !is SemaShape2.Circle) {
		        return s.radius;
		    }
		    return 0.0;
		}
		""",
		"'!is' must not smart-cast into the then branch"
	);

	// Empty type list in `is []` and `!is []` is rejected.
	check_single_error(
		"""
		enum SemaShape3 { Circle(radius: f64), Empty }
		fn f(s: SemaShape3): bool => s is [];
		""",
		"Empty type list in 'is []' must be rejected"
	);
	check_single_error(
		"""
		enum SemaShape4 { Circle(radius: f64), Empty }
		fn f(s: SemaShape4): bool => s !is [];
		""",
		"Empty type list in '!is []' must be rejected"
	);

	// Multi-type list `is [A, B]` must NOT smart-cast into a single variant type.
	check_single_error(
		"""
		enum SemaShape5 { Circle(radius: f64), Empty }
		fn f(s: SemaShape5): f64 {
		    if (s is [SemaShape5.Circle, SemaShape5.Empty]) {
		        return s.radius;
		    }
		    return 0.0;
		}
		""",
		"Multi-type 'is [A, B]' must not smart-cast"
	);

	println("  [PASS] test_not_is_semantics");
}

fn test_is_pointer_mutability_propagation_and_no_new_ctor() {
	// `is T as x` on read-only `*Base` stays `*T` and cannot pass to `&T`.
	check_single_error(
		"""
		enum Node { Literal(v: i32), Empty }
		fn take_mut(lit: &Node.Literal) {}
		fn f(n: *Node) {
		    if (n is Node.Literal as lit) {
		        take_mut(lit);
		    }
		}
		""",
		"is Node.Literal as lit on *Node must remain read-only (*Node.Literal)"
	);

	// `is T as x` on mutable `&Base` propagates `&T` and can pass to `&T`.
	val ok_src = """
		enum Node { Literal(v: i32), Empty }
		fn take_mut(lit: &Node.Literal) {}
		fn f(n: &Node) {
		    if (n is Node.Literal as lit) {
		        take_mut(lit);
		    }
		}
	""";
	var ok_lexer = Lexer(ok_src);
	var ok_parser = Parser(ok_lexer.tokenize());
	val ok_prog = ok_parser.parse_program();
	assert_eq_usz(ok_parser.errors.len, 0, "Mutable is propagation sample must parse");
	var ok_bp = BodyChecker();
	ok_bp.check_program(ok_prog);
	assert_eq_usz(ok_bp.errors.len, 0, "is Node.Literal as lit on &Node must propagate &Node.Literal");

	// `fn new(...)` is an ordinary static method, not a fallback for `Struct(...)`.
	check_single_error(
		"""
		struct Boxed {
		    pub v: i32
		}
		impl Boxed {
		    pub fn new(v: i32): Boxed => Boxed { v: v };
		}
		fn f(): Boxed => Boxed(42);
		""",
		"Struct without init must reject Struct(...) even when fn new exists"
	);

	println("  [PASS] test_is_pointer_mutability_propagation_and_no_new_ctor");
}

fn check_valid_body(src: str, desc: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	val prog = p.parse_program();
	assert_eq_usz(p.errors.len, 0, "${desc}: parser must accept snippet");
	var bp = BodyChecker();
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, desc);
}

fn test_nullable_pointer_restrictions() {
	val pair_def = """
	struct Pair { pub x: i32, pub y: i32 }
	impl Pair {
	    pub fn get_x(*self): i32 => self.x;
	    pub op get(*self, i: i32): i32 => self.x + i;
	    pub op set(&self, i: i32, v: i32) { self.x = v; }
	}
	""";

	check_single_error(
		"fn f(p: ?*i32): i32 => *p;",
		"Direct deref on nullable ?*i32 must be rejected"
	);
	check_single_error(
		"fn f(p: ?&i32): i32 => *p;",
		"Direct deref on nullable ?&i32 must be rejected"
	);
	check_single_error(
		"${pair_def}\nfn f(p: ?*Pair): i32 => p.x;",
		"Direct field access on nullable ?*Pair must be rejected"
	);
	check_single_error(
		"fn f(p: ?*i32): i32 => p[0];",
		"Direct index read on nullable ?*i32 must be rejected"
	);
	check_single_error(
		"${pair_def}\nfn f(p: ?*Pair): i32 => p[0];",
		"Direct overloaded index read on nullable ?*Pair must be rejected"
	);
	check_single_error(
		"fn f(p: ?&i32) { p[0] = 1; }",
		"Direct index write on nullable ?&i32 must be rejected"
	);
	check_single_error(
		"${pair_def}\nfn f(p: ?&Pair) { p[0] = 1; }",
		"Direct overloaded index write on nullable ?&Pair must be rejected"
	);
	check_single_error(
		"${pair_def}\nfn f(p: ?*Pair): i32 => p.get_x();",
		"Direct method call on nullable ?*Pair must be rejected"
	);
	check_single_error(
		"fn f(p: ?*i32): i32 => p.read();",
		"Direct read() on nullable ?*i32 must be rejected"
	);
	check_single_error(
		"fn f(p: ?&i32) { p.write(1); }",
		"Direct write() on nullable ?&i32 must be rejected"
	);
	check_single_error(
		"fn f(p: ?*i32) { p?.write(1); }",
		"Safe write() on immutable nullable ?*i32 must be rejected"
	);

	// Allowed nullable operations: addr(), is, ?., ?:, smart-cast after != null
	check_valid_body(
		"""
		struct Base { pub tag: i32 }
		struct Sub { pub tag: i32, pub v: i32 }
		impl Sub { pub const TAG: i32 = 1; }
		${pair_def}
		fn f(p: ?*i32, q: ?&i32, pr: ?*Pair, qw: ?&Pair, b: ?*Base): bool {
		    val a1 = p.addr();
		    val a2 = q.addr();
		    val x = pr?.x ?: 0;
		    val gx = pr?.get_x() ?: 0;
		    q?.write(1);
		    val is_sub = b is Sub;
		    var res: i32 = x + gx + (a1 as i32) + (a2 as i32);
		    if (p != null) { res = res + *p; }
		    if (q != null) { q.write(42); }
		    val has_x = (pr?.get_x() == 1);
		    return is_sub && has_x && (qw != null || res >= 0);
		}
		""",
		"Allowed nullable ops (addr, is, ?., ?:, smart-cast) must typecheck"
	);

	check_valid_body(
		"fn f(q: ?&i32) { if (q != null) { q[0] = 1; q.write(2); } }",
		"Smart-cast after q != null allows q[0] = 1 and q.write(2)"
	);

	println("  [PASS] test_nullable_pointer_restrictions");
}

fn test_address_of_and_auto_ref_mutability() {
	check_single_error(
		"fn f() { val x: i32 = 1; val p: &i32 = &x; }",
		"&val_var must produce *T, not assignable to &T"
	);
	check_single_error(
		"fn f() { val x: i32 = 1; (&x).write(2); }",
		"&val_var must not allow .write()"
	);
	check_single_error(
		"""
		struct Box { pub v: i32 }
		fn take_mut(b: &Box) { b.v = 2; }
		fn f() { val b = Box { v: 1 }; take_mut(b); }
		""",
		"Auto-ref of val struct to &Struct parameter must be rejected"
	);
	check_single_error(
		"""
		struct Box { pub v: i32 }
		fn take_mut(b: &Box) { b.v = 2; }
		fn make(): Box => Box { v: 1 };
		fn f() { take_mut(make()); }
		""",
		"Auto-ref of rvalue struct to &Struct parameter must be rejected"
	);

	check_valid_body(
		"""
		struct Box { pub v: i32 }
		fn take_ro(b: *Box): i32 => b.v;
		fn take_mut(b: &Box) { b.v = 2; }
		fn f(): i32 {
		    val x: i32 = 1;
		    val p: *i32 = &x;
		    var y: i32 = 2;
		    val mp: &i32 = &y;
		    mp.write(3);
		    val vb = Box { v: 4 };
		    var mb = Box { v: 5 };
		    take_mut(mb);
		    return *p + take_ro(vb) + mb.v;
		}
		""",
		"&val -> *T, &var -> &T, var -> &Struct, and val -> *Struct must be allowed"
	);

	println("  [PASS] test_address_of_and_auto_ref_mutability");
}

fn test_lvalue_and_pointer_write_mutability() {
	val box_def = """
	struct Box { pub v: i32 }
	impl Box {
	    pub fn mut_m(&self) { self.v = self.v + 1; }
	    pub op set(&self, i: i32, val_in: i32) { self.v = val_in + i; }
	    pub op plus_assign(&self, d: i32) { self.v = self.v + d; }
	}
	""";

	check_single_error(
		"struct Box { pub v: i32 }\nfn f(p: *Box) { p.v = 2; }",
		"Field write through non-self *T must be rejected"
	);
	check_single_error(
		"fn f(p: *i32) { *p = 2; }",
		"Dereference write through non-self *i32 must be rejected"
	);
	check_single_error(
		"fn f(p: *i32) { p[0] = 2; }",
		"Raw index write through *i32 must be rejected"
	);
	check_single_error(
		"${box_def}\nfn f(p: *Box) { p[0] = 2; }",
		"Overloaded index write through *Box must be rejected"
	);
	check_single_error(
		"${box_def}\nfn f(p: *Box) { p += 1; }",
		"Compound assignment operator through *Box must be rejected"
	);
	check_single_error(
		"${box_def}\nfn f(p: ?&Box) { p += 1; }",
		"Compound assignment operator on nullable ?&Box must be rejected"
	);
	check_single_error(
		"${box_def}\nfn f(p: *Box) { p.mut_m(); }",
		"Mutating method call through *Box must be rejected"
	);
	check_single_error(
		"""
		struct Inner { pub v: i32 }
		struct Outer { pub inner: Inner }
		fn f() {
		    val o = Outer { inner: Inner { v: 1 } };
		    o.inner.v = 2;
		}
		""",
		"Nested member write through val struct must be rejected"
	);
	check_single_error(
		"""
		struct Inner { pub v: i32 }
		struct Outer { pub inner: Inner }
		impl Outer {
		    pub fn bad(*self) { self.inner.v = 2; }
		}
		""",
		"Nested member write through *self must be rejected"
	);
	check_single_error(
		"fn f() { var s = \"abc\"; s[0] = 'x'; }",
		"Index assignment on str must be rejected"
	);

	// Mutating pointee through immutable binding `val p: &T` is allowed
	check_valid_body(
		"""
		${box_def}
		fn f() {
		    var b = Box { v: 1 };
		    val pb: &Box = &b;
		    pb.v = 2;
		    pb[0] = 3;
		    pb += 4;
		    pb.mut_m();
		    var x: i32 = 10;
		    val pi: &i32 = &x;
		    *pi = 20;
		    pi[0] = 30;
		    pi.write(40);
		}
		""",
		"Mutating pointee through val p: &T must be allowed"
	);

	println("  [PASS] test_lvalue_and_pointer_write_mutability");
}

fn test_pointer_cast_and_implicit_conv_restrictions() {
	check_single_error(
		"fn f(p: *i32): &i32 => p as &i32;",
		"Cast *i32 as &i32 must be rejected"
	);
	check_single_error(
		"fn f(p: *i32): &u8 => p as &u8;",
		"Cast *i32 as &u8 must be rejected"
	);
	check_single_error(
		"fn f(p: *none): &u8 => p as &u8;",
		"Cast *none as &u8 must be rejected"
	);
	check_single_error(
		"fn f() { val p: &u8 = \"hi\"; }",
		"Implicit conversion from str to &u8 must be rejected"
	);
	check_single_error(
		"fn f() { val p: &char = \"hi\"; }",
		"Implicit conversion from str to &char must be rejected"
	);
	check_single_error(
		"fn f() { val p: &none = \"hi\"; }",
		"Implicit conversion from str to &none must be rejected"
	);
	check_single_error(
		"fn f(p: *i32) { val q: &u8 = p; }",
		"Implicit conversion from *i32 to &u8 must be rejected"
	);
	check_single_error(
		"fn f(p: *i32) { val q: &none = p; }",
		"Implicit conversion from *i32 to &none must be rejected"
	);
	check_single_error(
		"fn f() { val n = null as ?*i32; }",
		"Casting null to ?*i32 must be rejected"
	);
	check_single_error(
		"fn f() { val n = null as ?&i32; }",
		"Casting null to ?&i32 must be rejected"
	);
	check_single_error(
		"fn f() { val n = (null) as ?*u8; }",
		"Casting parenthesized null to ?*u8 must be rejected"
	);
	check_single_error(
		"fn f() { val n = null as &u8; }",
		"Casting null to &u8 must be rejected"
	);
	check_single_error(
		"fn f() { val n = null as i32; }",
		"Casting null to i32 must be rejected"
	);

	check_valid_body(
		"""
		fn f(p: *i32, q: &i32) {
		    val n1: ?&i32 = null;
		    val n2: ?&u8 = null;
		    val m1: &u8 = q as &u8;
		    val m_null: ?&u8 = q as ?&u8;
		    val r1: *u8 = q as *u8;
		    val s1: *u8 = "hi";
		    val s2: *char = "hi";
		    val s3: *none = "hi";
		    val op: *none = p;
		    val m2: &none = q;
		    if (n1 != null && n2 != null && m_null != null) {
		        val x = m1 as *u8;
		        val y = (r1 as *none) == op && (m2 as *none) == (s3 as *none) && (s1 != null) && (s2 != null);
		    }
		}
		""",
		"Typed null initialization, ?&T casts, &T -> &U casts, and str/const-ptr -> *char/*u8/*none must be allowed"
	);

	println("  [PASS] test_pointer_cast_and_implicit_conv_restrictions");
}

fn test_error_union_restrictions() {
	check_single_error(
		"fault E { Fail }\nfn f(): i32 ! E => 1;\nfn main() { f(); }",
		"Discarding T ! E as bare statement must fail"
	);
	check_single_error(
		"fault E { Fail }\nfn f(): !E {}\nfn main() { f(); }",
		"Discarding !E as bare statement must fail"
	);
	check_single_error(
		"fault E { Fail }\nstruct S { pub x: i32 }\nfn f(): S ! E => S(1);\nfn main() { val y = f().x; }",
		"Member access on unhandled error union must fail"
	);
	check_single_error(
		"fault E { Fail }\nfn f(): i32 ! E => 1;\nfn g(): i32 { val a: i32 = f(); return a; }",
		"Implicit conversion from T ! E to T must fail"
	);
	check_single_error(
		"fault E { Fail }\nfn f(): i32 ! E => 1;\nfn g(r: i32 ! E): bool => f() == r;",
		"Direct == on error union must fail"
	);
	check_single_error(
		"fault E { A, B }\nfn eq(a: E, b: E): bool => a == b;",
		"Direct == on fault must fail"
	);
	check_single_error(
		"fault E { Fail }\nfn f(): i32 ! E => 1;\nfn g(): i32 { val x = f()?; return x; }",
		"Using ? in non-error-union function must fail"
	);
	check_single_error(
		"fault E1 { A }\nfault E2 { B }\nfn f(): i32 ! E1 => 1;\nfn g(): i32 ! E2 { val x = f()?; return x; }",
		"Using ? with mismatched fault type must fail"
	);
	check_single_error(
		"fault E { A }\nfn f(): i32 ! E => 1;\nfn run_cb(cb: () -> i32): i32 => cb();\nfn g(): i32 ! E => run_cb { f()? };",
		"Using ? inside lambda must fail"
	);
	check_single_error(
		"fault E { A }\nfn f(): !E {}\nfn g(x: i32 ! E): bool => x is none;",
		"Checking is none on T ! E (non-none ok) must fail"
	);
	check_single_error(
		"fault E { A }\nfn f(): !E {}\nfn g(): bool { val r = f(); return r is none as n; }",
		"Binding alias to none in is must fail"
	);
	check_single_error(
		"fault E { A, B }\nfn f(): i32 ! E => 1;\nfn g(): i32 { val r = f(); return when (r) { is i32 as n -> *n; is .A -> -1; }; }",
		"Non-exhaustive when on T ! E must fail"
	);
	check_single_error(
		"fault E { A }\nfn main(): str ! E => \"ok\";",
		"Entry point main with non-none success error union must fail"
	);
	check_single_error(
		"fn main(): i32 { return 0; }",
		"Deprecated fn main(): i32 must be rejected"
	);
	check_single_error(
		"fault E { A }\nfn main(): i32 ! E => 1;",
		"Entry point main returning i32 ! E must be rejected"
	);
	check_single_error(
		"fn main() { return 0; }",
		"Returning non-fault i32 from fn main() must be rejected"
	);
	check_single_error(
		"fn main() => 42;",
		"Arrow fn main() returning i32 must be rejected"
	);
	check_single_error(
		"fn main(x: i32) {}",
		"Entry point main with invalid parameter list must be rejected"
	);
	check_single_error(
		"fault E { A }\nfn f(): i32 ! E => 1;\nfn g() { val x = f() !: \"bad\"; }",
		"Recovery handler type mismatch in !: must fail"
	);
	check_single_error(
		"fault E { A }\nfn f(): i32 ! E => 1;\nfn g(cb: () -> none) { cb(); }\nfn main() { g { f(); }; }",
		"Discarded error union in none-returning lambda must fail"
	);
	check_single_error(
		"fault E { A }\nfn f(): i32 ! E => 1;\nfn g(): i32 { val r = f(); val y = r as i32 ! E; return 0; }",
		"Casting error union with 'as' must fail"
	);
	check_valid_body(
		"fault E { A, B }\nfn f(ok: bool): !E { if (!ok) return E.A; }\nfn main(): !E { f(true)?; return; }",
		"main returning !E with ? propagation and empty return must pass"
	);
	check_valid_body(
		"fault A { X }\nfault B { Y }\nfn f(): i32 ! A => 1;\nfn g(): !B {}\nfn main() { val v = f()?; g()?; }",
		"fn main() must propagate multiple distinct fault types via ?"
	);
	check_valid_body(
		"fault E { A }\nfn main() { return E.A; }",
		"fn main() returning a fault directly must pass"
	);
	check_valid_body(
		"fn main(argc: i32, argv: &*char) {}",
		"fn main(argc: i32, argv: &*char) without return type must pass"
	);
	println("  [PASS] test_error_union_restrictions");
}

fn test_object_and_empty_struct_restrictions() {
	check_single_error(
		"object MyObj { fn f() {} }\nimpl MyObj { fn g() {} }",
		"Writing impl block for an object must be rejected"
	);
	check_single_error(
		"trait T { fn f(*self); }\nobject MyObj { fn a() {} }\nimpl T for MyObj { fn f(*self) {} }",
		"Implementing a trait for an object must be rejected"
	);
	check_single_error(
		"object MyObj { fn f(*self) {} }",
		"Instance receiver *self on object function must be rejected"
	);
	check_single_error(
		"object MyObj { fn f(self) {} }",
		"Move receiver self on object function must be rejected"
	);
	check_single_error(
		"object MyObj { fn f(); }",
		"Bodyless function inside object must be rejected"
	);
	check_single_error(
		"object MyObj { pub fn f(): i32 => 1; }\nfn main() { val x = MyObj(); }",
		"Instantiating an object via call syntax must be rejected"
	);
	check_single_error(
		"object MyObj { pub fn f(): i32 => 1; }\nfn main() { val x: MyObj = 1; }",
		"Using object as variable type must be rejected"
	);
	check_single_error(
		"object MyObj { pub fn f(): i32 => 1; }\nfn take(x: MyObj) {}",
		"Using object as parameter type must be rejected"
	);
	check_single_error(
		"object MyObj { pub fn f(): i32 => 1; }\nfn take(p: *MyObj) {}",
		"Pointer to object type must be rejected"
	);
	check_single_error(
		"object MyObj { pub fn f(): i32 => 1; }\nfn main() { val x = MyObj; }",
		"Using object directly as value must be rejected"
	);
	check_single_error(
		"object MyObj { fn bad() { Self(); } }",
		"Instantiating Self inside object must be rejected"
	);
	check_single_error(
		"object MyObj { fn bad(): Self { return 0; } }",
		"Using Self as return type inside object must be rejected"
	);
	check_single_error(
		"object MyObj { fn f() {} }\nfn main() { val n = MyObj.size(); }",
		"Querying size on object without size() fn must fail"
	);
	check_single_error(
		"object MyObj { pub const C: i32 = 1; }\nfn main() { val n = MyObj.MISSING; }",
		"Accessing missing constant on object must fail"
	);
	check_single_error(
		"struct ForwardOnly;\nfn main() {}",
		"Semicolon struct declaration must be rejected"
	);
	check_single_error(
		"struct Empty {}\nfn main() {}",
		"Empty zero-field struct must be rejected"
	);
	check_valid_body(
		"""
		object Helper {
			const A: i32 = 4;
			pub const B: i32 = Self.A * 2;
			pub fn size(): i32 => Self.B;
			pub fn id<T>(x: T): T => x;
		}
		fn main() {
			val s = Helper.size() + Helper.id<i32>(1);
		}
		""",
		"Valid object constants, Self usage, generic function, and explicit size() function must pass"
	);
	println("  [PASS] test_object_and_empty_struct_restrictions");
}

fn main() {
	println("[RUNNING] Bootstrap Semantic BodyChecker tests...");
	test_nullable_pointer_restrictions();
	test_address_of_and_auto_ref_mutability();
	test_lvalue_and_pointer_write_mutability();
	test_pointer_cast_and_implicit_conv_restrictions();
	test_error_union_restrictions();
	test_object_and_empty_struct_restrictions();
	test_when_subject_and_implicit_dot_restrictions();
	test_lambda_body_and_call_restrictions();
	test_in_candidate_list_restrictions();
	test_not_is_semantics();
	test_is_pointer_mutability_propagation_and_no_new_ctor();
	test_destructure_nullable_pointer_error();
	test_cast_null_to_non_null_pointer_rejected();
	test_unused_mutability_warning();
	test_interpolation_requires_to_str();
	test_valid_program();
	test_undeclared_identifier();
	test_type_mismatch();
	test_condition_not_bool();
	test_return_type_mismatch();
	test_val_immutability();
	test_elvis_jump_restriction();
	test_defer_restrictions();
	println("[ALL PASSED] Bootstrap Semantic BodyChecker passed all tests successfully!");
}
