	assert_true(bp.errors.len >= 1, "Must catch return type mismatch error");
	println("  [PASS] test_return_type_mismatch");
}

// ============================================================================
// Test 6: Immutability Enforcement (val vs var)
// ============================================================================

fn test_val_immutability() {
	// 6a: Reassigning val variable
	val src1 = """
		fn test(): none {
		    val x = 10;
		    x = 20;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Must catch assignment to val variable");

	// 6b: Compound assignment to val variable
	val src2 = """
		fn test(): none {
		    val x = 10;
		    x += 5;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Must catch compound assignment to val variable");

	// 6c: Update (increment) on val variable
	val src3 = """
		fn test(): none {
		    val x = 10;
		    x++;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Must catch update on val variable");

	// 6d: Reassigning immutable parameter
	val src4 = """
		fn test(a: i32): none {
		    a = 20;
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Must catch assignment to immutable parameter");

	// 6e: Mutating field on val self receiver
	val src5 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(val self): none {
		        self.x = 20;
		    }
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Must catch field mutation on val self");

	// 6f: Mutations on var are allowed without errors
	val src6 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(var self, var p: i32): none {
		        var x = 10;
		        x = 20;
		        x += 5;
		        x++;
		        p = 30;
		        p++;
		        self.x = 40;
		    }
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_eq_usz(bp6.errors.len, 0, "Mutations on var must produce 0 errors");

	// 6g: Calling mutating method on val variable
	val src7 = """
		struct Counter {
		    pub count: i32
		}
		impl Counter {
		    pub fn increment(var self) { self.count++; }
		}
		fn test(): none {
		    val c = Counter();
		    c.increment();
		}
	""";
	var l7 = Lexer(src7);
	var p7 = Parser(l7.tokenize());
	var bp7 = BodyChecker();
	bp7.check_program(p7.parse_program());
	assert_true(bp7.errors.len >= 1, "Must catch mutating method call on val variable");

	// 6h: Mutating field on val variable
	val src8 = """
		struct Point { pub x: i32 }
		fn test(): none {
		    val p = Point();
		    p.x = 10;
		}
	""";
	var l8 = Lexer(src8);
	var p8 = Parser(l8.tokenize());
	var bp8 = BodyChecker();
	bp8.check_program(p8.parse_program());
	assert_true(bp8.errors.len >= 1, "Must catch field mutation on val variable");

	// 6i: Calling write on read-only pointer
	val src9 = """
		fn test(p: *i32): none {
		    p.write(10);
		}
	""";
	var l9 = Lexer(src9);
	var p9 = Parser(l9.tokenize());
	var bp9 = BodyChecker();
	bp9.check_program(p9.parse_program());
	assert_true(bp9.errors.len >= 1, "Must catch write call on read-only pointer");

	println("  [PASS] test_val_immutability");
}

fn test_elvis_jump_restriction() {
	// 1. Allowed in variable declaration: val x = p ?: return;
	val src1 = """
		fn test(p: *i32?): i32 {
		    val x = p ?: return 0;
		    return *x;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_eq_usz(bp1.errors.len, 0, "Elvis with return in variable declaration must be allowed");

	// 2. Allowed in assignment: x = p ?: return;
	val src2 = """
		fn test(p: *i32?, var x: *i32): i32 {
		    x = p ?: return 0;
		    return *x;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_eq_usz(bp2.errors.len, 0, "Elvis with return in assignment must be allowed");

	// 3. Allowed in statement expression: p ?: return;
	val src3 = """
		fn test(p: *i32?): i32 {
		    p ?: return 0;
		    return 1;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_eq_usz(bp3.errors.len, 0, "Elvis with return in statement expression must be allowed");

	// 4. Disallowed in call argument: foo(p ?: return)
	val src4 = """
		fn foo(x: *i32): none {}
		fn test(p: *i32?): none {
		    foo(p ?: return);
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Elvis with return in call argument must be rejected");

	// 5. Disallowed in binary expression: 1 + (p ?: return)
	val src5 = """
		fn test(p: *i32?): i32 {
		    val x = 1 + *(p ?: return 0);
		    return x;
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Elvis with return in binary sub-expression must be rejected");

	// 6. Disallowed in condition: if (p ?: return)
	val src6 = """
		fn test(p: *bool?): none {
		    if (p ?: return) {}
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_true(bp6.errors.len >= 1, "Elvis with return in if condition must be rejected");

	println("  [PASS] test_elvis_jump_restriction");
}

fn test_defer_restrictions() {
	// 1. Disallow return inside defer
	val src1 = """
		fn test(): none {
		    defer return;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Return inside defer must be rejected");

	// 2. Disallow break inside defer
	val src2 = """
		fn test(): none {
		    while (true) {
		        defer break;
		    }
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Break inside defer must be rejected");

	// 3. Disallow continue inside defer
	val src3 = """
		fn test(): none {
		    while (true) {
		        defer continue;
		    }
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Continue inside defer must be rejected");

	// 4. Disallow nested defer inside defer
	val src4 = """
		fn test(): none {
		    defer {
		        defer 1 + 2;
		    }
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Nested defer inside defer must be rejected");

	println("  [PASS] test_defer_restrictions");
}

fn test_interpolation_requires_to_str() {
	val src1 = """
		struct NoString {
		    pub x: i32
		}
		fn test(): str {
		    val ns = NoString(1);
		    return "\${ns}";
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Interpolation of struct without Stringer must be rejected");

	val src2 = """
		struct AdHoc {
		    pub x: i32
		}
		impl AdHoc {
		    fn to_str(val self): str => "adhoc";
		}
		fn test(): str {
		    val a = AdHoc(1);
		    return "\${a}";
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Interpolation with ad-hoc to_str without Stringer trait must be rejected");

	println("  [PASS] test_interpolation_requires_to_str");
}


fn test_cast_null_to_non_null_pointer_rejected() {
	val src = """
		struct Node {
		    pub id: i32
		}
		fn test_cast(p: *Node?) {
		    val a = null as *Node;
		    val b = p as *Node;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_true(bp.errors.len >= 2, "Casting null or nullable pointer to non-nullable pointer must be rejected");
	println("  [PASS] test_cast_null_to_non_null_pointer_rejected");
}

fn test_unused_mutability_warning() {
	val src = """
		struct Item {
		    pub val: i32
		}
		impl Item {
		    pub fn query(var self): i32 => self.val;
		}
		fn compute(var x: i32): i32 => x + 1;
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_eq_usz(bp.errors.len, 0, "No errors expected");
	assert_eq_usz(bp.warnings.len, 2, "Must emit 2 warnings for unused var self and unused var param");
	println("  [PASS] test_unused_mutability_warning");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic BodyChecker tests...");
	test_cast_null_to_non_null_pointer_rejected();
	test_unused_mutability_warning();
	test_interpolation_requires_to_str();
	test_valid_program();
	test_undeclared_identifier();
	test_type_mismatch();
	test_condition_not_bool();
	test_return_type_mismatch();
	test_val_immutability();
	test_elvis_jump_restriction();
	test_defer_restrictions();
	println("[ALL PASSED] Bootstrap Semantic BodyChecker passed all tests successfully!");
	return 0;
}
