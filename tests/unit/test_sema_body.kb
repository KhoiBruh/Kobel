mod test.bootstrap_sema_body;

use std.io.print;
use std.io.println;

use compiler.lexer.Lexer;
use compiler.parser.*;

use compiler.semantic.checker.BodyChecker;


fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_usz(actual: usz, expected: usz, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		println(" (usz mismatch)");
	}
}

// ============================================================================
// Test 1: Valid Program Type Checking
// ============================================================================

fn test_valid_program() {
	val src = """
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		fn add(a: i32, b: i32): i32 => a + b;
		fn compute(p: &Point): i32 {
		    val factor = 2;
		    val sum = (p.x * factor) + p.y;
		    val is_positive = sum > 0;
		    if (is_positive) {
		        return sum;
		    } else {
		        return 0;
		    }
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var bp = BodyChecker();
	bp.check_program(prog);

	assert_eq_usz(bp.errors.len, 0, "Valid program must have 0 semantic errors");
	println("  [PASS] test_valid_program");
}

// ============================================================================
// Test 2: Undeclared Identifier Error Detection
// ============================================================================

fn test_undeclared_identifier() {
	val src = """
		fn test(): i32 {
		    return unknown_variable + 10;
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var bp = BodyChecker();
	bp.check_program(prog);

	assert_true(bp.errors.len >= 1, "Must catch undeclared identifier error");
	println("  [PASS] test_undeclared_identifier");
}

