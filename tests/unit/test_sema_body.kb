mod test.bootstrap_sema_body;

use std.io.print;
use std.io.println;

use compiler.lexer.lexer.Lexer;
use compiler.parser.parser.Parser;
use compiler.parser.decl.parse_program;

use compiler.sema.body_pass.BodyPass;
use compiler.sema.body_stmt.*;
use compiler.sema.body_expr.*;
use compiler.sema.body_call.*;
use compiler.sema.body_program.*;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_usz(actual: usz, expected: usz, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		println(" (usz mismatch)");
	}
}

// ============================================================================
// Test 1: Valid Program Type Checking
// ============================================================================

fn test_valid_program() {
	val src = "struct Point {\n" +
		"    pub x: i32,\n" +
		"    pub y: i32\n" +
		"}\n" +
		"fn add(a: i32, b: i32): i32 => a + b;\n" +
		"fn compute(p: &Point): i32 {\n" +
		"    val factor = 2;\n" +
		"    val sum = (p.x * factor) + p.y;\n" +
		"    val is_positive = sum > 0;\n" +
		"    if (is_positive) {\n" +
		"        return sum;\n" +
		"    } else {\n" +
		"        return 0;\n" +
		"    }\n" +
		"}\n";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var bp = BodyPass();
	bp.check_program(prog);

	assert_eq_usz(bp.errors.len, 0UZ, "Valid program must have 0 semantic errors");
	println("  [PASS] test_valid_program");
}

// ============================================================================
// Test 2: Undeclared Identifier Error Detection
// ============================================================================

fn test_undeclared_identifier() {
	val src = "fn test(): i32 {\n" +
		"    return unknown_variable + 10;\n" +
		"}\n";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var bp = BodyPass();
	bp.check_program(prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch undeclared identifier error");
	println("  [PASS] test_undeclared_identifier");
}

// ============================================================================
// Test 3: Type Mismatch in Declaration / Assignment
// ============================================================================

fn test_type_mismatch() {
	val src = "fn test(): none {\n" +
		"    val x: i32 = \"this is a string\";\n" +
		"}\n";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var bp = BodyPass();
	bp.check_program(prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch type mismatch error");
	println("  [PASS] test_type_mismatch");
}

