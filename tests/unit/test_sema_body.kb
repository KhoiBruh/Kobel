	bp.check_program(prog);

	assert_true(bp.errors.len >= 1, "Must catch return type mismatch error");
	println("  [PASS] test_return_type_mismatch");
}

// ============================================================================
// Test 6: Immutability Enforcement (val vs var)
// ============================================================================

fn test_val_immutability() {
	// 6a: Reassigning val variable
	val src1 = """
		fn test(): none {
		    val x = 10;
		    x = 20;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Must catch assignment to val variable");

	// 6b: Compound assignment to val variable
	val src2 = """
		fn test(): none {
		    val x = 10;
		    x += 5;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Must catch compound assignment to val variable");

	// 6c: Update (increment) on val variable
	val src3 = """
		fn test(): none {
		    val x = 10;
		    x++;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Must catch update on val variable");

	// 6d: Reassigning immutable parameter
	val src4 = """
		fn test(a: i32): none {
		    a = 20;
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Must catch assignment to immutable parameter");

	// 6e: Mutating field on *self receiver
	val src5 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(*self): none {
		        self.x = 20;
		    }
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Must catch field mutation on *self");

	// 6f: Mutations on var are allowed without errors
	val src6 = """
		struct Point { pub x: i32 }
		impl Point {
		    pub fn test(&self, var p: i32): none {
		        var x = 10;
		        x = 20;
		        x += 5;
		        x++;
		        p = 30;
		        p++;
		        self.x = 40;
		    }
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_eq_usz(bp6.errors.len, 0, "Mutations on var must produce 0 errors");

	// 6g: Calling mutating method on val variable
	val src7 = """
		struct Counter {
		    pub count: i32
		}
		impl Counter {
		    pub fn increment(&self) { self.count++; }
		}
		fn test(): none {
		    val c = Counter();
		    c.increment();
		}
	""";
	var l7 = Lexer(src7);
	var p7 = Parser(l7.tokenize());
	var bp7 = BodyChecker();
	bp7.check_program(p7.parse_program());
	assert_true(bp7.errors.len >= 1, "Must catch mutating method call on val variable");

	// 6h: Mutating field on val variable
	val src8 = """
		struct Point { pub x: i32 }
		fn test(): none {
		    val p = Point();
		    p.x = 10;
		}
	""";
	var l8 = Lexer(src8);
	var p8 = Parser(l8.tokenize());
	var bp8 = BodyChecker();
	bp8.check_program(p8.parse_program());
	assert_true(bp8.errors.len >= 1, "Must catch field mutation on val variable");

	// 6i: Calling write on read-only pointer
	val src9 = """
		fn test(p: *i32): none {
		    p.write(10);
		}
	""";
	var l9 = Lexer(src9);
	var p9 = Parser(l9.tokenize());
	var bp9 = BodyChecker();
	bp9.check_program(p9.parse_program());
	assert_true(bp9.errors.len >= 1, "Must catch write call on read-only pointer");

	// 6j: Calling method on moved value
	val src10 = """
		struct Resource { pub id: i32 }
		impl Resource {
		    pub fn consume(self): i32 => self.id;
		    pub fn peek(*self): i32 => self.id;
		}
		fn test(): none {
		    val r = Resource(1);
		    r.consume();
		    r.peek();
		}
	""";
	var l10 = Lexer(src10);
	var p10 = Parser(l10.tokenize());
	var bp10 = BodyChecker();
	bp10.check_program(p10.parse_program());
	assert_true(bp10.errors.len >= 1, "Must catch use of moved value");

	// 6k: Calling move method on pointer receiver
	val src11 = """
		struct Resource { pub id: i32 }
		impl Resource {
		    pub fn consume(self): i32 => self.id;
		}
		fn test(p: *Resource): none {
		    p.consume();
		}
	""";
	var l11 = Lexer(src11);
	var p11 = Parser(l11.tokenize());
	var bp11 = BodyChecker();
	bp11.check_program(p11.parse_program());
	assert_true(bp11.errors.len >= 1, "Must catch move method call on pointer receiver");

	println("  [PASS] test_val_immutability");
}

fn test_elvis_jump_restriction() {
	// 1. Allowed in variable declaration: val x = p ?: return;
	val src1 = """
		fn test(p: *i32?): i32 {
		    val x = p ?: return 0;
		    return *x;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_eq_usz(bp1.errors.len, 0, "Elvis with return in variable declaration must be allowed");

	// 2. Allowed in assignment: x = p ?: return;
	val src2 = """
		fn test(p: *i32?, var x: *i32): i32 {
		    x = p ?: return 0;
		    return *x;
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_eq_usz(bp2.errors.len, 0, "Elvis with return in assignment must be allowed");

	// 3. Allowed in statement expression: p ?: return;
	val src3 = """
		fn test(p: *i32?): i32 {
		    p ?: return 0;
		    return 1;
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_eq_usz(bp3.errors.len, 0, "Elvis with return in statement expression must be allowed");

	// 4. Disallowed in call argument: foo(p ?: return)
	val src4 = """
		fn foo(x: *i32): none {}
		fn test(p: *i32?): none {
		    foo(p ?: return);
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Elvis with return in call argument must be rejected");

	// 5. Disallowed in binary expression: 1 + (p ?: return)
	val src5 = """
		fn test(p: *i32?): i32 {
		    val x = 1 + *(p ?: return 0);
		    return x;
		}
	""";
	var l5 = Lexer(src5);
	var p5 = Parser(l5.tokenize());
	var bp5 = BodyChecker();
	bp5.check_program(p5.parse_program());
	assert_true(bp5.errors.len >= 1, "Elvis with return in binary sub-expression must be rejected");

	// 6. Disallowed in condition: if (p ?: return)
	val src6 = """
		fn test(p: *bool?): none {
		    if (p ?: return) {}
		}
	""";
	var l6 = Lexer(src6);
	var p6 = Parser(l6.tokenize());
	var bp6 = BodyChecker();
	bp6.check_program(p6.parse_program());
	assert_true(bp6.errors.len >= 1, "Elvis with return in if condition must be rejected");

	println("  [PASS] test_elvis_jump_restriction");
}

fn test_defer_restrictions() {
	// 1. Disallow return inside defer
	val src1 = """
		fn test(): none {
		    defer return;
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Return inside defer must be rejected");

	// 2. Disallow break inside defer
	val src2 = """
		fn test(): none {
		    while (true) {
		        defer break;
		    }
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Break inside defer must be rejected");

	// 3. Disallow continue inside defer
	val src3 = """
		fn test(): none {
		    while (true) {
		        defer continue;
		    }
		}
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Continue inside defer must be rejected");

	// 4. Disallow nested defer inside defer
	val src4 = """
		fn test(): none {
		    defer {
		        defer 1 + 2;
		    }
		}
	""";
	var l4 = Lexer(src4);
	var p4 = Parser(l4.tokenize());
	var bp4 = BodyChecker();
	bp4.check_program(p4.parse_program());
	assert_true(bp4.errors.len >= 1, "Nested defer inside defer must be rejected");

	println("  [PASS] test_defer_restrictions");
}

fn test_interpolation_requires_to_str() {
	val src1 = """
		struct NoString {
		    pub x: i32
		}
		fn test(): str {
		    val ns = NoString(1);
		    return "\${ns}";
		}
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Interpolation of struct without Stringer must be rejected");

	val src2 = """
		struct AdHoc {
		    pub x: i32
		}
		impl AdHoc {
		    fn to_str(*self): str => "adhoc";
		}
		fn test(): str {
		    val a = AdHoc(1);
		    return "\${a}";
		}
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Interpolation with ad-hoc to_str without Stringer trait must be rejected");

	println("  [PASS] test_interpolation_requires_to_str");
}


fn test_cast_null_to_non_null_pointer_rejected() {
	val src = """
		struct Node {
		    pub id: i32
		}
		fn test_cast(p: *Node?) {
		    val a = null as *Node;
		    val b = p as *Node;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_true(bp.errors.len >= 2, "Casting null or nullable pointer to non-nullable pointer must be rejected");
	println("  [PASS] test_cast_null_to_non_null_pointer_rejected");
}

fn test_unused_mutability_warning() {
	val src = """
		struct Item {
		    pub val: i32
		}
		impl Item {
		    pub fn query(&self): i32 => self.val;
		}
		fn compute(var x: i32): i32 => x + 1;
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_eq_usz(bp.errors.len, 0, "No errors expected");
	assert_eq_usz(bp.warnings.len, 2, "Must emit 2 warnings for unused &self and unused var param");
	println("  [PASS] test_unused_mutability_warning");
}

fn test_destructure_nullable_pointer_error() {
	val src = """
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		impl Point {
		    pub op unpack(*self, x: &i32, y: &i32) {
		        x.write(self.x);
		        y.write(self.y);
		    }
		}
		fn test(p: *Point?) {
		    val (x, y) = p;
		}
	""";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());

	assert_true(bp.errors.len > 0, "Destructuring nullable pointer must produce an error");
	println("  [PASS] test_destructure_nullable_pointer_error");
}

fn test_when_subject_and_implicit_dot_restrictions() {
	// 1. Disallow function/method call in when subject
	val src1 = """
		fn get_str(): str => "hello";
		fn test(): i32 => when (get_str()) {
		    "hello" -> 1;
		    else -> 0;
		};
	""";
	var l1 = Lexer(src1);
	var p1 = Parser(l1.tokenize());
	var bp1 = BodyChecker();
	bp1.check_program(p1.parse_program());
	assert_true(bp1.errors.len >= 1, "Function call in when subject must be rejected");

	// 2. Disallow leading '.' outside when (subject)
	val src2 = """
		fn test(s: str): bool => .empty();
	""";
	var l2 = Lexer(src2);
	var p2 = Parser(l2.tokenize());
	var bp2 = BodyChecker();
	bp2.check_program(p2.parse_program());
	assert_true(bp2.errors.len >= 1, "Leading '.' outside when subject must be rejected");

	// 3. Disallow non-bool implicit subject pattern in when (subject)
	val src3 = """
		fn test(s: str): i32 => when (s) {
		    .len -> 1;
		    else -> 0;
		};
	""";
	var l3 = Lexer(src3);
	var p3 = Parser(l3.tokenize());
	var bp3 = BodyChecker();
	bp3.check_program(p3.parse_program());
	assert_true(bp3.errors.len >= 1, "Non-bool implicit subject pattern in when must be rejected");

	println("  [PASS] test_when_subject_and_implicit_dot_restrictions");
}

fn check_single_error(src: str, desc: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	var bp = BodyChecker();
	bp.check_program(p.parse_program());
	val total_errs = p.errors.len + bp.errors.len;
	assert_true(total_errs >= 1, desc);
}

fn test_lambda_body_and_call_restrictions() {
	// 1. Passing lambda inside parentheses: fn({ x -> ... })
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply({ x -> x + 1 });
		""",
		"Lambda inside parentheses must be rejected"
	);

	// 2. Empty parentheses before trailing lambda: fn() { x -> ... }
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply() { x -> x + 1 };
		""",
		"Empty parens before single-arg trailing lambda must be rejected"
	);

	// 3. Storing lambda literal in a local variable
	check_single_error(
		"""
		fn test() {
		    val f = { x: i32 -> x + 1 };
		}
		""",
		"Storing lambda literal in variable must be rejected"
	);

	// 4. Escaping a lambda parameter by assigning to a variable
	check_single_error(
		"""
		fn test(f: (i32) -> i32) {
		    val saved = f;
		}
		""",
		"Escaping lambda parameter into local variable must be rejected"
	);

	// 5. Mutating captured outer `val` inside lambda
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 {
		    val limit = 10;
		    return apply { x ->
		        limit = 20;
		        yield x;
		    };
		}
		""",
		"Mutating captured outer val inside lambda must be rejected"
	);

	// 6. Shadowing outer local variable with lambda parameter
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 {
		    val x = 5;
		    return apply { x -> x + 1 };
		}
		""",
		"Shadowing outer local variable with lambda parameter must be rejected"
	);

	// 7. Using `return` inside a lambda
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { x ->
		    return x + 1;
		};
		""",
		"Using return inside lambda must be rejected"
	);

	// 8. Using `break` inside lambda to exit outer loop
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test() {
		    while (true) {
		        apply { x ->
		            break;
		            yield x;
		        };
		    }
		}
		""",
		"Using break inside lambda targeting outer loop must be rejected"
	);

	// 9. Multi-statement value-returning lambda missing `yield`
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { x ->
		    val y = x + 1;
		};
		""",
		"Multi-statement lambda without yield must be rejected"
	);

	// 10. Lambda parameter count mismatch
	check_single_error(
		"""
		fn apply(f: (i32) -> i32): i32 => f(1);
		fn test(): i32 => apply { a, b -> a + b };
		""",
		"Lambda parameter count mismatch must be rejected"
	);

	println("  [PASS] test_lambda_body_and_call_restrictions");
}

fn test_in_candidate_list_restrictions() {
	// 1. Standalone '[...]' array literal is rejected
	check_single_error(
		"""
		fn test() {
		    val x = [1, 2, 3];
		}
		""",
		"Standalone '[...]' array literal must be rejected"
	);

	// 2. Empty candidate list in 'in' is rejected
	check_single_error(
		"""
		fn test() {
		    if (1 in []) {}
		}
		""",
		"Empty candidate list in 'in' must be rejected"
	);

	// 3. Mismatched element type in 'in' candidate list is rejected
	check_single_error(
		"""
		fn test() {
		    if (1 in ["a", "b"]) {}
		}
		""",
		"Mismatched element type in 'in' candidate list must be rejected"
	);

	println("  [PASS] test_in_candidate_list_restrictions");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic BodyChecker tests...");
	test_when_subject_and_implicit_dot_restrictions();
	test_lambda_body_and_call_restrictions();
	test_in_candidate_list_restrictions();
	test_destructure_nullable_pointer_error();
	test_cast_null_to_non_null_pointer_rejected();
	test_unused_mutability_warning();
	test_interpolation_requires_to_str();
	test_valid_program();
	test_undeclared_identifier();
	test_type_mismatch();
	test_condition_not_bool();
	test_return_type_mismatch();
	test_val_immutability();
	test_elvis_jump_restriction();
	test_defer_restrictions();
	println("[ALL PASSED] Bootstrap Semantic BodyChecker passed all tests successfully!");
	return 0;
}
