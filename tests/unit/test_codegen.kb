mod test.bootstrap_codegen;

use std.io.print;
use std.io.println;
use std.filesystem.Path;
use std.memory.Arena;

use compiler.lexer.Lexer;
use compiler.parser.*;

use compiler.semantic.declaration.DeclarationCollector;
use compiler.semantic.checker.BodyChecker;
use compiler.semantic.lowering.LoweringPass;

use compiler.codegen.*;
use testsupport.assert.*;

// ============================================================================
// Test: Full End-to-End Pipeline (Kobel -> AST -> Sema -> C Code)
// ============================================================================

fn test_end_to_end_codegen() {
	val src = """
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		fn add(a: i32, b: i32): i32 => a + b;
		fn main() {
		    val p = Point(10, 20);
		    val total = add(p.x, p.y);
		    if (total == 0) return;
		}
	""";

	// 1. Lexer
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	// 2. Parser
	var parser = Parser(tokens);
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "Parser must have 0 syntax errors");

	// 3. Semantic Analysis (DeclPass + BodyPass)
	var bp = BodyChecker();
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "Semantic analysis must have 0 errors");

	// 4. Code Generation (C Backend)
	var codegen = CCodeGen(&bp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.len > 100, "Generated C code must not be empty");

	// Write the C code to a file so it can be compiled natively
	val out_p = Path("build/sample_pipeline_output.c");
	val ok_write = out_p.write_text(c_code);
	assert_true(ok_write, "Must write generated C code to file");

	println("  [PASS] test_end_to_end_codegen");
}

fn test_dce_prunes_unused_and_keeps_reachable() {
	val src = """
		const USED_CONST = 7;
		const UNUSED_CONST = 999;

		struct UsedStruct {
		    pub a: i32
		}

		struct UnusedStruct {
		    pub z: i32
		}

		enum UsedEnum {
		    Pair(x: i32, y: i32),
		    Empty
		}

		struct Box<T> {
		    pub item: T
		}

		impl Box<T> {
		    pub fn get(*self): T => self.item;
		    pub fn unused_method(*self): T => self.item;
		}

		fn used_fn(b: *Box<i32>): i32 => b.get() + USED_CONST;
		fn unused_helper(): i32 => UNUSED_CONST;

		fn sink(v: i32) {}

		fn main() {
		    val u = UsedStruct(1);
		    val b = Box<i32>(u.a);
		    val e = UsedEnum.Pair(2, 3);
		    if (e is UsedEnum.Pair as p) {
		        if (b.get() > 0 && u.a == 1 && u.a != 2) {
		            sink(used_fn(&b) + p.x);
		        }
		    }
		}
	""";

	var arena = Arena(65536);
	defer arena.free();

	var lexer = Lexer(src);
	var parser = Parser(lexer.tokenize());
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "DCE test source must parse cleanly");

	var dp = DeclarationCollector(arena);
	dp.collect_program(prog);
	assert_eq_usz(dp.errors.len, 0, "DCE test source must pass decl pass cleanly");

	var bp = BodyChecker(dp.symtab, dp);
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "DCE test source must typecheck cleanly");

	var lp = LoweringPass(bp.symtab, arena, dp);
	lp.lower_program(prog);

	var codegen = CCodeGen(&lp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.contains("used_fn("), "Live function used_fn must be kept");
	assert_true(c_code.contains("USED_CONST"), "Live constant USED_CONST must be kept");
	assert_true(c_code.contains("UsedStruct"), "Live struct UsedStruct must be kept");
	assert_true(c_code.contains("UsedEnum"), "Live enum UsedEnum must be kept");
	assert_true(!c_code.contains("unused_helper"), "Dead function unused_helper must be pruned");
	assert_true(!c_code.contains("UnusedStruct"), "Dead struct UnusedStruct must be pruned");
	assert_true(!c_code.contains("UNUSED_CONST"), "Dead constant UNUSED_CONST must be pruned");
	assert_true(!c_code.contains("unused_method"), "Unused generic method must be pruned");
	assert_true(!c_code.contains("if ((e."), "is-check condition must not emit double outer parens");
	assert_true(!c_code.contains("if (((Box_i32_get"), "Chained && conditions must flatten without nested parens");
	assert_true(!c_code.contains("(&("), "Payload is-cast must not double-wrap already wrapped subject");

	println("  [PASS] test_dce_prunes_unused_and_keeps_reachable");
}

fn test_dce_keeps_all_without_main() {
	val src = """
		struct LibStruct {
		    pub v: i32
		}
		fn library_fn(): i32 => 42;
	""";

	var lexer = Lexer(src);
	var parser = Parser(lexer.tokenize());
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "Library snippet must parse cleanly");

	var bp = BodyChecker();
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "Library snippet must typecheck cleanly");

	var codegen = CCodeGen(&bp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.contains("LibStruct"), "Library snippet without main keeps structs");
	assert_true(c_code.contains("library_fn"), "Library snippet without main keeps functions");

	println("  [PASS] test_dce_keeps_all_without_main");
}

fn test_minimal_parens_precedence() {
	val src = """
		const MACRO_SUM = 1 + 2;

		struct Wrap {
		    pub flag: bool,
		    pub v: i32
		}

		fn exprs(a: i32, b: i32, c: i32, w: ?*Wrap, ch: char): bool {
		    val k = (a + b) * c;
		    val m = a - (b + c);
		    val f = a + b - c;
		    val ternary_v = if (a > 0) b + 1 else c + MACRO_SUM;
		    val ok_range = ch in ['a'..'z'];
		    if (a == 1 || b == 2) {
		        return (a > 0 && b > 0) || c > 0;
		    }
		    if (w?.v == 1 && !(a > 0 && b < 0)) {
		        return k > m + f && ternary_v > 0 && ok_range;
		    }
		    return false;
		}
	""";

	var arena = Arena(65536);
	defer arena.free();

	var lexer = Lexer(src);
	var parser = Parser(lexer.tokenize());
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "Precedence test source must parse cleanly");

	var dp = DeclarationCollector(arena);
	dp.collect_program(prog);
	assert_eq_usz(dp.errors.len, 0, "Precedence test source must pass decl pass");

	var bp = BodyChecker(dp.symtab, dp);
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "Precedence test source must typecheck cleanly");

	var codegen = CCodeGen(&bp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.contains("#define MACRO_SUM (1 + 2)"), "Macro const keeps parens");
	assert_true(c_code.contains("(a + b) * c"), "Mul over add keeps parens");
	assert_true(c_code.contains("a - (b + c)"), "Right-hand add under minus keeps parens");
	assert_true(c_code.contains("a + b - c;"), "Left-associative add/sub drops parens");
	assert_true(c_code.contains("a > 0 ? b + 1 : c + MACRO_SUM;"), "Top-level if-expr drops parens");
	assert_true(c_code.contains("(ch >= 'a' && ch <= 'z') || (ch <= 'a' && ch >= 'z')"), "Range omits redundant atom parens");
	assert_true(!c_code.contains("((ch) >="), "Range must not double-wrap condition");
	assert_true(c_code.contains("if (a == 1 || b == 2)"), "Comparison inside || drops parens");
	assert_true(c_code.contains("(a > 0 && b > 0) || c > 0;"), "&& inside || keeps parens for clang");
	assert_true(c_code.contains("if (w != NULL && w->v == 1 && !(a > 0 && b < 0))"), "Safe cmp and negated && format cleanly");

	println("  [PASS] test_minimal_parens_precedence");
}

fn test_error_union_codegen_and_dce() {
	val src = """
		fault LiveErr {
		    Bad(code: i32)("Numeric validation failure"),
		    Other
		}
		fault DeadErr {
		    NeverUsed
		}
		fn helper(ok: bool): i32 ! LiveErr {
		    if (!ok) return LiveErr.Bad(42);
		    return 7;
		}
		fn main(): !LiveErr {
		    val v = helper(true)?;
		    if (v != 7) return LiveErr.Other;
		}
	""";

	var arena = Arena(65536);
	defer arena.free();

	var lexer = Lexer(src, 1);
	var parser = Parser(lexer.tokenize());
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "EU codegen test must parse cleanly");

	var dp = DeclarationCollector(arena);
	dp.symtab.sources.add_file("app/main.kb", "main", src);
	dp.collect_program(prog);
	assert_eq_usz(dp.errors.len, 0, "EU codegen test must collect decls cleanly");

	var bp = BodyChecker(dp.symtab, dp);
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "EU codegen test must typecheck cleanly");

	bp.decl.symtab = bp.symtab;
	var lp = LoweringPass(bp.symtab, arena, bp.decl);
	lp.lower_program(prog);

	var codegen = CCodeGen(&lp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.contains("__kobel_eu_"), "Emitted C must declare ErrorUnion structs");
	assert_true(c_code.contains("__kobel_fault_str_LiveErr"), "Live fault string helper must be emitted");
	assert_true(c_code.contains("__kobel_lookup_fault"), "Runtime fault lookup table must be emitted");
	assert_true(c_code.contains("Numeric validation failure"), "Custom fault variant description must appear in lookup table");
	assert_true(c_code.contains("__kobel_report_fault"), "Fault panic reporter helper must be emitted");
	assert_true(c_code.contains("\"app/main.kb\""), "Origin file path must be emitted on fault ctors");
	assert_true(c_code.contains("__kobel_unwrap_"), "ErrorUnion unwrap helper must be emitted");
	assert_true(c_code.contains("__kobel_user_main"), "main returning !E must generate C main wrapper");
	assert_true(!c_code.contains("DeadErr"), "DCE must prune unused FaultDecl");

	val any_src = """
		fault AErr {
		    Missing("Item missing")
		}
		fault BErr {
		    TimedOut("Timed out")
		}
		fn fa(): i32 ! AErr => AErr.Missing;
		fn fb(): !BErr => BErr.TimedOut;
		fn main() {
		    val a = fa()?;
		    val ua = fa()!;
		    fb()?;
		    if (a + ua == 0) return;
		}
	""";
	var l2 = Lexer(any_src, 1);
	var p2 = Parser(l2.tokenize());
	val prog2 = p2.parse_program();
	assert_eq_usz(p2.errors.len, 0, "Any-fault main codegen test must parse cleanly");
	var dp2 = DeclarationCollector(arena);
	dp2.symtab.sources.add_file("app/entry.kb", "main", any_src);
	dp2.collect_program(prog2);
	assert_eq_usz(dp2.errors.len, 0, "Any-fault main codegen test must collect decls");
	var bp2 = BodyChecker(dp2.symtab, dp2);
	bp2.check_program(prog2);
	assert_eq_usz(bp2.errors.len, 0, "Any-fault main codegen test must typecheck");
	bp2.decl.symtab = bp2.symtab;
	var lp2 = LoweringPass(bp2.symtab, arena, bp2.decl);
	lp2.lower_program(prog2);
	var cg2 = CCodeGen(&lp2.symtab);
	val c2 = cg2.gen_program(prog2);
	assert_true(c2.contains("__kobel_main_result __kobel_user_main"), "fn main() using ? must emit __kobel_main_result wrapper");
	assert_true(c2.contains("\"AErr.Missing\""), "AErr variant must be mapped in lookup table");
	assert_true(c2.contains("\"BErr.TimedOut\""), "BErr variant must be mapped in lookup table");
	assert_true(c2.contains("\"app/entry.kb\""), "Panic unwrap and propagation sites must include file location");

	println("  [PASS] test_error_union_codegen_and_dce");
}

fn main() {
	println("[RUNNING] Bootstrap C CodeGen tests...");
	test_end_to_end_codegen();
	test_dce_prunes_unused_and_keeps_reachable();
	test_dce_keeps_all_without_main();
	test_minimal_parens_precedence();
	test_error_union_codegen_and_dce();
	println("[ALL PASSED] Bootstrap C CodeGen passed all tests successfully!");
}
