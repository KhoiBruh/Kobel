mod test.bootstrap_codegen;

use std.io.print;
use std.io.println;
use std.filesystem.Path;

use compiler.lexer.Lexer;
use compiler.parser.*;

use compiler.semantic.checker.BodyChecker;

use compiler.codegen.*;
use testsupport.assert.*;

// ============================================================================
// Test: Full End-to-End Pipeline (Kobel -> AST -> Sema -> C Code)
// ============================================================================

fn test_end_to_end_codegen() {
	val src = """
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		fn add(a: i32, b: i32): i32 => a + b;
		fn main(): i32 {
		    val p = Point(10, 20);
		    val total = add(p.x, p.y);
		    return total;
		}
	""";

	// 1. Lexer
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	// 2. Parser
	var parser = Parser(tokens);
	val prog = parser.parse_program();
	assert_eq_usz(parser.errors.len, 0, "Parser must have 0 syntax errors");

	// 3. Semantic Analysis (DeclPass + BodyPass)
	var bp = BodyChecker();
	bp.check_program(prog);
	assert_eq_usz(bp.errors.len, 0, "Semantic analysis must have 0 errors");

	// 4. Code Generation (C Backend)
	var codegen = CCodeGen(&bp.symtab);
	val c_code = codegen.gen_program(prog);

	assert_true(c_code.len > 100, "Generated C code must not be empty");

	// Write the C code to a file so it can be compiled natively
	val out_p = Path("build/sample_pipeline_output.c");
	val ok_write = out_p.write_text(c_code);
	assert_true(ok_write, "Must write generated C code to file");

	println("  [PASS] test_end_to_end_codegen");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap C CodeGen tests...");
	test_end_to_end_codegen();
	println("[ALL PASSED] Bootstrap C CodeGen passed all tests successfully!");
	return 0;
}
