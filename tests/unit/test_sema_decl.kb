mod test.bootstrap_sema_decl;

use std.io.print;
use std.io.println;

use compiler.lexer.lexer.Lexer;
use compiler.parser.parser.Parser;
use compiler.parser.decl.parse_program;

use compiler.sema.types.DataType;

use compiler.sema.symbol.SymbolKind;

use compiler.sema.decl.pass.DeclPass;
use compiler.sema.decl.collect.*;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_str(actual: str, expected: str, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		print(" | Expected: '");
		print(expected);
		print("', got: '");
		print(actual);
		println("'");
	}
}

fn assert_eq_usz(actual: usz, expected: usz, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		println(" (usz mismatch)");
	}
}

// ============================================================================
// Test 1: Full Program Declaration Collection
// ============================================================================

fn test_collect_program() {
	val src = """
		mod sample.math;
		use std.io.println;
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		fn add(a: i32, b: i32): i32 => a + b;
		fn scale(p: &Point, factor: i32): none {
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val program_node = parser.parse_program();

	var decl_pass = DeclPass();
	decl_pass.collect_program(program_node);

	assert_eq_usz(decl_pass.errors.len, 0UZ, "DeclPass must have 0 errors");
	assert_eq_str(decl_pass.current_module, "sample.math", "Current module must match");

	// 1. Check the Symbol 'Point'
	val sym_pt = decl_pass.symtab.lookup("Point");
	assert_true(sym_pt != null, "Point struct must be defined in symbol table");
	assert_true(sym_pt.kind == SymbolKind.STRUCT, "Symbol kind must be STRUCT");
	assert_true(sym_pt.type_ptr.kind == DataType.STRUCT, "TypeKind must be STRUCT");

	val s_info = sym_pt.type_ptr.as_struct();
	assert_eq_str(s_info.name, "Point", "Struct name must match");
	assert_eq_usz(s_info.fields.len, 2UZ, "Point struct must have 2 fields");
	assert_eq_str(s_info.fields[0UZ].name, "x", "Field 0 must be x");
	assert_true(s_info.fields[0UZ].type_ptr.kind == DataType.I32, "Field x must be i32");
	assert_eq_str(s_info.fields[1UZ].name, "y", "Field 1 must be y");
	assert_true(s_info.fields[1UZ].type_ptr.kind == DataType.I32, "Field y must be i32");

	// 2. Check the Symbol 'add'
	val sym_add = decl_pass.symtab.lookup("add");
	assert_true(sym_add != null, "add function must be defined");
	assert_true(sym_add.kind == SymbolKind.FN, "Symbol kind must be FN");
	assert_true(sym_add.type_ptr.kind == DataType.FN, "TypeKind must be FN");

	val fn_add = sym_add.type_ptr.as_fn();
	assert_eq_usz(fn_add.param_types.len, 2UZ, "add must take 2 params");
	assert_true(fn_add.param_types[0UZ].kind == DataType.I32, "Param 0 must be i32");
	assert_true(fn_add.param_types[1UZ].kind == DataType.I32, "Param 1 must be i32");
	assert_true(fn_add.return_type.kind == DataType.I32, "add return type must be i32");

	// 3. Check the Symbol 'scale' (uses a pointer to struct Point)
	val sym_scale = decl_pass.symtab.lookup("scale");
	assert_true(sym_scale != null, "scale function must be defined");
	val fn_scale = sym_scale.type_ptr.as_fn();
	assert_eq_usz(fn_scale.param_types.len, 2UZ, "scale must take 2 params");

	val p0 = fn_scale.param_types[0UZ];
	assert_true(p0.kind == DataType.POINTER, "Param 0 of scale must be pointer");
	val p0_ptr = p0.as_pointer();
	assert_true(p0_ptr.is_mut, "Param 0 must be mutable pointer (&Point)");
	assert_true(p0_ptr.pointee.kind == DataType.STRUCT, "Pointee of scale param 0 must be Point struct");

	println("  [PASS] test_collect_program");
}

// ============================================================================
// Test 2: Duplicate Declaration Detection
// ============================================================================

fn test_duplicate_declarations() {
	val src = """
		fn compute(): i32 => 1;
		fn compute(): i32 => 2;
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val program_node = parser.parse_program();

	var decl_pass = DeclPass();
	decl_pass.collect_program(program_node);

	assert_eq_usz(decl_pass.errors.len, 1UZ, "Must record 1 duplicate error");
	println("  [PASS] test_duplicate_declarations");
}

// ============================================================================
// Test 3: Generic Trait Bounds Checking
// ============================================================================

fn test_generic_bounds_checking() {
	val src = """
		trait MyBound {
		    fn op(val self): i32;
		}
		struct Valid {
		    pub v: i32
		}
		impl MyBound for Valid {
		    fn op(val self): i32 => self.v;
		}
		struct Invalid {
		    pub v: i32
		}
		fn call_bound<T: MyBound>(val x: T): i32 => x.op();
		fn test(): i32 {
		    val a = call_bound<Valid>(Valid(1));
		    val b = call_bound<Invalid>(Invalid(2));
		    val c = call_bound<i32>(42);
		    return a;
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();
	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var decl_p = DeclPass();
	decl_p.collect_program(prog);

	assert_true(decl_p.errors.len >= 2UZ, "Instantiating with Invalid struct and i32 must fail bounds check");
	println("  [PASS] test_generic_bounds_checking");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic DeclPass tests...");
	test_generic_bounds_checking();
	test_collect_program();
	test_duplicate_declarations();
	println("[ALL PASSED] Bootstrap Semantic DeclPass passed all tests successfully!");
	return 0;
}
