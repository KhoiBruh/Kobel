mod test.bootstrap_sema_decl;

use std.io.print;
use std.io.println;

use compiler.lexer.Lexer;
use compiler.parser.*;

use compiler.semantic.types.DataType;

use compiler.semantic.symbols.SymbolKind;

use compiler.semantic.declaration.DeclarationCollector;
use testsupport.assert.*;

// ============================================================================
// Test 1: Full Program Declaration Collection
// ============================================================================

fn test_collect_program() {
	val src = """
		mod sample.math;
		use std.io.println;
		struct Point {
		    pub x: i32,
		    pub y: i32
		}
		fn add(a: i32, b: i32): i32 => a + b;
		fn scale(p: &Point, factor: i32): none {
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val program_node = parser.parse_program();

	var decl_pass = DeclarationCollector();
	decl_pass.collect_program(program_node);

	assert_eq_usz(decl_pass.errors.len, 0, "DeclarationCollector must have 0 errors");
	assert_eq_str(decl_pass.current_module, "sample.math", "Current module must match");

	// 1. Check the Symbol 'Point'
	val sym_pt = decl_pass.symtab.lookup("Point");
	assert_true(sym_pt != null, "Point struct must be defined in symbol table");
	assert_true(sym_pt!.kind == SymbolKind.STRUCT, "Symbol kind must be STRUCT");
	assert_true(sym_pt!.type_ptr.kind == DataType.STRUCT, "TypeKind must be STRUCT");

	val s_info = sym_pt!.type_ptr.as_struct()!;
	assert_eq_str(s_info.name, "Point", "Struct name must match");
	assert_eq_usz(s_info.fields.len, 2, "Point struct must have 2 fields");
	assert_eq_str(s_info.fields[0].name, "x", "Field 0 must be x");
	assert_true(s_info.fields[0].type_ptr.kind == DataType.I32, "Field x must be i32");
	assert_eq_str(s_info.fields[1].name, "y", "Field 1 must be y");
	assert_true(s_info.fields[1].type_ptr.kind == DataType.I32, "Field y must be i32");

	// 2. Check the Symbol 'add'
	val sym_add = decl_pass.symtab.lookup("add");
	assert_true(sym_add != null, "add function must be defined");
	assert_true(sym_add!.kind == SymbolKind.FN, "Symbol kind must be FN");
	assert_true(sym_add!.type_ptr.kind == DataType.FN, "TypeKind must be FN");

	val fn_add = sym_add!.type_ptr.as_fn()!;
	assert_eq_usz(fn_add.param_types.len, 2, "add must take 2 params");
	assert_true(fn_add.param_types[0].kind == DataType.I32, "Param 0 must be i32");
	assert_true(fn_add.param_types[1].kind == DataType.I32, "Param 1 must be i32");
	assert_true(fn_add.return_type.kind == DataType.I32, "add return type must be i32");

	// 3. Check the Symbol 'scale' (uses a pointer to struct Point)
	val sym_scale = decl_pass.symtab.lookup("scale");
	assert_true(sym_scale != null, "scale function must be defined");
	val fn_scale = sym_scale!.type_ptr.as_fn()!;
	assert_eq_usz(fn_scale.param_types.len, 2, "scale must take 2 params");

	val p0 = fn_scale.param_types[0];
	assert_true(p0.kind == DataType.POINTER, "Param 0 of scale must be pointer");
	val p0_ptr = p0.as_pointer()!;
	assert_true(p0_ptr.mutable, "Param 0 must be mutable pointer (&Point)");
	assert_true(p0_ptr.pointee.kind == DataType.STRUCT, "Pointee of scale param 0 must be Point struct");

	println("  [PASS] test_collect_program");
}

// ============================================================================
// Test 2: Duplicate Declaration Detection
// ============================================================================

fn test_duplicate_declarations() {
	val src = """
		fn compute(): i32 => 1;
		fn compute(): i32 => 2;
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val program_node = parser.parse_program();

	var decl_pass = DeclarationCollector();
	decl_pass.collect_program(program_node);

	assert_eq_usz(decl_pass.errors.len, 1, "Must record 1 duplicate error");
	println("  [PASS] test_duplicate_declarations");
}

// ============================================================================
// Test 3: Generic Trait Bounds Checking
// ============================================================================

fn test_generic_bounds_checking() {
	val src = """
		trait MyBound {
		    fn op(*self): i32;
		}
		struct Valid {
		    pub v: i32
		}
		impl MyBound for Valid {
		    fn op(*self): i32 => self.v;
		}
		struct Invalid {
		    pub v: i32
		}
		fn call_bound<T: MyBound>(x: T): i32 => x.op();
		fn test(): i32 {
		    val a = call_bound<Valid>(Valid(1));
		    val b = call_bound<Invalid>(Invalid(2));
		    val c = call_bound<i32>(42);
		    return a;
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();
	var parser = Parser(tokens);
	val prog = parser.parse_program();

	var decl_p = DeclarationCollector();
	decl_p.collect_program(prog);

	assert_true(decl_p.errors.len >= 2, "Instantiating with Invalid struct and i32 must fail bounds check");
	println("  [PASS] test_generic_bounds_checking");
}

// ============================================================================
// Test 4: Lambda Declaration Safety Rules
// ============================================================================

fn test_lambda_declaration_restrictions() {
	val src = """
		fn bad_multi(a: (i32) -> i32, b: (i32) -> i32) {}
		fn bad_non_final(f: (i32) -> i32, x: i32) {}
		fn bad_ret(): (i32) -> i32 {}
		struct BadStruct {
		    pub cb: (i32) -> i32
		}
		enum BadEnum {
		    Cb(f: (i32) -> i32),
		    None
		}
	""";

	var lexer = Lexer(src);
	var parser = Parser(lexer.tokenize());
	val prog = parser.parse_program();

	var decl_p = DeclarationCollector();
	decl_p.collect_program(prog);

	assert_true(decl_p.errors.len >= 5, "Must reject multiple/non-final/return/struct/enum lambda types");
	println("  [PASS] test_lambda_declaration_restrictions");
}

fn test_fault_and_error_union_decl() {
	val ok_src = """
		fault IoErr {
			NotFound,
			Fail(code: i32)
		}
		fn read(): i32 ! IoErr { return 1; }
		fn ping(): !IoErr { return; }
	""";
	var l_ok = Lexer(ok_src);
	var p_ok = Parser(l_ok.tokenize());
	val prog_ok = p_ok.parse_program();
	var d_ok = DeclarationCollector();
	d_ok.collect_program(prog_ok);
	assert_eq_usz(d_ok.errors.len, 0, "Valid fault & error union decls must collect cleanly");
	val sym_flt = d_ok.symtab.lookup("IoErr");
	assert_true(sym_flt != null, "IoErr symbol must exist");
	if (sym_flt != null) {
		assert_true(sym_flt.type_ptr.is_fault(), "IoErr symbol must be marked as fault");
	}
	val sym_read = d_ok.symtab.lookup("read");
	assert_true(sym_read != null, "read symbol must exist");
	if (sym_read != null) {
		val rfn = sym_read.type_ptr.as_fn();
		assert_true(rfn != null, "read must have FnType");
		if (rfn != null) {
			assert_true(rfn.return_type.kind == DataType.ERROR_UNION, "read return type must be ERROR_UNION");
		}
	}

	val bad_src = """
		enum NotAFault { A, B }
		fault RealFault { Err }
		fn bad_non_fault(x: i32 ! NotAFault) {}
		fn bad_prim_err(x: i32 ! i32) {}
		fn bad_nested(x: (i32 ! RealFault) ! RealFault) {}
		fn bad_same(x: RealFault ! RealFault) {}
		fn bad_fn_ok(x: ((i32) -> i32) ! RealFault) {}
		fn good_var_param(x: i32 ! NotAFault) {}
	""";
	var l_bad = Lexer(bad_src);
	var p_bad = Parser(l_bad.tokenize());
	val prog_bad = p_bad.parse_program();
	var d_bad = DeclarationCollector();
	d_bad.collect_program(prog_bad);
	assert_true(d_bad.errors.len >= 5, "Must reject non-fault error, nested error union, identical ok/err, and fn ok type");
	println("  [PASS] test_fault_and_error_union_decl");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic DeclarationCollector tests...");
	test_generic_bounds_checking();
	test_lambda_declaration_restrictions();
	test_fault_and_error_union_decl();
	test_collect_program();
	test_duplicate_declarations();
	println("[ALL PASSED] Bootstrap Semantic DeclarationCollector passed all tests successfully!");
	return 0;
}
