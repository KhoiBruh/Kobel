mod tests.unit.test_config;

use std.io.*;
use std.filesystem.Path;
use std.process.Process;
use config.*;

fn test_toml_parser(): bool {
	val toml_content = """
		# Kobel Project Configuration
		[package]
		name = "my_project"
		version = "0.2.1"

		[build]
		entry = "src/app.kb"
		output = "bin/app.exe"
		cc = "clang"

		[test]
		dir = "my_tests"
	""";

	val doc = Toml.parse(toml_content) !: return false;

	if (doc.get("package.name", "") != "my_project") return false;
	if (doc.get("package.version", "") != "0.2.1") return false;
	if (doc.get("build.entry", "") != "src/app.kb") return false;
	if (doc.get("build.output", "") != "bin/app.exe") return false;
	if (doc.get("build.cc", "") != "clang") return false;
	if (doc.get("test.dir", "") != "my_tests") return false;

	// Default fallback vs explicit ConfigErr.KeyNotFound
	if (doc.get("nonexistent.key", "fallback") != "fallback") return false;
	val miss = doc.try_get("nonexistent.key");
	if (miss !is ConfigErr.KeyNotFound) return false;

	return true;
}

fn test_config_errors(): bool {
	val bad_hdr = Toml.parse("[unclosed");
	if (bad_hdr !is ConfigErr.MalformedHeader) return false;
	val bad_line = Toml.parse("not_a_kv_pair");
	if (bad_line !is ConfigErr.MalformedLine) return false;
	val empty_key = Toml.parse("= \"val\"");
	if (empty_key !is ConfigErr.EmptyKey) return false;
	val bad_str = Toml.parse("name = \"unterminated");
	if (bad_str !is ConfigErr.UnterminatedString) return false;
	val missing_cfg = ProjectConfig.load("build/__missing_manifest__.toml");
	if (missing_cfg !is ConfigErr.ManifestNotFound) return false;
	return true;
}

fn test_default_config(): bool {
	val cfg = ProjectConfig();
	if (cfg.name != "kobel") return false;
	if (cfg.version != "1.0.0") return false;
	if (cfg.entry != "src/main.kb") return false;
	if (cfg.output != "build/kobel.exe") return false;
	if (cfg.cc != "cl") return false;
	if (cfg.test_dir != "tests") return false;

	return true;
}

fn test_toml_iteration(): bool {
	val toml_content = """
		[package]
		name = "foo"
		version = "1.2.3"
	""";
	val doc = Toml.parse(toml_content) !: return false;
	var count = 0;
	for ((k, v) in doc) {
		if (k == "package.name" && v == "foo") count++;
		if (k == "package.version" && v == "1.2.3") count++;
	}
	return count == 2;
}

fn test_entry_precedence(): bool {
	val tmp_path = "build/test_prec.toml";
	val p = Path(tmp_path);
	p.write_text("""
		[package]
		entry = "src/main.kb"

		[build]
		entry = "src/other.kb"
	""") !: return false;
	defer {
		if (p.exists()) {
			p.remove() !: err -> {};
		}
	}

	val cfg = ProjectConfig.load(tmp_path) !: return false;
	return cfg.entry == "src/main.kb";
}

fn run_tests(): i32 {
	println("[RUNNING] Test Mini-TOML & Project Configuration...");

	if (!test_toml_parser()) {
		println("  [FAIL] test_toml_parser");
		return 1;
	}
	println("  [PASS] test_toml_parser");

	if (!test_toml_iteration()) {
		println("  [FAIL] test_toml_iteration");
		return 1;
	}
	println("  [PASS] test_toml_iteration");

	if (!test_default_config()) {
		println("  [FAIL] test_default_config");
		return 1;
	}
	println("  [PASS] test_default_config");

	if (!test_entry_precedence()) {
		println("  [FAIL] test_entry_precedence");
		return 1;
	}
	println("  [PASS] test_entry_precedence");

	if (!test_config_errors()) {
		println("  [FAIL] test_config_errors");
		return 1;
	}
	println("  [PASS] test_config_errors");

	println("[ALL PASSED] Mini-TOML and Project Config tests passed successfully!");
	return 0;
}

fn main() {
	if (run_tests() != 0) Process.exit(1);
}
