mod test.bootstrap_ast;

use std.io.print;
use std.io.println;

use compiler.ast.node.NodeKind;
use compiler.ast.node.NodeData;
use compiler.ast.node.AstNode;

use compiler.ast.types.NamedType;
use compiler.ast.types.PointerType;
use compiler.ast.types.ArrayType;

use compiler.ast.expr.LiteralKind;
use compiler.ast.expr.LiteralExpr;
use compiler.ast.expr.IdentifierExpr;
use compiler.ast.expr.BinaryExpr;
use compiler.ast.expr.UnaryExpr;
use compiler.ast.expr.GroupExpr;

use compiler.ast.stmt.BlockStmt;
use compiler.ast.stmt.ExprStmt;
use compiler.ast.stmt.VarDeclStmt;
use compiler.ast.stmt.IfStmt;
use compiler.ast.stmt.ReturnStmt;

use compiler.ast.decl.Param;
use compiler.ast.decl.GenericParam;
use compiler.ast.decl.FnDecl;

use compiler.ast.builder.*;
use compiler.ast.decl.Program;

use compiler.lexer.token.TokenType;
use std.collections.list.List;
use std.mem.arena.Arena;

// Simple string-to-int helper for our test evaluator
fn parse_i32(s: str): i32 {
	var res: i32 = 0;
	for (i in 0..<s.len) {
		val c = s[i];
		if (c >= '0' && c <= '9') {
			val digit = (c as i32) - ('0' as i32);
			res = res * 10 + digit;
		}
	}
	return res;
}

// Tree traversal using when (node.kind) statement
fn eval_expr(node: *AstNode): i32 {
	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = node.as_literal_expr();
			return parse_i32(lit.raw_text);
		}
		NodeKind.EXPR_GROUP -> {
			val grp = node.as_group_expr();
			return eval_expr(grp.expr);
		}
		NodeKind.EXPR_BINARY -> {
			val bin = node.as_binary_expr();
			val l = eval_expr(bin.left);
			val r = eval_expr(bin.right);
			when (bin.op) {
				TokenType.PLUS -> return l + r;
				TokenType.MINUS -> return l - r;
				TokenType.STAR -> return l * r;
				TokenType.SLASH -> return l / r;
				else -> return 0;
			}
		}
		else -> return 0;
	}
	return 0;
}

fn test_expression_tree(): bool {
	var arena = Arena(16384UZ);
	defer arena.delete();

	// Build: (10 + 20) * 3
	val lit10 = arena.literal(LiteralKind.INT, "10", 1UZ, 2UZ);
	val lit20 = arena.literal(LiteralKind.INT, "20", 1UZ, 7UZ);
	val add_expr = arena.binary(TokenType.PLUS, lit10, lit20, 1UZ, 5UZ);
	val group_expr = arena.group(add_expr, 1UZ, 1UZ);

	val lit3 = arena.literal(LiteralKind.INT, "3", 1UZ, 12UZ);
	val mul_expr = arena.binary(TokenType.STAR, group_expr, lit3, 1UZ, 10UZ);

	if (mul_expr.kind != NodeKind.EXPR_BINARY) return false;

	val bin = mul_expr.as_binary_expr();
	if (bin.op != TokenType.STAR) return false;
	if (bin.right.kind != NodeKind.EXPR_LITERAL) return false;

	val r_lit = bin.right.as_literal_expr();
	if (r_lit.raw_text != "3") return false;

	if (bin.left.kind != NodeKind.EXPR_GROUP) return false;
	val grp = bin.left.as_group_expr();
	if (grp.expr.kind != NodeKind.EXPR_BINARY) return false;

	// Evaluate tree
	val val_result = eval_expr(mul_expr);
	if (val_result != 90) return false;

	return true;
}

fn test_statement_nodes(): bool {
	var arena = Arena(16384UZ);
	defer arena.delete();

	// var count: i32 = 42;
	val ty_i32 = arena.named_type("i32", List<*AstNode>(), 1UZ, 12UZ);
	val lit42 = arena.literal(LiteralKind.INT, "42", 1UZ, 18UZ);
	val var_stmt = arena.var_decl(true, "count", ty_i32, lit42, 1UZ, 1UZ);

	if (var_stmt.kind != NodeKind.STMT_VAR_DECL) return false;
	val vd = var_stmt.as_var_decl_stmt();
	if (!vd.is_mut || vd.name != "count") return false;
	if (vd.type_annotation.kind != NodeKind.TYPE_NAMED) return false;
	if (vd.initializer.kind != NodeKind.EXPR_LITERAL) return false;

	// return count;
	val id_count = arena.identifier("count", 2UZ, 8UZ);
	val ret_stmt = arena.return_stmt(id_count, 2UZ, 1UZ);
	if (ret_stmt.kind != NodeKind.STMT_RETURN) return false;

	// { return count; }
	var stmts = List<*AstNode>();
	stmts += ret_stmt;
	val block = arena.block_stmt(stmts, 2UZ, 1UZ);
	if (block.kind != NodeKind.STMT_BLOCK) return false;
	val blk = block.as_block_stmt();
	if (blk.statements.len != 1UZ) return false;

	// if (count > 0) { return count; }
	val lit0 = arena.literal(LiteralKind.INT, "0", 3UZ, 13UZ);
	val cond = arena.binary(TokenType.GREATER, id_count, lit0, 3UZ, 11UZ);
	val if_stmt = arena.if_stmt(cond, block, null, 3UZ, 1UZ);

	if (if_stmt.kind != NodeKind.STMT_IF) return false;
	val ifs = if_stmt.as_if_stmt();
	if (ifs.condition.kind != NodeKind.EXPR_BINARY) return false;
	if (ifs.then_branch.kind != NodeKind.STMT_BLOCK) return false;

	return true;
}

fn test_declaration_nodes(): bool {
	var arena = Arena(16384UZ);
	defer arena.delete();

	// fn add(a: i32, b: i32): i32 { return a + b; }
	var params = List<Param>();
	val ty_i32 = arena.named_type("i32", List<*AstNode>(), 1UZ, 1UZ);
	params += Param("a", ty_i32, false, false, null);
	params += Param("b", ty_i32, false, false, null);

	val id_a = arena.identifier("a", 1UZ, 1UZ);
	val id_b = arena.identifier("b", 1UZ, 1UZ);
	val add_expr = arena.binary(TokenType.PLUS, id_a, id_b, 1UZ, 1UZ);
	val ret_stmt = arena.return_stmt(add_expr, 1UZ, 1UZ);

	var body_stmts = List<*AstNode>();
	body_stmts += ret_stmt;
	val body = arena.block_stmt(body_stmts, 1UZ, 1UZ);

	val fn_node = arena.fn_decl(
		"add",
		List<GenericParam>(),
		params,
		ty_i32,
		body,
		true,
		1UZ,
		1UZ
	);

	if (fn_node.kind != NodeKind.DECL_FN) return false;
	val fn_d = fn_node.as_fn_decl();
	if (fn_d.name != "add") return false;
	if (!fn_d.is_pub) return false;
	if (fn_d.params.len != 2UZ) return false;
	if (fn_d.params[0UZ].name != "a") return false;
	if (fn_d.params[1UZ].name != "b") return false;

	return true;
}

fn test_program_iterable(): bool {
	var arena = Arena();
	defer arena.delete();
	var decls = List<*AstNode>();
	val d1 = arena.fn_decl("f1", List<GenericParam>(), List<Param>(), null, null, true, 1UZ, 1UZ);
	val d2 = arena.fn_decl("f2", List<GenericParam>(), List<Param>(), null, null, true, 2UZ, 1UZ);
	decls += d1;
	decls += d2;
	val prog_node = arena.program(decls, 1UZ, 1UZ);
	val prog = prog_node.as_program();

	var count: usz = 0;
	for (d in prog) {
		count = count + 1UZ;
	}
	if (count != 2UZ) return false;

	val p_val = *prog;
	var count2: usz = 0;
	for (d in p_val) {
		count2 = count2 + 1UZ;
	}
	if (count2 != 2UZ) return false;

	return true;
}

fn test_arena_ast_methods(): bool {
	var arena = Arena();
	defer arena.delete();

	val lit_node = arena.literal(LiteralKind.INT, "123", 1UZ, 1UZ);
	val lit = lit_node.as_literal_expr();
	if (lit.raw_text != "123") return false;
	val lit_to = lit_node.as_literal_expr();
	if (lit_to.raw_text != "123") return false;

	val id_node = arena.identifier("x", 1UZ, 5UZ);
	val id = id_node.as_identifier_expr();
	if (id.name != "x") return false;
	val id_to = id_node.as_identifier_expr();
	if (id_to.name != "x") return false;

	val bin_node = arena.binary(TokenType.PLUS, lit_node, id_node, 1UZ, 3UZ);
	val bin = bin_node.as_binary_expr();
	if (bin.op != TokenType.PLUS) return false;
	if (bin.left.as_literal_expr().raw_text != "123") return false;
	if (bin.right.as_identifier_expr().name != "x") return false;

	val fn_node = arena.fn_decl("test_fn", List<GenericParam>(), List<Param>(), null, null, true, 2UZ, 1UZ);
	val fn_d = fn_node.as_fn_decl();
	if (fn_d.name != "test_fn") return false;
	if (!fn_d.is_pub) return false;

	// Test arena.alloc_node + a typed NodeData payload
	val m_lit = arena.alloc_node(LiteralExpr.TAG, NodeData.LiteralExpr(arena.alloc_val<LiteralExpr>(LiteralExpr(LiteralKind.INT, "456"))), 3UZ, 1UZ);
	if (m_lit.kind != NodeKind.EXPR_LITERAL) return false;
	if (m_lit.as_literal_expr().raw_text != "456") return false;

	val m_id = arena.alloc_node(IdentifierExpr.TAG, NodeData.IdentifierExpr(arena.alloc_val<IdentifierExpr>(IdentifierExpr("y"))), 3UZ, 5UZ);
	if (m_id.kind != NodeKind.EXPR_IDENTIFIER) return false;
	if (m_id.as_identifier_expr().name != "y") return false;

	val m_bin = arena.alloc_node(BinaryExpr.TAG, NodeData.BinaryExpr(arena.alloc_val<BinaryExpr>(BinaryExpr(m_lit, TokenType.STAR, m_id))), 3UZ, 3UZ);
	if (m_bin.kind != NodeKind.EXPR_BINARY) return false;
	val bin_d = m_bin.as_binary_expr();
	if (bin_d.op != TokenType.STAR) return false;
	if (bin_d.left.as_literal_expr().raw_text != "456") return false;
	if (bin_d.right.as_identifier_expr().name != "y") return false;

	return true;
}

fn main(): i32 {
	println("[RUNNING] Bootstrap AST tests...");

	if (!test_expression_tree()) {
		println("  [FAIL] test_expression_tree");
		return 1;
	}
	println("  [PASS] test_expression_tree");
	if (!test_statement_nodes()) {
		println("  [FAIL] test_statement_nodes");
		return 1;
	}
	println("  [PASS] test_statement_nodes");

	if (!test_declaration_nodes()) {
		println("  [FAIL] test_declaration_nodes");
		return 1;
	}
	println("  [PASS] test_declaration_nodes");

	if (!test_program_iterable()) {
		println("  [FAIL] test_program_iterable");
		return 1;
	}
	println("  [PASS] test_program_iterable");

	if (!test_arena_ast_methods()) {
		println("  [FAIL] test_arena_ast_methods");
		return 1;
	}
	println("  [PASS] test_arena_ast_methods");

	println("[ALL PASSED] Bootstrap AST passed all tests successfully!");
	return 0;
}
