mod test.bootstrap_ast;

use std.io.print;
use std.io.println;

use compiler.ast.*;






use compiler.lexer.TokenType;
use std.collections.List;
use std.memory.Arena;

// Simple string-to-int helper for our test evaluator
fn parse_i32(s: str): i32 {
	var res: i32 = 0;
	for (i in 0..<s.len) {
		val c = s[i];
		if (c >= '0' && c <= '9') {
			val digit = c.code() - '0'.code();
			res = res * 10 + digit;
		}
	}
	return res;
}

// Tree traversal using when statement
fn eval_expr(node: *AstNode): i32 {
	return when (node) {
		is LiteralExpr as lit -> parse_i32(lit.raw_text);
		is GroupExpr as grp -> eval_expr(grp.expr);
		is BinaryExpr as bin -> {
			val l = eval_expr(bin.left);
			val r = eval_expr(bin.right);
			yield when (bin.op) {
				TokenType.PLUS -> l + r;
				TokenType.MINUS -> l - r;
				TokenType.STAR -> l * r;
				TokenType.SLASH -> l / r;
				else -> 0;
			};
		}
		else -> 0;
	};
}

fn test_expression_tree(): bool {
	var arena = Arena(16384);
	defer arena.free();

	// Build: (10 + 20) * 3
	val lit10 = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "10"), 1, 2);
	val lit20 = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "20"), 1, 7);
	val add_expr = arena.node(NodeData.BinaryExpr(lit10, TokenType.PLUS, lit20), 1, 5);
	val group_expr = arena.node(NodeData.GroupExpr(add_expr), 1, 1);

	val lit3 = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "3"), 1, 12);
	val mul_expr = arena.node(NodeData.BinaryExpr(group_expr, TokenType.STAR, lit3), 1, 10);

	if (mul_expr is BinaryExpr as bin) {
		if (bin.op != TokenType.STAR) return false;
		if (bin.right is LiteralExpr as r_lit) {
			if (r_lit.raw_text != "3") return false;
		} else return false;
		if (bin.left is GroupExpr as grp) {
			if (!(grp.expr is BinaryExpr)) return false;
		} else return false;
	} else return false;

	// Evaluate tree
	val val_result = eval_expr(mul_expr);
	if (val_result != 90) return false;

	return true;
}

fn test_statement_nodes(): bool {
	var arena = Arena(16384);
	defer arena.free();

	// var count: i32 = 42;
	val ty_i32 = arena.node(NodeData.NamedType("i32", List<*AstNode>()), 1, 12);
	val lit42 = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "42"), 1, 18);
	val var_stmt = arena.node(NodeData.VarDeclStmt(true, "count", ty_i32, lit42), 1, 1);

	if (var_stmt is VarDeclStmt as vd) {
		if (!vd.mutable || vd.name != "count") return false;
		if (!(vd.type_annotation is NamedType)) return false;
		if (!(vd.initializer is LiteralExpr)) return false;
	} else return false;

	// return count;
	val id_count = arena.node(NodeData.IdentifierExpr("count"), 2, 8);
	val ret_stmt = arena.node(NodeData.ReturnStmt(id_count), 2, 1);
	if (!(ret_stmt is ReturnStmt)) return false;

	// { return count; }
	var stmts = List<*AstNode>();
	stmts += ret_stmt;
	val block = arena.node(NodeData.BlockStmt(stmts), 2, 1);
	if (block is BlockStmt as blk) {
		if (blk.statements.len != 1) return false;
	} else return false;

	// if (count > 0) { return count; }
	val lit0 = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "0"), 3, 13);
	val cond = arena.node(NodeData.BinaryExpr(id_count, TokenType.GREATER, lit0), 3, 11);
	val if_stmt = arena.node(NodeData.IfStmt(cond, block, null), 3, 1);

	if (if_stmt is IfStmt as ifs) {
		if (!(ifs.condition is BinaryExpr)) return false;
		if (!(ifs.then_branch is BlockStmt)) return false;
	} else return false;

	return true;
}

fn test_declaration_nodes(): bool {
	var arena = Arena(16384);
	defer arena.free();

	// fn add(a: i32, b: i32): i32 { return a + b; }
	var params = List<Param>();
	val ty_i32 = arena.node(NodeData.NamedType("i32", List<*AstNode>()), 1, 1);
	params += Param("a", ty_i32, false, false, null);
	params += Param("b", ty_i32, false, false, null);

	val id_a = arena.node(NodeData.IdentifierExpr("a"), 1, 1);
	val id_b = arena.node(NodeData.IdentifierExpr("b"), 1, 1);
	val add_expr = arena.node(NodeData.BinaryExpr(id_a, TokenType.PLUS, id_b), 1, 1);
	val ret_stmt = arena.node(NodeData.ReturnStmt(add_expr), 1, 1);

	var body_stmts = List<*AstNode>();
	body_stmts += ret_stmt;
	val body = arena.node(NodeData.BlockStmt(body_stmts), 1, 1);

	val fn_node = arena.node(
		NodeData.FnDecl("add", List<GenericParam>(), params, ty_i32, body, true, false, false, ""),
		1,
		1
	);

	if (fn_node is FnDecl as fn_d) {
		if (fn_d.name != "add") return false;
		if (!fn_d.public) return false;
		if (fn_d.params.len != 2) return false;
		if (fn_d.params[0].name != "a") return false;
		if (fn_d.params[1].name != "b") return false;
	} else return false;

	return true;
}

fn test_program_iterable(): bool {
	var arena = Arena();
	defer arena.free();
	var decls = List<*AstNode>();
	val d1 = arena.node(NodeData.FnDecl("f1", List<GenericParam>(), List<Param>(), null, null, true, false, false, ""), 1, 1);
	val d2 = arena.node(NodeData.FnDecl("f2", List<GenericParam>(), List<Param>(), null, null, true, false, false, ""), 2, 1);
	decls += d1;
	decls += d2;
	val prog_node = arena.node(NodeData.Program(decls), 1, 1);
	if (prog_node is Program as prog) {
		var count: usz = 0;
		for (d in prog) {
			count = count + 1;
		}
		if (count != 2) return false;

		val p_val = *prog;
		var count2: usz = 0;
		for (d in p_val) {
			count2 = count2 + 1;
		}
		if (count2 != 2) return false;
	} else return false;

	return true;
}

fn test_arena_ast_methods(): bool {
	var arena = Arena();
	defer arena.free();

	val lit_node = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "123"), 1, 1);
	if (lit_node is LiteralExpr as lit) {
		if (lit.raw_text != "123") return false;
	} else return false;

	val id_node = arena.node(NodeData.IdentifierExpr("x"), 1, 5);
	if (id_node is IdentifierExpr as id) {
		if (id.name != "x") return false;
	} else return false;

	val bin_node = arena.node(NodeData.BinaryExpr(lit_node, TokenType.PLUS, id_node), 1, 3);
	if (bin_node is BinaryExpr as bin) {
		if (bin.op != TokenType.PLUS) return false;
		if (bin.left is LiteralExpr as l_lit) {
			if (l_lit.raw_text != "123") return false;
		} else return false;
		if (bin.right is IdentifierExpr as r_id) {
			if (r_id.name != "x") return false;
		} else return false;
	} else return false;

	val fn_node = arena.node(NodeData.FnDecl("test_fn", List<GenericParam>(), List<Param>(), null, null, true, false, false, ""), 2, 1);
	if (fn_node is FnDecl as fn_d) {
		if (fn_d.name != "test_fn") return false;
		if (!fn_d.public) return false;
	} else return false;

	// Test arena.alloc_node + a typed NodeData payload
	val m_lit = arena.node(NodeData.LiteralExpr(LiteralKind.INT, "456"), 3, 1);
	if (m_lit is LiteralExpr as m_lit_e) {
		if (m_lit_e.raw_text != "456") return false;
	} else return false;

	val m_id = arena.node(NodeData.IdentifierExpr("y"), 3, 5);
	if (m_id is IdentifierExpr as m_id_e) {
		if (m_id_e.name != "y") return false;
	} else return false;

	val m_bin = arena.node(NodeData.BinaryExpr(m_lit, TokenType.STAR, m_id), 3, 3);
	if (m_bin is BinaryExpr as bin_d) {
		if (bin_d.op != TokenType.STAR) return false;
		if (bin_d.left is LiteralExpr as bl_lit) {
			if (bl_lit.raw_text != "456") return false;
		} else return false;
		if (bin_d.right is IdentifierExpr as br_id) {
			if (br_id.name != "y") return false;
		} else return false;
	} else return false;

	return true;
}

fn main(): i32 {
	println("[RUNNING] Bootstrap AST tests...");

	if (!test_expression_tree()) {
		println("  [FAIL] test_expression_tree");
		return 1;
	}
	println("  [PASS] test_expression_tree");
	if (!test_statement_nodes()) {
		println("  [FAIL] test_statement_nodes");
		return 1;
	}
	println("  [PASS] test_statement_nodes");

	if (!test_declaration_nodes()) {
		println("  [FAIL] test_declaration_nodes");
		return 1;
	}
	println("  [PASS] test_declaration_nodes");

	if (!test_program_iterable()) {
		println("  [FAIL] test_program_iterable");
		return 1;
	}
	println("  [PASS] test_program_iterable");

	if (!test_arena_ast_methods()) {
		println("  [FAIL] test_arena_ast_methods");
		return 1;
	}
	println("  [PASS] test_arena_ast_methods");

	println("[ALL PASSED] Bootstrap AST passed all tests successfully!");
	return 0;
}
