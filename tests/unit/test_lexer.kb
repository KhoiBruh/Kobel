mod test.bootstrap_lexer;

use std.io.print;
use std.io.println;

use compiler.lexer.token.TokenType;
use compiler.lexer.token.Token;

use compiler.lexer.lexer.Lexer;

use std.collections.list.List;
use std.str.str_from_bytes;
use std.mem.alloc.alloc_array;

fn test_keywords(): bool {
	val code: str = "extern struct fn return const null true false val var as while break continue if else when mod use pub trait impl for defer";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 25) {
		println("  [ERR] Keyword token count mismatch");
		return false;
	}

	if (tokens[0].type != TokenType.KW_EXTERN) return false;
	if (tokens[1].type != TokenType.KW_STRUCT) return false;
	if (tokens[2].type != TokenType.KW_FN) return false;
	if (tokens[3].type != TokenType.KW_RETURN) return false;
	if (tokens[4].type != TokenType.KW_CONST) return false;
	if (tokens[5].type != TokenType.KW_NULL) return false;
	if (tokens[6].type != TokenType.KW_TRUE) return false;
	if (tokens[7].type != TokenType.KW_FALSE) return false;
	if (tokens[8].type != TokenType.KW_VAL) return false;
	if (tokens[9].type != TokenType.KW_VAR) return false;
	if (tokens[10].type != TokenType.KW_AS) return false;
	if (tokens[11].type != TokenType.KW_WHILE) return false;
	if (tokens[12].type != TokenType.KW_BREAK) return false;
	if (tokens[13].type != TokenType.KW_CONTINUE) return false;
	if (tokens[14].type != TokenType.KW_IF) return false;
	if (tokens[15].type != TokenType.KW_ELSE) return false;
	if (tokens[16].type != TokenType.KW_WHEN) return false;
	if (tokens[17].type != TokenType.KW_MOD) return false;
	if (tokens[18].type != TokenType.KW_USE) return false;
	if (tokens[19].type != TokenType.KW_PUB) return false;
	if (tokens[20].type != TokenType.KW_TRAIT) return false;
	if (tokens[21].type != TokenType.KW_IMPL) return false;
	if (tokens[22].type != TokenType.KW_FOR) return false;
	if (tokens[23].type != TokenType.KW_DEFER) return false;
	if (tokens[24].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_operators(): bool {
	val code: str = "= == => + - -> * / % < <= > >= ! != && || : ; , . [ ] ( ) { } &";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens[0].type != TokenType.EQUAL) return false;
	if (tokens[1].type != TokenType.EQUAL_EQUAL) return false;
	if (tokens[2].type != TokenType.FAT_ARROW) return false;
	if (tokens[3].type != TokenType.PLUS) return false;
	if (tokens[4].type != TokenType.MINUS) return false;
	if (tokens[5].type != TokenType.ARROW) return false;
	if (tokens[6].type != TokenType.STAR) return false;
	if (tokens[7].type != TokenType.SLASH) return false;
	if (tokens[8].type != TokenType.PERCENT) return false;
	if (tokens[9].type != TokenType.LESS) return false;
	if (tokens[10].type != TokenType.LESS_EQUAL) return false;
	if (tokens[11].type != TokenType.GREATER) return false;
	if (tokens[12].type != TokenType.GREATER_EQUAL) return false;
	if (tokens[13].type != TokenType.BANG) return false;
	if (tokens[14].type != TokenType.BANG_EQUAL) return false;
	if (tokens[15].type != TokenType.AND_AND) return false;
	if (tokens[16].type != TokenType.OR_OR) return false;
	if (tokens[17].type != TokenType.COLON) return false;
	if (tokens[18].type != TokenType.SEMI_COLON) return false;
	if (tokens[19].type != TokenType.COMMA) return false;
	if (tokens[20].type != TokenType.DOT) return false;
	if (tokens[21].type != TokenType.OPEN_BRACKET) return false;
	if (tokens[22].type != TokenType.CLOSE_BRACKET) return false;
	if (tokens[23].type != TokenType.OPEN_PAREN) return false;
	if (tokens[24].type != TokenType.CLOSE_PAREN) return false;
	if (tokens[25].type != TokenType.OPEN_BRACE) return false;
	if (tokens[26].type != TokenType.CLOSE_BRACE) return false;
	if (tokens[27].type != TokenType.AMPERSAND) return false;
	if (tokens[28].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_literals(): bool {
	val code: str = "123 45.67 \"hello world\" 'a' '\\n'";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 6) return false;

	val t0: Token = tokens[0];
	if (t0.type != TokenType.NUMBER || t0.text != "123") return false;

	val t1: Token = tokens[1];
	if (t1.type != TokenType.NUMBER || t1.text != "45.67") return false;

	val t2: Token = tokens[2];
	if (t2.type != TokenType.STRING || t2.text != "\"hello world\"") return false;

	val t3: Token = tokens[3];
	if (t3.type != TokenType.CHAR || t3.text != "'a'") return false;

	val t4: Token = tokens[4];
	if (t4.type != TokenType.CHAR || t4.text != "'\\n'") return false;

	val t5: Token = tokens[5];
	if (t5.type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_multiline_string_lexer(): bool {
	val code: str = "\"\"\"\nhello\nworld\n\"\"\" \"\"\"single\"\"\" \"\"\"\"\"\"";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 4) return false;
	if (tokens[0].type != TokenType.STRING) return false;
	if (tokens[0].text != "\"\"\"\nhello\nworld\n\"\"\"") return false;

	if (tokens[1].type != TokenType.STRING) return false;
	if (tokens[1].text != "\"\"\"single\"\"\"") return false;

	if (tokens[2].type != TokenType.STRING) return false;
	if (tokens[2].text != "\"\"\"\"\"\"") return false;

	if (tokens[3].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_numeric_prefixes_and_suffixes(): bool {
	val code: str = "0xFF 0b1010 0o77 1_000_000 100 50U 10_000_US 3.14F 2.5D";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 10) return false;

	if (tokens[0].type != TokenType.NUMBER || tokens[0].text != "0xFF") return false;
	if (tokens[1].type != TokenType.NUMBER || tokens[1].text != "0b1010") return false;
	if (tokens[2].type != TokenType.NUMBER || tokens[2].text != "0o77") return false;
	if (tokens[3].type != TokenType.NUMBER || tokens[3].text != "1_000_000") return false;
	if (tokens[4].type != TokenType.NUMBER || tokens[4].text != "100") return false;
	if (tokens[5].type != TokenType.NUMBER || tokens[5].text != "50U") return false;
	if (tokens[6].type != TokenType.NUMBER || tokens[6].text != "10_000_US") return false;
	if (tokens[7].type != TokenType.NUMBER || tokens[7].text != "3.14F") return false;
	if (tokens[8].type != TokenType.NUMBER || tokens[8].text != "2.5D") return false;
	if (tokens[9].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_comments_and_whitespace(): bool {
	val code: str = "val a = 1; // single line comment\nval b = 2; /* multi\nline\ncomment */ val c = 3;";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 16) return false;

	if (tokens[0].text != "val") return false;
	if (tokens[1].text != "a") return false;
	if (tokens[2].text != "=") return false;
	if (tokens[3].text != "1") return false;
	if (tokens[4].text != ";") return false;

	if (tokens[5].text != "val") return false;
	if (tokens[6].text != "b") return false;
	if (tokens[7].text != "=") return false;
	if (tokens[8].text != "2") return false;
	if (tokens[9].text != ";") return false;

	if (tokens[10].text != "val") return false;
	if (tokens[11].text != "c") return false;
	if (tokens[12].text != "=") return false;
	if (tokens[13].text != "3") return false;
	if (tokens[14].text != ";") return false;

	if (tokens[15].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn test_line_col_tracking(): bool {
	val code: str = "val x = 1;\nval y = 2;";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	val t0: Token = tokens[0];
	if (t0.text != "val" || t0.line != 1 || t0.col != 1) return false;

	val t5: Token = tokens[5];
	if (t5.text != "val" || t5.line != 2 || t5.col != 1) return false;

	return true;
}

// A UTF-8 BOM at the start of a file must be dropped before the first token. The
// bytes are built here so the test file itself stays plain ASCII.
fn test_bom_prefix(): bool {
	val buf = alloc_array<u8>(4);
	buf[0] = 239 as u8;
	buf[1] = 187 as u8;
	buf[2] = 191 as u8;
	buf[3] = 0 as u8;
	val code = str_from_bytes(buf, 3) + "val x = 1;";

	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 6) {
		println("  [ERR] BOM-prefixed source: wrong token count");
		return false;
	}
	if (tokens[0].type != TokenType.KW_VAL) {
		println("  [ERR] BOM-prefixed source: BOM leaked into the first token");
		return false;
	}

	return true;
}

fn test_question_operators(): bool {
	val code: str = "? ?: ?.";
	var lex: Lexer = Lexer(code);
	var tokens: List<Token> = lex.tokenize();
	defer tokens.delete();

	if (tokens.len != 4) return false;
	if (tokens[0].type != TokenType.QUESTION) return false;
	if (tokens[1].type != TokenType.QUESTION_COLON) return false;
	if (tokens[2].type != TokenType.QUESTION_DOT) return false;
	if (tokens[3].type != TokenType.END_OF_FILE) return false;

	return true;
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Lexer tests...");

	if (!test_keywords()) {
		println("  [FAIL] test_keywords");
		return 1;
	}
	println("  [PASS] test_keywords");

	if (!test_operators()) {
		println("  [FAIL] test_operators");
		return 1;
	}
	println("  [PASS] test_operators");

	if (!test_question_operators()) {
		println("  [FAIL] test_question_operators");
		return 1;
	}
	println("  [PASS] test_question_operators");

	if (!test_literals()) {
		println("  [FAIL] test_literals");
		return 1;
	}
	println("  [PASS] test_literals");

	if (!test_multiline_string_lexer()) {
		println("  [FAIL] test_multiline_string_lexer");
		return 1;
	}
	println("  [PASS] test_multiline_string_lexer");

	if (!test_numeric_prefixes_and_suffixes()) {
		println("  [FAIL] test_numeric_prefixes_and_suffixes");
		return 1;
	}
	println("  [PASS] test_numeric_prefixes_and_suffixes");

	if (!test_comments_and_whitespace()) {
		println("  [FAIL] test_comments_and_whitespace");
		return 1;
	}
	println("  [PASS] test_comments_and_whitespace");

	if (!test_line_col_tracking()) {
		println("  [FAIL] test_line_col_tracking");
		return 1;
	}
	println("  [PASS] test_line_col_tracking");

	if (!test_bom_prefix()) {
		println("  [FAIL] test_bom_prefix");
		return 1;
	}
	println("  [PASS] test_bom_prefix");

	println("[ALL PASSED] Bootstrap Lexer passed all tests successfully!");
	return 0;
}
