mod tests.unit.test_core;

use std.io.println;
use std.collections.*;

use compiler.core.*;

fn test_source_map(): bool {
	var sm = SourceMap();
	defer sm.free();

	val id1 = sm.add_file("src/main.kb", "main", "mod main;\nfn main(): i32 => 0;\n");
	val id2 = sm.add_file("src/util.kb", "util", "mod util;\npub fn helper() {}\n");

	if (id1 != 1 || id2 != 2 || sm.count() != 2) {
		return false;
	}

	val dup_id = sm.add_file("src/main.kb", "main", "ignored");
	if (dup_id != id1 || sm.count() != 2) {
		return false;
	}

	val f1 = sm.get_file(id1) ?: return false;
	if (f1.path != "src/main.kb" || f1.module_name != "main") {
		return false;
	}
	if (f1.line_text(1) != "mod main;") {
		return false;
	}
	if (f1.line_text(2) != "fn main(): i32 => 0;") {
		return false;
	}
	if (!f1.line_text(99).empty()) {
		return false;
	}

	val by_mod = sm.find_by_module("util") ?: return false;
	if (by_mod.id != id2 || by_mod.line_text(2) != "pub fn helper() {}") {
		return false;
	}

	val sp = Span(id1, 2, 4, 4);
	if (!sp.is_valid() || sp.file_id != id1 || sp.line != 2 || sp.col != 4 || sp.length != 4) {
		return false;
	}

	return true;
}

fn test_diagnostics(): bool {
	var sm = SourceMap();
	defer sm.free();
	val fid = sm.add_file("src/sample.kb", "sample", "mod sample;\nval x: i32 = \"bad\";\n");

	var bag = DiagnosticBag();
	defer bag.free();

	if (bag.has_errors() || !bag.empty()) {
		return false;
	}

	val sp = Span(fid, 2, 14, 5);
	bag.report_error(sp, "src/sample.kb", "Type mismatch", "expected i32, found str");
	// Duplicate error should be deduplicated automatically.
	bag.report_error(sp, "src/sample.kb", "Type mismatch", "expected i32, found str");
	bag.report_warning(Span(fid, 2, 5, 1), "src/sample.kb", "Unused variable 'x'");

	if (!bag.has_errors() || bag.error_count != 1 || bag.warning_count != 1 || bag.items.len != 2) {
		return false;
	}

	val first_diag = bag.items[0];
	val rendered = first_diag.render(&sm);
	if (!("Type mismatch" in rendered) || !("src/sample.kb:2:14" in rendered) || !("^^^^^" in rendered)) {
		return false;
	}

	val legacy = Diagnostic.parse_legacy(
		"sample: Line 2, Column 14: Legacy error message",
		"src/default.kb",
		Severity.ERROR,
		&sm
	);
	if (legacy.file_path != "src/sample.kb" || legacy.span.line != 2 || legacy.span.col != 14) {
		return false;
	}
	if (legacy.message != "Legacy error message") {
		return false;
	}

	return true;
}

fn test_naming(): bool {
	if ("std.io".module_to_rel() != "std/io") {
		return false;
	}
	if ("compiler/core/source.kb".path_to_module() != "compiler.core.source") {
		return false;
	}
	if (!"main.kb".has_kb_suffix() || "main.c".has_kb_suffix()) {
		return false;
	}
	if ("main.kb".strip_kb() != "main" || "main".strip_kb() != "main") {
		return false;
	}
	if ("std.io".mangle_symbol("println") != "std__io__println") {
		return false;
	}
	if ("".mangle_symbol("main") != "main") {
		return false;
	}

	var parts = List<str>();
	defer parts.free();
	parts += "compiler";
	parts += "core";
	parts += "Span";
	if (str_join_dots(parts, 2) != "compiler.core") {
		return false;
	}
	if (str_join_dots(parts, 3) != "compiler.core.Span") {
		return false;
	}
	if ("hello".hash_stamp().empty()) {
		return false;
	}

	return true;
}

fn main(): i32 {
	println("=== Unit Test: compiler.core ===");

	if (!test_source_map()) {
		println("  [FAIL] test_source_map");
		return 1;
	}
	println("  [PASS] test_source_map");

	if (!test_diagnostics()) {
		println("  [FAIL] test_diagnostics");
		return 1;
	}
	println("  [PASS] test_diagnostics");

	if (!test_naming()) {
		println("  [FAIL] test_naming");
		return 1;
	}
	println("  [PASS] test_naming");

	return 0;
}
