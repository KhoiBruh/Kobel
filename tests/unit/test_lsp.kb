mod test_lsp;

use std.io.println;
use std.collections.Array;
use std.filesystem.*;

use lsp.*;
use testsupport.assert.*;

fn test_json_and_uri() {
	val doc = JsonValue.parse("{\"name\":\"Kobel\",\"ver\":2,\"arr\":[true,\"\\u0041\"]}")!;
	assert_true(doc.is_obj(), "parsed JSON should be object");
	assert_eq_str(doc.get_str("name", ""), "Kobel", "JSON string field");
	assert_true(doc.get_num("ver", 0) == 2, "JSON num field");
	assert_true("arr" in doc, "JSON has key");
	val arr = doc["arr"];
	assert_true(arr.is_arr(), "JSON arr field");
	assert_eq_usz(arr.arr_val.len, 2, "JSON arr length");
	assert_eq_str(arr.at(1).str_val, "A", "JSON unicode escape \\u0041");

	val bad_empty = JsonValue.parse("");
	assert_true(bad_empty is JsonErr.EmptyInput, "empty JSON fails with EmptyInput");
	val bad_str = JsonValue.parse("\"unterminated");
	assert_true(bad_str is JsonErr.UnterminatedString, "unterminated JSON string fails");
	val bad_obj = JsonValue.parse("{\"a\":}");
	assert_true(bad_obj is JsonErr.UnexpectedToken, "invalid JSON value fails");

	val raw_path = "C:/Users/Admin/CLionProjects/Kobel/src/main.kb";
	val uri = path_to_uri(raw_path);
	assert_true("Kobel" in uri, "path_to_uri preserves directory case");
	val back = uri_to_path(uri);
	assert_true(paths_equal(raw_path, back), "uri_to_path round-trips path");

	println("  [PASS] test_json_and_uri");
}

fn find_line_col(text: str, needle: str): Pair<usz, usz> {
	val lines = text.split('\n');
	for (i in 0..<lines.len) {
		val idx = lines[i].index_of(needle) !: continue;
		return Pair(i, idx);
	}
	return Pair(0, 0);
}

fn test_new_features_and_semantics() {
	val kws = Array<str>("is", "op", "init", "yield", "defer", "when", "trait", "impl");
	for (kw in kws) {
		assert_true(!keyword_hover(kw).empty(), "keyword_hover should document keyword");
	}

	val src = """mod sample;

enum Mode {
	FAST,
	SAFE
}

struct Counter {
	pub value: i64
}

impl Counter {
	pub init(start: i64) => Self(start);

	pub fn bump(&self, delta: i64): i64 {
		self.value += delta;
		return self.value;
	}

	pub op plus(*self, other: Counter): Counter => Counter(self.value + other.value);
}

fn step_sum(m: Mode, a: i64, b: i64): i64 {
	var total = a;
	var c = Counter(b);
	defer c.bump(0);
	val bonus = when (m) {
		Mode.FAST -> 10;
		Mode.SAFE -> 1;
	};
	total += c.bump(bonus);
	for (i in 0..<2) total += i as i64;
	return total;
}

pub fn entry(): i64 {
	var out = step_sum(Mode.FAST, 2, 3);
	out += step_sum(Mode.SAFE, 1, 1);
	return out;
}
""";

	val sample_path = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/sample_lsp_virtual.kb";
	val sample_uri = path_to_uri(sample_path);
	val analysis = AnalysisResult(sample_path, src, "", false);

	assert_eq_usz(analysis.diagnostics.len, 0, "clean Kobel 2.0 snippet should have zero diagnostics");

	// Hover on `step_sum` call resolves unmangled signature
	val call_pos = find_line_col(src, "step_sum(Mode.FAST");
	val hov = analysis.hover_at(call_pos.first, call_pos.second);
	assert_true(!hov.is_null(), "hover_at call should succeed");
	val hov_md = hov["contents"].get_str("value", "");
	assert_true("fn step_sum(m: Mode, a: i64, b: i64): i64" in hov_md, "hover shows unmangled signature");

	// Definition & hover on enum variant `Mode.FAST` in when-arm
	val dot_fast = find_line_col(src, "Mode.FAST ->");
	val fast_hov = analysis.hover_at(dot_fast.first, dot_fast.second + 5);
	assert_true(!fast_hov.is_null(), "hover on Mode.FAST should resolve");
	val fast_def = analysis.definition_at(sample_uri, dot_fast.first, dot_fast.second + 5);
	assert_true(!fast_def.is_null(), "definition on Mode.FAST should resolve");

	// Member completion after `c.` should include Counter field & methods
	val bump_call = find_line_col(src, "c.bump(0)");
	val comp_items = analysis.complete_at(bump_call.first, bump_call.second + 2);
	assert_true(comp_items.is_arr() && comp_items.arr_val.len > 0, "member completion returns items");
	var saw_value = false;
	var saw_bump = false;
	for (item in comp_items.arr_val) {
		val lbl = item.get_str("label", "");
		if (lbl == "value") saw_value = true;
		if (lbl == "bump") saw_bump = true;
	}
	assert_true(saw_value && saw_bump, "Counter completion includes `value` and `bump`");

	// Signature help inside `step_sum(Mode.FAST, 2, 3)` at 2nd arg
	val arg2_pos = find_line_col(src, ", 2, 3");
	val sig_help = analysis.signature_help_at(arg2_pos.first, arg2_pos.second + 2);
	assert_true(!sig_help.is_null(), "signature_help should resolve inside call");
	assert_true(sig_help.get_num("activeParameter", -1) == 1, "activeParameter should be 1 at 2nd argument");

	// Document highlights on `total`
	val total_decl = find_line_col(src, "var total");
	val hls = analysis.document_highlights(total_decl.first, total_decl.second + 4);
	assert_true(hls.is_arr() && hls.arr_val.len >= 3, "document_highlights should find decl + writes/reads of total");

	// Document symbols
	val syms = AnalysisResult.document_symbols(src);
	assert_true(syms.is_arr() && syms.arr_val.len >= 4, "document_symbols lists enum/struct/fns");

	// Semantic references, prepareRename & rename on `step_sum`
	val fn_pos = find_line_col(src, "fn step_sum");
	val refs = find_references_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3, true);
	assert_true(refs.is_arr() && refs.arr_val.len == 3, "references should find def + 2 calls for step_sum");

	val prep = prepare_rename_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3);
	assert_eq_str(prep.get_str("placeholder", ""), "step_sum", "prepareRename returns unmangled name");

	val edit = rename_symbol_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3, "calc_step");
	assert_true(edit.is_obj() && "changes" in edit, "rename produces WorkspaceEdit changes");
	val file_edits = edit["changes"][sample_uri];
	assert_true(file_edits.is_arr() && file_edits.arr_val.len == 3, "rename produces 3 edits for step_sum");

	println("  [PASS] test_new_features_and_semantics");
}

fn test_code_actions() {
	val src = """mod actions_sample;

use std.collections.List;

trait Greeter {
	fn greet(*self): str;
}

struct Bot {
	pub id: i64
}

impl Greeter for Bot {}

pub fn helper(): i64 {
	var never_mutated = 42;
	return never_mutated;
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/actions_sample_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);
	val actions = code_actions_json(
		analysis.index,
		analysis.tokens,
		p,
		src,
		0,
		0,
		20,
		0,
		JsonValue.arr()
	);
	assert_true(actions.is_arr(), "code_actions returns array");

	var saw_var_to_val = false;
	var saw_unused_use = false;
	var saw_trait_stub = false;
	for (act in actions.arr_val) {
		val title = act.get_str("title", "");
		if ("val" in title) saw_var_to_val = true;
		if ("unused import" in title || "Unused" in title || "Remove" in title) saw_unused_use = true;
		if ("trait" in title || "Implement" in title) saw_trait_stub = true;
	}
	assert_true(saw_var_to_val, "codeAction offers var -> val for unmutated variable");
	assert_true(saw_unused_use, "codeAction offers removing unused use import");
	assert_true(saw_trait_stub, "codeAction offers trait method stub for Bot");

	println("  [PASS] test_code_actions");
}

fn test_preloaded_stdlib_no_duplicate_diagnostics() {
	val list_rel = "lib/std/collections/list.kb";
	if (!Path(list_rel).exists()) {
		println("  [SKIP] test_preloaded_stdlib_no_duplicate_diagnostics");
		return;
	}
	val list_src = Path(list_rel).read_text()!;
	val list_analysis = AnalysisResult(list_rel, list_src, ".", false);
	assert_eq_usz(
		list_analysis.diagnostics.len,
		0,
		"opening preloaded stdlib file (lib/std/collections/list.kb) should not duplicate declarations"
	);
	val node_rel = "src/compiler/ast/node.kb";
	if (Path(node_rel).exists()) {
		val node_src = Path(node_rel).read_text()!;
		val node_analysis = AnalysisResult(node_rel, node_src, ".", false);
		assert_eq_usz(
			node_analysis.diagnostics.len,
			0,
			"opening multi-file module file (src/compiler/ast/node.kb) should keep canonical file order"
		);
	}
	println("  [PASS] test_preloaded_stdlib_no_duplicate_diagnostics");
}

fn test_error_union_lsp() {
	val src = """mod err_lsp_sample;

fault NetErr {
	Timeout("Connection timed out"),
	Closed(code: i32)("Peer closed connection")
}

fn connect(ok: bool): i32 ! NetErr {
	if (!ok) return NetErr.Closed(500);
	return 1;
}

pub fn run(ok: bool): i32 {
	val r = connect(ok);
	val code = when (r) {
		is i32 as v -> *v;
		is .Timeout -> -1;
		is .Closed as c -> c.code;
	};
	val fallback = connect(false) !: err -> {
		if (err is NetErr.Timeout) yield -2;
		yield code;
	};
	return fallback;
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/err_lsp_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);
	assert_eq_usz(analysis.diagnostics.len, 0, "clean fault & error union file must produce zero LSP diagnostics");

	val syms = AnalysisResult.document_symbols(src);
	var saw_fault = false;
	for (sym in syms.arr_val) {
		if (sym.get_str("name", "") == "NetErr") saw_fault = true;
	}
	assert_true(saw_fault, "document_symbols must include NetErr fault");

	val dot_pos = find_line_col(src, ".Timeout ->");
	val dot_def = analysis.definition_at(path_to_uri(p), dot_pos.first, dot_pos.second + 2);
	assert_true(!dot_def.is_null(), "go-to-definition on .Timeout in error union when-arm must resolve to NetErr.Timeout");

	println("  [PASS] test_error_union_lsp");
}

fn test_dead_code_and_quickfixes() {
	val src = """mod dead_code_sample;

use std.io.println;
use std.collections.List;
use std.process.Process;
use std.string.StringBuilder;

const DEAD_CONST: i64 = 99;

trait Speak {
	fn speak(*self, target: str): str;
}

struct Dog {
	pub name: str
}

impl Speak for Dog {
	fn speak(*self, target: str): str => self.name;
}

struct DeadBox {
	pub v: i64
}

impl DeadBox {
	pub fn get(*self): i64 => self.v;
}

impl str {
	pub fn is_nonempty_api(*self): bool => !self.empty();
}

pub struct KV {
	pub k: str,
	pub v: i64
}

impl KV {
	pub op unpack(*self, ok: &str, ov: &i64) {
		ok.write(self.k);
		ov.write(self.v);
	}
}

enum Kind {
	A(v: i64),
	B(v: i64)
}

fn used_helper(n: i64): i64 {
	if (n <= 0) return 0;
	return used_helper(n - 1) + 1;
}

fn dead_cycle_a(): i64 => dead_cycle_b();
fn dead_cycle_b(): i64 => dead_cycle_a();

fn test_params(used_p: i64, dead_p: i64, _ok_p: i64): i64 {
	val unused_v = 7;
	if (used_p > 0) {
		return used_p;
	} else {
		return 0;
	}
	println("unreachable after if");
}

fn test_after_return_and_exit(flag: bool, k: Kind): i64 {
	if (k is Kind.A as item && item.v > 0) {
		println("pos");
	}
	if (k is Kind.A as item && item.v < 0) {
		println("neg");
	}
	if (!flag) {
		Process.exit(1);
		println("unreachable after exit");
	}
	return 42;
	println("unreachable after return");
}

pub fn main() {
	var xs: List<i64> = List();
	xs += 1;
	if (xs.len > 0) println("xs ok");
	var kvs: List<KV> = List();
	kvs += KV("a", 1);
	for ((u_k, u_v) in kvs) {
		if (u_v > 0) println(u_k);
	}
	for ((used_k, unused_kv) in kvs) {
		println(used_k);
	}
	val dog = Dog("Rex");
	println(dog.speak("world"));
	val k = Kind.A(3);
	val total = used_helper(1) + test_params(1, 2, 3) + test_after_return_and_exit(true, k);
	if (total > 0) println("total ok");
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/dead_code_sample_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);

	var saw_errors: usz = 0;
	var saw_unused_sb = false;
	var saw_used_import_flagged = false;
	var saw_unused_v = false;
	var saw_unpack_false_pos = false;
	var saw_unused_kv = false;
	var saw_shadowed_item_flagged = false;
	var saw_dead_p = false;
	var saw_ignored_p_flagged = false;
	var saw_trait_param_flagged = false;
	var saw_dead_const = false;
	var saw_dead_box = false;
	var saw_str_api_flagged = false;
	var saw_dead_a = false;
	var saw_dead_b = false;
	var saw_live_helper_flagged = false;
	var saw_main_flagged = false;
	var unreach_count: usz = 0;

	val diags_json = JsonValue.arr();
	for (d in analysis.diagnostics) {
		if (d.severity == 1) saw_errors++;
		diags_json += d.to_json();
		assert_true(!d.code.empty(), "dead code diagnostic must have non-empty code");
		assert_eq_usz(d.tags.len, 1, "dead code diagnostic must carry Unnecessary tag");
		assert_true(d.tags[0] == 1, "dead code diagnostic tag must be 1 (Unnecessary)");

		if (d.code == "unused-import") {
			if ("StringBuilder" in d.message) saw_unused_sb = true;
			if ("println" in d.message || "List" in d.message || "Process" in d.message) saw_used_import_flagged = true;
		} else if (d.code == "unused-variable") {
			if ("unused_v" in d.message) saw_unused_v = true;
			if ("(u_k, u_v)" in d.message || "'u_k'" in d.message || "'u_v'" in d.message || "'used_k'" in d.message) saw_unpack_false_pos = true;
			if ("unused_kv" in d.message) saw_unused_kv = true;
			if ("'item'" in d.message) saw_shadowed_item_flagged = true;
		} else if (d.code == "unused-parameter") {
			if ("dead_p" in d.message) saw_dead_p = true;
			if ("_ok_p" in d.message) saw_ignored_p_flagged = true;
			if ("target" in d.message) saw_trait_param_flagged = true;
		} else if (d.code == "unused-symbol") {
			if ("DEAD_CONST" in d.message) saw_dead_const = true;
			if ("DeadBox" in d.message) saw_dead_box = true;
			if ("is_nonempty_api" in d.message) saw_str_api_flagged = true;
			if ("dead_cycle_a" in d.message) saw_dead_a = true;
			if ("dead_cycle_b" in d.message) saw_dead_b = true;
			if ("used_helper" in d.message) saw_live_helper_flagged = true;
			if ("main" in d.message) saw_main_flagged = true;
		} else if (d.code == "unreachable-code") {
			unreach_count++;
		}
	}

	assert_eq_usz(saw_errors, 0, "dead code sample must compile cleanly with zero semantic errors");
	assert_true(saw_unused_sb, "unused explicit import StringBuilder must be flagged");
	assert_true(!saw_used_import_flagged, "used imports println/List/Process must not be flagged");
	assert_true(saw_unused_v, "unused local unused_v must be flagged");
	assert_true(!saw_unpack_false_pos, "for-loop unpacked variables used in body must not be flagged");
	assert_true(saw_unused_kv, "genuinely unused for-loop unpacked variable unused_kv must be flagged");
	assert_true(!saw_shadowed_item_flagged, "repeated if-is alias 'item' must resolve to inner scope");
	assert_true(saw_dead_p, "unused parameter dead_p must be flagged");
	assert_true(!saw_ignored_p_flagged, "_-prefixed parameter must not be flagged");
	assert_true(!saw_trait_param_flagged, "trait impl parameter must not be flagged");
	assert_true(saw_dead_const, "unused private const DEAD_CONST must be flagged");
	assert_true(saw_dead_box, "unused private struct DeadBox must be flagged");
	assert_true(!saw_str_api_flagged, "public impl str method must not be flagged as unused");
	assert_true(saw_dead_a && saw_dead_b, "mutually recursive private dead functions must be flagged");
	assert_true(!saw_live_helper_flagged && !saw_main_flagged, "live functions reachable from main must not be flagged");
	assert_eq_usz(unreach_count, 3, "unreachable stmts after diverging if, Process.exit, and return must all be flagged");

	// Verify serialized JSON contains `code` and `tags: [1]`
	val json_txt = diags_json.serialize();
	assert_true("\"code\":\"unreachable-code\"" in json_txt, "serialized diag must include code field");
	assert_true("\"tags\":[1]" in json_txt, "serialized diag must include tags array [1]");

	// Verify dead-code QuickFixes for unused import, unused param/var, and unreachable code
	val actions = code_actions_json(
		analysis.index, analysis.tokens, p, src, 0, 0, 100, 0, diags_json
	);
	var fix_import = false;
	var fix_param = false;
	var fix_var = false;
	var fix_unreach = false;
	for (act in actions.arr_val) {
		val title = act.get_str("title", "");
		if (title == "Remove unused import 'std.string.StringBuilder'") fix_import = true;
		if (title == "Rename 'dead_p' to '_dead_p'") fix_param = true;
		if (title == "Rename 'unused_v' to '_unused_v'") fix_var = true;
		if (title == "Remove unreachable code") fix_unreach = true;
	}
	assert_true(fix_import, "QuickFix must remove single unused import");
	assert_true(fix_param, "QuickFix must offer prefixing unused parameter with '_'");
	assert_true(fix_var, "QuickFix must offer prefixing unused variable with '_'");
	assert_true(fix_unreach, "QuickFix must offer removing unreachable code");

	// Verify non-scalar safe-navigation check reports semantic error instead of emitting bad C
	val bad_src = """mod bad_safenav_sample;

use std.collections.List;

struct Holder {
	pub items: List<i64>
}

pub fn broken(h: ?*Holder): bool {
	return h?.items.empty();
}
""";
	val bad_p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/bad_safenav_virtual.kb";
	val bad_analysis = AnalysisResult(bad_p, bad_src, "", false);
	var saw_safenav_err = false;
	for (d in bad_analysis.diagnostics) {
		if (d.severity == 1 && "Safe navigation" in d.message) saw_safenav_err = true;
	}
	assert_true(saw_safenav_err, "non-scalar safe-navigation chain without safe default must report LSP error");

	println("  [PASS] test_dead_code_and_quickfixes");
}

fn test_object_lsp_and_privacy() {
	val src = """mod obj_lsp_sample;

use testsupport.objdefs.MathObj;

object DeadNs {
	pub const UNUSED_CONST: i32 = 5;
	pub fn dead_method(): i32 => 1;
}

pub object LiveNs {
	pub const VAL: i32 = 2;

	pub fn compute(x: i32): i32 {
		return x + Self.VAL;
		val after = 1;
	}
}

pub fn run(): i32 {
	return MathObj.BASE + MathObj.scale(3) + LiveNs.compute(4);
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/obj_lsp_virtual.kb";
	val analysis = AnalysisResult(p, src, "C:/Users/Admin/CLionProjects/Kobel/tests/features", false);

	var saw_err: usz = 0;
	var saw_dead_obj = false;
	var saw_dead_const = false;
	var saw_dead_method = false;
	var saw_unreach_in_obj = false;
	var saw_live_flagged = false;
	for (d in analysis.diagnostics) {
		if (d.severity == 1) saw_err++;
		if (d.code == "unused-symbol") {
			if ("Unused object 'DeadNs'" in d.message) saw_dead_obj = true;
			if ("UNUSED_CONST" in d.message) saw_dead_const = true;
			if ("dead_method" in d.message) saw_dead_method = true;
			if ("LiveNs" in d.message || "compute" in d.message) saw_live_flagged = true;
		} else if (d.code == "unreachable-code") {
			saw_unreach_in_obj = true;
		}
	}
	assert_eq_usz(saw_err, 0, "valid object LSP file must produce zero compile errors");
	assert_true(saw_dead_obj, "unused private object DeadNs must be flagged");
	assert_true(saw_dead_const, "constant inside unused private object must be flagged");
	assert_true(saw_dead_method, "method inside unused private object must be flagged");
	assert_true(saw_unreach_in_obj, "unreachable code inside object method must be flagged");
	assert_true(!saw_live_flagged, "live public object and its members must not be flagged");

	// Document symbols: object kind == 19 with child constant & method
	val syms = AnalysisResult.document_symbols(src);
	var saw_obj_sym = false;
	for (sym in syms.arr_val) {
		if (sym.get_str("name", "") == "LiveNs") {
			assert_true(sym.get_num("kind", 0) == 19, "object document symbol must use LSP SymbolKind.Object (19)");
			val kids = sym.get_arr("children");
			assert_eq_usz(kids.arr_val.len, 2, "LiveNs outline must contain VAL and compute");
			saw_obj_sym = true;
		}
	}
	assert_true(saw_obj_sym, "document_symbols must include LiveNs object");

	// Definition and dot-completion on object members
	val call_pos = find_line_col(src, "LiveNs.compute(4)");
	val obj_def = analysis.definition_at(path_to_uri(p), call_pos.first, call_pos.second + 8);
	assert_true(!obj_def.is_null(), "go-to-definition on LiveNs.compute must resolve");
	val comp_items = analysis.complete_at(call_pos.first, call_pos.second + 7);
	var saw_comp_val = false;
	var saw_comp_fn = false;
	for (it in comp_items.arr_val) {
		val lbl = it.get_str("label", "");
		if (lbl == "VAL") saw_comp_val = true;
		if (lbl == "compute") saw_comp_fn = true;
	}
	assert_true(saw_comp_val && saw_comp_fn, "dot-completion on LiveNs must list VAL and compute");

	// Negative compilation assertions enforced via real test_lsp assertions
	var bad_cases = List<str>();
	bad_cases += "object O { fn a() {} }\nimpl O { fn b() {} }";
	bad_cases += "object O { pub fn a(): i32 => 1; }\npub fn bad() { val x = O(); }";
	bad_cases += "object O { pub fn a(): i32 => 1; }\npub fn bad(x: O) {}";
	bad_cases += "struct Empty {}";
	bad_cases += "struct ForwardOnly;";
	for (bad_case in bad_cases) {
		val b_ana = AnalysisResult(
			"C:/Users/Admin/CLionProjects/Kobel/tests/unit/obj_neg_virtual.kb",
			"mod obj_neg;\n" + bad_case,
			"",
			false
		);
		var has_err = false;
		for (d in b_ana.diagnostics) {
			if (d.severity == 1) has_err = true;
		}
		assert_true(has_err, "disallowed object/empty-struct snippet must report severity-1 error");
	}

	// Cross-module privacy checks on object private const and private function
	val priv_fn_src = """mod priv_fn_sample;

use testsupport.objdefs.MathObj;

pub fn bad(): i32 => MathObj.helper(1);
""";
	val pf_analysis = AnalysisResult(
		"C:/Users/Admin/CLionProjects/Kobel/tests/unit/obj_priv_fn_virtual.kb",
		priv_fn_src,
		"C:/Users/Admin/CLionProjects/Kobel/tests/features",
		false
	);
	var saw_fn_priv_err = false;
	for (d in pf_analysis.diagnostics) {
		if (d.severity == 1 && "private" in d.message) saw_fn_priv_err = true;
	}
	assert_true(saw_fn_priv_err, "calling private object function from another module must error");

	val priv_const_src = """mod priv_const_sample;

use testsupport.objdefs.MathObj;

pub fn bad(): i32 => MathObj.HIDDEN_STEP;
""";
	val pc_analysis = AnalysisResult(
		"C:/Users/Admin/CLionProjects/Kobel/tests/unit/obj_priv_const_virtual.kb",
		priv_const_src,
		"C:/Users/Admin/CLionProjects/Kobel/tests/features",
		false
	);
	var saw_const_priv_err = false;
	for (d in pc_analysis.diagnostics) {
		if (d.severity == 1 && "private" in d.message) saw_const_priv_err = true;
	}
	assert_true(saw_const_priv_err, "reading private object constant from another module must error");

	println("  [PASS] test_object_lsp_and_privacy");
}

fn lsp_pos_offset(text: str, line0: usz, char0: usz): usz {
	var cur_line: usz = 0;
	var i: usz = 0;
	while (i < text.len && cur_line < line0) {
		if (text[i] == '\n') cur_line++;
		i++;
	}
	var c: usz = 0;
	while (i < text.len && c < char0 && text[i] != '\n' && text[i] != '\r') {
		i++;
		c++;
	}
	return i;
}

fn apply_action_edits(text: str, act: *JsonValue, uri: str): str {
	val changes = act.get_obj("edit").get_obj("changes");
	val edits = changes[uri];
	if (edits == null || !edits.is_arr()) return text;
	// Simple single-edit or reverse-order application for tests
	var cur = text;
	var i = edits.arr_val.len;
	while (i > 0) {
		i--;
		val ed = edits.arr_val[i];
		val r = ed.get_obj("range");
		val sp = r.get_obj("start");
		val ep = r.get_obj("end");
		val a = lsp_pos_offset(
			cur,
			sp.get_num("line", 0) as usz,
			sp.get_num("character", 0) as usz
		);
		val b = lsp_pos_offset(
			cur,
			ep.get_num("line", 0) as usz,
			ep.get_num("character", 0) as usz
		);
		val nt = ed.get_str("newText", "");
		cur = "${cur.slice(0, a)}${nt}${cur.slice(b, cur.len)}";
	}
	return cur;
}

fn has_diag_on(diags: List<LspDiagnostic>, code: str, needle: str): bool {
	for (d in diags) {
		if (d.code == code && needle in d.message) return true;
	}
	return false;
}

fn count_diag_code(diags: List<LspDiagnostic>, code: str): usz {
	var n: usz = 0;
	for (d in diags) {
		if (d.code == code) n++;
	}
	return n;
}

fn find_action_by_title(actions: *JsonValue, prefix: str): ?*JsonValue {
	for (act in actions.arr_val) {
		val t = act.get_str("title", "");
		if (prefix in t) return act;
	}
	return null;
}

fn test_lint_warnings_and_quickfixes() {
	val src = """mod lint_sample;

use std.io.println;
use std.collections.List;

enum Kind {
	A(v: i64),
	B
}

struct Holder {
	pub x: i64
}

impl Holder {
	pub fn read_bad(&self): i64 => self.x;
	pub fn read_blk_bad(&self): i64 {
		val v = self.x + 1;
		return v;
	}
	pub fn bump_arrow(&self): i64 => self.x += 1;
}

fn single_expr_ret(x: i64): i64 {
	return x * 2;
}

fn inline_ret_ok(a: i64, b: i64): i64 {
	val sum = a + b;
	return sum;
}

fn multiline_keep_ok(flag: bool): i64 {
	val chosen = if (flag) {
		10
	} else {
		20
	};
	return chosen;
}

fn bool_ret_1(flag: bool): bool {
	if (flag) {
		return true;
	} else {
		return false;
	}
}

fn bool_ret_2(a: i64): bool {
	if (a > 0) return false;
	return true;
}

fn bool_ret_not_in(x: i64): bool {
	if (x !in [1, 2]) return false;
	return true;
}

fn bool_cmps(flag: bool, x: i64): bool {
	val a = flag == true;
	val b = flag == false;
	val c = !(!flag);
	val d = !(x !in [3, 4]);
	return a && b && c && d;
}

fn red_else_fn(x: i64): i64 {
	if (x > 0) {
		return x;
	} else {
		val y = x - 1;
		return y;
	}
}

fn empty_else_keep_and_drop(x: i64): i64 {
	var acc = 0;
	if (x > 0) {
		acc = 1;
	} else {}
	if (x < 0) {}
	if (x == 0) { // keep empty documented
	}
	return acc;
}

fn collapse_ok_and_guard(a: bool, b: bool, c: bool, k: Kind): i64 {
	var hits = 0;
	if (a || b) {
		if (c) {
			hits++;
		}
	}
	if (k is Kind.A) {
		if (k.v > 0) hits += k.v;
	}
	return hits;
}

fn trailing_ret_fn(x: i64) {
	if (x > 0) println("ok");
	return;
}

fn var_checks(): i64 {
	var unmut_1 = 10;
	var unmut_2 = 20;
	var xs: List<i64> = List();
	xs += 1;
	var ptr_tgt = 5;
	val mp = &ptr_tgt;
	mp.write(6);
	var sc_opt: ?&Holder = null;
	if (sc_opt != null) {
		sc_opt.x = 9;
	}
	var cap_cnt = 0;
	xs.each { _ -> cap_cnt++; };
	var used_h = Holder(1);
	defer used_h.bump_arrow();
	return unmut_1 + unmut_2 + xs.len as i64 + ptr_tgt + cap_cnt + used_h.x;
}

pub fn run_all(): i64 {
	var h = Holder(3);
	val sh = h.read_bad() + h.read_blk_bad() + h.bump_arrow();
	trailing_ret_fn(sh);
	val ok = bool_ret_1(true) && bool_ret_2(1) && bool_ret_not_in(5) && bool_cmps(true, 1);
	val s = sh + single_expr_ret(2) + inline_ret_ok(1, 2) + multiline_keep_ok(ok) + red_else_fn(1);
	return s + empty_else_keep_and_drop(1) + collapse_ok_and_guard(true, false, true, Kind.A(2)) + var_checks();
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/lint_sample_virtual.kb";
	val uri = path_to_uri(p);
	val analysis = AnalysisResult(p, src, "", false);

	var err_count: usz = 0;
	for (d in analysis.diagnostics) {
		if (d.severity == 1) err_count++;
	}
	assert_eq_usz(err_count, 0, "lint sample must compile with zero semantic errors");

	// Group 1 assertions
	assert_true(
		has_diag_on(analysis.diagnostics, "unnecessary-mut-receiver", "read_bad"),
		"arrow &self method never mutated must emit unnecessary-mut-receiver"
	);
	assert_true(
		has_diag_on(analysis.diagnostics, "unnecessary-mut-receiver", "read_blk_bad"),
		"block &self method never mutated must emit unnecessary-mut-receiver"
	);
	assert_true(
		!has_diag_on(analysis.diagnostics, "unnecessary-mut-receiver", "bump_arrow"),
		"mutated arrow &self method must not trigger unnecessary-mut-receiver"
	);

	assert_true(
		has_diag_on(analysis.diagnostics, "unnecessary-mut", "'unmut_1'") &&
		has_diag_on(analysis.diagnostics, "unnecessary-mut", "'unmut_2'"),
		"unmutated var declarations must emit unnecessary-mut"
	);
	assert_true(
		!has_diag_on(analysis.diagnostics, "unnecessary-mut", "'xs'") &&
		!has_diag_on(analysis.diagnostics, "unnecessary-mut", "'ptr_tgt'") &&
		!has_diag_on(analysis.diagnostics, "unnecessary-mut", "'sc_opt'") &&
		!has_diag_on(analysis.diagnostics, "unnecessary-mut", "'cap_cnt'") &&
		!has_diag_on(analysis.diagnostics, "unnecessary-mut", "'used_h'"),
		"vars mutated via &self call, &borrow, smart-cast, lambda, or defer must not be flagged"
	);

	// Group 2 assertions
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "prefer-expression-body"), 1,
		"single-return function body must emit prefer-expression-body"
	);
	assert_true(
		has_diag_on(analysis.diagnostics, "redundant-return-var", "'sum'"),
		"single-line val + immediate return must emit redundant-return-var"
	);
	assert_true(
		!has_diag_on(analysis.diagnostics, "redundant-return-var", "'chosen'"),
		"multi-line initializer before return must not emit redundant-return-var"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "redundant-boolean-return"), 3,
		"all three if-return boolean patterns must emit redundant-boolean-return"
	);
	assert_true(
		has_diag_on(analysis.diagnostics, "redundant-boolean-return", "return !(x !in [1, 2]);"),
		"negating (x !in [1, 2]) must preserve !in inside !(...) instead of dropping !"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "redundant-bool-compare"), 3,
		"flag == true, flag == false, and !(!flag) must emit redundant-bool-compare (not !(x !in ...))"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "redundant-else"), 1,
		"redundant else after return block must emit redundant-else"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "empty-branch"), 2,
		"undocumented empty else {} and empty if {} must emit empty-branch (commented one ignored)"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "collapsible-if"), 1,
		"collapsible nested if must trigger once while unaliased `if (k is Kind.A)` guard stays untouched"
	);
	assert_eq_usz(
		count_diag_code(analysis.diagnostics, "redundant-trailing-return"), 1,
		"trailing return; in none-returning function must emit redundant-trailing-return"
	);

	// QuickFixes check (precomputed fixes) + applying QuickFix edits and re-checking
	val diags_json = JsonValue.arr();
	for (d in analysis.diagnostics) diags_json += d.to_json();
	val all_actions = code_actions_json(
		analysis.index, analysis.tokens, p, src, 0, 0, 200, 0, diags_json, &analysis.lint_fixes
	);

	val act_recv = find_action_by_title(all_actions, "Change '&self' to '*self'");
	val act_var_all = find_action_by_title(all_actions, "Convert all");
	val act_expr_body = find_action_by_title(all_actions, "Convert to expression body");
	val act_inline = find_action_by_title(all_actions, "Inline return variable 'sum'");
	val act_red_else = find_action_by_title(all_actions, "Remove redundant 'else'");
	val act_merge_if = find_action_by_title(all_actions, "Merge nested 'if'");
	val act_trail_ret = find_action_by_title(all_actions, "Remove redundant 'return;'");
	val act_not_in_bool = find_action_by_title(all_actions, "Simplify to 'return !(x !in [1, 2]);'");
	assert_true(
		act_recv != null && act_var_all != null && act_expr_body != null &&
		act_inline != null && act_red_else != null && act_merge_if != null &&
		act_trail_ret != null && act_not_in_bool != null,
		"every Group 1 & Group 2 lint diagnostic must produce a working QuickFix"
	);

	// Verify 9-arg fallback still produces AST lint QuickFix when called without precomputed list
	val fb_actions = code_actions_json(
		analysis.index, analysis.tokens, p, src, 0, 0, 200, 0, diags_json
	);
	assert_true(
		find_action_by_title(fb_actions, "Remove redundant 'else'") != null,
		"9-arg code_actions_json fallback must still emit lint QuickFixes"
	);

	// Verify applying key QuickFixes produces valid code that compiles cleanly with zero errors
	val mini_src = """mod qf_verify;

struct Box { pub v: i64 }
impl Box {
	pub fn get(&self): i64 {
		return self.v;
	}
}
pub fn check(a: bool, b: bool, c: bool): i64 {
	var x = 1;
	var y = 2;
	if (a || b) {
		if (c) {
			return x + y;
		}
	}
	if (x == 1) {
		return 10;
	} else {
		val r = x + y;
		return r;
	}
}
""";
	val mp_path = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/qf_verify_virtual.kb";
	val mp_uri = path_to_uri(mp_path);
	var cur_txt = mini_src;
	// Repeatedly apply the first non-var/first available lint fix until fixed-point
	for (_step in 0..<8) {
		val cur_a = AnalysisResult(mp_path, cur_txt, "", false);
		var step_errs: usz = 0;
		for (d in cur_a.diagnostics) if (d.severity == 1) step_errs++;
		assert_eq_usz(step_errs, 0, "edited source at each QuickFix step must have zero compile errors");
		val cur_dj = JsonValue.arr();
		for (d in cur_a.diagnostics) cur_dj += d.to_json();
		val acts = code_actions_json(
			cur_a.index, cur_a.tokens, mp_path, cur_txt, 0, 0, 100, 0, cur_dj, &cur_a.lint_fixes
		);
		if (acts.arr_val.empty()) break;
		val batch = find_action_by_title(acts, "Convert all");
		val chosen = if (batch != null) batch! else acts.arr_val[0];
		val next_txt = apply_action_edits(cur_txt, chosen, mp_uri);
		assert_true(next_txt != cur_txt, "applied QuickFix edit must modify text");
		cur_txt = next_txt;
	}
	val final_a = AnalysisResult(mp_path, cur_txt, "", false);
	var final_errs: usz = 0;
	for (d in final_a.diagnostics) if (d.severity == 1) final_errs++;
	assert_eq_usz(final_errs, 0, "final QuickFixed code must compile with zero errors");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "unnecessary-mut-receiver"), 0, "receiver fixed");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "unnecessary-mut"), 0, "vars fixed");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "prefer-expression-body"), 0, "expr body fixed");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "collapsible-if"), 0, "collapsible if fixed");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "redundant-else"), 0, "redundant else fixed");
	assert_eq_usz(count_diag_code(final_a.diagnostics, "redundant-return-var"), 0, "inline return fixed");
	assert_true("fn get(*self): i64 => self.v;" in cur_txt, "applied fixes produced clean arrow *self method");
	assert_true("if ((a || b) && c)" in cur_txt, "applied collapsible-if preserved || precedence");

	println("  [PASS] test_lint_warnings_and_quickfixes");
}

fn test_null_smart_cast_and_unwrap_lint() {
	val src = """mod sample.smart_cast_lint;

struct Node {
	pub val_num: i64
}

struct Holder {
	pub node: ?*Node
}

fn take_node(n: *Node): i64 => n.val_num;

fn check_cases(h: *Holder, p: ?*Node, fb: *Node): i64 {
	var total: i64 = 0;
	if (h.node != null) total += take_node(h.node!);
	val picked = if (h.node != null) take_node(h.node!) else take_node(fb);
	total += picked;
	if (p != null && p!.val_num > 0) total += 1;
	if (p == null) return total;
	total += take_node(p!);
	return total;
}

fn keep_real_unwrap(p: ?*Node): i64 => take_node(p!);
""";
	val vpath = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/smart_cast_lint_virtual.kb";
	val vuri = path_to_uri(vpath);
	val a = AnalysisResult(vpath, src, "", false);

	var err_cnt: usz = 0;
	for (d in a.diagnostics) if (d.severity == 1) err_cnt++;
	assert_eq_usz(err_cnt, 0, "smart-casted redundant '!' must not fail compilation");

	assert_eq_usz(
		count_diag_code(a.diagnostics, "unnecessary-non-null-assert"),
		4,
		"expected 4 unnecessary-non-null-assert warnings (real unwrap must not warn)"
	);

	// Verify Unnecessary tag (1) on emitted diagnostics
	var tagged_cnt: usz = 0;
	for (d in a.diagnostics) {
		if (d.code == "unnecessary-non-null-assert") {
			for (t in d.tags) if (t == 1) tagged_cnt++;
		}
	}
	assert_eq_usz(tagged_cnt, 4, "all unnecessary-non-null-assert diags must carry tag 1");

	// Verify single + batch QuickFixes and apply batch QuickFix
	val dj = JsonValue.arr();
	for (d in a.diagnostics) dj += d.to_json();
	val actions = code_actions_json(
		a.index, a.tokens, vpath, src, 12, 0, 22, 0, dj, &a.lint_fixes
	);
	val single = find_action_by_title(actions, "Remove redundant '!'");
	assert_true(single != null, "single QuickFix 'Remove redundant !' must exist");
	val batch = find_action_by_title(actions, "Remove all 4 redundant '!' assertion(s)");
	assert_true(batch != null, "batch QuickFix for all 4 redundant '!' must exist");

	val fixed = apply_action_edits(src, batch!, vuri);
	assert_true("take_node(h.node);" in fixed, "batch fix removed redundant '!' on member");
	assert_true("p != null && p.val_num > 0" in fixed, "batch fix removed redundant '!' in &&");
	assert_true("take_node(p);" in fixed, "batch fix removed redundant '!' after early return");
	assert_true("take_node(p!);" in fixed, "batch fix preserved genuinely nullable '!'");

	val after = AnalysisResult(vpath, fixed, "", false);
	var after_errs: usz = 0;
	for (d in after.diagnostics) if (d.severity == 1) after_errs++;
	assert_eq_usz(after_errs, 0, "code after removing redundant '!' must have zero errors");
	assert_eq_usz(
		count_diag_code(after.diagnostics, "unnecessary-non-null-assert"),
		0,
		"zero unnecessary-non-null-assert warnings after batch QuickFix"
	);

	// Negative test: invalidation after reassignment to null must be a compile error
	val bad_src = """mod sample.smart_cast_bad;

struct Node { pub v: i64 }
struct Holder { pub node: ?*Node }

fn take(n: *Node): i64 => n.v;

fn invalidated(h: &Holder): i64 {
	if (h.node != null) {
		h.node = null;
		return take(h.node);
	}
	return 0;
}

fn non_null_bang(n: *Node): i64 => take(n!);
""";
	val bad_a = AnalysisResult(
		"C:/Users/Admin/CLionProjects/Kobel/tests/unit/smart_cast_bad_virtual.kb",
		bad_src, "", false
	);
	var bad_errs: usz = 0;
	for (d in bad_a.diagnostics) if (d.severity == 1) bad_errs++;
	assert_eq_usz(
		bad_errs, 2,
		"reassigned-to-null member use and '!' on intrinsically non-null pointer must both error"
	);

	println("  [PASS] test_null_smart_cast_and_unwrap_lint");
}

fn test_group3_idiom_lints_and_quickfixes() {
	val src = """mod sample.group3_lints;

use std.collections.*;
use std.collections.List;
use std.io.println;
use std.io.println;

struct Payload {
	pub x: i64
}

enum Item {
	A(x: i64),
	B
}

struct Box {
	pub v: i64,
	pub next: ?*Box,
	pub pl: Payload
}

impl Box {
	pub fn get_v(*self): i64 => self.v;
	pub fn ping(*self) { println("ok"); }
}

fn test_idioms(p: ?*Box, fb: *Box, n: i64, it: Item, def_pl: Payload): i64 {
	var xs = List<i64>();
	xs += n;
	var acc: i64 = 0;

	// prefer-not-in & prefer-not-is
	if (!(n in [1, 2, 3])) acc += 1;
	if (!(it is Item.A)) acc += 1;
	// Already idiomatic (must NOT warn)
	if (n !in [4, 5]) acc += 1;
	if (it !is Item.B) acc += 1;

	// prefer-safe-nav (Elvis, safe field, safe method, null fallback, void stmt)
	val chosen = if (p != null) p else fb;
	val fv = if (p != null) p.v else 0;
	val mv = if (p == null) 0 else p.get_v();
	val nx = if (p != null) p.next else null;
	if (p != null) p.ping();
	// Non-pointer struct field cannot use `?.` -> must NOT warn
	val pl = if (p != null) p.pl else def_pl;

	// redundant-cast (2 redundant, 2 legitimate)
	val c1 = n as i64;
	val c2 = chosen as *Box;
	val ok_diff = n as i32;
	val ok_lit = 0 as i32;

	// single-arm-when (value & unaliased is-pattern)
	val w1 = when (n) {
		1 -> 10;
		else -> 20;
	};
	val w2 = when (it) {
		is Item.A -> 100;
		else -> 0;
	};
	// Aliased is-pattern in WhenExpr must NOT warn (IfExpr does not bind `as alias`)
	val w_alias = when (it) {
		is Item.A as a -> a.x;
		else -> 0;
	};
	// Multi-arm when must NOT warn
	val w_multi = when (n) {
		1 -> 1;
		2 -> 2;
		else -> 3;
	};

	if (nx != null) acc += nx.v;
	return acc + fv + mv + pl.x + c1 + c2.v + (ok_diff as i64) + (ok_lit as i64) + w1 + w2 + w_alias + w_multi + (xs.len as i64);
}
""";
	val vpath = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/group3_lints_virtual.kb";
	val vuri = path_to_uri(vpath);
	val a = AnalysisResult(vpath, src, "", false);

	var err_cnt: usz = 0;
	for (d in a.diagnostics) if (d.severity == 1) err_cnt++;
	assert_eq_usz(err_cnt, 0, "group 3 sample must compile with zero errors");

	assert_eq_usz(count_diag_code(a.diagnostics, "duplicate-import"), 2, "expected 2 duplicate-import");
	assert_eq_usz(count_diag_code(a.diagnostics, "prefer-not-in"), 1, "expected 1 prefer-not-in");
	assert_eq_usz(count_diag_code(a.diagnostics, "prefer-not-is"), 1, "expected 1 prefer-not-is");
	assert_eq_usz(count_diag_code(a.diagnostics, "prefer-safe-nav"), 5, "expected 5 prefer-safe-nav");
	assert_eq_usz(count_diag_code(a.diagnostics, "redundant-cast"), 2, "expected 2 redundant-cast");
	assert_eq_usz(count_diag_code(a.diagnostics, "single-arm-when"), 2, "expected 2 single-arm-when");

	// Verify batch QuickFixes exist for duplicate-import and redundant-cast
	val dj = JsonValue.arr();
	for (d in a.diagnostics) dj += d.to_json();
	val all_acts = code_actions_json(
		a.index, a.tokens, vpath, src, 0, 0, 100, 0, dj, &a.lint_fixes
	);
	assert_true(
		find_action_by_title(all_acts, "Remove all 2 redundant import(s)") != null,
		"batch QuickFix for duplicate-import must exist"
	);
	assert_true(
		find_action_by_title(all_acts, "Remove all 2 redundant 'as' cast(s)") != null,
		"batch QuickFix for redundant-cast must exist"
	);

	// Apply QuickFixes iteratively until all Group 3 warnings are eliminated
	var cur_txt = src;
	for (_step in 0..<14) {
		val cur_a = AnalysisResult(vpath, cur_txt, "", false);
		var step_errs: usz = 0;
		for (d in cur_a.diagnostics) if (d.severity == 1) step_errs++;
		assert_eq_usz(step_errs, 0, "group 3 QuickFix step must have zero compile errors");
		val cur_dj = JsonValue.arr();
		for (d in cur_a.diagnostics) cur_dj += d.to_json();
		val acts = code_actions_json(
			cur_a.index, cur_a.tokens, vpath, cur_txt, 0, 0, 100, 0, cur_dj, &cur_a.lint_fixes
		);
		if (acts.arr_val.empty()) break;
		val batch_imp = find_action_by_title(acts, "Remove all 2 redundant import(s)");
		val batch_cast = find_action_by_title(acts, "Remove all 2 redundant 'as' cast(s)");
		val chosen = if (batch_imp != null) batch_imp
			else if (batch_cast != null) batch_cast
			else acts.arr_val[0];
		val next_txt = apply_action_edits(cur_txt, chosen, vuri);
		assert_true(next_txt != cur_txt, "group 3 QuickFix edit must modify text");
		cur_txt = next_txt;
	}

	val fin = AnalysisResult(vpath, cur_txt, "", false);
	var fin_errs: usz = 0;
	for (d in fin.diagnostics) if (d.severity == 1) fin_errs++;
	assert_eq_usz(fin_errs, 0, "final Group 3 fixed source must compile cleanly");
	assert_eq_usz(count_diag_code(fin.diagnostics, "duplicate-import"), 0, "duplicate-import cleared");
	assert_eq_usz(count_diag_code(fin.diagnostics, "prefer-not-in"), 0, "prefer-not-in cleared");
	assert_eq_usz(count_diag_code(fin.diagnostics, "prefer-not-is"), 0, "prefer-not-is cleared");
	assert_eq_usz(count_diag_code(fin.diagnostics, "prefer-safe-nav"), 0, "prefer-safe-nav cleared");
	assert_eq_usz(count_diag_code(fin.diagnostics, "redundant-cast"), 0, "redundant-cast cleared");
	assert_eq_usz(count_diag_code(fin.diagnostics, "single-arm-when"), 0, "single-arm-when cleared");

	assert_true("n !in [1, 2, 3]" in cur_txt, "prefer-not-in rewrite applied");
	assert_true("it !is Item.A" in cur_txt, "prefer-not-is rewrite applied");
	assert_true("val chosen = p ?: fb;" in cur_txt, "Elvis rewrite applied");
	assert_true("val fv = p?.v ?: 0;" in cur_txt, "safe field + Elvis rewrite applied");
	assert_true("val mv = p?.get_v() ?: 0;" in cur_txt, "safe call + Elvis rewrite applied");
	assert_true("val nx = p?.next;" in cur_txt, "safe pointer field rewrite applied");
	assert_true("p?.ping();" in cur_txt, "safe void call statement rewrite applied");
	assert_true("val c1 = n;" in cur_txt, "redundant i64 cast removed");
	assert_true("val c2 = chosen;" in cur_txt, "redundant pointer cast removed");
	assert_true("val w1 = if (n == 1) 10 else 20;" in cur_txt, "single-arm value when simplified");
	assert_true("val w2 = if (it is Item.A) 100 else 0;" in cur_txt, "single-arm is when simplified");

	println("  [PASS] test_group3_idiom_lints_and_quickfixes");
}

fn test_kblint_engine_and_custom_rules() {
	val src = """mod sample.kblint_custom;

use std.collections.List;
use std.io.println;

struct Bag {
	pub len: usz
}

impl Bag {
	pub fn empty(*self): bool => self.len == 0;
}

fn legacy_log(msg: str) { println(msg); }

fn demo(n: i64): bool {
	var xs = List<i64>();
	xs += n;
	legacy_log("hi");
	val is_z = xs.len == 0;
	val same = n == n;
	return is_z || same;
}
""";
	val vpath = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/kblint_custom_virtual.kb";
	val vuri = path_to_uri(vpath);

	// 1. Default built-in .kblint rules: prefer-empty + self-comparison (self.len == 0 must NOT warn)
	val a_builtin = AnalysisResult(vpath, src, "", false);
	assert_eq_usz(count_diag_code(a_builtin.diagnostics, "prefer-empty"), 1, "expected 1 prefer-empty (not self.len == 0)");
	assert_eq_usz(count_diag_code(a_builtin.diagnostics, "self-comparison"), 1, "expected 1 self-comparison");

	var saw_kobel_lint_source = false;
	for (d in a_builtin.diagnostics) {
		if (d.code == "prefer-empty" && d.to_json().get_str("source", "") == "kobel-lint") {
			saw_kobel_lint_source = true;
		}
	}
	assert_true(saw_kobel_lint_source, "lint diagnostic JSON must emit source='kobel-lint'");

	// 2. Custom .kblint rule + disable directive + malformed rule tolerance
	val custom_kblint = """
disable: ["self-comparison"]

rule "broken-rule" {
	match:   ((( broken syntax
	message: "Should be ignored safely"
}

rule "no-legacy-log" {
	match:   legacy_log($args...)
	fix:     println($args...)
	title:   "Replace legacy_log with println"
	message: "Use 'println($args...)' instead of deprecated 'legacy_log'"
}
""";
	var custom_rs = load_kblint_ruleset("", custom_kblint);
	defer custom_rs.free();

	val a_custom = AnalysisResult(vpath, src, "", false, &custom_rs);
	assert_eq_usz(count_diag_code(a_custom.diagnostics, "self-comparison"), 0, "disable directive suppressed self-comparison");
	assert_eq_usz(count_diag_code(a_custom.diagnostics, "no-legacy-log"), 1, "custom .kblint rule matched legacy_log");
	assert_eq_usz(count_diag_code(a_custom.diagnostics, "prefer-empty"), 1, "built-in prefer-empty still active");

	val dj = JsonValue.arr();
	for (d in a_custom.diagnostics) dj += d.to_json();
	val acts = code_actions_json(
		a_custom.index, a_custom.tokens, vpath, src, 0, 0, 40, 0, dj, &a_custom.lint_fixes
	);
	val custom_act = find_action_by_title(acts, "Replace legacy_log with println");
	assert_true(custom_act != null, "custom .kblint QuickFix action must exist");
	val fixed1 = apply_action_edits(src, custom_act!, vuri);
	assert_true("println(\"hi\");" in fixed1, "custom QuickFix rewrote legacy_log to println");

	val empty_act = find_action_by_title(acts, "Simplify to 'xs.empty()'");
	assert_true(empty_act != null, "prefer-empty QuickFix must exist");
	val fixed2 = apply_action_edits(fixed1, empty_act!, vuri);
	assert_true("val is_z = xs.empty();" in fixed2, "prefer-empty QuickFix rewrote xs.len == 0");

	val after = AnalysisResult(vpath, fixed2, "", false, &custom_rs);
	var after_errs: usz = 0;
	for (d in after.diagnostics) if (d.severity == 1) after_errs++;
	assert_eq_usz(after_errs, 0, "fixed source after custom .kblint QuickFixes must have zero errors");
	assert_eq_usz(count_diag_code(after.diagnostics, "no-legacy-log"), 0, "no-legacy-log cleared");
	assert_eq_usz(count_diag_code(after.diagnostics, "prefer-empty"), 0, "prefer-empty cleared");

	// 3. Disambiguating import across two wildcard modules must NOT emit duplicate-import
	val disambig_src = """mod sample.disambig;

use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.types.StructField;

fn check(f: StructField): str => f.name;
""";
	val a_disambig = AnalysisResult(
		"C:/Users/Admin/CLionProjects/Kobel/tests/unit/disambig_virtual.kb",
		disambig_src, "", false
	);
	assert_eq_usz(
		count_diag_code(a_disambig.diagnostics, "duplicate-import"),
		0,
		"disambiguating explicit import between two wildcard modules must not be flagged"
	);

	println("  [PASS] test_kblint_engine_and_custom_rules");
}

pub fn main() {
	println("Running LSP unit tests...");
	test_json_and_uri();
	test_new_features_and_semantics();
	test_code_actions();
	test_preloaded_stdlib_no_duplicate_diagnostics();
	test_error_union_lsp();
	test_dead_code_and_quickfixes();
	test_object_lsp_and_privacy();
	test_lint_warnings_and_quickfixes();
	test_null_smart_cast_and_unwrap_lint();
	test_group3_idiom_lints_and_quickfixes();
	test_kblint_engine_and_custom_rules();
	println("All LSP unit tests passed.");
}
