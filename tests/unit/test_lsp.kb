mod test_lsp;

use std.io.println;
use std.collections.Array;
use std.filesystem.*;

use lsp.*;
use testsupport.assert.*;

fn test_json_and_uri() {
	val doc = JsonValue.parse("{\"name\":\"Kobel\",\"ver\":2,\"arr\":[true,\"\\u0041\"]}")!;
	assert_true(doc.is_obj(), "parsed JSON should be object");
	assert_eq_str(doc.get_str("name", ""), "Kobel", "JSON string field");
	assert_true(doc.get_num("ver", 0) == 2, "JSON num field");
	assert_true("arr" in doc, "JSON has key");
	val arr = doc["arr"];
	assert_true(arr.is_arr(), "JSON arr field");
	assert_eq_usz(arr.arr_val.len, 2, "JSON arr length");
	assert_eq_str(arr.at(1).str_val, "A", "JSON unicode escape \\u0041");

	val bad_empty = JsonValue.parse("");
	assert_true(bad_empty is JsonErr.EmptyInput, "empty JSON fails with EmptyInput");
	val bad_str = JsonValue.parse("\"unterminated");
	assert_true(bad_str is JsonErr.UnterminatedString, "unterminated JSON string fails");
	val bad_obj = JsonValue.parse("{\"a\":}");
	assert_true(bad_obj is JsonErr.UnexpectedToken, "invalid JSON value fails");

	val raw_path = "C:/Users/Admin/CLionProjects/Kobel/src/main.kb";
	val uri = path_to_uri(raw_path);
	assert_true("Kobel" in uri, "path_to_uri preserves directory case");
	val back = uri_to_path(uri);
	assert_true(paths_equal(raw_path, back), "uri_to_path round-trips path");

	println("  [PASS] test_json_and_uri");
}

fn find_line_col(text: str, needle: str): Pair<usz, usz> {
	val lines = text.split('\n');
	for (i in 0..<lines.len) {
		val idx = lines[i].index_of(needle) !: continue;
		return Pair(i, idx);
	}
	return Pair(0, 0);
}

fn test_new_features_and_semantics() {
	val kws = Array<str>("is", "op", "init", "yield", "defer", "when", "trait", "impl");
	for (kw in kws) {
		assert_true(!keyword_hover(kw).empty(), "keyword_hover should document keyword");
	}

	val src = """mod sample;

enum Mode {
	FAST,
	SAFE
}

struct Counter {
	pub value: i64
}

impl Counter {
	pub init(start: i64) => Self(start);

	pub fn bump(&self, delta: i64): i64 {
		self.value += delta;
		return self.value;
	}

	pub op plus(*self, other: Counter): Counter {
		return Counter(self.value + other.value);
	}
}

fn step_sum(m: Mode, a: i64, b: i64): i64 {
	var total = a;
	var c = Counter(b);
	defer c.bump(0);
	val bonus = when (m) {
		Mode.FAST -> 10;
		Mode.SAFE -> 1;
	};
	total += c.bump(bonus);
	for (i in 0..<2) total += i as i64;
	return total;
}

pub fn entry(): i64 {
	var out = step_sum(Mode.FAST, 2, 3);
	out += step_sum(Mode.SAFE, 1, 1);
	return out;
}
""";

	val sample_path = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/sample_lsp_virtual.kb";
	val sample_uri = path_to_uri(sample_path);
	val analysis = AnalysisResult(sample_path, src, "", false);

	assert_eq_usz(analysis.diagnostics.len, 0, "clean Kobel 2.0 snippet should have zero diagnostics");

	// Hover on `step_sum` call resolves unmangled signature
	val call_pos = find_line_col(src, "step_sum(Mode.FAST");
	val hov = analysis.hover_at(call_pos.first, call_pos.second);
	assert_true(!hov.is_null(), "hover_at call should succeed");
	val hov_md = hov["contents"].get_str("value", "");
	assert_true("fn step_sum(m: Mode, a: i64, b: i64): i64" in hov_md, "hover shows unmangled signature");

	// Definition & hover on enum variant `Mode.FAST` in when-arm
	val dot_fast = find_line_col(src, "Mode.FAST ->");
	val fast_hov = analysis.hover_at(dot_fast.first, dot_fast.second + 5);
	assert_true(!fast_hov.is_null(), "hover on Mode.FAST should resolve");
	val fast_def = analysis.definition_at(sample_uri, dot_fast.first, dot_fast.second + 5);
	assert_true(!fast_def.is_null(), "definition on Mode.FAST should resolve");

	// Member completion after `c.` should include Counter field & methods
	val bump_call = find_line_col(src, "c.bump(0)");
	val comp_items = analysis.complete_at(bump_call.first, bump_call.second + 2);
	assert_true(comp_items.is_arr() && comp_items.arr_val.len > 0, "member completion returns items");
	var saw_value = false;
	var saw_bump = false;
	for (item in comp_items.arr_val) {
		val lbl = item.get_str("label", "");
		if (lbl == "value") saw_value = true;
		if (lbl == "bump") saw_bump = true;
	}
	assert_true(saw_value && saw_bump, "Counter completion includes `value` and `bump`");

	// Signature help inside `step_sum(Mode.FAST, 2, 3)` at 2nd arg
	val arg2_pos = find_line_col(src, ", 2, 3");
	val sig_help = analysis.signature_help_at(arg2_pos.first, arg2_pos.second + 2);
	assert_true(!sig_help.is_null(), "signature_help should resolve inside call");
	assert_true(sig_help.get_num("activeParameter", -1) == 1, "activeParameter should be 1 at 2nd argument");

	// Document highlights on `total`
	val total_decl = find_line_col(src, "var total");
	val hls = analysis.document_highlights(total_decl.first, total_decl.second + 4);
	assert_true(hls.is_arr() && hls.arr_val.len >= 3, "document_highlights should find decl + writes/reads of total");

	// Document symbols
	val syms = AnalysisResult.document_symbols(src);
	assert_true(syms.is_arr() && syms.arr_val.len >= 4, "document_symbols lists enum/struct/fns");

	// Semantic references, prepareRename & rename on `step_sum`
	val fn_pos = find_line_col(src, "fn step_sum");
	val refs = find_references_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3, true);
	assert_true(refs.is_arr() && refs.arr_val.len == 3, "references should find def + 2 calls for step_sum");

	val prep = prepare_rename_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3);
	assert_eq_str(prep.get_str("placeholder", ""), "step_sum", "prepareRename returns unmangled name");

	val edit = rename_symbol_json(analysis.index, sample_path, fn_pos.first, fn_pos.second + 3, "calc_step");
	assert_true(edit.is_obj() && "changes" in edit, "rename produces WorkspaceEdit changes");
	val file_edits = edit["changes"][sample_uri];
	assert_true(file_edits.is_arr() && file_edits.arr_val.len == 3, "rename produces 3 edits for step_sum");

	println("  [PASS] test_new_features_and_semantics");
}

fn test_code_actions() {
	val src = """mod actions_sample;

use std.collections.List;

trait Greeter {
	fn greet(*self): str;
}

struct Bot {
	pub id: i64
}

impl Greeter for Bot {}

pub fn helper(): i64 {
	var never_mutated = 42;
	return never_mutated;
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/actions_sample_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);
	val actions = code_actions_json(
		analysis.index,
		analysis.tokens,
		p,
		src,
		0,
		0,
		20,
		0,
		JsonValue.arr()
	);
	assert_true(actions.is_arr(), "code_actions returns array");

	var saw_var_to_val = false;
	var saw_unused_use = false;
	var saw_trait_stub = false;
	for (act in actions.arr_val) {
		val title = act.get_str("title", "");
		if ("val" in title) saw_var_to_val = true;
		if ("unused import" in title || "Unused" in title || "Remove" in title) saw_unused_use = true;
		if ("trait" in title || "Implement" in title) saw_trait_stub = true;
	}
	assert_true(saw_var_to_val, "codeAction offers var -> val for unmutated variable");
	assert_true(saw_unused_use, "codeAction offers removing unused use import");
	assert_true(saw_trait_stub, "codeAction offers trait method stub for Bot");

	println("  [PASS] test_code_actions");
}

fn test_preloaded_stdlib_no_duplicate_diagnostics() {
	val list_rel = "lib/std/collections/list.kb";
	if (!Path(list_rel).exists()) {
		println("  [SKIP] test_preloaded_stdlib_no_duplicate_diagnostics");
		return;
	}
	val list_src = Path(list_rel).read_text()!;
	val list_analysis = AnalysisResult(list_rel, list_src, ".", false);
	assert_eq_usz(
		list_analysis.diagnostics.len,
		0,
		"opening preloaded stdlib file (lib/std/collections/list.kb) should not duplicate declarations"
	);
	val node_rel = "src/compiler/ast/node.kb";
	if (Path(node_rel).exists()) {
		val node_src = Path(node_rel).read_text()!;
		val node_analysis = AnalysisResult(node_rel, node_src, ".", false);
		assert_eq_usz(
			node_analysis.diagnostics.len,
			0,
			"opening multi-file module file (src/compiler/ast/node.kb) should keep canonical file order"
		);
	}
	println("  [PASS] test_preloaded_stdlib_no_duplicate_diagnostics");
}

fn test_error_union_lsp() {
	val src = """mod err_lsp_sample;

fault NetErr {
	Timeout("Connection timed out"),
	Closed(code: i32)("Peer closed connection")
}

fn connect(ok: bool): i32 ! NetErr {
	if (!ok) return NetErr.Closed(500);
	return 1;
}

pub fn run(ok: bool): i32 {
	val r = connect(ok);
	val code = when (r) {
		is i32 as v -> *v;
		is .Timeout -> -1;
		is .Closed as c -> c.code;
	};
	val fallback = connect(false) !: err -> {
		if (err is NetErr.Timeout) yield -2;
		yield code;
	};
	return fallback;
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/err_lsp_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);
	assert_eq_usz(analysis.diagnostics.len, 0, "clean fault & error union file must produce zero LSP diagnostics");

	val syms = AnalysisResult.document_symbols(src);
	var saw_fault = false;
	for (sym in syms.arr_val) {
		if (sym.get_str("name", "") == "NetErr") saw_fault = true;
	}
	assert_true(saw_fault, "document_symbols must include NetErr fault");

	val dot_pos = find_line_col(src, ".Timeout ->");
	val dot_def = analysis.definition_at(path_to_uri(p), dot_pos.first, dot_pos.second + 2);
	assert_true(!dot_def.is_null(), "go-to-definition on .Timeout in error union when-arm must resolve to NetErr.Timeout");

	println("  [PASS] test_error_union_lsp");
}

fn test_dead_code_and_quickfixes() {
	val src = """mod dead_code_sample;

use std.io.println;
use std.collections.List;
use std.process.Process;
use std.string.StringBuilder;

const DEAD_CONST: i64 = 99;

trait Speak {
	fn speak(*self, target: str): str;
}

struct Dog {
	pub name: str
}

impl Speak for Dog {
	fn speak(*self, target: str): str => self.name;
}

struct DeadBox {
	pub v: i64
}

impl DeadBox {
	pub fn get(*self): i64 => self.v;
}

impl str {
	pub fn is_nonempty_api(*self): bool => !self.empty();
}

pub struct KV {
	pub k: str,
	pub v: i64
}

impl KV {
	pub op unpack(*self, ok: &str, ov: &i64) {
		ok.write(self.k);
		ov.write(self.v);
	}
}

enum Kind {
	A(v: i64),
	B(v: i64)
}

fn used_helper(n: i64): i64 {
	if (n <= 0) return 0;
	return used_helper(n - 1) + 1;
}

fn dead_cycle_a(): i64 => dead_cycle_b();
fn dead_cycle_b(): i64 => dead_cycle_a();

fn test_params(used_p: i64, dead_p: i64, _ok_p: i64): i64 {
	val unused_v = 7;
	if (used_p > 0) {
		return used_p;
	} else {
		return 0;
	}
	println("unreachable after if");
}

fn test_after_return_and_exit(flag: bool, k: Kind): i64 {
	if (k is Kind.A as item && item.v > 0) {
		println("pos");
	}
	if (k is Kind.A as item && item.v < 0) {
		println("neg");
	}
	if (!flag) {
		Process.exit(1);
		println("unreachable after exit");
	}
	return 42;
	println("unreachable after return");
}

pub fn main() {
	var xs: List<i64> = List();
	xs += 1;
	if (xs.len > 0) println("xs ok");
	var kvs: List<KV> = List();
	kvs += KV("a", 1);
	for ((u_k, u_v) in kvs) {
		if (u_v > 0) println(u_k);
	}
	for ((used_k, unused_kv) in kvs) {
		println(used_k);
	}
	val dog = Dog("Rex");
	println(dog.speak("world"));
	val k = Kind.A(3);
	val total = used_helper(1) + test_params(1, 2, 3) + test_after_return_and_exit(true, k);
	if (total > 0) println("total ok");
}
""";
	val p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/dead_code_sample_virtual.kb";
	val analysis = AnalysisResult(p, src, "", false);

	var saw_errors: usz = 0;
	var saw_unused_sb = false;
	var saw_used_import_flagged = false;
	var saw_unused_v = false;
	var saw_unpack_false_pos = false;
	var saw_unused_kv = false;
	var saw_shadowed_item_flagged = false;
	var saw_dead_p = false;
	var saw_ignored_p_flagged = false;
	var saw_trait_param_flagged = false;
	var saw_dead_const = false;
	var saw_dead_box = false;
	var saw_str_api_flagged = false;
	var saw_dead_a = false;
	var saw_dead_b = false;
	var saw_live_helper_flagged = false;
	var saw_main_flagged = false;
	var unreach_count: usz = 0;

	val diags_json = JsonValue.arr();
	for (d in analysis.diagnostics) {
		if (d.severity == 1) saw_errors++;
		diags_json += d.to_json();
		assert_true(!d.code.empty(), "dead code diagnostic must have non-empty code");
		assert_eq_usz(d.tags.len, 1, "dead code diagnostic must carry Unnecessary tag");
		assert_true(d.tags[0] == 1, "dead code diagnostic tag must be 1 (Unnecessary)");

		if (d.code == "unused-import") {
			if ("StringBuilder" in d.message) saw_unused_sb = true;
			if ("println" in d.message || "List" in d.message || "Process" in d.message) saw_used_import_flagged = true;
		} else if (d.code == "unused-variable") {
			if ("unused_v" in d.message) saw_unused_v = true;
			if ("(u_k, u_v)" in d.message || "'u_k'" in d.message || "'u_v'" in d.message || "'used_k'" in d.message) saw_unpack_false_pos = true;
			if ("unused_kv" in d.message) saw_unused_kv = true;
			if ("'item'" in d.message) saw_shadowed_item_flagged = true;
		} else if (d.code == "unused-parameter") {
			if ("dead_p" in d.message) saw_dead_p = true;
			if ("_ok_p" in d.message) saw_ignored_p_flagged = true;
			if ("target" in d.message) saw_trait_param_flagged = true;
		} else if (d.code == "unused-symbol") {
			if ("DEAD_CONST" in d.message) saw_dead_const = true;
			if ("DeadBox" in d.message) saw_dead_box = true;
			if ("is_nonempty_api" in d.message) saw_str_api_flagged = true;
			if ("dead_cycle_a" in d.message) saw_dead_a = true;
			if ("dead_cycle_b" in d.message) saw_dead_b = true;
			if ("used_helper" in d.message) saw_live_helper_flagged = true;
			if ("main" in d.message) saw_main_flagged = true;
		} else if (d.code == "unreachable-code") {
			unreach_count++;
		}
	}

	assert_eq_usz(saw_errors, 0, "dead code sample must compile cleanly with zero semantic errors");
	assert_true(saw_unused_sb, "unused explicit import StringBuilder must be flagged");
	assert_true(!saw_used_import_flagged, "used imports println/List/Process must not be flagged");
	assert_true(saw_unused_v, "unused local unused_v must be flagged");
	assert_true(!saw_unpack_false_pos, "for-loop unpacked variables used in body must not be flagged");
	assert_true(saw_unused_kv, "genuinely unused for-loop unpacked variable unused_kv must be flagged");
	assert_true(!saw_shadowed_item_flagged, "repeated if-is alias 'item' must resolve to inner scope");
	assert_true(saw_dead_p, "unused parameter dead_p must be flagged");
	assert_true(!saw_ignored_p_flagged, "_-prefixed parameter must not be flagged");
	assert_true(!saw_trait_param_flagged, "trait impl parameter must not be flagged");
	assert_true(saw_dead_const, "unused private const DEAD_CONST must be flagged");
	assert_true(saw_dead_box, "unused private struct DeadBox must be flagged");
	assert_true(!saw_str_api_flagged, "public impl str method must not be flagged as unused");
	assert_true(saw_dead_a && saw_dead_b, "mutually recursive private dead functions must be flagged");
	assert_true(!saw_live_helper_flagged && !saw_main_flagged, "live functions reachable from main must not be flagged");
	assert_eq_usz(unreach_count, 3, "unreachable stmts after diverging if, Process.exit, and return must all be flagged");

	// Verify serialized JSON contains `code` and `tags: [1]`
	val json_txt = diags_json.serialize();
	assert_true("\"code\":\"unreachable-code\"" in json_txt, "serialized diag must include code field");
	assert_true("\"tags\":[1]" in json_txt, "serialized diag must include tags array [1]");

	// Verify dead-code QuickFixes for unused import, unused param/var, and unreachable code
	val actions = code_actions_json(
		analysis.index, analysis.tokens, p, src, 0, 0, 100, 0, diags_json
	);
	var fix_import = false;
	var fix_param = false;
	var fix_var = false;
	var fix_unreach = false;
	for (act in actions.arr_val) {
		val title = act.get_str("title", "");
		if (title == "Remove unused import 'std.string.StringBuilder'") fix_import = true;
		if (title == "Rename 'dead_p' to '_dead_p'") fix_param = true;
		if (title == "Rename 'unused_v' to '_unused_v'") fix_var = true;
		if (title == "Remove unreachable code") fix_unreach = true;
	}
	assert_true(fix_import, "QuickFix must remove single unused import");
	assert_true(fix_param, "QuickFix must offer prefixing unused parameter with '_'");
	assert_true(fix_var, "QuickFix must offer prefixing unused variable with '_'");
	assert_true(fix_unreach, "QuickFix must offer removing unreachable code");

	// Verify non-scalar safe-navigation check reports semantic error instead of emitting bad C
	val bad_src = """mod bad_safenav_sample;

use std.collections.List;

struct Holder {
	pub items: List<i64>
}

pub fn broken(h: ?*Holder): bool {
	return h?.items.empty();
}
""";
	val bad_p = "C:/Users/Admin/CLionProjects/Kobel/tests/unit/bad_safenav_virtual.kb";
	val bad_analysis = AnalysisResult(bad_p, bad_src, "", false);
	var saw_safenav_err = false;
	for (d in bad_analysis.diagnostics) {
		if (d.severity == 1 && "Safe navigation" in d.message) saw_safenav_err = true;
	}
	assert_true(saw_safenav_err, "non-scalar safe-navigation chain without safe default must report LSP error");

	println("  [PASS] test_dead_code_and_quickfixes");
}

pub fn main() {
	println("Running LSP unit tests...");
	test_json_and_uri();
	test_new_features_and_semantics();
	test_code_actions();
	test_preloaded_stdlib_no_duplicate_diagnostics();
	test_error_union_lsp();
	test_dead_code_and_quickfixes();
	println("All LSP unit tests passed.");
}
