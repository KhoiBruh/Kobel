mod test.ptr_map;

use std.io.println;
use std.mem.alloc.*;
use std.collections.list.*;
use std.collections.ptr_map.*;

fn main(): i32 {
	val a = alloc<i32>();
	val b = alloc<i32>();
	val c = alloc<i32>();
	*a = 10;
	*b = 20;
	*c = 30;

	val ka = a as *u8;
	val kb = b as *u8;
	val kc = c as *u8;

	var m = PtrMap<i32>();
	defer m.delete();

	m.put(ka, 1);
	m.put(kb, 2);
	m.put(kc, 3);
	if (m.len != 3UZ) return 1;
	if (m.get_or(ka, -1) != 1) return 2;
	if (m.get_or(kc, -1) != 3) return 3;
	if (!(ka in m)) return 4;

	// A pointer that was never inserted must miss.
	val unknown = alloc<i32>();
	defer release<i32>(unknown);
	if (m.get_or(unknown as *u8, -1) != -1) return 5;

	// Overwrite keeps the size and replaces the value.
	m.put(kb, 22);
	if (m.get_or(kb, -1) != 22) return 6;
	if (m.len != 3UZ) return 7;

	// Removal leaves the probe sequence intact for the remaining keys.
	if (!m.remove(kb)) return 8;
	if (m.contains(kb)) return 9;
	if (m.len != 2UZ) return 10;
	if (m.get_or(ka, -1) != 1 || m.get_or(kc, -1) != 3) return 11;

	// Growth: insert enough entries to force several rehashes, then verify all.
	var keys = List<*u8>();
	defer keys.delete();
	for (i in 0..<200) {
		val p = alloc<i32>();
		*p = i as i32;
		keys += p as *u8;
		m.put(p as *u8, i as i32);
	}
	if (m.len != 202UZ) return 12;
	for (i in 0..<200) {
		if (m.get_or(keys[i], -1) != i as i32) return 13;
	}

	// Enumeration returns every live entry exactly once.
	val all_keys = m.keys();
	defer all_keys.delete();
	val all_vals = m.values();
	defer all_vals.delete();
	if (all_keys.len != 202UZ || all_vals.len != 202UZ) return 14;

	// clear() resets the table without losing the storage contract.
	m.clear();
	if (m.len != 0UZ || !m.empty()) return 15;

	for (i in 0..<200) release<i32>(keys[i] as &i32);
	release<i32>(a);
	release<i32>(b);
	release<i32>(c);

	println("[ALL PASSED] PtrMap passed all tests successfully!");
	return 0;
}
