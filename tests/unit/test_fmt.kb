use std.io.*;

use fmt.*;
use testsupport.assert.*;

// ============================================================================
// Test 1: Basic Declarations (struct, fn, mod, use)
// ============================================================================

fn test_basic_formatting() {
	val unformatted = "mod my.cool.module;\nuse std.io.*;\nuse std.collections.List;\nstruct Point{\nx:i32,\ny:i32\n}\nfn add(a:i32,b:i32):i32=>a+b;\n";
	val formatted = format_source(unformatted, FormatOptions());

	assert_true(("struct Point {" in formatted), "struct declaration must survive");
	assert_true(("pub " in formatted) || !("pub" in unformatted), "visibility must be preserved");
	assert_true(("fn add(a: i32, b: i32): i32 => a + b;" in formatted), "fn signature must be normalized");
	println("  [PASS] test_basic_formatting");
}

// ============================================================================
// Test 2: Smart Tabs & K&R Braces
// ============================================================================

fn test_knr_and_smart_tabs() {
	val code = "fn test_branch(x: i32): str {\nif (x > 0) {\nreturn \"positive\";\n} else {\nreturn \"zero or negative\";\n}\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("} else {" in formatted), "K&R else must stay on the closing brace line");
	assert_true(("if (x > 0) {" in formatted), "block body must stay on the condition line");
	assert_true(!("\nreturn" in formatted), "statements must be indented inside the function body");
	println("  [PASS] test_knr_and_smart_tabs");
}

// ============================================================================
// Test 3: Comment preservation
// ============================================================================

fn test_comments() {
	val code = "// Module header comment\nmod app.main;\n\n/*\n * Block line one.\n * Block line two.\n */\nstruct Point {\n\tpub x: i32\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("// Module header comment" in formatted), "line comment must survive");
	assert_true((" * Block line one." in formatted), "block comment line 1 must survive");
	assert_true((" * Block line two." in formatted), "block comment line 2 must survive");
	assert_true(!("\n\n * Block line two." in formatted), "no blank line may be injected into a block comment");
	println("  [PASS] test_comments");
}

// ============================================================================
// Test 4: `pub` on impl members survives (parser regression guard)
// ============================================================================

fn test_impl_visibility() {
	val code = "pub struct A {\n\tpub v: i32\n}\n\nimpl A {\n\n\tpub init(v: i32) {\n\t\treturn Self(v);\n\t}\n\n\tpub fn get(*self): i32 => self.v;\n\n\tfn hidden(*self) {\n\t\tval x = 1;\n\t}\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("pub init(" in formatted), "pub init inside impl must survive");
	assert_true(("pub fn get(" in formatted), "pub fn inside impl must survive");
	assert_true(("fn hidden(" in formatted), "non-pub method must stay non-pub");
	println("  [PASS] test_impl_visibility");
}

// ============================================================================
// Test 5: Single-line bodies, trailing whitespace and EOL normalization
// ============================================================================

fn test_whitespace_and_eol() {
	val code = "fn f(x: i32): i32 {\nif (x > 0) return 1;\nreturn 0;\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("if (x > 0) return 1;" in formatted), "single-line if body must stay on one line");
	assert_true(!(" \n" in formatted), "no trailing whitespace");

	val crlf = "mod m;\r\n\r\nfn g() {\r\n}\r\n";
	val normalized = format_source(crlf, FormatOptions());
	assert_true(!("\r" in normalized), "CRLF input must be normalized to LF output");
	println("  [PASS] test_whitespace_and_eol");
}

// ============================================================================
// Test 6: Formatting is idempotent
// ============================================================================

fn test_idempotent() {
	val code = "mod m;\n\npub struct S {\n\tpub a: i32,\n\tpub b: i32\n}\n\nimpl S {\n\n\tpub init(a: i32, b: i32) {\n\t\treturn Self(a, b);\n\t}\n}\n\nfn f(s: S): i32 {\n\tif (s.a > s.b) return s.a;\n\treturn s.b;\n}\n";
	val once = format_source(code, FormatOptions());
	val twice = format_source(once, FormatOptions());

	assert_eq_str(twice, once, "formatting twice must equal formatting once");
	println("  [PASS] test_idempotent");
}

fn test_multiline_literal_preserved() {
	val code = "fn msg(): str {\n\treturn \"\"\"\n\tline one\n\tline two\n\t\"\"\";\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("\"\"\"" in formatted), "multiline literal must keep its triple quotes");
	assert_true(("line one" in formatted), "multiline literal content must survive");
	assert_true(("\n\tline two" in formatted), "multiline literal must keep its own line breaks");
	println("  [PASS] test_multiline_literal_preserved");
}

fn test_wraps_long_lines() {
	val code = "fn process(first_parameter: i32, second_parameter: i32, third_parameter: i32, fourth_parameter: i32, fifth_parameter: i32): i32 {\n\treturn 0;\n}\n";
	val formatted = format_source(code, FormatOptions());

	var longest: usz = 0;
	val lines = formatted.split_lines();
	for (line in lines) {
		if (line.len > longest) longest = line.len;
	}
	assert_true(longest <= 100, "formatter must wrap lines wider than max_width");
	assert_true((",\n" in formatted), "wrapped list must break after a comma");
	println("  [PASS] test_wraps_long_lines");
}

fn test_lambda_formatting() {
	val code = "fn run(a: i32, f: (i32) -> i32): i32 {\n\tval x = list.filter { item -> item > 0 };\n\tval y = list.fold(0) { acc, item ->\n\t\tval next = acc + item;\n\t\tyield next;\n\t};\n\treturn f(a);\n}\n";
	val once = format_source(code, FormatOptions());
	val twice = format_source(once, FormatOptions());

	assert_eq_str(twice, once, "lambda formatting must be idempotent");
	assert_true(("f: (i32) -> i32" in once), "function type parameter must format cleanly");
	assert_true(("list.filter { item -> item > 0 }" in once), "single-arg trailing lambda must format without parens");
	assert_true(("list.fold(0) { acc, item ->" in once), "multi-arg trailing lambda must format with normal args in parens");
	println("  [PASS] test_lambda_formatting");
}

fn test_generic_impl_assoc_and_payload_enum() {
	val code = """pub struct Opaque;

trait Container {
	type Item;
	fn get(*self): Self.Item;
}

struct HashMap<K: Hash, V> {
	pub len: usz
}

impl HashMap<K: Hash, V> {
	pub fn empty(*self) => self.len == 0;
}

impl Container for HashMap<K: Hash, V> {
	type Item = V;
	fn get(*self): Self.Item => self.len as Self.Item;
}

enum Shape {
	Circle(radius: f64),
	Point
}
""";
	val once = format_source(code, FormatOptions());
	val twice = format_source(once, FormatOptions());
	assert_eq_str(twice, once, "generic impl, assoc types, and payload enum formatting must be idempotent");
	assert_true(("pub struct Opaque;" in once), "forward struct must keep semicolon");
	assert_true(("impl HashMap<K: Hash, V> {" in once), "generic params on impl belong on target struct, not after impl");
	assert_true(("impl Container for HashMap<K: Hash, V> {" in once), "trait generic impl must put type params after target struct");
	assert_true(("type Item;" in once), "trait associated type must be preserved");
	assert_true(("type Item = V;" in once), "impl associated type binding must be preserved");
	assert_true(("Circle(radius: f64)," in once), "payload enum fields must be preserved");

	val in_code = "fn has(x: i32, list: List<i32>): bool {\n\tif (x !in list) return false;\n\treturn x in list;\n}\n";
	val in_once = format_source(in_code, FormatOptions());
	val in_twice = format_source(in_once, FormatOptions());
	assert_eq_str(in_twice, in_once, "in and !in formatting must be idempotent");
	assert_true(("!(x in list)" in in_once), "!in must format with parens around BinaryExpr");
	assert_true(("return x in list;" in in_once), "in operator must be preserved");

	val not_is_code = "fn check_not(x: Shape): bool {\n\twhen (x) {\n\t\t!is Circle -> return true;\n\t\telse -> return false;\n\t}\n\treturn x !is Circle;\n}\n";
	val not_is_once = format_source(not_is_code, FormatOptions());
	val not_is_twice = format_source(not_is_once, FormatOptions());
	assert_eq_str(not_is_twice, not_is_once, "!is formatting must be idempotent");
	assert_true(("!(x is Circle)" in not_is_once), "infix !is must format with parens around IsExpr");
	assert_true(("!is Circle -> return true;" in not_is_once), "when arm !is must format without parens");

	val type_list_code = "fn has_kind(x: AstNode): bool {\n\tif (x !is [BinaryExpr, AssignExpr]) return false;\n\twhen (x) {\n\t\tis [.Literal, .Binary] -> return true;\n\t\telse -> return false;\n\t}\n\treturn x is [BinaryExpr, AssignExpr];\n}\n";
	val type_list_once = format_source(type_list_code, FormatOptions());
	val type_list_twice = format_source(type_list_once, FormatOptions());
	assert_eq_str(type_list_twice, type_list_once, "is/!is [...] formatting must be idempotent");
	assert_true(("!(x is [BinaryExpr, AssignExpr])" in type_list_once), "!is [...] must format cleanly");
	assert_true(("is [.Literal, .Binary] -> return true;" in type_list_once), "when arm is [...] with leading dots must preserve syntax");
	assert_true(("return x is [BinaryExpr, AssignExpr];" in type_list_once), "is [...] must preserve syntax");

	val nullable_ptr_code = "fn ptr_ops(a: ?*i32, b: ?&Node, c: *?*i32, d: &?*i32, e: ?*?*Node): ?*i32 {\n\tval casted = a as ?*i32;\n\treturn casted;\n}\n";
	val np_once = format_source(nullable_ptr_code, FormatOptions());
	val np_twice = format_source(np_once, FormatOptions());
	assert_eq_str(np_twice, np_once, "prefix nullable pointer formatting must be idempotent");
	assert_true(("fn ptr_ops(a: ?*i32, b: ?&Node, c: *?*i32, d: &?*i32, e: ?*?*Node): ?*i32 {" in np_once), "prefix nullable pointers must format cleanly");
	assert_true(("val casted = a as ?*i32;" in np_once), "as ?*T must format cleanly");

	val broken = "fn broken( { x = ";
	assert_true(!is_parseable(broken), "broken syntax must fail parseability check");
	println("  [PASS] test_generic_impl_assoc_and_payload_enum");
}

fn main(): i32 {
	println("[RUNNING] Kobel Formatter tests...");
	test_basic_formatting();
	test_knr_and_smart_tabs();
	test_comments();
	test_impl_visibility();
	test_whitespace_and_eol();
	test_multiline_literal_preserved();
	test_wraps_long_lines();
	test_lambda_formatting();
	test_idempotent();
	test_generic_impl_assoc_and_payload_enum();
	println("[ALL PASSED] Kobel Formatter tests passed successfully!");
	return 0;
}
