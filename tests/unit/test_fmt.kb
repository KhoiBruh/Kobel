use std.io.*;
use std.process.Process;

use fmt.*;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
		Process.exit(1);
	}
}

fn assert_eq_str(actual: str, expected: str, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		println(msg);
		print("  Expected:\n");
		println(expected);
		print("  Actual:\n");
		println(actual);
		Process.exit(1);
	}
}

// ============================================================================
// Test 1: Basic Declarations (struct, fn, mod, use)
// ============================================================================

fn test_basic_formatting() {
	val unformatted = "mod my.cool.module;\nuse std.io.*;\nuse std.collections.List;\nstruct Point{\nx:i32,\ny:i32\n}\nfn add(a:i32,b:i32):i32=>a+b;\n";
	val formatted = format_source(unformatted, FormatOptions());

	assert_true(("struct Point {" in formatted), "struct declaration must survive");
	assert_true(("pub " in formatted) || !("pub" in unformatted), "visibility must be preserved");
	assert_true(("fn add(a: i32, b: i32): i32 => a + b;" in formatted), "fn signature must be normalized");
	println("  [PASS] test_basic_formatting");
}

// ============================================================================
// Test 2: Smart Tabs & K&R Braces
// ============================================================================

fn test_knr_and_smart_tabs() {
	val code = "fn test_branch(x: i32): str {\nif (x > 0) {\nreturn \"positive\";\n} else {\nreturn \"zero or negative\";\n}\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("} else {" in formatted), "K&R else must stay on the closing brace line");
	assert_true(("if (x > 0) {" in formatted), "block body must stay on the condition line");
	assert_true(!("\nreturn" in formatted), "statements must be indented inside the function body");
	println("  [PASS] test_knr_and_smart_tabs");
}

// ============================================================================
// Test 3: Comment preservation
// ============================================================================

fn test_comments() {
	val code = "// Module header comment\nmod app.main;\n\n/*\n * Block line one.\n * Block line two.\n */\nstruct Point {\n\tpub x: i32\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("// Module header comment" in formatted), "line comment must survive");
	assert_true((" * Block line one." in formatted), "block comment line 1 must survive");
	assert_true((" * Block line two." in formatted), "block comment line 2 must survive");
	assert_true(!("\n\n * Block line two." in formatted), "no blank line may be injected into a block comment");
	println("  [PASS] test_comments");
}

// ============================================================================
// Test 4: `pub` on impl members survives (parser regression guard)
// ============================================================================

fn test_impl_visibility() {
	val code = "pub struct A {\n\tpub v: i32\n}\n\nimpl A {\n\n\tpub init(v: i32) {\n\t\treturn Self(v);\n\t}\n\n\tpub fn get(val self): i32 => self.v;\n\n\tfn hidden(val self) {\n\t\tval x = 1;\n\t}\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("pub init(" in formatted), "pub init inside impl must survive");
	assert_true(("pub fn get(" in formatted), "pub fn inside impl must survive");
	assert_true(("fn hidden(" in formatted), "non-pub method must stay non-pub");
	println("  [PASS] test_impl_visibility");
}

// ============================================================================
// Test 5: Single-line bodies, trailing whitespace and EOL normalization
// ============================================================================

fn test_whitespace_and_eol() {
	val code = "fn f(x: i32): i32 {\nif (x > 0) return 1;\nreturn 0;\n}\n";
	val formatted = format_source(code, FormatOptions());

	assert_true(("if (x > 0) return 1;" in formatted), "single-line if body must stay on one line");
	assert_true(!(" \n" in formatted), "no trailing whitespace");

	val crlf = "mod m;\r\n\r\nfn g() {\r\n}\r\n";
	val normalized = format_source(crlf, FormatOptions());
	assert_true(!("\r" in normalized), "CRLF input must be normalized to LF output");
	println("  [PASS] test_whitespace_and_eol");
}

// ============================================================================
// Test 6: Formatting is idempotent
// ============================================================================

fn test_idempotent() {
	val code = "mod m;\n\npub struct S {\n\tpub a: i32,\n\tpub b: i32\n}\n\nimpl S {\n\n\tpub init(a: i32, b: i32) {\n\t\treturn Self(a, b);\n\t}\n}\n\nfn f(s: S): i32 {\n\tif (s.a > s.b) return s.a;\n\treturn s.b;\n}\n";
	val once = format_source(code, FormatOptions());
	val twice = format_source(once, FormatOptions());

	assert_eq_str(twice, once, "formatting twice must equal formatting once");
	println("  [PASS] test_idempotent");
}

fn main(): i32 {
	println("[RUNNING] Kobel Formatter tests...");
	test_basic_formatting();
	test_knr_and_smart_tabs();
	test_comments();
	test_impl_visibility();
	test_whitespace_and_eol();
	test_idempotent();
	println("[ALL PASSED] Kobel Formatter tests passed successfully!");
	return 0;
}
