mod test.bootstrap_parser;

use std.io.print;
use std.io.println;

use compiler.lexer.Lexer;
use compiler.lexer.TokenType;
use compiler.lexer.Token;

use compiler.ast.*;

use compiler.parser.*;
use testsupport.assert.*;

// ============================================================================
// Test 1: Expression Precedence & Associativity (Pratt Parsing)
// ============================================================================

fn test_expression_parsing() {
	// Check association and precedence of the expression: 1 + 2 * 3
	val src = "1 + 2 * 3";
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val expr = parser.parse_expression(Precedence.NONE);

	assert_true(expr is BinaryExpr, "Root node must be binary expr");
	if (expr is BinaryExpr as bin_root) {
		assert_true(bin_root.op == TokenType.PLUS, "Root operator must be '+'");

		val left_node = bin_root.left;
		assert_true(left_node is LiteralExpr, "Left child must be literal 1");
		if (left_node is LiteralExpr as left_lit) {
			assert_eq_str(left_lit.raw_text, "1", "Left literal text must be 1");
		}

		val right_node = bin_root.right;
		assert_true(right_node is BinaryExpr, "Right child must be binary expr (2 * 3)");
		if (right_node is BinaryExpr as bin_mul) {
			assert_true(bin_mul.op == TokenType.STAR, "Inner operator must be '*'");
		}
	}

	println("  [PASS] test_expression_parsing");
}

// ============================================================================
// Test 2: Call, Member Access and Arguments
// ============================================================================

fn test_call_and_member_parsing() {
	val src = "player.move_to(100, 200 + 5)";
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val expr = parser.parse_expression(Precedence.NONE);

	assert_true(expr is CallExpr, "Top node must be CallExpr");
	if (expr is CallExpr as call_expr) {
		assert_eq_usz(call_expr.args.len, 2, "Call must have 2 arguments");

		val callee = call_expr.callee;
		assert_true(callee is MemberExpr, "Callee must be MemberExpr");
		if (callee is MemberExpr as mem_expr) {
			assert_eq_str(mem_expr.member, "move_to", "Member name must be 'move_to'");

			val obj = mem_expr.object;
			assert_true(obj is IdentifierExpr, "Object must be Identifier");
		if (obj is IdentifierExpr as id_expr) {
				assert_eq_str(id_expr.name, "player", "Identifier name must be 'player'");
			}
		}
	}

	println("  [PASS] test_call_and_member_parsing");
}

// ============================================================================
// Test 3: Type Parsing
// ============================================================================

fn test_type_parsing() {
	val src = "std.collections.List<*Point>";
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val type_node = parser.parse_type();

	assert_true(type_node is NamedType, "Parsed type must be NamedType");
	if (type_node is NamedType as named) {
		assert_eq_str(named.name, "std.collections.List", "Type path must match");
	assert_eq_usz(named.type_args.len, 1, "Type must have 1 generic argument");

		val arg0 = named.type_args[0];
		assert_true(arg0 is PointerType, "Generic argument must be PointerType");
	}

	println("  [PASS] test_type_parsing");
}

fn check_valid_ptr_type(src: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	val ty = p.parse_type();
	assert_true(p.errors.empty(), "Valid nullable pointer syntax must parse without errors");
	assert_true(ty is PointerType, "Outer parsed type must be PointerType");
}

fn check_valid_ptr_expr(src: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	val ex = p.parse_expression(Precedence.NONE);
	assert_true(p.errors.empty(), "Nullable pointer in cast/type-test expression must parse cleanly");
	assert_true(ex != null, "Parsed expression must not be null");
}

fn check_bad_type_syntax(src: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	p.parse_type();
	assert_true(!p.errors.empty(), "Legacy or non-pointer nullable syntax must be rejected");
}

fn test_nullable_pointer_parsing() {
	// 1. Prefix nullable pointers (?*T, ?&T) and nested combinations (*?*T, &?*T, ?*?*T, ?**T)
	check_valid_ptr_type("?*i32");
	check_valid_ptr_type("?&Node");
	check_valid_ptr_type("*?*i32");
	check_valid_ptr_type("&?*i32");
	check_valid_ptr_type("?*?*i32");
	check_valid_ptr_type("?**i32");

	var l_nested = Lexer("&?*i32");
	var p_nested = Parser(l_nested.tokenize());
	val nested_ty = p_nested.parse_type();
	assert_true(nested_ty is PointerType, "&?*i32 must be PointerType");
	if (nested_ty is PointerType as outer) {
		assert_true(outer.mutable && !outer.nullable, "Outer & in &?*i32 must be mutable non-null");
		assert_true(outer.pointee is PointerType, "Pointee of &?*i32 must be PointerType");
		if (outer.pointee is PointerType as inner) {
			assert_true(!inner.mutable && inner.nullable, "Inner ?* in &?*i32 must be read-only nullable");
		}
	}

	// 2. Expression contexts: `as ?*T`, `is ?*T`, `!is [?*A, ?&B]`
	check_valid_ptr_expr("x as ?*Node");
	check_valid_ptr_expr("x is ?*Node");
	check_valid_ptr_expr("x !is [?*Node, ?&Expr]");

	// 3. Legacy postfix '?' and non-pointer nullable syntax must be rejected
	check_bad_type_syntax("i32?");
	check_bad_type_syntax("*Node?");
	check_bad_type_syntax("&Node?");
	check_bad_type_syntax("?i32");

	var l_as_q = Lexer("x as? Node");
	var p_as_q = Parser(l_as_q.tokenize());
	p_as_q.parse_expression(Precedence.NONE);
	assert_true(!p_as_q.errors.empty(), "Removed as? operator must still be rejected");

	println("  [PASS] test_nullable_pointer_parsing");
}

// ============================================================================
// Test 4: Statement Parsing
// ============================================================================

fn test_statement_parsing() {
	val src = "val total: i32 = (a + b) * 10;";
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val stmt = parser.parse_statement();

	assert_true(stmt is VarDeclStmt, "Must be VarDeclStmt");
	if (stmt is VarDeclStmt as var_decl) {
		assert_true(!var_decl.mutable, "VarDecl must be immutable (val)");
		assert_eq_str(var_decl.name, "total", "VarDecl name must be 'total'");
		assert_true(var_decl.type_annotation != null, "VarDecl must have type annotation");
		assert_true(var_decl.initializer != null, "VarDecl must have initializer");
	}

	println("  [PASS] test_statement_parsing");
}

// ============================================================================
// Test 5: Full Program Parsing
// ============================================================================

fn test_full_program_parsing() {
	val src = """
		mod sample.math;
		use std.io.println;
		pub struct Vector2D {
		    pub x: i32,
		    pub y: i32
		}
		pub fn add(a: i32, b: i32): i32 => a + b;
		fn main(): i32 {
		    val v: Vector2D = Vector2D(10, 20);
		    return add(v.x, v.y);
		}
	""";

	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val program_node = parser.parse_program();

	assert_eq_usz(parser.errors.len, 0, "Parser must have 0 syntax errors");
	assert_true(program_node is Program, "Root node must be Program");
	if (program_node is Program as prog) {
		assert_eq_usz(prog.declarations.len, 5, "Program must contain 5 declarations");

		// Decl 0: ModuleDecl
		val d0 = prog.declarations[0];
		assert_true(d0 is ModuleDecl, "Decl 0 must be DECL_MODULE");
		if (d0 is ModuleDecl as m_decl) {
			assert_eq_str(m_decl.full_path, "sample.math", "Module path must match");
		}

		// Decl 1: UseDecl
		val d1 = prog.declarations[1];
		assert_true(d1 is UseDecl, "Decl 1 must be DECL_USE");
		if (d1 is UseDecl as u_decl) {
			assert_eq_str(u_decl.full_path, "std.io.println", "Use path must match");
		}

		// Decl 2: StructDecl
		val d2 = prog.declarations[2];
		assert_true(d2 is StructDecl, "Decl 2 must be DECL_STRUCT");
		if (d2 is StructDecl as s_decl) {
			assert_eq_str(s_decl.name, "Vector2D", "Struct name must match");
			assert_true(s_decl.public, "Struct must be pub");
			assert_eq_usz(s_decl.fields.len, 2, "Struct must have 2 fields");
		}

		// Decl 3: FnDecl (add)
		val d3 = prog.declarations[3];
		assert_true(d3 is FnDecl, "Decl 3 must be DECL_FN");
		if (d3 is FnDecl as fn_add) {
			assert_eq_str(fn_add.name, "add", "Function name must be 'add'");
			assert_true(fn_add.public, "Function must be pub");
			assert_eq_usz(fn_add.params.len, 2, "Function must have 2 params");
		}

		// Decl 4: FnDecl (main)
		val d4 = prog.declarations[4];
		assert_true(d4 is FnDecl, "Decl 4 must be DECL_FN");
		if (d4 is FnDecl as fn_main) {
			assert_eq_str(fn_main.name, "main", "Function name must be 'main'");
			assert_true(!fn_main.public, "Function must not be pub");
			assert_eq_usz(fn_main.params.len, 0, "Main must have 0 params");
		}
	}

	println("  [PASS] test_full_program_parsing");
}

fn test_adjacent_strings_parsing() {
	// Test adjacent plain string concatenation
	val src1 = "\"hello \" \"world\"";
	var lexer1 = Lexer(src1);
	var parser1 = Parser(lexer1.tokenize());
	val expr1 = parser1.parse_expression(Precedence.NONE);

	assert_true(expr1 is LiteralExpr, "Must be literal expr");
	if (expr1 is LiteralExpr as lit1) {
		assert_eq_str(lit1.raw_text, "\"hello world\"", "Concatenated literal must be '\"hello world\"'");
	}

	// Test multi-line adjacent strings
	val src2 = "\"a\" \n \"b\" \n \"c\"";
	var lexer2 = Lexer(src2);
	var parser2 = Parser(lexer2.tokenize());
	val expr2 = parser2.parse_expression(Precedence.NONE);

	assert_true(expr2 is LiteralExpr, "Must be literal expr");
	if (expr2 is LiteralExpr as lit2) {
		assert_eq_str(lit2.raw_text, "\"abc\"", "Concatenated literal must be '\"abc\"'");
	}

	println("  [PASS] test_adjacent_strings_parsing");
}

fn test_multiline_string_parsing() {
	val src = "\"\"\"\n\tline 1\n\tline 2\n\"\"\"";
	var lexer = Lexer(src);
	var parser = Parser(lexer.tokenize());
	val expr = parser.parse_expression(Precedence.NONE);

	assert_true(expr is LiteralExpr, "Must be literal expr");
	if (expr is LiteralExpr as lit) {
		assert_eq_str(lit.raw_text, "\"line 1\\nline 2\"", "Trimmed multiline literal must be '\"line 1\\nline 2\"'");
	}

	println("  [PASS] test_multiline_string_parsing");
}

fn test_safe_member_and_elvis_parsing() {
	val src = "user?.profile?.name ?: \"guest\"";
	var lexer = Lexer(src);
	val tokens = lexer.tokenize();

	var parser = Parser(tokens);
	val expr = parser.parse_expression(Precedence.NONE);

	assert_true(expr is BinaryExpr, "Root node must be binary expr (elvis)");
	if (expr is BinaryExpr as elvis_bin) {
		assert_true(elvis_bin.op == TokenType.QUESTION_COLON, "Operator must be '?:'");

		val left = elvis_bin.left;
		assert_true(left is MemberExpr, "LHS must be MemberExpr");
		if (left is MemberExpr as name_mem) {
			assert_true(name_mem.is_safe, "name_mem must be safe");
			assert_eq_str(name_mem.member, "name", "Member must be 'name'");

			val inner_obj = name_mem.object;
			assert_true(inner_obj is MemberExpr, "inner_obj must be MemberExpr");
			if (inner_obj is MemberExpr as prof_mem) {
				assert_true(prof_mem.is_safe, "prof_mem must be safe");
				assert_eq_str(prof_mem.member, "profile", "Member must be 'profile'");

				val user_obj = prof_mem.object;
				assert_true(user_obj is IdentifierExpr, "user_obj must be IdentifierExpr");
				if (user_obj is IdentifierExpr as user_id) {
					assert_eq_str(user_id.name, "user", "Identifier must be 'user'");
				}
			}
		}
	}

	println("  [PASS] test_safe_member_and_elvis_parsing");
}

fn check_bad_program_syntax(src: str, msg: str) {
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	p.parse_program();
	assert_true(!p.errors.empty(), msg);
}

fn test_val_var_self_rejected() {
	check_bad_program_syntax("impl S { fn f(val self) {} }", "Must reject 'val self'");
	check_bad_program_syntax("impl S { fn f(var self) {} }", "Must reject 'var self'");
	check_bad_program_syntax("fn f(var x: i32) {}", "Must reject 'var' parameter modifier");
	check_bad_program_syntax("fn f(val x: i32) {}", "Must reject 'val' parameter modifier");
	check_bad_program_syntax("fn f(a: i32, var b: *i32) {}", "Must reject 'var' on trailing parameter");
	check_bad_program_syntax("fn f(a: i32, val b: &i32) {}", "Must reject 'val' on trailing parameter");
	check_bad_program_syntax("impl S { init(var x: i32) {} }", "Must reject 'var' in init parameter");
	check_bad_program_syntax("impl S { op plus(*self, val rhs: S): S {} }", "Must reject 'val' in op parameter");

	val src_valid = "impl S { fn f(*self, a: i32, b: *i32, c: &i32) {} fn g(&self) {} fn h(self) {} }";
	var l_valid = Lexer(src_valid);
	var p_valid = Parser(l_valid.tokenize());
	p_valid.parse_program();
	assert_eq_usz(p_valid.errors.len, 0, "Must accept '*self', '&self', 'self', and pointer/value parameters without val/var");

	println("  [PASS] test_val_var_self_rejected");
}

fn test_not_is_parsing() {
	val src = "fn f(x: Shape): bool { when (x) { !is Circle -> return true; else -> {} } return x !is Rect; }";
	var l = Lexer(src);
	var p = Parser(l.tokenize());
	val prog = p.parse_program();
	assert_eq_usz(p.errors.len, 0, "Valid '!is' expressions must parse without errors");
	assert_true(prog is Program, "Parsed node must be Program");

	val bad_infix = "fn f(x: Shape): bool { return x !is Circle as c; }";
	var l_bad1 = Lexer(bad_infix);
	var p_bad1 = Parser(l_bad1.tokenize());
	p_bad1.parse_program();
	assert_true(p_bad1.errors.len >= 1, "Must reject 'x !is Type as alias'");

	val bad_prefix = "fn f(x: Shape): i32 { return when (x) { !is Circle as c -> 1; else -> 0; }; }";
	var l_bad2 = Lexer(bad_prefix);
	var p_bad2 = Parser(l_bad2.tokenize());
	p_bad2.parse_program();
	assert_true(p_bad2.errors.len >= 1, "Must reject '!is Type as alias' in when arm");

	val src_list = "fn f(x: Shape): bool { when (x) { is [.Circle, .Rect] -> return true; !is [Empty] -> return false; else -> {} } return x is [Circle, Rect] && x !is [Empty]; }";
	var l_list = Lexer(src_list);
	var p_list = Parser(l_list.tokenize());
	p_list.parse_program();
	assert_eq_usz(p_list.errors.len, 0, "Valid 'is [...]' and '!is [...]' must parse without errors");

	val bad_list_alias = "fn f(x: Shape): bool { return x is [Circle, Rect] as c; }";
	var l_bad3 = Lexer(bad_list_alias);
	var p_bad3 = Parser(l_bad3.tokenize());
	p_bad3.parse_program();
	assert_eq_usz(p_bad3.errors.len, 1, "Must reject 'x is [A, B] as alias' with single error");

	val bad_not_list_alias = "fn f(x: Shape): bool { return x !is [Circle, Rect] as c; }";
	var l_bad4 = Lexer(bad_not_list_alias);
	var p_bad4 = Parser(l_bad4.tokenize());
	p_bad4.parse_program();
	assert_eq_usz(p_bad4.errors.len, 1, "Must reject 'x !is [A, B] as alias' with single error");

	println("  [PASS] test_not_is_parsing");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Parser tests...");
	test_val_var_self_rejected();
	test_not_is_parsing();
	test_expression_parsing();
	test_call_and_member_parsing();
	test_safe_member_and_elvis_parsing();
	test_type_parsing();
	test_nullable_pointer_parsing();
	test_statement_parsing();
	test_full_program_parsing();
	test_adjacent_strings_parsing();
	test_multiline_string_parsing();
	println("[ALL PASSED] Bootstrap Parser passed all tests successfully!");
	return 0;
}
