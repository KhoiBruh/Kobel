mod tests.features.test_control_flow;

use std.io.print;
use std.io.println;
use std.string.*;
use std.collections.*;
use std.traits.*;

// ============================================================================
// `for` loop tests (phase 1: iterable lowering + closed/open ranges)
// ============================================================================

struct Bundle {
	pub name: str,
	pub id: i32
}

struct Tally {
	pub fails: i32
}

fn check(ok: bool, msg: str, t: &Tally) {
	if (!ok) {
		t.fails = t.fails + 1;
		print("  [FAIL] ");
		println(msg);
	}
}

// -- ranges (closed, both directions) ----------------------------------------

fn test_range_closed_asc(t: &Tally) {
	var sum: i32 = 0;
	var count: i32 = 0;
	for (i in 0..4) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 5, "closed 0..4 must run 5 times", t);
	check(sum == 10, "closed 0..4 sum must be 10", t);
}

fn test_range_closed_desc(t: &Tally) {
	var sum: i32 = 0;
	var count: i32 = 0;
	for (i in 4..0) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 5, "closed 4..0 must run 5 times", t);
	check(sum == 10, "closed 4..0 sum must be 10", t);

	count = 0;
	for (i in 3..3) count = count + 1;
	check(count == 1, "closed 3..3 must run exactly once", t);
}

fn test_range_open(t: &Tally) {
	var sum: i32 = 0;
	var count: i32 = 0;
	for (i in 0>..<4) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 3, "open 0>..<4 must run 3 times", t);
	check(sum == 6, "open 0>..<4 sum must be 6", t);

	sum = 0;
	count = 0;
	for (i in 4>..<0) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 3, "open 4>..<0 must run 3 times", t);
	check(sum == 6, "open 4>..<0 sum must be 6", t);

	count = 0;
	for (i in 1>..<2) count = count + 1;
	check(count == 0, "open 1>..<2 must be empty", t);

	count = 0;
	for (i in 2>..<1) count = count + 1;
	check(count == 0, "open 2>..<1 must be empty", t);
}

// The counter takes the type of the end bound: `n: usz` must make `i` a usz.
fn test_range_bound_type(t: &Tally, n: usz) {
	var total: usz = 0;
	for (i in 0..n) {
		val same: &usz = &i;
		total = total + i;
	}
	check(total == 15, "0..5(usz) sum must be 15", t);
}

// -- iterables ----------------------------------------------------------------

fn test_iter_list(t: &Tally) {
	var nums = List<i32>();
	defer nums.free();
	nums += 10;
	nums += 20;
	nums += 30;

	var sum: i32 = 0;
	var count: i32 = 0;
	for (x in nums) {
		sum = sum + x;
		count = count + 1;
	}
	check(count == 3, "list iteration must run 3 times", t);
	check(sum == 60, "list iteration sum must be 60", t);

	// The list is borrowed, not moved: it must stay usable after the loop.
	check(nums.len == 3, "list must keep its length after the loop", t);
	nums += 40;
	check(nums.len == 4, "list must still be appendable after the loop", t);
}

fn test_iter_str(t: &Tally) {
	val s = "hello";
	var count: i32 = 0;
	var hits: i32 = 0;
	for (c in s) {
		count = count + 1;
		if (c == 'e') hits = hits + 1;
		if (c == 'o') hits = hits + 1;
	}
	check(count == 5, "str iteration must run 5 times", t);
	check(hits == 2, "str iteration must find 'e' and 'o'", t);
}

fn test_iter_member(t: &Tally) {
	val box = Bundle("abc", 7);
	var count: i32 = 0;
	var last: char = '?';
	for (c in box.name) {
		count = count + 1;
		last = c;
	}
	check(count == 3, "member str iteration must run 3 times", t);
	check(last == 'c', "member str iteration must see the last char", t);
}

fn test_nested(t: &Tally) {
	var count: i32 = 0;
	for (i in 0..2) {
		for (j in 0..2) count = count + 1;
	}
	check(count == 9, "nested for must run 9 times", t);
}

// `continue` must not skip the counter update; the loop must still terminate.
fn test_break_continue(t: &Tally) {
	var count: i32 = 0;
	for (i in 0..10) {
		if (i == 3) continue;
		if (i == 7) break;
		count = count + 1;
	}
	check(count == 6, "continue must still advance the counter", t);

	// `continue` inside a `when` arm
	var sum: i32 = 0;
	for (i in 0..6) {
		when (i) {
			1 -> continue;
			2, 3 -> sum = sum + 10;
			else -> sum = sum + 1;
		}
	}
	check(sum == 24, "continue in a when arm must still advance the counter", t);
}

// The loop variable is read-only and fresh on every iteration.
fn test_loop_var_is_fresh(t: &Tally) {
	var sum = List<i32>();
	defer sum.free();
	for (i in 0..3) sum += i;
	val a = sum[0];
	val b = sum[2];
	check(a == 0 && b == 2, "loop variable must be fresh per iteration", t);
}

// A generic function body containing `for` (exercises monomorphization + clone).
fn count_items<T>(xs: List<T>): i32 {
	var n: i32 = 0;
	for (x in xs) n = n + 1;
	return n;
}

fn test_generic_for(t: &Tally) {
	var nums = List<i32>();
	defer nums.free();
	nums += 5;
	nums += 6;
	val n = count_items<i32>(nums);
	check(n == 2, "generic function with for must count 2", t);
}

// Half-open ranges: the end bound is excluded, so `0..<n` works for an empty
// container without ever computing `n - 1`.
fn test_range_half_open(t: &Tally) {
	var sum: i32 = 0;
	var count: i32 = 0;
	for (i in 0..<5) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 5, "half-open 0..<5 must run 5 times", t);
	check(sum == 10, "half-open 0..<5 sum must be 10", t);

	sum = 0;
	count = 0;
	for (i in 5..<0) {
		sum = sum + i;
		count = count + 1;
	}
	check(count == 5, "half-open 5..<0 must run 5 times (5..1)", t);
	check(sum == 15, "half-open 5..<0 sum must be 15", t);

	count = 0;
	for (i in 3..<3) count = count + 1;
	check(count == 0, "half-open 3..<3 must be empty", t);

	count = 0;
	for (i in 2..<5) count = count + 1;
	check(count == 3, "half-open 2..<5 must run 3 times", t);

	var evens = 0;
	for (i in 0..<10) {
		if (i % 2 != 0) continue;
		if (i > 6) break;
		evens = evens + 1;
	}
	check(evens == 4, "half-open 0..<10 with continue and break (0, 2, 4, 6)", t);
}

// `0..<n` is the index-loop idiom: index any number of parallel containers.
fn test_range_half_open_index(t: &Tally) {
	var nums = List<i32>();
	defer nums.free();
	nums += 10;
	nums += 20;
	nums += 30;
	var rev = List<i32>();
	defer rev.free();
	rev += 1;
	rev += 2;
	rev += 3;

	var sum: i32 = 0;
	var seps: i32 = 0;
	for (i in 0..<nums.len) {
		if (i > 0) seps = seps + 1;
		sum = sum + nums[i] + rev[i];
	}
	check(sum == 66, "indexed half-open loop must sum both lists", t);
	check(seps == 2, "indexed half-open loop must see i > 0 twice", t);
}

// Empty container: `0..<len` with len = 0 must not iterate at all (the closed
// form `0..len-1` would wrap and loop forever on an unsigned bound).
fn test_range_half_open_empty(t: &Tally, n: usz) {
	var count: i32 = 0;
	for (i in 0..<n) {
		val same: &usz = &i;
		count = count + 1;
	}
	check(count == 0, "half-open 0..<0 must be empty", t);
}

// -- Iterable trait: a container that is not a flat array ---------------------

struct Steps {
	pub n: i32
}

// Elements are computed from the index, so this type has no `.data` array at
// all: only the `Iterable` contract makes it loopable.
impl Iterable for Steps {
	fn count(*self): usz => self.n as usz;
	fn at(*self, i: usz): i32 => (i as i32) * 10;
}

fn test_iterable_trait(t: &Tally) {
	val s = Steps(3);
	var sum: i32 = 0;
	var seen: i32 = 0;
	for (v in s) {
		sum = sum + v;
		seen = seen + 1;
	}
	check(seen == 3, "Iterable: loop runs count() times", t);
	check(sum == 30, "Iterable: elements come from at(i)", t);

	// An empty container must not run the body at all.
	val e = Steps(0);
	var hits: i32 = 0;
	for (v in e) hits = hits + 1;
	check(hits == 0, "Iterable: empty container runs zero times", t);

	// Pointer to an Iterable container must also be loopable
	val s_ptr = &s;
	var ptr_sum: i32 = 0;
	for (v in s_ptr) {
		ptr_sum = ptr_sum + v;
	}
	check(ptr_sum == 30, "Iterable: pointer to container can be iterated", t);
}

// -- Array<T> and candidate-list containment (`in [...]`) ---------------------

struct Vec2 {
	pub x: i32,
	pub y: i32
}

enum CfStatus {
	OK,
	NOT_FOUND = 404,
	ERROR
}

enum CfMethod: str {
	GET,
	POST = "POST",
	DELETE
}

enum CfShape {
	Circle(radius: f64),
	Rect(width: f64, height: f64),
	Empty
}

struct CfHolder {
	pub code: i32,
	pub shape: CfShape
}

fn test_array_literal(t: &Tally) {
	val a = Array<i32>(1, 2, 3);
	check(a.len == 3, "Array<i32>: .len is the element count", t);
	check(a[0] == 1 && a[2] == 3, "Array<i32>: indexed access", t);

	var sum: i32 = 0;
	for (x in a) sum = sum + x;
	check(sum == 6, "for over Array<i32>", t);

	val words = Array<str>("ab", "cde");
	check(words[1].len == 3, "Array<str> elements", t);

	val pts = Array<Vec2>(Vec2(1, 2), Vec2(3, 4));
	var total: i32 = 0;
	for (p in pts) total = total + p.x + p.y;
	check(total == 10, "for over Array<Vec2>", t);

	val inferred = Array<i32>(7, 8);
	check(inferred.len == 2 && inferred[1] == 8, "Array<i32> element check", t);
}

fn test_in_candidate_list(t: &Tally) {
	// 1. Character literals and ranges
	val ch = 'g';
	check(ch in ['t', 'g', 'k'], "char in candidate list", t);
	check('z' !in ['t', 'g', 'k'], "char !in candidate list", t);
	check('m' in ['a'..'z', 'A'..'Z', '_'], "char in range candidate list", t);
	check('_' in ['a'..'z', 'A'..'Z', '_'], "char in mixed range/literal list", t);
	check('!' !in ['a'..'z', 'A'..'Z', '_'], "char !in range candidate list", t);

	// 2. Integer literals and ranges
	val num = 15;
	check(num in [0..5, 10..<20, 99], "int in mixed range candidate list", t);
	check(20 !in [0..5, 10..<20, 99], "int !in half-open range upper bound", t);
	check(5 in [0..5, 10..<20, 99], "int in closed range upper bound", t);

	// 3. Strings
	val kw = "val";
	check(kw in ["fn", "val", "var"], "str in candidate list", t);
	check("let" !in ["fn", "val", "var"], "str !in candidate list", t);

	// 4. Plain enum (qualified, shorthand, bare)
	val st = CfStatus.OK;
	check(st in [CfStatus.OK, CfStatus.NOT_FOUND], "plain enum qualified in list", t);
	check(st in [.OK, .NOT_FOUND], "plain enum shorthand in list", t);
	check(st in [OK, NOT_FOUND], "plain enum bare in list", t);
	check(CfStatus.ERROR !in [.OK, .NOT_FOUND], "plain enum !in list", t);

	// 5. Raw-value str enum
	val m = CfMethod.POST;
	check(m in [.GET, .POST], "raw-value str enum shorthand in list", t);
	check(CfMethod.DELETE !in [CfMethod.GET, CfMethod.POST], "raw-value str enum !in list", t);

	// 6. Payload enum (value & pointer, qualified & shorthand)
	val shape = CfShape.Circle(2.0);
	val p_shape = &shape;
	check(shape in [CfShape.Circle, CfShape.Empty], "payload enum qualified in list", t);
	check(shape in [.Circle, .Empty], "payload enum shorthand in list", t);
	check(CfShape.Rect(1.0, 2.0) !in [.Circle, .Empty], "payload enum !in list", t);
	check(p_shape in [.Circle, .Rect], "pointer to payload enum in list", t);

	// 7. Safe navigation on LHS
	val holder = CfHolder(20, CfShape.Empty);
	val p_holder: ?*CfHolder = &holder;
	val null_holder: ?*CfHolder = null;
	check(p_holder?.code in [10, 20, 30], "safe nav field in candidate list", t);
	check(!(null_holder?.code in [10, 20, 30]), "null safe nav in candidate list is false", t);
	check(null_holder?.shape !in [.Circle, .Empty], "null safe nav payload enum !in list", t);
	check(p_holder?.shape in [.Circle, .Empty], "safe nav payload enum in list", t);

	// 8. Struct equality
	check(Vec2(3, 4) in [Vec2(1, 2), Vec2(3, 4)], "struct in candidate list", t);
	check(Vec2(5, 6) !in [Vec2(1, 2), Vec2(3, 4)], "struct !in candidate list", t);
}

// -- Iterable: std containers and non-scalar elements ------------------------

fn test_iter_string_builder(t: &Tally) {
	var sb = StringBuilder();
	defer sb.free();
	sb += "abc";
	sb += 7;

	var count: i32 = 0;
	var first: char = '?';
	var last: char = '?';
	for (c in sb) {
		if (count == 0) first = c;
		last = c;
		count = count + 1;
	}
	check(count == 4, "StringBuilder iteration must run len times", t);
	check(first == 'a', "StringBuilder iteration must start at the first char", t);
	check(last == '7', "StringBuilder iteration must see appended digits", t);
}

fn test_iter_struct_elements(t: &Tally) {
	var items = List<Bundle>();
	defer items.free();
	items += Bundle("one", 1);
	items += Bundle("two", 2);

	var ids: i32 = 0;
	var count: i32 = 0;
	for (b in items) {
		ids = ids + b.id;
		count = count + 1;
	}
	check(count == 2, "List<struct> iteration must run twice", t);
	check(ids == 3, "List<struct> iteration must yield whole elements", t);
}

// A `for` over a container that lives in a field goes through the same path.
struct Bag {
	pub items: List<i32>
}

fn test_iter_list_field(t: &Tally) {
	var bag = Bag(List<i32>());
	defer bag.items.free();
	bag.items += 4;
	bag.items += 5;

	var sum: i32 = 0;
	for (n in bag.items) sum = sum + n;
	check(sum == 9, "iteration over a List field", t);
}

// ============================================================================
// `defer` statement tests (scope-based LIFO execution)
// ============================================================================

fn test_defer_basic(t: &Tally) {
	var trace = "";
	{
		trace += "A;";
		defer trace += "1;";
		trace += "B;";
		defer trace += "2;";
		trace += "C;";
	}
	check(trace == "A;B;C;2;1;", "basic defer must execute in LIFO order at scope exit", t);
}

fn test_defer_block(t: &Tally) {
	var trace = "";
	{
		trace += "start;";
		defer {
			trace += "d1;";
			trace += "d2;";
		}
		trace += "end;";
	}
	check(trace == "start;end;d1;d2;", "block defer must execute its body at scope exit", t);
}

fn test_defer_nested_scopes(t: &Tally) {
	var trace = "";
	{
		defer trace += "outer;";
		trace += "1;";
		{
			defer trace += "inner;";
			trace += "2;";
		}
		trace += "3;";
	}
	check(trace == "1;2;inner;3;outer;", "nested scopes must unwind defers when leaving inner block", t);
}

fn helper_return_with_defer(cond: bool, trace: &str): i32 {
	defer trace.write(trace.read() + "defer_outer;");
	if (cond) {
		defer trace.write(trace.read() + "defer_inner;");
		return 42;
	}
	trace.write(trace.read() + "after_if;");
	return 100;
}

fn test_defer_early_return(t: &Tally) {
	var trace1 = "";
	val r1 = helper_return_with_defer(true, &trace1);
	check(r1 == 42, "early return value must be 42", t);
	check(trace1 == "defer_inner;defer_outer;", "early return must unwind all active defers in LIFO", t);

	var trace2 = "";
	val r2 = helper_return_with_defer(false, &trace2);
	check(r2 == 100, "normal return value must be 100", t);
	check(trace2 == "after_if;defer_outer;", "normal path must run defers before return", t);
}

fn test_defer_loop(t: &Tally) {
	var trace = "";
	var i = 0;
	while (i < 3) {
		defer trace += "L;";
		if (i == 1) {
			defer trace += "C;";
			i++;
			continue;
		}
		if (i == 2) {
			defer trace += "B;";
			break;
		}
		trace += "${i};";
		i++;
	}
	check(trace == "0;L;C;L;B;L;", "defer in loop with continue and break must unwind correctly", t);
}

fn main(): i32 {
	println("=== Feature Suite: Control Flow & Loops ===");

	var t = Tally(0);

	test_range_closed_asc(&t);
	test_range_closed_desc(&t);
	test_range_open(&t);
	test_range_half_open(&t);
	test_range_half_open_index(&t);
	test_range_half_open_empty(&t, 0);
	test_range_bound_type(&t, 5);
	test_iter_list(&t);
	test_iter_str(&t);
	test_iter_member(&t);
	test_nested(&t);
	test_break_continue(&t);
	test_loop_var_is_fresh(&t);
	test_generic_for(&t);
	test_iterable_trait(&t);
	test_array_literal(&t);
	test_in_candidate_list(&t);
	test_iter_string_builder(&t);
	test_iter_struct_elements(&t);
	test_iter_list_field(&t);
	test_defer_basic(&t);
	test_defer_block(&t);
	test_defer_nested_scopes(&t);
	test_defer_early_return(&t);
	test_defer_loop(&t);

	if (t.fails != 0) {
		println("[FAILED] Bootstrap for-loop tests");
		return 1;
	}

	println("=== ALL CONTROL FLOW TESTS PASSED! ===");
	return 0;
}
