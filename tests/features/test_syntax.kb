mod tests.features.test_syntax;

use std.io.*;
use std.collections.list.List;
use std.collections.hash_map.HashMap;
use std.collections.hash_set.HashSet;

// ============================================================================
// Feature Suite 1: Core Syntax, Operators, and Control Expressions
//
// Consolidates:
//   - Compound Assignment (+=, -=, *=, /=, %=)
//   - Increment / Decrement (++, --)
//   - When / Yield expressions
//   - Struct constants (pub const TAG)
//   - Default arguments (functions, methods, struct fields)
//   - Null safety & Elvis operator (*T?, ?:)
// ============================================================================

struct Counter {
	pub count: i32
}

struct PointConst {
	pub const TAG: i32 = 42;
	pub const ZERO = 0;
	pub x: i32,
	pub y: i32
}

struct NodeConst {
	const KIND = 100;
	pub value: i32
}

struct ConfigWithDefaults {
	pub host: str,
	pub port: i32 = 8080,
	pub debug: bool = false,
	pub tags: List<str> = List<str>()
}

struct PointWithDefaults {
	pub x: i32,
	pub y: i32
}

impl PointWithDefaults {
	pub fn new(x: i32 = 0, y: i32 = 0): PointWithDefaults => Self(x, y);

	pub fn add_offset(self, dx: i32, dy: i32 = 5): PointWithDefaults {
		return PointWithDefaults(self.x + dx, self.y + dy);
	}
}

struct SafeNode {
	pub name: str,
	pub next: *SafeNode? = null,
	pub child: *SafeNode? = null
}

impl SafeNode {
	pub fn get_name(val self): str => self.name;
	pub fn get_child(val self): *SafeNode? => self.child;
}

fn greet_default(name: str, greeting: str = "Hello", punctuation: str = "!"): str {
	return "${greeting}, ${name}${punctuation}";
}

fn add_nums_default(a: i32, b: i32 = 10, c: i32 = 20): i32 {
	return a + b + c;
}

fn test_compound_assign(): bool {
	var x: i32 = 10;
	x += 5;
	if (x != 15) return false;
	x -= 3;
	if (x != 12) return false;
	x *= 2;
	if (x != 24) return false;
	x /= 4;
	if (x != 6) return false;
	x %= 4;
	if (x != 2) return false;

	var s: str = "hello";
	s += " ";
	s += "world!";
	if (s != "hello world!") return false;

	var total: i32 = 0;
	for (i in 0..<5) {
		total += i;
	}
	if (total != 10) return false;

	var c = Counter(10);
	c.count += 5;
	if (c.count != 15) return false;
	c.count -= 2;
	c.count *= 3;
	if (c.count != 39) return false;

	return true;
}

fn test_update_operators(): bool {
	var x: i32 = 10;
	x++;
	if (x != 11) return false;
	x--;
	if (x != 10) return false;

	var u: usz = 100;
	u++;
	if (u != 101) return false;
	u--;
	if (u != 100) return false;

	var f: f32 = 1.5;
	f++;
	if (f != 2.5) return false;
	f--;
	if (f != 1.5) return false;

	var c = Counter(41);
	c.count++;
	if (c.count != 42) return false;
	c.count--;
	if (c.count != 41) return false;

	var i = 0;
	while (i < 5) {
		i++;
	}
	if (i != 5) return false;

	var res = 10;
	val opt = 1;
	when (opt) {
		1 -> res++;
		else -> res--;
	}
	if (res != 11) return false;

	return true;
}

fn helper_when_yield(k: i32): str {
	return when (k) {
		10 -> "ten";
		20 -> {
			val doubled = k * 2;
			yield "calculated_${doubled}";
		}
		else -> {
			yield "default_value";
		}
	};
}

fn test_when_yield(): bool {
	val x: i32 = 2;
	val res = when (x) {
		1 -> "one";
		2 -> {
			val prefix = "number_";
			val n = 2;
			yield "${prefix}${n}";
		}
		else -> "other";
	};
	if (res != "number_2") return false;

	if (helper_when_yield(10) != "ten") return false;
	if (helper_when_yield(20) != "calculated_40") return false;
	if (helper_when_yield(99) != "default_value") return false;

	val a = 5;
	val b = 10;
	val category = when {
		a > b -> "greater";
		a < b -> {
			val diff = b - a;
			yield "smaller_by_${diff}";
		}
		else -> "equal";
	};
	if (category != "smaller_by_5") return false;

	return true;
}

fn test_struct_constants(): bool {
	val t = PointConst.TAG;
	val z = PointConst.ZERO;
	if (t != 42) return false;
	if (z != 0) return false;

	val nk = NodeConst.KIND;
	if (nk != 100) return false;

	return true;
}

fn test_default_arguments(): bool {
	if (greet_default("Alice") != "Hello, Alice!") return false;
	if (greet_default("Bob", "Hi") != "Hi, Bob!") return false;
	if (greet_default("Charlie", "Hey", "?") != "Hey, Charlie?") return false;

	if (add_nums_default(5) != 35) return false;
	if (add_nums_default(5, 1) != 26) return false;
	if (add_nums_default(5, 1, 2) != 8) return false;

	val c1 = ConfigWithDefaults("localhost");
	if (c1.host != "localhost" || c1.port != 8080 || c1.debug != false || c1.tags.len != 0) return false;

	val c2 = ConfigWithDefaults("0.0.0.0", 3000, true);
	if (c2.host != "0.0.0.0" || c2.port != 3000 || c2.debug != true) return false;

	val p0 = PointWithDefaults();
	if (p0.x != 0 || p0.y != 0) return false;

	val p1 = PointWithDefaults(10);
	if (p1.x != 10 || p1.y != 0) return false;

	val p2 = PointWithDefaults(10, 20);
	if (p2.x != 10 || p2.y != 20) return false;

	val p3 = p2.add_offset(5);
	if (p3.x != 15 || p3.y != 25) return false;

	return true;
}

fn elvis_helper_ret(val ptr: *i32?): i32 {
	val unwrapped = ptr ?: return 42;
	return *unwrapped;
}

fn elvis_chained_ret(val p1: *i32?, val p2: *i32?): i32 {
	val unwrapped = p1 ?: p2 ?: return 99;
	return *unwrapped;
}

fn track_ptr(p: *i32?, c: *Counter): *i32? {
	c.count++;
	return p;
}

fn ret_elvis(p: *i32?, fallback: *i32, c: *Counter): *i32 {
	return track_ptr(p, c) ?: fallback;
}

fn arrow_elvis(p: *i32?, fallback: *i32, c: *Counter): *i32 => track_ptr(p, c) ?: fallback;

fn test_null_safety(): bool {
	val p_null: *i32? = null;
	if (p_null != null) return false;

	val x: i32 = 10;
	val p_val: *i32? = &x;
	if (p_val == null) return false;

	val p_nn: *i32 = &x;
	val p_widened: *i32? = p_nn;
	if (p_widened == null) return false;

	val fb1: *i32 = p_null ?: &x;
	if (*fb1 != 10) return false;

	val y: i32 = 20;
	val fb2: *i32 = p_val ?: &y;
	if (*fb2 != 10) return false;

	if (elvis_helper_ret(null) != 42) return false;
	val val_30: i32 = 30;
	if (elvis_helper_ret(&val_30) != 30) return false;

	var break_count: i32 = 0;
	for (i in 0..5) {
		val p: *i32? = if (i == 3) null else &x;
		val unwrapped = p ?: break;
		break_count = break_count + 1;
	}
	if (break_count != 3) return false;

	// Single evaluation tests for Elvis
	var c = Counter(0);

	// 1. Variable declaration
	val res1: *i32 = track_ptr(&x, &c) ?: &y;
	if (c.count != 1 || *res1 != 10) return false;
	c.count = 0;

	val res2: *i32 = track_ptr(null, &c) ?: &y;
	if (c.count != 1 || *res2 != 20) return false;
	c.count = 0;

	// 2. Assignment
	var res3: *i32 = &x;
	res3 = track_ptr(&y, &c) ?: &x;
	if (c.count != 1 || *res3 != 20) return false;
	c.count = 0;

	res3 = track_ptr(null, &c) ?: &x;
	if (c.count != 1 || *res3 != 10) return false;
	c.count = 0;

	// 3. Return statement
	val res4 = ret_elvis(&x, &y, &c);
	if (c.count != 1 || *res4 != 10) return false;
	c.count = 0;

	val res5 = ret_elvis(null, &y, &c);
	if (c.count != 1 || *res5 != 20) return false;
	c.count = 0;

	// 4. Arrow function
	val res6 = arrow_elvis(&x, &y, &c);
	if (c.count != 1 || *res6 != 10) return false;
	c.count = 0;

	val res7 = arrow_elvis(null, &y, &c);
	if (c.count != 1 || *res7 != 20) return false;
	c.count = 0;

	// 5. Chained Elvis
	val res8: *i32 = track_ptr(&x, &c) ?: track_ptr(&y, &c) ?: &y;
	if (c.count != 1 || *res8 != 10) return false;
	c.count = 0;

	val res9: *i32 = track_ptr(null, &c) ?: track_ptr(&y, &c) ?: &x;
	if (c.count != 2 || *res9 != 20) return false;
	c.count = 0;

	// 6. String Elvis
	val p_null_char: *char = null;
	val s_null: str = p_null_char;
	val s1: str = s_null ?: "fallback";
	if (s1 != "fallback") return false;

	val s_orig: str = "custom";
	val s2: str = s_orig ?: "fallback";
	if (s2 != "custom") return false;

	// 7. Null literal fallback
	val fb_lit: *i32 = null ?: &x;
	if (*fb_lit != 10) return false;

	// 8. Elvis continue jump
	var cont_count: i32 = 0;
	for (i in 0..<5) {
		val p: *i32? = if (i % 2 == 0) null else &x;
		val unwrapped = p ?: continue;
		cont_count = cont_count + 1;
	}
	if (cont_count != 2) return false;

	// 9. Chained Elvis with return jump
	if (elvis_chained_ret(null, null) != 99) return false;
	if (elvis_chained_ret(null, &y) != 20) return false;
	if (elvis_chained_ret(&x, &y) != 10) return false;

	// 10. Elvis yield jump in when expression
	val when_test1 = when (1) {
		1 -> {
			val p: *i32? = null;
			val unwrapped = p ?: yield 404;
			yield *unwrapped;
		}
		else -> 0;
	};
	if (when_test1 != 404) return false;

	val when_test2 = when (1) {
		1 -> {
			val p: *i32? = &x;
			val unwrapped = p ?: yield 404;
			yield *unwrapped;
		}
		else -> 0;
	};
	if (when_test2 != 10) return false;

	// 11. Smart cast on != null and == null
	val opt_p: *i32? = &x;
	var smart_cast_ok = false;
	if (opt_p != null) {
		val nn_p: *i32 = opt_p;
		if (*nn_p == 10) smart_cast_ok = true;
	}
	if (!smart_cast_ok) return false;

	// Compound condition with != null
	var compound_ok = false;
	if (opt_p != null && *opt_p == 10) {
		compound_ok = true;
	}
	if (!compound_ok) return false;

	// == null else branch smart cast
	var else_ok = false;
	if (opt_p == null) {
		return false;
	} else {
		val nn_p2: *i32 = opt_p;
		if (*nn_p2 == 10) else_ok = true;
	}
	if (!else_ok) return false;

	// while loop != null smart cast
	var while_p: *i32? = &x;
	var while_count = 0;
	while (while_p != null) {
		val nn_p3: *i32 = while_p;
		while_count = while_count + *nn_p3;
		while_p = null;
	}
	if (while_count != 10) return false;

	return true;
}

fn safe_call_chain_ret(node: *SafeNode?): str {
	return node?.child?.name ?: "none";
}

fn safe_call_jump_ret(node: *SafeNode?): str {
	val name = node?.child?.name ?: return "escaped";
	return name;
}

fn test_safe_calls(): bool {
	// 1. Safe access on null pointer
	val null_node: *SafeNode? = null;
	val s1: str = null_node?.name ?: "fallback";
	if (s1 != "fallback") return false;

	// 2. Safe access on non-null pointer
	var leaf = SafeNode("leaf", null, null);
	val s2: str = (&leaf)?.name ?: "fallback";
	if (s2 != "leaf") return false;

	// 3. Chained safe member access
	var root = SafeNode("root", null, &leaf);
	val s3: str = (&root)?.child?.name ?: "fallback";
	if (s3 != "leaf") return false;

	val s4: str = null_node?.child?.name ?: "fallback";
	if (s4 != "fallback") return false;

	var lonely = SafeNode("lonely", null, null);
	val s5: str = (&lonely)?.child?.name ?: "fallback";
	if (s5 != "fallback") return false;

	// 4. Safe call with Elvis return jump
	if (safe_call_jump_ret(null) != "escaped") return false;
	if (safe_call_jump_ret(&lonely) != "escaped") return false;
	if (safe_call_jump_ret(&root) != "leaf") return false;

	// 5. Safe call in helper return
	if (safe_call_chain_ret(null) != "none") return false;
	if (safe_call_chain_ret(&lonely) != "none") return false;
	if (safe_call_chain_ret(&root) != "leaf") return false;

	// 6. Safe method call
	val m1: str = null_node?.get_name() ?: "no-name";
	if (m1 != "no-name") return false;

	val m2: str = (&leaf)?.get_name() ?: "no-name";
	if (m2 != "leaf") return false;

	val m3: *SafeNode? = (&root)?.get_child() ?: null;
	if (m3 == null) return false;
	val m3_name: str = m3?.name ?: "";
	if (m3_name != "leaf") return false;

	// 7. Chained safe call with continue
	var cont_count: i32 = 0;
	for (i in 0..<4) {
		val node_opt: *SafeNode? = if (i == 2) &root else null;
		val child_name = node_opt?.child?.name ?: continue;
		if (child_name == "leaf") cont_count = cont_count + 1;
	}
	if (cont_count != 1) return false;

	return true;
}

fn test_adjacent_strings(): bool {
	// 1. Basic adjacent strings
	val s1 = "Hello " "world!";
	if (s1 != "Hello world!") return false;

	// 2. Multiline adjacent strings
	val s2 = "Line 1, "
	         "Line 2, "
	         "Line 3";
	if (s2 != "Line 1, Line 2, Line 3") return false;

	// 3. Adjacent strings with escape sequences
	val s3 = "A\n" "B\t" "\"C\"";
	if (s3 != "A\nB\t\"C\"") return false;

	// 4. Adjacent strings with interpolation
	val name = "Kobel";
	val count = 3;
	val s4 = "Hello " "${name}! "
	         "You have ${count} messages.";
	if (s4 != "Hello Kobel! You have 3 messages.") return false;

	// 5. In expression context (array)
	val arr = ["foo" "bar", "baz"];
	if (arr.len != 2 || arr[0] != "foobar" || arr[1] != "baz") return false;

	return true;
}

fn test_multiline_strings(): bool {
	// 1. Basic multiline string with trimIndent
	val s1 = """
		Line 1
		Line 2
		Line 3
	""";
	if (s1 != "Line 1\nLine 2\nLine 3") return false;

	// 2. Multiline string with nested quotes without escaping
	val s2 = """
		<div class="container">
			<span id="title">Hello</span>
		</div>
	""";
	if (s2 != "<div class=\"container\">\n\t<span id=\"title\">Hello</span>\n</div>") return false;

	// 3. Multiline string with string interpolation
	val lang = "Kobel";
	val ver = 1;
	val s3 = """
		Language: ${lang}
		Version: ${ver}
	""";
	if (s3 != "Language: Kobel\nVersion: 1") return false;

	// 4. Single-line triple quotes
	val s4 = """Hello World""";
	if (s4 != "Hello World") return false;

	// 5. Empty triple quotes
	val s5 = """""";
	if (s5 != "") return false;

	// 6. Multiline with internal empty lines
	val s6 = """
		Paragraph 1

		Paragraph 2
	""";
	if (s6 != "Paragraph 1\n\nParagraph 2") return false;

	// 7. Escaped dollar sign in multiline string
	val s7 = """
		Price: \$100
	""";
	if (s7 != "Price: $100") return false;

	return true;
}

fn test_in_operator(): bool {
	// 1. in str
	val s = "hello world";
	if ("world" !in s) return false;
	if ("xyz" in s) return false;

	// 2. in List<str>
	var list = List<str>();
	defer list.delete();
	list += "foo";
	list += "bar";
	if ("foo" !in list) return false;
	if ("baz" in list) return false;

	// 3. in HashMap
	var map = HashMap<str, i32>();
	defer map.delete();
	map["k1"] = 10;
	if ("k1" !in map) return false;
	if ("k2" in map) return false;

	// 4. in HashSet
	var set = HashSet();
	defer set.delete();
	set += "alpha";
	if ("alpha" !in set) return false;
	if ("beta" in set) return false;

	return true;
}

fn main(): i32 {
	println("=== Feature Suite: Core Syntax & Operators ===");

	if (!test_compound_assign()) {
		println("  [FAIL] test_compound_assign");
		return 1;
	}
	println("  [PASS] test_compound_assign");

	if (!test_update_operators()) {
		println("  [FAIL] test_update_operators");
		return 1;
	}
	println("  [PASS] test_update_operators");

	if (!test_when_yield()) {
		println("  [FAIL] test_when_yield");
		return 1;
	}
	println("  [PASS] test_when_yield");

	if (!test_struct_constants()) {
		println("  [FAIL] test_struct_constants");
		return 1;
	}
	println("  [PASS] test_struct_constants");

	if (!test_default_arguments()) {
		println("  [FAIL] test_default_arguments");
		return 1;
	}
	println("  [PASS] test_default_arguments");

	if (!test_null_safety()) {
		println("  [FAIL] test_null_safety");
		return 1;
	}
	println("  [PASS] test_null_safety");

	if (!test_safe_calls()) {
		println("  [FAIL] test_safe_calls");
		return 1;
	}
	println("  [PASS] test_safe_calls");

	if (!test_adjacent_strings()) {
		println("  [FAIL] test_adjacent_strings");
		return 1;
	}
	println("  [PASS] test_adjacent_strings");

	if (!test_multiline_strings()) {
		println("  [FAIL] test_multiline_strings");
		return 1;
	}
	println("  [PASS] test_multiline_strings");

	if (!test_in_operator()) {
		println("  [FAIL] test_in_operator");
		return 1;
	}
	println("  [PASS] test_in_operator");

	println("=== ALL CORE SYNTAX TESTS PASSED! ===");
	return 0;
}
