mod test.test_operators;

use std.io.print;
use std.io.println;
use std.collections.list.List;
use std.collections.hash_map.HashMap;
use std.collections.hash_set.HashSet;
use std.collections.string_builder.StringBuilder;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_i32(actual: i32, expected: i32, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		print(" | Expected: ");
		print("${expected}");
		print(", got: ");
		println("${actual}");
	}
}

// ----------------------------------------------------------------------------
// Test Struct: Vector2 with arithmetic and overloading
// ----------------------------------------------------------------------------

pub struct Vector2 {
	pub x: i32,
	pub y: i32
}

impl Vector2 {
	pub fn new(x: i32, y: i32) => Self(x, y);

	// Overloaded op plus: Vector2 + Vector2
	pub op plus(val self, other: Vector2): Vector2 => Vector2(self.x + other.x, self.y + other.y);

	// Overloaded op plus: Vector2 + i32 (scalar)
	pub op plus(val self, scalar: i32): Vector2 => Vector2(self.x + scalar, self.y + scalar);

	// op minus: Vector2 - Vector2
	pub op minus(val self, other: Vector2): Vector2 => Vector2(self.x - other.x, self.y - other.y);

	// op mul: Vector2 * i32
	pub op mul(val self, factor: i32): Vector2 => Vector2(self.x * factor, self.y * factor);

	// op negate: -Vector2
	pub op negate(val self): Vector2 => Vector2(0 - self.x, 0 - self.y);

	// op equals: Vector2 == Vector2
	pub op equals(val self, other: Vector2): bool => self.x == other.x && self.y == other.y;

	// op plus_assign: Vector2 += Vector2
	pub op plus_assign(var self, other: Vector2) {
		self.x = self.x + other.x;
		self.y = self.y + other.y;
	}
}

// ----------------------------------------------------------------------------
// Test Struct: Buffer with indexing get and set
// ----------------------------------------------------------------------------

pub struct IntBuffer {
	pub a: i32,
	pub b: i32,
	pub c: i32
}

impl IntBuffer {
	pub fn new(a: i32, b: i32, c: i32) => Self(a, b, c);

	pub op get(val self, idx: usz): i32 => when (idx) {
		0UZ -> self.a,
		1UZ -> self.b,
		2UZ -> self.c,
		else -> 0
	};

	pub op set(var self, idx: usz, val_in: i32) {
		when (idx) {
			0UZ -> self.a = val_in;
			1UZ -> self.b = val_in;
			2UZ -> self.c = val_in;
			else -> {}
		}
	}

	pub op plus_assign(var self, delta: i32) {
		self.a = self.a + delta;
		self.b = self.b + delta;
		self.c = self.c + delta;
	}
}

// ----------------------------------------------------------------------------
// Test Execution
// ----------------------------------------------------------------------------

fn test_vector_ops() {
	val v1 = Vector2(10, 20);
	val v2 = Vector2(3, 5);

	// Test Vector2 + Vector2
	val v_add = v1 + v2;
	assert_eq_i32(v_add.x, 13, "Vector2 + Vector2: x");
	assert_eq_i32(v_add.y, 25, "Vector2 + Vector2: y");

	// Test Overloaded Vector2 + i32 (scalar)
	val v_scalar = v1 + 100;
	assert_eq_i32(v_scalar.x, 110, "Vector2 + i32: x");
	assert_eq_i32(v_scalar.y, 120, "Vector2 + i32: y");

	// Test Vector2 - Vector2
	val v_sub = v1 - v2;
	assert_eq_i32(v_sub.x, 7, "Vector2 - Vector2: x");
	assert_eq_i32(v_sub.y, 15, "Vector2 - Vector2: y");

	// Test Vector2 * i32
	val v_mul = v1 * 3;
	assert_eq_i32(v_mul.x, 30, "Vector2 * i32: x");
	assert_eq_i32(v_mul.y, 60, "Vector2 * i32: y");

	// Test Unary negate -Vector2
	val v_neg = -v1;
	assert_eq_i32(v_neg.x, -10, "-Vector2: x");
	assert_eq_i32(v_neg.y, -20, "-Vector2: y");

	// Test == and !=
	assert_true(v1 == Vector2(10, 20), "Vector2 == Vector2 (equal)");
	assert_true(v1 != v2, "Vector2 != Vector2 (not equal)");

	// Test +=
	var v_mut = Vector2(1, 2);
	v_mut += Vector2(10, 20);
	assert_eq_i32(v_mut.x, 11, "Vector2 += Vector2: x");
	assert_eq_i32(v_mut.y, 22, "Vector2 += Vector2: y");
}

fn test_buffer_index_ops() {
	var buf = IntBuffer(10, 20, 30);

	// Test op get
	assert_eq_i32(buf[0UZ], 10, "buf[0]");
	assert_eq_i32(buf[1UZ], 20, "buf[1]");
	assert_eq_i32(buf[2UZ], 30, "buf[2]");

	// Test op set
	buf[1UZ] = 99;
	assert_eq_i32(buf[1UZ], 99, "buf[1] after set");

	// Test op plus_assign
	buf += 5;
	assert_eq_i32(buf[0UZ], 15, "buf[0] after +=");
	assert_eq_i32(buf[1UZ], 104, "buf[1] after +=");
	assert_eq_i32(buf[2UZ], 35, "buf[2] after +=");
}

fn test_list_ops() {
	var list = List<i32>();
	defer list.delete();

	// Test op plus_assign (+=)
	list += 100;
	list += 200;
	list += 300;

	assert_eq_i32(list.len as i32, 3, "List length after +=");

	// Test op get ([])
	assert_eq_i32(list[0UZ], 100, "list[0]");
	assert_eq_i32(list[1UZ], 200, "list[1]");
	assert_eq_i32(list[2UZ], 300, "list[2]");

	// Test op set ([] =)
	list[1UZ] = 777;
	assert_eq_i32(list[1UZ], 777, "list[1] after [] =");
}

fn test_hash_map_ops() {
	var map = HashMap<str, i32>();
	defer map.delete();

	// Test op set: map[key] = val
	map["apple"] = 100;
	map["banana"] = 200;

	// Test op contains: key in map
	assert_true("apple" in map, "'apple' in map");
	assert_true("banana" in map, "'banana' in map");
	assert_true(!("cherry" in map), "!('cherry' in map)");

	// Test op get: map[key]
	val apple_ptr = map["apple"];
	assert_true(apple_ptr != null, "apple_ptr != null");
	assert_eq_i32(*apple_ptr, 100, "*map['apple']");

	val banana_ptr = map["banana"];
	assert_true(banana_ptr != null, "banana_ptr != null");
	assert_eq_i32(*banana_ptr, 200, "*map['banana']");

	// Overwrite via [] =
	map["apple"] = 999;
	assert_eq_i32(*map["apple"], 999, "*map['apple'] after update");
}

fn test_hash_set_ops() {
	var set = HashSet();
	defer set.delete();

	// Test op plus_assign: set += key
	set += "alpha";
	set += "beta";
	set += "gamma";

	// Test op contains: key in set
	assert_true("alpha" in set, "'alpha' in set");
	assert_true("beta" in set, "'beta' in set");
	assert_true("gamma" in set, "'gamma' in set");
	assert_true(!("delta" in set), "!('delta' in set)");

	// Test for loop over HashSet
	var count = 0;
	for (item in set) {
		assert_true(item in set, "item in set during iteration");
		count++;
	}
	assert_eq_i32(count, 3, "HashSet iteration count == 3");
}

fn test_string_builder_ops() {
	var sb = StringBuilder();
	defer sb.delete();

	// Test op plus_assign overloads: sb += str, sb += char, sb += i64, etc.
	sb += "Hello";
	sb += ' ';
	sb += "World";
	sb += '!';
	sb += 42L;

	assert_true(sb.to_str() == "Hello World!42", "sb.to_str() == 'Hello World!42'");

	// Test op get: sb[i]
	assert_true(sb[0UZ] == 'H', "sb[0] == 'H'");
	assert_true(sb[6UZ] == 'W', "sb[6] == 'W'");

	// Test op set: sb[i] = 'h'
	sb[0UZ] = 'h';
	assert_true(sb[0UZ] == 'h', "sb[0] after set == 'h'");
}

fn append_via_ptr(sb: &StringBuilder, list: &List<i32>, set: &HashSet, map: &HashMap<str, i32>) {
	sb += "ptr";
	sb += '_';
	sb += 99UZ;
	list += 42;
	set += "ptr_key";
	map["ptr_k"] = 123;
}

fn test_pointer_receiver_ops() {
	var sb = StringBuilder();
	defer sb.delete();
	var list = List<i32>();
	defer list.delete();
	var set = HashSet();
	defer set.delete();
	var map = HashMap<str, i32>();
	defer map.delete();

	append_via_ptr(&sb, &list, &set, &map);

	assert_true(sb.to_str() == "ptr_99", "pointer receiver sb += worked");
	assert_eq_i32(list.len as i32, 1, "pointer receiver list += len");
	assert_eq_i32(list[0UZ], 42, "pointer receiver list[0]");
	assert_true(42 in &list, "42 in &list");
	assert_true("ptr_key" in &set, "'ptr_key' in &set");
	assert_true("ptr_k" in &map, "'ptr_k' in &map");
	val map_ptr = &map;
	assert_eq_i32(*map_ptr["ptr_k"], 123, "*(&map)['ptr_k'] == 123");
}

pub fn main() {
	println("=== Running Operator Overloading Tests ===");
	test_vector_ops();
	test_buffer_index_ops();
	test_list_ops();
	test_hash_map_ops();
	test_hash_set_ops();
	test_string_builder_ops();
	test_pointer_receiver_ops();
	println("All operator tests passed!");
}

