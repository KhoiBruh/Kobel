mod test.forward;

use std.process.Process;

// Mutually referential structs resolve across the whole module without forward declarations.

struct B { pub a: *A }
struct A { pub v: i32, pub b: ?*B = null }

fn run_tests(): i32 {
	var a = A(5, null);
	var b = B(&a);
	a.b = &b;
	if (a.v != 5) return 1;
	if (b.a.v != 5) return 2;
	if (a.b != null && a.b!.a.v != 5) return 3;
	return 0;
}

fn main() {
	if (run_tests() != 0) Process.exit(1);
}
