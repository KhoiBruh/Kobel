mod test.generics;

// Generic instantiation through bodies: a generic function that builds a generic
// container locally, a generic function that calls another generic function with
// explicit type arguments, and a nested instantiation. These all exercise the
// instance worklist in the declaration pass.

use std.collections.*;
use std.process.Process;

fn id<U>(x: U): U {
	return x;
}

fn wrap<U>(x: U): List<U> {
	var l: List<U> = List<U>();
	l += x;
	return l;
}

fn twice<U>(x: U): U {
	val y = id<U>(x);
	return y;
}

struct Holder {
	pub items: List<i32> = List(),
	pub map: HashMap<str, i32> = HashMap()
}

fn make_empty_list(): List<i32> => List();

fn run_tests(): i32 {
	var inner: List<i32> = wrap<i32>(7);
	if (inner.len != 1) return 1;
	if (inner[0] != 7) return 2;

	val n = twice<i32>(41);
	if (n != 41) return 3;

	var nested: List<List<i32>> = List<List<i32>>();
	nested += inner;
	if (nested.len != 1) return 4;
	val first = nested[0];
	if (first.len != 1) return 5;
	if (first[0] != 7) return 6;

	// Generic call type inference
	val inferred_n = twice(41);
	if (inferred_n != 41) return 7;

	val inferred_s = id("generic");
	if (inferred_s != "generic") return 8;

	val inferred_inner = wrap(99);
	if (inferred_inner.len != 1) return 9;
	if (inferred_inner[0] != 99) return 10;

	// Expected-type generic struct constructor inference (assignment & return)
	var h = Holder();
	h.items += 5;
	h.map["a"] = 1;
	h.items = List();
	h.map = HashMap();
	if (h.items.len != 0 || h.map.len != 0) return 11;
	val empty_ret = make_empty_list();
	if (empty_ret.len != 0) return 12;

	return 0;
}

fn main() {
	if (run_tests() != 0) Process.exit(1);
}
