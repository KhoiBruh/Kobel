mod tests.features.test_collections;

use std.io.*;
use std.collections.list.*;
use std.collections.hash_map.*;
use std.fmt.*;

// ============================================================================
// Feature Suite 2: Collections, Indexing, and String Formatting
//
// Consolidates:
//   - List Literals ([1, 2, 3], [], nested)
//   - Indexing Operator (read, write, compound assign, custom get/set)
//   - String Interpolation ("${expr}")
//   - Formatting & ToStr trait implementation
// ============================================================================

struct Point2D {
	pub x: i32,
	pub y: i32
}

impl ToStr for Point2D {
	fn to_str(val self): str => "Point(${self.x}, ${self.y})";
}

impl Hash for Point2D {
	fn hash(val self): usz => (self.x as usz * 31UZ) + (self.y as usz);
}

struct CustomIndexBox {
	pub a: i32,
	pub b: i32
}

impl CustomIndexBox {
	pub op get(val self, i: usz): i32 => if (i == 0UZ) self.a else self.b;

	pub op set(var self, i: usz, v: i32) {
		if (i == 0UZ) self.a = v;
		else self.b = v;
	}
}

fn sum_list(list: List<i32>): i32 {
	var total = 0;
	for (x in list) total += x;
	return total;
}

fn make_strings(): List<str> => ["kobel", "bootstrap", "list", "literal"];

fn test_list_literals(): bool {
	// 1. Basic List literal
	val nums: List<i32> = [1, 2, 3, 4, 5];
	if (nums.len != 5) return false;
	if (nums[0] != 1 || nums[4] != 5) return false;

	// 2. Empty List literal + add
	var empty: List<str> = [];
	if (empty.len != 0) return false;
	empty += "first";
	empty += "second";
	if (empty.len != 2 || empty[0] != "first" || empty[1] != "second") return false;

	// 3. Passing literal directly to function
	val s = sum_list([10, 20, 30, 40]);
	if (s != 100) return false;

	// 4. Returning literal from function
	val words = make_strings();
	if (words.len != 4 || words[0] != "kobel" || words[3] != "literal") return false;

	// 5. Nested list literal
	val matrix: List<List<i32>> = [[1, 2], [3, 4]];
	if (matrix.len != 2) return false;
	val row0 = matrix[0];
	val row1 = matrix[1];
	if (row0[1] != 2 || row1[0] != 3) return false;

	return true;
}

fn test_indexing(): bool {
	val list: List<i32> = [10, 20, 30, 40];
	if (list[0] != 10 || list[2] != 30 || list[3] != 40) return false;

	var mut_list: List<i32> = [1, 2, 3];
	mut_list[0] = 100;
	mut_list[2] = 300;
	if (mut_list[0] != 100 || mut_list[1] != 2 || mut_list[2] != 300) return false;

	mut_list[0] += 50;  // 150
	mut_list[1] *= 10;  // 20
	mut_list[2] -= 100; // 200
	if (mut_list[0] != 150 || mut_list[1] != 20 || mut_list[2] != 200) return false;

	var box_val = CustomIndexBox(10, 20);
	if (box_val[0] != 10 || box_val[1] != 20) return false;
	box_val[0] = 99;
	if (box_val[0] != 99) return false;

	return true;
}

fn test_interpolation_and_formatting(): bool {
	// Literal characters preservation
	val plain = "a{b}c";
	if (plain.len != 5UZ) return false;
	val dollar = "gia: \$5";
	if (dollar != "gia: $5") return false;

	// Basic types interpolation
	val name = "Kobel";
	if ("hi ${name}!" != "hi Kobel!") return false;

	val a: i32 = -7;
	val b: usz = 42UZ;
	if ("${a} and ${b}" != "-7 and 42") return false;

	val flag = true;
	val ch = 'Z';
	if ("${flag} ${ch}" != "true Z") return false;

	val pi: f64 = 3.14;
	val pi_str = "${pi}";
	if (pi_str.len == 0) return false;

	// Custom struct ToStr implementation
	val pt = Point2D(3, 4);
	if ("${pt}" != "Point(3, 4)") return false;

	return true;
}

fn test_hash_map(): bool {
	var map: HashMap<str, i32> = HashMap<str, i32>();
	defer map.delete();
	if (!map.empty()) return false;

	// Insert 60 items to test multiple resizes (cap 16 -> 32 -> 64 -> 128)
	for (i in 0..<60) {
		val key = "key_${i}";
		map[key] = i as i32 * 10;
	}

	if (map.len != 60UZ || map.count() != 60UZ) return false;

	// Check all 60 items
	for (i in 0..<60) {
		val key = "key_${i}";
		if (!(key in map)) return false;
		val p = map[key];
		if (p == null || *p != i as i32 * 10) return false;
	}

	// Remove even numbered keys (0, 2, 4, ... 58 -> 30 items)
	for (i in 0..<60) {
		if (i % 2 == 0) {
			val key = "key_${i}";
			if (!map.remove(key)) return false;
		}
	}

	if (map.len != 30UZ) return false;

	// Verify evens are removed, odds remain intact
	for (i in 0..<60) {
		val key = "key_${i}";
		if (i % 2 == 0) {
			if (key in map) return false;
			if (map[key] != null) return false;
		} else {
			if (!(key in map)) return false;
			val p = map[key];
			if (p == null || *p != i as i32 * 10) return false;
		}
	}

	// Check keys() and values()
	{
		val ks = map.keys();
		defer ks.delete();
		if (ks.len != 30UZ) return false;
	}

	{
		val vs = map.values();
		defer vs.delete();
		if (vs.len != 30UZ) return false;
	}

	return true;
}

fn test_generic_hash_map(): bool {
	// 1. Integer keys
	var int_map = HashMap<i32, str>();
	defer int_map.delete();

	int_map[1] = "one";
	int_map[2] = "two";
	int_map[42] = "answer";

	if (int_map.len != 3UZ) return false;
	if (!(1 in int_map) || !(42 in int_map) || (99 in int_map)) return false;
	val ans = int_map[42];
	if (ans == null || *ans != "answer") return false;
	if (int_map.get_or(1, "") != "one") return false;
	if (int_map.get_or(99, "none") != "none") return false;

	if (!int_map.remove(2)) return false;
	if (int_map.len != 2UZ || (2 in int_map)) return false;

	// 2. Custom struct keys
	var pt_map = HashMap<Point2D, i32>();
	defer pt_map.delete();

	val p1 = Point2D(10, 20);
	val p2 = Point2D(30, 40);
	val p3 = Point2D(10, 20);

	pt_map[p1] = 100;
	pt_map[p2] = 200;

	if (pt_map.len != 2UZ) return false;
	if (!(p3 in pt_map)) return false;
	val v = pt_map[p3];
	if (v == null || *v != 100) return false;

	pt_map[p3] = 999;
	if (pt_map.len != 2UZ) return false;
	val v2 = pt_map[p1];
	if (v2 == null || *v2 != 999) return false;

	if (!pt_map.remove(p1)) return false;
	if (pt_map.len != 1UZ) return false;
	if (p1 in pt_map) return false;

	return true;
}

fn test_list_utilities(): bool {
	// 1. index_of and last_index_of
	val l: List<i32> = [10, 20, 30, 20, 50];
	if (l.index_of(10) != 0) return false;
	if (l.index_of(20) != 1) return false;
	if (l.index_of(50) != 4) return false;
	if (l.index_of(99) != -1) return false;

	if (l.last_index_of(20) != 3) return false;
	if (l.last_index_of(50) != 4) return false;
	if (l.last_index_of(99) != -1) return false;

	// 2. contains and in operator
	if (!l.contains(30) || l.contains(99)) return false;
	if (!(30 in l)) return false;
	if (!(99 !in l)) return false;

	// 3. remove
	var m: List<i32> = [10, 20, 30, 40];
	if (!m.remove(20)) return false;
	if (m.len != 3 || m[0] != 10 || m[1] != 30 || m[2] != 40) return false;
	if (m.remove(99)) return false;

	// 4. remove_all
	var r: List<i32> = [1, 2, 3, 2, 4, 2, 5];
	val removed = r.remove_all(2);
	if (removed != 3UZ || r.len != 4) return false;
	if (r[0] != 1 || r[1] != 3 || r[2] != 4 || r[3] != 5) return false;

	// 5. pop_or
	var p: List<i32> = [10, 20];
	if (p.pop_or(0) != 20) return false;
	if (p.pop_or(0) != 10) return false;
	if (p.pop_or(999) != 999) return false;

	// 6. swap
	var s: List<i32> = [10, 20, 30];
	s.swap(0UZ, 2UZ);
	if (s[0] != 30 || s[1] != 20 || s[2] != 10) return false;

	// 7. reverse
	var rev: List<i32> = [1, 2, 3, 4, 5];
	rev.reverse();
	if (rev[0] != 5 || rev[1] != 4 || rev[2] != 3 || rev[3] != 2 || rev[4] != 1) return false;

	// 8. sub_list
	val sl = rev.sub(1UZ, 3UZ);
	if (sl.len != 3 || sl[0] != 4 || sl[1] != 3 || sl[2] != 2) return false;

	// 9. extend
	var ext: List<i32> = [1, 2];
	ext.extend([3, 4]);
	if (ext.len != 4 || ext[0] != 1 || ext[1] != 2 || ext[2] != 3 || ext[3] != 4) return false;

	// 10. Struct list with memeq
	val pts: List<Point2D> = [Point2D(1, 2), Point2D(3, 4)];
	if (!(Point2D(3, 4) in pts)) return false;
	if (!(Point2D(5, 6) !in pts)) return false;
	if (pts.index_of(Point2D(3, 4)) != 1) return false;
	if (pts.index_of(Point2D(9, 9)) != -1) return false;

	return true;
}

fn main(): i32 {
	println("=== Feature Suite: Collections, Indexing & Formatting ===");

	if (!test_list_literals()) {
		println("  [FAIL] test_list_literals");
		return 1;
	}
	println("  [PASS] test_list_literals");

	if (!test_indexing()) {
		println("  [FAIL] test_indexing");
		return 1;
	}
	println("  [PASS] test_indexing");

	if (!test_hash_map()) {
		println("  [FAIL] test_hash_map");
		return 1;
	}
	println("  [PASS] test_hash_map");

	if (!test_generic_hash_map()) {
		println("  [FAIL] test_generic_hash_map");
		return 1;
	}
	println("  [PASS] test_generic_hash_map");

	if (!test_interpolation_and_formatting()) {
		println("  [FAIL] test_interpolation_and_formatting");
		return 1;
	}
	println("  [PASS] test_interpolation_and_formatting");

	if (!test_list_utilities()) {
		println("  [FAIL] test_list_utilities");
		return 1;
	}
	println("  [PASS] test_list_utilities");

	println("=== ALL COLLECTIONS & FORMATTING TESTS PASSED! ===");
	return 0;
}
