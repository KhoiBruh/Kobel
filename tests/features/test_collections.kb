mod tests.features.test_collections;

use std.io.*;
use std.collections.list.*;
use std.fmt.*;

// ============================================================================
// Feature Suite 2: Collections, Indexing, and String Formatting
//
// Consolidates:
//   - List Literals ([1, 2, 3], [], nested)
//   - Indexing Operator (read, write, compound assign, custom get/set)
//   - String Interpolation ("${expr}")
//   - Formatting & ToStr trait implementation
// ============================================================================

struct Point2D {
	pub x: i32,
	pub y: i32
}

impl ToStr for Point2D {
	fn to_str(val self): str => "Point(${self.x}, ${self.y})";
}

struct CustomIndexBox {
	pub a: i32,
	pub b: i32
}

impl CustomIndexBox {
	pub fn get(val self, i: usz): i32 => if (i == 0UZ) self.a else self.b;

	pub fn set(var self, i: usz, v: i32) {
		if (i == 0UZ) self.a = v;
		else self.b = v;
	}
}

fn sum_list(list: List<i32>): i32 {
	var total = 0;
	for (x in list) total += x;
	return total;
}

fn make_strings(): List<str> => ["kobel", "bootstrap", "list", "literal"];

fn test_list_literals(): bool {
	// 1. Basic List literal
	val nums: List<i32> = [1, 2, 3, 4, 5];
	if (nums.len != 5) return false;
	if (nums.get(0) != 1 || nums.get(4) != 5) return false;

	// 2. Empty List literal + add
	var empty: List<str> = [];
	if (empty.len != 0) return false;
	empty.add("first");
	empty.add("second");
	if (empty.len != 2 || empty.get(0) != "first" || empty.get(1) != "second") return false;

	// 3. Passing literal directly to function
	val s = sum_list([10, 20, 30, 40]);
	if (s != 100) return false;

	// 4. Returning literal from function
	val words = make_strings();
	if (words.len != 4 || words.get(0) != "kobel" || words.get(3) != "literal") return false;

	// 5. Nested list literal
	val matrix: List<List<i32>> = [[1, 2], [3, 4]];
	if (matrix.len != 2) return false;
	val row0 = matrix.get(0);
	val row1 = matrix.get(1);
	if (row0.get(1) != 2 || row1.get(0) != 3) return false;

	return true;
}

fn test_indexing(): bool {
	val list: List<i32> = [10, 20, 30, 40];
	if (list[0] != 10 || list[2] != 30 || list[3] != 40) return false;

	var mut_list: List<i32> = [1, 2, 3];
	mut_list[0] = 100;
	mut_list[2] = 300;
	if (mut_list[0] != 100 || mut_list[1] != 2 || mut_list[2] != 300) return false;

	mut_list[0] += 50;  // 150
	mut_list[1] *= 10;  // 20
	mut_list[2] -= 100; // 200
	if (mut_list[0] != 150 || mut_list[1] != 20 || mut_list[2] != 200) return false;

	var box_val = CustomIndexBox(10, 20);
	if (box_val[0] != 10 || box_val[1] != 20) return false;
	box_val[0] = 99;
	if (box_val[0] != 99) return false;

	return true;
}

fn test_interpolation_and_formatting(): bool {
	// Literal characters preservation
	val plain = "a{b}c";
	if (plain.len != 5UZ) return false;
	val dollar = "gia: \$5";
	if (dollar != "gia: $5") return false;

	// Basic types interpolation
	val name = "Kobel";
	if ("hi ${name}!" != "hi Kobel!") return false;

	val a: i32 = -7;
	val b: usz = 42UZ;
	if ("${a} and ${b}" != "-7 and 42") return false;

	val flag = true;
	val ch = 'Z';
	if ("${flag} ${ch}" != "true Z") return false;

	val pi: f64 = 3.14;
	val pi_str = "${pi}";
	if (pi_str.len == 0) return false;

	// Custom struct ToStr implementation
	val pt = Point2D(3, 4);
	if ("${pt}" != "Point(3, 4)") return false;

	return true;
}

fn main(): i32 {
	println("=== Feature Suite: Collections, Indexing & Formatting ===");

	if (!test_list_literals()) {
		println("  [FAIL] test_list_literals");
		return 1;
	}
	println("  [PASS] test_list_literals");

	if (!test_indexing()) {
		println("  [FAIL] test_indexing");
		return 1;
	}
	println("  [PASS] test_indexing");

	if (!test_interpolation_and_formatting()) {
		println("  [FAIL] test_interpolation_and_formatting");
		return 1;
	}
	println("  [PASS] test_interpolation_and_formatting");

	println("=== ALL COLLECTIONS & FORMATTING TESTS PASSED! ===");
	return 0;
}
