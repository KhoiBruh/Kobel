mod test.safe_nav;

enum ItemKind {
	FIRST,
	SECOND,
	THIRD
}

struct Inner {
	pub is_active: bool,
	pub kind: ItemKind,
	pub count: i32,
	pub name: str
}

impl Inner {
	pub fn check_ok(val self): bool {
		return self.is_active;
	}

	pub fn get_kind(val self): ItemKind {
		return self.kind;
	}
}

struct Middle {
	pub inner: *Inner? = null
}

struct Outer {
	pub middle: *Middle? = null
}

fn takes_non_null(item: *Inner): bool {
	return item.kind == ItemKind.SECOND;
}

fn main(): i32 {
	var in1 = Inner(true, ItemKind.SECOND, 42, "hello");
	var mid1 = Middle(&in1);
	var out1 = Outer(&mid1);

	var p_null_in: *Inner? = null;
	var p_null_out: *Outer? = null;

	// 1. Safe method call on null pointer returning bool: must short-circuit to false
	if (p_null_in?.check_ok()) return 1;

	// 2. Safe method call on non-null pointer returning bool: must evaluate to true
	val p_real_in: *Inner? = &in1;
	if (!p_real_in?.check_ok()) return 2;

	// 3. Safe field access on null pointer: must short-circuit to false
	if (p_null_in?.is_active) return 3;

	// 4. Safe field access on real pointer: must evaluate to true
	if (!p_real_in?.is_active) return 4;

	// 5. Chained safe method calls: out?.middle?.inner?.check_ok()
	val p_out: *Outer? = &out1;
	if (!p_out?.middle?.inner?.check_ok()) return 5;

	// 6. Broken chain at root: must short-circuit to false
	if (p_null_out?.middle?.inner?.check_ok()) return 6;

	// 7. Broken chain in middle: must short-circuit to false
	var mid_empty = Middle(null);
	var out_mid_empty = Outer(&mid_empty);
	val p_broken: *Outer? = &out_mid_empty;
	if (p_broken?.middle?.inner?.check_ok()) return 7;

	// 8. Universal safe access on Enum: null pointer returns 0, real returns SECOND
	if (p_null_in?.kind == ItemKind.SECOND) return 8;
	if (p_real_in?.kind != ItemKind.SECOND) return 9;

	// 9. Universal safe method call returning Enum
	if (p_null_in?.get_kind() == ItemKind.SECOND) return 10;
	if (p_real_in?.get_kind() != ItemKind.SECOND) return 11;

	// 10. Universal safe access on Int
	if (p_null_in?.count != 0) return 12;
	if (p_real_in?.count != 42) return 13;

	// 11. Smart cast: p_test is promoted to non-null *Inner inside `if (p_test?.kind == ItemKind.SECOND)`
	val p_test: *Inner? = &in1;
	if (p_test?.kind == ItemKind.SECOND) {
		// p_test is now *Inner, can pass to takes_non_null without `!` or `!!`
		if (!takes_non_null(p_test)) return 14;
		val direct_cnt = p_test.count;
		if (direct_cnt != 42) return 15;
	} else {
		return 16;
	}

	return 0;
}
