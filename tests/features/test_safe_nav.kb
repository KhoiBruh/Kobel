mod test.safe_nav;

enum ItemKind {
	FIRST,
	SECOND,
	THIRD
}

struct Inner {
	pub is_active: bool,
	pub kind: ItemKind,
	pub count: i32,
	pub name: str
}

impl Inner {
	pub fn check_ok(*self): bool {
		return self.is_active;
	}

	pub fn get_kind(*self): ItemKind {
		return self.kind;
	}
}

struct Middle {
	pub inner: ?*Inner = null
}

struct Outer {
	pub middle: ?*Middle = null
}

fn takes_non_null(item: *Inner): bool {
	return item.kind == ItemKind.SECOND;
}

fn test_elvis_jump_on_null(p: ?*Inner): bool {
	val k = p?.kind ?: return true;
	return false;
}

fn main(): i32 {
	var in1 = Inner(true, ItemKind.SECOND, 42, "hello");
	var mid1 = Middle(&in1);
	var out1 = Outer(&mid1);

	var p_null_in: ?*Inner = null;
	var p_null_out: ?*Outer = null;

	// 1. Safe method call on null pointer returning bool: must short-circuit to false
	if (p_null_in?.check_ok()) return 1;

	// 2. Safe method call on non-null pointer returning bool: must evaluate to true
	val p_real_in: ?*Inner = &in1;
	if (!p_real_in?.check_ok()) return 2;

	// 3. Safe field access on null pointer: must short-circuit to false
	if (p_null_in?.is_active) return 3;

	// 4. Safe field access on real pointer: must evaluate to true
	if (!p_real_in?.is_active) return 4;

	// 5. Chained safe method calls: out?.middle?.inner?.check_ok()
	val p_out: ?*Outer = &out1;
	if (!p_out?.middle?.inner?.check_ok()) return 5;

	// 6. Broken chain at root: must short-circuit to false
	if (p_null_out?.middle?.inner?.check_ok()) return 6;

	// 7. Broken chain in middle: must short-circuit to false
	var mid_empty = Middle(null);
	var out_mid_empty = Outer(&mid_empty);
	val p_broken: ?*Outer = &out_mid_empty;
	if (p_broken?.middle?.inner?.check_ok()) return 7;

	// 8. Safe comparison on null pointer in conditions: MUST be false, never match
	// Even though ItemKind.FIRST == 0, null check fails first!
	if (p_null_in?.kind == ItemKind.FIRST) return 8;
	if (p_null_in?.kind != ItemKind.SECOND) return 9; // null is not checked -> false
	if (p_real_in?.kind != ItemKind.SECOND) return 10;
	if (p_real_in?.kind == ItemKind.FIRST) return 11;

	// 9. Relational comparison with safe navigation in condition
	if (p_null_in?.count < 100) return 12; // null fails first -> false
	if (!(p_real_in?.count < 100)) return 13;

	// 10. Smart cast: p_test is promoted to non-null *Inner inside `if (p_test?.kind == ItemKind.SECOND)`
	val p_test: ?*Inner = &in1;
	if (p_test?.kind == ItemKind.SECOND) {
		// p_test is now *Inner, can pass to takes_non_null without `!` or `!!`
		if (!takes_non_null(p_test)) return 14;
		val direct_cnt = p_test.count;
		if (direct_cnt != 42) return 15;
	} else {
		return 16;
	}

	// 11. Elvis operator with safe navigation on primitive/enum: type?.b ?: fallback
	val k_fallback = p_null_in?.kind ?: ItemKind.THIRD;
	if (k_fallback != ItemKind.THIRD) return 17;

	val k_real = p_real_in?.kind ?: ItemKind.THIRD;
	if (k_real != ItemKind.SECOND) return 18;

	val cnt_fallback = p_null_in?.count ?: 99;
	if (cnt_fallback != 99) return 19;

	val cnt_real = p_real_in?.count ?: 99;
	if (cnt_real != 42) return 20;

	// 12. Elvis operator with jump statement on safe navigation
	if (!test_elvis_jump_on_null(p_null_in)) return 21;
	val k_no_jump = p_real_in?.kind ?: return 22;
	if (k_no_jump != ItemKind.SECOND) return 23;

	return 0;
}
