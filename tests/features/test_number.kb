mod tests.features.test_number;

use std.number.*;
use std.io.println;

fn assert(cond: bool, msg: str) {
	if (!cond) {
		println("Assertion failed: ${msg}");
	}
}

fn test_number_trait<T: Number>(val x: T): bool {
	return x.to_f64() != 0.0 || x.is_zero();
}

fn test_integer_trait<T: Integer>(val x: T): bool {
	return x.is_even() || x.is_odd();
}

fn main() {
	println("--- Testing std.number ---");

	// 1. Constants
	assert(MAX_I8 == 127, "MAX_I8 must be 127");
	assert(MIN_I8 == -128, "MIN_I8 must be -128");
	assert(MAX_I16 == 32767, "MAX_I16 must be 32767");
	assert(MIN_I16 == -32768, "MIN_I16 must be -32768");
	assert(MAX_I32 == 2147483647, "MAX_I32 must be 2147483647");
	assert(MAX_U8 == 255, "MAX_U8 must be 255");
	assert(MAX_U16 == 65535, "MAX_U16 must be 65535");

	// 2. Trait bounds
	val i: i32 = 42;
	assert(test_number_trait(i), "i32 must implement Number");
	assert(test_integer_trait(i), "i32 must implement Integer");

	val u: u64 = 100;
	assert(test_number_trait(u), "u64 must implement Number");
	assert(test_integer_trait(u), "u64 must implement Integer");

	val f: f64 = 3.14;
	assert(test_number_trait(f), "f64 must implement Number");

	// 3. Inherent integer methods
	val neg: i32 = -15;
	assert(neg.abs() == 15, "neg.abs() must be 15");
	assert(neg.signum() == -1, "neg.signum() must be -1");
	assert(neg.is_odd(), "neg is odd");
	assert(!neg.is_even(), "neg is not even");

	val pos: i32 = 20;
	assert(pos.clamp(0, 10) == 10, "pos clamped to 10");
	assert(pos.clamp(30, 50) == 30, "pos clamped to 30");
	assert(pos.clamp(10, 30) == 20, "pos clamped inside range");

	// 4. Bitwise operations
	val b: u32 = 7; // 0b111
	assert(b.count_ones() == 3, "count_ones for 7 is 3");
	assert(b.count_zeros() == 29, "count_zeros for 7 is 29");
	assert(b.trailing_zeros() == 0, "trailing_zeros for 7 is 0");

	val p16: u32 = 16; // 0b10000
	assert(p16.trailing_zeros() == 4, "trailing_zeros for 16 is 4");

	// 5. Number formatting (hex, bin)
	val h: u32 = 255;
	assert(h.to_hex() == "0xFF", "255.to_hex() must be 0xFF");
	val bn: u32 = 10;
	assert(bn.to_bin() == "0b1010", "10.to_bin() must be 0b1010");

	// 6. Float methods
	val fl: f64 = 3.7;
	assert(fl.floor() == 3.0, "3.7.floor() == 3.0");
	assert(fl.ceil() == 4.0, "3.7.ceil() == 4.0");
	assert(fl.round() == 4.0, "3.7.round() == 4.0");
	assert(fl.trunc() == 3.0, "3.7.trunc() == 3.0");

	val neg_fl: f64 = -3.7;
	assert(neg_fl.floor() == -4.0, "-3.7.floor() == -4.0");
	assert(neg_fl.ceil() == -3.0, "-3.7.ceil() == -3.0");
	assert(neg_fl.round() == -4.0, "-3.7.round() == -4.0");
	assert(neg_fl.trunc() == -3.0, "-3.7.trunc() == -3.0");
	assert(neg_fl.abs() == 3.7, "-3.7.abs() == 3.7");

	assert(fl.is_finite(), "fl is finite");
	assert(!fl.is_nan(), "fl is not nan");

	println("[PASS] test_number");
}
