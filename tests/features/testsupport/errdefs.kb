mod testsupport.errdefs;

pub fault NetErr {
	Timeout("Network request timed out"),
	Closed(code: i32)("Connection closed by peer")
}

pub fn ping(id: i32): i32 ! NetErr {
	if (id == 0) return NetErr.Timeout;
	if (id < 0) return NetErr.Closed(id);
	return id * 10;
}

pub fn ping_void(ok: bool): !NetErr {
	if (!ok) return NetErr.Timeout;
}
