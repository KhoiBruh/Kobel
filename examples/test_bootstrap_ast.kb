mod test.bootstrap_ast;

use std.io.print;
use std.io.println;

use compiler.ast.node.NodeKind;
use compiler.ast.node.AstNode;

use compiler.ast.types.NamedType;
use compiler.ast.types.PointerType;
use compiler.ast.types.ArrayType;

use compiler.ast.expr.LiteralKind;
use compiler.ast.expr.LiteralExpr;
use compiler.ast.expr.IdentifierExpr;
use compiler.ast.expr.BinaryExpr;
use compiler.ast.expr.UnaryExpr;
use compiler.ast.expr.GroupExpr;

use compiler.ast.stmt.BlockStmt;
use compiler.ast.stmt.ExprStmt;
use compiler.ast.stmt.VarDeclStmt;
use compiler.ast.stmt.IfStmt;
use compiler.ast.stmt.ReturnStmt;

use compiler.ast.decl.Param;
use compiler.ast.decl.GenericParam;
use compiler.ast.decl.FnDecl;

use compiler.ast.builder.AstBuilder;

use compiler.ast.builder.as_literal;
use compiler.ast.builder.as_identifier;
use compiler.ast.builder.as_binary;
use compiler.ast.builder.as_unary;
use compiler.ast.builder.as_group;
use compiler.ast.builder.as_named_type;
use compiler.ast.builder.as_block_stmt;
use compiler.ast.builder.as_var_decl;
use compiler.ast.builder.as_if_stmt;
use compiler.ast.builder.as_return_stmt;
use compiler.ast.builder.as_fn_decl;
use compiler.ast.builder.as_program;
use compiler.ast.decl.Program;

use compiler.lexer.token.TokenType;
use std.collections.list.List;
use std.mem.arena.Arena;

// Simple string-to-int helper for our test evaluator
fn parse_i32(s: str): i32 {
	var res: i32 = 0;
	for (i in 0..<s.len) {
		val c = s[i];
		if (c >= '0' && c <= '9') {
			val digit = (c as i32) - ('0' as i32);
			res = res * 10 + digit;
		}
	}
	return res;
}

// Tree traversal using when (node.kind) statement
fn eval_expr(node: *AstNode): i32 {
	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = as_literal(node);
			return parse_i32(lit.raw_text);
		}
		NodeKind.EXPR_GROUP -> {
			val grp = as_group(node);
			return eval_expr(grp.expr);
		}
		NodeKind.EXPR_BINARY -> {
			val bin = as_binary(node);
			val l = eval_expr(bin.left);
			val r = eval_expr(bin.right);
			when (bin.op) {
				TokenType.PLUS -> return l + r;
				TokenType.MINUS -> return l - r;
				TokenType.STAR -> return l * r;
				TokenType.SLASH -> return l / r;
				else -> return 0;
			}
		}
		else -> return 0;
	}
	return 0;
}

fn test_expression_tree(): bool {
	var arena = Arena(16384UZ);
	var b = AstBuilder(&arena);

	// Build: (10 + 20) * 3
	val lit10 = b.literal(LiteralKind.INT, "10", 1UZ, 2UZ);
	val lit20 = b.literal(LiteralKind.INT, "20", 1UZ, 7UZ);
	val add_expr = b.binary(TokenType.PLUS, lit10, lit20, 1UZ, 5UZ);
	val group_expr = b.group(add_expr, 1UZ, 1UZ);

	val lit3 = b.literal(LiteralKind.INT, "3", 1UZ, 13UZ);
	val mul_expr = b.binary(TokenType.STAR, group_expr, lit3, 1UZ, 11UZ);

	if (mul_expr.kind != NodeKind.EXPR_BINARY) return false;

	val bin = as_binary(mul_expr);
	if (bin.op != TokenType.STAR) return false;
	if (bin.right.kind != NodeKind.EXPR_LITERAL) return false;

	val r_lit = as_literal(bin.right);
	if (r_lit.raw_text != "3") return false;

	if (bin.left.kind != NodeKind.EXPR_GROUP) return false;
	val grp = as_group(bin.left);
	if (grp.expr.kind != NodeKind.EXPR_BINARY) return false;

	// Evaluate tree
	val val_result = eval_expr(mul_expr);
	if (val_result != 90) return false;

	arena.delete();
	return true;
}

fn test_statement_nodes(): bool {
	var arena = Arena(16384UZ);
	var b = AstBuilder(&arena);

	// var count: i32 = 42;
	val ty_i32 = b.named_type("i32", List<*AstNode>(), 1UZ, 12UZ);
	val lit42 = b.literal(LiteralKind.INT, "42", 1UZ, 18UZ);
	val var_stmt = b.var_decl(true, "count", ty_i32, lit42, 1UZ, 1UZ);

	if (var_stmt.kind != NodeKind.STMT_VAR_DECL) return false;
	val vd = as_var_decl(var_stmt);
	if (!vd.is_mut || vd.name != "count") return false;
	if (vd.type_annotation.kind != NodeKind.TYPE_NAMED) return false;
	if (vd.initializer.kind != NodeKind.EXPR_LITERAL) return false;

	// return count;
	val id_count = b.identifier("count", 2UZ, 8UZ);
	val ret_stmt = b.return_stmt(id_count, 2UZ, 1UZ);
	if (ret_stmt.kind != NodeKind.STMT_RETURN) return false;

	// { return count; }
	var stmts = List<*AstNode>();
	stmts.add(ret_stmt);
	val block = b.block_stmt(stmts, 2UZ, 1UZ);
	if (block.kind != NodeKind.STMT_BLOCK) return false;
	val blk = as_block_stmt(block);
	if (blk.statements.len != 1UZ) return false;

	// if (count > 0) { return count; }
	val lit0 = b.literal(LiteralKind.INT, "0", 3UZ, 13UZ);
	val cond = b.binary(TokenType.GREATER, id_count, lit0, 3UZ, 11UZ);
	val if_stmt = b.if_stmt(cond, block, null, 3UZ, 1UZ);

	if (if_stmt.kind != NodeKind.STMT_IF) return false;
	val ifs = as_if_stmt(if_stmt);
	if (ifs.condition.kind != NodeKind.EXPR_BINARY) return false;
	if (ifs.then_branch.kind != NodeKind.STMT_BLOCK) return false;

	arena.delete();
	return true;
}

fn test_declaration_nodes(): bool {
	var arena = Arena(16384UZ);
	var b = AstBuilder(&arena);

	// fn add(a: i32, b: i32): i32 { return a + b; }
	var params = List<Param>();
	val ty_i32 = b.named_type("i32", List<*AstNode>(), 1UZ, 1UZ);
	params.add(Param("a", ty_i32, false, false));
	params.add(Param("b", ty_i32, false, false));

	val id_a = b.identifier("a", 1UZ, 1UZ);
	val id_b = b.identifier("b", 1UZ, 1UZ);
	val add_expr = b.binary(TokenType.PLUS, id_a, id_b, 1UZ, 1UZ);
	val ret_stmt = b.return_stmt(add_expr, 1UZ, 1UZ);

	var body_stmts = List<*AstNode>();
	body_stmts.add(ret_stmt);
	val body = b.block_stmt(body_stmts, 1UZ, 1UZ);

	val fn_node = b.fn_decl(
		"add",
		List<GenericParam>(),
		params,
		ty_i32,
		body,
		true,
		1UZ,
		1UZ
	);

	if (fn_node.kind != NodeKind.DECL_FN) return false;
	val fn_d = as_fn_decl(fn_node);
	if (fn_d.name != "add") return false;
	if (!fn_d.is_pub) return false;
	if (fn_d.params.len != 2UZ) return false;
	if (fn_d.params.get(0UZ).name != "a") return false;
	if (fn_d.params.get(1UZ).name != "b") return false;

	arena.delete();
	return true;
}

fn test_program_iterable(): bool {
	var arena = Arena();
	var b = AstBuilder(&arena);
	var decls = List<*AstNode>();
	val d1 = b.fn_decl("f1", List<GenericParam>(), List<Param>(), null, null, true, 1UZ, 1UZ);
	val d2 = b.fn_decl("f2", List<GenericParam>(), List<Param>(), null, null, true, 2UZ, 1UZ);
	decls.add(d1);
	decls.add(d2);
	val prog_node = b.program(decls, 1UZ, 1UZ);
	val prog = as_program(prog_node);

	var count: usz = 0;
	for (d in prog) {
		count = count + 1UZ;
	}
	if (count != 2UZ) return false;

	val p_val = *prog;
	var count2: usz = 0;
	for (d in p_val) {
		count2 = count2 + 1UZ;
	}
	if (count2 != 2UZ) return false;

	arena.delete();
	return true;
}

fn test_ast_builder_and_methods(): bool {
	var arena = Arena();
	var b = AstBuilder(&arena);

	val lit_node = b.literal(LiteralKind.INT, "123", 1UZ, 1UZ);
	val lit = lit_node.as_literal();
	if (lit.raw_text != "123") return false;
	val lit_to = lit_node.to<LiteralExpr>();
	if (lit_to.raw_text != "123") return false;

	val id_node = b.identifier("x", 1UZ, 5UZ);
	val id = id_node.as_identifier();
	if (id.name != "x") return false;
	val id_to = id_node.to<IdentifierExpr>();
	if (id_to.name != "x") return false;

	val bin_node = b.binary(TokenType.PLUS, lit_node, id_node, 1UZ, 3UZ);
	val bin = bin_node.as_binary();
	if (bin.op != TokenType.PLUS) return false;
	if (bin.left.to<LiteralExpr>().raw_text != "123") return false;
	if (bin.right.to<IdentifierExpr>().name != "x") return false;

	val fn_node = b.fn_decl("test_fn", List<GenericParam>(), List<Param>(), null, null, true, 2UZ, 1UZ);
	val fn_d = fn_node.to<FnDecl>();
	if (fn_d.name != "test_fn") return false;
	if (!fn_d.is_pub) return false;

	// Test b.make<T>()
	val m_lit = b.make<LiteralExpr>(NodeKind.EXPR_LITERAL, LiteralExpr(LiteralKind.INT, "456"), 3UZ, 1UZ);
	if (m_lit.to<LiteralExpr>().raw_text != "456") return false;

	val m_id = b.make<IdentifierExpr>(NodeKind.EXPR_IDENTIFIER, IdentifierExpr("y"), 3UZ, 5UZ);
	if (m_id.to<IdentifierExpr>().name != "y") return false;

	val m_bin = b.make<BinaryExpr>(NodeKind.EXPR_BINARY, BinaryExpr(m_lit, TokenType.STAR, m_id), 3UZ, 3UZ);
	val bin_d = m_bin.to<BinaryExpr>();
	if (bin_d.op != TokenType.STAR) return false;
	if (bin_d.left.to<LiteralExpr>().raw_text != "456") return false;
	if (bin_d.right.to<IdentifierExpr>().name != "y") return false;

	arena.delete();
	return true;
}

fn main(): i32 {
	println("[RUNNING] Bootstrap AST tests...");

	if (!test_expression_tree()) {
		println("  [FAIL] test_expression_tree");
		return 1;
	}
	println("  [PASS] test_expression_tree");
	if (!test_statement_nodes()) {
		println("  [FAIL] test_statement_nodes");
		return 1;
	}
	println("  [PASS] test_statement_nodes");

	if (!test_declaration_nodes()) {
		println("  [FAIL] test_declaration_nodes");
		return 1;
	}
	println("  [PASS] test_declaration_nodes");

	if (!test_program_iterable()) {
		println("  [FAIL] test_program_iterable");
		return 1;
	}
	println("  [PASS] test_program_iterable");

	if (!test_ast_builder_and_methods()) {
		println("  [FAIL] test_ast_builder_and_methods");
		return 1;
	}
	println("  [PASS] test_ast_builder_and_methods");

	println("[ALL PASSED] Bootstrap AST passed all tests successfully!");
	return 0;
}
