mod test.bootstrap_default_args;

use std.io.println;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		println("ASSERTION FAILED: " + msg);
	}
}

// 1. Function with default parameters
fn greet(name: str, greeting: str = "Hello", punctuation: str = "!"): str {
	return "${greeting}, ${name}${punctuation}";
}

fn add_nums(a: i32, b: i32 = 10, c: i32 = 20): i32 {
	return a + b + c;
}

// 2. Struct with default field values
struct Config {
	host: str,
	port: i32 = 8080,
	debug: bool = false
}

// 3. Struct with `new` constructor default parameters
struct Point {
	x: i32,
	y: i32
}

impl Point {
	fn new(x: i32 = 0, y: i32 = 0): Point => Self(x, y);

	fn add_offset(self, dx: i32, dy: i32 = 5): Point {
		return Point(self.x + dx, self.y + dy);
	}
}

// 4. Primitive method with default parameters
impl i32 {
	fn scale_add(self, factor: i32 = 2, bias: i32 = 1): i32 {
		return self * factor + bias;
	}
}

fn main(): i32 {
	println("[RUNNING] Test default arguments for functions, methods, and structs...");

	// Test 1: Function default arguments
	assert_true(greet("Alice") == "Hello, Alice!", "greet with 1 arg");
	assert_true(greet("Bob", "Hi") == "Hi, Bob!", "greet with 2 args");
	assert_true(greet("Charlie", "Hey", "?") == "Hey, Charlie?", "greet with 3 args");

	assert_true(add_nums(5) == 35, "add_nums(5) == 5 + 10 + 20 == 35");
	assert_true(add_nums(5, 1) == 26, "add_nums(5, 1) == 5 + 1 + 20 == 26");
	assert_true(add_nums(5, 1, 2) == 8, "add_nums(5, 1, 2) == 5 + 1 + 2 == 8");

	// Test 2: Struct field default values
	val c1 = Config("localhost");
	assert_true(c1.host == "localhost", "c1 host");
	assert_true(c1.port == 8080, "c1 port default");
	assert_true(c1.debug == false, "c1 debug default");

	val c2 = Config("0.0.0.0", 3000);
	assert_true(c2.host == "0.0.0.0", "c2 host");
	assert_true(c2.port == 3000, "c2 port overridden");
	assert_true(c2.debug == false, "c2 debug default");

	val c3 = Config("127.0.0.1", 9000, true);
	assert_true(c3.host == "127.0.0.1", "c3 host");
	assert_true(c3.port == 9000, "c3 port overridden");
	assert_true(c3.debug == true, "c3 debug overridden");

	// Test 3: Struct `new` constructor default parameters
	val p1 = Point();
	assert_true(p1.x == 0 && p1.y == 0, "Point() defaults");

	val p2 = Point(10);
	assert_true(p2.x == 10 && p2.y == 0, "Point(10) default y");

	val p3 = Point(10, 20);
	assert_true(p3.x == 10 && p3.y == 20, "Point(10, 20) no defaults");

	// Test 4: Method default parameters
	val p4 = p3.add_offset(3);
	assert_true(p4.x == 13 && p4.y == 25, "p3.add_offset(3) default dy");

	val p5 = p3.add_offset(3, 1);
	assert_true(p5.x == 13 && p5.y == 21, "p3.add_offset(3, 1) overridden dy");

	// Test 5: Primitive method default parameters
	val num: i32 = 10;
	assert_true(num.scale_add() == 21, "num.scale_add() defaults");
	assert_true(num.scale_add(3) == 31, "num.scale_add(3) default bias");
	assert_true(num.scale_add(3, 10) == 40, "num.scale_add(3, 10) no defaults");

	println("  [PASS] All default argument tests passed successfully!");
	return 0;
}
