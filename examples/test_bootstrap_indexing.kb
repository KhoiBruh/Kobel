use std.collections.list.*;
use std.io.*;

struct IntBox {
	pub a: i32,
	pub b: i32
}

impl IntBox {
	pub fn get(val self, i: usz): i32 => if (i == 0) self.a else self.b;

	pub fn set(var self, i: usz, v: i32) {
		if (i == 0) self.a = v;
		else self.b = v;
	}
}

fn read_first(l: List<i32>): i32 => l[0];

fn main(): i32 {
	println("=== Test 1: List[i] read ===");
	val list: List<i32> = [10, 20, 30, 40];
	if (list[0] != 10) {
		println("FAIL: list[0] != 10");
		return 1;
	}
	if (list[2] != 30 || list[3] != 40) {
		println("FAIL: list[2] or list[3] mismatch");
		return 1;
	}
	println("Test 1 PASS");

	println("=== Test 2: List[i] write ===");
	var mut_list: List<i32> = [1, 2, 3];
	mut_list[0] = 100;
	mut_list[2] = 300;
	if (mut_list[0] != 100 || mut_list[1] != 2 || mut_list[2] != 300) {
		println("FAIL: mut_list write mismatch");
		return 1;
	}
	println("Test 2 PASS");

	println("=== Test 3: List[i] compound assignment ===");
	mut_list[0] += 50;  // 100 + 50 = 150
	mut_list[1] *= 10;  // 2 * 10 = 20
	mut_list[2] -= 100; // 300 - 100 = 200
	if (mut_list[0] != 150 || mut_list[1] != 20 || mut_list[2] != 200) {
		println("FAIL: mut_list compound assign mismatch");
		return 1;
	}
	println("Test 3 PASS");

	println("=== Test 4: List[i] in expressions & interpolation ===");
	val sum = list[0] + list[1] + list[2];
	if (sum != 60) {
		println("FAIL: sum != 60");
		return 1;
	}
	val s = "${list[1]}";
	if (s != "20") {
		println("FAIL: interpolation mismatch");
		return 1;
	}
	println("Test 4 PASS");

	println("=== Test 5: Function parameter List<T>[i] ===");
	val first_elem = read_first(list);
	if (first_elem != 10) {
		println("FAIL: read_first(list) != 10");
		return 1;
	}
	println("Test 5 PASS");

	println("=== Test 6: Custom struct with get/set ===");
	var box = IntBox(10, 20);
	if (box[0] != 10 || box[1] != 20) {
		println("FAIL: box read mismatch");
		return 1;
	}
	box[0] = 99;
	box[1] += 5;
	if (box[0] != 99 || box[1] != 25) {
		println("FAIL: box write mismatch");
		return 1;
	}
	println("Test 6 PASS");

	println("=== Test 7: Raw array and string indexing unchanged ===");
	val raw_arr = [5, 6, 7];
	if (raw_arr[0] != 5 || raw_arr[2] != 7) {
		println("FAIL: raw_arr mismatch");
		return 1;
	}
	val text = "Kobel";
	if (text[0] != 'K' || text[4] != 'l') {
		println("FAIL: text mismatch");
		return 1;
	}
	println("Test 7 PASS");

	println("=== ALL INDEXING TESTS PASSED! ===");
	return 0;
}
