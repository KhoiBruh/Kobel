use std.io.*;
use fmt.options.*;
use fmt.formatter.*;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_str(actual: str, expected: str, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		println(msg);
		print("  Expected:\n");
		println(expected);
		print("  Actual:\n");
		println(actual);
	}
}

// ============================================================================
// Test 1: Basic Declarations (struct, fn, mod, use)
// ============================================================================

fn test_basic_formatting() {
	val unformatted = "mod my.cool.module;\nuse std.io.*;\nuse std.collections.list.List;\nstruct Point{\nx:i32,\ny:i32\n}\nfn add(a:i32,b:i32):i32=>a+b;\n";
	val options = default_format_options();
	val formatted = format_source(unformatted, options);

	println("--- Formatted Output 1 ---");
	println(formatted);

	assert_true(formatted.len > 0UZ, "Formatted output must not be empty");
	println("  [PASS] test_basic_formatting");
}

// ============================================================================
// Test 2: Smart Tabs & K&R Braces
// ============================================================================

fn test_knr_and_smart_tabs() {
	val code = "fn test_branch(x: i32): str {\nif (x > 0) {\nreturn \"positive\";\n} else {\nreturn \"zero or negative\";\n}\n}\n";
	val options = default_format_options();
	val formatted = format_source(code, options);

	println("--- Formatted Output 2 ---");
	println(formatted);

	assert_true(formatted.len > 0UZ, "Formatted output must not be empty");
	println("  [PASS] test_knr_and_smart_tabs");
}

// ============================================================================
// Test 3: Comment Preservation
// ============================================================================

fn test_comments() {
	val code = "// Module header comment\nmod app.main;\n\n// Point structure doc\nstruct Point {\n\tpub x: i32,\n\tpub y: i32\n}\n";
	val options = default_format_options();
	val formatted = format_source(code, options);

	println("--- Formatted Output 3 ---");
	println(formatted);

	assert_true(formatted.len > 0UZ, "Formatted output must not be empty");
	println("  [PASS] test_comments");
}

fn main() {
	println("[RUNNING] Kobel Formatter tests...");
	test_basic_formatting();
	test_knr_and_smart_tabs();
	test_comments();
	println("[ALL PASSED] Kobel Formatter tests passed successfully!");
}
