extern "libc" {
    fn puts(s: *char): i32;
}

fn main(): i32 {
    // 1. Khai bao mang tinh voi suy luan kich thuoc (size = 5)
    val a: Array<i32> = [10, 20, 30, 40, 50];

    // 2. Thuoc tinh .len
    val len: i32 = a.len;
    if (len != 5) {
        puts("Error: a.len != 5");
        return 1;
    }

    // 3. Sua phan tu tai cho (val cho phep sua noi dung phan tu)
    a[0] = 100;
    if (a[0] != 100) {
        puts("Error: a[0] != 100");
        return 2;
    }

    // 4. Tinh tong phan tu qua vong lap while
    var sum: i32 = 0;
    var i: i32 = 0;
    while (i < a.len) {
        sum = sum + a[i];
        i = i + 1;
    }

    // 100 + 20 + 30 + 40 + 50 = 240
    if (sum != 240) {
        puts("Error: sum != 240");
        return 3;
    }

    // 5. Khai bao mang co kich thuoc tuong minh
    val b: Array<i32>(3) = [1, 2, 3];
    if (b.len != 3) {
        puts("Error: b.len != 3");
        return 4;
    }

    // 6. Ep kieu array decay sang con tro *i32
    val ptr: *i32 = a as *i32;
    if (ptr[0] != 100) {
        puts("Error: ptr[0] != 100");
        return 5;
    }

    puts("Array demo passed successfully in Kobel!");
    return 0;
}
