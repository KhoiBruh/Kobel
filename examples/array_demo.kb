extern "libc" {
    fn puts(s: *char): i32;
}

fn main(): i32 {
    // 1. Declare a static array with inferred size (size = 5)
    val a: Array<i32> = [10, 20, 30, 40, 50];

    // 2. The .len property
    val len: i32 = a.len;
    if (len != 5) {
        puts("Error: a.len != 5");
        return 1;
    }

    // 3. Mutate an element in place (val still allows mutating element contents)
    a[0] = 100;
    if (a[0] != 100) {
        puts("Error: a[0] != 100");
        return 2;
    }

    // 4. Sum the elements with a while loop
    var sum: i32 = 0;
    var i: i32 = 0;
    while (i < a.len) {
        sum = sum + a[i];
        i = i + 1;
    }

    // 100 + 20 + 30 + 40 + 50 = 240
    if (sum != 240) {
        puts("Error: sum != 240");
        return 3;
    }

    // 5. Declare an array with an explicit size
    val b: Array<i32>(3) = [1, 2, 3];
    if (b.len != 3) {
        puts("Error: b.len != 3");
        return 4;
    }

    // 6. Cast array decay to a *i32 pointer
    val ptr: *i32 = a as *i32;
    if (ptr[0] != 100) {
        puts("Error: ptr[0] != 100");
        return 5;
    }

    puts("Array demo passed successfully in Kobel!");
    return 0;
}
