mod test.bootstrap_sema_types;

use std.io.print;
use std.io.println;
use std.mem.arena.Arena;
use std.collections.list.List;

use compiler.sema.types.DataType;
use compiler.sema.types.Type;
use compiler.sema.types.PointerType;
use compiler.sema.types.ArrayType;
use compiler.sema.types.StructField;
use compiler.sema.types.StructType;
use compiler.sema.types.FnType;

use compiler.sema.types.type_none;
use compiler.sema.types.type_bool;
use compiler.sema.types.type_i8;
use compiler.sema.types.type_i16;
use compiler.sema.types.type_i32;
use compiler.sema.types.type_i64;
use compiler.sema.types.type_isz;
use compiler.sema.types.type_u8;
use compiler.sema.types.type_u16;
use compiler.sema.types.type_u32;
use compiler.sema.types.type_u64;
use compiler.sema.types.type_usz;
use compiler.sema.types.type_f32;
use compiler.sema.types.type_f64;
use compiler.sema.types.type_str;
use compiler.sema.types.type_primitive;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_usz(actual: usz, expected: usz, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		println(" (usz mismatch)");
	}
}

fn assert_eq_str(actual: str, expected: str, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		print(" | Expected: '");
		print(expected);
		print("', got: '");
		print(actual);
		println("'");
	}
}

// ============================================================================
// Test 1: Primitive Types Properties
// ============================================================================

fn test_primitive_types() {
	var t_i32 = type_i32();
	assert_eq_usz(t_i32.size, 4UZ, "i32 size must be 4");
	assert_eq_usz(t_i32.align, 4UZ, "i32 align must be 4");
	assert_true(t_i32.is_integer(), "i32 must be integer");
	assert_true(t_i32.is_signed_integer(), "i32 must be signed integer");
	assert_true(!t_i32.is_unsigned_integer(), "i32 must not be unsigned");
	assert_true(t_i32.is_numeric(), "i32 must be numeric");

	var t_u64 = type_u64();
	assert_eq_usz(t_u64.size, 8UZ, "u64 size must be 8");
	assert_eq_usz(t_u64.align, 8UZ, "u64 align must be 8");
	assert_true(t_u64.is_unsigned_integer(), "u64 must be unsigned integer");
	assert_true(!t_u64.is_signed_integer(), "u64 must not be signed");

	var t_f64 = type_f64();
	assert_eq_usz(t_f64.size, 8UZ, "f64 size must be 8");
	assert_true(t_f64.is_float(), "f64 must be float");
	assert_true(!t_f64.is_integer(), "f64 must not be integer");

	var t_bool = type_bool();
	assert_eq_usz(t_bool.size, 1UZ, "bool size must be 1");
	assert_true(!t_bool.is_numeric(), "bool must not be numeric");

	// Test type_primitive helper directly
	var t_prim_i16 = type_primitive(DataType.I16);
	assert_eq_usz(t_prim_i16.size, 2UZ, "type_primitive(DataType.I16) size must be 2");
	assert_eq_usz(t_prim_i16.align, 2UZ, "type_primitive(DataType.I16) align must be 2");
	var t_prim_str = type_primitive(DataType.STR);
	assert_eq_usz(t_prim_str.size, 16UZ, "type_primitive(DataType.STR) size must be 16");
	assert_eq_usz(t_prim_str.align, 8UZ, "type_primitive(DataType.STR) align must be 8");

	println("  [PASS] test_primitive_types");
}

// ============================================================================
// Test 2: Pointer & Array Types
// ============================================================================

fn test_pointer_and_array_types() {
	var arena = Arena(16384UZ);

	var t_i32 = type_i32();
	val ptr_mut = arena.pointer_type(&t_i32, true);
	val ptr_const = arena.pointer_type(&t_i32, false);

	assert_eq_usz(ptr_mut.size, 8UZ, "Pointer size must be 8 on x64");
	assert_eq_usz(ptr_mut.align, 8UZ, "Pointer align must be 8 on x64");
	assert_true(ptr_mut.as_pointer().is_mut, "ptr_mut must be mutable");
	assert_true(!ptr_const.as_pointer().is_mut, "ptr_const must not be mutable");
	assert_true(ptr_mut.to<PointerType>().is_mut, "ptr_mut.to<PointerType>() must be mutable");

	// Test UFCS alloc_pointer
	val ptr_ufcs = t_i32.alloc_pointer(&arena, true);
	assert_true(ptr_ufcs.to<PointerType>().is_mut, "ptr_ufcs.to<PointerType>() must be mutable");

	// Test nullable pointer
	val ptr_null = arena.nullable_pointer_type(&t_i32, false);
	assert_true(ptr_null.as_pointer().is_nullable, "ptr_null must be nullable");

	// Array [i32; 10]
	val arr = arena.array_type(&t_i32, 10UZ);
	assert_eq_usz(arr.size, 40UZ, "Array [i32; 10] size must be 40");
	assert_eq_usz(arr.align, 4UZ, "Array [i32; 10] align must be 4");
	assert_eq_usz(arr.as_array().length, 10UZ, "Array length must be 10");
	assert_eq_usz(arr.to<ArrayType>().length, 10UZ, "arr.to<ArrayType>() length must be 10");

	// Test UFCS alloc_array
	val arr_ufcs = t_i32.alloc_array(&arena, 5UZ);
	assert_eq_usz(arr_ufcs.to<ArrayType>().length, 5UZ, "arr_ufcs.to<ArrayType>() length must be 5");

	// Test fn_type
	var params = List<*Type>();
	params.add(&t_i32);
	val fn_ty = arena.fn_type(params, &t_i32);
	assert_eq_usz(fn_ty.as_fn().param_types.len, 1UZ, "fn_ty param count must be 1");

	// Test arena.make_type<T>() and .to<T>()
	val m_ptr = arena.make_type<PointerType>(PointerType(&t_i32, false, false));
	assert_true(m_ptr.kind == DataType.POINTER, "m_ptr kind must be POINTER");
	assert_eq_usz(m_ptr.size, 8UZ, "m_ptr size must be 8");
	assert_eq_usz(m_ptr.align, 8UZ, "m_ptr align must be 8");
	assert_true(m_ptr.to<PointerType>().pointee.equals(&t_i32), "m_ptr pointee must match");

	val m_arr = arena.make_type<ArrayType>(ArrayType(&t_i32, 7UZ));
	assert_true(m_arr.kind == DataType.ARRAY, "m_arr kind must be ARRAY");
	assert_eq_usz(m_arr.size, 28UZ, "m_arr size must be 28");
	assert_eq_usz(m_arr.align, 4UZ, "m_arr align must be 4");
	assert_eq_usz(m_arr.to<ArrayType>().length, 7UZ, "m_arr length must be 7");

	arena.delete();
	println("  [PASS] test_pointer_and_array_types");
}

// ============================================================================
// Test 3: Struct Layout & Alignment (x64 ABI)
// ============================================================================

fn test_struct_layout() {
	var arena = Arena(16384UZ);

	// struct Sample { a: u8, b: i32, c: i64 }
	// - a: u8  -> offset 0, size 1 (rem 3 bytes padding)
	// - b: i32 -> offset 4, size 4
	// - c: i64 -> offset 8, size 8
	// - total size: 16, align: 8
	var t_u8 = type_u8();
	var t_i32 = type_i32();
	var t_i64 = type_i64();

	var fields = List<StructField>();
	fields.add(StructField("a", &t_u8, 0UZ, true));
	fields.add(StructField("b", &t_i32, 0UZ, true));
	fields.add(StructField("c", &t_i64, 0UZ, true));

	val s_ty = arena.struct_type("Sample", fields);

	assert_eq_usz(s_ty.align, 8UZ, "Struct max align must be 8");
	assert_eq_usz(s_ty.size, 16UZ, "Struct size with padding must be 16");

	val s_info = s_ty.as_struct();
	assert_eq_str(s_info.name, "Sample", "Struct name must match");
	assert_eq_str(s_ty.to<StructType>().name, "Sample", "s_ty.to<StructType>() name must match");
	assert_eq_usz(s_ty.to_mut<StructType>().fields.len, 3UZ, "s_ty.to_mut<StructType>() fields len must be 3");
	assert_eq_usz(s_info.fields.len, 3UZ, "Field count must be 3");

	assert_eq_usz(s_info.fields.get(0UZ).offset, 0UZ, "Field a offset must be 0");
	assert_eq_usz(s_info.fields.get(1UZ).offset, 4UZ, "Field b offset must be 4 (after 3B padding)");
	assert_eq_usz(s_info.fields.get(2UZ).offset, 8UZ, "Field c offset must be 8");

	arena.delete();
	println("  [PASS] test_struct_layout");
}

// ============================================================================
// Test 4: Type Equality & Assignability
// ============================================================================

fn test_type_equality_and_assignability() {
	var arena = Arena(16384UZ);

	var t_i32_1 = type_i32();
	var t_i32_2 = type_i32();
	var t_i64 = type_i64();
	var t_bool = type_bool();

	assert_true(t_i32_1.equals(&t_i32_2), "i32 must equal i32");
	assert_true(!t_i32_1.equals(&t_i64), "i32 must not equal i64");

	assert_true(t_i32_1.can_assign(&t_i32_2), "i32 can assign to i32");
	assert_true(!t_bool.can_assign(&t_i32_1), "i32 cannot assign to bool");

	// Pointers: *mut i32 -> *i32 is valid (const promotion)
	val p_mut = arena.pointer_type(&t_i32_1, true);
	val p_const = arena.pointer_type(&t_i32_1, false);

	assert_true(p_const.can_assign(p_mut), "*mut i32 can assign to *i32");
	assert_true(!p_mut.can_assign(p_const), "*i32 cannot assign to *mut i32 without cast");

	arena.delete();
	println("  [PASS] test_type_equality_and_assignability");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic Types tests...");
	test_primitive_types();
	test_pointer_and_array_types();
	test_struct_layout();
	test_type_equality_and_assignability();
	println("[ALL PASSED] Bootstrap Semantic Types passed all tests successfully!");
	return 0;
}
