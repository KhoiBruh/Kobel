extern "libc" {
    fn puts(s: *char): i32;
}

mod math.vec;
pub struct Vector(x: i32, y: i32)
pub const PI: i32 = 314;
pub fn create(x: i32, y: i32): Vector => Vector(x, y);

mod physics.space;
pub struct Vector(mag: i32)
pub const PI: i32 = 3;
pub fn create(mag: i32): Vector => Vector(mag);

mod main;
use math.vec.Vector;
use math.vec.create;
use math.vec.PI;
use physics.space.Vector;
use physics.space.create;
use physics.space.PI;

fn main(): i32 {
    // Both Vector, create, and PI have collisions from math.vec and physics.space!
    // Disambiguate using last module segment prefix:
    val v1 = vec.Vector(10, 20);
    val v2 = space.Vector(100);
    val v3 = vec.create(30, 40);
    val v4 = space.create(200);
    val pi_math = vec.PI;
    val pi_physics = space.PI;

    if (v1.x != 10 || v1.y != 20) return 1;
    if (v2.mag != 100) return 2;
    if (v3.x != 30 || v3.y != 40) return 3;
    if (v4.mag != 200) return 4;
    if (pi_math != 314) return 5;
    if (pi_physics != 3) return 6;

    puts("Module prefix disambiguation passed successfully in Kobel!");
    return 0;
}
