mod test.bootstrap_null_safety;

use std.io.print;
use std.io.println;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_i32(actual: i32, expected: i32, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		print(" - expected ");
		print("${expected}");
		print(", got ");
		println("${actual}");
	}
}

fn test_elvis_return(val ptr: *i32?): i32 {
	val unwrapped = ptr ?: return 42;
	return *unwrapped;
}

fn test_elvis_stmt_return(val ptr: *i32?): i32 {
	ptr ?: return 99;
	return *ptr;
}

fn main() {
	println("=== Test Bootstrap Null Safety & Elvis Operator ===");

	// 1. Nullable pointer declaration with null
	val p_null: *i32? = null;
	assert_true(p_null == null, "p_null should be null");

	// 2. Nullable pointer declaration with address of non-null
	val x: i32 = 10;
	val p_val: *i32? = &x;
	assert_true(p_val != null, "p_val should not be null");

	// 3. Widening: non-null pointer to nullable pointer
	val p_nn: *i32 = &x;
	val p_widened: *i32? = p_nn;
	assert_true(p_widened != null, "p_widened should not be null");

	// 4. Elvis operator with value fallback
	val fb1: *i32 = p_null ?: &x;
	assert_eq_i32(*fb1, 10, "fb1 should fallback to &x (10)");

	val y: i32 = 20;
	val fb2: *i32 = p_val ?: &y;
	assert_eq_i32(*fb2, 10, "fb2 should use p_val (10)");

	// 5. Elvis operator with return jump
	val ret_null = test_elvis_return(null);
	assert_eq_i32(ret_null, 42, "test_elvis_return(null) should return 42");

	val val_30: i32 = 30;
	val ret_val = test_elvis_return(&val_30);
	assert_eq_i32(ret_val, 30, "test_elvis_return(&val_30) should return 30");

	// 6. Elvis statement with return jump
	val ret_stmt_null = test_elvis_stmt_return(null);
	assert_eq_i32(ret_stmt_null, 99, "test_elvis_stmt_return(null) should return 99");

	val ret_stmt_val = test_elvis_stmt_return(&val_30);
	assert_eq_i32(ret_stmt_val, 30, "test_elvis_stmt_return(&val_30) should return 30");

	// 7. Elvis with break jump in a loop
	var break_count: i32 = 0;
	for (i in 0..5) {
		val p: *i32? = if (i == 3) null else &x;
		val unwrapped = p ?: break;
		break_count = break_count + 1;
	}
	assert_eq_i32(break_count, 3, "loop should break on i=3, executed 3 times");

	// 8. Elvis with continue jump in a loop
	var continue_count: i32 = 0;
	for (i in 0..5) {
		val p: *i32? = if (i % 2 == 0) null else &x;
		val unwrapped = p ?: continue;
		continue_count = continue_count + 1;
	}
	assert_eq_i32(continue_count, 2, "loop should continue on even i, executed 2 times (i=1, 3)");

	// 9. Elvis assignment with jump
	var target: *i32 = null;
	for (i in 0..2) {
		val p: *i32? = if (i == 0) &x else null;
		target = p ?: break;
	}
	assert_eq_i32(*target, 10, "target should be 10 from i=0");

	println("[OK] All Null Safety & Elvis tests passed!");
}
