mod test.bootstrap_sema_body;

use std.io.print;
use std.io.println;

use bootstrap.lexer.lexer.Lexer;
use bootstrap.lexer.lexer.new_lexer;
use bootstrap.parser.parser.Parser;
use bootstrap.parser.parser.new_parser;
use bootstrap.parser.decl.parse_program;

use bootstrap.sema.body_pass.BodyPass;
use bootstrap.sema.body_pass.new_body_pass;
use bootstrap.sema.body_pass.check_program;

fn assert_true(cond: bool, msg: str) {
	if (!cond) {
		print("ASSERTION FAILED: ");
		println(msg);
	}
}

fn assert_eq_usz(actual: usz, expected: usz, msg: str) {
	if (actual != expected) {
		print("ASSERTION FAILED: ");
		print(msg);
		println(" (usz mismatch)");
	}
}

// ============================================================================
// Test 1: Valid Program Type Checking
// ============================================================================

fn test_valid_program() {
	val src = "struct Point {\n" +
		"    pub x: i32,\n" +
		"    pub y: i32\n" +
		"}\n" +
		"fn add(a: i32, b: i32): i32 => a + b;\n" +
		"fn compute(p: &Point): i32 {\n" +
		"    val factor = 2;\n" +
		"    val sum = (p.x * factor) + p.y;\n" +
		"    val is_positive = sum > 0;\n" +
		"    if (is_positive) {\n" +
		"        return sum;\n" +
		"    } else {\n" +
		"        return 0;\n" +
		"    }\n" +
		"}\n";

	var lexer = new_lexer(src);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	var bp = new_body_pass();
	check_program(&bp, prog);

	assert_eq_usz(bp.errors.len, 0UZ, "Valid program must have 0 semantic errors");
	println("  [PASS] test_valid_program");
}

// ============================================================================
// Test 2: Undeclared Identifier Error Detection
// ============================================================================

fn test_undeclared_identifier() {
	val src = "fn test(): i32 {\n" +
		"    return unknown_variable + 10;\n" +
		"}\n";

	var lexer = new_lexer(src);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	var bp = new_body_pass();
	check_program(&bp, prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch undeclared identifier error");
	println("  [PASS] test_undeclared_identifier");
}

// ============================================================================
// Test 3: Type Mismatch in Declaration / Assignment
// ============================================================================

fn test_type_mismatch() {
	val src = "fn test(): none {\n" +
		"    val x: i32 = \"this is a string\";\n" +
		"}\n";

	var lexer = new_lexer(src);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	var bp = new_body_pass();
	check_program(&bp, prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch type mismatch error");
	println("  [PASS] test_type_mismatch");
}

// ============================================================================
// Test 4: Condition Not Boolean Error Detection
// ============================================================================

fn test_condition_not_bool() {
	val src = "fn test(): none {\n" +
		"    if (100 + 200) {\n" +
		"        val a = 1;\n" +
		"    }\n" +
		"}\n";

	var lexer = new_lexer(src);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	var bp = new_body_pass();
	check_program(&bp, prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch non-bool condition error");
	println("  [PASS] test_condition_not_bool");
}

// ============================================================================
// Test 5: Return Type Mismatch Error Detection
// ============================================================================

fn test_return_type_mismatch() {
	val src = "fn get_number(): i32 {\n" +
		"    return \"not a number\";\n" +
		"}\n";

	var lexer = new_lexer(src);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	var bp = new_body_pass();
	check_program(&bp, prog);

	assert_true(bp.errors.len >= 1UZ, "Must catch return type mismatch error");
	println("  [PASS] test_return_type_mismatch");
}

fn main(): i32 {
	println("[RUNNING] Bootstrap Semantic BodyPass tests...");
	test_valid_program();
	test_undeclared_identifier();
	test_type_mismatch();
	test_condition_not_bool();
	test_return_type_mismatch();
	println("[ALL PASSED] Bootstrap Semantic BodyPass passed all tests successfully!");
	return 0;
}
