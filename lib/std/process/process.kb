mod std.process;

/*
 * ============================================================================
 * std.process — Process execution and lifecycle control
 * ============================================================================
 */

extern "libc" {
	fn system(cmd: *char): i32;
	fn exit(code: i32);
}

pub fault ProcessErr {
	EmptyCommand("Command string is empty"),
	SpawnFailed("Failed to launch shell or child process")
}

pub struct Process;

impl Process {

	pub fn exec(cmd: str): i32 ! ProcessErr {
		if (cmd.empty()) return ProcessErr.EmptyCommand;
		val rc = system(cmd.c_str());
		if (rc < 0) return ProcessErr.SpawnFailed;
		return rc;
	}

	pub fn exit(code: i32) => exit(code);

}
