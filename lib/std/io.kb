mod std.io;

extern "libc" {
	fn puts(s: *char): i32;
	fn putchar(c: char): i32;
	// The stdio file handle is opaque (`FILE*`): use `*none` so the generated C
	// passes it through without a FILE* / pointer mismatch warning.
	fn fopen(filename: *char, mode: *char): *none;
	fn fclose(stream: *none): i32;
	fn fread(ptr: &u8, size: usz, count: usz, stream: *none): usz;
	fn fwrite(ptr: *char, size: usz, count: usz, stream: *none): usz;
	fn fseek(stream: *none, offset: i64, origin: i32): i32;
	fn ftell(stream: *none): i64;
	fn malloc(size: usz): &u8;
	fn free(ptr: &u8);
}

struct StringRaw {
	data: *char,
	len: usz,
	cap: usz
}

pub fn print(s: str) {
	for (i in 0..<s.len) {
		putchar(s[i]);
	}
}

pub fn println(s: str) => puts(s.c_str());

pub fn read_file(path: str): str {
	val f = fopen(path.c_str(), "rb");
	if (f == null) return "";

	fseek(f, 0L, 2);
	val size_i64 = ftell(f);
	if (size_i64 <= 0L) {
		fclose(f);
		return "";
	}

	fseek(f, 0L, 0);
	val sz = size_i64 as usz;
	val buf = malloc(sz + 1);
	if (buf == null) {
		fclose(f);
		return "";
	}

	val read_bytes = fread(buf, 1, sz, f);
	fclose(f);
	buf[read_bytes] = 0;

	val raw_mem = malloc(24);
	val r = raw_mem as &StringRaw;
	r.data = buf as *char;
	r.len = read_bytes;
	r.cap = sz + 1;
	val sp = r as *str;
	val res = *sp;
	free(raw_mem);
	return res;
}

pub fn write_file(path: str, content: str): bool {
	val f = fopen(path.c_str(), "wb");
	if (f == null) return false;
	val written = fwrite(content.c_str(), 1, content.len, f);
	fclose(f);
	return written == content.len;
}
