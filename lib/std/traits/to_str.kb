mod std.traits.to_str;

use std.mem.alloc.raw_alloc;
use std.str.str_from_bytes;

// ============================================================================
// std.traits.to_str - the `ToStr` trait
//
// `ToStr` is the trait behind string interpolation and `x.to_str()`. It comes
// with implementations for the built-in value types; user structs may implement
// it too (import this module and write `impl ToStr for MyStruct`).
//
// One file per trait keeps std/traits/ organized as more traits are added.
//
// Floats use a fixed-point decimal printer (six fractional digits, trailing
// zeros trimmed) so no libc is needed; there is no exponent notation.
// ============================================================================

pub trait ToStr {
	fn to_str(val self): str;
}

// --- helpers ---------------------------------------------------------------

// Decimal string of an unsigned 64-bit value. The digit count is computed
// first so the digits can be written forward into an exactly sized buffer.
fn fmt_u64(n0: u64): str {
	var n = n0;
	var digits: usz = 1;
	var probe = n;
	while (probe >= 10) {
		probe = probe / 10;
		digits = digits + 1;
	}

	val buf = raw_alloc(digits + 1);
	buf[digits] = 0;
	var i = digits;
	while (i > 0) {
		i = i - 1;
		buf[i] = (48UL + (n % 10)) as u8;
		n = n / 10;
	}
	return str_from_bytes(buf, digits);
}

fn fmt_i64(v: i64): str {
	if (v < 0) return "-" + fmt_u64((0 - v) as u64);
	return fmt_u64(v as u64);
}

fn fmt_char(c: char): str {
	val buf = raw_alloc(2);
	buf[0] = c as u8;
	buf[1] = 0;
	return str_from_bytes(buf, 1);
}

fn fmt_bool(b: bool): str {
	if (b) return "true";
	return "false";
}

// `n` copies of the character '0'.
fn fmt_zeros(n: usz): str {
	if (n == 0) return "";
	val buf = raw_alloc(n + 1);
	for (i in 0..<n) {
		buf[i] = '0' as u8;
	}
	buf[n] = 0;
	return str_from_bytes(buf, n);
}

// Fixed-point decimal with up to six fractional digits, trailing zeros trimmed
// ("1.5", "-2.25", "3"). No exponent notation, so very large or very small
// magnitudes lose precision (see docs, section 6.6).
fn fmt_f64(v: f64): str {
	if (v != v) return "nan";
	// `v - v` is NaN for an infinity and 0 for a finite value.
	val diff = v - v;
	if (diff != 0.0) {
		if (v > 0.0) return "inf";
		return "-inf";
	}

	var sign = "";
	var x = v;
	if (x < 0.0) {
		sign = "-";
		x = 0.0 - x;
	}

	val prec: usz = 6;
	var scale: f64 = 1.0;
	for (k in 0..<prec) {
		scale = scale * 10.0;
	}

	var ip: u64 = x as u64;
	var frac: u64 = ((x - (ip as f64)) * scale + 0.5) as u64;
	if (frac >= (scale as u64)) {
		// Rounding carried into the integer part (e.g. 0.9999999 -> 1.0).
		ip = ip + 1;
		frac = 0;
	}

	var out = sign + fmt_u64(ip);
	if (frac == 0) return out;

	var digits = fmt_u64(frac);
	if (digits.len < prec) digits = fmt_zeros(prec - digits.len) + digits;

	var end = digits.len;
	while (end > 0) {
		if (digits[end - 1] != '0') break;
		end = end - 1;
	}
	if (end == 0) return out;
	return out + "." + digits.slice(0, end);
}

// --- built-in implementations ----------------------------------------------

impl ToStr for bool {
	fn to_str(val self): str => fmt_bool(self);
}

impl ToStr for char {
	fn to_str(val self): str => fmt_char(self);
}

impl ToStr for str {
	fn to_str(val self): str => self;
}

impl ToStr for i8 {
	fn to_str(val self): str => fmt_i64(self as i64);
}

impl ToStr for i16 {
	fn to_str(val self): str => fmt_i64(self as i64);
}

impl ToStr for i32 {
	fn to_str(val self): str => fmt_i64(self as i64);
}

impl ToStr for i64 {
	fn to_str(val self): str => fmt_i64(self);
}

impl ToStr for isz {
	fn to_str(val self): str => fmt_i64(self as i64);
}

impl ToStr for u8 {
	fn to_str(val self): str => fmt_u64(self as u64);
}

impl ToStr for u16 {
	fn to_str(val self): str => fmt_u64(self as u64);
}

impl ToStr for u32 {
	fn to_str(val self): str => fmt_u64(self as u64);
}

impl ToStr for u64 {
	fn to_str(val self): str => fmt_u64(self);
}

impl ToStr for usz {
	fn to_str(val self): str => fmt_u64(self as u64);
}

impl ToStr for f32 {
	fn to_str(val self): str => fmt_f64(self as f64);
}

impl ToStr for f64 {
	fn to_str(val self): str => fmt_f64(self);
}
