mod std.traits.new;

// ============================================================================
// std.traits.new - the `New` construction trait
//
// A type declares one or more `new` overloads; source code then builds it with
// Kotlin-style syntax, `Type(args)`, which picks the overload whose arity
// matches (falling back to field construction when there is none). Inside such
// a constructor, `Self(...)` builds the value directly.
//
// One file per trait keeps std/traits/ organized as more traits are added.
// ============================================================================

pub trait New {
	fn new();
}
