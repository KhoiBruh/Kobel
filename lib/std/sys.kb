mod std.sys;

extern "libc" {
	fn exit(code: i32);
	fn system(cmd: *char): i32;
}

// NOTE: block body instead of `=> exit(code)`:
// v0 emits broken IR for arrow bodies whose expression has void type
// ("Found return instr that returns non-void in Function of void return type").
pub fn sys_exit(code: i32) {
	exit(code);
}

pub fn exec(cmd: str) => system(cmd.c_str());
