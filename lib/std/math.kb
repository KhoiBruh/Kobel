mod std.math;

use std.number.*;

/*
 * ============================================================================
 * std.math — Mathematical constants, generic comparisons, and math utilities
 * ============================================================================
 */

// Mathematical constants
pub const PI: f64 = 3.14159265358979323846;
pub const E: f64 = 2.71828182845904523536;
pub const TAU: f64 = 6.28318530717958647692;
pub const SQRT2: f64 = 1.41421356237309504880;
pub const LN2: f64 = 0.69314718055994530942;
pub const LN10: f64 = 2.30258509299404568402;
pub const LOG2_E: f64 = 1.44269504088896340736;
pub const LOG10_E: f64 = 0.43429448190325182765;
pub const FRAC_1_PI: f64 = 0.31830988618379067154;
pub const FRAC_2_PI: f64 = 0.63661977236758134308;
pub const FRAC_PI_2: f64 = 1.57079632679489661923;
pub const FRAC_PI_4: f64 = 0.78539816339744830962;

// --- Generic comparisons bounded by Number trait ----------------------------

pub fn min<T: Number>(a: T, b: T): T => if (a < b) a else b;

pub fn max<T: Number>(a: T, b: T): T => if (a > b) a else b;

pub fn clamp<T: Number>(v: T, min_val: T, max_val: T): T =>
	if (v < min_val) min_val else (if (v > max_val) max_val else v);

// --- Integer mathematical utilities -----------------------------------------

pub fn gcd(var a: u64, var b: u64): u64 {
	while (b != 0) {
		val t = b;
		b = a % b;
		a = t;
	}
	return a;
}

pub fn lcm(a: u64, b: u64): u64 {
	if (a == 0 || b == 0) return 0;
	return (a / gcd(a, b)) * b;
}

// --- Floating-point & power math utilities ----------------------------------

pub fn pow_i64(base: i64, exp: usz): i64 {
	var res: i64 = 1;
	var b = base;
	var e = exp;
	while (e > 0) {
		if (e % 2 == 1) res *= b;
		b *= b;
		e /= 2;
	}
	return res;
}

pub fn sqrt(x: f64): f64 {
	if (x < 0.0) {
		var z = 0.0;
		return z / z;
	}
	if (x == 0.0 || x != x) return x;
	var guess = x;
	if (x > 1.0) guess = x / 2.0;
	for (i in 0..100) {
		val next_guess = 0.5 * (guess + x / guess);
		val diff = if (next_guess > guess) next_guess - guess else guess - next_guess;
		guess = next_guess;
		if (diff < 0.000000000001) break;
	}
	return guess;
}

pub fn hypot(x: f64, y: f64): f64 => sqrt(x * x + y * y);

pub fn deg_to_rad(deg: f64): f64 => deg * (PI / 180.0);

pub fn rad_to_deg(rad: f64): f64 => rad * (180.0 / PI);
