mod std.collections.string_builder;

use std.mem.alloc.*;
use std.traits.new.New;

struct StringRaw {
	data: *char,
	len: usz,
	cap: usz
}

// `len` is the public size accessor; the buffer and capacity are internal.
pub struct StringBuilder {
	buf: &u8,
	pub len: usz,
	cap: usz
}

pub fn new_string_builder(): StringBuilder => StringBuilder();

// Kotlin-style constructor: `StringBuilder()`.
impl New for StringBuilder {
	pub fn new(): StringBuilder {
		val init_cap = 32UZ;
		val raw = raw_alloc(init_cap);
		return Self(raw, 0, init_cap);
	}
}

impl StringBuilder {
	pub fn append_char(var self, c: char) {
		if (self.len + 2 >= self.cap) self.grow(self.len + 2);
		self.buf[self.len] = c as u8;
		self.len = self.len + 1;
	}

	pub fn append_str(var self, s: str) {
		val s_len = s.len;
		if (self.len + s_len + 1 >= self.cap) self.grow(self.len + s_len + 1);
		var i = 0UZ;
		while (i < s_len) {
			self.buf[self.len + i] = s[i] as u8;
			i = i + 1;
		}
		self.len = self.len + s_len;
	}

	pub fn append_i32(var self, n: i32) {
		var v = n;
		if (v == 0) {
			self.append_char('0');
			return;
		}
		if (v < 0) {
			self.append_char('-');
			v = -v;
		}

		// Emit from the most significant digit: find that digit's place value
		// first, then peel digits off one at a time (no temporary array needed).
		var place: i32 = 1;
		var probe = v;
		while (probe >= 10) {
			probe = probe / 10;
			place = place * 10;
		}
		var rest = v;
		while (place > 0) {
			val digit = rest / place;
			self.append_char((digit + 48) as char);
			rest = rest - digit * place;
			place = place / 10;
		}
	}

	pub fn to_str(val self): str {
		val str_data = raw_alloc(self.len + 1);
		for (i in 0UZ..<self.len) {
			str_data[i] = self.buf[i];
		}
		str_data[self.len] = 0;

		val raw = alloc<StringRaw>();
		raw.data = str_data as *char;
		raw.len = self.len;
		raw.cap = self.len + 1;
		val sp = raw as *str;
		val res = *sp;
		release<StringRaw>(raw);
		return res;
	}

	pub fn clear(var self) {
		self.len = 0;
	}

	fn grow(var self, min_cap: usz) {
		var new_cap = self.cap * 2;
		while (new_cap < min_cap) {
			new_cap = new_cap * 2;
		}
		val new_raw = raw_resize(self.buf, new_cap);
		self.buf = new_raw;
		self.cap = new_cap;
	}

	// NOTE: block body instead of `=> raw_release(...)`:
	// v0 cannot resolve module-level `extern` fns from arrow bodies inside impl.
	pub fn delete(self) {
		raw_release(self.buf);
	}
}
