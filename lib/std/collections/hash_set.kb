mod std.collections;

use std.memory.*;
use std.traits.*;

/*
 * ============================================================================
 * HashSet<T: Hash> — open-addressed hash set with Robin Hood backward-shift
 * deletion.
 *
 * Uses linear probing without tombstones. `len` is the public element count;
 * the backing arrays and capacity are internal.
 * ============================================================================
 */
pub struct HashSet<T: Hash> {
	keys: &T,
	hashes: &usz,
	occupied: &bool,
	pub len: usz = 0,
	cap: usz = 0
}

impl HashSet<T: Hash> {

	pub init(init_cap: usz = 16) {
		var cap = init_cap;
		if (cap < 8) cap = 8;

		val keys = Heap.create_array<T>(cap);
		val hashes = Heap.create_array<usz>(cap);
		val occ = Heap.create_array<bool>(cap);

		for (i in 0..<cap) occ[i] = false;
		return Self(keys, hashes, occ, 0, cap);
	}

	fn dist(val self, from: usz, to: usz): usz {
		if (to >= from) return to - from;
		return self.cap + to - from;
	}

	pub fn add(var self, key: T): bool {
		if (self.cap == 0 || self.len * 10 >= self.cap * 7) self.grow();

		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) return false;
			idx = (idx + 1) % self.cap;
		}

		self.keys[idx] = key;
		self.hashes[idx] = h;
		self.occupied[idx] = true;
		self.len++;
		return true;
	}

	pub fn remove(var self, key: T): bool {
		if (self.len == 0 || self.cap == 0) return false;

		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) {
				var i = idx;
				var j = (idx + 1) % self.cap;
				while (self.occupied[j]) {
					val k = self.hashes[j] % self.cap;
					if (self.dist(k, j) > self.dist(k, i)) {
						self.keys[i] = self.keys[j];
						self.hashes[i] = self.hashes[j];
						i = j;
					}
					j = (j + 1) % self.cap;
				}
				self.occupied[i] = false;
				self.len--;
				return true;
			}
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub fn clear(var self) {
		if (self.cap > 0) for (i in 0..<self.cap) self.occupied[i] = false;
		self.len = 0;
	}

	pub fn empty(val self) => self.len == 0;

	pub fn reserve(var self, min_elements: usz) {
		while (
			self.cap == 0
			|| min_elements * 10 >= self.cap * 7
		) self.grow();
	}

	pub fn extend(var self, other: Self) {
		if (other.cap == 0) return;
		for (i in 0..<other.cap) {
			if (other.occupied[i]) self.add(other.keys[i]);
		}
	}

	pub fn clone(val self): Self {
		val cap = if (self.cap >= 8) self.cap else 16;
		val keys = Heap.create_array<T>(cap);
		val hashes = Heap.create_array<usz>(cap);
		val occ = Heap.create_array<bool>(cap);
		for (i in 0..<cap) occ[i] = false;

		var res = Self(keys, hashes, occ, 0, cap);
		if (self.cap > 0) {
			for (i in 0..<self.cap) {
				if (self.occupied[i]) res.add(self.keys[i]);
			}
		}
		return res;
	}

	pub fn to_list(val self): List<T> {
		var res = List<T>();
		if (self.cap == 0) return res;

		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += self.keys[i];
		}
		return res;
	}

	fn grow(var self) {
		val old_cap = self.cap;
		val old_keys = self.keys;
		val old_hashes = self.hashes;
		val old_occ = self.occupied;

		val new_cap = if (old_cap < 8) 16 else old_cap * 2;
		val keys = Heap.create_array<T>(new_cap);
		val hashes = Heap.create_array<usz>(new_cap);
		val new_occ = Heap.create_array<bool>(new_cap);

		for (j in 0..<new_cap) new_occ[j] = false;

		if (old_cap > 0) {
			for (i in 0..<old_cap) {
				if (old_occ[i]) {
					val h = old_hashes[i];
					var idx = h % new_cap;
					while (new_occ[idx]) idx = (idx + 1) % new_cap;

					keys[idx] = old_keys[i];
					hashes[idx] = h;
					new_occ[idx] = true;
				}
			}

			Heap.free(old_keys);
			Heap.free(old_hashes);
			Heap.free(old_occ);
		}

		self.keys = keys;
		self.hashes = hashes;
		self.occupied = new_occ;
		self.cap = new_cap;
	}

	pub fn free(self) {
		if (self.cap > 0) {
			Heap.free(self.keys);
			Heap.free(self.hashes);
			Heap.free(self.occupied);
		}
	}

	pub op plus_assign(var self, key: T) => self.add(key);

	pub op contains(val self, key: T): bool {
		if (self.len == 0 || self.cap == 0) return false;
		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) return true;
			idx = (idx + 1) % self.cap;
		}

		return false;
	}

}

// `for (key in set)` walks the occupied set keys.
impl Iterable for HashSet<T: Hash> {

	pub fn count(val self) => self.len;

	pub fn at(val self, i: usz): T {
		var seen = 0;
		for (idx in 0..<self.cap) {
			if (self.occupied[idx]) {
				if (seen == i) return self.keys[idx];
				seen++;
			}
		}

		return self.keys[0];
	}

}
