mod std.collections.list;

use std.mem.alloc.*;

/*
	List<T> - dynamic array, heap-allocated

	C ABI layout:
		data:   &T  - pointer to heap of elements
		len:    usz - current element count
		cap:    usz - max capacity before need to realloc

	Usage:
		val list = new_list<i32>();
		list.add(42);
		val x = list.get(0);
		list.delete();
*/

pub struct List<T> {
	pub data: &T,
	pub len: usz,
	pub cap: usz
}

pub fn new_list<T>(): List<T> {
	val init_cap = 4UZ;
	val data = alloc_array<T>(init_cap);
	return List<T>(data, 0, init_cap);
}

pub fn list_with_capacity<T>(capacity: usz): List<T> {
	var cap = capacity;
	if (cap == 0) cap = 4;
	val data = alloc_array<T>(cap);
	return List<T>(data, 0, cap);
}

impl List<T> {
	pub fn get(val self, index: usz): T => self.data[index];

	pub fn first(val self): T => self.data[0];

	pub fn last(val self): T => self.data[self.len - 1];

	pub fn is_empty(val self) => self.len == 0;

	pub fn set(var self, index: usz, value: T) {
		self.data[index] = value;
	}

	pub fn add(var self, value: T) {
		if (self.len == self.cap) self.grow();
		self.data[self.len] = value;
		self.len = self.len + 1;
	}

	pub fn pop(var self): T {
		self.len = self.len - 1;
		return self.data[self.len];
	}

	pub fn clear(var self) {
		self.len = 0;
	}

	fn grow(var self) {
		val new_cap = self.cap * 2;
		self.data = resize<T>(self.data, new_cap);
		self.cap = new_cap;
	}

	pub fn reserve(var self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap = self.cap;
			while (new_cap < min_cap) {
				new_cap = new_cap * 2;
			}
			self.data = resize<T>(self.data, new_cap);
			self.cap = new_cap;
		}
	}

	// NOTE: block body instead of `=> raw_release(...)`:
	// v0 cannot resolve module-level `extern` fns from arrow bodies inside impl.
	pub fn delete(self) => release<T>(self.data);
}
