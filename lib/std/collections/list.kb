mod std.collections;

use std.memory.*;
use std.traits.*;

/*
	List<T> - dynamic array, heap-allocated

	C ABI layout:
		data:   &T  - pointer to heap of elements
		len:    usz - current element count
		cap:    usz - max capacity before need to realloc

	Usage:
		var list = List<i32>();
		defer list.free();
		list += 42;
		val x = list[0];
*/

// `cap` is private: another module cannot build a List from its fields and must
// go through a constructor (`List<T>()` or `List<T>(elements...)`).
//
// `data` and `len` stay `pub` on purpose: the `for (x in seq)` lowering reads
// `seq.len` / `seq.data` directly (see docs section 6.2), so they are part of
// the container iteration contract rather than private state.
pub struct List<T> {
	pub data: &T,
	pub len: usz,
	cap: usz
}

// `for (x in list)` support: `for` calls `count()` and `at(i)`.
impl Iterable for List<T> {
	pub fn count(*self) => self.len;

	pub fn at(*self, i: usz) => self.data[i];
}

impl List<T> {

	pub init(items: ..T) {
		val cap = if (items.len < 4) 4 else items.len;
		val buf = Heap.alloc<T>(cap);
		for (i in 0..<items.len) {
			buf[i] = items[i];
		}
		return Self(buf, items.len, cap);
	}

	pub fn first(*self) => self.data[0];

	pub fn last(*self) => self.data[self.len - 1];

	pub fn empty(*self) => self.len == 0;

	pub fn add(&self, value: T) {
		if (self.len == self.cap) self.grow();
		self.data[self.len] = value;
		self.len++;
	}

	pub fn pop(&self): T {
		self.len--;
		return self.data[self.len];
	}

	pub fn extend(&self, other: Self) {
		for (data in other) self += data;
	}

	pub fn clear(&self) => self.len = 0;

	fn grow(&self) {
		val new_cap = self.cap * 2;
		self.data = Heap.resize<T>(self.data, new_cap);
		self.cap = new_cap;
	}

	pub fn reserve(&self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap = self.cap;
			while (new_cap < min_cap) new_cap *= 2;
			self.data = Heap.resize<T>(self.data, new_cap);
			self.cap = new_cap;
		}
	}

	pub fn remove_at(&self, index: usz): T {
		val item = self.data[index];
		for (i in index..<(self.len - 1)) {
			self.data[i] = self.data[i + 1];
		}
		self.len--;
		return item;
	}

	pub fn insert(&self, index: usz, value: T) {
		if (self.len == self.cap) self.grow();
		var i = self.len;
		while (i > index) {
			self.data[i] = self.data[i - 1];
			i--;
		}
		self.data[index] = value;
		self.len++;
	}

	pub fn clone(*self): Self {
		val cap = if (self.cap > 0) self.cap else 4;
		var res = Self(Heap.alloc<T>(cap), 0, cap);
		for (data in self) res += data;
		return res;
	}

	pub fn pop_or(&self, value: T) => if (self.len == 0) value else self.pop();

	pub fn swap(&self, a: usz, b: usz) {
		val tmp = self.data[a];
		self.data[a] = self.data[b];
		self.data[b] = tmp;
	}

	pub fn reverse(&self) {
		if (self.len <= 1) return;
		var left = 0;
		var right = self.len - 1;
		while (left < right) {
			val tmp = self.data[left];
			self.data[left] = self.data[right];
			self.data[right] = tmp;
			left++;
			right--;
		}
	}

	pub fn sub(*self, start: usz, count: usz): Self {
		var res = Self(Heap.alloc<T>(count), 0, count);
		if (start >= self.len) return res;
		val end = if (start + count > self.len) self.len else start + count;
		for (i in start..<end) res += self.data[i];
		return res;
	}

	pub fn index_of(*self, value: T): isz {
		for (i in 0..<self.len) if (self.data[i] == value) return i;
		return -1;
	}

	pub fn last_index_of(*self, value: T): isz {
		if (self.len == 0) return -1;

		var i = self.len - 1;
		while (true) {
			if (self.data[i] == value) return i;
			if (i == 0) break;
			i--;
		}

		return -1;
	}

	pub fn index_where(*self, predicate: (T) -> bool): isz {
		for (i in 0..<self.len) if (predicate(self.data[i])) return i;
		return -1;
	}

	pub fn last_index_where(*self, predicate: (T) -> bool): isz {
		if (self.len == 0) return -1;

		var i = self.len - 1;
		while (true) {
			if (predicate(self.data[i])) return i;
			if (i == 0) break;
			i--;
		}

		return -1;
	}

	pub fn find_ptr(*self, predicate: (T) -> bool): *T? {
		for (i in 0..<self.len) if (predicate(self.data[i])) return &self.data[i];
		return null;
	}

	pub fn first_or(*self, default_val: T, predicate: (T) -> bool): T {
		for (data in self) if (predicate(data)) return data;
		return default_val;
	}

	pub fn remove(&self, value: T): bool {
		val idx = self.index_of(value);
		if (idx < 0) return false;
		self.remove_at(idx as usz);
		return true;
	}

	pub fn remove_all(&self, value: T) => self.remove_where { x -> x == value };

	pub fn remove_where(&self, predicate: (T) -> bool): usz {
		var write = 0;
		var removed = 0;
		for (i in 0..<self.len) {
			if (predicate(self.data[i])) removed++;
			else {
				if (write != i) self.data[write] = self.data[i];
				write++;
			}
		}

		self.len = write;
		return removed;
	}

	pub fn retain(&self, predicate: (T) -> bool): usz {
		var write = 0;
		var removed = 0;
		for (i in 0..<self.len) {
			if (predicate(self.data[i])) {
				if (write != i) self.data[write] = self.data[i];
				write++;
			} else removed++;
		}

		self.len = write;
		return removed;
	}

	pub fn each(*self, action: (T) -> none) {
		for (data in self) action(data);
	}

	pub fn filter(*self, predicate: (T) -> bool): List<T> {
		var res = List<T>();
		for (data in self) if (predicate(data)) res += data;
		return res;
	}

	pub fn any(*self, predicate: (T) -> bool): bool {
		for (data in self) if (predicate(data)) return true;
		return false;
	}

	pub fn all(*self, predicate: (T) -> bool): bool {
		for (data in self) if (!predicate(data)) return false;
		return true;
	}

	pub fn count_where(*self, predicate: (T) -> bool): usz {
		var n = 0;
		for (data in self) if (predicate(data)) n++;
		return n;
	}

	pub fn map<U>(*self, transform: (T) -> U): List<U> {
		var res = List<U>();
		for (data in self) res += transform(data);
		return res;
	}

	pub fn fold<U>(*self, initial: U, operation: (U, T) -> U): U {
		var acc = initial;
		for (data in self) acc = operation(acc, data);
		return acc;
	}

	pub fn free(self) => Heap.free(self.data);

	pub op get(*self, index: usz) => self.data[index];

	pub op contains(*self, value: T) => self.index_of(value) != -1;

	pub op set(&self, index: usz, value: T) => self.data[index] = value;

	pub op plus_assign(&self, value: T) => self.add(value);

}
