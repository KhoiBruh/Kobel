mod std.collections.list;

use std.mem.alloc.*;
use std.traits.iterable.Iterable;

/*
	List<T> - dynamic array, heap-allocated

	C ABI layout:
		data:   &T  - pointer to heap of elements
		len:    usz - current element count
		cap:    usz - max capacity before need to realloc

	Usage:
		var list = List<i32>();
		defer list.delete();
		list += 42;
		val x = list[0];
*/

// `cap` is private: another module cannot build a List from its fields and must
// go through a constructor (`List<T>()` or `List<T>(capacity)`).
//
// `data` and `len` stay `pub` on purpose: the `for (x in seq)` lowering reads
// `seq.len` / `seq.data` directly (see docs section 6.2), so they are part of
// the container iteration contract rather than private state.
pub struct List<T> {
	pub data: &T,
	pub len: usz,
	cap: usz
}

// `for (x in list)` support: `for` calls `count()` and `at(i)`.
impl Iterable for List<T> {
	pub fn count(val self) => self.len;

	pub fn at(val self, i: usz) => self.data[i];
}

impl List<T> {

	pub fn new(cap: usz = 4) => Self(alloc_array<T>(cap), 0, cap);

	pub op get(val self, index: usz) => self.data[index];

	pub fn first(val self) => self.data[0];

	pub fn last(val self) => self.data[self.len - 1];

	pub fn empty(val self) => self.len == 0;

	pub op set(var self, index: usz, value: T) => self.data[index] = value;

	pub op plus_assign(var self, value: T) => self.add(value);

	pub fn add(var self, value: T) {
		if (self.len == self.cap) self.grow();
		self.data[self.len] = value;
		self.len++;
	}

	pub fn pop(var self): T {
		self.len--;
		return self.data[self.len];
	}

	pub fn extend(var self, other: Self) {
		for (data in other) self += data;
	}

	pub fn clear(var self) => self.len = 0;

	fn grow(var self) {
		val new_cap = self.cap * 2;
		self.data = resize<T>(self.data, new_cap);
		self.cap = new_cap;
	}

	pub fn reserve(var self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap = self.cap;
			while (new_cap < min_cap) new_cap *= 2;
			self.data = resize<T>(self.data, new_cap);
			self.cap = new_cap;
		}
	}

	pub fn remove_at(var self, index: usz): T {
		val item = self.data[index];
		for (i in index..<(self.len - 1)) {
			self.data[i] = self.data[i + 1];
		}
		self.len--;
		return item;
	}

	pub fn insert(var self, index: usz, value: T) {
		if (self.len == self.cap) self.grow();
		var i = self.len;
		while (i > index) {
			self.data[i] = self.data[i - 1];
			i--;
		}
		self.data[index] = value;
		self.len++;
	}

	pub fn clone(val self): Self {
		val cap = if (self.cap > 0) self.cap else 4;
		var res = Self(alloc_array<T>(cap), 0, cap);
		for (i in 0..<self.len) res += self.data[i];
		return res;
	}

	pub fn pop_or(var self, value: T) => if (self.len == 0) value else self.pop();

	pub fn swap(var self, a: usz, b: usz) {
		val tmp = self.data[a];
		self.data[a] = self.data[b];
		self.data[b] = tmp;
	}

	pub fn reverse(var self) {
		if (self.len <= 1) return;
		var left = 0;
		var right = self.len - 1;
		while (left < right) {
			val tmp = self.data[left];
			self.data[left] = self.data[right];
			self.data[right] = tmp;
			left++;
			right--;
		}
	}

	pub fn sub(val self, start: usz, count: usz): Self {
		var res = Self(alloc_array<T>(count), 0, count);
		if (start >= self.len) return res;
		val end = if (start + count > self.len) self.len else start + count;
		for (i in start..<end) res += self.data[i];
		return res;
	}

	pub fn index_of(val self, value: T): isz {
		for (i in 0..<self.len) if (self.data[i] == value) return i;
		return -1;
	}

	pub fn last_index_of(val self, value: T): isz {
		if (self.len == 0) return -1;
		var i = self.len - 1;
		while (true) {
			if (self.data[i] == value) return i;
			if (i == 0) break;
			i--;
		}
		return -1;
	}

	pub op contains(val self, value: T) => self.index_of(value) != -1;

	pub fn remove(var self, value: T): bool {
		val idx = self.index_of(value);
		if (idx < 0) return false;
		self.remove_at(idx as usz);
		return true;
	}

	pub fn remove_all(var self, value: T): usz {
		var write = 0;
		var removed = 0;
		for (i in 0..<self.len) {
			if (self.data[i] == value) removed++;
			else {
				if (write != i) self.data[write] = self.data[i];
				write++;
			}
		}
		self.len = write;
		return removed;
	}

	pub fn delete(self) => release<T>(self.data);
}
