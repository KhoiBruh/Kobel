mod std.collections.list;

use std.mem.alloc.*;
use std.traits.new.New;

/*
	List<T> - dynamic array, heap-allocated

	C ABI layout:
		data:   &T  - pointer to heap of elements
		len:    usz - current element count
		cap:    usz - max capacity before need to realloc

	Usage:
		val list = new_list<i32>();
		list.add(42);
		val x = list.get(0);
		list.delete();
*/

// `cap` is private: another module cannot build a List from its fields and must
// go through a constructor (`List<T>()`, `List<T>(capacity)` or the
// `new_list<T>()` / `list_with_capacity<T>()` helpers).
//
// `data` and `len` stay `pub` on purpose: the `for (x in seq)` lowering reads
// `seq.len` / `seq.data` directly (see docs section 6.2), so they are part of
// the container iteration contract rather than private state.
pub struct List<T> {
	pub data: &T,
	pub len: usz,
	cap: usz
}

pub fn new_list<T>(): List<T> {
	val init_cap = 4UZ;
	val data = alloc_array<T>(init_cap);
	return List<T>(data, 0, init_cap);
}

pub fn list_with_capacity<T>(capacity: usz): List<T> {
	var cap = capacity;
	if (cap == 0) cap = 4;
	val data = alloc_array<T>(cap);
	return List<T>(data, 0, cap);
}

impl List<T> {
	pub fn get(val self, index: usz): T => self.data[index];

	pub fn first(val self): T => self.data[0];

	pub fn last(val self): T => self.data[self.len - 1];

	pub fn is_empty(val self) => self.len == 0;

	pub fn set(var self, index: usz, value: T) {
		self.data[index] = value;
	}

	pub fn add(var self, value: T) {
		if (self.len == self.cap) self.grow();
		self.data[self.len] = value;
		self.len = self.len + 1;
	}

	pub fn pop(var self): T {
		self.len = self.len - 1;
		return self.data[self.len];
	}

	pub fn clear(var self) {
		self.len = 0;
	}

	fn grow(var self) {
		val new_cap = self.cap * 2;
		self.data = resize<T>(self.data, new_cap);
		self.cap = new_cap;
	}

	pub fn reserve(var self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap = self.cap;
			while (new_cap < min_cap) {
				new_cap = new_cap * 2;
			}
			self.data = resize<T>(self.data, new_cap);
			self.cap = new_cap;
		}
	}

	// NOTE: block body instead of `=> raw_release(...)`:
	// v0 cannot resolve module-level `extern` fns from arrow bodies inside impl.
	pub fn delete(self) => release<T>(self.data);
}

// Kotlin-style constructors: `List<T>()` and `List<T>(capacity)`.
// This impl must come *after* the inherent one above: the seed compiler in use
// while bootstrapping picks only the first impl template per type, and it must
// be the one carrying the methods the compiler itself calls.
impl New for List<T> {
	pub fn new(): List<T> => Self(alloc_array<T>(4UZ), 0, 4UZ);

	pub fn new(capacity: usz): List<T> {
		var cap = capacity;
		if (cap == 0) cap = 4;
		return Self(alloc_array<T>(cap), 0, cap);
	}
}
