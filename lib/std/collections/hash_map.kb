mod std.collections.hash_map;

use std.mem.alloc.*;

// `len` is the public size accessor; the storage is internal.
pub struct HashMap<V> {
	keys: &str,
	values: &V,
	occupied: &bool,
	pub len: usz,
	cap: usz
}

impl HashMap<V> {
	pub fn new(): Self<V> {
		val init_cap = 16UZ;
		val keys = alloc_array<str>(init_cap);
		val values = alloc_array<V>(init_cap);
		val occ = alloc_array<bool>(init_cap);

		for (i in 0..<init_cap) occ[i] = false;
		return Self(keys, values, occ, 0, init_cap);
	}

	fn hash_key(val self, key: str): usz {
		var h = 5381UZ;
		for (i in 0..<key.len) {
			val c = key[i] as usz;
			h = h * 33 + c;
		}
		return h;
	}

	pub fn put(var self, key: str, value: V) {
		if (self.len * 10 >= self.cap * 7) self.grow();

		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) {
				self.values[idx] = value;
				return;
			}
			idx = (idx + 1) % self.cap;
		}

		self.keys[idx] = key;
		self.values[idx] = value;
		self.occupied[idx] = true;
		self.len++;
	}

	pub fn contains(val self, key: str): bool {
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return true;
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub fn get_or(val self, key: str, default_val: V): V {
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return default_val;
	}

	fn grow(var self) {
		val old_cap = self.cap;
		val old_keys = self.keys;
		val old_vals = self.values;
		val old_occ = self.occupied;

		val new_cap = old_cap * 2;
		val keys = alloc_array<str>(new_cap);
		val values = alloc_array<V>(new_cap);
		val new_occ = alloc_array<bool>(new_cap);

		for (j in 0..<new_cap) new_occ[j] = false;

		self.keys = keys;
		self.values = values;
		self.occupied = new_occ;
		self.cap = new_cap;
		self.len = 0;

		for (i in 0..<old_cap) {
			if (old_occ[i]) self.put(old_keys[i], old_vals[i]);
		}

		release<str>(old_keys);
		release<V>(old_vals);
		release<bool>(old_occ);
	}

	pub fn delete(self): none {
		release<str>(self.keys);
		release<V>(self.values);
		release<bool>(self.occupied);
	}
}
