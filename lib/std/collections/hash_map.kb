mod std.collections.hash_map;

use std.mem.alloc.*;

// `len` is the public size accessor; the storage is internal.
pub struct HashMap<V> {
	keys: &str,
	values: &V,
	occupied: &bool,
	pub len: usz,
	cap: usz
}

// Kotlin-style constructor: `HashMap<V>()`.
impl HashMap<V> {
	pub fn new(): HashMap<V> {
		val init_cap = 16UZ;
		val raw_keys = raw_alloc(init_cap * str.size());
		val raw_vals = raw_alloc(init_cap * V.size());
		val raw_occ = raw_alloc(init_cap * bool.size());

		val occ = raw_occ as &bool;
		for (i in 0..<init_cap) {
			occ[i] = false;
		}
		return Self(raw_keys as &str, raw_vals as &V, occ, 0, init_cap);
	}
}

impl HashMap<V> {
	fn hash_key(val self, key: str): usz {
		var h = 5381UZ;
		for (i in 0..<key.len) {
			val c = key[i] as usz;
			h = h * 33 + c;
		}
		return h;
	}

	pub fn put(var self, key: str, value: V): none {
		if (self.len * 10 >= self.cap * 7) self.grow();

		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) {
				self.values[idx] = value;
				return;
			}
			idx = (idx + 1) % self.cap;
		}

		self.keys[idx] = key;
		self.values[idx] = value;
		self.occupied[idx] = true;
		self.len++;
	}

	pub fn contains(val self, key: str): bool {
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return true;
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub fn get_or(val self, key: str, default_val: V): V {
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return default_val;
	}

	fn grow(var self): none {
		val old_cap = self.cap;
		val old_keys = self.keys;
		val old_vals = self.values;
		val old_occ = self.occupied;

		val new_cap = old_cap * 2;
		val raw_keys = raw_alloc(new_cap * str.size());
		val raw_vals = raw_alloc(new_cap * V.size());
		val raw_occ = raw_alloc(new_cap * bool.size());

		val new_occ = raw_occ as &bool;
		for (j in 0..<new_cap) {
			new_occ[j] = false;
		}

		self.keys = raw_keys as &str;
		self.values = raw_vals as &V;
		self.occupied = new_occ;
		self.cap = new_cap;
		self.len = 0;

		for (i in 0..<old_cap) {
			if (old_occ[i]) self.put(old_keys[i], old_vals[i]);
		}

		release<str>(old_keys);
		release<V>(old_vals);
		release<bool>(old_occ);
	}

	pub fn delete(self): none {
		release<str>(self.keys);
		release<V>(self.values);
		release<bool>(self.occupied);
	}
}
