mod std.collections;

use std.memory.*;
use std.traits.*;

// A hash map with generic key `K: Hash` and value `V`.
//
// Uses open-addressing with linear probing and Robin Hood backward-shift deletion
// to keep the probing sequence contiguous without tombstones.
pub struct HashMap<K: Hash, V> {
	keys: &K,
	values: &V,
	hashes: &usz,
	occupied: &bool,
	pub len: usz = 0,
	cap: usz = 0
}

impl HashMap<K: Hash, V> {

	pub init(init_cap: usz = 16) {
		var cap = init_cap;
		if (cap < 8) cap = 8;
		val keys = Heap.create_array<K>(cap);
		val values = Heap.create_array<V>(cap);
		val hashes = Heap.create_array<usz>(cap);
		val occ = Heap.create_array<bool>(cap);

		for (i in 0..<cap) occ[i] = false;
		return Self(keys, values, hashes, occ, 0, cap);
	}

	fn dist(val self, from: usz, to: usz): usz {
		if (to >= from) return to - from;
		return self.cap + to - from;
	}

	pub fn get_or(val self, key: K, value: V): V {
		if (self.len == 0 || self.cap == 0) return value;
		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) return self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return value;
	}

	pub fn remove(var self, key: K): bool {
		if (self.len == 0 || self.cap == 0) return false;

		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) {
				var i = idx;
				var j = (idx + 1) % self.cap;
				while (self.occupied[j]) {
					val k = self.hashes[j] % self.cap;
					if (self.dist(k, i) < self.dist(k, j)) {
						self.keys[i] = self.keys[j];
						self.values[i] = self.values[j];
						self.hashes[i] = self.hashes[j];
						i = j;
					}
					j = (j + 1) % self.cap;
				}
				self.occupied[i] = false;
				self.len--;
				return true;
			}
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub fn clear(var self) {
		if (self.cap <= 0) return;
		for (i in 0..<self.cap) self.occupied[i] = false;
		self.len = 0;
	}

	pub fn empty(val self) => self.len == 0;

	pub fn keys(val self): List<K> {
		var res = List<K>();
		if (self.cap == 0) return res;
		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += self.keys[i];
		}
		return res;
	}

	pub fn values(val self): List<V> {
		var res = List<V>();
		if (self.cap == 0) return res;
		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += self.values[i];
		}
		return res;
	}

	pub fn entries(val self): List<MapEntry<K, V>> {
		var res = List<MapEntry<K, V>>();
		if (self.cap == 0) return res;
		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += MapEntry<K, V>(self.keys[i], self.values[i]);
		}
		return res;
	}

	fn grow(var self) {
		val old_cap = self.cap;
		val old_keys = self.keys;
		val old_vals = self.values;
		val old_hashes = self.hashes;
		val old_occ = self.occupied;

		val new_cap = if (old_cap < 8) 16 else old_cap * 2;
		val keys = Heap.create_array<K>(new_cap);
		val values = Heap.create_array<V>(new_cap);
		val hashes = Heap.create_array<usz>(new_cap);
		val new_occ = Heap.create_array<bool>(new_cap);

		for (j in 0..<new_cap) new_occ[j] = false;

		if (old_cap > 0) {
			for (i in 0..<old_cap) {
				if (old_occ[i]) {
					val h = old_hashes[i];
					var idx = h % new_cap;
					while (new_occ[idx]) {
						idx = (idx + 1) % new_cap;
					}
					keys[idx] = old_keys[i];
					values[idx] = old_vals[i];
					hashes[idx] = h;
					new_occ[idx] = true;
				}
			}
			Heap.free(old_keys);
			Heap.free(old_vals);
			Heap.free(old_hashes);
			Heap.free(old_occ);
		}

		self.keys = keys;
		self.values = values;
		self.hashes = hashes;
		self.occupied = new_occ;
		self.cap = new_cap;
	}

	pub fn free(self) {
		if (self.cap > 0) {
			Heap.free(self.keys);
			Heap.free(self.values);
			Heap.free(self.hashes);
			Heap.free(self.occupied);
		}
	}

	// ========================================================================
	// Overloaded Operators (placed at the end, after regular functions)
	// ========================================================================

	pub op set(var self, key: K, value: V) {
		if (self.cap == 0 || self.len * 10 >= self.cap * 7) self.grow();

		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) {
				self.values[idx] = value;
				return;
			}
			idx = (idx + 1) % self.cap;
		}

		self.keys[idx] = key;
		self.values[idx] = value;
		self.hashes[idx] = h;
		self.occupied[idx] = true;
		self.len++;
	}

	pub op get(val self, key: K): *V? {
		if (self.len == 0 || self.cap == 0) return null;
		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) return &self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return null;
	}

	pub op contains(val self, key: K): bool {
		if (self.len == 0 || self.cap == 0) return false;
		val h = key.hash();
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.hashes[idx] == h && self.keys[idx] == key) return true;
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

}

pub struct MapEntry<K, V> {
	pub key: K,
	pub value: V
}

impl MapEntry<K, V> {

	pub init(key: K, value: V) => Self(key, value);

	pub op unpack(val self, k: &K, v: &V) {
		k.write(self.key);
		v.write(self.value);
	}

}

impl Iterable for HashMap<K: Hash, V> {

	pub fn count(val self) => self.len;

	pub fn at(val self, i: usz): MapEntry<K, V> {
		var seen: usz = 0;
		for (idx in 0..<self.cap) {
			if (self.occupied[idx]) {
				if (seen == i) return MapEntry<K, V>(self.keys[idx], self.values[idx]);
				seen++;
			}
		}
		return MapEntry<K, V>(self.keys[0], self.values[0]);
	}

}

