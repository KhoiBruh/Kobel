mod std.collections.hash_map;

use std.mem.alloc.*;
use std.collections.list.List;

// `len` is the public size accessor; the storage is internal.
pub struct HashMap<V> {
	keys: &str,
	values: &V,
	occupied: &bool,
	pub len: usz = 0,
	cap: usz = 0
}

impl HashMap<V> {
	pub fn new(init_cap: usz = 16): Self<V> {
		var cap = init_cap;
		if (cap < 8) cap = 8;
		val keys = alloc_array<str>(cap);
		val values = alloc_array<V>(cap);
		val occ = alloc_array<bool>(cap);

		for (i in 0..<cap) occ[i] = false;
		return Self(keys, values, occ, 0, cap);
	}

	fn hash_key(val self, key: str): usz {
		var h: usz = 5381;
		for (i in 0..<key.len) {
			val c = key[i] as usz;
			h = h * 33 + c;
		}
		return h;
	}

	fn dist(val self, from: usz, to: usz): usz {
		if (to >= from) return to - from;
		return self.cap + to - from;
	}

	pub fn put(var self, key: str, value: V) {
		if (self.cap == 0 || self.len * 10 >= self.cap * 7) self.grow();

		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) {
				self.values[idx] = value;
				return;
			}
			idx = (idx + 1) % self.cap;
		}

		self.keys[idx] = key;
		self.values[idx] = value;
		self.occupied[idx] = true;
		self.len++;
	}

	pub op set(var self, key: str, value: V) => self.put(key, value);

	pub op contains(val self, key: str): bool {
		if (self.len == 0 || self.cap == 0) return false;
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return true;
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub op get(val self, key: str): *V {
		if (self.len == 0 || self.cap == 0) return null;
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return &self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return null;
	}

	pub fn get_or(val self, key: str, default_val: V): V {
		if (self.len == 0 || self.cap == 0) return default_val;
		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) return self.values[idx];
			idx = (idx + 1) % self.cap;
		}
		return default_val;
	}

	pub fn remove(var self, key: str): bool {
		if (self.len == 0 || self.cap == 0) return false;

		val h = self.hash_key(key);
		var idx = h % self.cap;

		while (self.occupied[idx]) {
			if (self.keys[idx] == key) {
				var i = idx;
				var j = (idx + 1) % self.cap;
				while (self.occupied[j]) {
					val k = self.hash_key(self.keys[j]) % self.cap;
					if (self.dist(k, i) < self.dist(k, j)) {
						self.keys[i] = self.keys[j];
						self.values[i] = self.values[j];
						i = j;
					}
					j = (j + 1) % self.cap;
				}
				self.occupied[i] = false;
				self.len--;
				return true;
			}
			idx = (idx + 1) % self.cap;
		}
		return false;
	}

	pub fn clear(var self) {
		if (self.cap > 0) {
			for (i in 0..<self.cap) self.occupied[i] = false;
		}
		self.len = 0;
	}

	pub fn empty(val self) => self.len == 0;

	pub fn count(val self) => self.len;

	pub fn keys(val self): List<str> {
		var res = List<str>();
		if (self.cap == 0) return res;
		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += self.keys[i];
		}
		return res;
	}

	pub fn values(val self): List<V> {
		var res = List<V>();
		if (self.cap == 0) return res;
		for (i in 0..<self.cap) {
			if (self.occupied[i]) res += self.values[i];
		}
		return res;
	}

	fn grow(var self) {
		val old_cap = self.cap;
		val old_keys = self.keys;
		val old_vals = self.values;
		val old_occ = self.occupied;

		val new_cap = if (old_cap < 8) 16 else old_cap * 2;
		val keys = alloc_array<str>(new_cap);
		val values = alloc_array<V>(new_cap);
		val new_occ = alloc_array<bool>(new_cap);

		for (j in 0..<new_cap) new_occ[j] = false;

		self.keys = keys;
		self.values = values;
		self.occupied = new_occ;
		self.cap = new_cap;
		self.len = 0;

		if (old_cap > 0) {
			for (i in 0..<old_cap) {
				if (old_occ[i]) self[old_keys[i]] = old_vals[i];
			}
			release<str>(old_keys);
			release<V>(old_vals);
			release<bool>(old_occ);
		}
	}

	pub fn delete(self): none {
		if (self.cap > 0) {
			release<str>(self.keys);
			release<V>(self.values);
			release<bool>(self.occupied);
		}
	}
}
