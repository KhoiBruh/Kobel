mod std.collections.ptr_map;

use std.collections.list.List;
use std.collections.hash_map.HashMap;

// A pointer-keyed map implemented over generic `HashMap<usz, V>`.
//
// Callers can pass raw or typed pointers (`node as *u8`) as keys.
// Address hashing and pointer equality are handled via the underlying integer map.
pub struct PtrMap<V> {
	inner: HashMap<usz, V>,
	pub len: usz = 0
}

impl PtrMap<V> {
	pub fn new(init_cap: usz = 8): Self<V> => Self(HashMap<usz, V>(init_cap), 0UZ);

	pub fn put(var self, key: *u8, value: V) {
		self.inner.put(key as usz, value);
		self.len = self.inner.len;
	}

	pub fn contains(val self, key: *u8): bool => self.inner.contains(key as usz);

	pub fn get_or(val self, key: *u8, default_val: V): V => self.inner.get_or(key as usz, default_val);

	pub fn remove(var self, key: *u8): bool {
		val ok = self.inner.remove(key as usz);
		self.len = self.inner.len;
		return ok;
	}

	pub fn clear(var self) {
		self.inner.clear();
		self.len = 0UZ;
	}

	pub fn empty(val self): bool => self.len == 0UZ;

	pub fn count(val self): usz => self.len;

	pub fn keys(val self): List<*u8> {
		var res = List<*u8>();
		val u_keys = self.inner.keys();
		for (i in 0..<u_keys.len) {
			res += u_keys[i] as *u8;
		}
		return res;
	}

	pub fn values(val self): List<V> => self.inner.values();

	pub fn delete(self): none => self.inner.delete();

	// ========================================================================
	// Overloaded Operators (placed at the end, after regular functions)
	// ========================================================================

	pub op get(val self, key: *u8): *V => self.inner.get(key as usz);

	pub op set(var self, key: *u8, value: V) => self.put(key, value);

	pub op contains(val self, key: *u8): bool => self.contains(key);
}
