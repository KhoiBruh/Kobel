mod std.filesystem;

use std.collections.List;
use std.memory.*;
use std.string.str_from_bytes;
use std.traits.Stringer;

/*
 * ============================================================================
 * std.filesystem.path — file system path manipulation and filesystem operations
 *
 * `Path` wraps a `str` and provides zero-cost path manipulation methods along
 * with filesystem queries (exists, is_dir, is_file), directory creation,
 * text reading/writing, and stream opening.
 * ============================================================================
 */

extern "C" {
	fn kobel_list_dir(dir_path: str): str;
	fn kobel_path_exists(path: str): i32;
	fn kobel_path_is_dir(path: str): i32;
	fn kobel_path_is_file(path: str): i32;
	fn kobel_create_dir(dir_path: str): i32;
	fn kobel_create_dir_all(dir_path: str): i32;
}

pub fn str_is_sep(c: char) => c == '/' || c == '\\';

// Path-byte remap: every `from` byte becomes `to`, and A-Z lowercases when
// `fold_case` (only `normalize_path` needs that).
fn remap_path_bytes(s: str, from: char, to: char, fold_case: bool): str {
	val buf = Heap.create_array<u8>(s.len + 1);
	for (i in 0..<s.len) {
		val c = s[i];
		buf[i] = when {
			c == from -> to.code();
			fold_case && c >= 'A' && c <= 'Z' -> c.code() + 32;
			else -> c.code();
		};
	}

	buf[s.len] = 0;
	return str_from_bytes(buf, s.len);
}

impl str {

	// Directory part of a path ("" when the path has no separator).
	pub fn dir_of(val self): str {
		var last: usz = 0;
		var found = false;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) {
				last = i;
				found = true;
			}
		}

		if (!found) {
			return "";
		}
		return self.slice(0, last);
	}

	// File name part of a path (input with separators included).
	pub fn base_name(val self): str {
		var start: usz = 0;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) {
				start = i + 1;
			}
		}

		return self.slice(start);
	}

	// Joins a directory and a relative path with a single '/' separator.
	pub fn join_path(val self, rel: str): str {
		if (self.empty()) {
			return rel;
		}
		if (str_is_sep(self[self.len - 1])) {
			return "${self}${rel}";
		}
		return "${self}/${rel}";
	}

	pub fn normalize_path(val self) => remap_path_bytes(self, '\\', '/', true);

	// Converts '/' to '\\' for Windows tools (cmd, del, etc.)
	pub fn to_win_path(val self) => remap_path_bytes(self, '/', '\\', false);

	// Converts '\\' to '/' for cross-platform and POSIX path representations
	pub fn to_posix_path(val self) => remap_path_bytes(self, '\\', '/', false);

}

pub struct Path {
	pub raw: str
}

impl Path {

	pub init(raw: str) => Self(raw);

	pub fn is_sep(c: char) => str_is_sep(c);

	pub fn c_str(val self) => self.raw.c_str();

	pub fn empty(val self) => self.raw.empty();

	pub fn len(val self) => self.raw.len;

	// Directory part of the path ("" when no separator is found).
	pub fn parent(val self): Path => Path(self.raw.dir_of());

	// File name part of the path including extension ("main.kb" from "src/main.kb").
	pub fn file_name(val self): str => self.raw.base_name();

	// Extension without the leading dot ("kb" from "src/main.kb", "" if none).
	pub fn extension(val self): str {
		val fname = self.file_name();
		var last_dot: usz = 0;
		var found = false;
		for (i in 0..<fname.len) {
			if (fname[i] == '.') {
				last_dot = i;
				found = true;
			}
		}

		if (!found || last_dot == 0 || last_dot == fname.len - 1) {
			return "";
		}
		return fname.slice(last_dot + 1);
	}

	// File name without the trailing extension ("main" from "src/main.kb").
	pub fn stem(val self): str {
		val fname = self.file_name();
		var last_dot: usz = 0;
		var found = false;
		for (i in 0..<fname.len) {
			if (fname[i] == '.') {
				last_dot = i;
				found = true;
			}
		}

		if (!found || last_dot == 0) {
			return fname;
		}
		return fname.slice(0, last_dot);
	}

	// Joins two path segments with a normalized '/' separator.
	pub fn join(val self, part: str): Path {
		if (self.raw.empty()) {
			return Path(part);
		}

		if (part.empty()) {
			return Path(self.raw);
		}

		if (str_is_sep(self.raw[self.raw.len - 1]) || str_is_sep(part[0])) {
			if (
				str_is_sep(self.raw[self.raw.len - 1]) &&
				str_is_sep(part[0])
			) {
				return Path(self.raw + part.slice(1));
			}

			return Path(self.raw + part);
		}

		return Path("${self.raw}/${part}");
	}

	pub fn join_path(val self, other: Path): Path => self.join(other.raw);

	pub fn to_win_path(val self): Path => Path(self.raw.to_win_path());

	pub fn to_posix_path(val self): Path => Path(self.raw.to_posix_path());

	pub fn normalize(val self): Path => Path(self.raw.normalize_path());

	// ------------------------------------------------------------------------
	// Filesystem state queries
	// ------------------------------------------------------------------------

	pub fn exists(val self): bool => kobel_path_exists(self.raw) != 0;

	pub fn is_dir(val self): bool => kobel_path_is_dir(self.raw) != 0;

	pub fn is_file(val self): bool => kobel_path_is_file(self.raw) != 0;

	// ------------------------------------------------------------------------
	// Filesystem directory manipulation
	// ------------------------------------------------------------------------

	pub fn create_dir(val self): bool => kobel_create_dir(self.raw) != 0;

	pub fn create_dir_all(val self): bool => kobel_create_dir_all(self.raw) != 0;

	pub fn remove(val self): bool => remove(self.raw.c_str()) == 0;

	pub fn rename_to(val self, target: Path): bool {
		if (target.exists()) {
			target.remove();
		}
		return rename(self.raw.c_str(), target.raw.c_str()) == 0;
	}

	// Directory entries listing returning List<Path>
	pub fn entries(val self): List<Path> {
		val raw = kobel_list_dir(self.raw);
		if (raw.empty()) {
			return List<Path>();
		}

		var res = List<Path>();
		var start: usz = 0;
		for (i in 0..<raw.len) {
			if (raw[i] == '\n') {
				if (i > start) {
					res += Path(raw.slice(start, i));
				}
				start = i + 1;
			}
		}

		if (start < raw.len) {
			res += Path(raw.slice(start, raw.len));
		}
		return res;
	}

	// Legacy static helper for directory listing
	pub fn list_dir(path: str): List<str> {
		val raw = kobel_list_dir(path);
		if (raw.empty()) {
			return List<str>();
		}

		var res = List<str>();
		var start: usz = 0;
		for (i in 0..<raw.len) {
			if (raw[i] == '\n') {
				if (i > start) {
					res += raw.slice(start, i);
				}
				start = i + 1;
			}
		}

		if (start < raw.len) {
			res += raw.slice(start, raw.len);
		}
		return res;
	}

	// ------------------------------------------------------------------------
	// High-level text I/O operations
	// ------------------------------------------------------------------------

	pub fn read_text(val self): str => File.read(self.raw);

	pub fn write_text(val self, content: str): bool => File.write(self.raw, content);

	pub fn append_text(val self, content: str): bool => File.append(self.raw, content);

	// ------------------------------------------------------------------------
	// Stream factory
	// ------------------------------------------------------------------------

	pub fn open_read(val self): File => File.open_read(self.raw);

	pub fn open_write(val self): File => File.open_write(self.raw);

	pub fn open_append(val self): File => File.open_append(self.raw);

}

impl Stringer for Path {
	fn to_str(val self) => self.raw;
}
