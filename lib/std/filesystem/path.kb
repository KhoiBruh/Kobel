mod std.filesystem;

use std.collections.List;
use std.memory.*;
use std.string.str_from_bytes;
use std.traits.Stringer;

/*
 * ============================================================================
 * std.filesystem.path — file system path manipulation and filesystem operations
 *
 * `Path` wraps a `str` and provides zero-cost path manipulation methods along
 * with filesystem queries (exists, is_dir, is_file), directory creation,
 * directory listing, text reading/writing, and stream opening.
 * ============================================================================
 */

extern "C" {
	fn kobel_list_dir(dir_path: str): str;
	fn kobel_path_exists(path: str): i32;
	fn kobel_path_is_dir(path: str): i32;
	fn kobel_path_is_file(path: str): i32;
	fn kobel_create_dir(dir_path: str): i32;
	fn kobel_create_dir_all(dir_path: str): i32;
}

pub fn str_is_sep(c: char) => when (c) {
	'/', '\\' -> true;
	else -> false;
};

// Path-byte remap: every `from` byte becomes `to`, and A-Z lowercases when
// `fold_case` (only `normalize_path` needs that).
fn remap_path_bytes(s: str, from: char, to: char, fold_case: bool): str =>
	s.map_chars { c ->
		yield when {
			c == from -> to;
			fold_case && c in 'A'..'Z' -> char(c.code() + 32);
			else -> c;
		};
	};

impl str {

	// Directory part of a path ("" when the path has no separator).
	pub fn dir_of(*self): str {
		val last = self.last_index_where { c -> str_is_sep(c) };
		if (last < 0) return "";
		return self.slice(0, last as usz);
	}

	// File name part of a path (input with separators included).
	pub fn base_name(*self): str {
		val last = self.last_index_where { c -> str_is_sep(c) };
		if (last < 0) return self;
		return self.slice((last + 1) as usz);
	}

	// Joins a directory and a relative path with a single '/' separator.
	pub fn join_path(*self, rel: str): str {
		if (self.empty()) return rel;
		if (str_is_sep(self[self.len - 1])) return "${self}${rel}";
		return "${self}/${rel}";
	}

	pub fn normalize_path(*self) => remap_path_bytes(self, '\\', '/', true);

	// Converts '/' to '\\' for Windows tools (cmd, del, etc.)
	pub fn to_win_path(*self) => remap_path_bytes(self, '/', '\\', false);

	// Converts '\\' to '/' for cross-platform and POSIX path representations
	pub fn to_posix_path(*self) => remap_path_bytes(self, '\\', '/', false);

}

pub struct Path {
	pub raw: str
}

impl Path {

	pub fn is_sep(c: char) => str_is_sep(c);

	pub fn c_str(*self) => self.raw.c_str();

	pub fn empty(*self) => self.raw.empty();

	pub fn len(*self) => self.raw.len;

	// Directory part of the path ("" when no separator is found).
	pub fn parent(*self) => Path(self.raw.dir_of());

	// File name part of the path including extension ("main.kb" from "src/main.kb").
	pub fn file_name(*self) => self.raw.base_name();

	// Extension without the leading dot ("kb" from "src/main.kb", "" if none).
	pub fn extension(*self): str {
		val fname = self.file_name();
		val last_dot = fname.last_index_where { c -> c == '.' };
		if (last_dot <= 0 || (last_dot as usz) == fname.len - 1) return "";
		return fname.slice((last_dot + 1) as usz);
	}

	// File name without the trailing extension ("main" from "src/main.kb").
	pub fn stem(*self): str {
		val fname = self.file_name();
		val last_dot = fname.last_index_where { c -> c == '.' };
		if (last_dot <= 0) return fname;
		return fname.slice(0, last_dot as usz);
	}

	// Joins two path segments with a normalized '/' separator.
	pub fn join(*self, part: str): Path {
		if (self.raw.empty()) return Path(part);

		if (part.empty()) return Path(self.raw);

		if (str_is_sep(self.raw[self.raw.len - 1]) || str_is_sep(part[0])) {
			if (
				str_is_sep(self.raw[self.raw.len - 1]) &&
				str_is_sep(part[0])
			) return Path(self.raw + part.slice(1));

			return Path(self.raw + part);
		}

		return Path("${self.raw}/${part}");
	}

	pub fn join_path(*self, other: Path) => self.join(other.raw);

	pub fn to_win_path(*self) => Path(self.raw.to_win_path());

	pub fn to_posix_path(*self) => Path(self.raw.to_posix_path());

	pub fn normalize(*self) => Path(self.raw.normalize_path());

	// ------------------------------------------------------------------------
	// Filesystem state queries
	// ------------------------------------------------------------------------

	pub fn exists(*self) => kobel_path_exists(self.raw) != 0;

	pub fn is_dir(*self) => kobel_path_is_dir(self.raw) != 0;

	pub fn is_file(*self) => kobel_path_is_file(self.raw) != 0;

	// ------------------------------------------------------------------------
	// Filesystem directory manipulation
	// ------------------------------------------------------------------------

	pub fn create_dir(*self) => kobel_create_dir(self.raw) != 0;

	pub fn create_dir_all(*self) => kobel_create_dir_all(self.raw) != 0;

	pub fn remove(*self) => remove(self.raw.c_str()) == 0;

	pub fn rename_to(*self, target: Path): bool {
		if (target.exists()) target.remove();
		return rename(self.raw.c_str(), target.raw.c_str()) == 0;
	}

	// Directory listing returning list of filename strings
	pub fn list_dir(*self): List<str> {
		val raw = kobel_list_dir(self.raw);
		if (raw.empty()) return List<str>();

		var res = List<str>();
		var start = 0;
		for (i in 0..<raw.len) {
			if (raw[i] == '\n') {
				if (i > start) res += raw.slice(start, i);
				start = i + 1;
			}
		}

		if (start < raw.len) res += raw.slice(start, raw.len);
		return res;
	}

	// Directory entries listing returning List<Path>
	pub fn entries(*self): List<Path> {
		val names = self.list_dir();
		defer names.free();

		return names.map { name -> self.join(name) };
	}

	// ------------------------------------------------------------------------
	// High-level text I/O operations
	// ------------------------------------------------------------------------

	pub fn read_text(*self): str {
		val f = fopen(self.raw.c_str(), "rb");
		if (f == null) return "";

		fseek(f, 0, 2);
		val size_i64 = ftell(f);
		if (size_i64 <= 0) {
			fclose(f);
			return "";
		}

		fseek(f, 0, 0);
		val sz = size_i64 as usz;
		val buf = Heap.alloc<u8>(sz + 1);
		if (buf == null) {
			fclose(f);
			return "";
		}

		val read_bytes = fread(buf, 1, sz, f);
		fclose(f);
		buf[read_bytes] = 0;

		return str_from_bytes(buf, read_bytes);
	}

	pub fn write_text(*self, content: str): bool {
		val f = fopen(self.raw.c_str(), "wb");
		if (f == null) return false;
		val written = fwrite(content.data, 1, content.len, f);
		fclose(f);
		return written == content.len;
	}

	pub fn append_text(*self, content: str): bool {
		val f = fopen(self.raw.c_str(), "ab") ?: return false;
		val written = fwrite(content.data, 1, content.len, f);
		fclose(f);
		return written == content.len;
	}

	// ------------------------------------------------------------------------
	// Stream factory
	// ------------------------------------------------------------------------

	pub fn open_read(*self) => File.open(self.raw, "rb");

	pub fn open_write(*self) => File.open(self.raw, "wb");

	pub fn open_append(*self) => File.open(self.raw, "ab");

}

impl Stringer for Path {
	fn to_str(*self) => self.raw;
}
