mod std.filesystem;

use std.string.str_from_bytes;
use std.mem.alloc_array;
use std.collections.List;

/*
 * ============================================================================
 * std.filesystem.file — file I/O operations and handle wrapper
 * ============================================================================
 */

extern "C" {
	fn kobel_list_dir(dir_path: str): str;
}

extern "libc" {
	fn fopen(filename: *char, mode: *char): *none;
	fn fclose(stream: *none?): i32;
	fn fread(ptr: &u8, size: usz, count: usz, stream: *none?): usz;
	fn fwrite(ptr: *char, size: usz, count: usz, stream: *none?): usz;
	fn fseek(stream: *none?, offset: i64, origin: i32): i32;
	fn ftell(stream: *none?): i64;
	fn fflush(stream: *none?): i32;
	fn remove(filename: *char): i32;
}

pub struct File {
	pub handle: *none?
}

pub fn file_open(path: str, mode: str): File {
	val f = fopen(path.c_str(), mode.c_str());
	return File(f);
}

pub fn file_open_read(path: str): File => file_open(path, "rb");

pub fn file_open_write(path: str): File => file_open(path, "wb");

pub fn file_open_append(path: str): File => file_open(path, "ab");

pub fn file_exists(path: str): bool {
	val f = fopen(path.c_str(), "rb");
	if (f == null) return false;
	fclose(f);
	return true;
}

pub fn file_remove(path: str): bool => remove(path.c_str()) == 0;

pub fn file_read(path: str): str {
	val f = fopen(path.c_str(), "rb");
	if (f == null) return "";

	fseek(f, 0, 2);
	val size_i64 = ftell(f);
	if (size_i64 <= 0) {
		fclose(f);
		return "";
	}

	fseek(f, 0, 0);
	val sz = size_i64 as usz;
	val buf = alloc_array<u8>(sz + 1);
	if (buf == null) {
		fclose(f);
		return "";
	}

	val read_bytes = fread(buf, 1, sz, f);
	fclose(f);
	buf[read_bytes] = 0;

	return str_from_bytes(buf, read_bytes);
}

pub fn file_write(path: str, content: str): bool {
	val f = fopen(path.c_str(), "wb");
	if (f == null) return false;
	val written = fwrite(content.data, 1, content.len, f);
	fclose(f);
	return written == content.len;
}

pub fn file_append(path: str, content: str): bool {
	val f = fopen(path.c_str(), "ab");
	if (f == null) return false;
	val written = fwrite(content.data, 1, content.len, f);
	fclose(f);
	return written == content.len;
}

pub fn file_list_dir(path: str): List<str> {
	val raw = kobel_list_dir(path);
	if (raw.empty()) return List();
	var res = List<str>();
	var start: usz = 0;
	for (i in 0..<raw.len) {
		if (raw[i] == '\n') {
			if (i > start) {
				res += raw.slice(start, i);
			}
			start = i + 1;
		}
	}
	if (start < raw.len) {
		res += raw.slice(start, raw.len);
	}
	return res;
}

impl File {
	pub fn is_valid(val self): bool => self.handle != null;

	pub fn close(var self) {
		if (self.handle != null) {
			fclose(self.handle);
			self.handle = null;
		}
	}

	pub fn flush(val self) {
		if (self.handle != null) fflush(self.handle);
	}

	pub fn size(val self): i64 {
		if (self.handle == null) return 0;
		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);
		val total = ftell(self.handle);
		fseek(self.handle, cur, 0);
		return total;
	}

	pub fn write(val self, content: str): bool {
		if (self.handle == null) return false;
		val written = fwrite(content.data, 1, content.len, self.handle);
		return written == content.len;
	}

	pub fn read_all(val self): str {
		if (self.handle == null) return "";
		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);
		val end_pos = ftell(self.handle);
		if (end_pos <= cur) {
			fseek(self.handle, cur, 0);
			return "";
		}
		fseek(self.handle, cur, 0);

		val sz = (end_pos - cur) as usz;
		val buf = alloc_array<u8>(sz + 1);
		if (buf == null) return "";

		val read_bytes = fread(buf, 1, sz, self.handle);
		buf[read_bytes] = 0;
		return str_from_bytes(buf, read_bytes);
	}
}
