mod std.filesystem;

use std.string.str_from_bytes;
use std.memory.*;

/*
 * ============================================================================
 * std.filesystem.file — file I/O stream handle wrapper and streaming operations
 * ============================================================================
 */

extern "libc" {
	fn fopen(filename: *char, mode: *char): *none;
	fn fclose(stream: ?*none): i32;
	fn fread(ptr: &u8, size: usz, count: usz, stream: ?*none): usz;
	fn fwrite(ptr: *char, size: usz, count: usz, stream: ?*none): usz;
	fn fseek(stream: ?*none, offset: i64, origin: i32): i32;
	fn ftell(stream: ?*none): i64;
	fn fflush(stream: ?*none): i32;
	fn remove(filename: *char): i32;
	fn rename(old_filename: *char, new_filename: *char): i32;
}

pub struct File {
	pub handle: ?*none
}

impl File {

	pub fn open(path: str, mode: str): File {
		val f = fopen(path.c_str(), mode.c_str());
		return File(f);
	}

	// ------------------------------------------------------------------------
	// Instance methods on File handle
	// ------------------------------------------------------------------------

	pub fn is_valid(*self) => self.handle != null;

	pub fn close(&self) {
		if (self.handle != null) {
			fclose(self.handle);
			self.handle = null;
		}
	}

	pub fn flush(*self) {
		if (self.handle != null) fflush(self.handle);
	}

	pub fn seek(*self, offset: i64, origin: i32) => fseek(self.handle, offset, origin);

	pub fn tell(*self) => ftell(self.handle);

	pub fn size(*self): i64 {
		if (self.handle == null) return 0;

		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);

		val total = ftell(self.handle);
		fseek(self.handle, cur, 0);

		return total;
	}

	pub fn write_all(*self, content: str): bool {
		if (self.handle == null) return false;
		val written = fwrite(content.data, 1, content.len, self.handle);
		return written == content.len;
	}

	pub fn read_all(*self): str {
		if (self.handle == null) return "";

		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);
		val end_pos = ftell(self.handle);
		if (end_pos <= cur) {
			fseek(self.handle, cur, 0);
			return "";
		}

		fseek(self.handle, cur, 0);

		val size = end_pos - cur;
		val buf = Heap.create<u8>(size + 1) ?: return "";

		val read_bytes = fread(buf, 1, size, self.handle);
		buf[read_bytes] = 0;

		return str_from_bytes(buf, read_bytes);
	}

}
