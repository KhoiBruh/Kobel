mod std.filesystem;

use std.string.str_from_bytes;
use std.memory.*;

/*
 * ============================================================================
 * std.filesystem.file — file I/O stream handle wrapper and streaming operations
 * ============================================================================
 */

extern "libc" {
	fn fopen(filename: *char, mode: *char): *none;
	fn fclose(stream: *none?): i32;
	fn fread(ptr: &u8, size: usz, count: usz, stream: *none?): usz;
	fn fwrite(ptr: *char, size: usz, count: usz, stream: *none?): usz;
	fn fseek(stream: *none?, offset: i64, origin: i32): i32;
	fn ftell(stream: *none?): i64;
	fn fflush(stream: *none?): i32;
	fn remove(filename: *char): i32;
	fn rename(old_filename: *char, new_filename: *char): i32;
}

pub struct File {
	pub handle: *none?
}

impl File {

	pub fn open(path: str, mode: str): File {
		val f = fopen(path.c_str(), mode.c_str());
		return File(f);
	}

	pub fn open_read(path: str) => File.open(path, "rb");

	pub fn open_write(path: str) => File.open(path, "wb");

	pub fn open_append(path: str) => File.open(path, "ab");

	// ------------------------------------------------------------------------
	// Backward-compatible static forwarding helpers
	// ------------------------------------------------------------------------

	pub fn exists(path: str): bool => kobel_path_exists(path) != 0;

	pub fn remove(path: str) => remove(path.c_str()) == 0;

	pub fn rename(src: str, dst: str): bool {
		if (File.exists(dst)) {
			File.remove(dst);
		}
		return rename(src.c_str(), dst.c_str()) == 0;
	}

	pub fn read(path: str): str {
		val f = fopen(path.c_str(), "rb") ?: return "";

		fseek(f, 0, 2);
		val size_i64 = ftell(f);
		if (size_i64 <= 0) {
			fclose(f);
			return "";
		}

		fseek(f, 0, 0);
		val sz = size_i64 as usz;
		val buf = Heap.create_array<u8>(sz + 1);
		if (buf == null) {
			fclose(f);
			return "";
		}

		val read_bytes = fread(buf, 1, sz, f);
		fclose(f);
		buf[read_bytes] = 0;

		return str_from_bytes(buf, read_bytes);
	}

	pub fn write(path: str, content: str): bool {
		val f = fopen(path.c_str(), "wb") ?: return false;
		val written = fwrite(content.data, 1, content.len, f);
		fclose(f);
		return written == content.len;
	}

	pub fn append(path: str, content: str): bool {
		val f = fopen(path.c_str(), "ab") ?: return false;
		val written = fwrite(content.data, 1, content.len, f);
		fclose(f);
		return written == content.len;
	}

	// ------------------------------------------------------------------------
	// Instance methods on File handle
	// ------------------------------------------------------------------------

	pub fn is_valid(val self) => self.handle != null;

	pub fn close(var self) {
		if (self.handle != null) {
			fclose(self.handle);
			self.handle = null;
		}
	}

	pub fn flush(val self) {
		if (self.handle != null) {
			fflush(self.handle);
		}
	}

	pub fn seek(val self, offset: i64, origin: i32): i32 => fseek(self.handle, offset, origin);

	pub fn tell(val self): i64 => ftell(self.handle);

	pub fn size(val self): i64 {
		if (self.handle == null) {
			return 0;
		}

		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);

		val total = ftell(self.handle);
		fseek(self.handle, cur, 0);

		return total;
	}

	pub fn write_all(val self, content: str): bool {
		if (self.handle == null) {
			return false;
		}
		val written = fwrite(content.data, 1, content.len, self.handle);
		return written == content.len;
	}

	pub fn read_all(val self): str {
		if (self.handle == null) {
			return "";
		}

		val cur = ftell(self.handle);
		fseek(self.handle, 0, 2);
		val end_pos = ftell(self.handle);
		if (end_pos <= cur) {
			fseek(self.handle, cur, 0);
			return "";
		}
		fseek(self.handle, cur, 0);

		val size = end_pos - cur;
		val buf = Heap.create_array<u8>(size + 1) ?: return "";

		val read_bytes = fread(buf, 1, size, self.handle);
		buf[read_bytes] = 0;

		return str_from_bytes(buf, read_bytes);
	}

}
