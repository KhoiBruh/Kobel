mod std.memory;

/*
 * ============================================================================
 * std.memory.heap — Heap allocator (routed through Kobel scoped heap runtime)
 * ============================================================================
 */

extern "C" {
	fn kobel_alloc(size: usz): ?&u8;
	fn kobel_realloc(ptr: &u8, size: usz): ?&u8;
	fn kobel_free(ptr: &u8): none;
	fn kobel_null_ptr(): &u8;
	fn kobel_str_clone(s: str): str;
	fn kobel_str_free(s: str): none;
	fn kobel_default_heap_bytes(): usz;
}

pub fault MemErr {
	OutOfMemory("Memory allocation failed (out of memory)")
}

pub object Heap {

	// Raw byte allocation returning explicit OOM error on failure.
	pub fn try_alloc(size: usz): &u8 ! MemErr {
		val req = if (size == 0) 1 else size;
		return kobel_alloc(req) ?: MemErr.OutOfMemory;
	}

	// Fallible allocation of `count` elements of `T`.
	pub fn try_create<T>(count: usz = 1): &T ! MemErr {
		val bytes = count * T.size();
		val raw = Heap.try_alloc(bytes)?;
		return raw as &T;
	}

	// Fallible reallocation of `ptr` to hold `count` elements of `T`.
	pub fn try_resize<T>(ptr: &T, count: usz): &T ! MemErr {
		val bytes = count * T.size();
		val req = if (bytes == 0) 1 else bytes;
		val raw = kobel_realloc(ptr as &u8, req) ?: return MemErr.OutOfMemory;
		return raw as &T;
	}

	// One uninitialized `T` on the heap (panics on OOM).
	pub fn create<T>(count: usz = 1) => Heap.try_create<T>(count)!;

	// One initialized `T` on the heap with the given value (panics on OOM).
	pub fn create_val<T>(value: T): &T {
		val ptr = Heap.create<T>(1);
		ptr.write(value);
		return ptr;
	}

	// Grow/shrink `ptr` to hold `count` elements of `T` (panics on OOM).
	pub fn resize<T>(ptr: &T, count: usz) => Heap.try_resize<T>(ptr, count)!;

	// Null typed pointer for lazy zero-capacity containers (never dereferenced when cap == 0).
	pub fn null_ptr<T>(): &T => kobel_null_ptr() as &T;

	// Clones `s` into the currently active heap (returns static "" when empty).
	pub fn dup_str(s: str): str => kobel_str_clone(s);

	// Frees a string previously created by `Heap.dup_str` (no-op for empty strings).
	pub fn drop_str(s: str) => kobel_str_free(s);

	// Live byte count allocated on the default (persistent) heap.
	pub fn default_live_bytes(): usz => kobel_default_heap_bytes();

	// Free a block obtained from create/alloc/resize.
	pub fn free(ptr: &none) => kobel_free(ptr as &u8);

	pub fn free<T>(ptr: &T) => kobel_free(ptr as &u8);

}
