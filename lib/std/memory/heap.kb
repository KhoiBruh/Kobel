mod std.memory;

/*
 * ============================================================================
 * std.memory.heap — Heap allocator (libc malloc/realloc/free)
 * ============================================================================
 */

extern "libc" {
	fn malloc(size: usz): &u8;
	fn realloc(ptr: &u8, size: usz): &u8;
	fn free(ptr: &u8): none;
}

pub struct Heap;

impl Allocator for Heap {
	pub fn alloc_bytes(&self, size: usz, align: usz): &u8 => malloc(size);
}

impl Heap {
	// One uninitialized `T` on the heap.
	pub fn create<T>() => malloc(T.size()) as &T;

	// One initialized `T` on the heap with the given value.
	pub fn create_val<T>(value: T): &T {
		val ptr = Heap.create<T>();
		ptr.write(value);
		return ptr;
	}

	// `count` uninitialized `T`s on the heap (contiguous).
	pub fn create_array<T>(count: usz) => malloc(count * T.size()) as &T;

	// Grow/shrink `ptr` to hold `count` elements of `T`.
	pub fn resize<T>(ptr: *T, count: usz) => realloc(ptr as &u8, count * T.size()) as &T;

	// Free a block obtained from create/create_array/resize.
	pub fn free(ptr: *none) => free(ptr as &u8);
	pub fn free<T>(ptr: *T) => free(ptr as &u8);
}
