mod std.memory;

/*
 * ============================================================================
 * std.memory.arena — Arena allocator
 * ============================================================================
 */

// Internal block of an arena: not exported, and its fields are private.
struct ArenaBlock {
	data: &u8,
	size: usz,
	used: usz,
	next: *ArenaBlock? = null
}

pub struct Arena {
	current: *ArenaBlock? = null,
	block_size: usz
}

impl Allocator for Arena {
	pub fn alloc_bytes(var self, size: usz, align: usz): &u8 {
		if (self.current == null) self.new_block(size);

		var blk = self.current as &ArenaBlock;
		val rem = blk.used % align;
		var aligned_used = blk.used;
		if (rem != 0) aligned_used = blk.used + (align - rem);

		if (aligned_used + size > blk.size) {
			self.new_block(size);
			blk = self.current as &ArenaBlock;
			aligned_used = 0;
		}

		val ptr = &blk.data[aligned_used];
		blk.used = aligned_used + size;
		return ptr;
	}
}

impl Arena {

	pub init(block_size: usz = 65536) => Self(null, block_size);

	fn new_block(var self, min_size: usz) {
		var sz = self.block_size;
		if (sz < min_size) sz = min_size;

		val data = Heap.create_array<u8>(sz);
		val blk = Heap.create<ArenaBlock>();

		blk.data = data;
		blk.size = sz;
		blk.used = 0;
		blk.next = self.current;
		self.current = blk as *ArenaBlock;
	}

	pub fn reset(val self) {
		var curr = self.current;
		while (curr != null) {
			val blk = curr as &ArenaBlock;
			blk.used = 0;
			curr = blk.next;
		}
	}

	pub fn free(var self) {
		var curr = self.current;
		while (curr != null) {
			val blk = curr as &ArenaBlock;
			val next_blk = blk.next;
			Heap.free(blk.data);
			Heap.free(curr);
			curr = next_blk;
		}
		self.current = null;
	}

	pub fn create<T>(var self) => self.alloc_bytes(T.size(), 8) as *T;

	pub fn create_val<T>(var self, value: T): *T {
		val ptr = self.create<T>();
		ptr.write(value);
		return ptr;
	}
}
