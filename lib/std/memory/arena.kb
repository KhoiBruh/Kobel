mod std.memory;

/*
 * ============================================================================
 * std.memory.arena — Arena allocator
 * ============================================================================
 */
// Internal block of an arena: not exported, and its fields are private.
struct ArenaBlock {
	data: &u8,
	size: usz,
	used: usz,
	next: ?&ArenaBlock = null
}

// Shared state handle so multiple compiler subsystems can allocate into one arena.
struct ArenaState {
	current: ?&ArenaBlock = null,
	block_size: usz
}

pub struct Arena {
	state: ?&ArenaState = null,
	block_size: usz = 65536
}

impl Allocator for Arena {

	pub fn alloc_bytes(&self, size: usz, align: usz): &u8 {
		val st = self.ensure_state();
		if (st.current == null) self.new_block(size);

		val blk = st.current!;
		val rem = blk.used % align;
		var aligned_used = blk.used;
		if (rem != 0) aligned_used = blk.used + (align - rem);
		if (aligned_used + size > blk.size) {
			self.new_block(size);
			aligned_used = 0;
		}

		val cur_blk = st.current!;
		val ptr = &cur_blk.data[aligned_used];
		cur_blk.used = aligned_used + size;
		return ptr;
	}

}

impl Arena {

	pub init(block_size: usz = 65536) {
		val st = Heap.create_val<ArenaState>(ArenaState(null, block_size));
		return Self(st, block_size);
	}

	pub fn empty() => Self(null, 65536);

	fn ensure_state(&self): &ArenaState {
		if (self.state != null) return self.state!;
		val st = Heap.create_val<ArenaState>(ArenaState(null, self.block_size));
		self.state = st;
		return st;
	}

	fn new_block(&self, min_size: usz) {
		val st = self.ensure_state();
		var sz = st.block_size;
		if (sz < min_size) sz = min_size;
		val data = Heap.create<u8>(sz);
		val blk = Heap.create<ArenaBlock>(1);
		blk.data = data;
		blk.size = sz;
		blk.used = 0;
		blk.next = st.current;
		st.current = blk;
	}

	pub fn reset(*self) {
		if (self.state == null) return;
		var curr = self.state!.current;
		while (curr != null) {
			curr.used = 0;
			curr = curr.next;
		}
	}

	pub fn total_allocated(*self): usz {
		if (self.state == null) return 0;
		var total: usz = 0;
		var curr = self.state!.current;
		while (curr != null) {
			total += curr.size;
			curr = curr.next;
		}
		return total;
	}

	pub fn free(&self) {
		if (self.state == null) return;

		val st = self.state!;
		var curr = st.current;
		while (curr != null) {
			val next_blk = curr.next;
			Heap.free(curr.data);
			Heap.free(curr);
			curr = next_blk;
		}

		st.current = null;
		Heap.free(st);
		self.state = null;
	}

	pub fn create<T>(&self) => self.alloc_bytes(T.size(), 8) as &T;

	pub fn create_val<T>(&self, value: T): &T {
		val ptr = self.create<T>();
		ptr.write(value);
		return ptr;
	}

}
