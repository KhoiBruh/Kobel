mod std.string;

use std.collections.List;
use std.memory.*;

/*
 * ============================================================================
 * std.string — core `str` layout and methods
 *
 * `str` is a non-owning fat-pointer view (`{ data: *char, len: usz }`, 16 bytes
 * in C99). String literals, concatenations, and buffer builders all keep an
 * extra trailing NUL byte at `data[len]` so `.c_str()` is O(1) without copying,
 * while `.slice(start, end)` produces an O(1) zero-allocation sub-view.
 * ============================================================================
 */

// Raw layout of a `str` value (`kobel_str` in C99).
struct StrRaw {
	data: *char,
	len: usz
}

// Wraps a heap byte buffer of `len` bytes into a `str` value without copying.
pub fn str_from_bytes(buf: &u8, len: usz): str {
	var r = StrRaw(buf as *char, len);
	val sp = &r as *str;
	return sp.read();
}

fn common_whitespace_prefix(lines: List<str>, start_idx: usz, end_idx: usz): str {
	var prefix = "";
	var first = true;

	for (i in start_idx..<end_idx) {
		val line = lines[i];
		if (line.blank()) continue;

		var ws_end = 0;
		for (c in line) {
			when (c) {
				' ', '\t' -> ws_end++;
				else -> break;
			}
		}
		val ws = line.slice(0, ws_end);

		if (first) {
			prefix = ws;
			first = false;
		} else {
			var match_len = 0;
			val max_l = if (prefix.len < ws.len) prefix.len else ws.len;
			while (
				match_len < max_l
				&& prefix[match_len] == ws[match_len]
			) match_len++;

			prefix = prefix.slice(0, match_len);
		}
	}

	return prefix;
}

impl str {

	pub fn empty(*self) => self.len == 0;

	pub fn each(*self, action: (char) -> none) {
		for (data in self) action(data);
	}

	pub fn any(*self, predicate: (char) -> bool): bool {
		for (data in self) if (predicate(data)) return true;
		return false;
	}

	pub fn all(*self, predicate: (char) -> bool): bool {
		for (data in self) if (!predicate(data)) return false;
		return true;
	}

	pub fn count_where(*self, predicate: (char) -> bool): usz {
		var n = 0;
		for (data in self) if (predicate(data)) n++;
		return n;
	}

	pub fn index_where(*self, predicate: (char) -> bool): isz {
		for (i in 0..<self.len) if (predicate(self[i])) return i;
		return -1;
	}

	pub fn last_index_where(*self, predicate: (char) -> bool): isz {
		if (self.len == 0) return -1;

		var i = self.len - 1;
		while (true) {
			if (predicate(self[i])) return i;
			if (i == 0) break;
			i--;
		}

		return -1;
	}

	pub fn filter(*self, predicate: (char) -> bool): str {
		val buf = Heap.create<u8>(self.len + 1);
		var w = 0;
		for (ch in self) {
			if (predicate(ch)) {
				buf[w] = ch.code();
				w++;
			}
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn map_chars(*self, transform: (char) -> char): str {
		if (self.empty()) return self;

		val buf = Heap.create<u8>(self.len + 1);
		for (i in 0..<self.len) buf[i] = transform(self[i]).code();

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	pub fn blank(*self) => self.all { c ->
		yield when (c) {
			' ', '\t', '\r', '\n' -> true;
			else -> false;
		};
	};

	pub fn starts_with(*self, prefix: str): bool {
		if (self.len < prefix.len) return false;

		for (i in 0..<prefix.len) {
			if (self[i] != prefix[i]) return false;
		}

		return true;
	}

	pub fn ends_with(*self, suffix: str): bool {
		if (self.len < suffix.len) return false;

		val off = self.len - suffix.len;
		for (i in 0..<suffix.len) {
			if (self[off + i] != suffix[i]) return false;
		}

		return true;
	}

	pub fn index_of(*self, sub: str): isz {
		if (sub.empty()) return 0;
		if (self.len < sub.len) return -1;

		val max_start = self.len - sub.len;
		for (i in 0..max_start) {
			var matched = true;
			for (j in 0..<sub.len) {
				if (self[i + j] != sub[j]) {
					matched = false;
					break;
				}
			}

			if (matched) return i;
		}

		return -1;
	}

	pub fn strip_suffix(*self, n: usz) => if (self.len <= n) ""
		else self.slice(0, self.len - n);

	// Copy of `self` with every occurrence of `c` removed (`"1_000".strip_char('_')` -> `"1000"`).
	pub fn strip_char(*self, c: char) => self.filter { ch -> ch != c };

	pub fn replace_char(*self, from: char, to: char) =>
		self.map_chars { c -> if (c == from) to else c };

	// `n` copies of `self` in a single allocation (`""` when `n == 0`).
	pub fn repeat(*self, n: usz): str {
		if (n == 0 || self.empty()) return "";

		val buf = Heap.create<u8>(self.len * n + 1);
		var w = 0;

		for (k in 0..<n) {
			memcpy(&buf[w], self.data as *none, self.len);
			w += self.len;
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn join(*self, list: List<str>): str {
		if (list.empty()) return "";
		if (list.len == 1) return list.data[0];

		var total = list.fold(0) { acc, item -> acc + item.len };
		total += self.len * (list.len - 1);

		val buf = Heap.create<u8>(total + 1);
		var w = 0;
		for (i in 0..<list.len) {
			val item = list.data[i];
			if (item.len > 0) {
				memcpy(&buf[w], item.data as *none, item.len);
				w += item.len;
			}

			if (i + 1 < list.len && self.len > 0) {
				memcpy(&buf[w], self.data as *none, self.len);
				w += self.len;
			}
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	/*
	 * Trailing type suffix of a text, ignoring what comes before it: `100L` -> "L",
	 * `1.5F` -> "F", `0xFF` -> "F". Only used through `num_suffix`.
	 */
	fn suffix_tail(*self): str {
		if (self.empty()) return "";

		if (self.len >= 2) {
			val two = self.slice(self.len - 2, self.len);
			when (two) {
				"UZ", "UL", "UB", "US" -> return two;
			}
		}

		val last = self.slice(self.len - 1, self.len);
		when (self[self.len - 1]) {
			'U', 'L', 'S', 'B', 'Z', 'D', 'F' -> return last;
		}

		return "";
	}

	/*
	 * The type suffix of a numeric literal, or "" when it carries none: `100L` ->
	 * "L", `0xFF_UL` -> "UL", `1.5F` -> "F".
	 *
	 * A radix-prefixed literal (`0x...`, `0b...`, `0o...`) only carries a suffix after
	 * the `_` separator, because B, D and F are digits there: `0xBF` is the number
	 * 191, not `0xF` with an f32 suffix, and `0xFF_UL` is still a u64 255.
	 */
	pub fn num_suffix(*self): str {
		if (self.empty()) return "";

		var zone = self;
		var radix = false;
		if (self.len > 2 && self[0] == '0') {
			val r = self[1];
			when (r) {
				'x', 'X', 'b', 'B', 'o', 'O' -> {
					radix = true;
					zone = "";
					for (i in 2..<self.len) {
						if (self[i] == '_') {
							zone = self.slice(i + 1, self.len);
						}
					}
				}
			}
		}

		if (zone.empty()) return "";

		val tail = zone.suffix_tail();
		/*
		 * For a radix literal the whole zone has to be the suffix, or a digit such
		 * as the second F of `0xFF_FF` would be read as one.
		 */
		if (radix && zone.len != tail.len) return "";
		return tail;
	}

	pub fn trim(*self): str {
		if (self.empty()) return self;

		var start = 0;
		while (start < self.len) {
			val c = self[start];
			when (c) {
				' ', '\t', '\r', '\n' -> start++;
				else -> break;
			}
		}

		if (start == self.len) return "";

		var end = self.len;
		while (end > start) {
			val c = self[end - 1];
			when (c) {
				' ', '\t', '\r', '\n' -> end--;
				else -> break;
			}
		}

		return self.slice(start, end);
	}

	pub fn split(*self, delim: char): List<str> {
		var parts = List<str>();
		var start = 0;
		for (i in 0..<self.len) {
			if (self[i] == delim) {
				parts += self.slice(start, i);
				start = i + 1;
			}
		}

		parts += self.slice(start);
		return parts;
	}

	pub fn split_lines(*self): List<str> {
		var res = List<str>();
		var start = 0;
		var i = 0;
		while (i < self.len) {
			val c = self[i];
			if (c == '\n') {
				var line_end = i;
				if (line_end > start && self[line_end - 1] == '\r') line_end--;
				res += self.slice(start, line_end);
				start = i + 1;
			}
			i++;
		}

		if (start <= self.len) {
			var line_end = self.len;
			if (line_end > start && self[line_end - 1] == '\r') line_end--;
			res += self.slice(start, line_end);
		}

		return res;
	}

	pub fn multiline_trim_indent(*self): str {
		if (self.empty()) return "";

		val lines = self.split_lines();
		if (lines.empty()) return "";
		if (lines.len == 1) return lines[0];

		var start_idx = 0;
		if (lines[0].blank()) start_idx = 1;

		var end_idx = lines.len;
		if (
			end_idx > start_idx
			&& lines[end_idx - 1].blank()
		) end_idx = end_idx - 1;

		val prefix = common_whitespace_prefix(lines, start_idx, end_idx);

		var sb = StringBuilder();
		defer sb.free();

		var first = true;
		for (i in start_idx..<end_idx) {
			val line = lines[i];
			val trimmed_line = if (line.blank()) ""
				else if (line.starts_with(prefix)) line.slice(prefix.len, line.len)
				else line;

			if (first) {
				sb += trimmed_line;
				first = false;
			} else {
				sb += '\n';
				sb += trimmed_line;
			}
		}

		return sb.to_str();
	}

	pub fn trim_indent(*self) => self.multiline_trim_indent();

	// ============================================================================
	// Overloaded Operators
	// ============================================================================

	pub op contains(*self, sub: str) => self.index_of(sub) >= 0;

}

impl Iterable for str {

	pub fn count(*self) => self.len;

	pub fn at(*self, i: usz) => self.data[i];

}
