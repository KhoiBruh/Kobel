mod std.number;

/*
 * ============================================================================
 * std.number — foundational traits for numeric types
 * ============================================================================
 */

pub trait Number {
	fn is_zero(val self): bool;
	fn is_positive(val self): bool;
	fn is_negative(val self): bool;
	fn to_f64(val self): f64;
	fn to_i64(val self): i64;
	fn to_u64(val self): u64;
}

// Number trait implementations for signed integers
impl Number for i8 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => self < 0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => (self as i64) as u64;
}

impl Number for i16 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => self < 0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => (self as i64) as u64;
}

impl Number for i32 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => self < 0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => (self as i64) as u64;
}

impl Number for i64 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => self < 0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self;
	fn to_u64(val self): u64 => self as u64;
}

impl Number for isz {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => self < 0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

// Number trait implementations for unsigned integers
impl Number for u8 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => false;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

impl Number for u16 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => false;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

impl Number for u32 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => false;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

impl Number for u64 {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => false;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self;
}

impl Number for usz {
	fn is_zero(val self): bool => self == 0;
	fn is_positive(val self): bool => self > 0;
	fn is_negative(val self): bool => false;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

// Number trait implementations for floats
impl Number for f32 {
	fn is_zero(val self): bool => self == 0.0;
	fn is_positive(val self): bool => self > 0.0;
	fn is_negative(val self): bool => self < 0.0;
	fn to_f64(val self): f64 => self as f64;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}

impl Number for f64 {
	fn is_zero(val self): bool => self == 0.0;
	fn is_positive(val self): bool => self > 0.0;
	fn is_negative(val self): bool => self < 0.0;
	fn to_f64(val self): f64 => self;
	fn to_i64(val self): i64 => self as i64;
	fn to_u64(val self): u64 => self as u64;
}
