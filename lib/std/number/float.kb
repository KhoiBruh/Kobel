mod std.number;

/*
 * ============================================================================
 * std.number — Float trait, mathematical constants and floating-point methods
 * ============================================================================
 */

pub trait Float {
	fn is_nan(val self): bool;
	fn is_infinite(val self): bool;
	fn is_finite(val self): bool;
}

// --- Float trait implementations --------------------------------------------

impl Float for f32 {
	fn is_nan(val self): bool => self != self;
	fn is_infinite(val self): bool => !self.is_nan() && ((self - self) != 0.0 as f32);
	fn is_finite(val self): bool => !self.is_nan() && ((self - self) == 0.0 as f32);
}

impl Float for f64 {
	fn is_nan(val self): bool => self != self;
	fn is_infinite(val self): bool => !self.is_nan() && ((self - self) != 0.0);
	fn is_finite(val self): bool => !self.is_nan() && ((self - self) == 0.0);
}

// --- Inherent methods for f32 -----------------------------------------------

impl f32 {
	pub fn abs(val self): f32 => if (self < 0.0) 0.0 - self else self;
	pub fn signum(val self): f32 => if (self > 0.0) 1.0 else (if (self < 0.0) -1.0 else 0.0);
	pub fn floor(val self): f32 => (self as f64).floor() as f32;
	pub fn ceil(val self): f32 => (self as f64).ceil() as f32;
	pub fn round(val self): f32 => (self as f64).round() as f32;
	pub fn trunc(val self): f32 => (self as f64).trunc() as f32;
	pub fn fract(val self): f32 => (self as f64).fract() as f32;
}

// --- Inherent methods for f64 -----------------------------------------------

impl f64 {
	pub fn abs(val self): f64 => if (self < 0.0) 0.0 - self else self;
	pub fn signum(val self): f64 => if (self > 0.0) 1.0 else (if (self < 0.0) -1.0 else 0.0);

	pub fn floor(val self): f64 {
		if (self.is_nan() || self.is_infinite()) return self;
		val t = (self as i64) as f64;
		if (self < 0.0 && self != t) return t - 1.0;
		return t;
	}

	pub fn ceil(val self): f64 {
		if (self.is_nan() || self.is_infinite()) return self;
		val t = (self as i64) as f64;
		if (self > 0.0 && self != t) return t + 1.0;
		return t;
	}

	pub fn round(val self): f64 {
		if (self.is_nan() || self.is_infinite()) return self;
		if (self >= 0.0) return (self + 0.5).floor();
		return (self - 0.5).ceil();
	}

	pub fn trunc(val self): f64 {
		if (self.is_nan() || self.is_infinite()) return self;
		return (self as i64) as f64;
	}

	pub fn fract(val self): f64 => self - self.trunc();
}
