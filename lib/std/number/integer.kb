mod std.number;

use std.mem.*;
use std.collections.List;
use std.str.str_from_bytes;

/*
 * ============================================================================
 * std.number — Integer trait, limit constants, bitwise and arithmetic utilities
 * ============================================================================
 */

// Limit constants
pub const MIN_I8: i8 = -128;
pub const MAX_I8: i8 = 127;
pub const MIN_I16: i16 = -32768;
pub const MAX_I16: i16 = 32767;
pub const MIN_I32: i32 = -2147483648;
pub const MAX_I32: i32 = 2147483647;
pub const MIN_I64: i64 = -9223372036854775807 - 1;
pub const MAX_I64: i64 = 9223372036854775807;

pub const MIN_U8: u8 = 0;
pub const MAX_U8: u8 = 255;
pub const MIN_U16: u16 = 0;
pub const MAX_U16: u16 = 65535;
pub const MIN_U32: u32 = 0;
pub const MAX_U32: u32 = 4294967295;
pub const MIN_U64: u64 = 0;
pub const MAX_U64: u64 = 18446744073709551615;

pub const MIN_ISZ: isz = MIN_I64 as isz;
pub const MAX_ISZ: isz = MAX_I64 as isz;
pub const MIN_USZ: usz = 0;
pub const MAX_USZ: usz = MAX_U64 as usz;

pub trait Integer {
	fn is_even(val self): bool;
	fn is_odd(val self): bool;
	fn count_ones(val self): usz;
	fn count_zeros(val self): usz;
	fn leading_zeros(val self): usz;
	fn trailing_zeros(val self): usz;
}

// --- Arithmetic bitwise helpers ---------------------------------------------

fn popcount64(var n: u64): usz {
	var count: usz = 0;
	while (n > 0) {
		if (n % 2 == 1) count++;
		n /= 2;
	}
	return count;
}

fn clz_bits(n: u64, total_bits: usz): usz {
	if (n == 0) return total_bits;
	var count: usz = 0;
	var x = n;
	while (x > 0) {
		count++;
		x /= 2;
	}
	if (count > total_bits) return 0;
	return total_bits - count;
}

fn ctz64(n: u64): usz {
	if (n == 0) return 64;
	var count: usz = 0;
	var x = n;
	while (x % 2 == 0) {
		count++;
		x /= 2;
	}
	return count;
}

fn format_hex_u64(n: u64): str {
	if (n == 0) return "0x0";
	var temp = n;
	val hex_chars = "0123456789ABCDEF";
	var digits = List<char>();
	while (temp > 0) {
		val rem: usz = (temp % 16) as usz;
		digits += hex_chars[rem];
		temp /= 16;
	}
	val total_len = digits.len + 2;
	val buf: &u8 = alloc_array<u8>(total_len + 1);
	buf[0] = '0'.code() as u8;
	buf[1] = 'x'.code() as u8;
	for (i in 0..<digits.len) {
		buf[2 + i] = digits[digits.len - 1 - i].code() as u8;
	}
	buf[total_len] = 0;
	return str_from_bytes(buf, total_len);
}

fn format_bin_u64(n: u64): str {
	if (n == 0) return "0b0";
	var temp = n;
	var digits = List<char>();
	while (temp > 0) {
		val bit = temp % 2;
		if (bit == 1) digits += '1';
		else digits += '0';
		temp /= 2;
	}
	val total_len = digits.len + 2;
	val buf: &u8 = alloc_array<u8>(total_len + 1);
	buf[0] = '0'.code() as u8;
	buf[1] = 'b'.code() as u8;
	for (i in 0..<digits.len) {
		buf[2 + i] = digits[digits.len - 1 - i].code() as u8;
	}
	buf[total_len] = 0;
	return str_from_bytes(buf, total_len);
}

// --- Integer trait and inherent implementations: i8 ------------------------

impl Integer for i8 {
	fn is_even(val self): bool => self % 2 == 0;
	fn is_odd(val self): bool => self % 2 != 0;
	fn count_ones(val self): usz => popcount64((self as u8) as u64);
	fn count_zeros(val self): usz => 8 - self.count_ones();
	fn leading_zeros(val self): usz => clz_bits((self as u8) as u64, 8);
	fn trailing_zeros(val self): usz => ctz64((self as u8) as u64);
}

impl i8 {
	pub fn abs(val self): i8 => if (self < 0) 0 - self else self;
	pub fn signum(val self): i8 => if (self > 0) 1 else (if (self < 0) -1 else 0);
	pub fn clamp(val self, lo: i8, hi: i8): i8 => if (self < lo) lo else (if (self > hi) hi else self);
	pub fn to_hex(val self): str => format_hex_u64((self as u8) as u64);
	pub fn to_bin(val self): str => format_bin_u64((self as u8) as u64);
}

