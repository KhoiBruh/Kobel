mod std.str;

use std.mem.alloc.raw_alloc;
use std.mem.alloc.raw_release;

// ============================================================================
// std.str - low-level `str` construction
//
// The shared base for every formatter in std (traits/, etc.): it turns a heap
// byte buffer into a `str` value without relying on how the backend represents
// `str`, so a formatter only has to fill a buffer.
// ============================================================================

// Raw layout of a `str` value ({ data, len }); the same trick as util.strutil.
struct StrRaw {
	data: *char,
	len: usz,
	cap: usz
}

// Wraps a heap byte buffer (already NUL terminated) into a `str` value.
pub fn str_from_bytes(buf: &u8, len: usz): str {
	val raw_mem = raw_alloc(24);
	val r = raw_mem as &StrRaw;
	r.data = buf as *char;
	r.len = len;
	r.cap = len + 1;
	val sp: *str = r as *str;
	val res: str = *sp;
	raw_release(raw_mem);
	return res;
}

impl str {

	pub fn empty(val self) => self.len == 0;

	pub fn starts_with(val self, prefix: str): bool {
		if (self.len < prefix.len) return false;
		return self.slice(0, prefix.len) == prefix;
	}

	pub fn ends_with(val self, suffix: str): bool {
		if (self.len < suffix.len) return false;
		return self.slice(self.len - suffix.len, self.len) == suffix;
	}

	pub fn strip_suffix(val self, n: usz) => if (self.len <= n) ""
		else self.slice(0, self.len - n);

	// Trailing type suffix of a text, ignoring what comes before it: `100L` -> "L",
	// `1.5F` -> "F", `0xFF` -> "F". Only used through `num_suffix`.
	fn suffix_tail(val self): str {
		if (self.len >= 2) {
			val two = self.slice(self.len - 2, self.len);
			if (two == "UZ" || two == "UL" || two == "UB" || two == "US") return two;
		}
		if (self.len == 0) return "";
		val last = self.slice(self.len - 1, self.len);
		if (
			last == "U" || last == "L" || last == "S" || last == "B" ||
			last == "Z" || last == "D" || last == "F"
		) return last;
		return "";
	}

	// The type suffix of a numeric literal, or "" when it carries none: `100L` ->
	// "L", `0xFF_UL` -> "UL", `1.5F` -> "F".
	//
	// A radix-prefixed literal (`0x…`, `0b…`, `0o…`) only carries a suffix after
	// the `_` separator, because B, D and F are digits there: `0xBF` is the number
	// 191, not `0xF` with an f32 suffix, and `0xFF_UL` is still a u64 255.
	pub fn num_suffix(val self): str {
		if (self.len == 0) return "";

		var zone = self;
		var radix = false;
		if (self.len > 2 && self[0] == '0') {
			val r = self[1];
			if (r == 'x' || r == 'X' || r == 'b' || r == 'B' || r == 'o' || r == 'O') {
				radix = true;
				zone = "";
				for (i in 2..<self.len) {
					if (self[i] == '_') zone = self.slice(i + 1, self.len);
				}
			}
		}
		if (zone.len == 0) return "";

		val tail = zone.suffix_tail();
		// For a radix literal the whole zone has to be the suffix, or a digit such
		// as the second F of `0xFF_FF` would be read as one.
		if (radix && zone.len != tail.len) return "";
		return tail;
	}

	// `n` copies of `self` in a single allocation ("" for n == 0).
	pub fn repeat(val self, n: usz): str {
		if (n == 0 || self.len == 0) return "";
		val buf = raw_alloc(self.len * n + 1);
		var w = 0;

		for (k in 0..<n) {
			for (i in 0..<self.len) {
				buf[w] = self[i] as u8;
				w++;
			}
		}
		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn contains(val self, sub: str): bool {
		if (sub.len == 0) return true;
		if (self.len < sub.len) return false;

		val max_start = self.len - sub.len;
		for (i in 0..max_start) {
			var match = true;
			for (j in 0..<sub.len) {
				if (self[i + j] != sub[j]) {
					match = false;
					break;
				}
			}
			if (match) return true;
		}

		return false;
	}

	pub fn index_of(val self, sub: str): isz {
		if (sub.len == 0) return 0;
		if (self.len < sub.len) return -1;

		val max_start = self.len - sub.len;
		for (i in 0..max_start) {
			var match = true;
			for (j in 0..<sub.len) {
				if (self[i + j] != sub[j]) {
					match = false;
					break;
				}
			}
			if (match) return i as isz;
		}

		return -1;
	}

}
