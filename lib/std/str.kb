mod std.str;

use std.collections.list.List;
use std.mem.alloc.*;

/*
 * ============================================================================
 * std.str — core `str` layout and methods
 *
 * `str` is a non-owning fat-pointer view (`{ data: *char, len: usz }`, 16 bytes
 * in C99). String literals, concatenations, and buffer builders all keep an
 * extra trailing NUL byte at `data[len]` so `.c_str()` is O(1) without copying,
 * while `.slice(start, end)` produces an O(1) zero-allocation sub-view.
 * ============================================================================
 */

// Raw layout of a `str` value (`kobel_str` in C99).
struct StrRaw {
	data: *char,
	len: usz
}

// Wraps a heap byte buffer of `len` bytes into a `str` value without copying.
pub fn str_from_bytes(buf: &u8, len: usz): str {
	var r = StrRaw(buf as *char, len);
	val sp = &r as *str;
	return *sp;
}

impl str {

	pub fn empty(val self) => self.len == 0;

	pub fn starts_with(val self, prefix: str): bool {
		if (self.len < prefix.len) return false;

		for (i in 0..<prefix.len) {
			if (self[i] != prefix[i]) return false;
		}

		return true;
	}

	pub fn ends_with(val self, suffix: str): bool {
		if (self.len < suffix.len) return false;

		val off = self.len - suffix.len;
		for (i in 0..<suffix.len) {
			if (self[off + i] != suffix[i]) return false;
		}

		return true;
	}

	pub fn index_of(val self, sub: str): isz {
		if (sub.empty()) return 0;
		if (self.len < sub.len) return -1;

		val max_start = self.len - sub.len;
		for (i in 0..max_start) {
			var matched = true;
			for (j in 0..<sub.len) {
				if (self[i + j] != sub[j]) {
					matched = false;
					break;
				}
			}

			if (matched) return i;
		}

		return -1;
	}

	pub fn strip_suffix(val self, n: usz) => if (self.len <= n) ""
		else self.slice(0, self.len - n);

	// Copy of `self` with every occurrence of `c` removed (`"1_000".strip_char('_')` -> `"1000"`).
	pub fn strip_char(val self, c: char): str {
		val buf = alloc_array<u8>(self.len + 1);
		var w = 0;
		for (i in 0..<self.len) {
			val ch = self[i];
			if (ch != c) {
				buf[w] = ch.code();
				w++;
			}
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn replace_char(val self, from: char, to: char): str {
		if (self.empty()) return self;

		val buf = alloc_array<u8>(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			buf[i] = if (c == from) to.code() else c.code();
		}

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	// `n` copies of `self` in a single allocation (`""` when `n == 0`).
	pub fn repeat(val self, n: usz): str {
		if (n == 0 || self.empty()) return "";
		val buf = alloc_array<u8>(self.len * n + 1);
		var w = 0;

		for (k in 0..<n) {
			for (i in 0..<self.len) {
				buf[w] = self[i].code();
				w++;
			}
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn join(val self, list: List<str>): str {
		if (list.empty()) return "";
		if (list.len == 1) return list.data[0];

		var total = 0;
		for (i in 0..<list.len) total += list.data[i].len;
		total += self.len * (list.len - 1);

		val buf = alloc_array<u8>(total + 1);
		var w = 0;
		for (i in 0..<list.len) {
			val item = list.data[i];
			for (c in item) {
				buf[w] = c.code();
				w++;
			}

			if (i + 1 < list.len) {
				for (c in self) {
					buf[w] = c.code();
					w++;
				}
			}
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	/*
	 * Trailing type suffix of a text, ignoring what comes before it: `100L` -> "L",
	 * `1.5F` -> "F", `0xFF` -> "F". Only used through `num_suffix`.
	 */
	fn suffix_tail(val self): str {
		if (self.empty()) return "";

		if (self.len >= 2) {
			val two = self.slice(self.len - 2, self.len);
			if (
				two == "UZ" || two == "UL"
				|| two == "UB" || two == "US"
			) return two;
		}

		val last = self.slice(self.len - 1, self.len);
		if (
			last == "U" || last == "L" || last == "S"
			|| last == "B" || last == "Z" || last == "D"
			|| last == "F"
		) return last;

		return "";
	}

	/*
	 * The type suffix of a numeric literal, or "" when it carries none: `100L` ->
	 * "L", `0xFF_UL` -> "UL", `1.5F` -> "F".
	 *
	 * A radix-prefixed literal (`0x...`, `0b...`, `0o...`) only carries a suffix after
	 * the `_` separator, because B, D and F are digits there: `0xBF` is the number
	 * 191, not `0xF` with an f32 suffix, and `0xFF_UL` is still a u64 255.
	 */
	pub fn num_suffix(val self): str {
		if (self.empty()) return "";

		var zone = self;
		var radix = false;
		if (self.len > 2 && self[0] == '0') {
			val r = self[1];
			if (
				r == 'x' || r == 'X'
				|| r == 'b' || r == 'B'
				|| r == 'o' || r == 'O'
			) {
				radix = true;
				zone = "";
				for (i in 2..<self.len) {
					if (self[i] == '_') zone = self.slice(i + 1, self.len);
				}
			}
		}

		if (zone.empty()) return "";

		val tail = zone.suffix_tail();
		/*
		 * For a radix literal the whole zone has to be the suffix, or a digit such
		 * as the second F of `0xFF_FF` would be read as one.
		 */
		if (radix && zone.len != tail.len) return "";
		return tail;
	}

	// ============================================================================
	// Overloaded Operators
	// ============================================================================

	pub op contains(val self, sub: str) => self.index_of(sub) >= 0;

}
