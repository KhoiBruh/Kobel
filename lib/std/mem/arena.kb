mod std.mem.arena;

use std.mem.alloc.*;
use std.traits.new.New;

// Fields are internal: an arena is used through `arena_alloc` / its methods.
pub struct ArenaBlock {
	data: &u8,
	size: usz,
	used: usz,
	next: *ArenaBlock
}

pub struct Arena {
	current: *ArenaBlock,
	block_size: usz
}

pub fn new_arena(default_block_size: usz): Arena => Arena(default_block_size);

// Kotlin-style constructors: `Arena()` (64 KiB blocks) and `Arena(block_size)`.
impl New for Arena {
	pub fn new(): Arena => Self(null, 65536UZ);

	pub fn new(block_size: usz): Arena {
		var bs = block_size;
		if (bs == 0) bs = 65536;
		return Self(null, bs);
	}
}

impl Arena {
	pub fn alloc_bytes(var self, size: usz, align: usz): &u8 {
		var al: usz = align;
		if (al == 0) al = 8;

		if (self.current == null) self.new_block(size);

		var blk: &ArenaBlock = self.current as &ArenaBlock;
		val rem: usz = blk.used % al;
		var aligned_used: usz = blk.used;
		if (rem != 0) aligned_used = blk.used + (al - rem);

		if (aligned_used + size > blk.size) {
			self.new_block(size);
			blk = self.current as &ArenaBlock;
			aligned_used = 0;
		}

		val addr: usz = (blk.data as usz) + aligned_used;
		val ptr: &u8 = addr as &u8;
		blk.used = aligned_used + size;
		return ptr;
	}

	fn new_block(var self, min_size: usz) {
		var sz: usz = self.block_size;
		if (sz < min_size) sz = min_size;

		val data: &u8 = raw_alloc(sz);
		val blk_mem: &u8 = raw_alloc(ArenaBlock.size());
		val blk: &ArenaBlock = blk_mem as &ArenaBlock;
		blk.data = data;
		blk.size = sz;
		blk.used = 0;
		blk.next = self.current;
		self.current = blk as *ArenaBlock;
	}

	pub fn reset(var self) {
		var curr: *ArenaBlock = self.current;
		while (curr != null) {
			val blk: &ArenaBlock = curr as &ArenaBlock;
			blk.used = 0;
			curr = blk.next;
		}
	}

	pub fn delete(var self) {
		var curr: *ArenaBlock = self.current;
		while (curr != null) {
			val blk: &ArenaBlock = curr as &ArenaBlock;
			val next_blk: *ArenaBlock = blk.next;
			raw_release(blk.data);
			raw_release(curr as &u8);
			curr = next_blk;
		}
		self.current = null;
	}
}

// Allocates room for one `T` in the arena and returns it already typed as `*T`,
// so callers never have to write `arena.alloc_bytes(T.size(), 8) as *T`.
//
//	val node = arena_alloc<AstNode>(&self.arena);
//	*node = AstNode(...);
pub fn arena_alloc<T>(var arena: &Arena): *T {
	val raw: &u8 = arena.alloc_bytes(T.size(), 8);
	return raw as *T;
}

