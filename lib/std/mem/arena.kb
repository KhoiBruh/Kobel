mod std.mem.arena;

use std.mem.alloc.*;

// Internal block of an arena: not exported, and its fields are private.
struct ArenaBlock {
	data: &u8,
	size: usz,
	used: usz,
	next: *ArenaBlock
}

pub struct Arena {
	current: *ArenaBlock,
	block_size: usz
}

impl Arena {

	pub fn new(block_size: usz = 65536) => Self(null, block_size);

	pub fn alloc_bytes(var self, size: usz, align: usz = 8): &u8 {
		if (self.current == null) self.new_block(size);

		var blk = self.current as &ArenaBlock;
		val rem = blk.used % align;
		var aligned_used = blk.used;
		if (rem != 0) aligned_used = blk.used + (align - rem);

		if (aligned_used + size > blk.size) {
			self.new_block(size);
			blk = self.current as &ArenaBlock;
			aligned_used = 0;
		}

		val addr = (blk.data as usz) + aligned_used;
		val ptr = addr as &u8;
		blk.used = aligned_used + size;
		return ptr;
	}

	fn new_block(var self, min_size: usz) {
		var sz = self.block_size;
		if (sz < min_size) sz = min_size;

		val data = raw_alloc(sz);
		val blk_mem = raw_alloc(ArenaBlock.size());
		val blk = blk_mem as &ArenaBlock;

		blk.data = data;
		blk.size = sz;
		blk.used = 0;
		blk.next = self.current;
		self.current = blk as *ArenaBlock;
	}

	pub fn reset(var self) {
		var curr = self.current;
		while (curr != null) {
			val blk = curr as &ArenaBlock;
			blk.used = 0;
			curr = blk.next;
		}
	}

	pub fn delete(var self) {
		var curr = self.current;
		while (curr != null) {
			val blk = curr as &ArenaBlock;
			val next_blk = blk.next;
			raw_release(blk.data);
			raw_release(curr as &u8);
			curr = next_blk;
		}
		self.current = null;
	}

	pub fn alloc<T>(var self) => self.alloc_bytes(T.size(), 8) as *T;

	pub fn alloc_val<T>(var self, value: T): *T {
		val ptr = self.alloc<T>();
		*ptr = value;
		return ptr;
	}
}

