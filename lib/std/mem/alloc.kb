mod std.mem.alloc;

// ============================================================================
// std.mem.alloc - thin allocation facade
//
// A single place for heap allocation in the standard library and compiler.
// No module has to repeat `extern "libc" { malloc; realloc; free; }`.
//
// Typed generic allocators automatically cast and multiply by T.size().
//
// This layer does NO ownership tracking and NO bounds checking: the caller owns
// whatever it allocates and must release it exactly once.
// ============================================================================

extern "libc" {
	fn malloc(size: usz): &u8;
	fn realloc(ptr: &u8, size: usz): &u8;
	fn free(ptr: &u8): none;
}

// ----------------------------------------------------------------------------
// Typed plane - auto-cast through generics.
// ----------------------------------------------------------------------------

// One uninitialized `T` on the heap.
pub fn alloc<T>() => malloc(T.size()) as &T;

// `count` uninitialized `T`s on the heap (contiguous).
pub fn alloc_array<T>(count: usz) => malloc(count * T.size()) as &T;

// Grow/shrink `ptr` to hold `count` elements of `T`.
pub fn resize<T>(ptr: *T, count: usz) => realloc(ptr as &u8, count * T.size()) as &T;

// Release a block obtained from alloc/alloc_array/resize.
pub fn release<T>(ptr: *T) => free(ptr as &u8);
