mod std.collections;

// ============================================================================
// List<T> — Dynamic array (mang dong), heap-allocated
//
// Layout tuong thich C ABI:
//   data: &T   — con tro den vung nho heap chua cac phan tu
//   len:  usz  — so luong phan tu hien tai
//   cap:  usz  — dung luong toi da truoc khi can realloc
//
// Su dung:
//   val list: List<i32> = new_list<i32>();
//   list.add(42);
//   val x: i32 = list.get(0);
//   list.destroy();
// ============================================================================

extern "libc" {
	fn malloc(size: usz): &u8;
	fn realloc(ptr: &u8, size: usz): &u8;
	fn free(ptr: &u8);
}

pub struct List<T> {
	pub data: &T,
	pub len: usz,
	pub cap: usz
}

// --- Factory functions (top-level vi Kobel chua co static methods) ----------

/// Tao List rong voi dung luong mac dinh (4 phan tu)
pub fn new_list<T>(): List<T> {
	val initial_cap: usz = 4UZ;
	val raw: &u8 = malloc(initial_cap * T.size());
	return List<T>(raw as &T, 0UZ, initial_cap);
}

/// Tao List rong voi dung luong chi dinh
pub fn list_with_capacity<T>(capacity: usz): List<T> {
	var cap: usz = capacity;
	if (cap == 0UZ) {
		cap = 4UZ;
	}
	val raw: &u8 = malloc(cap * T.size());
	return List<T>(raw as &T, 0UZ, cap);
}

// --- Methods ----------------------------------------------------------------

impl List<T> {
	// ---- Read operations ----

	/// Lay phan tu tai vi tri index (khong kiem tra bounds)
	pub fn get(val self, index: usz): T {
		return self.data[index];
	}

	/// Lay phan tu dau tien
	pub fn first(val self): T {
		return self.data[0UZ];
	}

	/// Lay phan tu cuoi cung
	pub fn last(val self): T {
		return self.data[self.len - 1UZ];
	}

	/// Kiem tra list co rong khong
	pub fn is_empty(val self): bool {
		return self.len == 0UZ;
	}

	// ---- Write operations ----

	/// Gan gia tri tai vi tri index (khong kiem tra bounds)
	pub fn set(var self, index: usz, value: T) {
		self.data[index] = value;
	}

	/// Them phan tu vao cuoi list, tu dong mo rong neu can
	pub fn add(var self, value: T) {
		if (self.len == self.cap) {
			self.grow();
		}
		self.data[self.len] = value;
		self.len = self.len + 1UZ;
	}

	/// Xoa phan tu cuoi cung va tra ve gia tri
	pub fn pop(var self): T {
		self.len = self.len - 1UZ;
		return self.data[self.len];
	}

	/// Xoa tat ca phan tu (khong giai phong bo nho)
	pub fn clear(var self) {
		self.len = 0UZ;
	}

	// ---- Capacity management ----

	/// Mo rong gap doi dung luong hien tai
	fn grow(var self) {
		val new_cap: usz = self.cap * 2UZ;
		val new_raw: &u8 = realloc(self.data as &u8, new_cap * T.size());
		self.data = new_raw as &T;
		self.cap = new_cap;
	}

	/// Dam bao dung luong toi thieu, mo rong neu can
	pub fn reserve(var self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap: usz = self.cap;
			while (new_cap < min_cap) {
				new_cap = new_cap * 2UZ;
			}
			val new_raw: &u8 = realloc(self.data as &u8, new_cap * T.size());
			self.data = new_raw as &T;
			self.cap = new_cap;
		}
	}

	// ---- Cleanup ----

	/// Giai phong vung nho heap. Goi khi khong con dung list nua.
	pub fn destroy(self) {
		free(self.data as &u8);
	}
}
