mod std.collections;

/*
	List<T> — dynamic array, heap-allocated

	C ABI layout:
		data:   &T  — pointer point to heap of elements
		len:    usz — current element count
		cap:    usz — max capacity before need to realloc

	Usage:
		val list = new_list<i32>();
		list.add(42);
		val x = list.get(0);
		list.delete();
*/

extern "libc" {
	fn malloc(size: usz): &u8;
	fn realloc(ptr: &u8, size: usz): &u8;
	fn free(ptr: &u8);
}

pub struct List<T> {
	pub data: &T,
	pub len: usz,
	pub cap: usz
}

// create an empty list with 4 slots
pub fn new_list<T>(): List<T> {
	val init_cap = 4UZ;
	val raw = malloc(init_cap * T.size());
	return List<T>(raw as &T, 0, init_cap);
}

// create an empty list with capacity
pub fn list_with_capacity<T>(capacity: usz): List<T> {
	var cap = capacity;
	if (cap == 0) cap = 4;
	val raw = malloc(cap * T.size());
	return List<T>(raw as &T, 0, cap);
}

// --- Methods ----------------------------------------------------------------

impl List<T> {
	// ---- Read operations ----

	/// Lay phan tu tai vi tri index (khong kiem tra bounds)
	pub fn get(val self, index: usz) => self.data[index];

	/// Lay phan tu dau tien
	pub fn first(val self) => self.data[0];

	/// Lay phan tu cuoi cung
	pub fn last(val self)  => self.data[self.len - 1];

	/// Kiem tra list co rong khong
	pub fn is_empty(val self) => self.len == 0;

	// ---- Write operations ----

	/// Gan gia tri tai vi tri index (khong kiem tra bounds)
	pub fn set(var self, index: usz, value: T) {
		self.data[index] = value;
	}

	/// Them phan tu vao cuoi list, tu dong mo rong neu can
	pub fn add(var self, value: T) {
		if (self.len == self.cap) self.grow();
		self.data[self.len] = value;
		self.len = self.len + 1;
	}

	/// Xoa phan tu cuoi cung va tra ve gia tri
	pub fn pop(var self): T {
		self.len = self.len - 1;
		return self.data[self.len];
	}

	/// Xoa tat ca phan tu (khong giai phong bo nho)
	pub fn clear(var self) {
		self.len = 0UZ;
	}

	// ---- Capacity management ----

	/// Mo rong gap doi dung luong hien tai
	fn grow(var self) {
		val new_cap = self.cap * 2;
		val new_raw = realloc(self.data as &u8, new_cap * T.size());
		self.data = new_raw as &T;
		self.cap = new_cap;
	}

	/// Dam bao dung luong toi thieu, mo rong neu can
	pub fn reserve(var self, min_cap: usz) {
		if (min_cap > self.cap) {
			var new_cap = self.cap;
			while (new_cap < min_cap) {
				new_cap = new_cap * 2;
			}
			val new_raw = realloc(self.data as &u8, new_cap * T.size());
			self.data = new_raw as &T;
			self.cap = new_cap;
		}
	}

	// ---- Cleanup ----

	/// Giai phong vung nho heap. Goi khi khong con dung list nua.
	pub fn delete(self) {
		free(self.data as &u8);
	}
}
