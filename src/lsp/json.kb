mod lsp;

use std.io.*;
use std.string.*;
use std.ascii.*;
use std.memory.*;
use std.collections.*;

// ============================================================================
// JSON Data Types
// ============================================================================

pub fault JsonErr {
	EmptyInput("JSON input is empty"),
	UnexpectedToken("Unexpected character in JSON"),
	UnterminatedString("Unterminated JSON string"),
	InvalidEscape("Invalid escape sequence in JSON string"),
	ExpectedColon("Expected ':' after JSON object key"),
	InvalidLiteral("Invalid JSON literal token"),
	InvalidNumber("Invalid JSON number token"),
	TrailingData("Unexpected trailing characters after JSON value")
}

pub enum JsonKind {
	JNULL,
	JBOOL,
	JNUM,
	JSTR,
	JARR,
	JOBJ
}

pub struct JsonValue {
	pub kind: JsonKind,
	pub bool_val: bool = false,
	pub num_val: i64 = 0,
	pub str_val: str = "",
	pub arr_val: List<*JsonValue> = List(),
	pub obj_keys: List<str> = List(),
	pub obj_vals: List<*JsonValue> = List()
}

// ============================================================================
// Serialization Helpers
// ============================================================================

fn append_json_escaped_str(sb: &StringBuilder, s: str) {
	sb += '"';
	sb.append_escaped(s);
	sb += '"';
}

// ============================================================================
// Methods on JsonValue
// ============================================================================

impl JsonValue {

	pub fn box(v: JsonValue): &JsonValue {
		val p = Heap.create<JsonValue>(1);
		p.write(v);
		return p;
	}

	pub fn null_val() => JsonValue.box(JsonValue(JsonKind.JNULL));
	pub fn nil() => JsonValue.null_val();

	pub fn bool(b: bool) => JsonValue.box(JsonValue(JsonKind.JBOOL, b));

	pub fn num(n: i64) => JsonValue.box(JsonValue(JsonKind.JNUM, false, n));
	pub fn int(n: i64) => JsonValue.num(n);

	pub fn str(s: str) => JsonValue.box(JsonValue(JsonKind.JSTR, false, 0, s));
	pub fn string(s: str) => JsonValue.str(s);

	pub fn arr() => JsonValue.box(JsonValue(JsonKind.JARR));
	pub fn array() => JsonValue.arr();

	pub fn obj() => JsonValue.box(JsonValue(JsonKind.JOBJ));
	pub fn object() => JsonValue.obj();

	pub fn parse(src: str): &JsonValue ! JsonErr {
		var parser = JsonParser(src);
		val v = parser.parse_value()?;
		parser.skip_whitespace();
		if (!parser.is_end()) return JsonErr.TrailingData;
		return v;
	}

	pub fn serialize_to(*self, sb: &StringBuilder) {
		if (self == null) {
			sb += "null";
			return;
		}

		when (self.kind) {
			JsonKind.JNULL -> sb += "null";
			JsonKind.JBOOL -> sb += self.bool_val;
			JsonKind.JNUM -> sb += self.num_val;
			JsonKind.JSTR -> append_json_escaped_str(sb, self.str_val);
			JsonKind.JARR -> {
				sb += '[';
				for (i in 0..<self.arr_val.len) {
					if (i > 0) sb += ',';
					self.arr_val[i].serialize_to(sb);
				}
				sb += ']';
			}
			JsonKind.JOBJ -> {
				sb += '{';
				for (i in 0..<self.obj_keys.len) {
					if (i > 0) sb += ',';
					append_json_escaped_str(sb, self.obj_keys[i]);
					sb += ':';
					self.obj_vals[i].serialize_to(sb);
				}
				sb += '}';
			}
		}
	}

	pub fn is_null(*self) => self == null || self.kind == JsonKind.JNULL;
	pub fn is_bool(*self) => self?.kind == JsonKind.JBOOL;
	pub fn is_num(*self) => self?.kind == JsonKind.JNUM;
	pub fn is_str(*self) => self?.kind == JsonKind.JSTR;
	pub fn is_arr(*self) => self?.kind == JsonKind.JARR;
	pub fn is_obj(*self) => self?.kind == JsonKind.JOBJ;

	pub fn add(&self, val_item: *JsonValue) {
		if (self.kind == JsonKind.JARR) self.arr_val += val_item;
	}

	pub op plus_assign(&self, val_item: *JsonValue) => self.add(val_item);

	pub op set(&self, key: str, val_item: *JsonValue) {
		if (self.kind != JsonKind.JOBJ) return;
		val idx_res = self.obj_keys.index_of(key);
		if (idx_res is usz as idx) {
			self.obj_vals[*idx] = val_item;
			return;
		}
		self.obj_keys += key;
		self.obj_vals += val_item;
	}

	pub op get(*self, key: str): *JsonValue {
		if (self == null || self.kind != JsonKind.JOBJ) return JsonValue.null_val();

		val idx = self.obj_keys.index_of(key) !: return JsonValue.null_val();
		return self.obj_vals[idx];
	}

	pub op contains(*self, key: str): bool => self?.kind == JsonKind.JOBJ && key in self.obj_keys;

	pub fn has(*self, key: str): bool => key in self;

	pub fn get_str(*self, key: str, def_val: str): str {
		val v = self[key];
		if (v.is_str()) return v.str_val;
		return def_val;
	}

	pub fn get_num(*self, key: str, def_val: i64): i64 {
		val v = self[key];
		if (v.is_num()) return v.num_val;
		return def_val;
	}

	pub fn get_bool(*self, key: str, def_val: bool): bool {
		val v = self[key];
		if (v.is_bool()) return v.bool_val;
		return def_val;
	}

	pub fn get_obj(*self, key: str): *JsonValue {
		val v = self[key];
		if (v.is_obj()) return v;
		return JsonValue.obj();
	}

	pub fn get_arr(*self, key: str): *JsonValue {
		val v = self[key];
		if (v.is_arr()) return v;
		return JsonValue.arr();
	}

	pub fn at(*self, index: usz): *JsonValue {
		if (self?.kind == JsonKind.JARR && index < self.arr_val.len) return self.arr_val[index];
		return JsonValue.null_val();
	}

	pub fn count(*self): usz {
		if (self == null) return 0;
		if (self.kind == JsonKind.JARR) return self.arr_val.len;
		if (self.kind == JsonKind.JOBJ) return self.obj_keys.len;
		return 0;
	}

	pub fn serialize(*self): str {
		var sb = StringBuilder();
		defer sb.free();
		self.serialize_to(&sb);
		return sb.to_str();
	}

}

// ============================================================================
// JSON Parser
// ============================================================================

pub struct JsonParser {
	pub src: str,
	pub cursor: usz = 0
}

impl JsonParser {

	pub fn is_end(*self) => self.cursor >= self.src.len;

	pub fn peek(*self) => if (self.is_end()) '\0' else self.src[self.cursor];

	pub fn advance(&self): char {
		val c = self.peek();
		self.cursor++;
		return c;
	}

	pub fn skip_whitespace(&self) {
		while (!self.is_end()) {
			val c = self.peek();
			if (c.is_whitespace()) {
				self.advance();
			} else break;
		}
	}

	pub fn parse_string(&self): str ! JsonErr {
		self.advance(); // Skip opening quote '"'
		var sb = StringBuilder();
		defer sb.free();
		var closed = false;
		while (!self.is_end()) {
			val c = self.advance();
			when (c) {
				'"' -> {
					closed = true;
					break;
				}
				'\\' -> {
					if (self.is_end()) return JsonErr.UnterminatedString;

					val esc = self.advance();
					when (esc) {
						'"' -> sb += '"';
						'\\' -> sb += '\\';
						'/' -> sb += '/';
						'n' -> sb += '\n';
						'r' -> sb += '\r';
						't' -> sb += '\t';
						'u' -> {
							var u_val: i32 = 0;
							var u_count: usz = 0;
							while (u_count < 4 && !self.is_end()) {
								val hc = self.advance();
								val d: i32 = when (hc) {
									'0'..'9' -> (hc.code() as i32) - 48;
									'a'..'f' -> (hc.code() as i32) - 87;
									'A'..'F' -> (hc.code() as i32) - 55;
									else -> -1;
								};
								if (d < 0) return JsonErr.InvalidEscape;
								u_val = u_val * 16 + d;
								u_count++;
							}
							if (u_count < 4) return JsonErr.InvalidEscape;
							if (u_val > 0 && u_val < 128) sb += char(u_val);
							else sb += '?';
						}
						else -> sb += esc;
					}
				}
				else -> sb += c;
			}
		}

		if (!closed) return JsonErr.UnterminatedString;
		return sb.to_str();
	}

	pub fn parse_number(&self): i64 ! JsonErr {
		var sign: i64 = 1;
		if (self.peek() == '-') {
			sign = -1;
			self.advance();
		}

		if (self.is_end() || !(self.peek() in '0'..'9')) return JsonErr.InvalidNumber;
		var val_num: i64 = 0;
		while (!self.is_end() && self.peek() in '0'..'9') {
			val c = self.advance();
			val d = c.code() - 48;
			val_num = val_num * 10 + d;
		}

		if (!self.is_end() && self.peek() == '.') {
			self.advance();
			if (self.is_end() || !(self.peek() in '0'..'9')) return JsonErr.InvalidNumber;
			while (!self.is_end() && self.peek() in '0'..'9') self.advance();
		}

		if (!self.is_end()) {
			val p = self.peek();
			when (p) {
				'e', 'E' -> {
					self.advance();
					if (!self.is_end()) {
						val s = self.peek();
						when (s) {
							'+', '-' -> self.advance();
						}
					}
					if (self.is_end() || !(self.peek() in '0'..'9')) return JsonErr.InvalidNumber;
					while (!self.is_end() && self.peek() in '0'..'9') self.advance();
				}
			}
		}

		return val_num * sign;
	}

	pub fn parse_array(&self): &JsonValue ! JsonErr {
		self.advance(); // Skip '['
		var res = JsonValue.arr();
		self.skip_whitespace();
		if (!self.is_end() && self.peek() == ']') {
			self.advance();
			return res;
		}

		while (!self.is_end()) {
			self.skip_whitespace();
			val item = self.parse_value()?;
			res += item;
			self.skip_whitespace();

			if (!self.is_end() && self.peek() == ',') self.advance();
			else break;
		}

		self.skip_whitespace();
		if (self.is_end() || self.peek() != ']') return JsonErr.UnexpectedToken;
		self.advance();
		return res;
	}

	pub fn parse_object(&self): &JsonValue ! JsonErr {
		self.advance(); // Skip '{'
		var res = JsonValue.obj();
		self.skip_whitespace();
		if (!self.is_end() && self.peek() == '}') {
			self.advance();
			return res;
		}

		while (!self.is_end()) {
			self.skip_whitespace();
			if (self.is_end() || self.peek() != '"') return JsonErr.UnexpectedToken;
			val key = self.parse_string()?;
			self.skip_whitespace();

			if (self.is_end() || self.peek() != ':') return JsonErr.ExpectedColon;
			self.advance();
			self.skip_whitespace();

			val val_item = self.parse_value()?;
			res[key] = val_item;

			self.skip_whitespace();
			if (!self.is_end() && self.peek() == ',') self.advance();
			else break;
		}

		self.skip_whitespace();
		if (self.is_end() || self.peek() != '}') return JsonErr.UnexpectedToken;
		self.advance();
		return res;
	}

	fn expect_literal(&self, expected: str): !JsonErr {
		for (i in 0..<expected.len) {
			if (self.is_end() || self.advance() != expected[i]) {
				return JsonErr.InvalidLiteral;
			}
		}
	}

	pub fn parse_value(&self): &JsonValue ! JsonErr {
		self.skip_whitespace();
		if (self.is_end()) return JsonErr.EmptyInput;

		val c = self.peek();
		when (c) {
			'"' -> return JsonValue.str(self.parse_string()?);
			'{' -> return self.parse_object()?;
			'[' -> return self.parse_array()?;
			'-', '0'..'9' -> return JsonValue.num(self.parse_number()?);
			't' -> {
				self.expect_literal("true")?;
				return JsonValue.bool(true);
			}
			'f' -> {
				self.expect_literal("false")?;
				return JsonValue.bool(false);
			}
			'n' -> {
				self.expect_literal("null")?;
				return JsonValue.null_val();
			}
			else -> return JsonErr.UnexpectedToken;
		}
	}

}
