mod lsp;

use std.ascii.*;
use std.memory.Arena;
use std.collections.*;
use std.string.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.loader.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

/*
 * ============================================================================
 * lsp.ast_index — Semantic & Dependency AST Indexer
 *
 * Walks loaded modules, ASTs, and `SymbolTable`/`SemanticTable` to construct a
 * workspace-wide index of definitions, exact identifier references, module
 * dependency edges, import usage, and unmutated `var` bindings.
 * ============================================================================
 */

pub fault IndexErr {
	NotFound("Entry not found in semantic index")
}

pub enum SymRole {
	MODULE,
	FN,
	METHOD,
	STRUCT,
	OBJECT,
	FIELD,
	ENUM,
	ENUM_VARIANT,
	TRAIT,
	CONST,
	LOCAL,
	PARAM
}

pub struct DefInfo {
	pub key: str,
	pub name: str,
	pub role: SymRole,
	pub file_path: str,
	pub module_name: str,
	pub container: str,
	pub line: usz,
	pub col: usz,
	pub len: usz,
	pub signature: str,
	pub type_str: str,
	pub is_public: bool = false,
	pub is_mutable: bool = false,
	pub is_mutated: bool = false,
	pub is_vararg: bool = false,
	pub param_names: List<str> = List(),
	pub param_types: List<str> = List(),
	pub return_type: str = "",
	pub has_body: bool = true,
	pub is_trait_impl: bool = false,
	pub is_special_fn: bool = false,
	pub has_mut_check: bool = false
}

pub struct RefInfo {
	pub target_key: str,
	pub file_path: str,
	pub module_name: str,
	pub line: usz,
	pub col: usz,
	pub len: usz,
	pub is_def: bool = false,
	pub is_write: bool = false,
	pub is_import: bool = false,
	pub type_str: str = "",
	pub owner_key: str = ""
}

pub struct ImportInfo {
	pub file_path: str,
	pub module_name: str,
	pub target_module: str,
	pub symbol_name: str,
	pub alias: str,
	pub wildcard: bool,
	pub line: usz,
	pub col: usz,
	pub end_line: usz,
	pub end_col: usz,
	pub used: bool = false
}

pub struct ImplMissingInfo {
	pub file_path: str,
	pub struct_name: str,
	pub trait_name: str,
	pub line: usz,
	pub col: usz,
	pub missing_stubs: List<str> = List()
}

pub struct DepGraph {
	pub imports_of: HashMap<str, List<str>> = HashMap(),
	pub dependents_of: HashMap<str, List<str>> = HashMap(),
	pub module_files: HashMap<str, List<str>> = HashMap()
}

impl DepGraph {

	pub fn add_edge(&self, from_mod: str, to_mod: str) {
		if (from_mod.empty() || to_mod.empty() || from_mod == to_mod) return;

		var imp_list = self.imports_of.get_or(from_mod, List<str>());
		if (to_mod !in imp_list) {
			imp_list += to_mod;
			self.imports_of[from_mod] = imp_list;
		}

		var dep_list = self.dependents_of.get_or(to_mod, List<str>());
		if (from_mod !in dep_list) {
			dep_list += from_mod;
			self.dependents_of[to_mod] = dep_list;
		}
	}

	pub fn add_module_file(&self, mod_name: str, file_path: str) {
		if (mod_name.empty() || file_path.empty()) return;
		var files = self.module_files.get_or(mod_name, List<str>());
		val norm = file_path.normalize_path();
		if (norm !in files) {
			files += norm;
			self.module_files[mod_name] = files;
		}
	}

	pub fn related_modules(*self, target_mod: str): HashSet<str> {
		var result = HashSet<str>();
		if (target_mod.empty()) return result;
		result += target_mod;

		// Direct and transitive dependents
		var queue = List<str>();
		queue += target_mod;
		var idx: usz = 0;
		while (idx < queue.len) {
			val cur = queue[idx];
			idx++;
			val deps = self.dependents_of.get_or(cur, List<str>());
			for (d in deps) {
				if (d !in result) {
					result += d;
					queue += d;
				}
			}
		}
		return result;
	}

	pub fn free(*self) {
		for ((_k, v) in self.imports_of) v.free();
		self.imports_of.free();
		for ((_k, v) in self.dependents_of) v.free();
		self.dependents_of.free();
		for ((_k, v) in self.module_files) v.free();
		self.module_files.free();
	}

}

struct LocalBinding {
	pub name: str,
	pub key: str,
	pub def_idx: usz
}

struct LocalScope {
	pub bindings: List<LocalBinding> = List()
}

pub struct SemanticIndex {
	pub defs: List<DefInfo> = List(),
	pub def_by_key: HashMap<str, usz> = HashMap(),
	pub refs: List<RefInfo> = List(),
	pub refs_by_file: HashMap<str, List<usz>> = HashMap(),
	pub refs_by_key: HashMap<str, List<usz>> = HashMap(),
	pub seen_refs: HashSet<str> = HashSet(),
	pub imports_by_file: HashMap<str, List<ImportInfo>> = HashMap(),
	pub missing_impls_by_file: HashMap<str, List<ImplMissingInfo>> = HashMap(),
	pub dep_graph: DepGraph = DepGraph(),
	pub symtab: SymbolTable = SymbolTable(Arena.empty()),
	pub has_symtab: bool = false,
	pub file_tokens: HashMap<str, List<Token>> = HashMap(),
	pub file_modules: HashMap<str, str> = HashMap(),
	pub orig_node_names: HashMap<usz, str> = HashMap(),
	pub orig_node_keys: HashMap<usz, str> = HashMap(),
	pub c_name_to_key: HashMap<str, str> = HashMap(),
	pub c_inst_to_base: HashMap<str, str> = HashMap(),
	pub struct_mod_by_name: HashMap<str, str> = HashMap(),
	pub enum_mod_by_name: HashMap<str, str> = HashMap(),
	pub top_key_by_name: HashMap<str, str> = HashMap()
}

impl SemanticIndex {

	pub fn free(*self) {
		for (d in self.defs) {
			d.param_names.free();
			d.param_types.free();
		}
		self.defs.free();
		self.def_by_key.free();
		self.refs.free();
		for ((_k, v) in self.refs_by_file) v.free();
		self.refs_by_file.free();
		for ((_k, v) in self.refs_by_key) v.free();
		self.refs_by_key.free();
		self.seen_refs.free();
		for ((_k, v) in self.imports_by_file) v.free();
		self.imports_by_file.free();
		for ((_k, v) in self.missing_impls_by_file) {
			for (mi in v) mi.missing_stubs.free();
			v.free();
		}
		self.missing_impls_by_file.free();
		self.dep_graph.free();
		for ((_k, v) in self.file_tokens) v.free();
		self.file_tokens.free();
		self.file_modules.free();
		self.orig_node_names.free();
		self.orig_node_keys.free();
		self.c_name_to_key.free();
		self.c_inst_to_base.free();
		self.struct_mod_by_name.free();
		self.enum_mod_by_name.free();
		self.top_key_by_name.free();
	}

}

// ============================================================================
// Token Snapping & Formatting Helpers
// ============================================================================

fn find_token_index_at_line(tokens: List<Token>, start_line: usz): usz {
	if (tokens.empty()) return 0;
	var lo: usz = 0;
	var hi: usz = tokens.len;
	while (lo < hi) {
		val mid = lo + (hi - lo) / 2;
		if (tokens[mid].line < start_line) lo = mid + 1;
		else hi = mid;
	}
	return lo;
}

fn find_param_token_after(
	tokens: List<Token>, start_line: usz, start_col: usz, name: str
): Token {
	var i = find_token_index_at_line(tokens, start_line);
	val n = tokens.len;
	while (i < n) {
		val tok = tokens[i];
		if (tok.line > start_line + 12) break;
		if (tok.line > start_line || tok.col >= start_col) {
			if (tok.type == TokenType.IDENTIFIER && tok.text == name) {
				if (i + 1 < n && tokens[i + 1].type == TokenType.COLON) return tok;
			}
		}
		i++;
	}
	return find_ident_token_after(tokens, start_line, start_col, name);
}

fn find_ident_token_after(
	tokens: List<Token>, start_line: usz, start_col: usz, name: str
): Token {
	var i = find_token_index_at_line(tokens, start_line);
	val n = tokens.len;
	while (i < n) {
		val tok = tokens[i];
		if (tok.line > start_line + 12) break;
		if (tok.line > start_line || tok.col >= start_col) {
			if (tok.type == TokenType.IDENTIFIER && tok.text == name) return tok;
		}
		i++;
	}
	return Token(TokenType.UNKNOWN, "", 0, 0);
}

fn find_member_token_after(
	tokens: List<Token>, start_line: usz, start_col: usz, member: str
): Token {
	var seen_dot = false;
	var i = find_token_index_at_line(tokens, start_line);
	val n = tokens.len;
	while (i < n) {
		val tok = tokens[i];
		if (tok.line > start_line + 3) break;
		if (tok.line > start_line || tok.col >= start_col) {
			if (tok.type in [TokenType.DOT, TokenType.QUESTION_DOT]) {
				seen_dot = true;
			} else if (seen_dot && tok.type == TokenType.IDENTIFIER && tok.text == member) {
				return tok;
			}
		}
		i++;
	}
	return find_ident_token_after(tokens, start_line, start_col, member);
}

fn find_line_end_col(tokens: List<Token>, line: usz): usz {
	var max_col: usz = 1;
	var i = find_token_index_at_line(tokens, line);
	val n = tokens.len;
	while (i < n) {
		val tok = tokens[i];
		if (tok.line == line) {
			val end_c = tok.col + tok.text.len;
			if (end_c > max_col) max_col = end_c;
		} else if (tok.line > line) {
			break;
		}
		i++;
	}
	return max_col;
}

pub fn format_type_node(node: ?*AstNode): str {
	if (node == null) return "none";
	when (node) {
		is NamedType -> {
			if (node.type_args.empty()) return node.name;
			var sb = StringBuilder();
			defer sb.free();
			sb += node.name;
			sb += "<";
			for (i in 0..<node.type_args.len) {
				if (i > 0) sb += ", ";
				sb += format_type_node(node.type_args[i]);
			}
			sb += ">";
			return sb.to_str();
		}
		is PointerType -> {
			val prefix = (if (node.nullable) "?" else "") + (if (node.mutable) "&" else "*");
			return prefix + format_type_node(node.pointee);
		}
		is VariadicType -> return ".." + format_type_node(node.element_type);
		is ArrayType -> return "[${format_type_node(node.element_type)}; ${node.size}]";
		is ArrayLiteralExpr -> {
			var sb = StringBuilder();
			defer sb.free();
			sb += "[";
			for (i in 0..<node.elements.len) {
				if (i > 0) sb += ", ";
				sb += format_type_node(node.elements[i]);
			}
			sb += "]";
			return sb.to_str();
		}
		is FnType -> {
			var sb = StringBuilder();
			defer sb.free();
			sb += "fn(";
			for (i in 0..<node.param_types.len) {
				if (i > 0) sb += ", ";
				sb += format_type_node(node.param_types[i]);
			}
			sb += "): ";
			sb += format_type_node(node.return_type);
			return sb.to_str();
		}
		is ErrorUnionType -> {
			if (node.ok_type != null) return "${format_type_node(node.ok_type!)} ! ${format_type_node(node.err_type)}";
			return "!${format_type_node(node.err_type)}";
		}
		else -> return "any";
	}
}

pub fn format_fn_signature(
	name: str,
	type_params: List<GenericParam>,
	params: List<Param>,
	return_type: ?*AstNode,
	is_op: bool = false,
	is_init: bool = false
): str {
	var sb = StringBuilder();
	defer sb.free();
	if (is_init) sb += "init";
	else if (is_op) sb += "op ${name}";
	else sb += "fn ${name}";

	if (!type_params.empty()) {
		sb += "<";
		for (i in 0..<type_params.len) {
			if (i > 0) sb += ", ";
			sb += type_params[i].name;
		}
		sb += ">";
	}

	sb += "(";
	for (i in 0..<params.len) {
		if (i > 0) sb += ", ";
		val p = params[i];
		when (p.receiver) {
			ReceiverKind.PTR_MUT -> sb += "&self";
			ReceiverKind.PTR_CONST -> sb += "*self";
			ReceiverKind.MOVE -> sb += "self";
			else -> sb += "${p.name}: ${format_type_node(p.type_node)}";
		}
	}
	sb += ")";
	if (return_type != null) sb += ": ${format_type_node(return_type)}";
	return sb.to_str();
}

pub fn unwrap_base_type(ty: ?*Type): ?*Type {
	var cur = ty;
	var depth = 0;
	while (cur != null && depth < 4) {
		val ptr = cur.as_pointer();
		if (ptr != null) {
			cur = ptr.pointee;
			depth++;
			continue;
		}
		break;
	}
	return cur;
}

impl SemanticIndex {

	pub fn add_def(&self, def: DefInfo): usz {
		if (def.role == SymRole.STRUCT && def.name !in self.struct_mod_by_name) {
			self.struct_mod_by_name[def.name] = def.module_name;
		} else if (def.role == SymRole.ENUM && def.name !in self.enum_mod_by_name) {
			self.enum_mod_by_name[def.name] = def.module_name;
		}

		if (
			def.role in [
				SymRole.FN, SymRole.STRUCT, SymRole.ENUM,
				SymRole.TRAIT, SymRole.CONST
			] && def.name !in self.top_key_by_name
		) {
			self.top_key_by_name[def.name] = def.key;
		}

		val existing = self.def_by_key.get(def.key);
		if (existing != null) {
			val idx = existing.read();
			self.defs[idx] = def;
			return idx;
		}
		val idx = self.defs.len;
		self.defs += def;
		self.def_by_key[def.key] = idx;
		return idx;
	}

	pub fn get_def(*self, key: str): DefInfo ! IndexErr {
		val idx_p = self.def_by_key.get(key) ?: return IndexErr.NotFound;
		val idx = idx_p.read();
		if (idx < self.defs.len) return self.defs[idx];
		return IndexErr.NotFound;
	}

	pub fn add_ref(&self, r: RefInfo) {
		if (r.line == 0 || r.col == 0 || r.len == 0) return;
		val norm = r.file_path.normalize_path();
		val dedup = "${norm}:${r.line}:${r.col}:${r.target_key}";
		if (dedup in self.seen_refs) return;
		self.seen_refs += dedup;

		val idx = self.refs.len;
		self.refs += r;

		val fp = self.refs_by_file[norm];
		if (fp != null) {
			var fl = fp.read();
			fl += idx;
			self.refs_by_file[norm] = fl;
		} else {
			var nl = List<usz>();
			nl += idx;
			self.refs_by_file[norm] = nl;
		}

		val kp = self.refs_by_key[r.target_key];
		if (kp != null) {
			var kl = kp.read();
			kl += idx;
			self.refs_by_key[r.target_key] = kl;
		} else {
			var nl = List<usz>();
			nl += idx;
			self.refs_by_key[r.target_key] = nl;
		}
	}

	pub fn find_ref_at(*self, file_path: str, line1: usz, col1: usz): RefInfo ! IndexErr {
		val norm = file_path.normalize_path();
		val list = self.refs_by_file.get_or(norm, List<usz>());
		var best = RefInfo("", "", "", 0, 0, 0);
		var found = false;
		var best_len: usz = 999999;
		for (idx in list) {
			val r = self.refs[idx];
			if (r.line == line1 && col1 >= r.col && col1 <= r.col + r.len) {
				if (!found || r.len <= best_len) {
					best = r;
					best_len = r.len;
					found = true;
				}
			}
		}
		if (!found) return IndexErr.NotFound;
		return best;
	}

	pub fn find_refs_for_key(*self, key: str, include_def: bool): List<RefInfo> {
		var out = List<RefInfo>();
		val idxs = self.refs_by_key.get_or(key, List<usz>());
		for (idx in idxs) {
			val r = self.refs[idx];
			if (!include_def && r.is_def) continue;
			out += r;
		}
		return out;
	}

	fn resolve_module_symbol_key(*self, mod_name: str, sym_name: str): str {
		val fk = "fn:${mod_name}:${sym_name}";
		if (fk in self.def_by_key) return fk;
		val sk = "struct:${mod_name}:${sym_name}";
		if (sk in self.def_by_key) return sk;
		val ok = "object:${mod_name}:${sym_name}";
		if (ok in self.def_by_key) return ok;
		val ek = "enum:${mod_name}:${sym_name}";
		if (ek in self.def_by_key) return ek;
		val tk = "trait:${mod_name}:${sym_name}";
		if (tk in self.def_by_key) return tk;
		val ck = "const:${mod_name}:${sym_name}";
		if (ck in self.def_by_key) return ck;
		return "";
	}

	fn resolve_visible_symbol_key(&self, file_path: str, cur_mod: str, name: str): str {
		// 1. Same module
		val local_mod_key = self.resolve_module_symbol_key(cur_mod, name);
		if (!local_mod_key.empty()) return local_mod_key;

		// 2. Imports in this file
		val norm = file_path.normalize_path();
		val imps_p = self.imports_by_file[norm];
		if (imps_p != null) {
			var imps = imps_p.read();
			for (i in 0..<imps.len) {
				val imp = imps[i];
				if (!imp.wildcard) {
					val eff = if (!imp.alias.empty()) imp.alias else imp.symbol_name;
					if (eff == name) {
						val k = self.resolve_module_symbol_key(imp.target_module, imp.symbol_name);
						if (!k.empty()) {
							if (!imp.used) {
								var item = imps[i];
								item.used = true;
								imps[i] = item;
								self.imports_by_file[norm] = imps;
							}
							return k;
						}
					}
				} else {
					val k = self.resolve_module_symbol_key(imp.target_module, name);
					if (!k.empty()) {
						if (!imp.used) {
							var item = imps[i];
							item.used = true;
							imps[i] = item;
							self.imports_by_file[norm] = imps;
						}
						return k;
					}
				}
			}
		}

		// 3. Fallback: O(1) lookup across indexed top-level symbols
		return self.top_key_by_name.get_or(name, "");
	}

	fn mark_import_used(&self, file_path: str, target_mod: str, sym_name: str) {
		if (file_path.empty() || target_mod.empty() || sym_name.empty()) return;
		val norm = file_path.normalize_path();
		val imps_p = self.imports_by_file[norm] ?: return;
		var imps = imps_p.read();
		var changed = false;
		for (i in 0..<imps.len) {
			val imp = imps[i];
			if (imp.used || imp.target_module != target_mod) continue;
			val match_explicit = !imp.wildcard && imp.symbol_name == sym_name;
			val match_wild = imp.wildcard;
			if (match_explicit || match_wild) {
				var item = imp;
				item.used = true;
				imps[i] = item;
				changed = true;
			}
		}
		if (changed) self.imports_by_file[norm] = imps;
	}

	fn find_struct_module(*self, struct_name: str, cur_mod: str): str {
		val same = "struct:${cur_mod}:${struct_name}";
		if (same in self.def_by_key) return cur_mod;
		val same_obj = "object:${cur_mod}:${struct_name}";
		if (same_obj in self.def_by_key) return cur_mod;
		return self.struct_mod_by_name.get_or(struct_name, cur_mod);
	}

	fn find_enum_module(*self, enum_name: str, cur_mod: str): str {
		val same = "enum:${cur_mod}:${enum_name}";
		if (same in self.def_by_key) return cur_mod;
		return self.enum_mod_by_name.get_or(enum_name, cur_mod);
	}

}

// ============================================================================
// Index Builder
// ============================================================================

struct IndexWalker {
	pub index: &SemanticIndex,
	pub cur_file: str,
	pub cur_mod: str,
	pub tokens: List<Token>,
	pub scopes: List<LocalScope> = List(),
	pub cur_when_enum: str = "",
	pub cur_when_enum_mod: str = "",
	pub cur_owner_key: str = "",
	pub cur_impl_struct: str = "",
	pub cur_impl_mod: str = "",
	pub cur_file_id: u32 = 0
}

impl IndexWalker {

	fn push_scope(&self) => self.scopes += LocalScope();

	fn pop_scope(&self) {
		if (!self.scopes.empty()) self.scopes.pop()!;
	}

	fn record_use(&self, key: str, line: usz, col: usz, len: usz, type_str: str = "") {
		self.index.add_ref(RefInfo(
			key, self.cur_file, self.cur_mod, line, col, len,
			false, false, false, type_str, self.cur_owner_key
		));
	}

	fn bind_local(
		&self, name: str, role: SymRole, line: usz, col: usz, type_str: str, is_mut: bool
	): isz {
		if (name.empty() || name == "_") return -1;
		val tok = if (role == SymRole.PARAM) find_param_token_after(self.tokens, line, col, name)
			else find_ident_token_after(self.tokens, line, col, name);
		val r_line = if (tok.line > 0) tok.line else line;
		val r_col = if (tok.col > 0) tok.col else col;
		val prefix = if (role == SymRole.PARAM) "param" else "local";
		val key = "${prefix}:${self.cur_file.normalize_path()}:${r_line}:${r_col}:${name}";
		val kw = if (role == SymRole.PARAM) "param" else if (is_mut) "var" else "val";
		val sig = "${kw} ${name}: ${type_str}";
		val container = if (role == SymRole.PARAM) self.cur_owner_key else "";

		val def_idx = self.index.add_def(DefInfo(
			key, name, role, self.cur_file, self.cur_mod, container,
			r_line, r_col, name.len, sig, type_str, false, is_mut, false
		));
		self.index.add_ref(RefInfo(
			key, self.cur_file, self.cur_mod, r_line, r_col, name.len,
			true, is_mut, false, type_str
		));

		if (!self.scopes.empty()) {
			val last_i = self.scopes.len - 1;
			var sc = self.scopes[last_i];
			sc.bindings += LocalBinding(name, key, def_idx);
			self.scopes[last_i] = sc;
		}
		return def_idx as isz;
	}

	fn lookup_local(*self, name: str): LocalBinding ! IndexErr {
		var i = self.scopes.len;
		while (i > 0) {
			i--;
			val sc = self.scopes[i];
			var j = sc.bindings.len;
			while (j > 0) {
				j--;
				val b = sc.bindings[j];
				if (b.name == name) return b;
			}
		}
		return IndexErr.NotFound;
	}

	fn mark_mutated(*self, node: ?*AstNode) {
		if (node == null) return;
		if (node is IdentifierExpr as id) {
			val lb = self.lookup_local(id.name) !: return;
			var d = self.index.defs[lb.def_idx];
			d.is_mutated = true;
			self.index.defs[lb.def_idx] = d;
		}
	}

	fn node_type_str(*self, node: ?*AstNode): str {
		if (node == null || !self.index.has_symtab) return "";
		val ty = self.index.symtab.get_node_type(node) ?: return "";
		return format_pretty_type(self.index.symtab, ty);
	}

	fn format_named_type_pretty(*self, name: str): str {
		if (self.index.has_symtab) {
			val rec_p = self.index.symtab.gen.record_map.get(name);
			if (rec_p != null) {
				val rec = rec_p.read();
				val base = strip_module_prefix(rec.template.name);
				if (!rec.args.empty()) {
					var sb = StringBuilder();
					defer sb.free();
					sb += base;
					sb += "<";
					for (i in 0..<rec.args.len) {
						if (i > 0) sb += ", ";
						val a_s = format_pretty_type(self.index.symtab, rec.args[i]);
						sb += if (a_s.empty()) "none" else a_s;
					}
					sb += ">";
					return sb.to_str();
				}
				return base;
			}
		}
		val vp_res = self.resolve_variant_named_type(name);
		if (vp_res is Pair<str, str> as vpair) {
			val vdef_res = self.index.get_def(vpair.first);
			if (vdef_res is DefInfo as vdef && !vdef.container.empty()) {
				return "${vdef.container}.${vdef.name}";
			}
			return vpair.second;
		}
		val c_key = self.index.c_name_to_key.get_or(name, "");
		if (!c_key.empty()) {
			val def_res = self.index.get_def(c_key);
			if (def_res is DefInfo as def && !def.name.empty()) return def.name;
		}
		return strip_module_prefix(name);
	}

	fn format_type_node_pretty(*self, node: ?*AstNode): str {
		if (node == null) return "none";
		when (node) {
			is NamedType -> {
				val base = self.format_named_type_pretty(node.name);
				if (node.type_args.empty()) return base;
				var sb = StringBuilder();
				defer sb.free();
				sb += base;
				sb += "<";
				for (i in 0..<node.type_args.len) {
					if (i > 0) sb += ", ";
					sb += self.format_type_node_pretty(node.type_args[i]);
				}
				sb += ">";
				return sb.to_str();
			}
			is PointerType -> {
				val prefix = (if (node.nullable) "?" else "") + (if (node.mutable) "&" else "*");
				return prefix + self.format_type_node_pretty(node.pointee);
			}
			is VariadicType -> return ".." + self.format_type_node_pretty(node.element_type);
			is ArrayType -> return "[${self.format_type_node_pretty(node.element_type)}; ${node.size}]";
			is ArrayLiteralExpr -> {
				var sb = StringBuilder();
				defer sb.free();
				sb += "[";
				for (i in 0..<node.elements.len) {
					if (i > 0) sb += ", ";
					sb += self.format_type_node_pretty(node.elements[i]);
				}
				sb += "]";
				return sb.to_str();
			}
			is FnType -> {
				var sb = StringBuilder();
				defer sb.free();
				sb += "fn(";
				for (i in 0..<node.param_types.len) {
					if (i > 0) sb += ", ";
					sb += self.format_type_node_pretty(node.param_types[i]);
				}
				sb += "): ";
				sb += self.format_type_node_pretty(node.return_type);
				return sb.to_str();
			}
			is ErrorUnionType -> {
				if (node.ok_type != null) {
					return "${self.format_type_node_pretty(node.ok_type!)} ! ${self.format_type_node_pretty(node.err_type)}";
				}
				return "!${self.format_type_node_pretty(node.err_type)}";
			}
			else -> return "any";
		}
	}

	fn resolve_variant_named_type(*self, type_name: str): Pair<str, str> ! IndexErr {
		if (type_name.empty()) return IndexErr.NotFound;
		// 1. BodyChecker-mangled variant type: `<c_enum>__<Variant>`
		if (type_name !in self.index.c_name_to_key && type_name.len >= 3) {
			var split_i: isz = -1;
			var idx = type_name.len - 2;
			while (true) {
				if (type_name[idx] == '_' && type_name[idx + 1] == '_') {
					split_i = idx as isz;
					break;
				}
				if (idx == 0) break;
				idx--;
			}
			if (split_i > 0) {
				val s_u = split_i as usz;
				val prefix = type_name.slice(0, s_u);
				val vname = type_name.slice(s_u + 2, type_name.len);
				val e_key = self.index.c_name_to_key.get_or(prefix, "");
				if (!e_key.empty() && !vname.empty()) {
					val edef_res = self.index.get_def(e_key);
					if (edef_res is DefInfo as edef) {
						val v_key = "variant:${edef.module_name}:${edef.name}:${vname}";
						if (v_key in self.index.def_by_key) return Pair<str, str>(v_key, vname);
					}
				}
			}
		}
		// 2. Unmangled shorthand `.Variant` inside `when` on enum / error union
		if (type_name.starts_with(".") && !self.cur_when_enum.empty()) {
			val vname = type_name.slice(1, type_name.len);
			val v_key = "variant:${self.cur_when_enum_mod}:${self.cur_when_enum}:${vname}";
			if (v_key in self.index.def_by_key) return Pair<str, str>(v_key, vname);
		}
		// 3. Unmangled `Enum.Variant` / `Fault.Variant`
		val di = type_name.index_of(".") !: return IndexErr.NotFound;
		if (di > 0) {
			val ename = type_name.slice(0, di);
			val vname = type_name.slice(di + 1, type_name.len);
			if (!vname.empty()) {
				val e_key = self.index.resolve_visible_symbol_key(self.cur_file, self.cur_mod, ename);
				if (!e_key.empty()) {
					val edef_res = self.index.get_def(e_key);
					if (edef_res is DefInfo as edef) {
						val v_key = "variant:${edef.module_name}:${edef.name}:${vname}";
						if (v_key in self.index.def_by_key) return Pair<str, str>(v_key, vname);
					}
				}
			}
		}
		return IndexErr.NotFound;
	}

	fn resolve_c_inst_key(&self, cname: str): Pair<str, str> ! IndexErr {
		val base_inst = self.index.c_inst_to_base.get_or(cname, "");
		if (base_inst.empty()) return IndexErr.NotFound;
		val sep = base_inst.index_of(":") !: return IndexErr.NotFound;
		if (sep == 0 || sep + 1 >= base_inst.len) return IndexErr.NotFound;
		val bmod = base_inst.slice(0, sep);
		val bname = base_inst.slice(sep + 1, base_inst.len);
		val k = self.index.resolve_module_symbol_key(bmod, bname);
		if (k.empty()) return IndexErr.NotFound;
		self.index.mark_import_used(self.cur_file, bmod, bname);
		return Pair(k, bname);
	}

	fn walk_type_node(&self, node: ?*AstNode) {
		if (node == null) return;
		val nl = node.line;
		val nc = node.col;
		when (node) {
			is NamedType -> {
				var key = self.index.resolve_visible_symbol_key(self.cur_file, self.cur_mod, node.name);
				var snap_name = node.name;
				if (key.empty()) {
					val vp_res = self.resolve_variant_named_type(node.name);
					if (vp_res is Pair<str, str> as vpair) {
						key = vpair.first;
						snap_name = vpair.second;
					}
				}
				if (key.empty()) {
					val inst_res = self.resolve_c_inst_key(node.name);
					if (inst_res is Pair<str, str> as ip) {
						key = ip.first;
						snap_name = ip.second;
					}
				}
				if (key.empty()) {
					key = self.index.c_name_to_key.get_or(node.name, "");
					if (!key.empty()) {
						val def_res = self.index.get_def(key);
						if (def_res is DefInfo as def && !def.name.empty()) {
							snap_name = def.name;
							self.index.mark_import_used(self.cur_file, def.module_name, def.name);
						}
					}
				}
				if (!key.empty()) {
					val tok = find_ident_token_after(self.tokens, nl, nc, snap_name);
					val r_line = if (tok.line > 0) tok.line else nl;
					val r_col = if (tok.col > 0) tok.col else nc;
					self.record_use(key, r_line, r_col, snap_name.len, snap_name);
				}
				for (ta in node.type_args) self.walk_type_node(ta);
			}
			is PointerType -> self.walk_type_node(node.pointee);
			is VariadicType -> self.walk_type_node(node.element_type);
			is ArrayType -> self.walk_type_node(node.element_type);
			is ArrayLiteralExpr -> for (el in node.elements) self.walk_type_node(el);
			is FnType -> {
				for (pt in node.param_types) self.walk_type_node(pt);
				self.walk_type_node(node.return_type);
			}
			is ErrorUnionType -> {
				if (node.ok_type != null) self.walk_type_node(node.ok_type);
				self.walk_type_node(node.err_type);
			}
		}
	}

	fn walk_decl_pass(&self, prog: *AstNode) {
		if (prog is Program as p) {
		for (decl in p) {
			val raw_decl = decl;
			val dl = decl.line;
			val dc = decl.col;
			when (decl) {
				is ModuleDecl -> {
					val key = "module:${decl.full_path}";
					self.index.add_def(DefInfo(
						key, decl.full_path, SymRole.MODULE, self.cur_file, decl.full_path, "",
						dl, dc, decl.full_path.len, "mod ${decl.full_path}", "module", true
					));
				}
				is UseDecl -> {
					val target_mod = when (decl) {
						.wildcard -> str_join_dots(decl.path, decl.path.len);
						.path.len >= 2 -> str_join_dots(decl.path, decl.path.len - 1);
						else -> "";
					};
					if (!target_mod.empty()) {
						self.index.dep_graph.add_edge(self.cur_mod, target_mod);
						val end_c = find_line_end_col(self.tokens, dl);
						val norm = self.cur_file.normalize_path();
						var imps = self.index.imports_by_file.get_or(norm, List<ImportInfo>());
						imps += ImportInfo(
							self.cur_file, self.cur_mod, target_mod,
							decl.symbol_name, decl.alias, decl.wildcard,
							dl, dc, dl, end_c, false
						);
						self.index.imports_by_file[norm] = imps;
					}
				}
				is StructDecl -> {
					val key = "struct:${self.cur_mod}:${decl.name}";
					self.index.orig_node_names[raw_decl.addr()] = decl.name;
					self.index.orig_node_keys[raw_decl.addr()] = key;
					val tok = find_ident_token_after(self.tokens, dl, dc, decl.name);
					val r_line = if (tok.line > 0) tok.line else dl;
					val r_col = if (tok.col > 0) tok.col else dc;
					self.index.add_def(DefInfo(
						key, decl.name, SymRole.STRUCT, self.cur_file, self.cur_mod, "",
						r_line, r_col, decl.name.len, "struct ${decl.name}", decl.name, decl.public
					));
					self.index.add_ref(RefInfo(
						key, self.cur_file, self.cur_mod, r_line, r_col, decl.name.len,
						true, false, false, decl.name
					));
					for (f in decl.fields) {
						val f_key = "field:${self.cur_mod}:${decl.name}:${f.name}";
						val f_tok = find_ident_token_after(self.tokens, f.type_node.line, 1, f.name);
						val fl = if (f_tok.line > 0) f_tok.line else f.type_node.line;
						val fc = if (f_tok.col > 0) f_tok.col else 1;
						val ft = format_type_node(f.type_node);
						self.index.add_def(DefInfo(
							f_key, f.name, SymRole.FIELD, self.cur_file, self.cur_mod, decl.name,
							fl, fc, f.name.len, "${f.name}: ${ft}", ft, f.public, true
						));
						self.index.add_ref(RefInfo(
							f_key, self.cur_file, self.cur_mod, fl, fc, f.name.len,
							true, false, false, ft
						));
					}
				}
				is EnumDecl -> self.add_tagged_decl_def(decl.name, "enum", decl.public, decl.members, raw_decl, dl, dc);
				is FaultDecl -> self.add_tagged_decl_def(decl.name, "fault", decl.public, decl.members, raw_decl, dl, dc);
				is TraitDecl -> {
					val key = "trait:${self.cur_mod}:${decl.name}";
					self.index.orig_node_names[raw_decl.addr()] = decl.name;
					self.index.orig_node_keys[raw_decl.addr()] = key;
					val tok = find_ident_token_after(self.tokens, dl, dc, decl.name);
					val r_line = if (tok.line > 0) tok.line else dl;
					val r_col = if (tok.col > 0) tok.col else dc;
					self.index.add_def(DefInfo(
						key, decl.name, SymRole.TRAIT, self.cur_file, self.cur_mod, "",
						r_line, r_col, decl.name.len, "trait ${decl.name}", decl.name, decl.public
					));
					self.index.add_ref(RefInfo(
						key, self.cur_file, self.cur_mod, r_line, r_col, decl.name.len,
						true, false, false, decl.name
					));
					for (m in decl.methods) {
						val raw_m = m;
						if (m is FnDecl) self.register_fn_def(raw_m, decl.name, self.cur_mod, true);
					}
				}
				is ConstDecl -> {
					val key = "const:${self.cur_mod}:${decl.name}";
					self.index.orig_node_names[raw_decl.addr()] = decl.name;
					self.index.orig_node_keys[raw_decl.addr()] = key;
					val tok = find_ident_token_after(self.tokens, dl, dc, decl.name);
					val r_line = if (tok.line > 0) tok.line else dl;
					val r_col = if (tok.col > 0) tok.col else dc;
					val ty_s = format_type_node(decl.type_node);
					self.index.add_def(DefInfo(
						key, decl.name, SymRole.CONST, self.cur_file, self.cur_mod, "",
						r_line, r_col, decl.name.len, "const ${decl.name}: ${ty_s}", ty_s, decl.public
					));
					self.index.add_ref(RefInfo(
						key, self.cur_file, self.cur_mod, r_line, r_col, decl.name.len,
						true, false, false, ty_s
					));
				}
				is FnDecl -> self.register_fn_def(raw_decl, "");
				is ImplDecl -> {
					self.index.orig_node_names[raw_decl.addr()] = decl.struct_name;
					val s_mod = self.index.find_struct_module(decl.struct_name, self.cur_mod);
					val is_tr = !decl.trait_name.empty();
					for (m in decl.methods) {
						val raw_m = m;
						if (m is FnDecl) self.register_fn_def(raw_m, decl.struct_name, s_mod, is_tr);
					}
				}
				is ObjectDecl -> {
					val key = "object:${self.cur_mod}:${decl.name}";
					self.index.orig_node_names[raw_decl.addr()] = decl.name;
					self.index.orig_node_keys[raw_decl.addr()] = key;
					self.index.struct_mod_by_name[decl.name] = self.cur_mod;
					val tok = find_ident_token_after(self.tokens, dl, dc, decl.name);
					val r_line = if (tok.line > 0) tok.line else dl;
					val r_col = if (tok.col > 0) tok.col else dc;
					self.index.add_def(DefInfo(
						key, decl.name, SymRole.OBJECT, self.cur_file, self.cur_mod, "",
						r_line, r_col, decl.name.len, "object ${decl.name}", decl.name, decl.public
					));
					self.index.add_ref(RefInfo(
						key, self.cur_file, self.cur_mod, r_line, r_col, decl.name.len,
						true, false, false, decl.name
					));
					for (cnode in decl.consts) {
						val raw_c = cnode;
						if (cnode is ConstDecl as cd) {
							val ck = "const:${self.cur_mod}:${decl.name}__${cd.name}";
							self.index.orig_node_names[raw_c.addr()] = cd.name;
							self.index.orig_node_keys[raw_c.addr()] = ck;
							val ctok = find_ident_token_after(self.tokens, raw_c.line, raw_c.col, cd.name);
							val cl = if (ctok.line > 0) ctok.line else raw_c.line;
							val cc = if (ctok.col > 0) ctok.col else raw_c.col;
							val cty = format_type_node(cd.type_node);
							self.index.add_def(DefInfo(
								ck, cd.name, SymRole.CONST, self.cur_file, self.cur_mod, decl.name,
								cl, cc, cd.name.len, "const ${decl.name}.${cd.name}: ${cty}", cty, cd.public
							));
							self.index.add_ref(RefInfo(
								ck, self.cur_file, self.cur_mod, cl, cc, cd.name.len,
								true, false, false, cty
							));
						}
					}
					for (m in decl.methods) {
						val raw_m = m;
						if (m is FnDecl) self.register_fn_def(raw_m, decl.name, self.cur_mod, false);
					}
				}
				is ExternBlock -> {
					for (ed in decl.declarations) {
						val raw_ed = ed;
						if (ed is FnDecl) self.register_fn_def(raw_ed, "", "", false, true);
					}
				}
			}
		}
		}
	}

	fn register_fn_def(
		&self,
		fn_node: *AstNode,
		container: str,
		container_mod: str = "",
		is_trait_impl: bool = false,
		is_extern: bool = false
	) {
		val fl = fn_node.line;
		val fc = fn_node.col;
		if (fn_node is FnDecl as f) {
		val mod_owner = if (!container_mod.empty()) container_mod else self.cur_mod;
		val key = if (container.empty()) "fn:${self.cur_mod}:${f.name}"
			else "method:${mod_owner}:${container}:${f.name}";
		self.index.orig_node_names[fn_node.addr()] = f.name;
		self.index.orig_node_keys[fn_node.addr()] = key;
		val role = if (container.empty()) SymRole.FN else SymRole.METHOD;
		val has_body = !is_extern && f.body != null;
		val is_special = f.initializer || f.operator || f.name == "main";

		val search_name = if (f.initializer) "init" else f.name;
		val tok = find_ident_token_after(self.tokens, fl, fc, search_name);
		val r_line = if (tok.line > 0) tok.line else fl;
		val r_col = if (tok.col > 0) tok.col else fc;

		val sig = format_fn_signature(f.name, f.type_params, f.params, f.return_type, f.operator, f.initializer);
		var p_names = List<str>();
		var p_types = List<str>();
		var is_vararg = false;
		for (p in f.params) {
			if (p.name == "self") continue;
			p_names += p.name;
			val pt = format_type_node(p.type_node);
			p_types += pt;
			if (p.type_node is VariadicType) is_vararg = true;
		}
		val ret_s = format_type_node(f.return_type);

		self.index.add_def(DefInfo(
			key, f.name, role, self.cur_file, self.cur_mod, container,
			r_line, r_col, search_name.len, sig, ret_s, f.public, false, false,
			is_vararg, p_names, p_types, ret_s, has_body, is_trait_impl, is_special
		));
		if (!f.initializer && !f.operator) {
			self.index.add_ref(RefInfo(
				key, self.cur_file, self.cur_mod, r_line, r_col, f.name.len,
				true, false, false, sig
			));
		}
		}
	}

	fn walk_body_pass(&self, prog: *AstNode) {
		if (prog is Program as p) {
		for (decl in p) {
			val raw_decl = decl;
			val dl = decl.line;
			val dc = decl.col;
			when (decl) {
				is UseDecl -> {
					if (!decl.wildcard && !decl.symbol_name.empty()) {
						val target_mod = if (decl.path.len >= 2) str_join_dots(decl.path, decl.path.len - 1) else "";
						if (!target_mod.empty()) {
							val key = self.index.resolve_module_symbol_key(target_mod, decl.symbol_name);
							if (!key.empty()) {
								val tok = find_ident_token_after(self.tokens, dl, dc, decl.symbol_name);
								val r_line = if (tok.line > 0) tok.line else dl;
								val r_col = if (tok.col > 0) tok.col else dc;
								self.index.add_ref(RefInfo(
									key, self.cur_file, self.cur_mod, r_line, r_col, decl.symbol_name.len,
									false, false, true, ""
								));
							}
						}
					}
				}
				is StructDecl -> {
					self.cur_owner_key = self.index.orig_node_keys.get_or(raw_decl.addr(), "");
					for (f in decl.fields) {
						self.walk_type_node(f.type_node);
						if (f.default_val != null) self.walk_expr(f.default_val);
					}
					self.cur_owner_key = "";
				}
				is EnumDecl -> {
					self.cur_owner_key = self.index.orig_node_keys.get_or(raw_decl.addr(), "");
					if (decl.underlying_type != null) self.walk_type_node(decl.underlying_type);
					for (m in decl.members) {
						if (m.value != null) self.walk_expr(m.value);
						for (pf in m.payload) self.walk_type_node(pf.type_node);
					}
					self.cur_owner_key = "";
				}
				is FaultDecl -> {
					self.cur_owner_key = self.index.orig_node_keys.get_or(raw_decl.addr(), "");
					for (m in decl.members) {
						for (pf in m.payload) self.walk_type_node(pf.type_node);
					}
					self.cur_owner_key = "";
				}
				is TraitDecl -> {
					val t_key = self.index.orig_node_keys.get_or(raw_decl.addr(), "");
					self.cur_owner_key = t_key;
					for (m in decl.methods) self.walk_fn_body(m);
					self.cur_owner_key = "";
				}
				is ImplDecl -> {
					val orig_sname = self.index.orig_node_names.get_or(raw_decl.addr(), decl.struct_name);
					self.cur_owner_key = if (!decl.trait_name.empty()) "" else "__impl_hdr__";
					if (!orig_sname.empty()) {
						val s_key = self.index.resolve_visible_symbol_key(self.cur_file, self.cur_mod, orig_sname);
						if (!s_key.empty()) {
							val stok = find_ident_token_after(self.tokens, dl, dc, orig_sname);
							val sl = if (stok.line > 0) stok.line else dl;
							val sc = if (stok.col > 0) stok.col else dc;
							self.record_use(s_key, sl, sc, orig_sname.len);
						}
					}
					if (!decl.trait_name.empty()) {
						val t_key = self.index.resolve_visible_symbol_key(self.cur_file, self.cur_mod, decl.trait_name);
						if (!t_key.empty()) {
							val ttok = find_ident_token_after(self.tokens, dl, dc, decl.trait_name);
							val tl = if (ttok.line > 0) ttok.line else dl;
							val tc = if (ttok.col > 0) ttok.col else dc;
							self.record_use(t_key, tl, tc, decl.trait_name.len);
						}
						self.check_missing_trait_methods(raw_decl, dl, dc);
					}
					self.cur_owner_key = "";
					val prev_impl_st = self.cur_impl_struct;
					val prev_impl_mod = self.cur_impl_mod;
					if (!orig_sname.empty()) {
						self.cur_impl_struct = orig_sname;
						self.cur_impl_mod = self.index.find_struct_module(orig_sname, self.cur_mod);
					}
					for (m in decl.methods) self.walk_fn_body(m);
					self.cur_impl_struct = prev_impl_st;
					self.cur_impl_mod = prev_impl_mod;
				}
				is ObjectDecl -> {
					val orig_oname = self.index.orig_node_names.get_or(raw_decl.addr(), decl.name);
					val prev_impl_st = self.cur_impl_struct;
					val prev_impl_mod = self.cur_impl_mod;
					self.cur_impl_struct = orig_oname;
					self.cur_impl_mod = self.cur_mod;
					for (cnode in decl.consts) {
						val raw_c = cnode;
						if (cnode is ConstDecl as cd) {
							self.cur_owner_key = self.index.orig_node_keys.get_or(raw_c.addr(), "");
							if (cd.type_node != null) self.walk_type_node(cd.type_node);
							if (cd.value != null) self.walk_expr(cd.value);
						}
					}
					self.cur_owner_key = "";
					for (m in decl.methods) self.walk_fn_body(m);
					self.cur_impl_struct = prev_impl_st;
					self.cur_impl_mod = prev_impl_mod;
				}
				is ConstDecl -> {
					self.cur_owner_key = self.index.orig_node_keys.get_or(raw_decl.addr(), "");
					if (decl.type_node != null) self.walk_type_node(decl.type_node);
					if (decl.value != null) self.walk_expr(decl.value);
					self.cur_owner_key = "";
				}
				is FnDecl -> self.walk_fn_body(raw_decl);
				is ExternBlock -> {
					self.cur_owner_key = "";
					for (ed in decl.declarations) self.walk_fn_body(ed);
				}
			}
		}
		}
	}

	fn check_missing_trait_methods(*self, impl_node: *AstNode, imp_line: usz, imp_col: usz) {
		if (!self.index.has_symtab) return;
		if (impl_node is ImplDecl as imp) {
		val orig_sname = self.index.orig_node_names.get_or(impl_node.addr(), imp.struct_name);
		val trait_p = self.index.symtab.trait_map.get(imp.trait_name) ?: return;
		val trait_info = trait_p.read();

		var implemented = HashSet<str>();
		for (m in imp.methods) {
			val raw_m = m;
			if (m is FnDecl as f) {
				implemented += self.index.orig_node_names.get_or(raw_m.addr(), f.name);
			}
		}

		var stubs = List<str>();
		for (tm in trait_info.methods) {
			if (!tm.has_default && tm.name !in implemented) {
				if (tm.node is FnDecl as tf) {
					val sig = format_fn_signature(tf.name, tf.type_params, tf.params, tf.return_type, tf.operator, tf.initializer);
					stubs += "\tpub ${sig} {\n\t\t\n\t}";
				}
			}
		}

		if (!stubs.empty()) {
			val norm = self.cur_file.normalize_path();
			var list = self.index.missing_impls_by_file.get_or(norm, List<ImplMissingInfo>());
			list += ImplMissingInfo(self.cur_file, orig_sname, imp.trait_name, imp_line, imp_col, stubs);
			self.index.missing_impls_by_file[norm] = list;
		}
		}
	}

	fn walk_fn_body(&self, fn_node: *AstNode) {
		val fl = fn_node.line;
		val fc = fn_node.col;
		if (fn_node is FnDecl as f) {
		val prev_owner = self.cur_owner_key;
		val fn_key = self.index.orig_node_keys.get_or(fn_node.addr(), "");
		if (!fn_key.empty()) self.cur_owner_key = fn_key;
		self.push_scope();
		var p_line = fl;
		var p_col = fc;
		var ti = find_token_index_at_line(self.tokens, fl);
		while (ti < self.tokens.len) {
			val t = self.tokens[ti];
			if (t.line > fl + 6) break;
			if (t.line > fl || t.col >= fc) {
				if (t.type == TokenType.OPEN_PAREN) {
					p_line = t.line;
					p_col = t.col + 1;
					break;
				}
			}
			ti++;
		}
		for (p in f.params) {
			if (p.type_node != null) self.walk_type_node(p.type_node);
			if (p.default_val != null) self.walk_expr(p.default_val);
			if (p.name != "self") {
				val pt = self.format_type_node_pretty(p.type_node);
				self.bind_local(p.name, SymRole.PARAM, p_line, p_col, pt, false);
				val p_tok = find_param_token_after(self.tokens, p_line, p_col, p.name);
				if (p_tok.line > 0) {
					p_line = p_tok.line;
					p_col = p_tok.col + p.name.len;
				}
			}
		}
		if (f.return_type != null) self.walk_type_node(f.return_type);
		if (f.body != null) self.walk_stmt(f.body);
		self.pop_scope();
		self.cur_owner_key = prev_owner;
		}
	}

	fn walk_stmt(&self, node: ?*AstNode) {
		if (node == null) return;
		val nl = node.line;
		val nc = node.col;
		when (node) {
			is BlockStmt -> {
				self.push_scope();
				for (s in node.statements) self.walk_stmt(s);
				self.pop_scope();
			}
			is ExprStmt -> self.walk_expr(node.expr);
			is VarDeclStmt -> {
				if (node.type_annotation != null) self.walk_type_node(node.type_annotation);
				if (node.initializer != null) self.walk_expr(node.initializer);
				var ty_s = self.node_type_str(node.initializer);
				if (ty_s.empty() && node.type_annotation != null) ty_s = self.format_type_node_pretty(node.type_annotation);
				if (ty_s.empty()) ty_s = "any";
				val d_idx = self.bind_local(node.name, SymRole.LOCAL, nl, nc, ty_s, node.mutable);
				if (d_idx >= 0 && node.mutable && self.index.has_symtab && self.cur_file_id > 0) {
					val v_key = "V:${self.cur_file_id}:${nl}:${nc}";
					val sem = self.index.symtab.sem;
					if (v_key in sem.checked_var_decls) {
						val idx_u = d_idx as usz;
						var def = self.index.defs[idx_u];
						def.has_mut_check = true;
						if (v_key in sem.mutated_decl_keys) def.is_mutated = true;
						self.index.defs[idx_u] = def;
					}
				}
			}
			is DestructDeclStmt -> {
				self.walk_expr(node.initializer);
				for (n in node.names) {
					self.bind_local(n, SymRole.LOCAL, nl, nc, "any", node.mutable);
				}
			}
			is IfStmt -> {
				self.push_scope();
				self.walk_expr(node.condition);
				self.walk_stmt(node.then_branch);
				self.pop_scope();
				if (node.else_branch != null) self.walk_stmt(node.else_branch);
			}
			is WhileStmt -> {
				self.push_scope();
				self.walk_expr(node.condition);
				self.walk_stmt(node.body);
				self.pop_scope();
			}
			is ForStmt -> {
				self.push_scope();
				if (node.iterable != null) self.walk_expr(node.iterable);
				if (node.range_start != null) self.walk_expr(node.range_start);
				if (node.range_end != null) self.walk_expr(node.range_end);
				val vn = node.var_name;
				val is_var_destruct = vn.starts_with("var (") && vn.ends_with(")");
				val is_val_destruct = vn.starts_with("(") && vn.ends_with(")");
				if (is_var_destruct || is_val_destruct) {
					val raw = if (is_var_destruct) vn.slice(5, vn.len - 1) else vn.slice(1, vn.len - 1);
					var start: isz = -1;
					for (i in 0..<raw.len) {
						val ch = raw[i];
						if (ch == ',' || ch == ' ' || ch == '\t') {
							if (start >= 0) {
								self.bind_local(raw.slice(start as usz, i), SymRole.LOCAL, nl, nc, "any", is_var_destruct);
								start = -1;
							}
						} else if (start < 0) {
							start = i as isz;
						}
					}
					if (start >= 0) {
						self.bind_local(raw.slice(start as usz), SymRole.LOCAL, nl, nc, "any", is_var_destruct);
					}
				} else {
					self.bind_local(vn, SymRole.LOCAL, nl, nc, "any", false);
				}
				self.walk_stmt(node.body);
				self.pop_scope();
			}
			is ReturnStmt -> if (node.value != null) self.walk_expr(node.value);
			is YieldStmt -> if (node.value != null) self.walk_expr(node.value);
			is DeferStmt -> self.walk_stmt(node.body);
			is WhenStmt -> self.walk_when(node.condition, node.arms);
			else -> self.walk_expr(node);
		}
	}

	fn walk_when(&self, cond: ?*AstNode, arms: List<WhenArm>) {
		val prev_enum = self.cur_when_enum;
		val prev_mod = self.cur_when_enum_mod;
		if (cond != null) {
			self.walk_expr(cond);
			if (self.index.has_symtab) {
				val c_ty = unwrap_base_type(self.index.symtab.get_node_type(cond));
				if (c_ty != null) {
					val e_info = if (c_ty.kind == DataType.ERROR_UNION) c_ty.as_error_union()!.err.as_enum()
						else c_ty.as_enum();
					if (e_info != null) {
						self.cur_when_enum = e_info.name;
						self.cur_when_enum_mod = self.index.find_enum_module(e_info.name, self.cur_mod);
					}
				}
			}
		}
		for (arm in arms) {
			self.push_scope();
			for (pat in arm.patterns) self.walk_expr(pat);
			self.walk_stmt(arm.body);
			self.pop_scope();
		}
		self.cur_when_enum = prev_enum;
		self.cur_when_enum_mod = prev_mod;
	}

	fn walk_expr(&self, node: ?*AstNode) {
		if (node == null) return;
		val raw_node = node;
		val nl = node.line;
		val nc = node.col;
		val ty_s = self.node_type_str(node);
		when (node) {
			is IdentifierExpr -> {
				val lb_res = self.lookup_local(node.name);
				if (lb_res is LocalBinding as lb) {
					self.record_use(lb.key, nl, nc, node.name.len, ty_s);
					return;
				}
				var key = self.index.resolve_visible_symbol_key(self.cur_file, self.cur_mod, node.name);
				var ref_len = node.name.len;
				if (key.empty()) {
					val inst_res = self.resolve_c_inst_key(node.name);
					if (inst_res is Pair<str, str> as ip) {
						key = ip.first;
						ref_len = ip.second.len;
					}
				}
				if (key.empty()) {
					key = self.index.c_name_to_key.get_or(node.name, "");
					if (!key.empty()) {
						val def_res = self.index.get_def(key);
						if (def_res is DefInfo as def && !def.name.empty()) {
							ref_len = def.name.len;
							self.index.mark_import_used(self.cur_file, def.module_name, def.name);
						}
					}
				}
				if (!key.empty()) {
					self.record_use(key, nl, nc, ref_len, ty_s);
				}
			}
			is MemberExpr -> {
				self.walk_expr(node.object);
				val m_tok = find_member_token_after(self.tokens, nl, nc, node.member);
				val ml = if (m_tok.line > 0) m_tok.line else nl;
				val mc = if (m_tok.col > 0) m_tok.col else nc;

				var target_key = "";
				// 1. Check resolved method from SemanticTable
				if (self.index.has_symtab) {
					val mi = self.index.symtab.get_resolved_method(raw_node);
					val rec_ty = unwrap_base_type(self.index.symtab.get_node_type(node.object));
					if (mi != null && rec_ty != null) {
						val st = rec_ty.as_struct();
						if (st != null) {
							val raw_smod = if (!st.module.empty()) st.module else self.index.find_struct_module(st.name, self.cur_mod);
							val base_pair = self.index.c_inst_to_base.get_or(st.c_name, "");
							if (!base_pair.empty()) {
								target_key = "method:${base_pair}:${node.member}";
							} else {
								target_key = "method:${raw_smod}:${st.name}:${node.member}";
							}
						} else {
							val type_name = rec_ty.to_str();
							val p_mod = self.index.find_struct_module(type_name, self.cur_mod);
							val p_key = "method:${p_mod}:${type_name}:${node.member}";
							if (p_key in self.index.def_by_key) target_key = p_key;
						}
					} else if (mi != null && !mi.c_name.empty()) {
						target_key = self.index.c_name_to_key.get_or(mi.c_name, "");
					}
					// 2. Check object type for struct field or enum variant
					if (target_key.empty() && rec_ty != null) {
						val st = rec_ty.as_struct();
						if (st != null) {
							val raw_smod = if (!st.module.empty()) st.module else self.index.find_struct_module(st.name, self.cur_mod);
							val base_pair = self.index.c_inst_to_base.get_or(st.c_name, "");
							val mod_and_name = if (!base_pair.empty()) base_pair else "${raw_smod}:${st.name}";
							val f_key = "field:${mod_and_name}:${node.member}";
							val m_key = "method:${mod_and_name}:${node.member}";
							if (f_key in self.index.def_by_key) target_key = f_key;
							else if (m_key in self.index.def_by_key) target_key = m_key;
						} else {
							val en = rec_ty.as_enum();
							if (en != null) {
								val e_mod = self.index.find_enum_module(en.name, self.cur_mod);
								val v_key = "variant:${e_mod}:${en.name}:${node.member}";
								if (v_key in self.index.def_by_key) target_key = v_key;
							} else {
								val type_name = rec_ty.to_str();
								val p_mod = self.index.find_struct_module(type_name, self.cur_mod);
								val p_key = "method:${p_mod}:${type_name}:${node.member}";
								if (p_key in self.index.def_by_key) target_key = p_key;
							}
						}
					}
				}
				// 3. Implicit Enum.VARIANT, Self/self on impl/object, or leading-dot .VARIANT in when
				if (target_key.empty()) {
					if (node.object is IdentifierExpr as id && id.name in ["self", "Self"] && !self.cur_impl_struct.empty()) {
						val m_key = "method:${self.cur_impl_mod}:${self.cur_impl_struct}:${node.member}";
						val f_key = "field:${self.cur_impl_mod}:${self.cur_impl_struct}:${node.member}";
						val c_key = "const:${self.cur_impl_mod}:${self.cur_impl_struct}__${node.member}";
						if (m_key in self.index.def_by_key) target_key = m_key;
						else if (f_key in self.index.def_by_key) target_key = f_key;
						else if (c_key in self.index.def_by_key) target_key = c_key;
					} else if (node.object is IdentifierExpr as id && !id.name.empty()) {
						val e_mod = self.index.find_enum_module(id.name, self.cur_mod);
						val v_key = "variant:${e_mod}:${id.name}:${node.member}";
						if (v_key in self.index.def_by_key) target_key = v_key;
						else {
							val s_mod = self.index.find_struct_module(id.name, self.cur_mod);
							val m_key = "method:${s_mod}:${id.name}:${node.member}";
							val c_key = "const:${s_mod}:${id.name}__${node.member}";
							if (m_key in self.index.def_by_key) target_key = m_key;
							else if (c_key in self.index.def_by_key) target_key = c_key;
						}
					} else if (!self.cur_when_enum.empty()) {
						val v_key = "variant:${self.cur_when_enum_mod}:${self.cur_when_enum}:${node.member}";
						if (v_key in self.index.def_by_key) target_key = v_key;
					}
				}

				if (target_key.empty() && self.index.has_symtab && !ty_s.empty()) {
					val rec_ty = unwrap_base_type(self.index.symtab.get_node_type(node.object));
					if (rec_ty != null) {
						var b_key = "";
						var b_mod = "";
						var b_container = "";
						if (rec_ty.kind == DataType.STR && node.member in ["len", "data"]) {
							b_key = "builtin:str:${node.member}";
							b_mod = "std.str";
							b_container = "str";
						} else if (rec_ty.kind == DataType.ARRAY && node.member == "len") {
							b_key = "builtin:array:len";
							b_mod = "std.collections";
							b_container = "Array";
						} else if (
							rec_ty.as_enum()?.is_fault &&
							node.member in ["code", "name", "message", "description"]
						) {
							b_key = "builtin:fault:${node.member}";
							b_mod = "";
							b_container = rec_ty.as_enum()!.name;
						}
						if (!b_key.empty()) {
							if (b_key !in self.index.def_by_key) {
								self.index.add_def(DefInfo(
									b_key, node.member, SymRole.FIELD, "", b_mod, b_container,
									0, 0, node.member.len, "${node.member}: ${ty_s}", ty_s, true
								));
							}
							target_key = b_key;
						}
					}
				}

				if (!target_key.empty()) {
					self.record_use(target_key, ml, mc, node.member.len, ty_s);
				}
			}
			is CallExpr -> {
				self.walk_expr(node.callee);
				for (ta in node.type_args) self.walk_type_node(ta);
				for (a in node.args) self.walk_expr(a);
			}
			is BinaryExpr -> {
				self.walk_expr(node.left);
				self.walk_expr(node.right);
			}
			is UnaryExpr -> {
				if (node.op in [TokenType.AMPERSAND, TokenType.PLUS_PLUS, TokenType.MINUS_MINUS]) {
					self.mark_mutated(node.operand);
				}
				self.walk_expr(node.operand);
			}
			is AssignExpr -> {
				self.mark_mutated(node.target);
				self.walk_expr(node.target);
				self.walk_expr(node.value);
			}
			is UpdateExpr -> {
				self.mark_mutated(node.target);
				self.walk_expr(node.target);
			}
			is IndexExpr -> {
				self.walk_expr(node.target);
				self.walk_expr(node.index);
			}
			is CastExpr -> {
				if (node.expr != null) self.walk_expr(node.expr);
				self.walk_type_node(node.target_type);
			}
			is GroupExpr -> self.walk_expr(node.expr);
			is ArrayLiteralExpr -> for (el in node.elements) self.walk_expr(el);
			is IfExpr -> {
				self.push_scope();
				self.walk_expr(node.condition);
				self.walk_stmt(node.then_branch);
				self.pop_scope();
				self.walk_stmt(node.else_branch);
			}
			is WhenExpr -> self.walk_when(node.condition, node.arms);
			is InterpExpr -> {
				for (part in node.parts) {
					when (part) {
						is InterpPart.Hole -> self.walk_expr(part.node);
						else -> {}
					}
				}
			}
			is IsExpr -> {
				if (node.expr != null) self.walk_expr(node.expr);
				self.walk_type_node(node.target_type);
				if (!node.alias.empty()) {
					self.bind_local(
						node.alias, SymRole.LOCAL, nl, nc,
						self.format_type_node_pretty(node.target_type), false
					);
				}
			}
			is LambdaExpr -> {
				self.push_scope();
				for (p in node.params) {
					if (p.type_node != null) self.walk_type_node(p.type_node);
					val pt = if (p.type_node != null) self.format_type_node_pretty(p.type_node) else "any";
					self.bind_local(p.name, SymRole.PARAM, nl, nc, pt, false);
				}
				self.walk_stmt(node.body);
				self.pop_scope();
			}
			is CatchExpr -> {
				self.walk_expr(node.expr);
				self.push_scope();
				if (!node.err_name.empty()) {
					var err_ty_s = "any";
					val src_ty = if (self.index.has_symtab) unwrap_base_type(self.index.symtab.get_node_type(node.expr)) else null;
					if (src_ty?.kind == DataType.ERROR_UNION) {
						val pretty_err = format_pretty_type(self.index.symtab, src_ty.as_error_union()!.err);
						if (!pretty_err.empty()) err_ty_s = pretty_err;
					}
					val e_tok = find_ident_token_after(self.tokens, nl, nc, node.err_name);
					val el = if (e_tok.line > 0) e_tok.line else nl;
					val ec = if (e_tok.col > 0) e_tok.col else nc;
					self.bind_local(node.err_name, SymRole.LOCAL, el, ec, err_ty_s, false);
				}
				self.walk_stmt(node.handler);
				self.pop_scope();
			}
			is ErrorUnionWrapExpr -> if (node.value != null) self.walk_expr(node.value);
		}
	}

	fn add_tagged_decl_def(
		&self,
		name: str,
		kw: str,
		is_public: bool,
		members: List<EnumMember>,
		raw_decl: *AstNode,
		dl: usz,
		dc: usz
	) {
		val key = "enum:${self.cur_mod}:${name}";
		self.index.orig_node_names[raw_decl.addr()] = name;
		self.index.orig_node_keys[raw_decl.addr()] = key;
		val tok = find_ident_token_after(self.tokens, dl, dc, name);
		val r_line = if (tok.line > 0) tok.line else dl;
		val r_col = if (tok.col > 0) tok.col else dc;
		self.index.add_def(DefInfo(
			key, name, SymRole.ENUM, self.cur_file, self.cur_mod, "",
			r_line, r_col, name.len, "${kw} ${name}", name, is_public
		));
		self.index.add_ref(RefInfo(
			key, self.cur_file, self.cur_mod, r_line, r_col, name.len,
			true, false, false, name
		));
		for (m in members) {
			val m_key = "variant:${self.cur_mod}:${name}:${m.name}";
			val m_tok = find_ident_token_after(self.tokens, m.line, m.col, m.name);
			val ml = if (m_tok.line > 0) m_tok.line else m.line;
			val mc = if (m_tok.col > 0) m_tok.col else m.col;
			self.index.add_def(DefInfo(
				m_key, m.name, SymRole.ENUM_VARIANT, self.cur_file, self.cur_mod, name,
				ml, mc, m.name.len, "${name}.${m.name}", name, is_public
			));
			self.index.add_ref(RefInfo(
				m_key, self.cur_file, self.cur_mod, ml, mc, m.name.len,
				true, false, false, name
			));
			var cur_l = ml;
			var cur_c = mc + m.name.len;
			val v_container = "${name}.${m.name}";
			for (pf in m.payload) {
				val f_key = "field:${self.cur_mod}:${v_container}:${pf.name}";
				val f_tok = find_param_token_after(self.tokens, cur_l, cur_c, pf.name);
				val fl = if (f_tok.line > 0) f_tok.line else pf.type_node.line;
				val fc = if (f_tok.col > 0) f_tok.col else pf.type_node.col;
				val ft = format_type_node(pf.type_node);
				self.index.add_def(DefInfo(
					f_key, pf.name, SymRole.FIELD, self.cur_file, self.cur_mod, v_container,
					fl, fc, pf.name.len, "${pf.name}: ${ft}", ft, is_public, true
				));
				self.index.add_ref(RefInfo(
					f_key, self.cur_file, self.cur_mod, fl, fc, pf.name.len,
					true, false, false, ft
				));
				cur_l = fl;
				cur_c = fc + pf.name.len;
			}
		}
	}

}

fn register_c_name_mapping(index: &SemanticIndex, prog: *AstNode) {
	if (prog is Program as p) {
		for (decl in p) {
			val raw_decl = decl;
			val key = index.orig_node_keys.get_or(raw_decl.addr(), "");
			if (key.empty()) continue;
			when (decl) {
				is StructDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
				is ObjectDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
				is EnumDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
				is FaultDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
				is ConstDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
				is FnDecl -> if (!decl.name.empty()) index.c_name_to_key[decl.name] = key;
			}
		}
	}
}

pub fn prepare_semantic_index(
	loader: *ModuleLoader,
	doc_path: str = "",
	doc_source: str = "",
	doc_tokens: ?*List<Token> = null
): SemanticIndex {
	var index = SemanticIndex();

	var src_by_path = HashMap<str, str>();
	for (sf in loader.sources.files) {
		val s_norm = sf.path.normalize_path();
		/*
		 * `ModuleLoader.parse_source` calls `add_file(path, source, module_name)`
		 * where parameter 2 is `module_name` and parameter 3 is `content`, so the
		 * actual buffer may sit in `sf.content` or `sf.module_name`.
		 */
		val text = if ("\n" in sf.content || ";" in sf.content) sf.content else sf.module_name;
		if (!text.empty()) src_by_path[s_norm] = text;
	}
	val doc_norm = if (!doc_path.empty()) doc_path.normalize_path() else "";
	if (!doc_norm.empty() && !doc_source.empty()) {
		src_by_path[doc_norm] = doc_source;
	}

	// Tokenize each loaded module once for exact identifier snapping (reuse doc_tokens for active file)
	for (lm in loader.ordered) {
		index.dep_graph.add_module_file(lm.name, lm.path);
		val norm = lm.path.normalize_path();
		index.file_modules[norm] = lm.name;

		if (doc_tokens != null && !doc_norm.empty() && norm == doc_norm) {
			index.file_tokens[norm] = doc_tokens.clone();
			continue;
		}
		val src = src_by_path.get_or(norm, "");
		if (!src.empty()) {
			var lex = Lexer(src, lm.file_id);
			val toks = lex.tokenize();
			index.file_tokens[norm] = toks;
		}
	}

	// Pass 1: register all unmangled definitions & dependency edges BEFORE DeclarationCollector mangles names
	for (lm in loader.ordered) {
		val prog = lm.program ?: continue;
		val norm = lm.path.normalize_path();
		val toks = index.file_tokens.get_or(norm, List<Token>());
		var walker = IndexWalker(&index, lm.path, lm.name, toks);
		walker.walk_decl_pass(prog);
	}

	src_by_path.free();
	return index;
}

pub fn finish_semantic_index(
	index: &SemanticIndex,
	loader: *ModuleLoader,
	symtab: SymbolTable,
	has_symtab: bool,
	target_path: str = "",
	include_workspace: bool = true
) {
	index.symtab = symtab;
	index.has_symtab = has_symtab;

	for (lm in loader.ordered) {
		val prog = lm.program ?: continue;
		register_c_name_mapping(index, prog);
	}

	if (has_symtab) {
		for (inst in symtab.gen.records) {
			if (inst != null && inst.template != null && !inst.c_name.empty() && !inst.template.name.empty()) {
				val tmod = if (!inst.template.module.empty()) inst.template.module else "std";
				val base_val = "${tmod}:${inst.template.name}";
				index.c_inst_to_base[inst.c_name] = base_val;
				if (inst.decl != null && inst.decl is StructDecl as sd && !sd.name.empty()) {
					index.c_inst_to_base[sd.name] = base_val;
				}
			}
		}
	}

	// Pass 2: walk bodies for refs & type resolution (target doc + siblings in same module, or full workspace)
	val target_mod = if (!target_path.empty()) index.file_modules.get_or(target_path.normalize_path(), "") else "";
	for (lm in loader.ordered) {
		val same_file = !target_path.empty() && paths_equal(lm.path, target_path);
		val same_mod = !target_mod.empty() && lm.name == target_mod;
		if (!include_workspace && !target_path.empty() && !same_file && !same_mod) continue;
		val prog = lm.program ?: continue;
		val norm = lm.path.normalize_path();
		val toks = index.file_tokens.get_or(norm, List<Token>());
		var walker = IndexWalker(index, lm.path, lm.name, toks);
		walker.cur_file_id = lm.file_id;
		walker.walk_body_pass(prog);
	}

	// Reclaim temporary per-file token buffers after Pass 2 completes and reset to empty
	// so `SemanticIndex.free()` never double-frees `file_tokens`.
	for ((_, tok_list) in index.file_tokens) {
		tok_list.free();
	}
	index.file_tokens.free();
	index.file_tokens = HashMap<str, List<Token>>();
}

pub fn build_semantic_index(
	loader: *ModuleLoader,
	symtab: SymbolTable,
	has_symtab: bool
): SemanticIndex {
	var index = prepare_semantic_index(loader);
	finish_semantic_index(&index, loader, symtab, has_symtab);
	return index;
}
