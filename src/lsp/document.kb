mod lsp.document;

use std.ascii.*;
use std.collections.list.*;
use std.collections.hash_map.*;
use std.collections.string_builder.*;

use util.strutil.*;

// ============================================================================
// Document Representation
// ============================================================================

pub struct Document {
	pub uri: str = "",
	pub path: str = "",
	pub text: str = "",
	pub version: i64 = 0
}

// ============================================================================
// In-Memory Document Store
// ============================================================================

pub struct DocumentStore {
	pub doc_map: HashMap<str, Document> = HashMap<str, Document>()
}

impl DocumentStore {

	pub fn set(var self, uri: str, text: str, version: i64) {
		val p = uri_to_path(uri);
		self.doc_map[uri] = Document(uri, p, text, version);
	}

	pub fn remove(var self, uri: str) => self.doc_map.remove(uri);

	pub op get(val self, uri: str) => self.doc_map.get_or(uri, Document());

	pub op contains(val self, uri: str) => uri in self.doc_map;

}

pub fn uri_to_path(uri: str): str {
	var s = uri;
	s = if (s.len >= 8 && s.slice(0, 8) == "file:///") s.slice(8, s.len)
	else if (s.len >= 7 && s.slice(0, 7) == "file://") s.slice(7, s.len)
	else s;

	var sb = StringBuilder();
	defer sb.delete();
	var i: usz = 0;
	while (i < s.len) {
		val c = s[i];
		if (c == '%' && i + 2 < s.len) {
			val h1 = s[i + 1];
			val h2 = s[i + 2];
			if (h1 == '3' && (h2 == 'a' || h2 == 'A')) {
				sb += ':';
				i += 3;
				continue;
			}
			if (h1 == '2' && h2 == '0') {
				sb += ' ';
				i += 3;
				continue;
			}
		}

		if (c == '/') sb += '\\'; else sb += c;
		i++;
	}

	return sb.to_str();
}
