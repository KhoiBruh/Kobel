mod lsp;

use std.string.*;
use std.ascii.*;
use std.collections.*;

// ============================================================================
// Document Representation
// ============================================================================

pub struct Document {
	pub uri: str = "",
	pub path: str = "",
	pub text: str = "",
	pub version: i64 = 0
}

impl Document {

	pub op unpack(*self, path: &str, text: &str) {
		path.write(self.path);
		text.write(self.text);
	}

	pub op unpack(*self, uri: &str, path: &str, text: &str) {
		uri.write(self.uri);
		path.write(self.path);
		text.write(self.text);
	}

}

// ============================================================================
// In-Memory Document Store
// ============================================================================

pub struct DocumentStore {
	pub doc_map: HashMap<str, Document> = HashMap()
}

impl DocumentStore {

	pub fn set(&self, uri: str, text: str, version: i64) {
		val p = uri_to_path(uri);
		self.doc_map[uri] = Document(uri, p, text, version);
	}

	pub fn remove(&self, uri: str) => self.doc_map.remove(uri);

	pub op get(*self, uri: str) => self.doc_map.get_or(uri, Document());

	pub op contains(*self, uri: str) => uri in self.doc_map;

	pub fn all_docs(*self): List<Document> {
		var res = List<Document>();
		for ((_, doc) in self.doc_map) res += doc;
		return res;
	}

}

pub fn paths_equal(a: str, b: str): bool {
	if (a.empty() || b.empty()) return false;
	var na = a.normalize_path();
	var nb = b.normalize_path();
	while (na.starts_with(".\\") || na.starts_with("./")) na = na.slice(2, na.len);
	while (nb.starts_with(".\\") || nb.starts_with("./")) nb = nb.slice(2, nb.len);
	if (na == nb) return true;
	// Case-insensitive drive letter comparison on Windows (e.g. C:/ vs c:/)
	if (na.len == nb.len && na.len >= 2 && na[1] == ':' && nb[1] == ':') {
		if (na[0].to_lower() == nb[0].to_lower()) {
			return na.slice(1, na.len) == nb.slice(1, nb.len);
		}
	}
	return false;
}

pub fn path_to_uri(path: str): str {
	if (path.empty()) return "";
	val norm = path.to_posix_path();
	var sb = StringBuilder();
	defer sb.free();
	sb += "file://";
	if (norm.len > 0 && norm[0] != '/') sb += '/';

	for (i in 0..<norm.len) {
		val c = norm[i];
		if (c == ' ') sb += "%20";
		else if (c == ':' && i == 1) sb += "%3A";
		else sb += c;
	}
	return sb.to_str();
}

pub fn uri_to_path(uri: str): str {
	var s = uri;
	s = if (s.len >= 8 && s.slice(0, 8) == "file:///") s.slice(8, s.len)
		else if (s.len >= 7 && s.slice(0, 7) == "file://") s.slice(7, s.len)
		else s;

	var sb = StringBuilder();
	defer sb.free();

	var i = 0;
	while (i < s.len) {
		val c = s[i];
		if (c == '%' && i + 2 < s.len) {
			val h1 = s[i + 1];
			val h2 = s[i + 2];
			when (h1) {
				'3' -> when (h2) {
					'a', 'A' -> {
						sb += ':';
						i += 3;
						continue;
					}
				}
				'2' -> if (h2 == '0') {
					sb += ' ';
					i += 3;
					continue;
				}
			}
		}

		if (c == '/') sb += '\\'; else sb += c;
		i++;
	}

	return sb.to_str();
}
