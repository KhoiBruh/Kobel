mod lsp.server;

use std.io.*;
use std.sys.*;
use std.collections.list.*;

use util.strutil.*;

use lsp.json.*;
use lsp.protocol.*;
use lsp.document.*;
use lsp.analysis.*;

// ============================================================================
// Diagnostics Publisher Helper
// ============================================================================

pub enum Method: str {
	INITIALIZE = "initialize",
	INITIALIZED = "initialized",
	SHUTDOWN = "shutdown",
	EXIT = "exit",
	DID_OPEN = "textDocument/didOpen",
	DID_CHANGE = "textDocument/didChange",
	DID_CLOSE = "textDocument/didClose",
	HOVER = "textDocument/hover",
	DEFINITION = "textDocument/definition",
	FORMATTING = "textDocument/formatting",
	DOCUMENT_SYMBOL = "textDocument/documentSymbol",
	COMPLETION = "textDocument/completion",
	PUBLISH_DIAGNOSTICS = "textDocument/publishDiagnostics"
}

fn publish_doc_diagnostics(uri: str, text: str, workspace_root: str) {
	val p = uri_to_path(uri);
	val analysis = AnalysisResult(p, text, workspace_root);

	val diags_arr = json_arr();
	for (d in analysis.diagnostics) diags_arr += d.to_json();

	val notif_params = json_obj();
	notif_params["uri"] = json_str(uri);
	notif_params["diagnostics"] = diags_arr;
	send_notification(Method.PUBLISH_DIAGNOSTICS.value, notif_params);
}

// ============================================================================
// Main LSP Server Event Loop
// ============================================================================

pub fn run_server(): i32 {
	init_stdio();

	var docs = DocumentStore();
	var is_shutdown = false;
	var workspace_root = "";

	while (true) {
		val raw_msg = read_message();
		if (raw_msg.empty()) break; // EOF: editor closed pipe

		val msg = parse_json(raw_msg);
		if (!msg.is_obj()) continue;

		val method = msg.get_str("method", "");
		val id = msg["id"];
		val params = msg.get_obj("params");

		when (method) {
			Method.INITIALIZE.value -> {
				val root_uri = params.get_str("rootUri", "");
				if (!root_uri.empty()) {
					workspace_root = uri_to_path(root_uri);
				} else {
					val root_path = params.get_str("rootPath", "");
					if (!root_path.empty()) {
						workspace_root = root_path;
					} else {
						val wf = params.get_arr("workspaceFolders");
						val wf_uri = wf.at(0)?.get_str("uri", "") ?: "";
						if (!wf_uri.empty()) workspace_root = uri_to_path(wf_uri);
					}
				}

				val res = json_obj();
				val caps = json_obj();

				// Capabilities:
				// - textDocumentSync: 1 (Full sync)
				// - hoverProvider: true
				// - definitionProvider: true
				// - documentFormattingProvider: true
				// - documentSymbolProvider: true
				// - completionProvider: triggers on '.' and ':'
				caps["textDocumentSync"] = json_num(1);
				caps["hoverProvider"] = json_bool(true);
				caps["definitionProvider"] = json_bool(true);
				caps["documentFormattingProvider"] = json_bool(true);
				caps["documentSymbolProvider"] = json_bool(true);

				val comp = json_obj();
				val triggers = json_arr();
				triggers += json_str(".");
				triggers += json_str(":");
				comp["triggerCharacters"] = triggers;
				caps["completionProvider"] = comp;

				val server_info = json_obj();
				server_info["name"] = json_str("kobel-lsp");
				server_info["version"] = json_str("1.0.0");

				res["capabilities"] = caps;
				res["serverInfo"] = server_info;
				send_response(id, res);
			}

			Method.INITIALIZED.value -> {
				// Notification from client confirming initialization
			}

			Method.SHUTDOWN.value -> {
				is_shutdown = true;
				send_response(id, json_null());
			}

			Method.EXIT.value -> {
				if (is_shutdown) sys_exit(0);
				else sys_exit(1);
			}

			Method.DID_OPEN.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val text = text_doc.get_str("text", "");
				val version = text_doc.get_num("version", 0);

				docs.set(uri, text, version);
				publish_doc_diagnostics(uri, text, workspace_root);
			}

			Method.DID_CHANGE.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val version = text_doc.get_num("version", 0);
				val changes = params.get_arr("contentChanges");
				val new_text = changes.at(0)?.get_str("text", "") ?: "";
				if (!new_text.empty()) {
					docs.set(uri, new_text, version);
					publish_doc_diagnostics(uri, new_text, workspace_root);
				}
			}

			Method.DID_CLOSE.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				docs.remove(uri);

				// Clear diagnostics when file is closed
				val p = json_obj();
				p["uri"] = json_str(uri);
				p["diagnostics"] = json_arr();
				send_notification(Method.PUBLISH_DIAGNOSTICS.value, p);
			}

			Method.HOVER.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val pos = params.get_obj("position");
				val line = pos.get_num("line", 0) as usz;
				val char_col = pos.get_num("character", 0) as usz;

				val doc = docs[uri];
				if (!doc.text.empty()) {
					val analysis = AnalysisResult(doc.path, doc.text, workspace_root);
					val h = analysis.hover_at(line, char_col);
					send_response(id, h);
				} else {
					send_response(id, json_null());
				}
			}

			Method.DEFINITION.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val pos = params.get_obj("position");
				val line = pos.get_num("line", 0) as usz;
				val char_col = pos.get_num("character", 0) as usz;

				val doc = docs[uri];
				if (!doc.text.empty()) {
					val analysis = AnalysisResult(doc.path, doc.text, workspace_root);
					val def_res = analysis.definition_at(uri, line, char_col);
					send_response(id, def_res);
				} else {
					send_response(id, json_null());
				}
			}

			Method.FORMATTING.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val doc = docs[uri];
				if (!doc.text.empty()) {
					val edits = format_document(doc.text);
					send_response(id, edits);
				} else {
					send_response(id, json_arr());
				}
			}

			Method.DOCUMENT_SYMBOL.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val doc = docs[uri];
				if (!doc.text.empty()) {
					val syms = document_symbols(doc.text);
					send_response(id, syms);
				} else {
					send_response(id, json_arr());
				}
			}

			Method.COMPLETION.value -> {
				val text_doc = params.get_obj("textDocument");
				val uri = text_doc.get_str("uri", "");
				val doc = docs[uri];
				if (!doc.text.empty()) {
					val analysis = AnalysisResult(doc.path, doc.text, workspace_root);
					val items = analysis.complete_at();
					send_response(id, items);
				} else {
					val empty_analysis = AnalysisResult("", "", workspace_root);
					val items = empty_analysis.complete_at();
					send_response(id, items);
				}
			}

			else -> {
				if (id != null && !id.is_null()) {
					send_error(id, -32601, "Method '${method}' not found");
				}
			}
		}
	}

	return 0;
}
