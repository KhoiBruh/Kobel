mod lsp;

use std.io.*;
use std.string.*;
use std.ascii.*;
use std.memory.Heap;
use std.collections.*;

// ============================================================================
// Libc Stdio & Mode Bindings
// ============================================================================
extern "libc" {
	fn getchar(): i32;
	fn fflush(stream: *none?): i32;
	fn _setmode(fd: i32, mode: i32): i32;
}

pub fn init_stdio() {
	// Set stdin (0) and stdout (1) to binary mode (0x8000 = 32768) on Windows
	_setmode(0, 32768);
	_setmode(1, 32768);
}

// ============================================================================
// Sending LSP Frames
// ============================================================================
pub fn send_raw(payload: str) {
	print("Content-Length: ${payload.len}\r\n\r\n${payload}");
	fflush(null);
}

pub fn send_response(id: *JsonValue, result: *JsonValue) {
	val msg = JsonValue.obj();
	msg["jsonrpc"] = JsonValue.str("2.0");
	msg["id"] = id;
	msg["result"] = result;
	send_raw(msg.serialize());
}

pub fn send_error(id: *JsonValue, code: i64, message: str) {
	val msg = JsonValue.obj();
	msg["jsonrpc"] = JsonValue.str("2.0");
	msg["id"] = id;
	val err = JsonValue.obj();
	err["code"] = JsonValue.num(code);
	err["message"] = JsonValue.str(message);
	msg["error"] = err;
	send_raw(msg.serialize());
}

pub fn send_notification(method: str, params: *JsonValue) {
	val msg = JsonValue.obj();
	msg["jsonrpc"] = JsonValue.str("2.0");
	msg["method"] = JsonValue.str(method);
	msg["params"] = params;
	send_raw(msg.serialize());
}

// ============================================================================
// Receiving LSP Frames
// ============================================================================
pub fn read_message(): str {
	var content_length = 0;
	// 1. Read HTTP-like headers line-by-line
	while (true) {
		var header_line = StringBuilder();
		defer header_line.free();
		var has_any = false;
		while (true) {
			val ch = getchar();
			if (ch < 0) return ""; // EOF
			has_any = true;
			val c = char(ch);
			if (c == '\n') break;
			if (c != '\r') header_line += c;
		}

		if (!has_any) return "";

		val line = header_line.to_str();
		// Blank line marks the end of headers
		if (line.empty()) break;

		// Check for Content-Length (case-insensitive)
		val prefix = "content-length:";
		if (line.len > prefix.len) {
			var matches = true;
			for (i in 0..<prefix.len) {
				if (line[i].lower() != prefix[i]) {
					matches = false;
					break;
				}
			}
			if (matches) {
				var n: usz = 0;
				for (j in prefix.len..<line.len) {
					val c = line[j];
					if (c in '0'..'9') {
						n = n * 10 + (c.code() - 48);
					}
				}
				content_length = n;
			}
		}
	}

	if (content_length == 0 || content_length > 16777216) return "";

	// 2. Read exactly content_length bytes
	val buf = Heap.create<u8>(content_length + 1);
	for (i in 0..<content_length) {
		val ch = getchar();
		if (ch < 0) {
			Heap.free(buf);
			return ""; // Unexpected EOF
		}
		buf[i] = ch as u8;
	}
	buf[content_length] = 0;
	return str_from_bytes(buf, content_length);
}
