// ============================================================================
// LSP Diagnostic Model
// ============================================================================

pub struct LspDiagnostic {
	pub line: usz,
	pub col: usz,
	pub end_line: usz,
	pub end_col: usz,
	pub severity: i64,
	pub message: str
}

impl LspDiagnostic {

	pub fn new(err_str: str, source: str): Self {
		var line = 1UZ;
		var col = 1UZ;
		var msg_start = 0UZ;

		// Look for "Line "
		val line_tag = "Line ";
		var line_idx = 0UZ;
		var found_line = false;
		val l_pos = err_str.index_of(line_tag);
		if (l_pos >= 0) {
			line_idx = (l_pos as usz) + line_tag.len;
			found_line = true;
		}

		if (found_line) {
			var n: usz = 0;
			var idx = line_idx;
			while (idx < err_str.len && err_str[idx].is_digit()) {
				n = n * 10 + ((err_str[idx] as i32) - 48);
				idx++;
			}
			if (n > 0) line = n;

			// Look for "Column "
			val col_tag = "Column ";
			var col_idx = 0UZ;
			var found_col = false;
			val rest = err_str.slice(idx, err_str.len);
			val c_pos = rest.index_of(col_tag);
			if (c_pos >= 0) {
				col_idx = idx + (c_pos as usz) + col_tag.len;
				found_col = true;
			}

			if (found_col) {
				var cn = 0UZ;
				var c_idx = col_idx;
				while (c_idx < err_str.len && err_str[c_idx].is_digit()) {
					cn = cn * 10 + ((err_str[c_idx] as i32) - 48);
					c_idx++;
				}
				if (cn > 0) col = cn;

				// Skip ": "
				while (
					c_idx < err_str.len && (
						err_str[c_idx] == ':' ||
						err_str[c_idx] == ' '
					)
				) c_idx++;
				msg_start = c_idx;
			}
		}

		val actual_msg = if (msg_start < err_str.len) err_str.slice(msg_start, err_str.len)
		else err_str;

		val l0 = if (line > 0) line - 1 else 0;
		val c0 = if (col > 0) col - 1 else 0;

		var end_col = c0 + 1;
		if (source.len > 0) {
			var cur_line = 0UZ;
			var line_start = 0UZ;
			var pos = 0UZ;
			while (pos < source.len && cur_line < l0) {
				if (source[pos] == '\n') {
					cur_line++;
					line_start = pos + 1;
				}
				pos++;
			}

			if (cur_line == l0 && line_start < source.len) {
				var line_end = line_start;
				while (
					line_end < source.len &&
					source[line_end] != '\n' &&
					source[line_end] != '\r'
				) line_end++;

				val char_idx = line_start + c0;
				if (char_idx < line_end) {
					if (
						source[char_idx] == 'u' &&
						(char_idx + 3 <= line_end) &&
						source[char_idx + 1] == 's' &&
						source[char_idx + 2] == 'e'
					) {
						var s_idx = char_idx;
						while (s_idx < line_end && source[s_idx] != ';') s_idx++;
						if (s_idx < line_end && source[s_idx] == ';') s_idx++;
						end_col = s_idx - line_start;
					} else if (source[char_idx].is_alphanumeric() || source[char_idx] == '_') {
						var w_idx = char_idx;
						while (
							w_idx < line_end && (
								source[w_idx].is_alphanumeric() ||
								source[w_idx] == '_'
							)
						) w_idx++;
						end_col = w_idx - line_start;
					}
				}
			}
		}

		if (end_col <= c0) end_col = c0 + 1;

		return Self(l0, c0, l0, end_col, 1, actual_msg);
	}

	pub fn to_json(val self): *JsonValue {
		val obj = json_obj();

		val range = json_obj();
		val start_pos = json_obj();
		start_pos.set("line", json_num(self.line));
		start_pos.set("character", json_num(self.col));

		val end_pos = json_obj();
		end_pos.set("line", json_num(self.end_line));
		end_pos.set("character", json_num(self.end_col));
		range.set("start", start_pos);
		range.set("end", end_pos);

		obj.set("range", range);
		obj.set("severity", json_num(self.severity));
		obj.set("source", json_str("kobel"));
		obj.set("message", json_str(self.message));

		return obj;
	}
}

pub fn match_doc_prefix(prefix: str, doc_mod: str, doc_path: str): bool {
	if (prefix.len == 0) return true;

	// Check if prefix matches doc_mod (e.g. "lsp.analysis")
	if (doc_mod.len > 0 && prefix == doc_mod) return true;

	// Check if prefix matches doc_path (e.g. "C:/.../src/lsp/analysis.kb")
	if (doc_path.len > 0) {
		val norm_p = prefix.normalize_path();
		val norm_d = doc_path.normalize_path();

		if (norm_p == norm_d) return true;

		// If norm_d ends with norm_p (e.g. norm_d is "c:/users/.../src/lsp/analysis.kb" and norm_p is "src/lsp/analysis.kb")
		if (norm_d.len > norm_p.len && norm_d.ends_with(norm_p)) {
			val sep_char = norm_d[norm_d.len - norm_p.len - 1];
			if (sep_char == '/') return true;
		}

		// If norm_p ends with norm_d
		if (norm_p.len > norm_d.len && norm_p.ends_with(norm_d)) {
			val sep_char = norm_p[norm_p.len - norm_d.len - 1];
			if (sep_char == '/') return true;
		}

		// Compare base name: if prefix is "analysis.kb"
		val base_p = norm_p.base_name();
		val base_d = norm_d.base_name();
		if (
			base_p == base_d && (
				norm_p.len <= base_p.len ||
				norm_d.len <= base_d.len
			)
		) return true;
	}

	return false;
}

pub fn is_error_for_doc(err_str: str, doc_mod: str, doc_path: str): bool {
	val line_idx = err_str.index_of("Line ");
	if (line_idx < 0) {
		val colon_idx = err_str.index_of(":");
		if (colon_idx < 0) return true;
		val prefix = err_str.slice(0, colon_idx);
		return match_doc_prefix(prefix, doc_mod, doc_path);
	}

	if (line_idx == 0) return true;

	var prefix = err_str.slice(0, line_idx);
	while (prefix.ends_with(" ") || prefix.ends_with(":")) {
		prefix = prefix.strip_suffix(1);
	}

	return match_doc_prefix(prefix, doc_mod, doc_path);
}

// ============================================================================
// Document Analysis & Diagnostics Collection
// ============================================================================

pub struct AnalysisResult {
	pub diagnostics: List<LspDiagnostic> = List(),
	pub symtab: SymbolTable = SymbolTable(),
	pub has_symtab: bool = false,
	pub tokens: List<Token> = List()
}

// ============================================================================
// Hover Provider
// ============================================================================

pub fn find_token_at(tokens: List<Token>, target_line: usz, target_col: usz): Token {
	for (tok in tokens) {
		if (tok.line == target_line) {
			val len = tok.text.len;
			if (
				target_col >= tok.col &&
				target_col <= (tok.col + len)
			) return tok;
		}
	}
	return Token(TokenType.UNKNOWN, "", 0, 0);
}

pub fn keyword_hover(kw: str): str => when (kw) {
	"fn" -> "```kobel\nfn <name>(<params>): <type>\n```\nDeclares a function.",
	"val" -> "```kobel\nval <name> = <expr>\n```\nDeclares an immutable local binding.",
	"var" -> "```kobel\nvar <name> = <expr>\n```\nDeclares a mutable variable.",
	"const" -> "```kobel\nconst <name>: <type> = <expr>\n```\nDeclares a compile-time constant.",
	"struct" -> "```kobel\nstruct <name> { <fields> }\n```\nDeclares a record/struct data type.",
	"enum" -> "```kobel\nenum <name> { <members> }\n```\nDeclares an enumeration.",
	"trait" -> "```kobel\ntrait <name> { <methods> }\n```\nDeclares an interface/trait contract.",
	"impl" -> "```kobel\nimpl <type> { <methods> }\n```\nImplements methods or traits for a type.",
	"when" -> "```kobel\nwhen (<expr>) { <pattern> -> <expr> }\n```\nPattern matching expression or statement.",
	"if" -> "```kobel\nif (<cond>) <then> else <else>\n```\nConditional branching.",
	"while" -> "```kobel\nwhile (<cond>) { <body> }\n```\nWhile loop.",
	"for" -> "```kobel\nfor (<item> in <seq>) { <body> }\n```\nIteration loop.",
	"return" -> "```kobel\nreturn <expr>;\n```\nReturns from function.",
	"pub" -> "Visibility modifier: makes declaration accessible outside current module.",
	"use" -> "```kobel\nuse <module>.*;\n```\nImports symbols from another module.",
	"mod" -> "```kobel\nmod <module.path>;\n```\nDeclares current module namespace.",
	"extern" -> "```kobel\nextern \"libc\" { ... }\n```\nDeclares external C ABI foreign functions.",
	"as" -> "Type casting operator: `expr as Type`.",
	else -> ""
};

// ============================================================================
// Completion Helper
// ============================================================================

fn add_completion_item(arr: *JsonValue, label: str, kind: i64, detail: str) {
	val item = json_obj();
	item.set("label", json_str(label));
	item.set("kind", json_num(kind));
	if (detail.len > 0) item.set("detail", json_str(detail));
	arr.add(item);
}

impl AnalysisResult {

	pub fn new(path: str, source: str, workspace_root: str): Self {
		var diagnostics = List<LspDiagnostic>();

		// 1. Lexical analysis
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();

		// Check for unknown tokens
		for (tok in tokens) {
			if (tok.type == TokenType.UNKNOWN) {
				val l0 = if (tok.line > 0) tok.line - 1 else 0;
				val c0 = if (tok.col > 0) tok.col - 1 else 0;
				diagnostics.add(LspDiagnostic(l0, c0, l0, c0 + 1, 1, "Unrecognized character or syntax"));
			}
		}

		// 2. Syntax analysis (Parser)
		var parser = Parser(tokens);
		val prog = parser.parse_program();

		if (parser.errors.len > 0) {
			for (err_msg in parser.errors) {
				diagnostics.add(LspDiagnostic(err_msg, source));
			}
			var empty_symtab = SymbolTable();
			return AnalysisResult(diagnostics, empty_symtab, false, tokens);
		}

		var doc_mod = prog.to<Program>().declared_module_name();
		if (doc_mod.len == 0) doc_mod = path.base_name().path_to_module();

		// 3. Module loading & semantic analysis (DeclPass)
		val entry_dir = path.dir_of();
		var extra_roots = List<str>();
		if (workspace_root.len > 0) {
			extra_roots.add(workspace_root);
			extra_roots.add(workspace_root.join_path("lib"));
			extra_roots.add(workspace_root.join_path("src"));
		}

		var loader = ModuleLoader(entry_dir, extra_roots);
		if (loader.find_module("std.fmt").found) loader.ensure_module("std.fmt");

		val full_prog = loader.load_program(path, source);
		if (loader.errors.len > 0) {
			for (err_msg in loader.errors) {
				if (is_error_for_doc(err_msg, doc_mod, path)) {
					diagnostics.add(LspDiagnostic(err_msg, source));
				}
			}
		}

		if (full_prog != null) {
			var decl_p = DeclPass();
			decl_p.collect_program(full_prog);
			if (decl_p.errors.len > 0) {
				for (err_msg in decl_p.errors) {
					if (is_error_for_doc(err_msg, doc_mod, path)) {
						diagnostics.add(LspDiagnostic(err_msg, source));
					}
				}
			}

			// 4. Type & body semantic analysis (BodyPass)
			var body_p = BodyPass(decl_p.symtab);
			body_p.check_program(full_prog);
			if (body_p.errors.len > 0) {
				for (err_msg in body_p.errors) {
					if (is_error_for_doc(err_msg, doc_mod, path)) {
						diagnostics.add(LspDiagnostic(err_msg, source));
					}
				}
			}

			return Self(diagnostics, decl_p.symtab, true, tokens);
		}

		var empty_symtab = SymbolTable();
		return Self(diagnostics, empty_symtab, false, tokens);
	}

	pub fn hover_at(val self, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type == TokenType.UNKNOWN || tok.text.len == 0) return json_null();

		// 1. Check keywords
		val kw_doc = keyword_hover(tok.text);
		if (kw_doc.len > 0) {
			val res = json_obj();
			val contents = json_obj();
			contents.set("kind", json_str("markdown"));
			contents.set("value", json_str(kw_doc));
			res.set("contents", contents);
			return res;
		}

		// 2. Check identifier symbol in symbol table
		if (self.has_symtab && tok.type == TokenType.IDENTIFIER) {
			val sym = self.symtab.lookup(tok.text);
			if (sym != null) {
				var md = "```kobel\n";
				md = when (sym.kind) {
					SymbolKind.FN -> "${md}fn ${sym.name}: ${sym.type_ptr.to_str()}";
					SymbolKind.STRUCT -> "${md}struct ${sym.name}";
					SymbolKind.ENUM -> "${md}enum ${sym.name}";
					SymbolKind.VAR -> "${md}var ${sym.name}: ${sym.type_ptr.to_str()}";
					SymbolKind.CONST -> "${md}const ${sym.name}: ${sym.type_ptr.to_str()}";
					SymbolKind.PARAM -> "${md}param ${sym.name}: ${sym.type_ptr.to_str()}";
					else -> "${md}${sym.name}: ${sym.type_ptr.to_str()}";
				};
				md = "${md}\n```";

				val res = json_obj();
				val contents = json_obj();
				contents.set("kind", json_str("markdown"));
				contents.set("value", json_str(md));
				res.set("contents", contents);
				return res;
			}
		}

		return json_null();
	}

// ============================================================================
// Go-to-Definition Provider
// ============================================================================

	pub fn definition_at(val self, doc_uri: str, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type != TokenType.IDENTIFIER || tok.text.len == 0) return json_null();

		if (self.has_symtab) {
			val sym = self.symtab.lookup(tok.text);
			if (sym != null && sym.line > 0) {
				val res = json_obj();
				res.set("uri", json_str(doc_uri));

				val range = json_obj();
				val start_pos = json_obj();
				start_pos.set("line", json_num((sym.line - 1) as i64));
				start_pos.set("character", json_num((sym.col - 1) as i64));
				val end_pos = json_obj();
				end_pos.set("line", json_num((sym.line - 1) as i64));
				end_pos.set("character", json_num((sym.col - 1 + sym.name.len) as i64));
				range.set("start", start_pos);
				range.set("end", end_pos);

				res.set("range", range);
				return res;
			}
		}

		return json_null();
	}

	pub fn complete_at(val self): *JsonValue {
		val items = json_arr();

		// 1. Language Keywords (Kind: 14 = Keyword)
		add_completion_item(items, "fn", 14L, "Function declaration");
		add_completion_item(items, "val", 14L, "Immutable binding");
		add_completion_item(items, "var", 14L, "Mutable variable");
		add_completion_item(items, "const", 14L, "Constant declaration");
		add_completion_item(items, "struct", 14L, "Struct type");
		add_completion_item(items, "enum", 14L, "Enum type");
		add_completion_item(items, "trait", 14L, "Trait definition");
		add_completion_item(items, "impl", 14L, "Implementation block");
		add_completion_item(items, "when", 14L, "Pattern matching");
		add_completion_item(items, "if", 14L, "Conditional");
		add_completion_item(items, "else", 14L, "Else branch");
		add_completion_item(items, "while", 14L, "While loop");
		add_completion_item(items, "for", 14L, "For-in loop");
		add_completion_item(items, "in", 14L, "Iteration in");
		add_completion_item(items, "return", 14L, "Return statement");
		add_completion_item(items, "pub", 14L, "Public visibility");
		add_completion_item(items, "use", 14L, "Module import");
		add_completion_item(items, "mod", 14L, "Module declaration");
		add_completion_item(items, "extern", 14L, "External declaration");
		add_completion_item(items, "true", 14L, "Boolean true");
		add_completion_item(items, "false", 14L, "Boolean false");
		add_completion_item(items, "null", 14L, "Null pointer");
		add_completion_item(items, "as", 14L, "Type cast");
		add_completion_item(items, "break", 14L, "Break loop");
		add_completion_item(items, "continue", 14L, "Continue loop");

		// 2. Built-in Primitive Types (Kind: 7 = Class/Type)
		add_completion_item(items, "i8", 7L, "Signed 8-bit integer");
		add_completion_item(items, "i16", 7L, "Signed 16-bit integer");
		add_completion_item(items, "i32", 7L, "Signed 32-bit integer");
		add_completion_item(items, "i64", 7L, "Signed 64-bit integer");
		add_completion_item(items, "isz", 7L, "Signed pointer-size integer");
		add_completion_item(items, "u8", 7L, "Unsigned 8-bit integer");
		add_completion_item(items, "u16", 7L, "Unsigned 16-bit integer");
		add_completion_item(items, "u32", 7L, "Unsigned 32-bit integer");
		add_completion_item(items, "u64", 7L, "Unsigned 64-bit integer");
		add_completion_item(items, "usz", 7L, "Unsigned pointer-size integer");
		add_completion_item(items, "f32", 7L, "32-bit float");
		add_completion_item(items, "f64", 7L, "64-bit float");
		add_completion_item(items, "bool", 7L, "Boolean type");
		add_completion_item(items, "char", 7L, "ASCII character type");
		add_completion_item(items, "str", 7L, "String type");
		add_completion_item(items, "none", 7L, "Unit / void type");

		// 3. User & imported symbols from SymbolTable
		if (self.has_symtab) {
			for (mod_scope in self.symtab.modules) {
				for (sym in mod_scope.symbols) {
					val k: i64 = when (sym.kind) {
						SymbolKind.FN -> 3, // Function
						SymbolKind.STRUCT -> 22, // Struct
						SymbolKind.ENUM -> 13, // Enum
						SymbolKind.VAR -> 6, // Variable
						SymbolKind.CONST -> 21, // Constant
						else -> 6
					};
					add_completion_item(items, sym.name, k, sym.type_ptr.to_str());
				}
			}
		}

		return items;
	}

}

// ============================================================================
// Document Symbol Outline Provider
// ============================================================================

pub fn document_symbols(source: str): *JsonValue {
	var lexer = Lexer(source);
	val tokens = lexer.tokenize();
	var parser = Parser(tokens);
	val prog_node = parser.parse_program();

	val arr = json_arr();
	if (prog_node == null) return arr;

	val prog = prog_node.to<Program>();
	for (decl in prog) {
		var sym_name = "";
		var sym_kind = 0L; // LSP SymbolKind

		when (decl) {
			is FnDecl -> {
				sym_name = decl.name;
				sym_kind = 12; // Function
			}
			is StructDecl -> {
				sym_name = decl.name;
				sym_kind = 23; // Struct
			}
			is EnumDecl -> {
				sym_name = decl.name;
				sym_kind = 10; // Enum
			}
			is TraitDecl -> {
				sym_name = decl.name;
				sym_kind = 11; // Interface
			}
			is ImplDecl -> {
				sym_name = "impl ${decl.struct_name}";
				sym_kind = 5; // Class
			}
			is ConstDecl -> {
				sym_name = decl.name;
				sym_kind = 14; // Constant
			}
			else -> {}
		}

		if (sym_name.len > 0) {
			val item = json_obj();
			item.set("name", json_str(sym_name));
			item.set("kind", json_num(sym_kind));

			val l0 = if (decl.line > 0) decl.line - 1 else 0;
			val c0 = if (decl.col > 0) decl.col - 1 else 0;

			val range = json_obj();
			val s_pos = json_obj();
			s_pos.set("line", json_num(l0));
			s_pos.set("character", json_num(c0));

			val e_pos = json_obj();
			e_pos.set("line", json_num(l0));
			e_pos.set("character", json_num(c0 + sym_name.len));
			range.set("start", s_pos);
			range.set("end", e_pos);

			item.set("range", range);
			item.set("selectionRange", range);

			arr.add(item);
		}
	}

	return arr;
}

// ============================================================================
// Formatting Provider
// ============================================================================

pub fn format_document(text: str): *JsonValue {
	val options = FormatOptions();
	val formatted = format_source(text, options);

	val edits = json_arr();
	val edit = json_obj();

	val range = json_obj();
	val start_pos = json_obj();
	start_pos.set("line", json_num(0));
	start_pos.set("character", json_num(0));

	val end_pos = json_obj();
	end_pos.set("line", json_num(999999));
	end_pos.set("character", json_num(0));
	range.set("start", start_pos);
	range.set("end", end_pos);

	edit.set("range", range);
	edit.set("newText", json_str(formatted));
	edits.add(edit);

	return edits;
}

