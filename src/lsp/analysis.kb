// ============================================================================
// LSP Diagnostic Model
// ============================================================================

pub enum DocSymbol: i64 {
	NONE = 0,
	FILE = 1,
	MODULE = 2,
	CLASS = 5,
	METHOD = 6,
	ENUM = 10,
	INTERFACE = 11,
	FUNCTION = 12,
	VARIABLE = 13,
	CONSTANT = 14,
	STRUCT = 23
}

pub enum Completion: i64 {
	FUNCTION = 3,
	VARIABLE = 6,
	TYPE = 7,
	ENUM = 13,
	KEYWORD = 14,
	CONSTANT = 21,
	STRUCT = 22
}

pub struct LspDiagnostic {
	pub line: usz,
	pub col: usz,
	pub end_line: usz,
	pub end_col: usz,
	pub severity: i64,
	pub message: str
}

impl LspDiagnostic {

	pub init(diag: Diagnostic, source: str) {
		val line = if (diag.line > 0) diag.line else 1;
		val col = if (diag.col > 0) diag.col else 1;
		val l0 = line - 1;
		val c0 = if (col > 0) col - 1 else 0;

		var end_col = c0 + 1;
		if (diag.length > 1) end_col = c0 + (diag.length as usz);

		val severity = if (diag.severity == Severity.WARNING) 2 else 1;
		return Self(l0, c0, l0, end_col, severity, diag.message);
	}

	pub fn to_json(val self): *JsonValue {
		val obj = JsonValue.obj();

		val range = JsonValue.obj();
		val start_pos = JsonValue.obj();
		start_pos["line"] = JsonValue.num(self.line);
		start_pos["character"] = JsonValue.num(self.col);

		val end_pos = JsonValue.obj();
		end_pos["line"] = JsonValue.num(self.end_line);
		end_pos["character"] = JsonValue.num(self.end_col);
		range["start"] = start_pos;
		range["end"] = end_pos;

		obj["range"] = range;
		obj["severity"] = JsonValue.num(self.severity);
		obj["source"] = JsonValue.str("kobel");
		obj["message"] = JsonValue.str(self.message);

		return obj;
	}
}

pub fn match_doc_prefix(prefix: str, doc_mod: str, doc_path: str): bool {
	if (prefix.empty()) return true;

	// Check if prefix matches doc_mod (e.g. "lsp.analysis")
	if (doc_mod.len > 0 && prefix == doc_mod) return true;

	// Check if prefix matches doc_path (e.g. "C:/.../src/lsp/analysis.kb")
	if (doc_path.len > 0) {
		val norm_p = prefix.normalize_path();
		val norm_d = doc_path.normalize_path();

		if (norm_p == norm_d) return true;

		// If norm_d ends with norm_p (e.g. norm_d is "c:/users/.../src/lsp/analysis.kb"
		// and norm_p is "src/lsp/analysis.kb")
		if (norm_d.len > norm_p.len && norm_d.ends_with(norm_p)) {
			val sep_char = norm_d[norm_d.len - norm_p.len - 1];
			if (sep_char == '/') return true;
		}

		// If norm_p ends with norm_d
		if (norm_p.len > norm_d.len && norm_p.ends_with(norm_d)) {
			val sep_char = norm_p[norm_p.len - norm_d.len - 1];
			if (sep_char == '/') return true;
		}

		// Compare base name: if prefix is "analysis.kb"
		val base_p = norm_p.base_name();
		val base_d = norm_d.base_name();
		if (
			base_p == base_d && (
				norm_p.len <= base_p.len ||
				norm_d.len <= base_d.len
			)
		) return true;
	}

	return false;
}

pub fn is_error_for_doc(diag: Diagnostic, doc_mod: str, doc_path: str): bool {
	return match_doc_prefix(diag.file_path, doc_mod, doc_path);
}

// ============================================================================
// Document Analysis & Diagnostics Collection
// ============================================================================

pub struct AnalysisResult {
	pub diagnostics: List<LspDiagnostic> = List(),
	pub symtab: SymbolTable = SymbolTable(),
	pub has_symtab: bool = false,
	pub tokens: List<Token> = List()
}

// ============================================================================
// Hover Provider
// ============================================================================

pub fn find_token_at(tokens: List<Token>, target_line: usz, target_col: usz): Token {
	for (tok in tokens) {
		if (tok.line == target_line) {
			val len = tok.text.len;
			if (
				target_col >= tok.col &&
				target_col <= (tok.col + len)
			) return tok;
		}
	}
	return Token(TokenType.UNKNOWN, "", 0, 0);
}

pub fn keyword_hover(kw: str): str => when (kw) {
	"fn" -> """
		```kobel
		fn <name>(<params>): <type>
		```
		Declares a function.
	""";
	"val" -> """
		```kobel
		val <name> = <expr>
		```
		Declares an immutable local binding.
	""";
	"var" -> """
		```kobel
		var <name> = <expr>
		```
		Declares a mutable variable.
	""";
	"const" -> """
		```kobel
		const <name>: <type> = <expr>
		```
		Declares a compile-time constant.
	""";
	"struct" -> """
		```kobel
		struct <name> { <fields> }
		```
		Declares a record/struct data type.
	""";
	"enum" -> """
		```kobel
		enum <name> { <members> }
		```
		Declares an enumeration.
	""";
	"trait" -> """
		```kobel
		trait <name> { <methods> }
		```
		Declares an interface/trait contract.
	""";
	"impl" -> """
		```kobel
		impl <type> { <methods> }
		```
		Implements methods or traits for a type.
	""";
	"when" -> """
		```kobel
		when (<expr>) { <pattern> -> <expr> }
		```
		Pattern matching expression or statement.
	""";
	"if" -> """
		```kobel
		if (<cond>) <then> else <else>
		```
		Conditional branching.
	""";
	"while" -> """
		```kobel
		while (<cond>) { <body> }
		```
		While loop.
	""";
	"for" -> """
		```kobel
		for (<item> in <seq>) { <body> }
		```
		Iteration loop.
	""";
	"return" -> """
		```kobel
		return <expr>;
		```
		Returns from function.
	""";
	"pub" -> "Visibility modifier: makes declaration accessible outside current module.";
	"use" -> """
		```kobel
		use <module>.*;
		```
		Imports symbols from another module.
	""";
	"mod" -> """
		```kobel
		mod <module.path>;
		```
		Declares current module namespace.
	""";
	"extern" -> """
		```kobel
		extern "libc" { ... }
		```
		Declares external C ABI foreign functions.
	""";
	"defer" -> """
		```kobel
		defer <stmt>;
		defer { <body> }
		```
		Defers execution of a statement or block until the surrounding scope exits.
	""";
	"as" -> "Type casting operator: `expr as Type`.";
	else -> "";
};

// ============================================================================
// Completion Helper
// ============================================================================

fn add_completion_item(arr: *JsonValue, label: str, kind: i64, detail: str) {
	val item = JsonValue.obj();
	item["label"] = JsonValue.str(label);
	item["kind"] = JsonValue.num(kind);
	if (detail.len > 0) item["detail"] = JsonValue.str(detail);
	arr += item;
}

impl AnalysisResult {

	pub init(path: str, source: str, workspace_root: str) {
		var diagnostics = List<LspDiagnostic>();

		// 1. Lexical analysis
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();

		// Check for unknown tokens
		for (tok in tokens) {
			if (tok.type == TokenType.UNKNOWN) {
				val l0 = if (tok.line > 0) tok.line - 1 else 0;
				val c0 = if (tok.col > 0) tok.col - 1 else 0;
				diagnostics += LspDiagnostic(l0, c0, l0, c0 + 1, 1, "Unrecognized character or syntax");
			}
		}

		// 2. Syntax analysis (Parser)
		var parser = Parser(tokens);
		val prog = parser.parse_program();

		if (parser.errors.len > 0) {
			for (d in parser.errors) {
				diagnostics += LspDiagnostic(d, source);
			}
			var empty_symtab = SymbolTable();
			return AnalysisResult(diagnostics, empty_symtab, false, tokens);
		}

		var doc_mod = "";
		if (prog is Program as p) doc_mod = p.declared_module_name();
		if (doc_mod.empty()) doc_mod = path.base_name().path_to_module();

		// 3. Module loading & semantic analysis (DeclPass)
		val entry_dir = path.dir_of();
		var extra_roots = List<str>();
		if (workspace_root.len > 0) {
			extra_roots += workspace_root;
			extra_roots += workspace_root.join_path("lib");
			extra_roots += workspace_root.join_path("src");
		}

		var loader = ModuleLoader(entry_dir, extra_roots);
		if (loader.find_module("std.traits").found) {
			loader.ensure_module("std.traits");
		}
		if (loader.find_module("std.string").found) {
			loader.ensure_module("std.string");
		}
		if (loader.find_module("std.range").found) {
			loader.ensure_module("std.range");
		}

		val full_prog = loader.load_program(path, source);
		if (loader.errors.len > 0) {
			for (d in loader.errors) {
				if (is_error_for_doc(d, doc_mod, path)) {
					diagnostics += LspDiagnostic(d, source);
				}
			}
		}

		if (full_prog != null) {
			var decl_p = DeclarationCollector();
			decl_p.collect_program(full_prog);
			if (decl_p.errors.len > 0) {
				for (d in decl_p.errors) {
					if (is_error_for_doc(d, doc_mod, path)) {
						diagnostics += LspDiagnostic(d, source);
					}
				}
			}

			// 4. Type & body semantic analysis (BodyPass)
			var body_p = BodyChecker(decl_p.symtab, decl_p);
			body_p.check_program(full_prog);
			if (body_p.errors.len > 0) {
				for (d in body_p.errors) {
					if (is_error_for_doc(d, doc_mod, path)) {
						diagnostics += LspDiagnostic(d, source);
					}
				}
			}

			return Self(diagnostics, decl_p.symtab, true, tokens);
		}

		var empty_symtab = SymbolTable();
		return Self(diagnostics, empty_symtab, false, tokens);
	}

	pub fn hover_at(val self, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type == TokenType.UNKNOWN || tok.text.empty()) return JsonValue.null_val();

		// 1. Check keywords
		val kw_doc = keyword_hover(tok.text);
		if (kw_doc.len > 0) {
			val res = JsonValue.obj();
			val contents = JsonValue.obj();
			contents["kind"] = JsonValue.str("markdown");
			contents["value"] = JsonValue.str(kw_doc);
			res["contents"] = contents;
			return res;
		}

		// 2. Check identifier symbol in symbol table
		if (self.has_symtab && tok.type == TokenType.IDENTIFIER) {
			val sym = self.symtab.lookup(tok.text) ?: return JsonValue.null_val();
			var md = "```kobel\n";
			md = when (sym.kind) {
				SymbolKind.FN -> "${md}fn ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.STRUCT -> "${md}struct ${sym.name}";
				SymbolKind.ENUM -> "${md}enum ${sym.name}";
				SymbolKind.VAR -> "${md}var ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.CONST -> "${md}const ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.PARAM -> "${md}param ${sym.name}: ${sym.type_ptr.to_str()}";
				else -> "${md}${sym.name}: ${sym.type_ptr.to_str()}";
			};
			md = "${md}\n```";

			val res = JsonValue.obj();
			val contents = JsonValue.obj();
			contents["kind"] = JsonValue.str("markdown");
			contents["value"] = JsonValue.str(md);
			res["contents"] = contents;
			return res;
		}

		return JsonValue.null_val();
	}

// ============================================================================
// Go-to-Definition Provider
// ============================================================================

	pub fn definition_at(val self, doc_uri: str, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type != TokenType.IDENTIFIER || tok.text.empty()) return JsonValue.null_val();

		if (self.has_symtab) {
			val sym = self.symtab.lookup(tok.text) ?: return JsonValue.null_val();
			if (sym.line > 0) {
				val res = JsonValue.obj();
				res["uri"] = JsonValue.str(doc_uri);

				val range = JsonValue.obj();
				val start_pos = JsonValue.obj();
				start_pos["line"] = JsonValue.num((sym.line - 1) as i64);
				start_pos["character"] = JsonValue.num((sym.col - 1) as i64);
				val end_pos = JsonValue.obj();
				end_pos["line"] = JsonValue.num((sym.line - 1) as i64);
				end_pos["character"] = JsonValue.num((sym.col - 1 + sym.name.len) as i64);
				range["start"] = start_pos;
				range["end"] = end_pos;

				res["range"] = range;
				return res;
			}
		}

		return JsonValue.null_val();
	}

	pub fn complete_at(val self): *JsonValue {
		val items = JsonValue.arr();

		// 1. Language Keywords (Kind: 14 = Keyword)
		add_completion_item(items, "fn", 14, "Function declaration");
		add_completion_item(items, "val", 14, "Immutable binding");
		add_completion_item(items, "var", 14, "Mutable variable");
		add_completion_item(items, "const", 14, "Constant declaration");
		add_completion_item(items, "struct", 14, "Struct type");
		add_completion_item(items, "enum", 14, "Enum type");
		add_completion_item(items, "trait", 14, "Trait definition");
		add_completion_item(items, "impl", 14, "Implementation block");
		add_completion_item(items, "when", 14, "Pattern matching");
		add_completion_item(items, "if", 14, "Conditional");
		add_completion_item(items, "else", 14, "Else branch");
		add_completion_item(items, "while", 14, "While loop");
		add_completion_item(items, "for", 14, "For-in loop");
		add_completion_item(items, "in", 14, "Iteration in");
		add_completion_item(items, "return", 14, "Return statement");
		add_completion_item(items, "pub", 14, "Public visibility");
		add_completion_item(items, "use", 14, "Module import");
		add_completion_item(items, "mod", 14, "Module declaration");
		add_completion_item(items, "extern", 14, "External declaration");
		add_completion_item(items, "true", 14, "Boolean true");
		add_completion_item(items, "false", 14, "Boolean false");
		add_completion_item(items, "null", 14, "Null pointer");
		add_completion_item(items, "as", 14, "Type cast");
		add_completion_item(items, "break", 14, "Break loop");
		add_completion_item(items, "continue", 14, "Continue loop");

		// 2. Built-in Primitive Types (Kind: 7 = Class/Type)
		add_completion_item(items, "i8", 7, "Signed 8-bit integer");
		add_completion_item(items, "i16", 7, "Signed 16-bit integer");
		add_completion_item(items, "i32", 7, "Signed 32-bit integer");
		add_completion_item(items, "i64", 7, "Signed 64-bit integer");
		add_completion_item(items, "isz", 7, "Signed pointer-size integer");
		add_completion_item(items, "u8", 7, "Unsigned 8-bit integer");
		add_completion_item(items, "u16", 7, "Unsigned 16-bit integer");
		add_completion_item(items, "u32", 7, "Unsigned 32-bit integer");
		add_completion_item(items, "u64", 7, "Unsigned 64-bit integer");
		add_completion_item(items, "usz", 7, "Unsigned pointer-size integer");
		add_completion_item(items, "f32", 7, "32-bit float");
		add_completion_item(items, "f64", 7, "64-bit float");
		add_completion_item(items, "bool", 7, "Boolean type");
		add_completion_item(items, "char", 7, "ASCII character type");
		add_completion_item(items, "str", 7, "String type");
		add_completion_item(items, "none", 7, "Unit / void type");

		// 3. User & imported symbols from SymbolTable
		if (self.has_symtab) {
			for (mod_scope in self.symtab.modules) {
				for ((name, kind, type_ptr) in mod_scope) {
					val k: i64 = when (kind) {
						SymbolKind.FN -> Completion.FUNCTION.value;
						SymbolKind.STRUCT -> Completion.STRUCT.value;
						SymbolKind.ENUM -> Completion.ENUM.value;
						SymbolKind.VAR -> Completion.VARIABLE.value;
						SymbolKind.CONST -> Completion.CONSTANT.value;
						else -> Completion.VARIABLE.value;
					};
					add_completion_item(items, name, k, type_ptr.to_str());
				}
			}
		}

		return items;
	}

}

// ============================================================================
// Document Symbol Outline Provider
// ============================================================================

impl AnalysisResult {

	pub fn document_symbols(source: str): *JsonValue {
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();
		var parser = Parser(tokens);
		val arr = JsonValue.arr();
		val prog_node = parser.parse_program() ?: return arr;

		if (prog_node is Program as prog) {
			for (decl in prog) {
			var sym_name = "";
			var sym_kind = DocSymbol.NONE;

			when (decl) {
				is FnDecl -> {
					sym_name = decl.name;
					sym_kind = DocSymbol.FUNCTION;
				}
				is StructDecl -> {
					sym_name = decl.name;
					sym_kind = DocSymbol.STRUCT;
				}
				is EnumDecl -> {
					sym_name = decl.name;
					sym_kind = DocSymbol.ENUM;
				}
				is TraitDecl -> {
					sym_name = decl.name;
					sym_kind = DocSymbol.INTERFACE;
				}
				is ImplDecl -> {
					sym_name = "impl ${decl.struct_name}";
					sym_kind = DocSymbol.CLASS;
				}
				is ConstDecl -> {
					sym_name = decl.name;
					sym_kind = DocSymbol.CONSTANT;
				}
			}

			if (sym_name.len > 0) {
				val item = JsonValue.obj();
				item["name"] = JsonValue.str(sym_name);
				item["kind"] = JsonValue.num(sym_kind.value);

				val l0 = if (decl.line > 0) decl.line - 1 else 0;
				val c0 = if (decl.col > 0) decl.col - 1 else 0;

				val range = JsonValue.obj();
				val s_pos = JsonValue.obj();
				s_pos["line"] = JsonValue.num(l0);
				s_pos["character"] = JsonValue.num(c0);

				val e_pos = JsonValue.obj();
				e_pos["line"] = JsonValue.num(l0);
				e_pos["character"] = JsonValue.num(c0 + sym_name.len);
				range["start"] = s_pos;
				range["end"] = e_pos;

				item["range"] = range;
				item["selectionRange"] = range;

				arr += item;
			}
		}
		}

		return arr;
	}

// ============================================================================
// Formatting Provider
// ============================================================================

	pub fn format_document(text: str): *JsonValue {
		val options = FormatOptions();
		val formatted = format_source(text, options);

		val edits = JsonValue.arr();
		val edit = JsonValue.obj();

		val range = JsonValue.obj();
		val start_pos = JsonValue.obj();
		start_pos["line"] = JsonValue.num(0);
		start_pos["character"] = JsonValue.num(0);

		val end_pos = JsonValue.obj();
		end_pos["line"] = JsonValue.num(999999);
		end_pos["character"] = JsonValue.num(0);
		range["start"] = start_pos;
		range["end"] = end_pos;

		edit["range"] = range;
		edit["newText"] = JsonValue.str(formatted);
		edits += edit;

		return edits;
	}

}
