mod lsp;

use std.ascii.*;
use std.filesystem.*;
use std.collections.*;
use std.string.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.parser.*;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.checker.*;
use compiler.loader.*;

use config.*;
use fmt.*;

/*
 * ============================================================================
 * lsp.analysis — Semantic Analysis, Hover, Definition, Completion & Symbols
 *
 * Bridges the Kobel compiler pipeline (`ModuleLoader` -> `DeclarationCollector`
 * -> `BodyChecker`) with `SemanticIndex` to power context-aware completions,
 * cross-file definitions, signature help, document/workspace symbols, and
 * rich hover information.
 * ============================================================================
 */

pub enum DocSymbol: i64 {
	NONE = 0,
	FILE = 1,
	MODULE = 2,
	CLASS = 5,
	METHOD = 6,
	PROPERTY = 7,
	FIELD = 8,
	CONSTRUCTOR = 9,
	ENUM = 10,
	INTERFACE = 11,
	FUNCTION = 12,
	VARIABLE = 13,
	CONSTANT = 14,
	ENUM_MEMBER = 22,
	STRUCT = 23
}

pub enum Completion: i64 {
	METHOD = 2,
	FUNCTION = 3,
	CONSTRUCTOR = 4,
	FIELD = 5,
	VARIABLE = 6,
	TYPE = 7,
	MODULE = 9,
	ENUM = 13,
	KEYWORD = 14,
	ENUM_MEMBER = 20,
	CONSTANT = 21,
	STRUCT = 22
}

pub struct LspDiagnostic {
	pub line: usz,
	pub col: usz,
	pub end_line: usz,
	pub end_col: usz,
	pub severity: i64,
	pub message: str
}

impl LspDiagnostic {

	pub init(diag: Diagnostic, source: str) {
		val line = if (diag.line > 0) diag.line else 1;
		val col = if (diag.col > 0) diag.col else 1;
		val l0 = line - 1;
		val c0 = if (col > 0) col - 1 else 0;

		var end_col = c0 + 1;
		if (diag.length > 1) end_col = c0 + (diag.length as usz);

		val severity = if (diag.severity == Severity.WARNING) 2 else 1;
		return Self(l0, c0, l0, end_col, severity, diag.message);
	}

	pub fn to_json(*self): *JsonValue {
		val obj = JsonValue.obj();

		val range = JsonValue.obj();
		val start_pos = JsonValue.obj();
		start_pos["line"] = JsonValue.num(self.line);
		start_pos["character"] = JsonValue.num(self.col);

		val end_pos = JsonValue.obj();
		end_pos["line"] = JsonValue.num(self.end_line);
		end_pos["character"] = JsonValue.num(self.end_col);
		range["start"] = start_pos;
		range["end"] = end_pos;

		obj["range"] = range;
		obj["severity"] = JsonValue.num(self.severity);
		obj["source"] = JsonValue.str("kobel");
		obj["message"] = JsonValue.str(self.message);

		return obj;
	}
}

pub fn match_doc_prefix(prefix: str, doc_mod: str, doc_path: str): bool {
	if (prefix.empty()) return true;
	if (doc_mod.len > 0 && prefix == doc_mod) return true;

	if (doc_path.len > 0) {
		val norm_p = prefix.normalize_path();
		val norm_d = doc_path.normalize_path();

		if (norm_p == norm_d) return true;

		if (norm_d.len > norm_p.len && norm_d.ends_with(norm_p)) {
			val sep_char = norm_d[norm_d.len - norm_p.len - 1];
			if (sep_char == '/') return true;
		}

		if (norm_p.len > norm_d.len && norm_p.ends_with(norm_d)) {
			val sep_char = norm_p[norm_p.len - norm_d.len - 1];
			if (sep_char == '/') return true;
		}

		val base_p = norm_p.base_name();
		val base_d = norm_d.base_name();
		if (
			base_p == base_d && (
				norm_p.len <= base_p.len ||
				norm_d.len <= base_d.len
			)
		) return true;
	}

	return false;
}

pub fn is_error_for_doc(diag: Diagnostic, doc_mod: str, doc_path: str): bool {
	return match_doc_prefix(diag.file_path, doc_mod, doc_path);
}

// ============================================================================
// Document Analysis & Diagnostics Collection
// ============================================================================

pub struct AnalysisResult {
	pub diagnostics: List<LspDiagnostic> = List(),
	pub symtab: SymbolTable = SymbolTable(),
	pub has_symtab: bool = false,
	pub tokens: List<Token> = List(),
	pub index: SemanticIndex = SemanticIndex(),
	pub file_path: str = "",
	pub source: str = ""
}

pub fn find_token_at(tokens: List<Token>, target_line: usz, target_col: usz): Token {
	for (tok in tokens) {
		if (tok.line == target_line) {
			val len = tok.text.len;
			if (target_col >= tok.col && target_col <= (tok.col + len)) return tok;
		}
	}
	return Token(TokenType.UNKNOWN, "", 0, 0);
}

pub fn keyword_hover(kw: str): str => when (kw) {
	"fn" -> """
		```kobel
		fn <name>(<params>): <type>
		fn <name>(..args: ..T): <type>
		```
		Declares a function (supports generic type params and `..T` variadics).
	""";
	"op" -> """
		```kobel
		pub op <name>(*self, ...): <type>
		```
		Declares an operator overload (`get`, `set`, `plus`, `equals`, `unpack`, etc.) inside `impl`.
	""";
	"init" -> """
		```kobel
		pub init(<params>) { ... }
		```
		Declares a struct initializer/constructor inside `impl`.
	""";
	"val" -> """
		```kobel
		val <name> = <expr>
		```
		Declares an immutable local binding.
	""";
	"var" -> """
		```kobel
		var <name> = <expr>
		```
		Declares a mutable variable.
	""";
	"const" -> """
		```kobel
		const <name>: <type> = <expr>
		```
		Declares a compile-time constant.
	""";
	"struct" -> """
		```kobel
		struct <name><T> { <fields> }
		```
		Declares a record/struct data type.
	""";
	"enum" -> """
		```kobel
		enum <name> { <members> }
		```
		Declares a plain or payload-carrying algebraic enumeration.
	""";
	"trait" -> """
		```kobel
		trait <name> { <methods> }
		```
		Declares an interface/trait contract with optional default methods and associated types.
	""";
	"impl" -> """
		```kobel
		impl <type> { <methods> }
		impl <trait> for <type> { <methods> }
		```
		Implements methods (`*self`, `&self`, `self`) or traits for a type.
	""";
	"when" -> """
		```kobel
		when (<expr>) {
			.VARIANT, 1..10 -> <expr>;
			is Type as alias -> <expr>;
			else -> <expr>;
		}
		```
		Pattern matching expression or statement supporting leading-dot variants, ranges (`..`, `..<`), and grouped `is` type patterns.
	""";
	"is" -> """
		```kobel
		expr is Type [as alias]
		```
		Runtime/compile-time type narrowing and enum variant matching with smart casting.
	""";
	"if" -> """
		```kobel
		if (<cond>) <then> else <else>
		```
		Conditional branching statement or expression.
	""";
	"while" -> """
		```kobel
		while (<cond>) { <body> }
		```
		While loop.
	""";
	"for" -> """
		```kobel
		for (<item> in <seq>) { <body> }
		for (i in 0..<n) { <body> }
		```
		Iteration loop over `Iterable` collections or `Range` (`..`, `..<`).
	""";
	"return" -> """
		```kobel
		return <expr>;
		```
		Returns from the enclosing function.
	""";
	"yield" -> """
		```kobel
		yield <expr>;
		```
		Yields a value from a `when` arm or trailing lambda block.
	""";
	"break" -> "Exits the innermost loop.";
	"continue" -> "Skips to the next iteration of the innermost loop.";
	"pub" -> "Visibility modifier: makes declaration accessible outside current module.";
	"use" -> """
		```kobel
		use <module>.*;
		use <module>.<Symbol>;
		```
		Imports symbols from another module.
	""";
	"mod" -> """
		```kobel
		mod <module.path>;
		```
		Declares current module namespace.
	""";
	"extern" -> """
		```kobel
		extern "libc" { ... }
		```
		Declares external C ABI foreign functions.
	""";
	"defer" -> """
		```kobel
		defer <stmt>;
		defer { <body> }
		```
		Defers execution of a statement or block until the surrounding scope exits.
	""";
	"as" -> "Type casting operator: `expr as Type`.";
	"self" -> "Method receiver (`*self` read-only pointer, `&self` mutable pointer, or `self` move).";
	else -> "";
};

fn add_completion_item(arr: *JsonValue, label: str, kind: i64, detail: str) {
	val item = JsonValue.obj();
	item["label"] = JsonValue.str(label);
	item["kind"] = JsonValue.num(kind);
	if (detail.len > 0) item["detail"] = JsonValue.str(detail);
	arr += item;
}

fn contains_ci(haystack: str, needle: str): bool {
	if (needle.empty()) return true;
	if (needle.len > haystack.len) return false;
	val limit = haystack.len - needle.len + 1;
	for (i in 0..<limit) {
		var ok = true;
		for (j in 0..<needle.len) {
			if (haystack[i + j].to_lower() != needle[j].to_lower()) {
				ok = false;
				break;
			}
		}
		if (ok) return true;
	}
	return false;
}

fn resolve_project_entry(workspace_root: str): str {
	if (workspace_root.empty()) return "";
	val root_p = Path(workspace_root);
	val toml_p = root_p.join("kobel.toml");
	if (toml_p.exists()) {
		val cfg = ProjectConfig(toml_p.raw);
		val entry_p = root_p.join(cfg.entry);
		if (entry_p.exists()) return entry_p.raw;
	}
	val fallback = root_p.join("src/main.kb");
	if (fallback.exists()) return fallback.raw;
	return "";
}

impl AnalysisResult {

	pub init() => Self(
		List<LspDiagnostic>(),
		SymbolTable(),
		false,
		List<Token>(),
		SemanticIndex(),
		"",
		""
	);

	pub init(path: str, source: str, workspace_root: str, include_workspace: bool = false) {
		var diagnostics = List<LspDiagnostic>();

		// 1. Lexical analysis
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();

		for (tok in tokens) {
			if (tok.type == TokenType.UNKNOWN) {
				val l0 = if (tok.line > 0) tok.line - 1 else 0;
				val c0 = if (tok.col > 0) tok.col - 1 else 0;
				diagnostics += LspDiagnostic(l0, c0, l0, c0 + 1, 1, "Unrecognized character or syntax");
			}
		}

		// 2. Syntax analysis (Parser)
		var parser = Parser(tokens);
		val prog = parser.parse_program();

		if (parser.errors.len > 0) {
			for (d in parser.errors) diagnostics += LspDiagnostic(d, source);
			var empty_symtab = SymbolTable();
			return Self(diagnostics, empty_symtab, false, tokens, SemanticIndex(), path, source);
		}

		var doc_mod = "";
		if (prog is Program as p) doc_mod = p.declared_module_name();
		if (doc_mod.empty()) doc_mod = path.base_name().path_to_module();

		// 3. Module loading (current doc + project entry for full dependency graph)
		val entry_dir = path.dir_of();
		val proj_root = if (!workspace_root.empty()) workspace_root else detect_project_root(entry_dir);
		var extra_roots = List<str>();
		if (!proj_root.empty()) {
			val root_p = Path(proj_root);
			extra_roots += proj_root;
			extra_roots += proj_root.join_path("lib");
			extra_roots += proj_root.join_path("src");
			val toml_p = root_p.join("kobel.toml");
			if (toml_p.exists()) {
				val cfg = ProjectConfig(toml_p.raw);
				val test_p = root_p.join(cfg.test_dir);
				if (test_p.exists()) extra_roots += test_p.raw;
			} else {
				val test_p = root_p.join("tests");
				if (test_p.exists()) extra_roots += test_p.raw;
			}
		}

		var loader = ModuleLoader(entry_dir, extra_roots);
		if (loader.find_module("std.traits").found) loader.ensure_module("std.traits");
		if (loader.find_module("std.string").found) loader.ensure_module("std.string");
		if (loader.find_module("std.range").found) loader.ensure_module("std.range");

		var full_prog: *AstNode? = null;
		val was_known = loader.is_known(doc_mod);
		var use_in_place = was_known;
		val pkg_files = loader.find_module_files(doc_mod);
		if (!was_known) {
			for ((f_path, _) in pkg_files) {
				if (paths_equal(f_path, path)) {
					loader.ensure_module(doc_mod);
					use_in_place = true;
					break;
				}
			}
		}

		if (use_in_place) {
			// Module already loaded in canonical file order: substitute live editor buffer for `path`
			val override_prog = loader.parse_source(path, source, doc_mod);
			if (override_prog != null) {
				loader.process_uses(override_prog, doc_mod);
				var replaced = false;
				for (i in 0..<loader.ordered.len) {
					if (paths_equal(loader.ordered[i].path, path)) {
						loader.ordered[i] = LoadedModule(doc_mod, path, override_prog, override_prog.span.file_id);
						replaced = true;
						break;
					}
				}
				if (!replaced) {
					loader.ordered += LoadedModule(doc_mod, path, override_prog, override_prog.span.file_id);
				}
			}
			full_prog = loader.build_merged_program();
		} else {
			val doc_prog = loader.load_program(path, source);

			// Load any sibling files belonging to the same module if not already loaded
			var pkg_dirty = false;
			for ((f_path, f_src) in pkg_files) {
				if (paths_equal(f_path, path)) continue;
				var seen_path = false;
				for (existing in loader.ordered) {
					if (paths_equal(existing.path, f_path)) {
						seen_path = true;
						break;
					}
				}
				if (seen_path) continue;
				val sib_prog = loader.parse_source(f_path, f_src, doc_mod) ?: continue;
				var declared = "";
				if (sib_prog is Program as sp) declared = sp.declared_module_name();
				if (!declared.empty() && declared != doc_mod) continue;
				loader.process_uses(sib_prog, doc_mod);
				loader.ordered += LoadedModule(doc_mod, f_path, sib_prog, sib_prog.span.file_id);
				pkg_dirty = true;
			}

			full_prog = if (pkg_dirty) loader.build_merged_program() else doc_prog;
		}

		// Optionally load project entry so reverse-dependencies on this file are indexed
		if (include_workspace && !proj_root.empty()) {
			val proj_entry = resolve_project_entry(proj_root);
			if (!proj_entry.empty() && !paths_equal(proj_entry, path)) {
				val entry_src = Path(proj_entry).read_text();
				if (!entry_src.empty()) {
					val ep = loader.parse_source(proj_entry, entry_src);
					if (ep != null && ep is Program as epp) {
						var entry_mod = epp.declared_module_name();
						if (entry_mod.empty()) entry_mod = proj_entry.base_name().path_to_module();
						if (!loader.is_known(entry_mod)) {
							loader.ensure_module(entry_mod);
							full_prog = loader.build_merged_program();
						}
					}
				}
			}
		}

		if (loader.errors.len > 0) {
			for (d in loader.errors) {
				if (is_error_for_doc(d, doc_mod, path)) diagnostics += LspDiagnostic(d, source);
			}
		}

		if (full_prog != null) {
			// Pre-index declarations and original unmangled names BEFORE DeclarationCollector mangles AST nodes in-place
			var index = prepare_semantic_index(&loader, path, source);

			var decl_p = DeclarationCollector();
			decl_p.collect_program(full_prog);
			if (decl_p.errors.len > 0) {
				for (d in decl_p.errors) {
					if (is_error_for_doc(d, doc_mod, path)) diagnostics += LspDiagnostic(d, source);
				}
			}

			var body_p = BodyChecker(decl_p.symtab, decl_p);
			body_p.check_program(full_prog);
			if (body_p.errors.len > 0) {
				for (d in body_p.errors) {
					if (is_error_for_doc(d, doc_mod, path)) diagnostics += LspDiagnostic(d, source);
				}
			}

			finish_semantic_index(&index, &loader, body_p.symtab, true, path, include_workspace);
			loader.arena.free();
			loader.sources.free();
			loader.errors.free();
			decl_p.errors.free();
			body_p.errors.free();
			return Self(diagnostics, body_p.symtab, true, tokens, index, path, source);
		}

		loader.arena.free();
		loader.sources.free();
		loader.errors.free();
		var empty_symtab = SymbolTable();
		return Self(diagnostics, empty_symtab, false, tokens, SemanticIndex(), path, source);
	}

	pub fn hover_at(*self, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type == TokenType.UNKNOWN || tok.text.empty()) return JsonValue.null_val();

		// 1. Check keywords (except `self` if resolved semantically)
		val kw_doc = keyword_hover(tok.text);
		if (kw_doc.len > 0) {
			val res = JsonValue.obj();
			val contents = JsonValue.obj();
			contents["kind"] = JsonValue.str("markdown");
			contents["value"] = JsonValue.str(kw_doc);
			res["contents"] = contents;
			return res;
		}

		// 2. Semantic index lookup (locals, params, fields, methods, enum variants, functions)
		val ref_hit = self.index.find_ref_at(self.file_path, target_line, target_col);
		if (!ref_hit.target_key.empty()) {
			val def = self.index.get_def(ref_hit.target_key);
			if (!def.key.empty()) {
				var md = "```kobel\n${def.signature}\n```";
				if (!def.module_name.empty()) md = "${md}\n\n*module* `${def.module_name}`";
				if (!ref_hit.type_str.empty() && ref_hit.type_str != def.type_str) {
					md = "${md} — type `${ref_hit.type_str}`";
				}
				val res = JsonValue.obj();
				val contents = JsonValue.obj();
				contents["kind"] = JsonValue.str("markdown");
				contents["value"] = JsonValue.str(md);
				res["contents"] = contents;
				return res;
			}
		}

		// 3. Fallback: SymbolTable lookup
		if (self.has_symtab && tok.type == TokenType.IDENTIFIER) {
			val sym = self.symtab.lookup(tok.text) ?: return JsonValue.null_val();
			var md = "```kobel\n";
			md = when (sym.kind) {
				SymbolKind.FN -> "${md}fn ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.STRUCT -> "${md}struct ${sym.name}";
				SymbolKind.ENUM -> "${md}enum ${sym.name}";
				SymbolKind.VAR -> "${md}var ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.CONST -> "${md}const ${sym.name}: ${sym.type_ptr.to_str()}";
				SymbolKind.PARAM -> "${md}param ${sym.name}: ${sym.type_ptr.to_str()}";
				else -> "${md}${sym.name}: ${sym.type_ptr.to_str()}";
			};
			md = "${md}\n```";

			val res = JsonValue.obj();
			val contents = JsonValue.obj();
			contents["kind"] = JsonValue.str("markdown");
			contents["value"] = JsonValue.str(md);
			res["contents"] = contents;
			return res;
		}

		return JsonValue.null_val();
	}

	pub fn definition_at(*self, doc_uri: str, line0: usz, col0: usz): *JsonValue {
		val target_line = line0 + 1;
		val target_col = col0 + 1;

		// 1. Semantic index cross-file definition lookup
		val ref_hit = self.index.find_ref_at(self.file_path, target_line, target_col);
		if (!ref_hit.target_key.empty()) {
			val def = self.index.get_def(ref_hit.target_key);
			if (!def.key.empty() && def.line > 0) {
				val target_uri = if (!def.file_path.empty()) path_to_uri(def.file_path) else doc_uri;
				val res = JsonValue.obj();
				res["uri"] = JsonValue.str(target_uri);

				val range = JsonValue.obj();
				val s_pos = JsonValue.obj();
				s_pos["line"] = JsonValue.num((def.line - 1) as i64);
				s_pos["character"] = JsonValue.num((if (def.col > 0) def.col - 1 else 0) as i64);
				val e_pos = JsonValue.obj();
				e_pos["line"] = JsonValue.num((def.line - 1) as i64);
				e_pos["character"] = JsonValue.num(((if (def.col > 0) def.col - 1 else 0) + def.len) as i64);
				range["start"] = s_pos;
				range["end"] = e_pos;

				res["range"] = range;
				return res;
			}
		}

		// 2. Fallback: SymbolTable lookup
		val tok = find_token_at(self.tokens, target_line, target_col);
		if (tok.type != TokenType.IDENTIFIER || tok.text.empty()) return JsonValue.null_val();

		if (self.has_symtab) {
			val sym = self.symtab.lookup(tok.text) ?: return JsonValue.null_val();
			if (sym.line > 0) {
				val res = JsonValue.obj();
				res["uri"] = JsonValue.str(doc_uri);
				val range = JsonValue.obj();
				val s_pos = JsonValue.obj();
				s_pos["line"] = JsonValue.num((sym.line - 1) as i64);
				s_pos["character"] = JsonValue.num((sym.col - 1) as i64);
				val e_pos = JsonValue.obj();
				e_pos["line"] = JsonValue.num((sym.line - 1) as i64);
				e_pos["character"] = JsonValue.num((sym.col - 1 + sym.name.len) as i64);
				range["start"] = s_pos;
				range["end"] = e_pos;
				res["range"] = range;
				return res;
			}
		}

		return JsonValue.null_val();
	}

	pub fn complete_at(*self, line0: usz = 0, col0: usz = 0): *JsonValue {
		val items = JsonValue.arr();
		val line1 = line0 + 1;
		val col1 = col0 + 1;

		// Check if cursor is right after `.` or `?.` for member completion
		var prev_dot = false;
		var recv_tok = Token(TokenType.UNKNOWN, "", 0, 0);
		for (i in 0..<self.tokens.len) {
			val t = self.tokens[i];
			if (t.line == line1 && (t.type == TokenType.DOT || t.type == TokenType.QUESTION_DOT)) {
				if (t.col + t.text.len == col1 || (i + 1 < self.tokens.len && self.tokens[i + 1].col <= col1 && col1 <= self.tokens[i + 1].col + self.tokens[i + 1].text.len)) {
					prev_dot = true;
					if (i > 0 && self.tokens[i - 1].line == line1) recv_tok = self.tokens[i - 1];
					break;
				}
			}
		}

		if (prev_dot && recv_tok.type == TokenType.IDENTIFIER) {
			var seen = HashSet<str>();
			// Check if receiver is a struct/enum type name or variable with known type
			var target_type_name = recv_tok.text;
			val recv_ref = self.index.find_ref_at(self.file_path, recv_tok.line, recv_tok.col);
			if (!recv_ref.target_key.empty() && !recv_ref.type_str.empty()) {
				var ts = recv_ref.type_str;
				if (ts.starts_with("*")) ts = ts.slice(1, ts.len);
				else if (ts.starts_with("&")) ts = ts.slice(1, ts.len);
				if (ts.ends_with("?")) ts = ts.slice(0, ts.len - 1);
				val lt = ts.index_of("<");
				if (lt >= 0) ts = ts.slice(0, lt as usz);
				val base_pair = self.index.c_inst_to_base.get_or(ts, "");
				if (!base_pair.empty()) {
					val colon = base_pair.index_of(":");
					target_type_name = if (colon >= 0) base_pair.slice((colon + 1) as usz, base_pair.len) else base_pair;
				} else {
					target_type_name = ts;
				}
			}

			for (def in self.index.defs) {
				if (def.container != target_type_name) continue;
				if (def.name in seen) continue;
				seen += def.name;
				val k = when (def.role) {
					SymRole.FIELD -> Completion.FIELD.value;
					SymRole.METHOD -> Completion.METHOD.value;
					SymRole.ENUM_VARIANT -> Completion.ENUM_MEMBER.value;
					else -> Completion.VARIABLE.value;
				};
				add_completion_item(items, def.name, k, def.signature);
			}
			if (!seen.empty()) return items;
		}

		// 1. Language Keywords (including new Kobel keywords)
		val kws = [
			"fn", "val", "var", "const", "struct", "enum", "trait", "impl",
			"when", "if", "else", "while", "for", "in", "return", "yield",
			"pub", "use", "mod", "extern", "defer", "is", "op", "init",
			"true", "false", "null", "as", "break", "continue"
		];
		for (kw in kws) add_completion_item(items, kw, Completion.KEYWORD.value, "keyword");

		// 2. Built-in & Standard Types
		val prims = [
			"i8", "i16", "i32", "i64", "isz",
			"u8", "u16", "u32", "u64", "usz",
			"f32", "f64", "bool", "char", "str", "none",
			"Range", "Array", "List", "HashMap", "HashSet"
		];
		for (pt in prims) add_completion_item(items, pt, Completion.TYPE.value, "type");

		// 3. Local variables/params in current file + module & imported symbols
		var added = HashSet<str>();
		for (def in self.index.defs) {
			if (def.role == SymRole.LOCAL || def.role == SymRole.PARAM) {
				if (!paths_equal(def.file_path, self.file_path)) continue;
				if (def.line > line1) continue;
			} else if (def.role == SymRole.FIELD || def.role == SymRole.METHOD || def.role == SymRole.ENUM_VARIANT) {
				continue;
			}
			if (def.name in added) continue;
			added += def.name;
			val k = when (def.role) {
				SymRole.FN -> Completion.FUNCTION.value;
				SymRole.STRUCT -> Completion.STRUCT.value;
				SymRole.ENUM -> Completion.ENUM.value;
				SymRole.TRAIT -> Completion.TYPE.value;
				SymRole.CONST -> Completion.CONSTANT.value;
				SymRole.MODULE -> Completion.MODULE.value;
				else -> Completion.VARIABLE.value;
			};
			add_completion_item(items, def.name, k, def.signature);
		}

		return items;
	}

	pub fn signature_help_at(*self, line0: usz, col0: usz): *JsonValue {
		val line1 = line0 + 1;
		val col1 = col0 + 1;

		// Walk backwards through tokens before cursor to find enclosing `(`
		var idx: isz = -1;
		for (i in 0..<self.tokens.len) {
			val t = self.tokens[i];
			if (t.line < line1 || (t.line == line1 && t.col < col1)) idx = i as isz;
			else break;
		}
		if (idx < 0) return JsonValue.null_val();

		var depth: i32 = 0;
		var commas: i64 = 0;
		var open_idx: isz = -1;
		var cur = idx;
		while (cur >= 0) {
			val t = self.tokens[cur as usz];
			if (t.type == TokenType.CLOSE_PAREN) depth++;
			else if (t.type == TokenType.OPEN_PAREN) {
				if (depth == 0) {
					open_idx = cur;
					break;
				}
				depth--;
			} else if (t.type == TokenType.COMMA && depth == 0) {
				commas++;
			}
			cur--;
		}
		if (open_idx <= 0) return JsonValue.null_val();

		val callee_tok = self.tokens[(open_idx - 1) as usz];
		if (callee_tok.type != TokenType.IDENTIFIER) return JsonValue.null_val();

		var def = DefInfo("", "", SymRole.FN, "", "", "", 0, 0, 0, "", "");
		val ref_hit = self.index.find_ref_at(self.file_path, callee_tok.line, callee_tok.col);
		if (!ref_hit.target_key.empty()) def = self.index.get_def(ref_hit.target_key);
		if (def.key.empty()) {
			for (d in self.index.defs) {
				if ((d.role == SymRole.FN || d.role == SymRole.METHOD) && d.name == callee_tok.text) {
					def = d;
					break;
				}
			}
		}
		if (def.key.empty()) return JsonValue.null_val();

		val sig_obj = JsonValue.obj();
		sig_obj["label"] = JsonValue.str(def.signature);
		val params_arr = JsonValue.arr();
		for (i in 0..<def.param_names.len) {
			val p_obj = JsonValue.obj();
			val pt = if (i < def.param_types.len) def.param_types[i] else "any";
			p_obj["label"] = JsonValue.str("${def.param_names[i]}: ${pt}");
			params_arr += p_obj;
		}
		sig_obj["parameters"] = params_arr;

		val sigs_arr = JsonValue.arr();
		sigs_arr += sig_obj;

		val res = JsonValue.obj();
		res["signatures"] = sigs_arr;
		res["activeSignature"] = JsonValue.num(0);
		res["activeParameter"] = JsonValue.num(commas);
		return res;
	}

	pub fn document_highlights(*self, line0: usz, col0: usz): *JsonValue {
		val arr = JsonValue.arr();
		val hit = self.index.find_ref_at(self.file_path, line0 + 1, col0 + 1);
		if (hit.target_key.empty()) return arr;
		val refs = self.index.find_refs_for_key(hit.target_key, true);
		for (r in refs) {
			if (!paths_equal(r.file_path, self.file_path)) continue;
			val item = JsonValue.obj();
			val range = JsonValue.obj();
			val s_pos = JsonValue.obj();
			s_pos["line"] = JsonValue.num((r.line - 1) as i64);
			s_pos["character"] = JsonValue.num((r.col - 1) as i64);
			val e_pos = JsonValue.obj();
			e_pos["line"] = JsonValue.num((r.line - 1) as i64);
			e_pos["character"] = JsonValue.num((r.col - 1 + r.len) as i64);
			range["start"] = s_pos;
			range["end"] = e_pos;
			item["range"] = range;
			// DocumentHighlightKind: 2 = Read, 3 = Write
			item["kind"] = JsonValue.num(if (r.is_write) 3 else 2);
			arr += item;
		}
		return arr;
	}

	pub fn workspace_symbols(*self, query: str): *JsonValue {
		val arr = JsonValue.arr();
		for (def in self.index.defs) {
			if (def.role == SymRole.LOCAL || def.role == SymRole.PARAM) continue;
			if (!contains_ci(def.name, query)) continue;
			val item = JsonValue.obj();
			item["name"] = JsonValue.str(def.name);
			val k = when (def.role) {
				SymRole.MODULE -> DocSymbol.MODULE.value;
				SymRole.FN -> DocSymbol.FUNCTION.value;
				SymRole.METHOD -> DocSymbol.METHOD.value;
				SymRole.STRUCT -> DocSymbol.STRUCT.value;
				SymRole.FIELD -> DocSymbol.FIELD.value;
				SymRole.ENUM -> DocSymbol.ENUM.value;
				SymRole.ENUM_VARIANT -> DocSymbol.ENUM_MEMBER.value;
				SymRole.TRAIT -> DocSymbol.INTERFACE.value;
				SymRole.CONST -> DocSymbol.CONSTANT.value;
				else -> DocSymbol.VARIABLE.value;
			};
			item["kind"] = JsonValue.num(k);
			if (!def.container.empty()) item["containerName"] = JsonValue.str(def.container);

			val loc = JsonValue.obj();
			loc["uri"] = JsonValue.str(path_to_uri(def.file_path));
			val range = JsonValue.obj();
			val s_pos = JsonValue.obj();
			s_pos["line"] = JsonValue.num((if (def.line > 0) def.line - 1 else 0) as i64);
			s_pos["character"] = JsonValue.num((if (def.col > 0) def.col - 1 else 0) as i64);
			val e_pos = JsonValue.obj();
			e_pos["line"] = JsonValue.num((if (def.line > 0) def.line - 1 else 0) as i64);
			e_pos["character"] = JsonValue.num(((if (def.col > 0) def.col - 1 else 0) + def.len) as i64);
			range["start"] = s_pos;
			range["end"] = e_pos;
			loc["range"] = range;
			item["location"] = loc;
			arr += item;
		}
		return arr;
	}

}

// ============================================================================
// Hierarchical Document Symbol Outline & Formatting Providers
// ============================================================================

fn make_doc_symbol(name: str, kind: i64, line1: usz, col1: usz, children: *JsonValue? = null): *JsonValue {
	val item = JsonValue.obj();
	item["name"] = JsonValue.str(name);
	item["kind"] = JsonValue.num(kind);

	val l0 = if (line1 > 0) line1 - 1 else 0;
	val c0 = if (col1 > 0) col1 - 1 else 0;
	val range = JsonValue.obj();
	val s_pos = JsonValue.obj();
	s_pos["line"] = JsonValue.num(l0);
	s_pos["character"] = JsonValue.num(c0);
	val e_pos = JsonValue.obj();
	e_pos["line"] = JsonValue.num(l0);
	e_pos["character"] = JsonValue.num(c0 + name.len);
	range["start"] = s_pos;
	range["end"] = e_pos;

	item["range"] = range;
	item["selectionRange"] = range;
	if (children != null) item["children"] = children;
	return item;
}

impl AnalysisResult {

	pub fn document_symbols(source: str): *JsonValue {
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();
		var parser = Parser(tokens);
		val arr = JsonValue.arr();
		val prog_node = parser.parse_program() ?: return arr;

		if (prog_node is Program as prog) {
			for (decl in prog) {
				val dl = decl.line;
				val dc = decl.col;
				when (decl) {
					is ModuleDecl -> {
						arr += make_doc_symbol(decl.full_path, DocSymbol.MODULE.value, dl, dc);
					}
					is FnDecl -> {
						arr += make_doc_symbol(decl.name, DocSymbol.FUNCTION.value, dl, dc);
					}
					is StructDecl -> {
						val kids = JsonValue.arr();
						for (f in decl.fields) {
							kids += make_doc_symbol(f.name, DocSymbol.FIELD.value, f.type_node.line, 1);
						}
						arr += make_doc_symbol(decl.name, DocSymbol.STRUCT.value, dl, dc, kids);
					}
					is EnumDecl -> {
						val kids = JsonValue.arr();
						for (m in decl.members) {
							kids += make_doc_symbol(m.name, DocSymbol.ENUM_MEMBER.value, m.line, m.col);
						}
						arr += make_doc_symbol(decl.name, DocSymbol.ENUM.value, dl, dc, kids);
					}
					is TraitDecl -> {
						val kids = JsonValue.arr();
						for (m in decl.methods) {
							val ml = m.line;
							val mc = m.col;
							if (m is FnDecl as mf) {
								kids += make_doc_symbol(mf.name, DocSymbol.METHOD.value, ml, mc);
							}
						}
						arr += make_doc_symbol(decl.name, DocSymbol.INTERFACE.value, dl, dc, kids);
					}
					is ImplDecl -> {
						val kids = JsonValue.arr();
						for (m in decl.methods) {
							val ml = m.line;
							val mc = m.col;
							if (m is FnDecl as mf) {
								val mname = if (mf.initializer) "init" else if (mf.operator) "op ${mf.name}" else mf.name;
								kids += make_doc_symbol(mname, DocSymbol.METHOD.value, ml, mc);
							}
						}
						val label = if (decl.trait_name.empty()) "impl ${decl.struct_name}"
							else "impl ${decl.trait_name} for ${decl.struct_name}";
						arr += make_doc_symbol(label, DocSymbol.CLASS.value, dl, dc, kids);
					}
					is ConstDecl -> {
						arr += make_doc_symbol(decl.name, DocSymbol.CONSTANT.value, dl, dc);
					}
				}
			}
		}

		return arr;
	}

	pub fn format_document(text: str): *JsonValue {
		val options = FormatOptions();
		val formatted = format_source(text, options);

		val edits = JsonValue.arr();
		val edit = JsonValue.obj();

		val range = JsonValue.obj();
		val start_pos = JsonValue.obj();
		start_pos["line"] = JsonValue.num(0);
		start_pos["character"] = JsonValue.num(0);

		val end_pos = JsonValue.obj();
		end_pos["line"] = JsonValue.num(999999);
		end_pos["character"] = JsonValue.num(0);
		range["start"] = start_pos;
		range["end"] = end_pos;

		edit["range"] = range;
		edit["newText"] = JsonValue.str(formatted);
		edits += edit;

		return edits;
	}

}
