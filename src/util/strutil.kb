mod util.strutil;

use std.str.*;
use std.mem.alloc.alloc_array;
use std.collections.list.List;

// ============================================================================
// String utilities shared by the compiler
//
// These helpers build strings from byte buffers (alloc_array<u8> + str_from_bytes)
// so that they keep working regardless of how `str` is represented by the
// active backend (they never rely on `str + str` operator overloading).
// ============================================================================

extern "libc" {
	fn strlen(s: *char): usz;
}

// Views a NUL-terminated C string as a `str`. The buffer is shared, not copied,
// so it must outlive the returned value (used for argv et al.).
pub fn cstr_to_str(s: *char) => str_from_bytes(s as &u8, strlen(s));

pub fn str_is_sep(c: char) => c == '/' || c == '\\';

impl str {
	// "std.io" -> "std/io" (module path -> relative file path, without extension)
	pub fn module_to_rel(val self) => self.replace_char('.', '/');

	// "sub/x.kb" -> "sub.x"  (relative file path -> module name)
	pub fn path_to_module(val self): str {
		val stem = self.strip_kb();
		val buf = alloc_array<u8>(stem.len + 1);
		for (i in 0..<stem.len) {
			val c = stem[i];
			if (str_is_sep(c)) buf[i] = '.' as u8;
			else buf[i] = c as u8;
		}
		buf[stem.len] = 0;
		return str_from_bytes(buf, stem.len);
	}

	pub fn has_kb_suffix(val self) => self.ends_with(".kb");

	// Strips a trailing ".kb" extension when present.
	pub fn strip_kb(val self): str => if (self.ends_with(".kb")) self.strip_suffix(3) else self;

	// Directory part of a path ("" when the path has no separator).
	pub fn dir_of(val self): str {
		var last: usz = 0;
		var found = false;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) {
				last = i;
				found = true;
			}
		}

		if (!found) return "";
		return self.slice(0, last);
	}

	// File name part of a path (input with separators included).
	pub fn base_name(val self): str {
		var start: usz = 0;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) start = i + 1;
		}

		return self.slice(start);
	}

	// Joins a directory and a relative path with a single '/' separator.
	pub fn join_path(val self, rel: str): str {
		if (self.empty()) return rel;
		if (str_is_sep(self[self.len - 1])) return "${self}${rel}";
		return "${self}/${rel}";
	}

	pub fn split_dots(val self): List<str> {
		var parts = List<str>();
		var start: usz = 0;
		for (i in 0..<self.len) {
			if (self[i] == '.') {
				parts.add(self.slice(start, i));
				start = i + 1;
			}
		}

		parts.add(self.slice(start));
		return parts;
	}

	// Builds the C identifier used for a top-level symbol of `module_name`.
	// "std.io" + "println" -> "std__io__println"
	pub fn mangle_symbol(val self, name: str): str {
		if (self.empty()) return name;
		// Each '.' is written as 2 '_' characters, so allocate extra (2x the module part) to be safe.
		val total = self.len * 2 + 2 + name.len;
		val buf = alloc_array<u8>(total + 1);

		var w = 0;
		for (c in self) {
			when (c) {
				'.' -> {
					buf[w] = '_' as u8;
					buf[w + 1] = '_' as u8;
					w += 2;
				}
				'_', '-' -> {
					// keep '_' as is, map '-' to '_' to stay a valid C identifier
					buf[w] = '_' as u8;
					w++;
				}
				else -> {
					buf[w] = c as u8;
					w++;
				}
			}
		}

		buf[w] = '_' as u8;
		buf[w + 1] = '_' as u8;
		w += 2;
		for (c in name) {
			buf[w] = c as u8;
			w++;
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	// Path-byte remap: every `from` byte becomes `to`, and A-Z lowercases when
	// `fold_case` (only `normalize_path` needs that). One pass, one allocation —
	// shared by the three path-conversion helpers below.
	fn remap_path_bytes(val self, from: char, to: char, fold_case: bool): str {
		val buf = alloc_array<u8>(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			buf[i] = when {
				c == from -> to as u8;
				fold_case && c >= 'A' && c <= 'Z' -> ((c as i32) + 32) as u8;
				else -> c as u8;
			};
		}

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	pub fn normalize_path(val self) => self.remap_path_bytes('\\', '/', true);

	// Converts '/' to '\\' for Windows tools (cmd, del, etc.)
	pub fn to_win_path(val self) => self.remap_path_bytes('/', '\\', false);

	// Converts '\\' to '/' for cross-platform and POSIX path representations
	pub fn to_posix_path(val self) => self.remap_path_bytes('\\', '/', false);

	pub fn trim(val self): str {
		if (self.empty()) return self;
		var start: usz = 0;
		while (start < self.len) {
			val c = self[start];
			if (c == ' ' || c == '\t' || c == '\r' || c == '\n') start++;
			else break;
		}
		if (start == self.len) return "";
		var end: usz = self.len;
		while (end > start) {
			val c = self[end - 1];
			if (c == ' ' || c == '\t' || c == '\r' || c == '\n') end--;
			else break;
		}
		return self.slice(start, end);
	}

	pub fn split_lines(val self): List<str> {
		var res = List<str>();
		var start = 0;
		var i = 0;
		while (i < self.len) {
			val c = self[i];
			if (c == '\n') {
				var line_end = i;
				if (line_end > start && self[line_end - 1] == '\r') {
					line_end = line_end - 1;
				}
				res.add(self.slice(start, line_end));
				start = i + 1;
			}
			i++;
		}

		if (start <= self.len) {
			var line_end = self.len;
			if (line_end > start && self[line_end - 1] == '\r') {
				line_end = line_end - 1;
			}
			res.add(self.slice(start, line_end));
		}
		return res;
	}

	pub fn hash_stamp(val self): str {
		var h = 5381UL;
		for (c in self) {
			h = ((h * 33) + (c as u64)) % 1000000007;
		}
		return "${h}_${self.len}";
	}

	pub fn trim_indent(val self): str => multiline_trim_indent(self);
}

pub fn str_is_blank(s: str): bool {
	for (c in s) {
		if (c != ' ' && c != '\t' && c != '\r') return false;
	}
	return true;
}

pub fn common_whitespace_prefix(lines: List<str>, start_idx: usz, end_idx: usz): str {
	var prefix = "";
	var first = true;

	for (i in start_idx..<end_idx) {
		val line = lines[i];
		if (str_is_blank(line)) continue;

		var ws = "";
		for (c in line) {
			if (c == ' ' || c == '\t') ws = "${ws}${c}";
			else break;
		}

		if (first) {
			prefix = ws;
			first = false;
		} else {
			var match_len: usz = 0;
			val max_l = if (prefix.len < ws.len) prefix.len else ws.len;
			while (match_len < max_l && prefix[match_len] == ws[match_len]) {
				match_len++;
			}
			prefix = prefix.slice(0, match_len);
		}
	}

	return prefix;
}

pub fn multiline_trim_indent(raw: str): str {
	if (raw.empty()) return "";
	val lines = raw.split_lines();
	if (lines.len == 0) return "";
	if (lines.len == 1) return lines[0];

	var start_idx: usz = 0;
	if (str_is_blank(lines[0])) {
		start_idx = 1;
	}

	var end_idx: usz = lines.len;
	if (end_idx > start_idx && str_is_blank(lines[end_idx - 1])) {
		end_idx = end_idx - 1;
	}

	val prefix = common_whitespace_prefix(lines, start_idx, end_idx);

	var res = "";
	var first = true;
	for (i in start_idx..<end_idx) {
		val line = lines[i];
		val trimmed_line = if (str_is_blank(line)) ""
		else if (line.starts_with(prefix)) line.slice(prefix.len, line.len)
		else line;

		if (first) {
			res = trimmed_line;
			first = false;
		} else {
			res = "${res}\n${trimmed_line}";
		}
	}

	return res;
}

pub fn multiline_escape_for_c(text: str): str {
	var out = "\"";
	var i: usz = 0;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			if (i + 1 < text.len) {
				val next_c = text[i + 1];
				if (next_c == '$') {
					out = "${out}$";
					i += 2;
					continue;
				}
				if (next_c == '\\') {
					out = "${out}\\\\";
					i += 2;
					continue;
				}
				if (next_c == '"') {
					out = "${out}\\\"";
					i += 2;
					continue;
				}
				out = "${out}\\${next_c}";
				i += 2;
				continue;
			}
			out = "${out}\\\\";
			i++;
			continue;
		}
		if (c == '"') {
			out = "${out}\\\"";
			i++;
			continue;
		}
		if (c == '\n') {
			out = "${out}\\n";
			i++;
			continue;
		}
		if (c == '\r') {
			i++;
			continue;
		}
		out = "${out}${text.slice(i, i + 1)}";
		i++;
	}
	out = "${out}\"";
	return out;
}

pub fn str_join_dots(parts: List<str>, count: usz): str {
	var total = 0;
	for (i in 0..<count) total += parts[i].len;
	if (count > 1) total += (count - 1);

	val buf = alloc_array<u8>(total + 1);
	var w = 0;
	for (i in 0..<count) {
		val p = parts[i];
		for (c in p) {
			buf[w] = c as u8;
			w++;
		}
		if (i + 1 < count) {
			buf[w] = '.' as u8;
			w++;
		}
	}

	buf[w] = 0;
	return str_from_bytes(buf, w);
}
