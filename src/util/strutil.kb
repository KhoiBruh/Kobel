mod util.strutil;

use std.string.*;
use std.memory.*;
use std.collections.List;
use std.collections.StringBuilder;

// ============================================================================
// String utilities shared by the compiler
//
// These helpers build strings from byte buffers (create_array<u8> + str_from_bytes)
// so that they keep working regardless of how `str` is represented by the
// active backend (they never rely on `str + str` operator overloading).
// ============================================================================

extern "libc" {
	fn strlen(s: *char): usz;
}

// Views a NUL-terminated C string as a `str`. The buffer is shared, not copied,
// so it must outlive the returned value (used for argv et al.).
pub fn cstr_to_str(s: *char) => str_from_bytes(s as &u8, strlen(s));

impl str {
	// "std.io" -> "std/io" (module path -> relative file path, without extension)
	pub fn module_to_rel(val self) => self.replace_char('.', '/');

	// "sub/x.kb" -> "sub.x"  (relative file path -> module name)
	pub fn path_to_module(val self): str {
		val stem = self.strip_kb();
		val buf = Heap.create_array<u8>(stem.len + 1);
		for (i in 0..<stem.len) {
			val c = stem[i];
			if (str_is_sep(c)) buf[i] = '.'.code();
			else buf[i] = c.code();
		}
		buf[stem.len] = 0;
		return str_from_bytes(buf, stem.len);
	}

	pub fn has_kb_suffix(val self) => self.ends_with(".kb");

	// Strips a trailing ".kb" extension when present.
	pub fn strip_kb(val self): str => if (self.ends_with(".kb")) self.strip_suffix(3) else self;

	pub fn split_dots(val self): List<str> {
		var parts = List<str>();
		var start: usz = 0;
		for (i in 0..<self.len) {
			if (self[i] == '.') {
				parts += self.slice(start, i);
				start = i + 1;
			}
		}

		parts += self.slice(start);
		return parts;
	}

	// Builds the C identifier used for a top-level symbol of `module_name`.
	// "std.io" + "println" -> "std__io__println"
	pub fn mangle_symbol(val self, name: str): str {
		if (self.empty()) return name;
		// Each '.' is written as 2 '_' characters, so allocate extra (2x the module part) to be safe.
		val total = self.len * 2 + 2 + name.len;
		val buf = Heap.create_array<u8>(total + 1);

		var w: usz = 0;
		for (c in self) {
			when (c) {
				'.' -> {
					buf[w] = '_'.code();
					buf[w + 1] = '_'.code();
					w += 2;
				}
				'_', '-' -> {
					// keep '_' as is, map '-' to '_' to stay a valid C identifier
					buf[w] = '_'.code();
					w++;
				}
				else -> {
					buf[w] = c.code();
					w++;
				}
			}
		}

		buf[w] = '_'.code();
		buf[w + 1] = '_'.code();
		w += 2;
		for (c in name) {
			buf[w] = c.code();
			w++;
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn hash_stamp(val self): str {
		var h: u64 = 5381;
		for (c in self) {
			h = ((h * 33) + c.code()) % 1000000007;
		}
		return "${h}_${self.len}";
	}

	pub fn trim_indent(val self): str => multiline_trim_indent(self);
}

pub fn str_is_blank(s: str): bool {
	for (c in s) {
		if (c != ' ' && c != '\t' && c != '\r') return false;
	}
	return true;
}

pub fn common_whitespace_prefix(lines: List<str>, start_idx: usz, end_idx: usz): str {
	var prefix = "";
	var first = true;

	for (i in start_idx..<end_idx) {
		val line = lines[i];
		if (str_is_blank(line)) continue;

		var ws_end: usz = 0;
		for (c in line) {
			if (c == ' ' || c == '\t') ws_end++;
			else break;
		}
		val ws = line.slice(0, ws_end);

		if (first) {
			prefix = ws;
			first = false;
		} else {
			var match_len: usz = 0;
			val max_l = if (prefix.len < ws.len) prefix.len else ws.len;
			while (match_len < max_l && prefix[match_len] == ws[match_len]) {
				match_len++;
			}
			prefix = prefix.slice(0, match_len);
		}
	}

	return prefix;
}

pub fn multiline_trim_indent(raw: str): str {
	if (raw.empty()) return "";
	val lines = raw.split_lines();
	if (lines.empty()) return "";
	if (lines.len == 1) return lines[0];

	var start_idx: usz = 0;
	if (str_is_blank(lines[0])) {
		start_idx = 1;
	}

	var end_idx: usz = lines.len;
	if (end_idx > start_idx && str_is_blank(lines[end_idx - 1])) {
		end_idx = end_idx - 1;
	}

	val prefix = common_whitespace_prefix(lines, start_idx, end_idx);

	var sb = StringBuilder();
	defer sb.free();
	var first = true;
	for (i in start_idx..<end_idx) {
		val line = lines[i];
		val trimmed_line = if (str_is_blank(line)) ""
		else if (line.starts_with(prefix)) line.slice(prefix.len, line.len)
		else line;

		if (first) {
			sb += trimmed_line;
			first = false;
		} else {
			sb += '\n';
			sb += trimmed_line;
		}
	}

	return sb.to_str();
}

pub fn multiline_escape_for_c(text: str): str {
	var out = StringBuilder();
	defer out.free();
	out += '"';
	var i: usz = 0;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			if (i + 1 < text.len) {
				val next_c = text[i + 1];
				if (next_c == '$') {
					out += '$';
					i += 2;
					continue;
				}
				if (next_c == '\\') {
					out += "\\\\";
					i += 2;
					continue;
				}
				if (next_c == '"') {
					out += "\\\"";
					i += 2;
					continue;
				}
				out += '\\';
				out += next_c;
				i += 2;
				continue;
			}
			out += "\\\\";
			i++;
			continue;
		}
		if (c == '"') {
			out += "\\\"";
			i++;
			continue;
		}
		if (c == '\n') {
			out += "\\n";
			i++;
			continue;
		}
		if (c == '\r') {
			i++;
			continue;
		}
		out += c;
		i++;
	}
	out += '"';
	return out.to_str();
}

pub fn str_join_dots(parts: List<str>, count: usz): str {
	var total: usz = 0;
	for (i in 0..<count) total += parts[i].len;
	if (count > 1) total += (count - 1);

	val buf = Heap.create_array<u8>(total + 1);
	var w: usz = 0;
	for (i in 0..<count) {
		val p = parts[i];
		for (c in p) {
			buf[w] = c.code();
			w++;
		}
		if (i + 1 < count) {
			buf[w] = '.'.code();
			w++;
		}
	}

	buf[w] = 0;
	return str_from_bytes(buf, w);
}
