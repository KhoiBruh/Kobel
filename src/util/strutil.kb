mod util.strutil;

use std.collections.list.List;
use std.mem.alloc.raw_alloc;
use std.mem.alloc.raw_release;

// ============================================================================
// String utilities shared by the compiler
//
// These helpers build strings from raw byte buffers (raw_alloc + StrRaw) so
// that they keep working regardless of how `str` is represented by the
// active backend (they never rely on `str + str` operator overloading).
// ============================================================================

extern "libc" {
	fn strlen(s: *char): usz;
}

struct StrRaw {
	pub data: *char,
	pub len: usz,
	pub cap: usz
}

// Wraps a heap byte buffer (already NUL terminated) into a `str` value.
pub fn str_from_bytes(buf: &u8, len: usz): str {
	val raw_mem = raw_alloc(24);
	val r = raw_mem as &StrRaw;
	r.data = buf as *char;
	r.len = len;
	r.cap = len + 1;
	val sp: *str = r as *str;
	val res: str = *sp;
	raw_release(raw_mem);
	return res;
}

// Views a NUL-terminated C string as a `str`. The buffer is shared, not copied,
// so it must outlive the returned value (used for argv et al.).
pub fn cstr_to_str(s: *char): str => str_from_bytes(s as &u8, strlen(s));

pub fn str_is_sep(c: char) => c == '/' || c == '\\';

// "std.io" -> "std/io" (module path -> relative file path, without extension)
pub fn str_module_to_rel(module_name: str): str {
	val buf = raw_alloc(module_name.len + 1);
	for (i in 0..<module_name.len) {
		val c = module_name[i];
		if (c == '.') buf[i] = '/' as u8;
		else buf[i] = c as u8;
	}
	buf[module_name.len] = 0;
	return str_from_bytes(buf, module_name.len);
}

// "sub/x.kb" -> "sub.x"  (relative file path -> module name)
pub fn str_path_to_module(rel_path: str): str {
	val stem = str_strip_kb(rel_path);
	val buf = raw_alloc(stem.len + 1);
	for (i in 0..<stem.len) {
		val c = stem[i];
		if (str_is_sep(c)) buf[i] = '.' as u8;
		else buf[i] = c as u8;
	}
	buf[stem.len] = 0;
	return str_from_bytes(buf, stem.len);
}

pub fn str_has_kb_suffix(path: str): bool => path.len >= 3 &&
	path[path.len - 3] == '.' &&
	path[path.len - 2] == 'k' &&
	path[path.len - 1] == 'b';

// Strips a trailing ".kb" extension when present.
pub fn str_strip_kb(path: str): str =>
	if (str_has_kb_suffix(path)) path.slice(0, path.len - 3) else path;

// Directory part of a path ("" when the path has no separator).
pub fn str_dir_of(path: str): str {
	var last: usz = 0;
	var found = false;
	for (i in 0..<path.len) {
		if (str_is_sep(path[i])) {
			last = i;
			found = true;
		}
	}
	if (!found) return "";
	return path.slice(0, last);
}

// File name part of a path (input with separators included).
pub fn str_base_name(path: str): str {
	var start: usz = 0;
	for (i in 0..<path.len) {
		if (str_is_sep(path[i])) start = i + 1;
	}
	return path.slice(start);
}

// Joins a directory and a relative path with a single '/' separator.
pub fn str_join_path(dir: str, rel: str): str => if (dir.len == 0) rel else "${dir}/${rel}";

pub fn str_join_dots(parts: List<str>, count: usz): str {
	var total: usz = 0;
	for (i in 0..<count) {
		total = total + parts[i].len;
	}
	if (count > 1) total = total + (count - 1);

	val buf = raw_alloc(total + 1);
	var w: usz = 0;
	for (i in 0..<count) {
		val p = parts[i];
		for (c in p) {
			buf[w] = c as u8;
			w = w + 1;
		}
		if (i + 1 < count) {
			buf[w] = '.' as u8;
			w = w + 1;
		}
	}
	buf[w] = 0;
	return str_from_bytes(buf, w);
}

pub fn str_split_dots(s: str): List<str> {
	var parts = List<str>();
	var start: usz = 0;
	for (i in 0..<s.len) {
		if (s[i] == '.') {
			parts.add(s.slice(start, i));
			start = i + 1;
		}
	}
	parts.add(s.slice(start));
	return parts;
}

// Builds the C identifier used for a top-level symbol of `module_name`.
// "std.io" + "println" -> "std__io__println"
pub fn str_mangle_symbol(module_name: str, name: str): str {
	if (module_name.len == 0) return name;
	// Each '.' is written as 2 '_' characters, so allocate extra (2x the module part) to be safe.
	val total = module_name.len * 2 + 2 + name.len;
	val buf = raw_alloc(total + 1);
	var w: usz = 0;
	for (c in module_name) {
		if (c == '.') {
			buf[w] = '_' as u8;
			buf[w + 1] = '_' as u8;
			w = w + 2;
		} else if (c == '_' || c == '-') {
			// keep '_' as is, map '-' to '_' to stay a valid C identifier
			buf[w] = '_' as u8;
			w = w + 1;
		} else {
			buf[w] = c as u8;
			w = w + 1;
		}
	}
	buf[w] = '_' as u8;
	buf[w + 1] = '_' as u8;
	w = w + 2;
	for (c in name) {
		buf[w] = c as u8;
		w = w + 1;
	}
	buf[w] = 0;
	return str_from_bytes(buf, w);
}

pub fn str_starts_with(s: str, prefix: str): bool {
	if (s.len < prefix.len) return false;
	return s.slice(0, prefix.len) == prefix;
}

