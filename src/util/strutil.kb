mod util.strutil;

use std.str.*;
use std.mem.alloc.raw_alloc;
use std.collections.list.List;

// ============================================================================
// String utilities shared by the compiler
//
// These helpers build strings from raw byte buffers (raw_alloc + StrRaw) so
// that they keep working regardless of how `str` is represented by the
// active backend (they never rely on `str + str` operator overloading).
// ============================================================================

extern "libc" {
	fn strlen(s: *char): usz;
}

// Views a NUL-terminated C string as a `str`. The buffer is shared, not copied,
// so it must outlive the returned value (used for argv et al.).
pub fn cstr_to_str(s: *char) => str_from_bytes(s as &u8, strlen(s));

pub fn str_is_sep(c: char) => c == '/' || c == '\\';

impl str {
	// "std.io" -> "std/io" (module path -> relative file path, without extension)
	pub fn module_to_rel(val self): str {
		val buf = raw_alloc(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			if (c == '.') buf[i] = '/' as u8;
			else buf[i] = c as u8;
		}
		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	// "sub/x.kb" -> "sub.x"  (relative file path -> module name)
	pub fn path_to_module(val self): str {
		val stem = self.strip_kb();
		val buf = raw_alloc(stem.len + 1);
		for (i in 0..<stem.len) {
			val c = stem[i];
			if (str_is_sep(c)) buf[i] = '.' as u8;
			else buf[i] = c as u8;
		}
		buf[stem.len] = 0;
		return str_from_bytes(buf, stem.len);
	}

	pub fn has_kb_suffix(val self): bool => self.ends_with(".kb");

	// Strips a trailing ".kb" extension when present.
	pub fn strip_kb(val self): str => if (self.ends_with(".kb")) self.strip_suffix(3) else self;


	// Directory part of a path ("" when the path has no separator).
	pub fn dir_of(val self): str {
		var last = 0UZ;
		var found = false;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) {
				last = i;
				found = true;
			}
		}

		if (!found) return "";
		return self.slice(0, last);
	}

	// File name part of a path (input with separators included).
	pub fn base_name(val self): str {
		var start = 0UZ;
		for (i in 0..<self.len) {
			if (str_is_sep(self[i])) start = i + 1;
		}

		return self.slice(start);
	}

	// Joins a directory and a relative path with a single '/' separator.
	pub fn join_path(val self, rel: str): str {
		if (self.empty()) return rel;
		if (str_is_sep(self[self.len - 1])) return "${self}${rel}";
		return "${self}/${rel}";
	}

	pub fn split_dots(val self): List<str> {
		var parts = List<str>();
		var start = 0UZ;
		for (i in 0..<self.len) {
			if (self[i] == '.') {
				parts.add(self.slice(start, i));
				start = i + 1;
			}
		}

		parts.add(self.slice(start));
		return parts;
	}

	// Builds the C identifier used for a top-level symbol of `module_name`.
	// "std.io" + "println" -> "std__io__println"
	pub fn mangle_symbol(val self, name: str): str {
		if (self.empty()) return name;
		// Each '.' is written as 2 '_' characters, so allocate extra (2x the module part) to be safe.
		val total = self.len * 2 + 2 + name.len;
		val buf = raw_alloc(total + 1);

		var w = 0UZ;
		for (c in self) {
			when (c) {
				'.' -> {
					buf[w] = '_' as u8;
					buf[w + 1] = '_' as u8;
					w += 2;
				}
				'_', '-' -> {
					// keep '_' as is, map '-' to '_' to stay a valid C identifier
					buf[w] = '_' as u8;
					w++;
				}
				else -> {
					buf[w] = c as u8;
					w++;
				}
			}
		}

		buf[w] = '_' as u8;
		buf[w + 1] = '_' as u8;
		w += 2;
		for (c in name) {
			buf[w] = c as u8;
			w++;
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn normalize_path(val self): str {
		val buf = raw_alloc(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			buf[i] = when {
				c == '\\' -> '/' as u8;
				c >= 'A' && c <= 'Z' -> ((c as i32) + 32) as u8;
				else -> c as u8;
			};
		}

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	// Converts '/' to '\\' for Windows tools (cmd, del, etc.)
	pub fn to_win_path(val self): str {
		val buf = raw_alloc(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			buf[i] = if (c == '/') '\\' as u8 else c as u8;
		}

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	// Converts '\\' to '/' for cross-platform and POSIX path representations
	pub fn to_posix_path(val self): str {
		val buf = raw_alloc(self.len + 1);
		for (i in 0..<self.len) {
			val c = self[i];
			buf[i] = if (c == '\\') '/' as u8 else c as u8;
		}

		buf[self.len] = 0;
		return str_from_bytes(buf, self.len);
	}

	pub fn in_list(val self, list: List<str>): bool {
		for (item in list) {
			if (item == self) return true;
		}
		return false;
	}

	pub fn index_in_list(val self, list: List<str>): isz {
		for (i in 0..<list.len) {
			if (list[i] == self) return i as isz;
		}
		return -1;
	}

	pub fn trim(val self): str {
		if (self.empty()) return self;
		var start: usz = 0;
		while (start < self.len) {
			val c = self[start];
			if (c == ' ' || c == '\t' || c == '\r' || c == '\n') start++;
			else break;
		}
		if (start == self.len) return "";
		var end: usz = self.len;
		while (end > start) {
			val c = self[end - 1];
			if (c == ' ' || c == '\t' || c == '\r' || c == '\n') end--;
			else break;
		}
		return self.slice(start, end);
	}

	pub fn split_lines(val self): List<str> {
		var res = List<str>();
		var start: usz = 0UZ;
		var i: usz = 0UZ;
		while (i < self.len) {
			val c = self[i];
			if (c == '\n') {
				var line_end = i;
				if (line_end > start && self[line_end - 1UZ] == '\r') {
					line_end = line_end - 1UZ;
				}
				res.add(self.slice(start, line_end));
				start = i + 1UZ;
			}
			i++;
		}
		if (start <= self.len) {
			var line_end = self.len;
			if (line_end > start && self[line_end - 1UZ] == '\r') {
				line_end = line_end - 1UZ;
			}
			res.add(self.slice(start, line_end));
		}
		return res;
	}

	pub fn hash_stamp(val self): str {
		var h: u64 = 5381UL;
		for (c in self) {
			h = ((h * 33UL) + (c as u64)) % 1000000007UL;
		}
		return "${h}_${self.len}";
	}
}

pub fn str_join_dots(parts: List<str>, count: usz): str {
	var total = 0UZ;
	for (i in 0..<count) total += parts[i].len;
	if (count > 1) total += (count - 1);

	val buf = raw_alloc(total + 1);
	var w = 0UZ;
	for (i in 0..<count) {
		val p = parts[i];
		for (c in p) {
			buf[w] = c as u8;
			w++;
		}
		if (i + 1 < count) {
			buf[w] = '.' as u8;
			w++;
		}
	}

	buf[w] = 0;
	return str_from_bytes(buf, w);
}
