// ============================================================================
// Node Allocator Helpers
// ============================================================================

pub fn alloc_node(
	var arena: &Arena,
	kind: NodeKind,
	line: usz,
	col: usz,
	data: *u8
): *AstNode {
	val mem = arena.alloc_bytes(AstNode.size(), 8UZ);
	val ptr = mem as *AstNode;
	*ptr = AstNode(kind, line, col, data);
	return ptr;
}

// ----------------------------------------------------------------------------
// Type Allocators
// ----------------------------------------------------------------------------

pub fn alloc_named_type(
	var arena: &Arena,
	name: str,
	type_args: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(NamedType.size(), 8UZ);
	val ptr = mem as *NamedType;
	*ptr = NamedType(name, type_args);
	return alloc_node(arena, NodeKind.TYPE_NAMED, line, col, mem);
}

pub fn alloc_pointer_type(
	var arena: &Arena,
	is_mut: bool,
	pointee: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(PointerType.size(), 8UZ);
	val ptr = mem as *PointerType;
	*ptr = PointerType(is_mut, pointee);
	return alloc_node(arena, NodeKind.TYPE_POINTER, line, col, mem);
}

pub fn alloc_array_type(
	var arena: &Arena,
	elem: *AstNode,
	size: usz,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(ArrayType.size(), 8UZ);
	val ptr = mem as *ArrayType;
	*ptr = ArrayType(elem, size);
	return alloc_node(arena, NodeKind.TYPE_ARRAY, line, col, mem);
}

// ----------------------------------------------------------------------------
// Expression Allocators
// ----------------------------------------------------------------------------

pub fn alloc_literal(
	var arena: &Arena,
	lk: LiteralKind,
	raw: str,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(LiteralExpr.size(), 8UZ);
	val ptr = mem as *LiteralExpr;
	*ptr = LiteralExpr(lk, raw);
	return alloc_node(arena, NodeKind.EXPR_LITERAL, line, col, mem);
}

pub fn alloc_identifier(
	var arena: &Arena,
	name: str,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(IdentifierExpr.size(), 8UZ);
	val ptr = mem as *IdentifierExpr;
	*ptr = IdentifierExpr(name);
	return alloc_node(arena, NodeKind.EXPR_IDENTIFIER, line, col, mem);
}

pub fn alloc_binary(
	var arena: &Arena,
	op: TokenType,
	left: *AstNode,
	right: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(BinaryExpr.size(), 8UZ);
	val ptr = mem as *BinaryExpr;
	*ptr = BinaryExpr(left, op, right);
	return alloc_node(arena, NodeKind.EXPR_BINARY, line, col, mem);
}

pub fn alloc_unary(
	var arena: &Arena,
	op: TokenType,
	operand: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(UnaryExpr.size(), 8UZ);
	val ptr = mem as *UnaryExpr;
	*ptr = UnaryExpr(op, operand);
	return alloc_node(arena, NodeKind.EXPR_UNARY, line, col, mem);
}

pub fn alloc_call(
	var arena: &Arena,
	callee: *AstNode,
	args: List<*AstNode>,
	type_args: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(CallExpr.size(), 8UZ);
	val ptr = mem as *CallExpr;
	*ptr = CallExpr(callee, args, type_args);
	return alloc_node(arena, NodeKind.EXPR_CALL, line, col, mem);
}

