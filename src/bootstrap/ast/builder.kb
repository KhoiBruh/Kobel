	statements: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(BlockStmt.size(), 8UZ);
	val ptr = mem as *BlockStmt;
	*ptr = BlockStmt(statements);
	return alloc_node(arena, NodeKind.STMT_BLOCK, line, col, mem);
}

pub fn alloc_expr_stmt(
	var arena: &Arena,
	expr: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(ExprStmt.size(), 8UZ);
	val ptr = mem as *ExprStmt;
	*ptr = ExprStmt(expr);
	return alloc_node(arena, NodeKind.STMT_EXPR, line, col, mem);
}

pub fn alloc_var_decl(
	var arena: &Arena,
	is_mut: bool,
	name: str,
	type_annotation: *AstNode,
	initializer: *AstNode,
