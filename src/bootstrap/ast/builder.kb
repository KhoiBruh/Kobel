	val mem = arena.alloc_bytes(CastExpr.size(), 8UZ);
	val ptr = mem as *CastExpr;
	*ptr = CastExpr(expr, target_type);
	return alloc_node(arena, NodeKind.EXPR_CAST, line, col, mem);
