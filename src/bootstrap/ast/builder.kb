	var arena: &Arena,
	expr: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(GroupExpr.size(), 8UZ);
	val ptr = mem as *GroupExpr;
	*ptr = GroupExpr(expr);
	return alloc_node(arena, NodeKind.EXPR_GROUP, line, col, mem);
