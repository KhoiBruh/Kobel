	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(VarDeclStmt.size(), 8UZ);
	val ptr = mem as *VarDeclStmt;
	*ptr = VarDeclStmt(is_mut, name, type_annotation, initializer);
	return alloc_node(arena, NodeKind.STMT_VAR_DECL, line, col, mem);
}

pub fn alloc_if_stmt(
	var arena: &Arena,
	condition: *AstNode,
	then_branch: *AstNode,
	else_branch: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(IfStmt.size(), 8UZ);
	val ptr = mem as *IfStmt;
	*ptr = IfStmt(condition, then_branch, else_branch);
	return alloc_node(arena, NodeKind.STMT_IF, line, col, mem);
}

pub fn alloc_while_stmt(
	var arena: &Arena,
	condition: *AstNode,
	body: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val mem = arena.alloc_bytes(WhileStmt.size(), 8UZ);
	val ptr = mem as *WhileStmt;
	*ptr = WhileStmt(condition, body);
	return alloc_node(arena, NodeKind.STMT_WHILE, line, col, mem);
}

pub fn alloc_return_stmt(
	var arena: &Arena,
