mod bootstrap.lexer.token;

pub enum TokenType {
	// Single syntax
	SEMI_COLON,    // ;
	COLON,         // :
	COMMA,         // ,
	DOT,           // .
	BANG,          // !
	EQUAL,         // =
	PLUS,          // +
	MINUS,         // -
	STAR,          // *
	SLASH,         // /
	PERCENT,       // %
	GREATER,       // >
	LESS,          // <
	OPEN_BRACKET,  // [
	CLOSE_BRACKET, // ]
	OPEN_PAREN,    // (
	CLOSE_PAREN,   // )
	OPEN_BRACE,    // {
	CLOSE_BRACE,   // }
	AMPERSAND,     // &

	// Double syntax
	EQUAL_EQUAL,   // ==
	BANG_EQUAL,    // !=
	LESS_EQUAL,    // <=
	GREATER_EQUAL, // >=
	AND_AND,       // &&
	OR_OR,         // ||
	FAT_ARROW,     // =>
	ARROW,         // ->

	// Literals
	CHAR,
	NUMBER,
	STRING,
	IDENTIFIER,

	// Keywords
	KW_EXTERN,
	KW_STRUCT,
	KW_ENUM,
	KW_FN,
	KW_RETURN,
	KW_CONST,
	KW_NULL,
	KW_TRUE,
	KW_FALSE,
	KW_VAL,
	KW_VAR,
	KW_AS,
	KW_WHILE,
	KW_BREAK,
	KW_CONTINUE,
	KW_IF,
	KW_ELSE,
	KW_WHEN,
	KW_MOD,
	KW_USE,
	KW_PUB,
	KW_TRAIT,
	KW_IMPL,
	KW_FOR,

	// Specials
	END_OF_FILE,
	UNKNOWN
}

pub struct Token {
	pub type: TokenType,
	pub text: str,
	pub line: usz,
	pub col: usz
}

pub fn token_type_name(t: TokenType): str => when (t) {
	TokenType.SEMI_COLON -> "SEMI_COLON",
	TokenType.COLON -> "COLON",
	TokenType.COMMA -> "COMMA",
	TokenType.DOT -> "DOT",
	TokenType.BANG -> "BANG",
	TokenType.EQUAL -> "EQUAL",
	TokenType.PLUS -> "PLUS",
	TokenType.MINUS -> "MINUS",
	TokenType.STAR -> "STAR",
	TokenType.SLASH -> "SLASH",
	TokenType.PERCENT -> "PERCENT",
	TokenType.GREATER -> "GREATER",
	TokenType.LESS -> "LESS",
	TokenType.OPEN_BRACKET -> "OPEN_BRACKET",
	TokenType.CLOSE_BRACKET -> "CLOSE_BRACKET",
	TokenType.OPEN_PAREN -> "OPEN_PAREN",
	TokenType.CLOSE_PAREN -> "CLOSE_PAREN",
	TokenType.OPEN_BRACE -> "OPEN_BRACE",
	TokenType.CLOSE_BRACE -> "CLOSE_BRACE",
	TokenType.AMPERSAND -> "AMPERSAND",

	TokenType.EQUAL_EQUAL -> "EQUAL_EQUAL",
	TokenType.BANG_EQUAL -> "BANG_EQUAL",
	TokenType.LESS_EQUAL -> "LESS_EQUAL",
	TokenType.GREATER_EQUAL -> "GREATER_EQUAL",
	TokenType.AND_AND -> "AND_AND",
	TokenType.OR_OR -> "OR_OR",
	TokenType.FAT_ARROW -> "FAT_ARROW",
	TokenType.ARROW -> "ARROW",

	TokenType.CHAR -> "CHAR",
	TokenType.NUMBER -> "NUMBER",
	TokenType.STRING -> "STRING",
	TokenType.IDENTIFIER -> "IDENTIFIER",

	TokenType.KW_EXTERN -> "KW_EXTERN",
	TokenType.KW_STRUCT -> "KW_STRUCT",
	TokenType.KW_ENUM -> "KW_ENUM",
	TokenType.KW_FN -> "KW_FN",
	TokenType.KW_RETURN -> "KW_RETURN",
	TokenType.KW_CONST -> "KW_CONST",
	TokenType.KW_NULL -> "KW_NULL",
	TokenType.KW_TRUE -> "KW_TRUE",
	TokenType.KW_FALSE -> "KW_FALSE",
	TokenType.KW_VAL -> "KW_VAL",
	TokenType.KW_VAR -> "KW_VAR",
	TokenType.KW_AS -> "KW_AS",
	TokenType.KW_WHILE -> "KW_WHILE",
	TokenType.KW_BREAK -> "KW_BREAK",
	TokenType.KW_CONTINUE -> "KW_CONTINUE",
	TokenType.KW_IF -> "KW_IF",
	TokenType.KW_ELSE -> "KW_ELSE",
	TokenType.KW_WHEN -> "KW_WHEN",
	TokenType.KW_MOD -> "KW_MOD",
	TokenType.KW_USE -> "KW_USE",
	TokenType.KW_PUB -> "KW_PUB",
	TokenType.KW_TRAIT -> "KW_TRAIT",
	TokenType.KW_IMPL -> "KW_IMPL",
	TokenType.KW_FOR -> "KW_FOR",

	TokenType.END_OF_FILE -> "END_OF_FILE",
	else -> "UNKNOWN"
};

extern "libc" {
	fn malloc(size: usz): &u8;
	fn free(ptr: &u8): void;
}

struct StringRaw {
	pub data: *char,
	pub len: usz,
	pub cap: usz
}

pub fn usz_to_str(n: usz): str {
	if (n == 0UZ) return "0";
	val buf = malloc(32UZ);
	var tmp = n;
	var len: usz = 0UZ;
	while (tmp > 0UZ) {
		len = len + 1UZ;
		tmp = tmp / 10UZ;
	}
	buf[len] = 0UB;
	var i = len;
	tmp = n;
	while (tmp > 0UZ) {
		i = i - 1UZ;
		val digit = (tmp % 10UZ) as u8;
		buf[i] = (48UB + digit) as u8;
		tmp = tmp / 10UZ;
	}
	val raw_mem = malloc(24UZ);
	val r = raw_mem as &StringRaw;
	r.data = buf as *char;
	r.len = len;
	r.cap = 32UZ;
	val sp: *str = r as *str;
	val res: str = *sp;
	free(raw_mem);
	return res;
}

pub fn format_loc(line: usz, col: usz): str {
	return "Line " + usz_to_str(line) + ", Column " + usz_to_str(col) + ": ";
}

pub fn strip_suffix(s: str, n: usz): str {
	if (s.len <= n) return "";
	val new_len = s.len - n;
	val buf = malloc(new_len + 1UZ);
	var i: usz = 0UZ;
	while (i < new_len) {
		buf[i] = s[i] as u8;
		i = i + 1UZ;
	}
	buf[new_len] = 0UB;
	val raw_mem = malloc(24UZ);
	val r = raw_mem as &StringRaw;
	r.data = buf as *char;
	r.len = new_len;
	r.cap = new_len + 1UZ;
	val sp: *str = r as *str;
	val res: str = *sp;
	free(raw_mem);
	return res;
}