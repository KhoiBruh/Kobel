mod fmt.options;

// ============================================================================
// Formatting Options
// ============================================================================

pub struct FormatOptions {
	pub tab_size: usz,
	pub use_smart_tabs: bool,
	pub max_width: usz,
	pub k_and_r_braces: bool
}

impl FormatOptions {
	pub fn new() => Self(4, true, 100, true);
}
