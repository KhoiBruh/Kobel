mod fmt.formatter;

use std.collections.list.*;

use fmt.options.*;
use fmt.buffer.*;
use fmt.comments.*;

use compiler.ast.node.*;
use compiler.ast.decl.*;
use compiler.ast.stmt.*;
use compiler.ast.expr.*;
use compiler.ast.types.*;
use compiler.lexer.token.*;
use compiler.lexer.lexer.*;
use compiler.parser.parser.*;
use compiler.parser.decl.*;

// ============================================================================
// Operator token to string representation
// ============================================================================

pub fn op_to_str(op: TokenType): str => when (op) {
	TokenType.PLUS -> "+";
	TokenType.MINUS -> "-";
	TokenType.STAR -> "*";
	TokenType.SLASH -> "/";
	TokenType.PERCENT -> "%";
	TokenType.EQUAL_EQUAL -> "==";
	TokenType.BANG_EQUAL -> "!=";
	TokenType.LESS -> "<";
	TokenType.LESS_EQUAL -> "<=";
	TokenType.GREATER -> ">";
	TokenType.GREATER_EQUAL -> ">=";
	TokenType.AND_AND -> "&&";
	TokenType.OR_OR -> "||";
	TokenType.EQUAL -> "=";
	TokenType.PLUS_EQUAL -> "+=";
	TokenType.MINUS_EQUAL -> "-=";
	TokenType.STAR_EQUAL -> "*=";
	TokenType.SLASH_EQUAL -> "/=";
	TokenType.PERCENT_EQUAL -> "%=";
	TokenType.QUESTION_COLON -> "?:";
	TokenType.QUESTION_DOT -> "?.";
	TokenType.DOT_DOT -> "..";
	TokenType.BANG -> "!";
	TokenType.PLUS_PLUS -> "++";
	TokenType.MINUS_MINUS -> "--";
	TokenType.AMPERSAND -> "&";
	TokenType.QUESTION -> "?";
	else -> "";
};

// ============================================================================
// Formatter Implementation
// ============================================================================

pub struct Formatter {
	pub buf: FormatBuffer,
	pub comments: CommentTable,
	pub options: FormatOptions
}

impl Formatter {

	pub fn new(options: FormatOptions, comments: CommentTable) => Self(
		FormatBuffer(options), comments, options
	);

	pub fn to_str(val self) => self.buf.to_str();

	// ------------------------------------------------------------------------
	// Types
	// ------------------------------------------------------------------------

	pub fn format_type(var self, node: *AstNode) {
		if (node == null) return;
		when (node) {
			is NamedType as nt -> {
				self.buf += nt.name;
				if (nt.type_args.len > 0) {
					self.buf += "<";
					for (i in 0..<nt.type_args.len) {
						if (i > 0) self.buf += ", ";
						self.format_type(nt.type_args[i]);
					}
					self.buf += ">";
				}
			}
			is PointerType as pt -> {
				if (pt.is_mut) self.buf += "&";
				else self.buf += "*";
				self.format_type(pt.pointee);
			}
			is ArrayType as at -> {
				self.buf += "[";
				self.format_type(at.element_type);
				self.buf += "; ";
				self.buf += "${at.size}";
				self.buf += "]";
			}
			is NullableType as nt -> {
				self.format_type(nt.inner);
				self.buf += "?";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Expressions
	// ------------------------------------------------------------------------

	pub fn format_expr(var self, node: *AstNode) {
		if (node == null) return;
		when (node) {
			is LiteralExpr as lit -> self.buf += lit.raw_text;
			is IdentifierExpr as id -> self.buf += id.name;
			is BinaryExpr as b -> {
				self.format_expr(b.left);
				self.buf.space();
				self.buf += op_to_str(b.op);
				self.buf.space();
				self.format_expr(b.right);
			}
			is UnaryExpr as u -> {
				self.buf += op_to_str(u.op);
				self.format_expr(u.operand);
			}
			is CallExpr as c -> {
				self.format_expr(c.callee);
				if (c.type_args.len > 0) {
					self.buf += "<";
					for (i in 0..<c.type_args.len) {
						if (i > 0) self.buf += ", ";
						self.format_type(c.type_args[i]);
					}
					self.buf += ">";
				}
				self.buf += "(";
				for (j in 0..<c.args.len) {
					if (j > 0) self.buf += ", ";
					self.format_expr(c.args[j]);
				}
				self.buf += ")";
			}
			is MemberExpr as m -> {
				self.format_expr(m.object);
				if (m.is_safe) self.buf += "?.";
				else self.buf += ".";
				self.buf += m.member;
			}
			is IndexExpr as idx -> {
				self.format_expr(idx.target);
				self.buf += "[";
				self.format_expr(idx.index);
				self.buf += "]";
			}
			is AssignExpr as a -> {
				self.format_expr(a.target);
				self.buf.space();
				self.buf += op_to_str(a.op);
				self.buf.space();
				self.format_expr(a.value);
			}
			is UpdateExpr as u -> {
				self.format_expr(u.target);
				self.buf += op_to_str(u.op);
			}
			is CastExpr as cst -> {
				self.format_expr(cst.expr);
				self.buf += " as ";
				self.format_type(cst.target_type);
			}
			is GroupExpr as g -> {
				self.buf += "(";
				self.format_expr(g.expr);
				self.buf += ")";
			}
			is ArrayLiteralExpr as al -> {
				self.buf += "[";
				for (i in 0..<al.elements.len) {
					if (i > 0) self.buf += ", ";
					self.format_expr(al.elements[i]);
				}
				self.buf += "]";
			}
			is IfExpr as ie -> {
				self.buf += "if (";
				self.format_expr(ie.condition);
				self.buf += ") ";
				self.format_expr(ie.then_branch);
				if (ie.else_branch != null) {
					self.buf += " else ";
					self.format_expr(ie.else_branch);
				}
			}
			is WhenExpr as we -> {
				self.buf += "when (";
				self.format_expr(we.condition);
				self.buf += ") {";
				self.buf.indent();
				for (i in 0..<we.arms.len) {
					self.buf.newline();
					val arm = we.arms[i];
					if (arm.is_else) {
						self.buf += "else -> ";
					} else {
						for (p in 0..<arm.patterns.len) {
							if (p > 0) self.buf += ", ";
							self.format_expr(arm.patterns[p]);
						}
						self.buf += " -> ";
					}
					if (arm.body is BlockStmt) {
						self.format_stmt(arm.body);
					} else {
						self.format_expr(arm.body);
						self.buf += ";";
					}
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
			is InterpExpr as interp -> {
				self.buf += "\"";
				for (part in interp.parts) {
					val expr = part.expr;
					if (expr is LiteralExpr as lit) {
						val text = lit.raw_text;
						// Strip enclosing quotes from string literal
						if (text.len >= 2) {
							self.buf += text.slice(1, text.len - 1);
						}
					} else {
						self.buf += '$';
						self.buf += '{';
						self.format_expr(expr);
						self.buf += "}";
					}
				}
				self.buf += "\"";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Statements
	// ------------------------------------------------------------------------

	pub fn format_stmt(var self, node: *AstNode) {
		if (node == null) return;
		self.comments.emit_before(&self.buf, node.line);

		when (node) {
			is BlockStmt as b -> {
				self.buf += "{";
				self.buf.indent();
				for (s in b.statements) {
					self.buf.newline();
					self.format_stmt(s);
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
			is ExprStmt as es -> {
				self.format_expr(es.expr);
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is VarDeclStmt as v -> {
				if (v.is_mut) self.buf += "var ";
				else self.buf += "val ";
				self.buf += v.name;
				if (v.type_annotation != null) {
					self.buf += ": ";
					self.format_type(v.type_annotation);
				}
				if (v.initializer != null) {
					self.buf += " = ";
					self.format_expr(v.initializer);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is IfStmt as s -> {
				self.buf += "if (";
				self.format_expr(s.condition);
				self.buf += ") ";

				if (s.then_branch.kind == NodeKind.STMT_BLOCK) {
					self.format_stmt(s.then_branch);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(s.then_branch);
					self.buf.dedent();
				}

				if (s.else_branch != null) {
					if (s.then_branch.kind == NodeKind.STMT_BLOCK) {
						self.buf += " else ";
					} else {
						self.buf.newline();
						self.buf += "else ";
					}

					if (
						s.else_branch.kind == NodeKind.STMT_IF ||
						s.else_branch.kind == NodeKind.STMT_BLOCK
					) self.format_stmt(s.else_branch);
					else {
						self.buf.indent();
						self.buf.newline();
						self.format_stmt(s.else_branch);
						self.buf.dedent();
					}
				}
			}
			is WhileStmt as w -> {
				self.buf += "while (";
				self.format_expr(w.condition);
				self.buf += ") ";
				if (w.body.kind == NodeKind.STMT_BLOCK) {
					self.format_stmt(w.body);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(w.body);
					self.buf.dedent();
				}
			}
			is ForStmt as f -> {
				self.buf += "for (";
				self.buf += f.var_name;
				self.buf += " in ";
				if (f.is_range) {
					self.format_expr(f.range_start);
					if (f.is_open) self.buf += ">..<";
					else if (f.is_half_open) self.buf += "..<";
					else self.buf += "..";
					self.format_expr(f.range_end);
				} else {
					self.format_expr(f.iterable);
				}

				self.buf += ") ";
				if (f.body.kind == NodeKind.STMT_BLOCK) {
					self.format_stmt(f.body);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(f.body);
					self.buf.dedent();
				}
			}
			is ReturnStmt as r -> {
				self.buf += "return";
				if (r.value != null) {
					self.buf.space();
					self.format_expr(r.value);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is YieldStmt as y -> {
				self.buf += "yield";
				if (y.value != null) {
					self.buf.space();
					self.format_expr(y.value);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is BreakStmt as b -> {
				self.buf += "break;";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ContinueStmt as c -> {
				self.buf += "continue;";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is DeferStmt as d -> {
				self.buf += "defer ";
				self.format_stmt(d.body);
			}
			is WhenStmt as ws -> {
				self.buf += "when (";
				self.format_expr(ws.condition);
				self.buf += ") {";
				self.buf.indent();
				for (arm in ws.arms) {
					self.buf.newline();
					if (arm.is_else) self.buf += "else -> ";
					else {
						for (p in 0..<arm.patterns.len) {
							if (p > 0) self.buf += ", ";
							self.format_expr(arm.patterns[p]);
						}
						self.buf += " -> ";
					}
					self.format_stmt(arm.body);
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Generic type parameters
	// ------------------------------------------------------------------------

	pub fn format_type_params(var self, type_params: List<GenericParam>) {
		if (type_params.len == 0) return;
		self.buf += "<";
		for (i in 0..<type_params.len) {
			if (i > 0) self.buf += ", ";
			val tp = type_params[i];
			self.buf += tp.name;
			if (tp.bounds.len > 0) {
				self.buf += ": ";
				for (b in 0..<tp.bounds.len) {
					if (b > 0) self.buf += " + ";
					self.buf += tp.bounds[b];
				}
			}
		}
		self.buf += ">";
	}

	// ------------------------------------------------------------------------
	// Declarations
	// ------------------------------------------------------------------------

	pub fn format_decl(var self, node: *AstNode) {
		if (node == null) return;
		self.comments.emit_before(&self.buf, node.line);

		when (node) {
			is ModuleDecl as m -> {
				self.buf += "mod ";
				self.buf += m.full_path;
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
				self.buf.newline();
			}
			is UseDecl as u -> {
				self.buf += "use ";
				self.buf += u.full_path;
				if (u.alias.len > 0) {
					self.buf += " as ";
					self.buf += u.alias;
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is StructDecl as s -> {
				if (s.is_pub) self.buf += "pub ";
				self.buf += "struct ";
				self.buf += s.name;
				self.format_type_params(s.type_params);
				self.buf += " {";

				if (s.fields.len > 0) {
					self.buf.indent();
					for (i in 0..<s.fields.len) {
						self.buf.newline();
						val f = s.fields[i];
						if (f.is_pub) self.buf += "pub ";
						self.buf += f.name;
						self.buf += ": ";
						self.format_type(f.type_node);
						if (f.default_val != null) {
							self.buf += " = ";
							self.format_expr(f.default_val);
						}
						if (i + 1 < s.fields.len) self.buf += ",";
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is FnDecl as f -> {
				if (f.is_pub) self.buf += "pub ";
				if (f.is_op) self.buf += "op ";
				else self.buf += "fn ";
				self.buf += f.name;
				self.format_type_params(f.type_params);
				self.buf += "(";

				for (i in 0..<f.params.len) {
					if (i > 0) self.buf += ", ";
					val p = f.params[i];
					if (p.is_mut) self.buf += "var ";
					else if (p.has_val) self.buf += "val ";
					self.buf += p.name;
					if (p.type_node != null) {
						self.buf += ": ";
						self.format_type(p.type_node);
					}
					if (p.default_val != null) {
						self.buf += " = ";
						self.format_expr(p.default_val);
					}
				}
				self.buf += ")";

				if (f.return_type != null) {
					self.buf += ": ";
					self.format_type(f.return_type);
				}

				if (f.body != null) {
					val body = f.body;
					when (body) {
						is BlockStmt -> {
							self.buf += " ";
							self.format_stmt(f.body);
						}
						is ExprStmt as es -> {
							self.buf += " => ";
							self.format_expr(es.expr);
							self.buf += ";";
						}
						else -> {
							self.buf += " ";
							self.format_stmt(f.body);
						}
					}
				} else self.buf += ";";

				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ImplDecl as im -> {
				self.buf += "impl";
				if (im.type_params.len > 0) {
					self.buf.space();
					self.format_type_params(im.type_params);
				}
				self.buf.space();
				if (im.trait_name.len > 0) {
					self.buf += im.trait_name;
					self.buf += " for ";
				}
				self.buf += im.struct_name;
				self.buf += " {";

				if (im.methods.len > 0) {
					self.buf.indent();
					for (m in im.methods) {
						self.buf.double_newline();
						self.format_decl(m);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is TraitDecl as tr -> {
				if (tr.is_pub) self.buf += "pub ";
				self.buf += "trait ";
				self.buf += tr.name;
				self.format_type_params(tr.type_params);
				if (tr.bases.len > 0) {
					self.buf += " : ";
					for (i in 0..<tr.bases.len) {
						if (i > 0) self.buf += ", ";
						self.buf += tr.bases[i];
					}
				}
				self.buf += " {";

				if (tr.methods.len > 0) {
					self.buf.indent();
					for (m in tr.methods) {
						self.buf.newline();
						self.format_decl(m);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is EnumDecl as en -> {
				if (en.is_pub) self.buf += "pub ";
				self.buf += "enum ";
				self.buf += en.name;
				if (en.underlying_type != null) {
					self.buf += ": ";
					self.format_type(en.underlying_type);
				}
				self.buf += " {";

				if (en.members.len > 0) {
					self.buf.indent();
					for (i in 0..<en.members.len) {
						self.buf.newline();
						val mem = en.members[i];
						self.buf += mem.name;
						if (mem.value != null) {
							self.buf += " = ";
							self.format_expr(mem.value);
						}
						if (i + 1 < en.members.len) self.buf += ",";
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ConstDecl as c -> {
				if (c.is_pub) self.buf += "pub ";
				self.buf += "const ";
				self.buf += c.name;
				if (c.type_node != null) {
					self.buf += ": ";
					self.format_type(c.type_node);
				}
				self.buf += " = ";
				self.format_expr(c.value);
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ExternBlock as eb -> {
				self.buf += "extern \"";
				self.buf += eb.abi;
				self.buf += "\" {";

				if (eb.declarations.len > 0) {
					self.buf.indent();
					for (d in eb.declarations) {
						self.buf.newline();
						self.format_decl(d);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
		}
	}

	// ------------------------------------------------------------------------
	// Program entry
	// ------------------------------------------------------------------------

	pub fn format_program(var self, program: *AstNode) {
		if (program == null) return;
		when (program) {
			is Program as p -> {
				var prev_was_import = false;

				for (i in 0..<p.declarations.len) {
					val decl = p.declarations[i];
					val is_import = (decl is UseDecl);

					if (i > 0) {
						if (prev_was_import && !is_import) self.buf.newline();
						else if (!is_import) self.buf.newline();
					}

					self.format_decl(decl);
					self.buf.newline();
					prev_was_import = is_import;
				}

				self.comments.emit_remaining(&self.buf);
			}
			else -> {}
		}
	}

}

pub fn format_source(src: str, options: FormatOptions): str {
	val comments = extract_comments(src);
	val comment_table = CommentTable(comments);

	val lex = Lexer(src);
	val tokens = lex.tokenize();

	val parser = Parser(tokens);
	val program = parser.parse_program();

	val fmt = Formatter(options, comment_table);
	fmt.format_program(program);

	return fmt.to_str();
}
