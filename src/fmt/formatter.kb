mod fmt;

use std.io.*;
use std.filesystem.*;
use std.collections.*;
use std.string.StringBuilder;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.parser.*;

// ============================================================================
// Operator token to string representation
// ============================================================================

/*
 * Formatting normalizes line endings to `\n`; a CRLF source would otherwise
 * leak `\r` bytes into comments and produce mixed-EOL output.
 */
fn strip_cr(src: str): str {
	if (src.index_of("\r") < 0) return src;

	var sb = StringBuilder();
	for (c in src) if (c != '\r') sb += c;
	return sb.to_str();
}

// A single-line body keeps `if (cond) stmt;` on one line; block-like bodies
// (blocks, nested ifs, when) are always emitted on their own indented line.
fn is_inline_stmt(node: *AstNode?): bool {
	if (node == null) return false;
	val n = node!;
	return when (n) {
		is BlockStmt -> false;
		is IfStmt -> false;
		is WhenStmt -> false;
		else -> true;
	};
}

pub fn op_to_str(op: TokenType) => when (op) {
	TokenType.PLUS -> "+";
	TokenType.MINUS -> "-";
	TokenType.STAR -> "*";
	TokenType.SLASH -> "/";
	TokenType.PERCENT -> "%";
	TokenType.EQUAL_EQUAL -> "==";
	TokenType.BANG_EQUAL -> "!=";
	TokenType.LESS -> "<";
	TokenType.LESS_EQUAL -> "<=";
	TokenType.GREATER -> ">";
	TokenType.GREATER_EQUAL -> ">=";
	TokenType.AND_AND -> "&&";
	TokenType.OR_OR -> "||";
	TokenType.EQUAL -> "=";
	TokenType.PLUS_EQUAL -> "+=";
	TokenType.MINUS_EQUAL -> "-=";
	TokenType.STAR_EQUAL -> "*=";
	TokenType.SLASH_EQUAL -> "/=";
	TokenType.PERCENT_EQUAL -> "%=";
	TokenType.QUESTION_COLON -> "?:";
	TokenType.QUESTION_DOT -> "?.";
	TokenType.DOT_DOT -> "..";
	TokenType.BANG -> "!";
	TokenType.PLUS_PLUS -> "++";
	TokenType.MINUS_MINUS -> "--";
	TokenType.AMPERSAND -> "&";
	TokenType.QUESTION -> "?";
	else -> "";
};

// ============================================================================
// Formatter Implementation
// ============================================================================

pub struct Formatter {
	pub buf: FormatBuffer,
	pub comments: CommentTable,
	pub options: FormatOptions,
	// Original text, used to re-emit string literals verbatim (notably `"""`).
	pub source: str = ""
}

impl Formatter {

	pub init(options: FormatOptions, comments: CommentTable, source: str = "") => Self(
		FormatBuffer(options), comments, options, source
	);

	pub fn to_str(val self) => self.buf.to_str();

	/*
	 * Width bookkeeping: render a fragment into a scratch formatter so a long
	 * argument/parameter list can break before it, without touching the line.
	 */
	fn measure_expr(val self, node: *AstNode): usz {
		var scratch = Formatter(self.options, CommentTable(List<Comment>()), "");
		scratch.format_expr(node);
		return scratch.buf.to_str().len;
	}

	fn measure_param(val self, p: Param): usz {
		var scratch = Formatter(self.options, CommentTable(List<Comment>()), "");
		scratch.format_param(p);
		return scratch.buf.to_str().len;
	}

	pub fn format_param(var self, p: Param) {
		if (p.mutable) self.buf += "var ";
		else if (p.has_val) self.buf += "val ";
		self.buf += p.name;
		if (p.type_node != null) {
			self.buf += ": ";
			self.format_type(p.type_node!);
		}
		if (p.default_val != null) {
			self.buf += " = ";
			self.format_expr(p.default_val!);
		}
	}

	fn source_offset(val self, line: usz, col: usz): isz {
		var cur: usz = 1;
		var i: usz = 0;
		while (cur < line && i < self.source.len) {
			if (self.source[i] == '\n') cur++;
			i++;
		}
		if (cur != line) return -1;
		return (i + col - 1) as isz;
	}

	// A `"""` literal is re-emitted exactly as written; its indentation is part
	// of the language semantics, so reconstructing it is not safe.
	fn original_string(val self, node: *AstNode): str {
		if (self.source.empty() || node.span.length == 0 || node.span.line == 0) return "";
		val off = self.source_offset(node.span.line, node.span.col);
		if (off < 0) return "";
		val start = off as usz;
		val end = start + node.span.length;
		if (end > self.source.len) return "";
		val text = self.source.slice(start, end);
		if (text.starts_with("\"\"\"") && text.ends_with("\"\"\"")) return text;
		return "";
	}

	// ------------------------------------------------------------------------
	// Types
	// ------------------------------------------------------------------------

	pub fn format_type(var self, node: *AstNode) {
		if (node == null) return;

		when (node) {
			is NamedType as nt -> {
				self.buf += nt.name;
				if (nt.type_args.len > 0) {
					self.buf += "<";
					for (i in 0..<nt.type_args.len) {
						if (i > 0) self.buf += ", ";
						self.format_type(nt.type_args[i]);
					}
					self.buf += ">";
				}
			}
			is PointerType as pt -> {
				if (pt.mutable) self.buf += "&";
				else self.buf += "*";
				self.format_type(pt.pointee);
			}
			is ArrayType as at -> {
				self.buf += "[";
				self.format_type(at.element_type);
				self.buf += "; ";
				self.buf += "${at.size}";
				self.buf += "]";
			}
			is NullableType as nt -> {
				self.format_type(nt.inner_type);
				self.buf += "?";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Expressions
	// ------------------------------------------------------------------------

	pub fn format_expr(var self, node: *AstNode) {
		if (node == null) return;

		when (node) {
			is LiteralExpr as lit -> {
				val preserved = if (lit.literal_kind == Literal.STRING) self.original_string(node) else "";
				if (!preserved.empty()) self.buf += preserved;
				else self.buf += lit.raw_text;
			}
			is IdentifierExpr as id -> self.buf += id.name;
			is BinaryExpr as b -> {
				self.format_expr(b.left);
				self.buf.space();
				self.buf += op_to_str(b.op);
				self.buf.space();
				self.format_expr(b.right);
			}
			is UnaryExpr as u -> {
				if (u.is_postfix) {
					self.format_expr(u.operand);
					self.buf += op_to_str(u.op);
				} else {
					self.buf += op_to_str(u.op);
					self.format_expr(u.operand);
				}
			}
			is CallExpr as c -> {
				self.format_expr(c.callee);
				if (c.type_args.len > 0) {
					self.buf += "<";
					for (i in 0..<c.type_args.len) {
						if (i > 0) self.buf += ", ";
						self.format_type(c.type_args[i]);
					}
					self.buf += ">";
				}
				self.buf += "(";
				var call_broke = false;
				for (j in 0..<c.args.len) {
					if (j > 0) {
						val need = 2 + self.measure_expr(c.args[j]);
						if (self.buf.current_col + need > self.options.max_width) {
							self.buf += ",";
							self.buf.newline();
							if (!call_broke) {
								self.buf.indent();
								call_broke = true;
							}
						} else self.buf += ", ";
					}
					self.format_expr(c.args[j]);
				}
				if (call_broke) self.buf.dedent();
				self.buf += ")";
			}
			is MemberExpr as m -> {
				self.format_expr(m.object);
				if (m.is_safe) self.buf += "?.";
				else self.buf += ".";
				self.buf += m.member;
			}
			is IndexExpr as idx -> {
				self.format_expr(idx.target);
				self.buf += "[";
				self.format_expr(idx.index);
				self.buf += "]";
			}
			is AssignExpr as a -> {
				self.format_expr(a.target);
				self.buf.space();
				self.buf += op_to_str(a.op);
				self.buf.space();
				self.format_expr(a.value);
			}
			is UpdateExpr as u -> {
				self.format_expr(u.target);
				self.buf += op_to_str(u.op);
			}
			is CastExpr as cst -> {
				if (cst.expr != null) self.format_expr(cst.expr!);
				self.buf += " as ";
				self.format_type(cst.target_type);
			}
			is GroupExpr as g -> {
				self.buf += "(";
				self.format_expr(g.expr);
				self.buf += ")";
			}
			is ArrayLiteralExpr as al -> {
				self.buf += "[";
				for (i in 0..<al.elements.len) {
					if (i > 0) self.buf += ", ";
					self.format_expr(al.elements[i]);
				}
				self.buf += "]";
			}
			is IfExpr as ie -> {
				self.buf += "if (";
				self.format_expr(ie.condition);
				self.buf += ") ";
				self.format_expr(ie.then_branch);
				if (ie.else_branch != null) {
					self.buf += " else ";
					self.format_expr(ie.else_branch);
				}
			}
			is WhenExpr as we -> {
				if (we.condition != null) {
					self.buf += "when (";
					self.format_expr(we.condition!);
					self.buf += ") {";
				} else {
					self.buf += "when {";
				}
				self.buf.indent();
				for (i in 0..<we.arms.len) {
					self.buf.newline();
					val arm = we.arms[i];
					if (arm.is_else) {
						self.buf += "else -> ";
					} else {
						for (p in 0..<arm.patterns.len) {
							if (p > 0) self.buf += ", ";
							self.format_expr(arm.patterns[p]);
						}
						self.buf += " -> ";
					}
					if (arm.body is BlockStmt) {
						self.format_stmt(arm.body);
					} else {
						self.format_expr(arm.body);
						self.buf += ";";
					}
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
			is InterpExpr as interp -> {
				self.buf += "\"";
				for (part in interp.parts) {
					when (part) {
						is InterpPart.Literal as lit -> {
							val expr = lit.node;
							if (expr is LiteralExpr as l) {
								val text = l.raw_text;
								if (text.len >= 2) {
									self.buf += text.slice(1, text.len - 1);
								}
							}
						}
						is InterpPart.Hole as hole -> {
							self.buf += '$';
						self.buf += '{';
						self.format_expr(hole.node);
						self.buf += "}";
					}
				}
				}
				self.buf += "\"";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Statements
	// ------------------------------------------------------------------------

	pub fn format_stmt(var self, node: *AstNode) {
		if (node == null) return;
		self.comments.emit_before(&self.buf, node.line);

		when (node) {
			is BlockStmt as b -> {
				self.buf += "{";
				self.buf.indent();
				for (s in b.statements) {
					self.buf.newline();
					self.format_stmt(s);
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
			is ExprStmt as es -> {
				self.format_expr(es.expr);
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is VarDeclStmt as v -> {
				if (v.mutable) self.buf += "var ";
				else self.buf += "val ";
				self.buf += v.name;
				if (v.type_annotation != null) {
					self.buf += ": ";
					self.format_type(v.type_annotation!);
				}
				if (v.initializer != null) {
					self.buf += " = ";
					self.format_expr(v.initializer!);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is IfStmt as s -> {
				self.buf += "if (";
				self.format_expr(s.condition);
				self.buf += ") ";

				val inline_then = s.then_branch is BlockStmt || is_inline_stmt(s.then_branch);
				if (inline_then) {
					self.format_stmt(s.then_branch);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(s.then_branch);
					self.buf.dedent();
				}

				if (s.else_branch != null) {
					val else_node = s.else_branch!;
					if (inline_then) self.buf += " else ";
					else {
						self.buf.newline();
						self.buf += "else ";
					}

					val inline_else = else_node is IfStmt
						|| else_node is BlockStmt
						|| is_inline_stmt(else_node);
					if (inline_else) {
						self.format_stmt(else_node);
					} else {
						self.buf.indent();
						self.buf.newline();
						self.format_stmt(else_node);
						self.buf.dedent();
					}
				}
			}
			is WhileStmt as w -> {
				self.buf += "while (";
				self.format_expr(w.condition);
				self.buf += ") ";
				if (w.body is BlockStmt || is_inline_stmt(w.body)) {
					self.format_stmt(w.body);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(w.body);
					self.buf.dedent();
				}
			}
			is ForStmt as f -> {
				self.buf += "for (";
				self.buf += f.var_name;
				self.buf += " in ";
				if (f.is_range) {
					self.format_expr(f.range_start!);
					if (f.is_open) self.buf += ">..<";
					else if (f.is_half_open) self.buf += "..<";
					else self.buf += "..";
					self.format_expr(f.range_end!);
				} else {
					self.format_expr(f.iterable!);
				}

				self.buf += ") ";
				if (f.body is BlockStmt || is_inline_stmt(f.body)) {
					self.format_stmt(f.body);
				} else {
					self.buf.indent();
					self.buf.newline();
					self.format_stmt(f.body);
					self.buf.dedent();
				}
			}
			is ReturnStmt as r -> {
				self.buf += "return";
				if (r.value != null) {
					self.buf.space();
					self.format_expr(r.value!);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is YieldStmt as y -> {
				self.buf += "yield";
				if (y.value != null) {
					self.buf.space();
					self.format_expr(y.value!);
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is BreakStmt as b -> {
				self.buf += "break;";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ContinueStmt as c -> {
				self.buf += "continue;";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is DeferStmt as d -> {
				self.buf += "defer ";
				self.format_stmt(d.body);
			}
			is WhenStmt as ws -> {
				if (ws.condition != null) {
					self.buf += "when (";
					self.format_expr(ws.condition!);
					self.buf += ") {";
				} else {
					self.buf += "when {";
				}
				self.buf.indent();
				for (arm in ws.arms) {
					self.buf.newline();
					if (arm.is_else) self.buf += "else -> ";
					else {
						for (p in 0..<arm.patterns.len) {
							if (p > 0) self.buf += ", ";
							self.format_expr(arm.patterns[p]);
						}
						self.buf += " -> ";
					}
					self.format_stmt(arm.body);
				}
				self.buf.dedent();
				self.buf.newline();
				self.buf += "}";
			}
		}
	}

	// ------------------------------------------------------------------------
	// Generic type parameters
	// ------------------------------------------------------------------------

	pub fn format_type_params(var self, type_params: List<GenericParam>) {
		if (type_params.empty()) return;
		self.buf += "<";
		for (i in 0..<type_params.len) {
			if (i > 0) self.buf += ", ";
			val tp = type_params[i];
			self.buf += tp.name;
			if (tp.bounds.len > 0) {
				self.buf += ": ";
				for (b in 0..<tp.bounds.len) {
					if (b > 0) self.buf += " + ";
					self.buf += tp.bounds[b];
				}
			}
		}
		self.buf += ">";
	}

	// ------------------------------------------------------------------------
	// Declarations
	// ------------------------------------------------------------------------

	pub fn format_decl(var self, node: *AstNode) {
		if (node == null) return;
		self.comments.emit_before(&self.buf, node.line);

		when (node) {
			is ModuleDecl as m -> {
				self.buf += "mod ";
				self.buf += m.full_path;
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
				self.buf.newline();
			}
			is UseDecl as u -> {
				self.buf += "use ";
				self.buf += u.full_path;
				if (u.alias.len > 0) {
					self.buf += " as ";
					self.buf += u.alias;
				}
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is StructDecl as s -> {
				if (s.public) self.buf += "pub ";
				self.buf += "struct ";
				self.buf += s.name;
				self.format_type_params(s.type_params);
				self.buf += " {";

				if (s.fields.len > 0) {
					self.buf.indent();
					for (i in 0..<s.fields.len) {
						self.buf.newline();
						val f = s.fields[i];
						if (f.public) self.buf += "pub ";
						self.buf += f.name;
						self.buf += ": ";
						self.format_type(f.type_node);
						if (f.default_val != null) {
							self.buf += " = ";
							self.format_expr(f.default_val!);
						}
						if (i + 1 < s.fields.len) self.buf += ",";
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is FnDecl as f -> {
				if (f.public) self.buf += "pub ";
				if (f.initializer) {
					self.buf += "init";
				} else {
					if (f.operator) self.buf += "op ";
					else self.buf += "fn ";
					self.buf += f.name;
				}
				self.format_type_params(f.type_params);
				self.buf += "(";

				var params_broke = false;
				for (i in 0..<f.params.len) {
					val p = f.params[i];
					if (i > 0) {
						val need = 2 + self.measure_param(p);
						if (self.buf.current_col + need > self.options.max_width) {
							self.buf += ",";
							self.buf.newline();
							if (!params_broke) {
								self.buf.indent();
								params_broke = true;
							}
						} else self.buf += ", ";
					}
					self.format_param(p);
				}
				if (params_broke) self.buf.dedent();
				self.buf += ")";

				if (!f.initializer && f.return_type != null) {
					self.buf += ": ";
					self.format_type(f.return_type!);
				}

				if (f.body != null) {
					val body = f.body;
					when (body) {
						is BlockStmt -> {
							self.buf += " ";
							self.format_stmt(f.body!);
						}
						is ExprStmt as es -> {
							self.buf += " => ";
							self.format_expr(es.expr);
							self.buf += ";";
						}
						else -> {
							self.buf += " ";
							self.format_stmt(f.body!);
						}
					}
				} else self.buf += ";";

				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ImplDecl as im -> {
				self.buf += "impl";
				if (im.type_params.len > 0) {
					self.buf.space();
					self.format_type_params(im.type_params);
				}
				self.buf.space();
				if (im.trait_name.len > 0) {
					self.buf += im.trait_name;
					self.buf += " for ";
				}
				self.buf += im.struct_name;
				self.buf += " {";

				if (im.methods.len > 0) {
					self.buf.indent();
					for (i in 0..<im.methods.len) {
						if (i > 0) self.buf.double_newline();
						else self.buf.newline();
						self.format_decl(im.methods[i]);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is TraitDecl as tr -> {
				if (tr.public) self.buf += "pub ";
				self.buf += "trait ";
				self.buf += tr.name;
				self.format_type_params(tr.type_params);
				if (tr.bases.len > 0) {
					self.buf += " : ";
					for (i in 0..<tr.bases.len) {
						if (i > 0) self.buf += ", ";
						self.buf += tr.bases[i];
					}
				}
				self.buf += " {";

				if (tr.methods.len > 0) {
					self.buf.indent();
					for (m in tr.methods) {
						self.buf.newline();
						self.format_decl(m);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is EnumDecl as en -> {
				if (en.public) self.buf += "pub ";
				self.buf += "enum ";
				self.buf += en.name;
				if (en.underlying_type != null) {
					self.buf += ": ";
					self.format_type(en.underlying_type!);
				}
				self.buf += " {";

				if (en.members.len > 0) {
					self.buf.indent();
					for (i in 0..<en.members.len) {
						self.buf.newline();
						val mem = en.members[i];
						self.buf += mem.name;
						if (mem.value != null) {
							self.buf += " = ";
							self.format_expr(mem.value!);
						}
						if (i + 1 < en.members.len) self.buf += ",";
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ConstDecl as c -> {
				if (c.public) self.buf += "pub ";
				self.buf += "const ";
				self.buf += c.name;
				if (c.type_node != null) {
					self.buf += ": ";
					self.format_type(c.type_node!);
				}
				self.buf += " = ";
				if (c.value != null) self.format_expr(c.value!);
				self.buf += ";";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
			is ExternBlock as eb -> {
				self.buf += "extern \"";
				self.buf += eb.abi;
				self.buf += "\" {";

				if (eb.declarations.len > 0) {
					self.buf.indent();
					for (d in eb.declarations) {
						self.buf.newline();
						self.format_decl(d);
					}
					self.buf.dedent();
					self.buf.newline();
				}
				self.buf += "}";
				self.comments.emit_trailing_on_line(&self.buf, node.line);
			}
		}
	}

	// ------------------------------------------------------------------------
	// Program entry
	// ------------------------------------------------------------------------

	pub fn format_program(var self, program: *AstNode) {
		if (program == null) return;

		when (program) {
			is Program as p -> {
				var prev_was_import = false;

				for (i in 0..<p.declarations.len) {
					val decl = p.declarations[i];
					val is_import = (decl is UseDecl);

					if (i > 0) {
						if (prev_was_import && !is_import) self.buf.newline();
						else if (!is_import) self.buf.newline();
					}

					self.format_decl(decl);
					self.buf.newline();
					prev_was_import = is_import;
				}

				self.comments.emit_remaining(&self.buf);
			}
		}
	}

	pub fn format_file(
		path: str,
		write_in_place: bool = false,
		options: FormatOptions = FormatOptions()
	): bool {
		val fp = Path(path);
		val src = fp.read_text();
		if (src.empty()) {
			println("Error: cannot format '${path}': file is empty or unreadable");
			return false;
		}
		if (!is_parseable(src)) {
			println("Error: cannot format '${path}': source has syntax errors");
			return false;
		}

		val formatted = format_source(src, options);
		if (write_in_place) {
			val ok = fp.write_text(formatted);
			if (!ok) {
				println("Error: Failed to write to ${path}");
				return false;
			}
			println("Formatted: ${path}");
		} else {
			print(formatted);
		}
		return true;
	}

	pub fn format_files(
		files: List<str>,
		write_in_place: bool = false,
		options: FormatOptions = FormatOptions()
	): i32 {
		if (files.empty()) {
			println("Error: No files specified to format");
			return 1;
		}

		var all_ok = true;
		for (fpath in files) {
			if (!Self.format_file(fpath, write_in_place, options)) all_ok = false;
		}
		return if (all_ok) 0 else 1;
	}

}

/*
 * Parses the source first so the formatter never rewrites a file it could not
 * fully understand; `format_file` failing loudly beats emitting garbage.
 */
pub fn is_parseable(src: str): bool {
	val normalized = strip_cr(src);
	var lex = Lexer(normalized);
	var parser = Parser(lex.tokenize());
	parser.parse_program();
	return parser.errors.empty();
}

pub fn format_source(src: str, options: FormatOptions): str {
	val normalized = strip_cr(src);
	val comments = Comment.extract(normalized);
	val comment_table = CommentTable(comments);

	var lex = Lexer(normalized);
	val tokens = lex.tokenize();

	var parser = Parser(tokens);
	val program = parser.parse_program();

	var fmt = Formatter(options, comment_table, normalized);
	fmt.format_program(program);

	return fmt.to_str();
}
