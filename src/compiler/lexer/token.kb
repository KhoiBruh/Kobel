mod compiler.lexer;

use std.traits.*;
use std.string.*;

use compiler.core.Span;

/*
 * ============================================================================
 * compiler.lexer.token — Lexical token types and token representation
 *
 * Every token carries its `TokenType`, raw slice `text`, and source `Span`
 * (file_id, 1-based line/column, and byte length), along with `line` and `col`
 * for direct access.
 * ============================================================================
 */

pub enum TokenType {
	// Single-character punctuation & operators
	SEMI_COLON,    // ;
	COLON,         // :
	COMMA,         // ,
	DOT,           // .
	BANG,          // !
	EQUAL,         // =
	PLUS,          // +
	MINUS,         // -
	STAR,          // *
	SLASH,         // /
	PERCENT,       // %
	GREATER,       // >
	LESS,          // <
	OPEN_BRACKET,  // [
	CLOSE_BRACKET, // ]
	OPEN_PAREN,    // (
	CLOSE_PAREN,   // )
	OPEN_BRACE,    // {
	CLOSE_BRACE,   // }
	AMPERSAND,     // &
	QUESTION,      // ?

	// Multi-character operators & punctuation
	EQUAL_EQUAL,   // ==
	BANG_EQUAL,    // !=
	LESS_EQUAL,    // <=
	GREATER_EQUAL, // >=
	AND_AND,       // &&
	OR_OR,         // ||
	FAT_ARROW,     // =>
	ARROW,         // ->
	DOT_DOT,       // ..
	PLUS_PLUS,     // ++
	MINUS_MINUS,   // --
	PLUS_EQUAL,    // +=
	MINUS_EQUAL,   // -=
	STAR_EQUAL,    // *=
	SLASH_EQUAL,   // /=
	PERCENT_EQUAL, // %=
	QUESTION_COLON,// ?:
	QUESTION_DOT,  // ?.

	// Literals & identifiers
	CHAR,
	NUMBER,
	STRING,
	IDENTIFIER,

	// Keywords
	KW_EXTERN,
	KW_STRUCT,
	KW_ENUM,
	KW_FN,
	KW_RETURN,
	KW_CONST,
	KW_NULL,
	KW_TRUE,
	KW_FALSE,
	KW_VAL,
	KW_VAR,
	KW_AS,
	KW_WHILE,
	KW_BREAK,
	KW_CONTINUE,
	KW_IF,
	KW_ELSE,
	KW_WHEN,
	KW_MOD,
	KW_USE,
	KW_PUB,
	KW_TRAIT,
	KW_IMPL,
	KW_FOR,
	KW_IN,
	KW_YIELD,
	KW_OP,
	KW_DEFER,
	KW_IS,
	KW_INIT,

	// Specials
	END_OF_FILE,
	UNKNOWN
}

pub struct Token {
	pub type: TokenType,
	pub text: str,
	pub line: usz,
	pub col: usz,
	pub span: Span = Span.empty()
}

impl Token {

	pub init(type: TokenType, text: str, line: usz, col: usz)
		=> Self(type, text, line, col, Span(0, line, col, text.len));

	pub init(type: TokenType, text: str, line: usz, col: usz, span: Span)
		=> Self(type, text, line, col, span);

	pub fn is_eof(val self) => self.type == TokenType.END_OF_FILE;

	pub op unpack(val self, line: &usz, col: &usz) {
		line.write(self.line);
		col.write(self.col);
	}

	pub op unpack(val self, tok_type: &TokenType, line: &usz, col: &usz) {
		tok_type.write(self.type);
		line.write(self.line);
		col.write(self.col);
	}

	pub op unpack(val self, tok_type: &TokenType, text: &str, line: &usz, col: &usz) {
		tok_type.write(self.type);
		text.write(self.text);
		line.write(self.line);
		col.write(self.col);
	}

	pub fn is_unknown(val self) => self.type == TokenType.UNKNOWN;

	pub fn is_keyword(val self) => when (self.type) {
		TokenType.KW_EXTERN, TokenType.KW_STRUCT, TokenType.KW_ENUM,
		TokenType.KW_FN, TokenType.KW_RETURN, TokenType.KW_CONST,
		TokenType.KW_NULL, TokenType.KW_TRUE, TokenType.KW_FALSE,
		TokenType.KW_VAL, TokenType.KW_VAR, TokenType.KW_AS,
		TokenType.KW_WHILE, TokenType.KW_BREAK, TokenType.KW_CONTINUE,
		TokenType.KW_IF, TokenType.KW_ELSE, TokenType.KW_WHEN,
		TokenType.KW_MOD, TokenType.KW_USE, TokenType.KW_PUB,
		TokenType.KW_TRAIT, TokenType.KW_IMPL, TokenType.KW_FOR,
		TokenType.KW_IN, TokenType.KW_YIELD, TokenType.KW_OP,
		TokenType.KW_DEFER, TokenType.KW_IS, TokenType.KW_INIT -> true;
		else -> false;
	};

	pub fn is_literal(val self) => when (self.type) {
		TokenType.CHAR, TokenType.NUMBER, TokenType.STRING,
		TokenType.KW_TRUE, TokenType.KW_FALSE, TokenType.KW_NULL -> true;
		else -> false;
	};

	pub fn is_assignment_op(val self) => when (self.type) {
		TokenType.EQUAL, TokenType.PLUS_EQUAL, TokenType.MINUS_EQUAL,
		TokenType.STAR_EQUAL, TokenType.SLASH_EQUAL, TokenType.PERCENT_EQUAL -> true;
		else -> false;
	};

}

impl Stringer for Token {
	pub fn to_str(val self) => self.text;
}
