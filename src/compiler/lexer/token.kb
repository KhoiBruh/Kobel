mod compiler.lexer.token;

use std.traits.to_str.*;

pub enum TokenType {
	// Single syntax
	SEMI_COLON,    // ;
	COLON,         // :
	COMMA,         // ,
	DOT,           // .
	BANG,          // !
	EQUAL,         // =
	PLUS,          // +
	MINUS,         // -
	STAR,          // *
	SLASH,         // /
	PERCENT,       // %
	GREATER,       // >
	LESS,          // <
	OPEN_BRACKET,  // [
	CLOSE_BRACKET, // ]
	OPEN_PAREN,    // (
	CLOSE_PAREN,   // )
	OPEN_BRACE,    // {
	CLOSE_BRACE,   // }
	AMPERSAND,     // &

	// Double syntax
	EQUAL_EQUAL,   // ==
	BANG_EQUAL,    // !=
	LESS_EQUAL,    // <=
	GREATER_EQUAL, // >=
	AND_AND,       // &&
	OR_OR,         // ||
	FAT_ARROW,     // =>
	ARROW,         // ->
	DOT_DOT,       // ..

	// Literals
	CHAR,
	NUMBER,
	STRING,
	IDENTIFIER,

	// Keywords
	KW_EXTERN,
	KW_STRUCT,
	KW_ENUM,
	KW_FN,
	KW_RETURN,
	KW_CONST,
	KW_NULL,
	KW_TRUE,
	KW_FALSE,
	KW_VAL,
	KW_VAR,
	KW_AS,
	KW_WHILE,
	KW_BREAK,
	KW_CONTINUE,
	KW_IF,
	KW_ELSE,
	KW_WHEN,
	KW_MOD,
	KW_USE,
	KW_PUB,
	KW_TRAIT,
	KW_IMPL,
	KW_FOR,
	KW_IN,
	KW_YIELD,

	// Specials
	END_OF_FILE,
	UNKNOWN
}

pub struct Token {
	pub type: TokenType,
	pub text: str,
	pub line: usz,
	pub col: usz
}

impl ToStr for Token {
	pub fn to_str(val self): str => self.text;
}

pub fn strip_suffix(s: str, n: usz): str =>
	if (s.len <= n) "" else s.slice(0, s.len - n);