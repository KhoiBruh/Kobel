mod compiler.lexer.token;

use util.strutil.str_from_bytes;
use util.strutil.str_slice;
use std.mem.alloc.raw_alloc;

pub enum TokenType {
	// Single syntax
	SEMI_COLON,    // ;
	COLON,         // :
	COMMA,         // ,
	DOT,           // .
	BANG,          // !
	EQUAL,         // =
	PLUS,          // +
	MINUS,         // -
	STAR,          // *
	SLASH,         // /
	PERCENT,       // %
	GREATER,       // >
	LESS,          // <
	OPEN_BRACKET,  // [
	CLOSE_BRACKET, // ]
	OPEN_PAREN,    // (
	CLOSE_PAREN,   // )
	OPEN_BRACE,    // {
	CLOSE_BRACE,   // }
	AMPERSAND,     // &

	// Double syntax
	EQUAL_EQUAL,   // ==
	BANG_EQUAL,    // !=
	LESS_EQUAL,    // <=
	GREATER_EQUAL, // >=
	AND_AND,       // &&
	OR_OR,         // ||
	FAT_ARROW,     // =>
	ARROW,         // ->
	DOT_DOT,       // ..

	// Literals
	CHAR,
	NUMBER,
	STRING,
	IDENTIFIER,

	// Keywords
	KW_EXTERN,
	KW_STRUCT,
	KW_ENUM,
	KW_FN,
	KW_RETURN,
	KW_CONST,
	KW_NULL,
	KW_TRUE,
	KW_FALSE,
	KW_VAL,
	KW_VAR,
	KW_AS,
	KW_WHILE,
	KW_BREAK,
	KW_CONTINUE,
	KW_IF,
	KW_ELSE,
	KW_WHEN,
	KW_MOD,
	KW_USE,
	KW_PUB,
	KW_TRAIT,
	KW_IMPL,
	KW_FOR,
	KW_IN,

	// Specials
	END_OF_FILE,
	UNKNOWN
}

pub struct Token {
	pub type: TokenType,
	pub text: str,
	pub line: usz,
	pub col: usz
}

pub fn usz_to_str(n: usz): str {
	if (n == 0) return "0";
	val buf = raw_alloc(32);
	var tmp = n;
	var len = 0UZ;
	while (tmp > 0) {
		len = len + 1;
		tmp = tmp / 10;
	}
	buf[len] = 0;
	var i = len;
	tmp = n;
	while (tmp > 0) {
		i = i - 1;
		val digit = (tmp % 10) as u8;
		buf[i] = (48 + digit) as u8;
		tmp = tmp / 10;
	}
	return str_from_bytes(buf, len);
}

pub fn format_loc(line: usz, col: usz) => "Line " + usz_to_str(line) + ", Column " + usz_to_str(col) + ": ";
 
pub fn strip_suffix(s: str, n: usz): str {
	if (s.len <= n) return "";
	return str_slice(s, 0, s.len - n);
}