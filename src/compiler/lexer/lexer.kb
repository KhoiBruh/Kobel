mod compiler.lexer;

use std.ascii.*;
use std.collections.*;

use compiler.core.Diagnostic;
use compiler.core.Span;

/*
 * ============================================================================
 * compiler.lexer.lexer — Lexical scanner for Kobel source code
 *
 * Scans UTF-8 source text into a stream of `Token` values, tracking exact
 * source `Span` coordinates (file_id, start line, start column, byte length)
 * and collecting lexical errors in `errors: List<str>`.
 * ============================================================================
 */

pub fn lookup_keyword(text: str) => when (text) {
	"extern" -> TokenType.KW_EXTERN;
	"struct" -> TokenType.KW_STRUCT;
	"enum" -> TokenType.KW_ENUM;
	"fn" -> TokenType.KW_FN;
	"return" -> TokenType.KW_RETURN;
	"const" -> TokenType.KW_CONST;
	"null" -> TokenType.KW_NULL;
	"true" -> TokenType.KW_TRUE;
	"false" -> TokenType.KW_FALSE;
	"val" -> TokenType.KW_VAL;
	"var" -> TokenType.KW_VAR;
	"as" -> TokenType.KW_AS;
	"while" -> TokenType.KW_WHILE;
	"break" -> TokenType.KW_BREAK;
	"continue" -> TokenType.KW_CONTINUE;
	"if" -> TokenType.KW_IF;
	"else" -> TokenType.KW_ELSE;
	"when" -> TokenType.KW_WHEN;
	"mod" -> TokenType.KW_MOD;
	"use" -> TokenType.KW_USE;
	"pub" -> TokenType.KW_PUB;
	"trait" -> TokenType.KW_TRAIT;
	"impl" -> TokenType.KW_IMPL;
	"for" -> TokenType.KW_FOR;
	"in" -> TokenType.KW_IN;
	"yield" -> TokenType.KW_YIELD;
	"is" -> TokenType.KW_IS;
	"init" -> TokenType.KW_INIT;
	"op" -> TokenType.KW_OP;
	"defer" -> TokenType.KW_DEFER;
	else -> TokenType.IDENTIFIER;
};

fn strip_utf8_bom(src: str): str {
	if (src.len >= 3) {
		/*
		 * `EF BB BF`, the UTF-8 BOM (spelled in decimal because a hex literal
		 * ending in B/D/F is parsed as a float/byte suffix).
		 */
		if (
			src[0].code() == 239
			&& src[1].code() == 187
			&& src[2].code() == 191
		) return src.slice(3, src.len);
	}
	return src;
}

pub struct Lexer {
	pub src: str,
	pub cursor: usz = 0,
	pub line: usz = 1,
	pub col: usz = 1,
	pub file_id: u32 = 0,
	pub errors: List<Diagnostic> = List()
}

impl Lexer {

	/*
	 * A source file may open with a UTF-8 BOM (Windows editors add one). It is not
	 * part of the language, so drop it before the first token instead of letting it
	 * lex as an unknown token at line 1 column 1.
	 */
	pub init(src: str, file_id: u32 = 0)
		=> Self(strip_utf8_bom(src), 0, 1, 1, file_id, List<Diagnostic>());

	pub fn is_end(val self) => self.cursor >= self.src.len;

	pub fn peek(val self) => if (self.is_end()) '\0' else self.src[self.cursor];

	pub fn peek_at(val self, offset: usz): char {
		val idx = self.cursor + offset;
		if (idx >= self.src.len) return '\0';

		return self.src[idx];
	}

	pub fn sub(val self, start: usz) => self.src.slice(start, self.cursor);

	pub fn next(var self): char {
		if (self.is_end()) return '\0';

		val c = self.src[self.cursor];
		self.cursor++;
		self.col++;
		return c;
	}

	pub fn match(var self, expected: char): bool {
		if (self.is_end()) return false;
		if (self.src[self.cursor] != expected) return false;

		self.cursor++;
		self.col++;
		return true;
	}

	pub fn record_error(var self, line: usz, col: usz, msg: str) {
		self.errors += Diagnostic.error(
			Span(self.file_id, line, col), "", msg
		);
	}

	pub fn make_token(
		val self, type: TokenType,
		start_cursor: usz, start_col: usz
	) => self.make_token_at(type, start_cursor, self.line, start_col);

	pub fn make_token_at(
		val self, type: TokenType,
		start_cursor: usz, start_line: usz, start_col: usz
	): Token {
		val text = self.sub(start_cursor);
		val span = Span(self.file_id, start_line, start_col, text.len);
		return Token(type, text, start_line, start_col, span);
	}

	pub fn newline(var self) {
		val c = self.peek();
		when (c) {
			'\r' -> {
				self.next();
				if (!self.is_end() && self.peek() == '\n') self.cursor++;
			}
			'\n' -> self.cursor++;
		}

		self.line++;
		self.col = 1;
	}

	pub fn skip_space(var self) {
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				' ', '\t' -> self.next();
				'\r', '\n' -> self.newline();
				else -> break;
			}
		}
	}

	pub fn scan_identifier(var self, start_cursor: usz, start_col: usz): Token {
		while (!self.is_end()) {
			val c = self.peek();
			if (c.is_alphanumeric() || c == '_') self.next();
			else break;
		}

		val text = self.sub(start_cursor);
		val kw = lookup_keyword(text);
		val sp = Span(self.file_id, self.line, start_col, text.len);
		return Token(kw, text, self.line, start_col, sp);
	}

	pub fn scan_decimal_digits_and_fraction(var self) {
		while (!self.is_end()) {
			val c = self.peek();
			if (c.is_digit() || c == '_') self.next();
			else break;
		}

		if (
			self.peek() == '.'
			&& self.cursor + 1 < self.src.len
			&& self.src[self.cursor + 1].is_digit()
		) {
			self.next(); // consume '.'
			while (!self.is_end()) {
				val c = self.peek();
				if (c.is_digit() || c == '_') self.next();
				else break;
			}
		}
	}

	pub fn scan_number(var self, start_cursor: usz, start_col: usz): Token {
		val first = self.src[start_cursor];
		if (first == '0' && !self.is_end()) {
			val p = self.peek();
			when (p) {
				'x', 'X' -> {
					self.next(); // consume 'x' or 'X'
					while (!self.is_end()) {
						val c = self.peek();
						if (c.is_hex_digit() || c == '_') self.next();
						else break;
					}
				}
				'b', 'B' -> {
					self.next(); // consume 'b' or 'B'
					while (!self.is_end()) {
						val c = self.peek();
						if (c == '0' || c == '1' || c == '_') self.next();
						else break;
					}
				}
				'o', 'O' -> {
					self.next(); // consume 'o' or 'O'
					while (!self.is_end()) {
						val c = self.peek();
						if ((c >= '0' && c <= '7') || c == '_') self.next();
						else break;
					}
				}
				else -> self.scan_decimal_digits_and_fraction();
			}
		} else self.scan_decimal_digits_and_fraction();

		// Optional separator before suffix: e.g. 100_L or 0xFF_UL
		if (self.peek() == '_' && self.cursor + 1 < self.src.len) {
			val next_c = self.src[self.cursor + 1];
			when (next_c) {
				'S', 'L', 'B', 'Z', 'U', 'D', 'F' -> self.next();
			}
		}

		// Optional type suffixes: S, L, B, Z, U, US, UL, UB, UZ, D, F
		if (!self.is_end()) {
			val c1 = self.peek();
			if (c1 == 'U' && self.cursor + 1 < self.src.len) {
				val c2 = self.src[self.cursor + 1];
				when (c2) {
					'S', 'L', 'B', 'Z' -> {
						self.next();
						self.next();
					}
					else -> self.next();
				}
			} else when (c1) {
				'S', 'L', 'B', 'Z', 'U', 'D', 'F' -> self.next();
			}
		}

		return self.make_token(TokenType.NUMBER, start_cursor, start_col);
	}

	pub fn scan_string(var self, start_cursor: usz, start_col: usz): Token {
		val start_line = self.line;
		var closed = false;
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'"' -> {
					self.next();
					closed = true;
					break;
				}
				'\\' -> {
					self.next(); // consume '\'
					if (!self.is_end()) {
						val esc = self.peek();
						if (esc == '\r' || esc == '\n') self.newline();
						else self.next();
					}
					continue;
				}
				'\r', '\n' -> {
					self.newline();
					continue;
				}
				/*
				* `${...}` is an interpolation hole: skip it (nesting-aware) so the
				* closing quote of the string is found correctly. Where the braces
				* are, and what the hole contains, is the parser's business.
				*/
				'$' -> if (self.peek_at(1) == '{') {
					self.next(); // '$'
					self.skip_hole();
					continue;
				}
			}

			self.next();
		}

		if (!closed) {
			self.record_error(start_line, start_col, "Unterminated string literal");
			return self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
		}

		return self.make_token_at(TokenType.STRING, start_cursor, start_line, start_col);
	}

	pub fn scan_multiline_string(var self, start_cursor: usz, start_col: usz): Token {
		val start_line = self.line;
		var closed = false;
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'"' -> if (self.peek_at(1) == '"' && self.peek_at(2) == '"') {
					self.next();
					self.next();
					self.next();
					closed = true;
					break;
				}
				'\\' -> {
					self.next(); // consume '\'
					if (!self.is_end()) {
						val esc = self.peek();
						if (esc == '\r' || esc == '\n') self.newline();
						else self.next();
					}
					continue;
				}
				'\r', '\n' -> {
					self.newline();
					continue;
				}
				'$' -> if (self.peek_at(1) == '{') {
					self.next(); // '$'
					self.skip_hole();
					continue;
				}
			}

			self.next();
		}

		if (!closed) {
			self.record_error(start_line, start_col, "Unterminated multiline string literal");
			return self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
		}

		return self.make_token_at(TokenType.STRING, start_cursor, start_line, start_col);
	}

	/*
	 * Consumes a `${ ... }` hole body; the cursor sits on the '{'.
	 * Nested braces, string literals, char literals and nested `${...}` are all
	 * honoured so the matching '}' is the right one.
	 */
	pub fn skip_hole(var self) {
		var depth = 0;
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'{' -> {
					depth++;
					self.next();
					continue;
				}
				'}' -> {
					depth--;
					self.next();
					if (depth <= 0) return;
					continue;
				}
				'"' -> {
					if (self.peek_at(1) == '"' && self.peek_at(2) == '"') {
						self.skip_multiline_string_raw();
					} else {
						self.skip_string_raw();
					}
					continue;
				}
				'\'' -> {
					self.skip_char_raw();
					continue;
				}
				'\r', '\n' -> {
					self.newline();
					continue;
				}
				else -> self.next();
			}
		}
	}

	pub fn skip_multiline_string_raw(var self) {
		self.next(); // 1st quote
		self.next(); // 2nd quote
		self.next(); // 3rd quote
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'"' -> if (self.peek_at(1) == '"' && self.peek_at(2) == '"') {
					self.next();
					self.next();
					self.next();
					return;
				}
				'\\' -> {
					self.next();
					if (!self.is_end()) {
						val esc = self.peek();
						if (esc == '\r' || esc == '\n') self.newline();
						else self.next();
					}
					continue;
				}
				'$' -> if (self.peek_at(1) == '{') {
					self.next(); // '$'
					self.skip_hole();
					continue;
				}
				'\r', '\n' -> {
					self.newline();
					continue;
				}
			}

			self.next();
		}
	}

	/*
	 * Skips a string literal that starts on the current '"' (may itself be
	 * interpolated).
	 */
	pub fn skip_string_raw(var self) {
		self.next(); // opening quote
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'"' -> {
					self.next();
					return;
				}
				'\\' -> {
					self.next();
					if (!self.is_end()) self.next();
					continue;
				}
				'$' -> if (self.peek_at(1) == '{') {
					self.next(); // '$'
					self.skip_hole();
					continue;
				}
				'\r', '\n' -> {
					self.newline();
					continue;
				}
			}

			self.next();
		}
	}

	// Skips a char literal that starts on the current '\''.
	pub fn skip_char_raw(var self) {
		self.next(); // opening quote
		while (!self.is_end()) {
			val c = self.peek();
			when (c) {
				'\\' -> {
					self.next();
					if (!self.is_end()) self.next();
					continue;
				}
				'\'' -> {
					self.next();
					return;
				}
			}

			self.next();
		}
	}

	pub fn scan_char(var self, start_cursor: usz, start_col: usz): Token {
		val start_line = self.line;
		if (self.is_end() || self.peek() == '\'') {
			if (!self.is_end() && self.peek() == '\'') self.next();
			self.record_error(start_line, start_col, "Empty or unterminated character literal");
			return self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
		}

		if (self.peek() == '\\') self.next();
		if (!self.is_end()) self.next();

		if (self.peek() == '\'') {
			self.next();
			return self.make_token_at(TokenType.CHAR, start_cursor, start_line, start_col);
		}

		self.record_error(start_line, start_col, "Unterminated character literal");
		return self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
	}

	pub fn next_token(var self): Token {
		while (true) {
			self.skip_space();
			if (self.is_end()) {
				val eof_sp = Span(self.file_id, self.line, self.col);
				return Token(TokenType.END_OF_FILE, "", self.line, self.col, eof_sp);
			}

			val start_cursor = self.cursor;
			val start_line = self.line;
			val start_col = self.col;
			val c = self.next();

			return when (c) {
				',' -> self.make_token(TokenType.COMMA, start_cursor, start_col);
				'.' -> {
					if (self.match('.')) {
						if (self.match('<')) yield self.make_token(TokenType.DOT_DOT_LESS, start_cursor, start_col);
						yield self.make_token(TokenType.DOT_DOT, start_cursor, start_col);
					}
					yield self.make_token(TokenType.DOT, start_cursor, start_col);
				}
				':' -> self.make_token(TokenType.COLON, start_cursor, start_col);
				';' -> self.make_token(TokenType.SEMI_COLON, start_cursor, start_col);
				'(' -> self.make_token(TokenType.OPEN_PAREN, start_cursor, start_col);
				')' -> self.make_token(TokenType.CLOSE_PAREN, start_cursor, start_col);
				'{' -> self.make_token(TokenType.OPEN_BRACE, start_cursor, start_col);
				'}' -> self.make_token(TokenType.CLOSE_BRACE, start_cursor, start_col);
				'[' -> self.make_token(TokenType.OPEN_BRACKET, start_cursor, start_col);
				']' -> self.make_token(TokenType.CLOSE_BRACKET, start_cursor, start_col);
				'%' -> {
					if (self.match('=')) yield self.make_token(TokenType.PERCENT_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.PERCENT, start_cursor, start_col);
				}
				'+' -> {
					if (self.match('+')) yield self.make_token(TokenType.PLUS_PLUS, start_cursor, start_col);
					if (self.match('=')) yield self.make_token(TokenType.PLUS_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.PLUS, start_cursor, start_col);
				}
				'*' -> {
					if (self.match('=')) yield self.make_token(TokenType.STAR_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.STAR, start_cursor, start_col);
				}
				'"' -> {
					if (self.peek() == '"' && self.peek_at(1) == '"') {
						self.next();
						self.next();
						yield self.scan_multiline_string(start_cursor, start_col);
					}
					yield self.scan_string(start_cursor, start_col);
				}
				'\'' -> self.scan_char(start_cursor, start_col);

				'=' -> {
					if (self.match('=')) yield self.make_token(TokenType.EQUAL_EQUAL, start_cursor, start_col);
					if (self.match('>')) yield self.make_token(TokenType.FAT_ARROW, start_cursor, start_col);
					yield self.make_token(TokenType.EQUAL, start_cursor, start_col);
				}

				'-' -> {
					if (self.match('-')) yield self.make_token(TokenType.MINUS_MINUS, start_cursor, start_col);
					if (self.match('=')) yield self.make_token(TokenType.MINUS_EQUAL, start_cursor, start_col);
					if (self.match('>')) yield self.make_token(TokenType.ARROW, start_cursor, start_col);
					yield self.make_token(TokenType.MINUS, start_cursor, start_col);
				}

				'/' -> {
					if (self.match('/')) {
						while (
							!self.is_end()
							&& self.peek() != '\n'
							&& self.peek() != '\r'
						) self.next();
						continue;
					}
					if (self.match('*')) {
						var closed_comment = false;
						while (!self.is_end()) {
							if (self.peek() == '\r' || self.peek() == '\n') {
								self.newline();
								continue;
							}
							if (
								self.peek() == '*'
								&& self.cursor + 1 < self.src.len
								&& self.src[self.cursor + 1] == '/'
							) {
								self.next(); // '*'
								self.next(); // '/'
								closed_comment = true;
								break;
							}
							self.next();
						}
						if (!closed_comment) {
							self.record_error(start_line, start_col, "Unterminated block comment");
						}
						continue;
					}
					if (self.match('=')) yield self.make_token(TokenType.SLASH_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.SLASH, start_cursor, start_col);
				}

				'<' -> {
					if (self.match('=')) yield self.make_token(TokenType.LESS_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.LESS, start_cursor, start_col);
				}

				'>' -> {
					if (self.match('=')) yield self.make_token(TokenType.GREATER_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.GREATER, start_cursor, start_col);
				}

				'&' -> {
					if (self.match('&')) yield self.make_token(TokenType.AND_AND, start_cursor, start_col);
					yield self.make_token(TokenType.AMPERSAND, start_cursor, start_col);
				}

				'!' -> {
					if (self.match('=')) yield self.make_token(TokenType.BANG_EQUAL, start_cursor, start_col);
					yield self.make_token(TokenType.BANG, start_cursor, start_col);
				}

				'|' -> {
					if (self.match('|')) yield self.make_token(TokenType.OR_OR, start_cursor, start_col);
					self.record_error(start_line, start_col, "Unexpected character '|'");
					yield self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
				}

				'?' -> {
					if (self.match(':')) yield self.make_token(TokenType.QUESTION_COLON, start_cursor, start_col);
					if (self.match('.')) yield self.make_token(TokenType.QUESTION_DOT, start_cursor, start_col);
					yield self.make_token(TokenType.QUESTION, start_cursor, start_col);
				}

				else -> {
					if (c.is_alpha() || c == '_') yield self.scan_identifier(start_cursor, start_col);
					if (c.is_digit()) yield self.scan_number(start_cursor, start_col);
					self.record_error(start_line, start_col, "Unexpected character '${c}'");
					yield self.make_token_at(TokenType.UNKNOWN, start_cursor, start_line, start_col);
				}
			};
		}

		val unk_sp = Span(self.file_id, self.line, self.col);
		return Token(TokenType.UNKNOWN, "", self.line, self.col, unk_sp);
	}

	pub fn tokenize(var self): List<Token> {
		var tokens = List<Token>();
		while (true) {
			val tok = self.next_token();
			tokens += tok;
			if (tok.type == TokenType.END_OF_FILE) break;
		}
		return tokens;
	}

}
