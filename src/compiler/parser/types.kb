mod compiler.parser;

use std.collections.*;

use compiler.lexer.*;
use compiler.ast.*;

/*
 * ============================================================================
 * compiler.parser.types — Type annotation parser
 * ============================================================================
 */

impl Parser {

	pub fn parse_single_type(&self): *AstNode {
		val (line, col) = self.peek();

		// 1. Variadic type: ..T
		if (self.match_token(TokenType.DOT_DOT)) {
			val elem_type = self.parse_single_type();
			return self.node(NodeData.VariadicType(elem_type), line, col);
		}

		// 2. Pointer type: *T (read-only), &T (read-write), ?*T / ?&T (nullable)
		if (self.match_token(TokenType.QUESTION)) {
			if (self.match_token(TokenType.STAR)) {
				val pointee = self.parse_single_type();
				return self.node(NodeData.PointerType(false, true, pointee), line, col);
			}
			if (self.match_token(TokenType.AMPERSAND)) {
				val pointee = self.parse_single_type();
				return self.node(NodeData.PointerType(true, true, pointee), line, col);
			}
			self.error(self.peek(), "Expected '*' or '&' after '?' (only pointer types can be nullable: ?*T / ?&T)");
			return self.parse_single_type();
		}

		if (self.match_token(TokenType.STAR)) {
			val pointee = self.parse_single_type();
			return self.node(NodeData.PointerType(false, false, pointee), line, col);
		}

		if (self.match_token(TokenType.AMPERSAND)) {
			val pointee = self.parse_single_type();
			return self.node(NodeData.PointerType(true, false, pointee), line, col);
		}

		// 3. Function type: (T1, T2) -> R
		if (self.match_token(TokenType.OPEN_PAREN)) {
			var param_types = List<*AstNode>();
			if (!self.check(TokenType.CLOSE_PAREN)) {
				param_types += self.parse_type();
				while (self.match_token(TokenType.COMMA)) {
					param_types += self.parse_type();
				}
			}
			self.consume(TokenType.CLOSE_PAREN, "Expected ')' after function parameter types");
			self.consume(TokenType.ARROW, "Expected '->' after function parameter types");
			val ret_type = self.parse_type();
			return self.node(NodeData.FnType(param_types, ret_type), line, col);
		}

		// 4. Named type / Path: Foo, std.collections.List, List<T>
		val id_tok = self.consume(TokenType.IDENTIFIER, "Expected type name");
		var full_name = id_tok.text;

		while (self.match_token(TokenType.DOT)) {
			val seg = self.consume(TokenType.IDENTIFIER, "Expected identifier after '.' in type path");
			full_name = "${full_name}.${seg.text}";
		}

		var type_args = List<*AstNode>();
		if (self.match_token(TokenType.LESS)) {
			if (!self.check(TokenType.GREATER)) {
				type_args += self.parse_type();
				while (self.match_token(TokenType.COMMA)) type_args += self.parse_type();
			}
			self.consume(TokenType.GREATER, "Expected '>' after type arguments");
		}

		return self.node(NodeData.NamedType(full_name, type_args), line, col);
	}

	pub fn parse_type(&self): *AstNode => self.parse_single_type();

}
