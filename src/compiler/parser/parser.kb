mod compiler.parser.parser;

use std.mem.arena.*;
use std.collections.list.*;

use compiler.lexer.token.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

pub struct Parser {
	pub tokens: List<Token>,
	pub current: usz = 0,
	pub arena: Arena = Arena(),
	pub errors: List<str> = List(),
	pub struct_consts: List<*AstNode> = List()
}

impl Parser {

	pub fn new(tokens: List<Token>) => Self(tokens);

	pub fn named_type(var self, name: str, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(NamedType.TAG, NodeData.NamedType(self.arena.alloc_val(NamedType(name, type_args))), line, col);

	pub fn pointer_type(var self, is_mut: bool, pointee: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(PointerType.TAG, NodeData.PointerType(self.arena.alloc_val(PointerType(is_mut, pointee))), line, col);

	pub fn array_type(var self, elem: *AstNode, size: usz, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ArrayType.TAG, NodeData.ArrayType(self.arena.alloc_val(ArrayType(elem, size))), line, col);

	pub fn nullable_type(var self, inner: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(NullableType.TAG, NodeData.NullableType(self.arena.alloc_val(NullableType(inner))), line, col);

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(LiteralExpr.TAG, NodeData.LiteralExpr(self.arena.alloc_val(LiteralExpr(lk, raw))), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(IdentifierExpr.TAG, NodeData.IdentifierExpr(self.arena.alloc_val(IdentifierExpr(name))), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(BinaryExpr.TAG, NodeData.BinaryExpr(self.arena.alloc_val(BinaryExpr(left, op, right))), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz, is_postfix: bool = false): *AstNode
		=> self.arena.alloc_node(UnaryExpr.TAG, NodeData.UnaryExpr(self.arena.alloc_val(UnaryExpr(op, operand, is_postfix))), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(CallExpr.TAG, NodeData.CallExpr(self.arena.alloc_val(CallExpr(callee, args, type_args))), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(MemberExpr.TAG, NodeData.MemberExpr(self.arena.alloc_val(MemberExpr(obj, member))), line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(MemberExpr.TAG, NodeData.MemberExpr(self.arena.alloc_val(MemberExpr(obj, member, true))), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(IndexExpr.TAG, NodeData.IndexExpr(self.arena.alloc_val(IndexExpr(target, index))), line, col);

	pub fn assign(var self, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(AssignExpr.TAG, NodeData.AssignExpr(self.arena.alloc_val(AssignExpr(target, TokenType.EQUAL, value))), line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(AssignExpr.TAG, NodeData.AssignExpr(self.arena.alloc_val(AssignExpr(target, op, value))), line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(UpdateExpr.TAG, NodeData.UpdateExpr(self.arena.alloc_val(UpdateExpr(op, target))), line, col);

	pub fn cast(var self, expr: *AstNode, target_type: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(CastExpr.TAG, NodeData.CastExpr(self.arena.alloc_val(CastExpr(expr, target_type))), line, col);

	pub fn is_expr(var self, expr: *AstNode, target_type: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(IsExpr.TAG, NodeData.IsExpr(self.arena.alloc_val(IsExpr(expr, target_type))), line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(GroupExpr.TAG, NodeData.GroupExpr(self.arena.alloc_val(GroupExpr(expr))), line, col);

	pub fn array_literal(var self, elements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ArrayLiteralExpr.TAG, NodeData.ArrayLiteralExpr(self.arena.alloc_val(ArrayLiteralExpr(elements, "", null))), line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ArrayLiteralExpr.TAG, NodeData.ArrayLiteralExpr(self.arena.alloc_val(ArrayLiteralExpr(elements, list_struct_name, elem_type_node))), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(IfExpr.TAG, NodeData.IfExpr(self.arena.alloc_val(IfExpr(condition, then_branch, else_branch))), line, col);

	pub fn when_expr(var self, condition: *AstNode, arms: List<WhenArm>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(WhenExpr.TAG, NodeData.WhenExpr(self.arena.alloc_val(WhenExpr(condition, arms))), line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(InterpExpr.TAG, NodeData.InterpExpr(self.arena.alloc_val(InterpExpr(parts))), line, col);

	pub fn block_stmt(var self, statements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(BlockStmt.TAG, NodeData.BlockStmt(self.arena.alloc_val(BlockStmt(statements))), line, col);

	pub fn expr_stmt(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ExprStmt.TAG, NodeData.ExprStmt(self.arena.alloc_val(ExprStmt(expr))), line, col);

	pub fn var_decl(var self, is_mut: bool, name: str, type_annotation: *AstNode, initializer: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(VarDeclStmt.TAG, NodeData.VarDeclStmt(self.arena.alloc_val(VarDeclStmt(is_mut, name, type_annotation, initializer))), line, col);

	pub fn if_stmt(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(IfStmt.TAG, NodeData.IfStmt(self.arena.alloc_val(IfStmt(condition, then_branch, else_branch))), line, col);

	pub fn while_stmt(var self, condition: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(WhileStmt.TAG, NodeData.WhileStmt(self.arena.alloc_val(WhileStmt(condition, body))), line, col);

	pub fn for_stmt(var self, var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode, range_start: *AstNode, range_end: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ForStmt.TAG, NodeData.ForStmt(self.arena.alloc_val(ForStmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body))), line, col);

	pub fn return_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ReturnStmt.TAG, NodeData.ReturnStmt(self.arena.alloc_val(ReturnStmt(value))), line, col);

	pub fn break_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(BreakStmt.TAG, NodeData.BreakStmt(self.arena.alloc_val(BreakStmt(0))), line, col);

	pub fn continue_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ContinueStmt.TAG, NodeData.ContinueStmt(self.arena.alloc_val(ContinueStmt(0))), line, col);

	pub fn when_stmt(var self, condition: *AstNode, arms: List<WhenStmtArm>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(WhenStmt.TAG, NodeData.WhenStmt(self.arena.alloc_val(WhenStmt(condition, arms))), line, col);

	pub fn yield_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(YieldStmt.TAG, NodeData.YieldStmt(self.arena.alloc_val(YieldStmt(value))), line, col);

	pub fn defer_stmt(var self, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(DeferStmt.TAG, NodeData.DeferStmt(self.arena.alloc_val(DeferStmt(body))), line, col);

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ModuleDecl.TAG, NodeData.ModuleDecl(self.arena.alloc_val(ModuleDecl(path, full_path))), line, col);

	pub fn use_decl(var self, path: List<str>, full_path: str, symbol_name: str, alias: str, is_wildcard: bool, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(UseDecl.TAG, NodeData.UseDecl(self.arena.alloc_val(UseDecl(path, full_path, symbol_name, alias, is_wildcard))), line, col);

	pub fn fn_decl(var self, name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode, body: *AstNode, is_pub: bool, line: usz, col: usz, is_op: bool = false): *AstNode
		=> self.arena.alloc_node(FnDecl.TAG, NodeData.FnDecl(self.arena.alloc_val(FnDecl(name, type_params, params, return_type, body, is_pub, is_op))), line, col);

	pub fn struct_decl(var self, name: str, type_params: List<GenericParam>, fields: List<StructField>, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(StructDecl.TAG, NodeData.StructDecl(self.arena.alloc_val(StructDecl(name, type_params, fields, is_pub))), line, col);

	// `struct Name;` — an opaque declaration whose definition may follow later.
	pub fn struct_decl_forward(var self, name: str, type_params: List<GenericParam>, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(StructDecl.TAG, NodeData.StructDecl(self.arena.alloc_val(StructDecl(name, type_params, List<StructField>(), is_pub, true))), line, col);

	pub fn trait_decl(var self, name: str, type_params: List<GenericParam>, bases: List<str>, methods: List<*AstNode>, is_pub: bool, line: usz, col: usz, assoc_types: List<str> = List()): *AstNode
		=> self.arena.alloc_node(TraitDecl.TAG, NodeData.TraitDecl(self.arena.alloc_val(TraitDecl(name, type_params, bases, methods, is_pub, assoc_types))), line, col);

	pub fn impl_decl(var self, struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, line: usz, col: usz, assoc_bindings: List<AssocBinding> = List()): *AstNode
		=> self.arena.alloc_node(ImplDecl.TAG, NodeData.ImplDecl(self.arena.alloc_val(ImplDecl(struct_name, type_params, trait_name, methods, assoc_bindings))), line, col);

	pub fn enum_decl(var self, name: str, underlying_type: *AstNode, members: List<EnumMember>, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(EnumDecl.TAG, NodeData.EnumDecl(self.arena.alloc_val(EnumDecl(name, underlying_type, members, is_pub))), line, col);

	pub fn const_decl(var self, name: str, type_node: *AstNode, value: *AstNode, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ConstDecl.TAG, NodeData.ConstDecl(self.arena.alloc_val(ConstDecl(name, type_node, value, is_pub))), line, col);

	pub fn extern_block(var self, abi: str, declarations: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(ExternBlock.TAG, NodeData.ExternBlock(self.arena.alloc_val(ExternBlock(abi, declarations))), line, col);

	pub fn program(var self, declarations: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node(Program.TAG, NodeData.Program(self.arena.alloc_val(Program(declarations))), line, col);

	pub fn is_end(var self): bool {
		if (self.current >= self.tokens.len) return true;
		val tok = self.tokens[self.current];
		return tok.type == TokenType.END_OF_FILE;
	}

	pub fn peek(var self) =>
		if (self.current >= self.tokens.len) self.tokens.last()
		else self.tokens[self.current];

// Token `offset` positions ahead of the cursor (0 == peek), clamped to the end.
	pub fn peek_at(var self, offset: usz): Token {
		val idx = self.current + offset;
		if (idx >= self.tokens.len) return self.tokens.last();
		return self.tokens[idx];
	}

	pub fn previous(var self) =>
		if (self.current == 0) self.tokens.first()
		else self.tokens[self.current - 1];

	pub fn advance(var self): Token {
		if (!self.is_end()) self.current++;
		return self.previous();
	}

	pub fn check(var self, t: TokenType): bool {
		if (self.is_end()) return false;
		val tok = self.peek();
		return tok.type == t;
	}

	pub fn match_token(var self, t: TokenType): bool {
		if (self.check(t)) {
			self.advance();
			return true;
		}
		return false;
	}

	// Record a parse error with line and column
	pub fn error(var self, tok: Token, msg: str) {
		self.errors += "Line ${tok.line}, Column ${tok.col}: ${msg}";
	}

	pub fn consume(var self, t: TokenType, msg: str): Token {
		if (self.check(t)) return self.advance();
		if (t == TokenType.IDENTIFIER && self.check(TokenType.KW_OP)) return self.advance();
		val tok = self.peek();
		self.error(tok, msg);
		return tok;
	}

	pub fn synchronize(var self) {
		self.advance();

		while (!self.is_end()) {
			val prev = self.previous();
			if (prev.type == TokenType.SEMI_COLON) return;

			val cur = self.peek();
			when (cur.type) {
				TokenType.KW_FN, TokenType.KW_STRUCT,
				TokenType.KW_VAL, TokenType.KW_VAR,
				TokenType.KW_IF, TokenType.KW_WHEN,
				TokenType.KW_WHILE, TokenType.KW_FOR,
				TokenType.KW_RETURN, TokenType.KW_PUB,
				TokenType.KW_MOD, TokenType.KW_USE,
				TokenType.KW_ENUM, TokenType.KW_TRAIT,
				TokenType.KW_IMPL, TokenType.KW_EXTERN -> return;
				else -> self.advance();
			}
		}
	}

	pub fn is_generic_args_ahead(var self): bool {
		// Check whether the position after '<' looks like type arguments ending with '>'
		if (!self.check(TokenType.LESS)) return false;

		var depth = 1;

		for (i in (self.current + 1)..<self.tokens.len) {
			val tok = self.tokens[i];
			when (tok.type) {
				TokenType.LESS -> depth++;
				TokenType.GREATER -> {
					depth--;
					if (depth == 0) return (
						i + 1 < self.tokens.len &&
						self.tokens[i + 1].type == TokenType.OPEN_PAREN
					);
				}
				TokenType.SEMI_COLON, TokenType.OPEN_BRACE,
				TokenType.CLOSE_BRACE, TokenType.END_OF_FILE -> return false;
			}
		}

		return false;
	}

}
