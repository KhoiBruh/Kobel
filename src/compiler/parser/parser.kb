mod compiler.parser.parser;

use compiler.lexer.token.*;
use compiler.ast.builder.AstBuilder;
use std.collections.list.*;
use std.mem.arena.*;

pub struct Parser {
	pub tokens: List<Token>,
	pub current: usz,
	pub arena: Arena,
	pub errors: List<str>,
	pub builder: AstBuilder
}

impl Parser {
	pub fn new(tokens: List<Token>): Parser => Self(tokens, 0, Arena(65536), List<str>(), AstBuilder(null));
	pub fn b(var self: &Parser): &AstBuilder {
		self.builder.arena = &self.arena;
		return &self.builder;
	}
}

pub fn is_end(var self: &Parser): bool {
	if (self.current >= self.tokens.len) return true;
	val tok = self.tokens.get(self.current);
	return tok.type == TokenType.END_OF_FILE;
}

pub fn peek(var self: &Parser): Token {
	if (self.current >= self.tokens.len) return self.tokens.last();
	return self.tokens.get(self.current);
}

// Token `offset` positions ahead of the cursor (0 == peek), clamped to the end.
pub fn peek_at(var self: &Parser, offset: usz): Token {
	val idx = self.current + offset;
	if (idx >= self.tokens.len) return self.tokens.last();
	return self.tokens.get(idx);
}

pub fn previous(var self: &Parser): Token {
	if (self.current == 0) return self.tokens.first();
	return self.tokens.get(self.current - 1);
}

pub fn advance(var self: &Parser): Token {
	if (!is_end(self)) self.current = self.current + 1;
	return previous(self);
}

pub fn check(var self: &Parser, t: TokenType): bool {
	if (is_end(self)) return false;
	val tok = peek(self);
	return tok.type == t;
}

pub fn match_token(var self: &Parser, t: TokenType): bool {
	if (check(self, t)) {
		advance(self);
		return true;
	}
	return false;
}

pub fn error(var self: &Parser, tok: Token, msg: str) {
	// Record a parse error with line and column
	self.errors.add("Line ${tok.line}, Column ${tok.col}: ${msg}");
}

pub fn consume(var self: &Parser, t: TokenType, msg: str): Token {
	if (check(self, t)) return advance(self);
	val tok = peek(self);
	error(self, tok, msg);
	return tok;
}

pub fn synchronize(var self: &Parser) {
	advance(self);

	while (!is_end(self)) {
		val prev = previous(self);
		if (prev.type == TokenType.SEMI_COLON) return;

		val cur = peek(self);
		when (cur.type) {
			TokenType.KW_FN,
			TokenType.KW_STRUCT,
			TokenType.KW_VAL,
			TokenType.KW_VAR,
			TokenType.KW_IF,
			TokenType.KW_WHEN,
			TokenType.KW_WHILE,
			TokenType.KW_FOR,
			TokenType.KW_RETURN,
			TokenType.KW_PUB,
			TokenType.KW_MOD,
			TokenType.KW_USE,
			TokenType.KW_ENUM,
			TokenType.KW_TRAIT,
			TokenType.KW_IMPL,
			TokenType.KW_EXTERN -> return;
			else -> advance(self);
		}
	}
}

pub fn is_generic_args_ahead(var self: &Parser): bool {
	// Check whether the position after '<' looks like type arguments ending with '>'
	if (!check(self, TokenType.LESS)) return false;

	var depth = 1;

	for (i in (self.current + 1)..<self.tokens.len) {
		val tok = self.tokens.get(i);
		when (tok.type) {
			TokenType.LESS -> { depth = depth + 1; }
			TokenType.GREATER -> {
				depth = depth - 1;
				if (depth == 0) return true;
			}
			TokenType.SEMI_COLON,
			TokenType.OPEN_BRACE,
			TokenType.CLOSE_BRACE,
			TokenType.END_OF_FILE -> return false;
			else -> {}
		}
	}

	return false;
}
