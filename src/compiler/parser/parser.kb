mod compiler.parser.parser;

use std.memory.*;
use std.collections.*;

use compiler.lexer.*;
use compiler.ast.node.*;
use compiler.ast.builder.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

pub struct Parser {
	pub tokens: List<Token>,
	pub current: usz = 0,
	pub arena: Arena = Arena(),
	pub errors: List<str> = List(),
	pub struct_consts: List<*AstNode> = List()
}

impl Parser {

	pub init(tokens: List<Token>) => Self(tokens);

	pub fn named_type(var self, name: str, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.named_type(name, type_args, line, col);

	pub fn pointer_type(var self, mutable: bool, pointee: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.pointer_type(mutable, pointee, line, col);

	pub fn array_type(var self, elem: *AstNode, size: usz, line: usz, col: usz): *AstNode
		=> self.arena.array_type(elem, size, line, col);

	pub fn nullable_type(var self, inner: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.nullable_type(inner, line, col);

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz): *AstNode
		=> self.arena.literal(lk, raw, line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz): *AstNode
		=> self.arena.identifier(name, line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.binary(op, left, right, line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz, is_postfix: bool = false): *AstNode
		=> self.arena.unary(op, operand, line, col, is_postfix);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.call(callee, args, type_args, line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.member(obj, member, line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.safe_member(obj, member, line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.index(target, index, line, col);

	pub fn assign(var self, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.assign(target, value, line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.compound_assign(op, target, value, line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.update(op, target, line, col);

	pub fn cast(var self, expr: *AstNode, target_type: *AstNode, line: usz = 0, col: usz = 0): *AstNode
		=> self.arena.cast(expr, target_type, line, col);

	pub fn is_expr(var self, expr: *AstNode? = null, target_type: *AstNode, line: usz = 0, col: usz = 0): *AstNode
		=> self.arena.is_expr(expr, target_type, line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.group(expr, line, col);

	pub fn array_literal(var self, elements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.array_literal(elements, line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.list_literal(elements, list_struct_name, elem_type_node, line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.if_expr(condition, then_branch, else_branch, line, col);

	pub fn when_expr(var self, condition: *AstNode?, arms: List<WhenArm>, line: usz, col: usz): *AstNode
		=> self.arena.when_expr(condition, arms, line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz): *AstNode
		=> self.arena.interp(parts, line, col);

	pub fn block_stmt(var self, statements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.block_stmt(statements, line, col);

	pub fn expr_stmt(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.expr_stmt(expr, line, col);

	pub fn var_decl(var self, mutable: bool, name: str, type_annotation: *AstNode?, initializer: *AstNode?, line: usz, col: usz): *AstNode
		=> self.arena.var_decl(mutable, name, type_annotation, initializer, line, col);

	pub fn if_stmt(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode?, line: usz, col: usz): *AstNode
		=> self.arena.if_stmt(condition, then_branch, else_branch, line, col);

	pub fn while_stmt(var self, condition: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.while_stmt(condition, body, line, col);

	pub fn for_stmt(var self, var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode?, range_start: *AstNode?, range_end: *AstNode?, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.for_stmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body, line, col);

	pub fn return_stmt(var self, value: *AstNode?, line: usz, col: usz): *AstNode
		=> self.arena.return_stmt(value, line, col);

	pub fn break_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.break_stmt(line, col);

	pub fn continue_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.continue_stmt(line, col);

	pub fn when_stmt(var self, condition: *AstNode?, arms: List<WhenStmtArm>, line: usz, col: usz): *AstNode
		=> self.arena.when_stmt(condition, arms, line, col);

	pub fn yield_stmt(var self, value: *AstNode?, line: usz, col: usz): *AstNode
		=> self.arena.yield_stmt(value, line, col);

	pub fn defer_stmt(var self, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.defer_stmt(body, line, col);

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz): *AstNode
		=> self.arena.module_decl(path, full_path, line, col);

	pub fn use_decl(var self, path: List<str>, full_path: str, symbol_name: str, alias: str, is_wildcard: bool, line: usz, col: usz): *AstNode
		=> self.arena.use_decl(path, full_path, symbol_name, alias, is_wildcard, line, col);

	pub fn fn_decl(var self, name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode? = null, body: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0, is_op: bool = false, is_init: bool = false): *AstNode
		=> self.arena.fn_decl(name, type_params, params, return_type, body, public, line, col, is_op, is_init);

	pub fn init_decl(var self, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode? = null, body: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0): *AstNode
		=> self.arena.init_decl(type_params, params, return_type, body, public, line, col);

	pub fn struct_decl(var self, name: str, type_params: List<GenericParam>, fields: List<StructField>, public: bool, line: usz, col: usz): *AstNode
		=> self.arena.struct_decl(name, type_params, fields, public, line, col);

	// `struct Name;` — an opaque declaration whose definition may follow later.
	pub fn struct_decl_forward(var self, name: str, type_params: List<GenericParam>, public: bool, line: usz, col: usz): *AstNode
		=> self.arena.struct_decl_forward(name, type_params, public, line, col);

	pub fn trait_decl(var self, name: str, type_params: List<GenericParam>, bases: List<str>, methods: List<*AstNode>, public: bool, line: usz, col: usz, assoc_types: List<str> = List()): *AstNode
		=> self.arena.trait_decl(name, type_params, bases, methods, public, line, col, assoc_types);

	pub fn impl_decl(var self, struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, line: usz, col: usz, assoc_bindings: List<AssocBinding> = List()): *AstNode
		=> self.arena.impl_decl(struct_name, type_params, trait_name, methods, line, col, assoc_bindings);

	pub fn enum_decl(var self, name: str, underlying_type: *AstNode? = null, members: List<EnumMember> = List(), public: bool = false, line: usz = 0, col: usz = 0): *AstNode
		=> self.arena.enum_decl(name, underlying_type, members, public, line, col);

	pub fn const_decl(var self, name: str, type_node: *AstNode? = null, value: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0): *AstNode
		=> self.arena.const_decl(name, type_node, value, public, line, col);

	pub fn extern_block(var self, abi: str, declarations: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.extern_block(abi, declarations, line, col);

	pub fn program(var self, declarations: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.program(declarations, line, col);

	pub fn is_end(var self): bool {
		if (self.current >= self.tokens.len) return true;
		val tok = self.tokens[self.current];
		return tok.type == TokenType.END_OF_FILE;
	}

	pub fn peek(var self) =>
		if (self.current >= self.tokens.len) self.tokens.last()
		else self.tokens[self.current];

// Token `offset` positions ahead of the cursor (0 == peek), clamped to the end.
	pub fn peek_at(var self, offset: usz): Token {
		val idx = self.current + offset;
		if (idx >= self.tokens.len) return self.tokens.last();
		return self.tokens[idx];
	}

	pub fn previous(var self) =>
		if (self.current == 0) self.tokens.first()
		else self.tokens[self.current - 1];

	pub fn advance(var self): Token {
		if (!self.is_end()) self.current++;
		return self.previous();
	}

	pub fn check(var self, t: TokenType): bool {
		if (self.is_end()) return false;
		val tok = self.peek();
		return tok.type == t;
	}

	pub fn match_token(var self, t: TokenType): bool {
		if (self.check(t)) {
			self.advance();
			return true;
		}
		return false;
	}

	// Record a parse error with line and column
	pub fn error(var self, tok: Token, msg: str) {
		self.errors += "Line ${tok.line}, Column ${tok.col}: ${msg}";
	}

	pub fn consume(var self, t: TokenType, msg: str): Token {
		if (self.check(t)) return self.advance();
		if (t == TokenType.IDENTIFIER && self.check(TokenType.KW_OP)) return self.advance();
		val tok = self.peek();
		self.error(tok, msg);
		return tok;
	}

	pub fn synchronize(var self) {
		self.advance();

		while (!self.is_end()) {
			val prev = self.previous();
			if (prev.type == TokenType.SEMI_COLON) return;

			val cur = self.peek();
			when (cur.type) {
				TokenType.KW_FN, TokenType.KW_STRUCT,
				TokenType.KW_VAL, TokenType.KW_VAR,
				TokenType.KW_IF, TokenType.KW_WHEN,
				TokenType.KW_WHILE, TokenType.KW_FOR,
				TokenType.KW_RETURN, TokenType.KW_PUB,
				TokenType.KW_MOD, TokenType.KW_USE,
				TokenType.KW_ENUM, TokenType.KW_TRAIT,
				TokenType.KW_IMPL, TokenType.KW_EXTERN -> return;
				else -> self.advance();
			}
		}
	}

	pub fn is_generic_args_ahead(var self): bool {
		// Check whether the position after '<' looks like type arguments ending with '>'
		if (!self.check(TokenType.LESS)) return false;

		var depth = 1;

		for (i in (self.current + 1)..<self.tokens.len) {
			val tok = self.tokens[i];
			when (tok.type) {
				TokenType.LESS -> depth++;
				TokenType.GREATER -> {
					depth--;
					if (depth == 0) return (
						i + 1 < self.tokens.len &&
						self.tokens[i + 1].type == TokenType.OPEN_PAREN
					);
				}
				TokenType.SEMI_COLON, TokenType.OPEN_BRACE,
				TokenType.CLOSE_BRACE, TokenType.END_OF_FILE -> return false;
			}
		}

		return false;
	}

}
