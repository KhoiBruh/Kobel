mod compiler.parser;

use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;

/*
 * ============================================================================
 * compiler.parser — Recursive-descent and Pratt parser state and cursor API
 * ============================================================================
 */

pub struct Parser {
	pub tokens: List<Token>,
	pub current: usz = 0,
	pub arena: Arena = Arena(),
	pub errors: List<Diagnostic> = List(),
	pub struct_consts: List<*AstNode> = List(),
	pub file_id: u32 = 0
}

impl Parser {

	pub init(tokens: List<Token>) {
		var p = Self(tokens);
		if (!tokens.empty()) {
			val first_tok = tokens[0];
			p.file_id = first_tok.span.file_id;
		}
		return p;
	}

	pub fn node(&self, data: NodeData, line: usz = 0, col: usz = 0): *AstNode {
		var n = self.arena.node(data, line, col);
		n.span.file_id = self.file_id;
		return n;
	}

	pub fn node_at(&self, data: NodeData, tok: Token): *AstNode {
		var n = self.arena.node(data, tok.line, tok.col);
		n.span = tok.span;
		return n;
	}

	pub fn is_end(*self): bool {
		if (self.current >= self.tokens.len) return true;
		val tok = self.tokens[self.current];
		return tok.type == TokenType.END_OF_FILE;
	}

	pub fn peek(*self) =>
		if (self.current >= self.tokens.len) self.tokens.last()
		else self.tokens[self.current];

	// Token `offset` positions ahead of the cursor (0 == peek), clamped to the end.
	pub fn peek_at(*self, offset: usz): Token {
		val idx = self.current + offset;
		if (idx >= self.tokens.len) return self.tokens.last();
		return self.tokens[idx];
	}

	pub fn previous(*self) =>
		if (self.current == 0) self.tokens.first()
		else self.tokens[self.current - 1];

	pub fn advance(&self): Token {
		if (!self.is_end()) self.current++;
		return self.previous();
	}

	pub fn check(*self, t: TokenType): bool {
		if (self.is_end()) return false;
		val tok = self.peek();
		return tok.type == t;
	}

	pub fn match_token(&self, t: TokenType): bool {
		if (self.check(t)) {
			self.advance();
			return true;
		}
		return false;
	}

	// Record a parse error at the token's span; the loader fills in the file path.
	pub fn error(&self, tok: Token, msg: str) {
		val span = Span(
			self.file_id, tok.line as u32, tok.col as u32,
			if (tok.span.length > 0) tok.span.length else 1
		);
		self.errors += Diagnostic(Severity.ERROR, span, "", msg, "");
	}

	pub fn consume(&self, t: TokenType, msg: str): Token {
		if (self.check(t)) return self.advance();
		if (t == TokenType.IDENTIFIER && self.check(TokenType.KW_OP)) return self.advance();
		val tok = self.peek();
		self.error(tok, msg);
		return tok;
	}

	pub fn synchronize(&self) {
		self.advance();

		while (!self.is_end()) {
			val prev = self.previous();
			if (prev.type == TokenType.SEMI_COLON) return;

			val cur = self.peek();
			when (cur.type) {
				TokenType.KW_FN, TokenType.KW_STRUCT,
				TokenType.KW_VAL, TokenType.KW_VAR,
				TokenType.KW_IF, TokenType.KW_WHEN,
				TokenType.KW_WHILE, TokenType.KW_FOR,
				TokenType.KW_RETURN, TokenType.KW_PUB,
				TokenType.KW_MOD, TokenType.KW_USE,
				TokenType.KW_ENUM, TokenType.KW_TRAIT,
				TokenType.KW_IMPL, TokenType.KW_EXTERN -> return;
				else -> self.advance();
			}
		}
	}

	// Check whether the token at `idx` is `{ [params] -> ... }` (a lambda block).
	pub fn is_lambda_brace_at(*self, idx: usz): bool {
		if (idx >= self.tokens.len) return false;
		val open_tok = self.tokens[idx];
		if (open_tok.type != TokenType.OPEN_BRACE) return false;

		var cur = idx + 1;
		if (cur >= self.tokens.len) return false;
		val first_tok = self.tokens[cur];
		if (first_tok.type == TokenType.ARROW) return true;

		while (cur < self.tokens.len) {
			val p_tok = self.tokens[cur];
			if (
				p_tok.type == TokenType.KW_VAR
				|| p_tok.type == TokenType.KW_VAL
			) cur++;
			if (cur >= self.tokens.len) return false;
			val id_tok = self.tokens[cur];
			if (id_tok.type != TokenType.IDENTIFIER) return false;
			cur++;

			if (cur < self.tokens.len && self.tokens[cur].type == TokenType.COLON) {
				cur++;
				var depth = 0;
				while (cur < self.tokens.len) {
					val t_tok = self.tokens[cur];
					if (
						depth == 0
						&& (t_tok.type == TokenType.COMMA || t_tok.type == TokenType.ARROW)
					) break;
					when (t_tok.type) {
						TokenType.LESS, TokenType.OPEN_PAREN,
						TokenType.OPEN_BRACKET -> depth++;
						TokenType.GREATER, TokenType.CLOSE_PAREN,
						TokenType.CLOSE_BRACKET -> {
							if (depth == 0) return false;
							depth--;
						}
						TokenType.SEMI_COLON, TokenType.OPEN_BRACE,
						TokenType.CLOSE_BRACE, TokenType.END_OF_FILE -> return false;
					}
					cur++;
				}
			}

			if (cur >= self.tokens.len) return false;
			val sep_tok = self.tokens[cur];
			if (sep_tok.type == TokenType.ARROW) return true;
			if (sep_tok.type == TokenType.COMMA) {
				cur++;
				continue;
			}
			return false;
		}
		return false;
	}

	pub fn is_lambda_brace_ahead(*self): bool => self.is_lambda_brace_at(self.current);

	// Check whether the position after '<' looks like type arguments ending with '>(' or '> {'
	pub fn is_generic_args_ahead(*self): bool {
		if (!self.check(TokenType.LESS)) return false;

		var depth = 1;
		for (i in (self.current + 1)..<self.tokens.len) {
			val tok = self.tokens[i];
			when (tok.type) {
				TokenType.LESS -> depth++;
				TokenType.GREATER -> {
					depth--;
					if (depth == 0) {
						if (i + 1 >= self.tokens.len) return false;
						val next_t = self.tokens[i + 1].type;
						if (next_t == TokenType.OPEN_PAREN) return true;
						if (next_t == TokenType.OPEN_BRACE) return self.is_lambda_brace_at(i + 1);
						return false;
					}
				}
				TokenType.SEMI_COLON, TokenType.OPEN_BRACE,
				TokenType.CLOSE_BRACE, TokenType.END_OF_FILE -> return false;
			}
		}
		return false;
	}

}
