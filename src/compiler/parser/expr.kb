mod compiler.parser.expr;

use compiler.lexer.token.*;
use compiler.lexer.lexer.*;

use compiler.ast.node.AstNode;
use compiler.ast.expr.*;
use compiler.ast.builder.*;

use compiler.parser.parser.*;
use compiler.parser.types.parse_type;

use std.collections.list.*;

// ============================================================================
// Operator Precedence Levels
// ============================================================================

pub const PREC_NONE: i32 = 0;
pub const PREC_ASSIGN: i32 = 1;       // =
pub const PREC_OR: i32 = 2;           // ||
pub const PREC_AND: i32 = 3;          // &&
pub const PREC_EQUALITY: i32 = 4;     // ==, !=
pub const PREC_COMPARISON: i32 = 5;   // <, <=, >, >=
pub const PREC_TERM: i32 = 6;         // +, -
pub const PREC_FACTOR: i32 = 7;       // *, /, %
pub const PREC_UNARY: i32 = 8;        // -, !, *, &, as
pub const PREC_CALL: i32 = 9;         // ., (), [], <args>()
pub const PREC_PRIMARY: i32 = 10;

// Whether a NUMBER token holds a float: the lexer scans the fractional part
// into the same token, so a '.' in the text marks a float literal. Hex/binary
// literals and suffixes never contain one.
pub fn num_literal_is_float(text: str): bool {
	for (c in text) {
		if (c == '.') return true;
	}
	return false;
}

pub fn get_infix_precedence(var self: &Parser, t: TokenType): i32 {
	when (t) {
		TokenType.EQUAL -> return PREC_ASSIGN;
		TokenType.OR_OR -> return PREC_OR;
		TokenType.AND_AND -> return PREC_AND;
		TokenType.EQUAL_EQUAL,
		TokenType.BANG_EQUAL -> return PREC_EQUALITY;
		TokenType.LESS_EQUAL,
		TokenType.GREATER,
		TokenType.GREATER_EQUAL -> return PREC_COMPARISON;
		TokenType.LESS -> {
			if (is_generic_args_ahead(self)) return PREC_CALL;
			return PREC_COMPARISON;
		}
		TokenType.PLUS,
		TokenType.MINUS -> return PREC_TERM;
		TokenType.STAR,
		TokenType.SLASH,
		TokenType.PERCENT -> return PREC_FACTOR;
		TokenType.KW_AS -> return PREC_UNARY;
		TokenType.DOT,
		TokenType.OPEN_PAREN,
		TokenType.OPEN_BRACKET -> return PREC_CALL;
		else -> return PREC_NONE;
	}
}

// ============================================================================
// Pratt Expression Parser
// ============================================================================

pub fn parse_prefix(var self: &Parser): *AstNode {
	val tok = advance(self);
	val line = tok.line;
	val col = tok.col;

	// Literals
	when (tok.type) {
		// A number token keeps its fractional part, so a '.' in the text means
		// the literal is a float (types are decided here, not by the lexer).
		TokenType.NUMBER -> {
			if (num_literal_is_float(tok.text)) return alloc_literal(&self.arena, LiteralKind.FLOAT, tok.text, line, col);
			return alloc_literal(&self.arena, LiteralKind.INT, tok.text, line, col);
		}
		TokenType.STRING -> return parse_string_literal(self, tok, line, col);
		TokenType.CHAR -> return alloc_literal(&self.arena, LiteralKind.CHAR, tok.text, line, col);
		TokenType.KW_TRUE -> return alloc_literal(&self.arena, LiteralKind.BOOL, "true", line, col);
		TokenType.KW_FALSE -> return alloc_literal(&self.arena, LiteralKind.BOOL, "false", line, col);
		TokenType.KW_NULL -> return alloc_literal(&self.arena, LiteralKind.NULL_VAL, "null", line, col);
		TokenType.IDENTIFIER -> return alloc_identifier(&self.arena, tok.text, line, col);

		// Grouping: (expr)
		TokenType.OPEN_PAREN -> {
			val inner = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after grouping expression");
			return alloc_group(&self.arena, inner, line, col);
		}

		// Array Literal: [a, b, c]
		TokenType.OPEN_BRACKET -> {
			var elements = List<*AstNode>();
			if (!check(self, TokenType.CLOSE_BRACKET)) {
				elements.add(parse_expression(self, PREC_NONE));
				while (match_token(self, TokenType.COMMA)) {
					if (check(self, TokenType.CLOSE_BRACKET)) {
						break;
					}
					elements.add(parse_expression(self, PREC_NONE));
				}
			}
			consume(self, TokenType.CLOSE_BRACKET, "Expected ']' after array literal");
			return alloc_array_literal(&self.arena, elements, line, col);
		}

		// Prefix Unary: -, !, *, &
		TokenType.MINUS,
		TokenType.BANG,
		TokenType.STAR,
		TokenType.AMPERSAND -> {
			val operand = parse_expression(self, PREC_UNARY);
			return alloc_unary(&self.arena, tok.type, operand, line, col);
		}

		// If Expression: if (cond) then_expr else else_expr
		TokenType.KW_IF -> {
			consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'if'");
			val condition = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after if condition");
			val then_branch = parse_if_expr_branch(self);
			consume(self, TokenType.KW_ELSE, "Expected 'else' in if expression");
			val else_branch = parse_if_expr_branch(self);
			return alloc_if_expr(&self.arena, condition, then_branch, else_branch, line, col);
		}

		// When Expression: when (cond) { val1 -> expr1, else -> expr2 }
		TokenType.KW_WHEN -> {
			// `when (cond) { ... }` or the boolean form `when { cond -> ... }`.
			var condition: *AstNode = null;
			if (match_token(self, TokenType.OPEN_PAREN)) {
				condition = parse_expression(self, PREC_NONE);
				consume(self, TokenType.CLOSE_PAREN, "Expected ')' after when condition");
			}
			consume(self, TokenType.OPEN_BRACE, "Expected '{' before when arms");

			var arms = List<WhenArm>();
			while (!check(self, TokenType.CLOSE_BRACE) && !is_end(self)) {
				val arm_line = peek(self).line;
				val arm_col = peek(self).col;
				var is_else = false;
				var patterns = List<*AstNode>();

				if (match_token(self, TokenType.KW_ELSE)) {
					is_else = true;
				} else {
					patterns.add(parse_expression(self, PREC_NONE));
					while (match_token(self, TokenType.COMMA)) {
						patterns.add(parse_expression(self, PREC_NONE));
					}
				}

				consume(self, TokenType.ARROW, "Expected '->' after when arm pattern");
				val body = parse_expression(self, PREC_NONE);
				arms.add(WhenArm(patterns, is_else, body, arm_line, arm_col));

				match_token(self, TokenType.COMMA);
				match_token(self, TokenType.SEMI_COLON);
			}

			consume(self, TokenType.CLOSE_BRACE, "Expected '}' after when arms");
			return alloc_when_expr(&self.arena, condition, arms, line, col);
		}

		else -> {
			error(self, tok, "Expected expression");
			return alloc_identifier(&self.arena, "<error>", line, col);
		}
	}
}

pub fn parse_infix(var self: &Parser, left: *AstNode, prec: i32): *AstNode {
	val tok = peek(self);
	val line = tok.line;
	val col = tok.col;

	// 1. Assignment: left = right (right-associative)
	if (match_token(self, TokenType.EQUAL)) {
		val right = parse_expression(self, PREC_ASSIGN - 1);
		return alloc_assign(&self.arena, left, right, line, col);
	}

	// 2. Member Access: left.member
	if (match_token(self, TokenType.DOT)) {
		val member_tok = consume(self, TokenType.IDENTIFIER, "Expected identifier after '.'");
		return alloc_member(&self.arena, left, member_tok.text, line, col);
	}

	// 3. Index Access: left[index]
	if (match_token(self, TokenType.OPEN_BRACKET)) {
		val index = parse_expression(self, PREC_NONE);
		consume(self, TokenType.CLOSE_BRACKET, "Expected ']' after array index");
		return alloc_index(&self.arena, left, index, line, col);
	}

	// 4. Type Cast: left as Type
	if (match_token(self, TokenType.KW_AS)) {
		val target_type = parse_type(self);
		return alloc_cast(&self.arena, left, target_type, line, col);
	}

	// 5. Generic Call: left<T1, T2>(arg1, arg2)
	if (check(self, TokenType.LESS) && is_generic_args_ahead(self)) {
		advance(self); // consume '<'
		var type_args = List<*AstNode>();
		type_args.add(parse_type(self));
		while (match_token(self, TokenType.COMMA)) {
			type_args.add(parse_type(self));
		}
		consume(self, TokenType.GREATER, "Expected '>' after generic call type arguments");

		consume(self, TokenType.OPEN_PAREN, "Expected '(' after generic type arguments");
		var args = List<*AstNode>();
		if (!check(self, TokenType.CLOSE_PAREN)) {
			args.add(parse_expression(self, PREC_NONE));
			while (match_token(self, TokenType.COMMA)) {
				args.add(parse_expression(self, PREC_NONE));
			}
		}
		consume(self, TokenType.CLOSE_PAREN, "Expected ')' after function arguments");
		return alloc_call(&self.arena, left, args, type_args, line, col);
	}

	// 6. Normal Call: left(arg1, arg2)
	if (match_token(self, TokenType.OPEN_PAREN)) {
		var args = List<*AstNode>();
		if (!check(self, TokenType.CLOSE_PAREN)) {
			args.add(parse_expression(self, PREC_NONE));
			while (match_token(self, TokenType.COMMA)) {
				args.add(parse_expression(self, PREC_NONE));
			}
		}
		consume(self, TokenType.CLOSE_PAREN, "Expected ')' after function arguments");
		return alloc_call(&self.arena, left, args, List<*AstNode>(), line, col);
	}

	// 7. Binary Operators: +, -, *, /, %, ==, !=, <, <=, >, >=, &&, ||
	val op_tok = advance(self);
	val right = parse_expression(self, prec);
	return alloc_binary(&self.arena, op_tok.type, left, right, line, col);
}

pub fn parse_expression(var self: &Parser, min_prec: i32): *AstNode {
	var left = parse_prefix(self);

	while (!is_end(self)) {
		val next_tok = peek(self);
		val prec = get_infix_precedence(self, next_tok.type);
		if (prec <= min_prec) {
			break;
		}
		left = parse_infix(self, left, prec);
	}

	return left;
}

// Branch of an if expression: either a plain expression or a `{ expr }` block.
pub fn parse_if_expr_branch(var self: &Parser): *AstNode {
	if (match_token(self, TokenType.OPEN_BRACE)) {
		val e = parse_expression(self, PREC_NONE);
		consume(self, TokenType.CLOSE_BRACE, "Expected '}' after if expression branch");
		return e;
	}
	return parse_expression(self, PREC_NONE);
}

// ============================================================================
// String interpolation
//
// A string token whose text holds an unescaped `${` is split into literal
// chunks and hole expressions. Each hole is parsed with a fresh lexer/parser
// over its own text, so it may contain any expression (calls, member access,
// nested plain strings, ...).
// ============================================================================

// True when the raw token text (quotes included) contains an unescaped `${`.
pub fn str_has_hole(text: str): bool {
	var i: usz = 0;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i = i + 2;
			continue;
		}
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') return true;
		i = i + 1;
	}
	return false;
}

pub fn parse_string_literal(var self: &Parser, tok: Token, line: usz, col: usz): *AstNode {
	if (str_has_hole(tok.text)) return parse_interp_string(self, tok.text, line, col);
	return alloc_literal(&self.arena, LiteralKind.STRING, normalize_esc_dollar(tok.text), line, col);
}

// `\$` means a literal '$' in any string literal. The parser rewrites it so the
// C backend never sees the invalid escape `\$` (plain strings included).
pub fn str_has_esc_dollar(text: str): bool {
	var i: usz = 0;
	while (i + 1 < text.len) {
		if (text[i] == '\\' && text[i + 1] == '$') return true;
		i = i + 1;
	}
	return false;
}

pub fn normalize_esc_dollar(text: str): str {
	if (!str_has_esc_dollar(text)) return text;
	var out = "";
	var i: usz = 0;
	while (i < text.len) {
		if (text[i] == '\\' && i + 1 < text.len && text[i + 1] == '$') {
			out = out + "$";
			i = i + 2;
			continue;
		}
		out = out + text.slice(i, i + 1);
		i = i + 1;
	}
	return out;
}

// Index of the '}' closing a `${` hole whose body starts at `start`, or -1.
pub fn interp_find_close(text: str, start: usz): isz {
	var depth: i32 = 1;
	var i = start;
	while (i < text.len) {
		val c = text[i];
		if (c == '{') {
			depth = depth + 1;
			i = i + 1;
			continue;
		}
		if (c == '}') {
			depth = depth - 1;
			if (depth == 0) return i;
			i = i + 1;
			continue;
		}
		if (c == '"') {
			i = interp_skip_quoted(text, i);
			continue;
		}
		if (c == '\'') {
			i = interp_skip_char_lit(text, i);
			continue;
		}
		i = i + 1;
	}
	return -1;
}

// Skips a "..." literal inside a hole (it may itself contain `${...}`).
pub fn interp_skip_quoted(text: str, start: usz): usz {
	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i = i + 2;
			continue;
		}
		if (c == '"') return i + 1;
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') {
			val e = interp_find_close(text, i + 2);
			if (e < 0) return text.len;
			i = e + 1;
			continue;
		}
		i = i + 1;
	}
	return text.len;
}

// Skips a '...' literal inside a hole.
pub fn interp_skip_char_lit(text: str, start: usz): usz {
	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i = i + 2;
			continue;
		}
		if (c == '\'') return i + 1;
		i = i + 1;
	}
	return text.len;
}

pub fn parse_interp_string(var self: &Parser, text: str, line: usz, col: usz): *AstNode {
	var parts = List<InterpPart>();
	val end = text.len - 1;   // index of the closing quote
	var i: usz = 1;           // skip the opening quote
	var lit = "";
	var has_lit = false;

	while (i < end) {
		val c = text[i];
		if (c == '\\') {
			// `\$` is a literal '$'; every other escape is kept verbatim.
			if (i + 1 < end && text[i + 1] == '$') lit = lit + "$";
			else lit = lit + text.slice(i, i + 2);
			has_lit = true;
			i = i + 2;
			continue;
		}
		if (c == '$' && i + 1 < end && text[i + 1] == '{') {
			if (has_lit) {
				parts.add(InterpPart(alloc_literal(&self.arena, LiteralKind.STRING, "\"" + lit + "\"", line, col), true));
				lit = "";
				has_lit = false;
			}
			val h_start = i + 2;
			val h_end = interp_find_close(text, h_start);
			if (h_end < 0) {
				self.errors.add("Unterminated interpolation hole in string literal");
				return alloc_literal(&self.arena, LiteralKind.STRING, text, line, col);
			}
			val src = text.slice(h_start, h_end);
			var sub_lexer = new_lexer(src);
			val sub_tokens = sub_lexer.tokenize();
			var sub = new_parser(sub_tokens);
			val hole = parse_expression(&sub, PREC_NONE);
			if (sub.errors.len > 0) {
				for (msg in sub.errors) self.errors.add("in interpolation hole: " + msg);
			}
			parts.add(InterpPart(hole, false));
			i = h_end + 1;
			continue;
		}
		lit = lit + text.slice(i, i + 1);
		has_lit = true;
		i = i + 1;
	}

	if (has_lit) parts.add(InterpPart(alloc_literal(&self.arena, LiteralKind.STRING, "\"" + lit + "\"", line, col), true));
	return alloc_interp(&self.arena, parts, line, col);
}
