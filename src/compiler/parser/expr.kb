mod compiler.parser.expr;

use compiler.lexer.token.*;
use compiler.lexer.lexer.*;

use compiler.ast.node.AstNode;
use compiler.ast.expr.*;
use compiler.ast.builder.*;

use compiler.parser.parser.*;
use compiler.parser.types.parse_type;

use std.collections.list.*;

// ============================================================================
// Operator Precedence Levels
// ============================================================================

pub const PREC_NONE: i32 = 0;
pub const PREC_ASSIGN: i32 = 1;       // =
pub const PREC_ELVIS: i32 = 2;        // ?:
pub const PREC_OR: i32 = 3;           // ||
pub const PREC_AND: i32 = 4;          // &&
pub const PREC_EQUALITY: i32 = 5;     // ==, !=
pub const PREC_COMPARISON: i32 = 6;   // <, <=, >, >=
pub const PREC_TERM: i32 = 7;         // +, -
pub const PREC_FACTOR: i32 = 8;       // *, /, %
pub const PREC_UNARY: i32 = 9;        // -, !, *, &, as
pub const PREC_CALL: i32 = 10;        // ., (), [], <args>()
pub const PREC_PRIMARY: i32 = 11;

// Whether a NUMBER token holds a float: the lexer scans the fractional part
// into the same token, so a '.' in the text marks a float literal. Hex/binary
// literals and suffixes never contain one.
pub fn num_literal_is_float(text: str): bool {
	for (c in text) {
		if (c == '.') return true;
	}
	return false;
}

pub fn get_infix_precedence(var self: &Parser, t: TokenType): i32 {
	when (t) {
		TokenType.EQUAL,
		TokenType.PLUS_EQUAL,
		TokenType.MINUS_EQUAL,
		TokenType.STAR_EQUAL,
		TokenType.SLASH_EQUAL,
		TokenType.PERCENT_EQUAL -> return PREC_ASSIGN;
		TokenType.QUESTION_COLON -> return PREC_ELVIS;
		TokenType.OR_OR -> return PREC_OR;
		TokenType.AND_AND -> return PREC_AND;
		TokenType.EQUAL_EQUAL,
		TokenType.BANG_EQUAL -> return PREC_EQUALITY;
		TokenType.LESS_EQUAL,
		TokenType.GREATER,
		TokenType.GREATER_EQUAL -> return PREC_COMPARISON;
		TokenType.LESS -> {
			if (is_generic_args_ahead(self)) return PREC_CALL;
			return PREC_COMPARISON;
		}
		TokenType.PLUS,
		TokenType.MINUS -> return PREC_TERM;
		TokenType.STAR,
		TokenType.SLASH,
		TokenType.PERCENT -> return PREC_FACTOR;
		TokenType.KW_AS -> return PREC_UNARY;
		TokenType.DOT,
		TokenType.OPEN_PAREN,
		TokenType.OPEN_BRACKET -> return PREC_CALL;
		else -> return PREC_NONE;
	}
}

// ============================================================================
// Pratt Expression Parser
// ============================================================================

pub fn parse_prefix(var self: &Parser): *AstNode {
	val tok = advance(self);
	val line = tok.line;
	val col = tok.col;

	// Literals
	when (tok.type) {
		// A number token keeps its fractional part, so a '.' in the text means
		// the literal is a float (types are decided here, not by the lexer).
		TokenType.NUMBER -> {
			if (num_literal_is_float(tok.text)) return self.b().literal(LiteralKind.FLOAT, tok.text, line, col);
			return self.b().literal(LiteralKind.INT, tok.text, line, col);
		}
		TokenType.STRING -> return parse_string_literal(self, tok, line, col);
		TokenType.CHAR -> return self.b().literal(LiteralKind.CHAR, tok.text, line, col);
		TokenType.KW_TRUE -> return self.b().literal(LiteralKind.BOOL, "true", line, col);
		TokenType.KW_FALSE -> return self.b().literal(LiteralKind.BOOL, "false", line, col);
		TokenType.KW_NULL -> return self.b().literal(LiteralKind.NULL_VAL, "null", line, col);
		TokenType.IDENTIFIER -> return self.b().identifier(tok.text, line, col);

		// Grouping: (expr)
		TokenType.OPEN_PAREN -> {
			val inner = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after grouping expression");
			return self.b().group(inner, line, col);
		}

		// Array Literal: [a, b, c]
		TokenType.OPEN_BRACKET -> {
			var elements = List<*AstNode>();
			if (!check(self, TokenType.CLOSE_BRACKET)) {
				elements.add(parse_expression(self, PREC_NONE));
				while (match_token(self, TokenType.COMMA)) {
					if (check(self, TokenType.CLOSE_BRACKET)) {
						break;
					}
					elements.add(parse_expression(self, PREC_NONE));
				}
			}
			consume(self, TokenType.CLOSE_BRACKET, "Expected ']' after array literal");
			return self.b().array_literal(elements, line, col);
		}

		// Prefix Unary: -, !, *, &
		TokenType.MINUS,
		TokenType.BANG,
		TokenType.STAR,
		TokenType.AMPERSAND -> {
			val operand = parse_expression(self, PREC_UNARY);
			return self.b().unary(tok.type, operand, line, col);
		}

		// If Expression: if (cond) then_expr else else_expr
		TokenType.KW_IF -> {
			consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'if'");
			val condition = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after if condition");
			val then_branch = parse_if_expr_branch(self);
			consume(self, TokenType.KW_ELSE, "Expected 'else' in if expression");
			val else_branch = parse_if_expr_branch(self);
			return self.b().if_expr(condition, then_branch, else_branch, line, col);
		}

		// When Expression: when (cond) { val1 -> expr1, else -> expr2 }
		TokenType.KW_WHEN -> {
			// `when (cond) { ... }` or the boolean form `when { cond -> ... }`.
			var condition: *AstNode = null;
			if (match_token(self, TokenType.OPEN_PAREN)) {
				condition = parse_expression(self, PREC_NONE);
				consume(self, TokenType.CLOSE_PAREN, "Expected ')' after when condition");
			}
			consume(self, TokenType.OPEN_BRACE, "Expected '{' before when arms");

			var arms = List<WhenArm>();
			while (!check(self, TokenType.CLOSE_BRACE) && !is_end(self)) {
				val arm_line = peek(self).line;
				val arm_col = peek(self).col;
				var is_else = false;
				var patterns = List<*AstNode>();

				if (match_token(self, TokenType.KW_ELSE)) {
					is_else = true;
				} else {
					patterns.add(parse_expression(self, PREC_NONE));
					while (match_token(self, TokenType.COMMA)) {
						patterns.add(parse_expression(self, PREC_NONE));
					}
				}

				consume(self, TokenType.ARROW, "Expected '->' after when arm pattern");
				var body: *AstNode = null;
				if (check(self, TokenType.OPEN_BRACE)) {
					body = parse_arm_block(self);
				} else {
					body = parse_expression(self, PREC_NONE);
				}
				arms.add(WhenArm(patterns, is_else, body, arm_line, arm_col));

				match_token(self, TokenType.COMMA);
				match_token(self, TokenType.SEMI_COLON);
			}

			consume(self, TokenType.CLOSE_BRACE, "Expected '}' after when arms");
			return self.b().when_expr(condition, arms, line, col);
		}

		else -> {
			error(self, tok, "Expected expression");
			return self.b().identifier("<error>", line, col);
		}
	}
}

pub fn parse_infix(var self: &Parser, left: *AstNode, prec: i32): *AstNode {
	val tok = peek(self);
	val line = tok.line;
	val col = tok.col;

	// 1. Assignment: left = right, left += right, ... (right-associative)
	when (tok.type) {
		TokenType.EQUAL,
		TokenType.PLUS_EQUAL,
		TokenType.MINUS_EQUAL,
		TokenType.STAR_EQUAL,
		TokenType.SLASH_EQUAL,
		TokenType.PERCENT_EQUAL -> {
			val op_tok = advance(self);
			val right = parse_expression(self, PREC_ASSIGN - 1);
			return self.b().compound_assign(op_tok.type, left, right, line, col);
		}
		else -> {}
	}

	// 2. Elvis operator: left ?: right (right can be expression or jump statement)
	if (match_token(self, TokenType.QUESTION_COLON)) {
		var right: *AstNode = null;
		if (match_token(self, TokenType.KW_RETURN)) {
			val kw_line = previous(self).line;
			val kw_col = previous(self).col;
			var value: *AstNode = null;
			if (!check(self, TokenType.SEMI_COLON) && !check(self, TokenType.CLOSE_BRACE) && !check(self, TokenType.CLOSE_PAREN)) {
				value = parse_expression(self, PREC_NONE);
			}
			right = self.b().return_stmt(value, kw_line, kw_col);
		} else if (match_token(self, TokenType.KW_BREAK)) {
			val kw_line = previous(self).line;
			val kw_col = previous(self).col;
			right = self.b().break_stmt(kw_line, kw_col);
		} else if (match_token(self, TokenType.KW_CONTINUE)) {
			val kw_line = previous(self).line;
			val kw_col = previous(self).col;
			right = self.b().continue_stmt(kw_line, kw_col);
		} else {
			right = parse_expression(self, PREC_ELVIS - 1);
		}
		return self.b().binary(TokenType.QUESTION_COLON, left, right, line, col);
	}

	// 3. Member Access: left.member
	if (match_token(self, TokenType.DOT)) {
		val member_tok = consume(self, TokenType.IDENTIFIER, "Expected identifier after '.'");
		return self.b().member(left, member_tok.text, line, col);
	}

	// 3. Index Access: left[index]
	if (match_token(self, TokenType.OPEN_BRACKET)) {
		val index = parse_expression(self, PREC_NONE);
		consume(self, TokenType.CLOSE_BRACKET, "Expected ']' after array index");
		return self.b().index(left, index, line, col);
	}

	// 4. Type Cast: left as Type
	if (match_token(self, TokenType.KW_AS)) {
		val target_type = parse_type(self);
		return self.b().cast(left, target_type, line, col);
	}

	// 5. Generic Call: left<T1, T2>(arg1, arg2)
	if (check(self, TokenType.LESS) && is_generic_args_ahead(self)) {
		advance(self); // consume '<'
		var type_args = List<*AstNode>();
		type_args.add(parse_type(self));
		while (match_token(self, TokenType.COMMA)) {
			type_args.add(parse_type(self));
		}
		consume(self, TokenType.GREATER, "Expected '>' after generic call type arguments");

		consume(self, TokenType.OPEN_PAREN, "Expected '(' after generic type arguments");
		var args = List<*AstNode>();
		if (!check(self, TokenType.CLOSE_PAREN)) {
			args.add(parse_expression(self, PREC_NONE));
			while (match_token(self, TokenType.COMMA)) {
				args.add(parse_expression(self, PREC_NONE));
			}
		}
		consume(self, TokenType.CLOSE_PAREN, "Expected ')' after function arguments");
		return self.b().call(left, args, type_args, line, col);
	}

	// 6. Normal Call: left(arg1, arg2)
	if (match_token(self, TokenType.OPEN_PAREN)) {
		var args = List<*AstNode>();
		if (!check(self, TokenType.CLOSE_PAREN)) {
			args.add(parse_expression(self, PREC_NONE));
			while (match_token(self, TokenType.COMMA)) {
				args.add(parse_expression(self, PREC_NONE));
			}
		}
		consume(self, TokenType.CLOSE_PAREN, "Expected ')' after function arguments");
		return self.b().call(left, args, List<*AstNode>(), line, col);
	}

	// 7. Binary Operators: +, -, *, /, %, ==, !=, <, <=, >, >=, &&, ||
	val op_tok = advance(self);
	val right = parse_expression(self, prec);
	return self.b().binary(op_tok.type, left, right, line, col);
}

pub fn parse_expression(var self: &Parser, min_prec: i32): *AstNode {
	var left = parse_prefix(self);

	while (!is_end(self)) {
		val next_tok = peek(self);
		val prec = get_infix_precedence(self, next_tok.type);
		if (prec <= min_prec) {
			break;
		}
		left = parse_infix(self, left, prec);
	}

	return left;
}

// Branch of an if expression: either a plain expression or a `{ expr }` block.
pub fn parse_if_expr_branch(var self: &Parser): *AstNode {
	if (match_token(self, TokenType.OPEN_BRACE)) {
		val e = parse_expression(self, PREC_NONE);
		consume(self, TokenType.CLOSE_BRACE, "Expected '}' after if expression branch");
		return e;
	}
	return parse_expression(self, PREC_NONE);
}

pub fn parse_arm_statement(var self: &Parser): *AstNode {
	val tok = peek(self);
	val line = tok.line;
	val col = tok.col;

	return when (tok.type) {
		TokenType.OPEN_BRACE -> parse_arm_block(self);
		TokenType.KW_VAL, TokenType.KW_VAR -> {
			advance(self);
			val is_mut = tok.type == TokenType.KW_VAR;
			val id_tok = consume(self, TokenType.IDENTIFIER, "Expected variable name");
			val ty_node = if (match_token(self, TokenType.COLON)) parse_type(self) else null;
			val init_node = if (match_token(self, TokenType.EQUAL)) parse_expression(self, PREC_NONE)
			else null;

			consume(self, TokenType.SEMI_COLON, "Expected ';' after variable declaration");

			yield self.b().var_decl(is_mut, id_tok.text, ty_node, init_node, line, col);
		}
		TokenType.KW_IF -> {
			advance(self);
			consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'if'");
			val condition = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after if condition");
			val then_branch = parse_arm_statement(self);
			val else_branch = if (match_token(self, TokenType.KW_ELSE)) parse_arm_statement(self) else null;

			yield self.b().if_stmt(condition, then_branch, else_branch, line, col);
		}
		TokenType.KW_WHILE -> {
			val kw = advance(self);
			consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'while'");
			val condition = parse_expression(self, PREC_NONE);
			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after while condition");
			val body = parse_arm_statement(self);

			yield self.b().while_stmt(condition, body, kw.line, kw.col);
		}
		TokenType.KW_FOR -> {
			val kw = advance(self);
			consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'for'");
			val name_tok = consume(self, TokenType.IDENTIFIER, "Expected loop variable name");
			consume(self, TokenType.KW_IN, "Expected 'in' after loop variable");

			val first = parse_expression(self, PREC_COMPARISON);

			var is_range = false;
			var is_open = false;
			var is_half_open = false;
			var iterable: *AstNode = null;
			var range_start: *AstNode = null;
			var range_end: *AstNode = null;

			if (match_token(self, TokenType.DOT_DOT)) {
				is_range = true;
				range_start = first;
				if (match_token(self, TokenType.LESS)) is_half_open = true;
				range_end = parse_expression(self, PREC_COMPARISON);
			} else if (check(self, TokenType.GREATER) && peek_at(self, 1).type == TokenType.DOT_DOT) {
				is_range = true;
				is_open = true;
				range_start = first;
				advance(self);
				consume(self, TokenType.DOT_DOT, "Expected '..' in open range");
				consume(self, TokenType.LESS, "Expected '<' to close an open range");
				range_end = parse_expression(self, PREC_COMPARISON);
			} else iterable = first;

			consume(self, TokenType.CLOSE_PAREN, "Expected ')' after for header");
			val body = parse_arm_statement(self);
			yield self.b().for_stmt(
				name_tok.text, is_range, is_open, is_half_open,
				iterable, range_start, range_end, body, kw.line, kw.col
			);
		}
		TokenType.KW_BREAK -> {
			advance(self);
			consume(self, TokenType.SEMI_COLON, "Expected ';' after break");
			yield self.b().break_stmt(line, col);
		}
		TokenType.KW_CONTINUE -> {
			advance(self);
			consume(self, TokenType.SEMI_COLON, "Expected ';' after continue");
			yield self.b().continue_stmt(line, col);
		}
		TokenType.KW_YIELD -> {
			advance(self);
			val value = if (!check(self, TokenType.SEMI_COLON)) parse_expression(self, PREC_NONE) else null;
			consume(self, TokenType.SEMI_COLON, "Expected ';' after yield");
			yield self.b().yield_stmt(value, line, col);
		}
		TokenType.KW_RETURN -> {
			advance(self);
			val value = if (!check(self, TokenType.SEMI_COLON)) parse_expression(self, PREC_NONE) else null;
			consume(self, TokenType.SEMI_COLON, "Expected ';' after return");
			yield self.b().return_stmt(value, line, col);
		}
		else -> {
			val expr = parse_expression(self, PREC_NONE);
			if (match_token(self, TokenType.PLUS_PLUS)) {
				val op_tok = previous(self);
				consume(self, TokenType.SEMI_COLON, "Expected ';' after '++'");
				yield self.b().expr_stmt(self.b().update(TokenType.PLUS_PLUS, expr, op_tok.line, op_tok.col), line, col);
			} else if (match_token(self, TokenType.MINUS_MINUS)) {
				val op_tok = previous(self);
				consume(self, TokenType.SEMI_COLON, "Expected ';' after '--'");
				yield self.b().expr_stmt(self.b().update(TokenType.MINUS_MINUS, expr, op_tok.line, op_tok.col), line, col);
			}
			consume(self, TokenType.SEMI_COLON, "Expected ';' after expression statement");
			yield self.b().expr_stmt(expr, line, col);
		}
	};
}

pub fn parse_arm_block(var self: &Parser): *AstNode {
	val lbrace = consume(self, TokenType.OPEN_BRACE, "Expected '{'");
	var stmts = List<*AstNode>();
	while (!check(self, TokenType.CLOSE_BRACE) && !is_end(self)) {
		stmts.add(parse_arm_statement(self));
	}
	consume(self, TokenType.CLOSE_BRACE, "Expected '}' after block");
	return self.b().block_stmt(stmts, lbrace.line, lbrace.col);
}

// ============================================================================
// String interpolation
//
// A string token whose text holds an unescaped `${` is split into literal
// chunks and hole expressions. Each hole is parsed with a fresh lexer/parser
// over its own text, so it may contain any expression (calls, member access,
// nested plain strings, ...).
// ============================================================================

// True when the raw token text (quotes included) contains an unescaped `${`.
pub fn str_has_hole(text: str): bool {
	var i: usz = 0;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') return true;
		i++;
	}
	return false;
}

pub fn parse_string_literal(var self: &Parser, tok: Token, line: usz, col: usz): *AstNode {
	if (str_has_hole(tok.text)) return parse_interp_string(self, tok.text, line, col);
	return self.b().literal(LiteralKind.STRING, normalize_esc_dollar(tok.text), line, col);
}

// `\$` means a literal '$' in any string literal. The parser rewrites it so the
// C backend never sees the invalid escape `\$` (plain strings included).
pub fn str_has_esc_dollar(text: str): bool {
	if (text.len < 2) return false;
	for (i in 0..<(text.len - 1)) {
		if (text[i] == '\\' && text[i + 1] == '$') return true;
	}
	return false;
}

pub fn normalize_esc_dollar(text: str): str {
	if (!str_has_esc_dollar(text)) return text;
	var out = "";
	var i: usz = 0;
	while (i < text.len) {
		if (text[i] == '\\' && i + 1 < text.len && text[i + 1] == '$') {
			out = "${out}$";
			i += 2;
			continue;
		}
		out = "${out}${text.slice(i, i + 1)}";
		i++;
	}
	return out;
}

// Index of the '}' closing a `${` hole whose body starts at `start`, or -1.
pub fn interp_find_close(text: str, start: usz): isz {
	var depth: i32 = 1;
	var i = start;
	while (i < text.len) {
		val c = text[i];
		if (c == '{') {
			depth++;
			i++;
			continue;
		}
		if (c == '}') {
			depth--;
			if (depth == 0) return i;
			i++;
			continue;
		}
		if (c == '"') {
			i = interp_skip_quoted(text, i);
			continue;
		}
		if (c == '\'') {
			i = interp_skip_char_lit(text, i);
			continue;
		}
		i++;
	}
	return -1;
}

// Skips a "..." literal inside a hole (it may itself contain `${...}`).
pub fn interp_skip_quoted(text: str, start: usz): usz {
	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '"') return i + 1;
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') {
			val e = interp_find_close(text, i + 2);
			if (e < 0) return text.len;
			i = e + 1;
			continue;
		}
		i++;
	}
	return text.len;
}

// Skips a '...' literal inside a hole.
pub fn interp_skip_char_lit(text: str, start: usz): usz {
	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '\'') return i + 1;
		i++;
	}
	return text.len;
}

pub fn parse_interp_string(var self: &Parser, text: str, line: usz, col: usz): *AstNode {
	var parts = List<InterpPart>();
	val end = text.len - 1;   // index of the closing quote
	var i: usz = 1;           // skip the opening quote
	var lit = "";
	var has_lit = false;

	while (i < end) {
		val c = text[i];
		if (c == '\\') {
			// `\$` is a literal '$'; every other escape is kept verbatim.
			if (i + 1 < end && text[i + 1] == '$') lit = "${lit}$";
			else lit = "${lit}${text.slice(i, i + 2)}";
			has_lit = true;
			i += 2;
			continue;
		}
		if (c == '$' && i + 1 < end && text[i + 1] == '{') {
			if (has_lit) {
				parts.add(InterpPart(self.b().literal(LiteralKind.STRING, "\"${lit}\"", line, col), true));
				lit = "";
				has_lit = false;
			}
			val h_start = i + 2;
			val h_end = interp_find_close(text, h_start);
			if (h_end < 0) {
				self.errors.add("Unterminated interpolation hole in string literal");
				return self.b().literal(LiteralKind.STRING, text, line, col);
			}
			val src = text.slice(h_start, h_end);
			var sub_lexer = Lexer(src);
			val sub_tokens = sub_lexer.tokenize();
			var sub = Parser(sub_tokens);
			val hole = parse_expression(&sub, PREC_NONE);
			if (sub.errors.len > 0) {
				for (msg in sub.errors) self.errors.add("in interpolation hole: ${msg}");
			}
			parts.add(InterpPart(hole, false));
			i = h_end + 1;
			continue;
		}
		lit = "${lit}${text.slice(i, i + 1)}";
		has_lit = true;
		i++;
	}

	if (has_lit) parts.add(InterpPart(self.b().literal(LiteralKind.STRING, "\"${lit}\"", line, col), true));
	return self.b().interp(parts, line, col);
}
