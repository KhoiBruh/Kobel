mod compiler.parser;

use std.collections.*;

use compiler.lexer.*;
use compiler.ast.*;

/*
 * ============================================================================
 * compiler.parser.declaration — Module and top-level declaration parsers
 * ============================================================================
 */

impl Parser {

	pub fn is_valid_op_name(*self, name: str) => name in [
		"plus", "minus", "mul", "div", "rem",
		"bit_and", "bit_or", "bit_xor", "shl", "shr",
		"plus_assign", "minus_assign", "mul_assign", "div_assign", "rem_assign",
		"bit_and_assign", "bit_or_assign", "bit_xor_assign", "shl_assign", "shr_assign",
		"get", "set",
		"equals", "compare",
		"negate", "not",
		"contains", "unpack"
	];

	fn parse_trait_bounds(&self): List<str> {
		var bounds = List<str>();
		if (self.match_token(TokenType.COLON)) {
			val b_tok = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
			bounds += b_tok.text;

			while (self.match_token(TokenType.PLUS)) {
				val b2 = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
				bounds += b2.text;
			}
		}

		return bounds;
	}

	pub fn parse_generic_params(&self): List<GenericParam> {
		var params = List<GenericParam>();
		if (!self.match_token(TokenType.LESS)) return params;

		if (!self.check(TokenType.GREATER)) {
			val p_tok = self.consume(TokenType.IDENTIFIER, "Expected generic parameter name");
			params += GenericParam(p_tok.text, self.parse_trait_bounds());

			while (self.match_token(TokenType.COMMA)) {
				val next_p = self.consume(TokenType.IDENTIFIER, "Expected generic parameter name");
				params += GenericParam(next_p.text, self.parse_trait_bounds());
			}
		}

		self.consume(TokenType.GREATER, "Expected '>' after generic parameters");
		return params;
	}

	fn parse_param_list(&self, allow_self: bool, open_msg: str): List<Param> {
		self.consume(TokenType.OPEN_PAREN, open_msg);
		var params = List<Param>();

		if (!self.check(TokenType.CLOSE_PAREN)) {
			var mutable = false;
			var has_val = false;
			var is_prefix_ptr = false;
			when (self) {
				.match_token(TokenType.KW_VAR) -> mutable = true;
				.match_token(TokenType.KW_VAL) -> has_val = true;
				.match_token(TokenType.AMPERSAND) -> {
					mutable = true;
					is_prefix_ptr = true;
				}
				.match_token(TokenType.STAR) -> {
					has_val = true;
					is_prefix_ptr = true;
				}
			}

			val pname = self.consume(TokenType.IDENTIFIER, "Expected parameter name");
			if (is_prefix_ptr && (!allow_self || pname.text != "self")) {
				self.error(pname, "Prefix '*' and '&' are only supported for the 'self' receiver parameter");
			}
			if (pname.text == "self" && !is_prefix_ptr && (mutable || has_val)) {
				self.error(pname, "'val self' and 'var self' are no longer supported; use '*self', '&self', or bare 'self'");
			}
			val ptype = when {
				self.match_token(TokenType.COLON) -> self.parse_type();
				!allow_self || pname.text != "self" -> {
					self.consume(TokenType.COLON, "Expected ':' after parameter name");
					yield self.parse_type();
				}
				else -> null;
			};

			val p_default = if (self.match_token(TokenType.EQUAL)) self.parse_expression(Precedence.NONE) else null;
			params += Param(pname.text, ptype, mutable, has_val, p_default);

			while (self.match_token(TokenType.COMMA)) {
				if (params.last().type_node is VariadicType) {
					self.error(self.peek(), "Variadic parameter '..T' must be the last parameter in the function declaration");
				}
				var p_mutable = false;
				var p_has_val = false;
				when (self) {
					.match_token(TokenType.KW_VAR) -> p_mutable = true;
					.match_token(TokenType.KW_VAL) -> p_has_val = true;
				}

				val p_name = self.consume(TokenType.IDENTIFIER, "Expected parameter name");
				if (allow_self && p_name.text == "self") {
					self.error(p_name, "'self' is only allowed as the first parameter");
				}
				self.consume(TokenType.COLON, "Expected ':' after parameter name");
				val p_type = self.parse_type();

				val p_def = if (self.match_token(TokenType.EQUAL)) self.parse_expression(Precedence.NONE)
				else null;
				params += Param(p_name.text, p_type, p_mutable, p_has_val, p_def);
			}
		}

		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after parameters");
		return params;
	}

	fn parse_callable_body(&self, body_msg: str): ?*AstNode => when (self) {
		.match_token(TokenType.FAT_ARROW) -> {
			val expr = self.parse_expression(Precedence.NONE);
			self.consume(TokenType.SEMI_COLON, "Expected ';' after expression body");
			yield self.node(NodeData.ExprStmt(expr), expr.line, expr.col);
		}

		.check(TokenType.OPEN_BRACE) -> self.parse_block_stmt();

		else -> {
			self.consume(TokenType.SEMI_COLON, body_msg);
			yield null;
		}
	};

	// ============================================================================
	// Top-Level Declarations
	// ============================================================================

	pub fn parse_fn_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'fn'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected function name");
		val type_params = self.parse_generic_params();
		val params = self.parse_param_list(true, "Expected '(' after function name");
		val return_type = if (self.match_token(TokenType.COLON)) self.parse_type() else null;
		val body = self.parse_callable_body("Expected ';' or '{' for function body");
		return self.node(
			NodeData.FnDecl(name_tok.text, type_params, params, return_type, body, public, false, false, ""),
			kw.line, kw.col
		);
	}

	pub fn parse_op_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'op'
		val name_tok = self.peek();
		val op_name = name_tok.text;
		if (!self.is_valid_op_name(op_name)) {
			self.error(name_tok, "Invalid operator name '${op_name}'. Expected one of: plus, minus, mul, div, rem, plus_assign, minus_assign, mul_assign, div_assign, rem_assign, get, set, equals, compare, negate, not, contains, unpack");
		}
		self.advance();

		val type_params = self.parse_generic_params();
		val params = self.parse_param_list(true, "Expected '(' after operator name");
		val return_type = if (self.match_token(TokenType.COLON)) self.parse_type() else null;
		val body = self.parse_callable_body("Expected ';' or '{' for operator body");
		return self.node(
			NodeData.FnDecl(op_name, type_params, params, return_type, body, public, true, false, ""),
			kw.line, kw.col
		);
	}

	pub fn parse_init_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'init'
		val type_params = self.parse_generic_params();
		val params = self.parse_param_list(false, "Expected '(' after 'init'");

		if (self.check(TokenType.COLON)) {
			val col_tok = self.peek();
			self.error(col_tok, "Constructor 'init' cannot declare a return type; it always returns the enclosing type");
			self.advance();
			self.parse_type();
		}

		val return_type = self.node(NodeData.NamedType("Self", List<*AstNode>()), kw.line, kw.col);
		val body = self.parse_callable_body("Expected ';' or '{' for constructor body");
		return self.node(
			NodeData.FnDecl("init", type_params, params, return_type, body, public, false, true, ""),
			kw.line, kw.col
		);
	}

	pub fn parse_struct_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'struct'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected struct name");
		val type_params = self.parse_generic_params();

		// `struct Name;`: an opaque declaration whose definition may follow later.
		if (self.match_token(TokenType.SEMI_COLON)) {
			return self.node(
				NodeData.StructDecl(name_tok.text, type_params, List<StructField>(), public, true, true),
				kw.line, kw.col
			);
		}

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before struct fields");
		var fields = List<StructField>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var f_pub = false;
			if (self.match_token(TokenType.KW_PUB)) f_pub = true;

			if (self.check(TokenType.KW_CONST)) {
				val c_decl = self.parse_const_decl(f_pub);
				if (c_decl is ConstDecl as c) {
					c.name = "${name_tok.text}__${c.name}";
				}
				self.struct_consts += c_decl;
				continue;
			}

			if (self.check(TokenType.KW_OP)) {
				if (self.peek_at(1).type != TokenType.COLON) {
					val tok = self.peek();
					self.error(tok, "Operators must be defined inside an 'impl' block, not directly inside 'struct'");
					self.advance();
					continue;
				}
			} else if (!self.check(TokenType.IDENTIFIER)) {
				val tok = self.peek();
				self.error(tok, "Expected field name in struct declaration");
				self.advance();
				continue;
			}

			val fname = self.consume(TokenType.IDENTIFIER, "Expected field name");
			self.consume(TokenType.COLON, "Expected ':' after field name");
			val ftype = self.parse_type();
			val f_default = if (self.match_token(TokenType.EQUAL)) self.parse_expression(Precedence.NONE)
			else null;
			fields += StructField(fname.text, ftype, f_pub, f_default);

			self.match_token(TokenType.COMMA);
			self.match_token(TokenType.SEMI_COLON);
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after struct fields");
		return self.node(
			NodeData.StructDecl(name_tok.text, type_params, fields, public, false, true),
			kw.line, kw.col
		);
	}

	pub fn parse_trait_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'trait'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected trait name");
		val type_params = self.parse_generic_params();

		var bases = List<str>();
		if (self.match_token(TokenType.COLON)) {
			val base1 = self.consume(TokenType.IDENTIFIER, "Expected base trait name");
			bases += base1.text;
			while (self.match_token(TokenType.PLUS)) {
				val next_base = self.consume(TokenType.IDENTIFIER, "Expected base trait name");
				bases += next_base.text;
			}
		}

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before trait body");
		var methods = List<*AstNode>();
		var assoc = List<str>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var m_pub = false;

			when (self) {
				.match_token(TokenType.KW_PUB) -> m_pub = true;
				.check(TokenType.IDENTIFIER) && .peek().text == "type" -> {
					self.advance(); // 'type'
					val a_name = self.consume(TokenType.IDENTIFIER, "Expected associated type name");
					self.consume(TokenType.SEMI_COLON, "Expected ';' after associated type");
					assoc += a_name.text;
				}
				.check(TokenType.KW_FN) -> methods += self.parse_fn_decl(m_pub);
				.check(TokenType.KW_OP) -> methods += self.parse_op_decl(m_pub);
				.check(TokenType.KW_INIT) -> methods += self.parse_init_decl(m_pub);
				else -> {
					val tok = self.peek();
					self.error(tok, "Expected method declaration inside trait");
					self.advance();
				}
			}
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after trait body");
		return self.node(
			NodeData.TraitDecl(name_tok.text, type_params, bases, methods, public, assoc),
			kw.line, kw.col
		);
	}

	pub fn parse_impl_decl(&self): *AstNode {
		val kw = self.advance(); // 'impl'
		var type_params = self.parse_generic_params();
		val first_name = self.consume(TokenType.IDENTIFIER, "Expected struct or trait name").text;

		if (
			type_params.empty()
			&& self.check(TokenType.LESS)
		) type_params = self.parse_generic_params();

		var struct_name = first_name;
		var trait_name = "";

		if (self.match_token(TokenType.KW_FOR)) {
			trait_name = first_name;
			val s_tok = self.consume(TokenType.IDENTIFIER, "Expected struct name after 'for'");
			struct_name = s_tok.text;
			if (self.check(TokenType.LESS)) type_params.extend(self.parse_generic_params());
		}

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before impl body");
		var methods = List<*AstNode>();
		var bindings = List<AssocBinding>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var m_pub = false;
			if (self.match_token(TokenType.KW_PUB)) m_pub = true;

			when (self) {
				.check(TokenType.IDENTIFIER) &&
				.peek().text == "type" -> {
					self.advance(); // 'type'
					val a_name = self.consume(TokenType.IDENTIFIER, "Expected associated type name");
					self.consume(TokenType.EQUAL, "Expected '=' in associated type binding");
					val a_ty = self.parse_type();
					self.consume(TokenType.SEMI_COLON, "Expected ';' after associated type binding");
					bindings += AssocBinding(a_name.text, a_ty);
				}
				.check(TokenType.KW_FN) -> methods += self.parse_fn_decl(m_pub);
				.check(TokenType.KW_OP) -> methods += self.parse_op_decl(m_pub);
				.check(TokenType.KW_INIT) -> methods += self.parse_init_decl(m_pub);
				else -> {
					val tok = self.peek();
					self.error(tok, "Expected method declaration inside impl");
					self.advance();
				}
			}
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after impl body");
		return self.node(
			NodeData.ImplDecl(struct_name, type_params, trait_name, methods, bindings),
			kw.line, kw.col
		);
	}

	pub fn parse_enum_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'enum'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected enum name");
		val underlying_type = if (self.match_token(TokenType.COLON)) self.parse_type()
		else null;

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before enum members");
		var members = List<EnumMember>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			val m_tok = self.consume(TokenType.IDENTIFIER, "Expected enum member name");

			// `Variant(field: Type, ...)` makes this a payload enum.
			var payload = List<EnumField>();
			if (self.match_token(TokenType.OPEN_PAREN)) {
				while (!self.check(TokenType.CLOSE_PAREN) && !self.is_end()) {
					val f_tok = self.consume(TokenType.IDENTIFIER, "Expected field name in enum variant");
					self.consume(TokenType.COLON, "Expected ':' after field name");
					payload += EnumField(f_tok.text, self.parse_type());
					if (!self.match_token(TokenType.COMMA)) break;
				}
				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after enum variant fields");
			}

			var m_val: ?*AstNode = null;
			if (self.match_token(TokenType.EQUAL)) {
				if (!payload.empty()) {
					self.error(m_tok, "A payload enum variant cannot have an explicit value");
				}
				m_val = self.parse_expression(Precedence.NONE);
			}
			members += EnumMember(m_tok.text, m_val, m_tok.line, m_tok.col, payload);

			self.match_token(TokenType.COMMA);
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after enum members");
		return self.node(
			NodeData.EnumDecl(name_tok.text, underlying_type, members, public),
			kw.line, kw.col
		);
	}

	pub fn parse_const_decl(&self, public: bool): *AstNode {
		val kw = self.advance(); // 'const'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected constant name");
		val type_node = if (self.match_token(TokenType.COLON)) self.parse_type() else null;

		self.consume(TokenType.EQUAL, "Expected '=' in const declaration");
		val val_node = self.parse_expression(Precedence.NONE);
		self.consume(TokenType.SEMI_COLON, "Expected ';' after const declaration");

		return self.node(
			NodeData.ConstDecl(name_tok.text, type_node, val_node, public),
			kw.line, kw.col
		);
	}

	pub fn parse_module_decl(&self): *AstNode {
		val kw = self.advance(); // 'mod'
		var path = List<str>();
		val first_seg = self.consume(TokenType.IDENTIFIER, "Expected module path segment").text;
		path += first_seg;
		var full_path = first_seg;

		while (self.match_token(TokenType.DOT)) {
			val seg = self.consume(TokenType.IDENTIFIER, "Expected module path segment after '.'").text;
			path += seg;
			full_path = "${full_path}.${seg}";
		}

		self.consume(TokenType.SEMI_COLON, "Expected ';' after module declaration");
		return self.node(NodeData.ModuleDecl(path, full_path), kw.line, kw.col);
	}

	pub fn parse_use_decl(&self): *AstNode {
		val kw = self.advance(); // 'use'
		var path = List<str>();
		val first_seg = self.consume(TokenType.IDENTIFIER, "Expected path in use declaration").text;
		path += first_seg;
		var full_path = first_seg;
		var wildcard = false;
		var symbol_name = first_seg;
		var alias = "";

		while (self.match_token(TokenType.DOT)) {
			if (self.match_token(TokenType.STAR)) {
				wildcard = true;
				full_path = "${full_path}.*";
				break;
			}
			val seg = self.consume(TokenType.IDENTIFIER, "Expected path segment after '.'").text;
			path += seg;
			symbol_name = seg;
			full_path = "${full_path}.${seg}";
		}

		if (self.match_token(TokenType.KW_AS))
			alias = self.consume(TokenType.IDENTIFIER, "Expected alias after 'as'").text;

		self.consume(TokenType.SEMI_COLON, "Expected ';' after use declaration");
		return self.node(
			NodeData.UseDecl(path, full_path, symbol_name, alias, wildcard),
			kw.line, kw.col
		);
	}

	pub fn parse_extern_block(&self): *AstNode {
		val kw = self.advance(); // 'extern'
		var abi = "C";
		if (self.check(TokenType.STRING)) abi = self.advance().text;

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before extern declarations");
		var declarations = List<*AstNode>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			val decl = self.parse_declaration();
			if (decl != null) declarations += decl;
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after extern declarations");
		return self.node(NodeData.ExternBlock(abi, declarations), kw.line, kw.col);
	}

	pub fn parse_declaration(&self): ?*AstNode {
		var public = false;
		if (self.match_token(TokenType.KW_PUB)) public = true;

		val tok = self.peek();
		return when (tok.type) {
			TokenType.KW_FN -> self.parse_fn_decl(public);
			TokenType.KW_STRUCT -> self.parse_struct_decl(public);
			TokenType.KW_TRAIT -> self.parse_trait_decl(public);
			TokenType.KW_IMPL -> self.parse_impl_decl();
			TokenType.KW_ENUM -> self.parse_enum_decl(public);
			TokenType.KW_CONST -> self.parse_const_decl(public);
			TokenType.KW_MOD -> self.parse_module_decl();
			TokenType.KW_USE -> self.parse_use_decl();
			TokenType.KW_EXTERN -> self.parse_extern_block();
			TokenType.KW_OP -> {
				self.error(tok, "Operator declarations can only be defined inside an 'impl' block");
				self.advance();
				yield null;
			}
			else -> {
				// Top-level statement or syntax error
				if (public) self.error(tok, "'pub' modifier is not allowed on this statement");
				val stmt = self.parse_statement();
				yield stmt;
			}
		};
	}

	pub fn parse_program(&self): *AstNode {
		var declarations = List<*AstNode>();

		while (!self.is_end()) {
			val decl = self.parse_declaration();
			if (decl != null) declarations += decl;
		}
		declarations.extend(self.struct_consts);

		return self.node(NodeData.Program(declarations), 1, 1);
	}

}
