mod compiler.parser;

use std.collections.*;
use std.string.StringBuilder;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;

/*
 * ============================================================================
 * compiler.parser.expression — Pratt expression and string interpolation parser
 * ============================================================================
 */

// Operator precedence levels, loosest first. `parse_expression(min_prec)` stops
// as soon as the next infix operator binds no tighter than `min_prec`; a member's
// position in this list *is* its binding power.
pub enum Precedence {
	NONE,        // no infix operator here
	ASSIGN,      // =
	ELVIS,       // ?:
	OR,          // ||
	AND,         // &&
	EQUALITY,    // ==, !=
	COMPARISON,  // <, <=, >, >=, in, is
	RANGE,       // .., ..<
	TERM,        // +, -
	FACTOR,      // *, /, %
	UNARY,       // -, !, *, &, as
	CALL,        // ., (), [], <args>()
	PRIMARY
}

// Whether a NUMBER token holds a float: the lexer scans the fractional part
// into the same token, so a '.' in the text marks a float literal. Hex/binary
// literals and suffixes never contain one.
pub fn num_literal_is_float(text: str): bool {
	for (c in text) if (c == '.') return true;
	// A trailing F/D is only a float suffix when the literal really carries one:
	// `0xEF` ends in F but is the integer 239.
	return when (text.num_suffix()) {
		"F", "D" -> true;
		else -> false;
	};
}

// True when the raw token text (quotes included) contains an unescaped `${`.
pub fn str_has_hole(text: str): bool {
	var i = 0;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') return true;
		i++;
	}
	return false;
}

// `\$` means a literal '$' in any string literal. The parser rewrites it so the
// C backend never sees the invalid escape `\$` (plain strings included).
pub fn str_has_esc_dollar(text: str): bool {
	if (text.len < 2) return false;
	for (i in 0..<(text.len - 1)) {
		if (text[i] == '\\' && text[i + 1] == '$') return true;
	}
	return false;
}

pub fn normalize_esc_dollar(text: str): str {
	if (!str_has_esc_dollar(text)) return text;
	var out = "";
	var i = 0;
	while (i < text.len) {
		if (text[i] == '\\' && i + 1 < text.len) {
			if (text[i + 1] == '\\') {
				out = "${out}\\\\";
				i += 2;
				continue;
			}
			if (text[i + 1] == '$') {
				out = "${out}$";
				i += 2;
				continue;
			}
		}
		out = "${out}${text.slice(i, i + 1)}";
		i++;
	}
	return out;
}

pub fn multiline_escape_for_c(text: str): str {
	var out = StringBuilder();
	defer out.free();
	out += '"';
	var i: usz = 0;
	while (i < text.len) {
		val c = text[i];
		when (c) {
			'\\' -> {
				if (i + 1 < text.len) {
					val next_c = text[i + 1];
					when (next_c) {
						'$' -> {
							out += '$';
							i += 2;
							continue;
						}
						'\\' -> {
							out += "\\\\";
							i += 2;
							continue;
						}
						'"' -> {
							out += "\\\"";
							i += 2;
							continue;
						}
					}
					out += '\\';
					out += next_c;
					i += 2;
					continue;
				}
				out += "\\\\";
				i++;
				continue;
			}
			'"' -> {
				out += "\\\"";
				i++;
				continue;
			}
			'\n' -> {
				out += "\\n";
				i++;
				continue;
			}
			'\r' -> {
				i++;
				continue;
			}
			else -> {
				out += c;
				i++;
			}
		}
	}
	out += '"';
	return out.to_str();
}

// Skips a '...' literal inside a hole.
pub fn interp_skip_char_lit(text: str, start: usz): usz {
	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '\'') return i + 1;
		i++;
	}
	return text.len;
}

// Skips a "..." or """...""" literal inside a hole (it may itself contain `${...}`).
pub fn interp_skip_quoted(text: str, start: usz): usz {
	if (start + 2 < text.len && text[start + 1] == '"' && text[start + 2] == '"') {
		var i = start + 3;
		while (i < text.len) {
			val c = text[i];
			if (c == '\\') {
				i += 2;
				continue;
			}
			if (c == '"' && i + 2 < text.len && text[i + 1] == '"' && text[i + 2] == '"') {
				return i + 3;
			}
			if (c == '$' && i + 1 < text.len && text[i + 1] == '{') {
				val e = interp_find_close(text, i + 2);
				if (e < 0) return text.len;
				i = (e as usz) + 1;
				continue;
			}
			i++;
		}
		return text.len;
	}

	var i = start + 1;
	while (i < text.len) {
		val c = text[i];
		if (c == '\\') {
			i += 2;
			continue;
		}
		if (c == '"') return i + 1;
		if (c == '$' && i + 1 < text.len && text[i + 1] == '{') {
			val e = interp_find_close(text, i + 2);
			if (e < 0) return text.len;
			i = (e as usz) + 1;
			continue;
		}
		i++;
	}
	return text.len;
}

// Index of the '}' closing a `${` hole whose body starts at `start`, or -1.
pub fn interp_find_close(text: str, start: usz): isz {
	var depth: i32 = 1;
	var i = start;
	while (i < text.len) {
		val c = text[i];
		if (c == '{') {
			depth++;
			i++;
			continue;
		}
		if (c == '}') {
			depth--;
			if (depth == 0) return i;
			i++;
			continue;
		}
		if (c == '"') {
			i = interp_skip_quoted(text, i);
			continue;
		}
		if (c == '\'') {
			i = interp_skip_char_lit(text, i);
			continue;
		}
		i++;
	}
	return -1;
}

impl Parser {

	pub fn get_infix_precedence(val self, t: TokenType): Precedence => when (t) {
		TokenType.EQUAL, TokenType.PLUS_EQUAL,
		TokenType.MINUS_EQUAL, TokenType.STAR_EQUAL,
		TokenType.SLASH_EQUAL, TokenType.PERCENT_EQUAL -> Precedence.ASSIGN;
		TokenType.QUESTION_COLON -> Precedence.ELVIS;
		TokenType.OR_OR -> Precedence.OR;
		TokenType.AND_AND -> Precedence.AND;
		TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL -> Precedence.EQUALITY;
		TokenType.LESS_EQUAL, TokenType.GREATER,
		TokenType.GREATER_EQUAL, TokenType.KW_IS,
		TokenType.KW_IN -> Precedence.COMPARISON;
		TokenType.BANG -> {
			if (self.peek_at(1).type == TokenType.KW_IN) yield Precedence.COMPARISON;
			yield Precedence.CALL;
		}
		TokenType.LESS -> {
			if (self.is_generic_args_ahead()) yield Precedence.CALL;
			yield Precedence.COMPARISON;
		}
		TokenType.DOT_DOT, TokenType.DOT_DOT_LESS -> Precedence.RANGE;
		TokenType.PLUS, TokenType.MINUS -> Precedence.TERM;
		TokenType.STAR, TokenType.SLASH, TokenType.PERCENT -> Precedence.FACTOR;
		TokenType.KW_AS -> Precedence.UNARY;
		TokenType.DOT, TokenType.QUESTION_DOT, TokenType.OPEN_PAREN,
		TokenType.OPEN_BRACKET, TokenType.PLUS_PLUS,
		TokenType.MINUS_MINUS -> Precedence.CALL;
		else -> Precedence.NONE;
	};

	fn parse_is_pattern(var self, left: *AstNode?, line: usz, col: usz): *AstNode {
		val target_type = self.parse_type();
		var alias = "";
		var mutable = false;
		if (self.match_token(TokenType.KW_AS)) {
			if (self.match_token(TokenType.KW_VAR)) {
				mutable = true;
				self.match_token(TokenType.AMPERSAND);
			} else if (self.match_token(TokenType.AMPERSAND)) {
				mutable = true;
			} else {
				self.match_token(TokenType.KW_VAL);
			}
			val alias_tok = self.consume(TokenType.IDENTIFIER, "Expected identifier after 'as'");
			alias = alias_tok.text;
		}
		return self.node(NodeData.IsExpr(left, target_type, alias, mutable), line, col);
	}

	fn parse_call_args(var self): List<*AstNode> {
		var args = List<*AstNode>();
		if (!self.check(TokenType.CLOSE_PAREN)) {
			args += self.parse_expression(Precedence.NONE);
			while (self.match_token(TokenType.COMMA)) {
				args += self.parse_expression(Precedence.NONE);
			}
		}
		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after function arguments");
		return args;
	}

	// ============================================================================
	// Pratt Expression Parser
	// ============================================================================

	pub fn parse_prefix(var self): *AstNode {
		val tok = self.advance();
		val (line, col) = tok;

		// Literals
		return when (tok.type) {
			// A number token keeps its fractional part, so a '.' in the text means
			// the literal is a float (types are decided here, not by the lexer).
			TokenType.NUMBER -> {
				if (num_literal_is_float(tok.text)) yield self.node(NodeData.LiteralExpr(Literal.FLOAT, tok.text), line, col);
				yield self.node(NodeData.LiteralExpr(Literal.INTEGER, tok.text), line, col);
			}
			TokenType.STRING -> {
				// Keep the token span so the formatter can re-emit a `"""` literal verbatim.
				val lit_node = self.parse_string_literal(tok, line, col);
				lit_node.span = tok.span;
				yield lit_node;
			}
			TokenType.CHAR -> self.node(NodeData.LiteralExpr(Literal.CHARACTER, tok.text), line, col);
			TokenType.KW_TRUE -> self.node(NodeData.LiteralExpr(Literal.BOOLEAN, "true"), line, col);
			TokenType.KW_FALSE -> self.node(NodeData.LiteralExpr(Literal.BOOLEAN, "false"), line, col);
			TokenType.KW_NULL -> self.node(NodeData.LiteralExpr(Literal.NULL_VAL, "null"), line, col);
			TokenType.IDENTIFIER, TokenType.KW_OP -> self.node(NodeData.IdentifierExpr(tok.text), line, col);

			// Grouping: (expr)
			TokenType.OPEN_PAREN -> {
				val inner = self.parse_expression(Precedence.NONE);
				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after grouping expression");
				yield self.node(NodeData.GroupExpr(inner), line, col);
			}

			// Array Literal: [a, b, c]
			TokenType.OPEN_BRACKET -> {
				var elements = List<*AstNode>();
				if (!self.check(TokenType.CLOSE_BRACKET)) {
					elements += self.parse_expression(Precedence.NONE);
					while (self.match_token(TokenType.COMMA)) {
						if (self.check(TokenType.CLOSE_BRACKET)) break;
						elements += self.parse_expression(Precedence.NONE);
					}
				}
				self.consume(TokenType.CLOSE_BRACKET, "Expected ']' after array literal");
				yield self.node(NodeData.ArrayLiteralExpr(elements, "", null), line, col);
			}

			// Prefix Unary: -, !, *, &
			TokenType.MINUS, TokenType.BANG,
			TokenType.STAR, TokenType.AMPERSAND -> {
				val operand = self.parse_expression(Precedence.UNARY);
				yield self.node(NodeData.UnaryExpr(tok.type, operand, false), line, col);
			}

			// Type pattern: is Type [as [var|val|&] alias]
			TokenType.KW_IS -> self.parse_is_pattern(null, line, col);

			// If Expression: if (cond) then_expr else else_expr
			TokenType.KW_IF -> {
				self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'if'");
				val condition = self.parse_expression(Precedence.NONE);

				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after if condition");
				val then_branch = self.parse_if_expr_branch();

				self.consume(TokenType.KW_ELSE, "Expected 'else' in if expression");
				val else_branch = self.parse_if_expr_branch();

				yield self.node(NodeData.IfExpr(condition, then_branch, else_branch), line, col);
			}

			// When Expression: when (cond) { val1 -> expr1, else -> expr2 }
			TokenType.KW_WHEN -> {
				// `when (cond) { ... }` or the boolean form `when { cond -> ... }`.
				var condition: *AstNode? = null;
				if (self.match_token(TokenType.OPEN_PAREN)) {
					condition = self.parse_expression(Precedence.NONE);
					self.consume(TokenType.CLOSE_PAREN, "Expected ')' after when condition");
				}
				self.consume(TokenType.OPEN_BRACE, "Expected '{' before when arms");

				var arms = List<WhenArm>();
				while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
					val (arm_line, arm_col) = self.peek();
					var is_else = false;
					var patterns = List<*AstNode>();

					if (self.match_token(TokenType.KW_ELSE)) is_else = true;
					else {
						patterns += self.parse_expression(Precedence.NONE);
						while (self.match_token(TokenType.COMMA)) {
							patterns += self.parse_expression(Precedence.NONE);
						}
					}

					self.consume(TokenType.ARROW, "Expected '->' after when arm pattern");
					val is_block = self.check(TokenType.OPEN_BRACE);
					val body = if (is_block) self.parse_block_stmt()
					else self.parse_expression(Precedence.NONE);

					arms += WhenArm(patterns, is_else, body, arm_line, arm_col);

					if (self.check(TokenType.COMMA)) {
						self.error(self.peek(), "Expected ';' after when arm, not ',' (commas are only allowed for grouping conditions before '->')");
						self.advance();
					} else if (is_block) {
						self.match_token(TokenType.SEMI_COLON);
					} else {
						self.consume(TokenType.SEMI_COLON, "Expected ';' after when arm");
					}
				}

				self.consume(TokenType.CLOSE_BRACE, "Expected '}' after when arms");
				yield self.node(NodeData.WhenExpr(condition, arms), line, col);
			}

			else -> {
				self.error(tok, "Expected expression");
				yield self.node(NodeData.IdentifierExpr("<error>"), line, col);
			}
		};
	}

	pub fn parse_infix(var self, left: *AstNode, prec: Precedence): *AstNode {
		val (tok_type, line, col) = self.peek();

		when (tok_type) {
			// 1. Postfix update: left++, left--
			TokenType.PLUS_PLUS -> {
				self.advance();
				return self.node(NodeData.UpdateExpr(TokenType.PLUS_PLUS, left), line, col);
			}
			TokenType.MINUS_MINUS -> {
				self.advance();
				return self.node(NodeData.UpdateExpr(TokenType.MINUS_MINUS, left), line, col);
			}
			// Postfix force unwrap: left!
			TokenType.BANG -> {
				if (self.peek_at(1).type != TokenType.KW_IN) {
					self.advance();
					return self.node(NodeData.UnaryExpr(TokenType.BANG, left, true), line, col);
				}
			}
			// 2. Assignment: left = right, left += right, ... (right-associative)
			TokenType.EQUAL, TokenType.PLUS_EQUAL,
			TokenType.MINUS_EQUAL, TokenType.STAR_EQUAL,
			TokenType.SLASH_EQUAL, TokenType.PERCENT_EQUAL -> {
				val op_tok = self.advance();
				// Right-associative: the RHS is parsed at the loosest level, so a
				// nested `=` binds inside this one.
				val right = self.parse_expression(Precedence.NONE);
				return self.node(NodeData.AssignExpr(left, op_tok.type, right), line, col);
			}
		}

		return when {
			// 2. Elvis operator: left ?: right (right can be expression or jump statement)
			self.match_token(TokenType.QUESTION_COLON) -> {
				val right = when {
					self.match_token(TokenType.KW_RETURN) -> {
						val (kw_line, kw_col) = self.previous();
						val value = if (
							!self.check(TokenType.SEMI_COLON)
							&& !self.check(TokenType.CLOSE_BRACE)
							&& !self.check(TokenType.CLOSE_PAREN)
						) self.parse_expression(Precedence.NONE) else null;

						yield self.node(NodeData.ReturnStmt(value), kw_line, kw_col);
					}
					self.match_token(TokenType.KW_BREAK) -> {
						val (kw_line, kw_col) = self.previous();
						yield self.node(NodeData.BreakStmt, kw_line, kw_col);
					}
					self.match_token(TokenType.KW_CONTINUE) -> {
						val (kw_line, kw_col) = self.previous();
						yield self.node(NodeData.ContinueStmt, kw_line, kw_col);
					}
					self.match_token(TokenType.KW_YIELD) -> {
						val (kw_line, kw_col) = self.previous();
						val value = if (
							!self.check(TokenType.SEMI_COLON)
							&& !self.check(TokenType.CLOSE_BRACE)
							&& !self.check(TokenType.CLOSE_PAREN)
						) self.parse_expression(Precedence.NONE) else null;

						yield self.node(NodeData.YieldStmt(value), kw_line, kw_col);
					}
					// One level below ELVIS keeps `?:` right-associative.
					else -> self.parse_expression(Precedence.ASSIGN);
				};

				yield self.node(NodeData.BinaryExpr(left, TokenType.QUESTION_COLON, right), line, col);
			}

			// 3. Member Access: left.member or left?.member
			self.match_token(TokenType.DOT) -> {
				val member_tok = self.consume(TokenType.IDENTIFIER, "Expected identifier after '.'");
				yield self.node(NodeData.MemberExpr(left, member_tok.text, false), line, col);
			}
			self.match_token(TokenType.QUESTION_DOT) -> {
				val member_tok = self.consume(TokenType.IDENTIFIER, "Expected identifier after '?.'");
				yield self.node(NodeData.MemberExpr(left, member_tok.text, true), line, col);
			}

			// 3. Index Access: left[index]
			self.match_token(TokenType.OPEN_BRACKET) -> {
				val index = self.parse_expression(Precedence.NONE);
				self.consume(TokenType.CLOSE_BRACKET, "Expected ']' after array index");
				yield self.node(NodeData.IndexExpr(left, index), line, col);
			}

			// 4. Type Cast: left as Type
			self.match_token(TokenType.KW_AS) -> {
				if (self.match_token(TokenType.QUESTION)) {
					self.error(self.peek(), "Safe cast 'as?' has been removed; use 'is' with smart casting instead");
				}
				val target_type = self.parse_type();
				yield self.node(NodeData.CastExpr(left, target_type), line, col);
			}

			// Type Test: left is Type [as [var|val|&] alias]
			self.match_token(TokenType.KW_IS) -> self.parse_is_pattern(left, line, col);

			// In test: left in right
			self.match_token(TokenType.KW_IN) -> {
				val right = self.parse_expression(prec);
				yield self.node(NodeData.BinaryExpr(left, TokenType.KW_IN, right), line, col);
			}

			// Not-in test: left !in right
			self.check(TokenType.BANG) && self.peek_at(1).type == TokenType.KW_IN -> {
				self.advance(); // consume '!'
				self.advance(); // consume 'in'
				val right = self.parse_expression(prec);
				val in_expr = self.node(NodeData.BinaryExpr(left, TokenType.KW_IN, right), line, col);
				yield self.node(NodeData.UnaryExpr(TokenType.BANG, in_expr, false), line, col);
			}

			// 5. Generic Call: left<T1, T2>(arg1, arg2)
			self.check(TokenType.LESS) && self.is_generic_args_ahead() -> {
				self.advance(); // consume '<'
				var type_args = List<*AstNode>();
				type_args += self.parse_type();
				while (self.match_token(TokenType.COMMA)) type_args += self.parse_type();
				self.consume(TokenType.GREATER, "Expected '>' after generic call type arguments");

				self.consume(TokenType.OPEN_PAREN, "Expected '(' after generic type arguments");
				val args = self.parse_call_args();
				yield self.node(NodeData.CallExpr(left, args, type_args), line, col);
			}

			// 6. Normal Call: left(arg1, arg2)
			self.match_token(TokenType.OPEN_PAREN) -> {
				val args = self.parse_call_args();
				yield self.node(NodeData.CallExpr(left, args, List<*AstNode>()), line, col);
			}

			// 7. Binary Operators: +, -, *, /, %, ==, !=, <, <=, >, >=, &&, ||
			else -> {
				val op_tok = self.advance();
				val right = self.parse_expression(prec);
				yield self.node(NodeData.BinaryExpr(left, op_tok.type, right), line, col);
			}
		};
	}

	pub fn parse_expression(var self, min_prec: Precedence): *AstNode {
		var left = self.parse_prefix();

		while (!self.is_end()) {
			val next_tok = self.peek();
			val prec = self.get_infix_precedence(next_tok.type);
			if (prec <= min_prec) break;
			left = self.parse_infix(left, prec);
		}

		return left;
	}

	// Branch of an if expression: either a plain expression or a `{ expr }` block.
	pub fn parse_if_expr_branch(var self): *AstNode {
		if (self.match_token(TokenType.OPEN_BRACE)) {
			val e = self.parse_expression(Precedence.NONE);
			self.consume(TokenType.CLOSE_BRACE, "Expected '}' after if expression branch");
			return e;
		}
		return self.parse_expression(Precedence.NONE);
	}

	pub fn parse_string_literal(var self, tok: Token, line: usz, col: usz): *AstNode {
		if (tok.text.starts_with("\"\"\"")) {
			return self.parse_multiline_string(tok.text, line, col);
		}

		if (!self.check(TokenType.STRING)) {
			if (str_has_hole(tok.text)) return self.parse_interp_string(tok.text, line, col);
			return self.node(NodeData.LiteralExpr(Literal.STRING, normalize_esc_dollar(tok.text)), line, col);
		}

		var combined_inner = "";
		if (tok.text.len >= 2) {
			combined_inner = tok.text.slice(1, tok.text.len - 1);
		}
		while (self.check(TokenType.STRING)) {
			val next_tok = self.advance();
			if (next_tok.text.len >= 2) {
				combined_inner = "${combined_inner}${next_tok.text.slice(1, next_tok.text.len - 1)}";
			}
		}
		val combined = "\"${combined_inner}\"";
		if (str_has_hole(combined)) return self.parse_interp_string(combined, line, col);
		return self.node(NodeData.LiteralExpr(Literal.STRING, normalize_esc_dollar(combined)), line, col);
	}

	pub fn parse_multiline_string(var self, text: str, line: usz, col: usz): *AstNode {
		if (text.len < 6) return self.node(NodeData.LiteralExpr(Literal.STRING, "\"\""), line, col);
		val inner = text.slice(3, text.len - 3);
		val trimmed = inner.multiline_trim_indent();

		if (str_has_hole(trimmed)) {
			return self.parse_interp_multiline(trimmed, line, col);
		}

		val c_literal = multiline_escape_for_c(trimmed);
		return self.node(NodeData.LiteralExpr(Literal.STRING, c_literal), line, col);
	}

	pub fn parse_interp_multiline(var self, text: str, line: usz, col: usz): *AstNode {
		var parts = List<InterpPart>();
		val end = text.len;
		var i: usz = 0;
		var lit = StringBuilder();
		defer lit.free();
		var has_lit = false;

		while (i < end) {
			val c = text[i];
			if (c == '\\') {
				if (i + 1 < end) {
					val next_c = text[i + 1];
					if (next_c == '$') {
						lit += '$';
						has_lit = true;
						i += 2;
						continue;
					}
					if (next_c == '\\') {
						lit += "\\\\";
						has_lit = true;
						i += 2;
						continue;
					}
					if (next_c == '"') {
						lit += "\\\"";
						has_lit = true;
						i += 2;
						continue;
					}
					lit += '\\';
					lit += next_c;
					has_lit = true;
					i += 2;
					continue;
				}
				lit += "\\\\";
				has_lit = true;
				i++;
				continue;
			}
			if (c == '"') {
				lit += "\\\"";
				has_lit = true;
				i++;
				continue;
			}
			if (c == '\n') {
				lit += "\\n";
				has_lit = true;
				i++;
				continue;
			}
			if (c == '\r') {
				i++;
				continue;
			}
			if (c == '$' && i + 1 < end && text[i + 1] == '{') {
				if (has_lit) {
					parts += InterpPart.Literal(self.node(NodeData.LiteralExpr(Literal.STRING, "\"${lit.to_str()}\""), line, col));
					lit.clear();
					has_lit = false;
				}
				val h_start = i + 2;
				val h_end = interp_find_close(text, h_start);
				if (h_end < 0) {
					self.errors += Diagnostic.error(Span(self.file_id, line as u32, col as u32, 1), "", "Unterminated interpolation hole in multiline string literal");
					return self.node(NodeData.LiteralExpr(Literal.STRING, "\"\""), line, col);
				}
				val src = text.slice(h_start, h_end as usz);
				var sub_lexer = Lexer(src);
				val sub_tokens = sub_lexer.tokenize();
				var sub = Parser(sub_tokens);
				// Share the parent arena: a fresh one per hole costs a mostly empty 64KB block.
				sub.arena = self.arena;
				val hole = sub.parse_expression(Precedence.NONE);
				self.arena = sub.arena;
				if (!sub.errors.empty()) {
					for (d in sub.errors) self.errors += Diagnostic.error(d.span(), d.file_path, "in interpolation hole: ${d.message}");
				}
				parts += InterpPart.Hole(hole);
				i = (h_end as usz) + 1;
				continue;
			}
			lit += c;
			has_lit = true;
			i++;
		}

		if (has_lit) parts += InterpPart.Literal(self.node(NodeData.LiteralExpr(Literal.STRING, "\"${lit.to_str()}\""), line, col));
		return self.node(NodeData.InterpExpr(parts), line, col);
	}

	pub fn parse_interp_string(var self, text: str, line: usz, col: usz): *AstNode {
		var parts = List<InterpPart>();
		val end = text.len - 1;   // index of the closing quote
		var i: usz = 1;           // skip the opening quote
		var lit = StringBuilder();
		defer lit.free();
		var has_lit = false;

		while (i < end) {
			val c = text[i];
			if (c == '\\') {
				if (i + 1 < end && text[i + 1] == '\\') {
					lit += "\\\\";
					has_lit = true;
					i += 2;
					continue;
				}
				// `\$` is a literal '$'; every other escape is kept verbatim.
				if (i + 1 < end && text[i + 1] == '$') {
					lit += '$';
				} else if (i + 1 < end) {
					lit += '\\';
					lit += text[i + 1];
				} else {
					lit += '\\';
				}
				has_lit = true;
				i += 2;
				continue;
			}
			if (c == '$' && i + 1 < end && text[i + 1] == '{') {
				if (has_lit) {
					parts += InterpPart.Literal(self.node(NodeData.LiteralExpr(Literal.STRING, "\"${lit.to_str()}\""), line, col));
					lit.clear();
					has_lit = false;
				}
				val h_start = i + 2;
				val h_end = interp_find_close(text, h_start);
				if (h_end < 0) {
					self.errors += Diagnostic.error(Span(self.file_id, line as u32, col as u32, 1), "", "Unterminated interpolation hole in string literal");
					return self.node(NodeData.LiteralExpr(Literal.STRING, text), line, col);
				}
				val src = text.slice(h_start, h_end);
				var sub_lexer = Lexer(src);
				val sub_tokens = sub_lexer.tokenize();
				var sub = Parser(sub_tokens);
				// Share the parent arena: a fresh one per hole costs a mostly empty 64KB block.
				sub.arena = self.arena;
				val hole = sub.parse_expression(Precedence.NONE);
				self.arena = sub.arena;
				if (sub.errors.len > 0) {
					for (d in sub.errors) self.errors += Diagnostic.error(d.span(), d.file_path, "in interpolation hole: ${d.message}");
				}
				parts += InterpPart.Hole(hole);
				i = h_end + 1;
				continue;
			}
			lit += c;
			has_lit = true;
			i++;
		}

		if (has_lit) parts += InterpPart.Literal(self.node(NodeData.LiteralExpr(Literal.STRING, "\"${lit.to_str()}\""), line, col));
		return self.node(NodeData.InterpExpr(parts), line, col);
	}

}
