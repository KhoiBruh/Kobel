mod compiler.parser;

use std.collections.*;

use compiler.lexer.*;
use compiler.ast.*;

/*
 * ============================================================================
 * compiler.parser.statement — Statement and control-flow parsers
 * ============================================================================
 */

impl Parser {

	pub fn parse_block_stmt(&self): *AstNode {
		val lbrace = self.consume(TokenType.OPEN_BRACE, "Expected '{'");
		var statements = List<*AstNode>();

		while (
			!self.is_end()
			&& !self.check(TokenType.CLOSE_BRACE)
		) statements += self.parse_statement();

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after block");
		return self.node(NodeData.BlockStmt(statements), lbrace.line, lbrace.col);
	}

	pub fn parse_var_decl_stmt(&self): *AstNode {
		val kw = self.advance(); // val or var
		val mutable = (kw.type == TokenType.KW_VAR);

		if (self.match_token(TokenType.OPEN_PAREN)) {
			var names = List<str>();

			val n1 = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
			names += n1.text;

			while (self.match_token(TokenType.COMMA)) {
				if (self.check(TokenType.CLOSE_PAREN)) break;
				val n = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
				names += n.text;
			}

			self.consume(TokenType.CLOSE_PAREN, "Expected ')' after destructuring pattern");
			self.consume(TokenType.EQUAL, "Expected '=' in destructuring declaration");
			val init_expr = self.parse_expression(Precedence.NONE);
			self.consume(TokenType.SEMI_COLON, "Expected ';' after variable declaration");

			return self.node(
				NodeData.DestructDeclStmt(mutable, names, init_expr),
				kw.line, kw.col
			);
		}

		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected variable name");
		val type_ann = if (self.match_token(TokenType.COLON)) self.parse_type()
		else null;

		val init_expr = if (self.match_token(TokenType.EQUAL)) self.parse_expression(Precedence.NONE)
		else null;

		self.consume(TokenType.SEMI_COLON, "Expected ';' after variable declaration");
		return self.node(
			NodeData.VarDeclStmt(mutable, name_tok.text, type_ann, init_expr),
			kw.line, kw.col
		);
	}

	pub fn parse_if_stmt(&self): *AstNode {
		val kw = self.advance(); // 'if'
		self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'if'");
		val condition = self.parse_expression(Precedence.NONE);
		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after if condition");

		val then_branch = self.parse_statement();
		val else_branch = if (self.match_token(TokenType.KW_ELSE)) self.parse_statement()
		else null;

		return self.node(
			NodeData.IfStmt(condition, then_branch, else_branch),
			kw.line, kw.col
		);
	}

	pub fn parse_while_stmt(&self): *AstNode {
		val kw = self.advance(); // 'while'
		self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'while'");
		val condition = self.parse_expression(Precedence.NONE);
		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after while condition");

		val body = self.parse_statement();
		return self.node(NodeData.WhileStmt(condition, body), kw.line, kw.col);
	}

	// `for (x in <expr>) <stmt>` where `<expr>` is either an iterable value or one
	// of the range forms `a..b` (closed) / `a>..<b` (open). Bounds are parsed with a
	// precedence that stops before comparison operators so `a>..<b` keeps its `>`.
	pub fn parse_for_stmt(&self): *AstNode {
		val kw = self.advance(); // 'for'
		self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'for'");

		val var_name = when (self) {
			.match_token(TokenType.KW_VAL) -> {
				self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'val' in destructuring loop");
				val n1 = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
				var raw_names = "(${n1.text}";
				while (self.match_token(TokenType.COMMA)) {
					if (self.check(TokenType.CLOSE_PAREN)) break;
					val n = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
					raw_names += ", ";
					raw_names += n.text;
				}

				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after destructuring pattern");
				raw_names += ")";
				yield raw_names;
			}

			.match_token(TokenType.KW_VAR) -> {
				self.consume(TokenType.OPEN_PAREN, "Expected '(' after 'var' in destructuring loop");
				val n1 = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
				var raw_names = "var (${n1.text}";
				while (self.match_token(TokenType.COMMA)) {
					if (self.check(TokenType.CLOSE_PAREN)) break;
					val n = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
					raw_names += ", ";
					raw_names += n.text;
				}

				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after destructuring pattern");
				raw_names += ")";
				yield raw_names;
			}

			.match_token(TokenType.OPEN_PAREN) -> {
				val n1 = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
				var raw_names = "(${n1.text}";
				while (self.match_token(TokenType.COMMA)) {
					if (self.check(TokenType.CLOSE_PAREN)) break;
					val n = self.consume(TokenType.IDENTIFIER, "Expected variable name in destructuring pattern");
					raw_names += ", ";
					raw_names += n.text;
				}

				self.consume(TokenType.CLOSE_PAREN, "Expected ')' after destructuring pattern");
				raw_names += ")";
				yield raw_names;
			}

			else -> self.consume(TokenType.IDENTIFIER, "Expected loop variable name").text;
		};

		self.consume(TokenType.KW_IN, "Expected 'in' after loop variable");

		val first = self.parse_expression(Precedence.RANGE);

		var is_range = false;
		var is_open = false;
		var is_half_open = false;
		var iterable: *AstNode? = null;
		var range_start: *AstNode? = null;
		var range_end: *AstNode? = null;

		when (self) {
			.match_token(TokenType.DOT_DOT_LESS) -> {
				is_range = true;
				is_half_open = true;
				range_start = first;
				range_end = self.parse_expression(Precedence.COMPARISON);
			}

			.match_token(TokenType.DOT_DOT) -> {
				is_range = true;
				range_start = first;
				// `a..<b` excludes the end bound, so `for (i in 0..<seq.len)` is the
				// index loop that never has to subtract one (which would wrap at 0).
				if (self.match_token(TokenType.LESS)) is_half_open = true;
				range_end = self.parse_expression(Precedence.COMPARISON);
			}

			.check(TokenType.GREATER) &&
			.peek_at(1).type in [TokenType.DOT_DOT, TokenType.DOT_DOT_LESS]
			-> {
				is_range = true;
				is_open = true;
				range_start = first;
				self.advance(); // '>'
				if (!self.match_token(TokenType.DOT_DOT_LESS)) {
					self.consume(TokenType.DOT_DOT, "Expected '..' in open range");
					self.consume(TokenType.LESS, "Expected '<' to close an open range");
				}
				range_end = self.parse_expression(Precedence.COMPARISON);
			}

			else -> {
				var iter = first;
				while (!self.is_end()) {
					val next_tok = self.peek();
					val prec = self.get_infix_precedence(next_tok.type);
					if (prec <= Precedence.NONE) break;
					iter = self.parse_infix(iter, prec);
				}

				var unwrapped = iter;
				if (unwrapped is GroupExpr as g) unwrapped = g.expr;

				if (
					unwrapped is BinaryExpr as bin &&
					bin.op in [TokenType.DOT_DOT, TokenType.DOT_DOT_LESS]
				) {
					is_range = true;
					is_half_open = bin.op == TokenType.DOT_DOT_LESS;
					range_start = bin.left;
					range_end = bin.right;
				} else {
					iterable = iter;
				}
			}
		}

		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after for header");
		val body = self.parse_statement();
		return self.node(NodeData.ForStmt(
			var_name, is_range, is_open, is_half_open,
			iterable, range_start, range_end, body), kw.line, kw.col
		);
	}

	pub fn parse_return_stmt(&self): *AstNode {
		val kw = self.advance(); // 'return'
		val value = if (!self.check(TokenType.SEMI_COLON)) self.parse_expression(Precedence.NONE) else null;

		self.consume(TokenType.SEMI_COLON, "Expected ';' after return statement");
		return self.node(NodeData.ReturnStmt(value), kw.line, kw.col);
	}

	pub fn parse_when_stmt(&self): *AstNode {
		val kw = self.advance(); // 'when'
		// `when (cond) { ... }` or the boolean form `when { cond -> ... }`.
		var condition: *AstNode? = null;
		if (self.match_token(TokenType.OPEN_PAREN)) {
			condition = self.parse_expression(Precedence.NONE);
			self.consume(TokenType.CLOSE_PAREN, "Expected ')' after when condition");
		}
		self.consume(TokenType.OPEN_BRACE, "Expected '{' before when statement arms");

		var arms = List<WhenArm>();
		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			val (arm_line, arm_col) = self.peek();
			var is_else = false;
			var patterns = List<*AstNode>();

			if (self.match_token(TokenType.KW_ELSE)) is_else = true;
			else patterns = self.parse_when_patterns();

			self.consume(TokenType.ARROW, "Expected '->' after when arm pattern");
			val body = self.parse_statement();
			arms += WhenArm(patterns, is_else, body, arm_line, arm_col);

			if (self.check(TokenType.COMMA)) {
				self.error(self.peek(), "Expected ';' after when arm, not ',' (commas are only allowed for grouping conditions before '->')");
				self.advance();
			}
			self.match_token(TokenType.SEMI_COLON);
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after when statement arms");
		return self.node(NodeData.WhenStmt(condition, arms), kw.line, kw.col);
	}

	pub fn parse_defer_stmt(&self): *AstNode {
		val kw = self.advance(); // 'defer'
		val body = self.parse_statement();
		return self.node(NodeData.DeferStmt(body), kw.line, kw.col);
	}

	pub fn parse_statement(&self): *AstNode {
		val (type, line, col) = self.peek();

		return when (type) {
			TokenType.OPEN_BRACE -> self.parse_block_stmt();
			TokenType.KW_VAL, TokenType.KW_VAR -> self.parse_var_decl_stmt();
			TokenType.KW_IF -> self.parse_if_stmt();
			TokenType.KW_WHILE -> self.parse_while_stmt();
			TokenType.KW_FOR -> self.parse_for_stmt();
			TokenType.KW_RETURN -> self.parse_return_stmt();
			TokenType.KW_WHEN -> self.parse_when_stmt();
			TokenType.KW_DEFER -> self.parse_defer_stmt();
			TokenType.KW_BREAK -> {
				self.advance();
				self.consume(TokenType.SEMI_COLON, "Expected ';' after break");
				yield self.node(NodeData.BreakStmt, line, col);
			}
			TokenType.KW_CONTINUE -> {
				self.advance();
				self.consume(TokenType.SEMI_COLON, "Expected ';' after continue");
				yield self.node(NodeData.ContinueStmt, line, col);
			}
			TokenType.KW_YIELD -> {
				self.advance();
				val value = if (!self.check(TokenType.SEMI_COLON)) self.parse_expression(Precedence.NONE)
				else null;

				self.consume(TokenType.SEMI_COLON, "Expected ';' after yield");
				yield self.node(NodeData.YieldStmt(value), line, col);
			}
			else -> {
				val expr = self.parse_expression(Precedence.NONE);
				self.consume(TokenType.SEMI_COLON, "Expected ';' after expression statement");
				yield self.node(NodeData.ExprStmt(expr), line, col);
			}
		};
	}

}
