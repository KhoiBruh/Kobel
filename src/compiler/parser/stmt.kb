mod compiler.parser.stmt;

use compiler.lexer.token.*;

use compiler.ast.node.AstNode;
use compiler.ast.stmt.WhenStmtArm;
use compiler.ast.builder.*;
use compiler.parser.parser.*;

use compiler.parser.types.parse_type;
use compiler.parser.expr.*;

use std.collections.list.*;

// ============================================================================
// Statement Parsers
// ============================================================================

pub fn parse_block_stmt(var self: &Parser): *AstNode {
	val lbrace = consume(self, TokenType.OPEN_BRACE, "Expected '{'");
	var statements = List<*AstNode>();

	while (!check(self, TokenType.CLOSE_BRACE) && !is_end(self)) {
		statements.add(parse_statement(self));
	}

	consume(self, TokenType.CLOSE_BRACE, "Expected '}' after block");
	return self.b().block_stmt(statements, lbrace.line, lbrace.col);
}

pub fn parse_var_decl_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // val or var
	val is_mut = (kw.type == TokenType.KW_VAR);

	val name_tok = consume(self, TokenType.IDENTIFIER, "Expected variable name");
	val type_ann = if (match_token(self, TokenType.COLON)) parse_type(self) else null;
	val init = if (match_token(self, TokenType.EQUAL)) parse_expression(self, PREC_NONE) else null;

	consume(self, TokenType.SEMI_COLON, "Expected ';' after variable declaration");
	return self.b().var_decl(is_mut, name_tok.text, type_ann, init, kw.line, kw.col);
}

pub fn parse_if_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // 'if'
	consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'if'");
	val condition = parse_expression(self, PREC_NONE);
	consume(self, TokenType.CLOSE_PAREN, "Expected ')' after if condition");

	val then_branch = parse_statement(self);
	val else_branch = if (match_token(self, TokenType.KW_ELSE)) parse_statement(self) else null;

	return self.b().if_stmt(condition, then_branch, else_branch, kw.line, kw.col);
}

pub fn parse_while_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // 'while'
	consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'while'");
	val condition = parse_expression(self, PREC_NONE);
	consume(self, TokenType.CLOSE_PAREN, "Expected ')' after while condition");

	val body = parse_statement(self);
	return self.b().while_stmt(condition, body, kw.line, kw.col);
}

// `for (x in <expr>) <stmt>` where `<expr>` is either an iterable value or one
// of the range forms `a..b` (closed) / `a>..<b` (open). Bounds are parsed with a
// precedence that stops before comparison operators so `a>..<b` keeps its `>`.
pub fn parse_for_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // 'for'
	consume(self, TokenType.OPEN_PAREN, "Expected '(' after 'for'");
	val name_tok = consume(self, TokenType.IDENTIFIER, "Expected loop variable name");
	consume(self, TokenType.KW_IN, "Expected 'in' after loop variable");

	val first = parse_expression(self, PREC_COMPARISON);

	var is_range = false;
	var is_open = false;
	var is_half_open = false;
	var iterable: *AstNode = null;
	var range_start: *AstNode = null;
	var range_end: *AstNode = null;

	if (match_token(self, TokenType.DOT_DOT)) {
		is_range = true;
		range_start = first;
		// `a..<b` excludes the end bound, so `for (i in 0..<seq.len)` is the
		// index loop that never has to subtract one (which would wrap at 0).
		if (match_token(self, TokenType.LESS)) is_half_open = true;
		range_end = parse_expression(self, PREC_COMPARISON);
	} else if (check(self, TokenType.GREATER) && peek_at(self, 1).type == TokenType.DOT_DOT) {
		is_range = true;
		is_open = true;
		range_start = first;
		advance(self); // '>'
		consume(self, TokenType.DOT_DOT, "Expected '..' in open range");
		consume(self, TokenType.LESS, "Expected '<' to close an open range");
		range_end = parse_expression(self, PREC_COMPARISON);
	} else iterable = first;

	consume(self, TokenType.CLOSE_PAREN, "Expected ')' after for header");
	val body = parse_statement(self);
	return self.b().for_stmt(
		name_tok.text, is_range, is_open, is_half_open,
		iterable, range_start, range_end, body, kw.line, kw.col
	);
}

pub fn parse_return_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // 'return'
	val value = if (!check(self, TokenType.SEMI_COLON)) parse_expression(self, PREC_NONE) else null;

	consume(self, TokenType.SEMI_COLON, "Expected ';' after return statement");
	return self.b().return_stmt(value, kw.line, kw.col);
}

pub fn parse_when_stmt(var self: &Parser): *AstNode {
	val kw = advance(self); // 'when'
	// `when (cond) { ... }` or the boolean form `when { cond -> ... }`.
	var condition: *AstNode = null;
	if (match_token(self, TokenType.OPEN_PAREN)) {
		condition = parse_expression(self, PREC_NONE);
		consume(self, TokenType.CLOSE_PAREN, "Expected ')' after when condition");
	}
	consume(self, TokenType.OPEN_BRACE, "Expected '{' before when statement arms");

	var arms = List<WhenStmtArm>();
	while (!check(self, TokenType.CLOSE_BRACE) && !is_end(self)) {
		val arm_line = peek(self).line;
		val arm_col = peek(self).col;
		var is_else = false;
		var patterns = List<*AstNode>();

		if (match_token(self, TokenType.KW_ELSE)) is_else = true;
		else {
			patterns.add(parse_expression(self, PREC_NONE));
			while (match_token(self, TokenType.COMMA)) {
				patterns.add(parse_expression(self, PREC_NONE));
			}
		}

		consume(self, TokenType.ARROW, "Expected '->' after when arm pattern");
		val body = parse_statement(self);
		arms.add(WhenStmtArm(patterns, is_else, body, arm_line, arm_col));

		match_token(self, TokenType.COMMA);
		match_token(self, TokenType.SEMI_COLON);
	}

	consume(self, TokenType.CLOSE_BRACE, "Expected '}' after when statement arms");
	return self.b().when_stmt(condition, arms, kw.line, kw.col);
}

pub fn parse_statement(var self: &Parser): *AstNode {
	val tok = peek(self);
	val line = tok.line;
	val col = tok.col;

	return when (tok.type) {
		TokenType.OPEN_BRACE -> parse_block_stmt(self);
		TokenType.KW_VAL, TokenType.KW_VAR -> parse_var_decl_stmt(self);
		TokenType.KW_IF -> parse_if_stmt(self);
		TokenType.KW_WHILE -> parse_while_stmt(self);
		TokenType.KW_FOR -> parse_for_stmt(self);
		TokenType.KW_RETURN -> parse_return_stmt(self);
		TokenType.KW_WHEN -> parse_when_stmt(self);
		TokenType.KW_BREAK -> {
			advance(self);
			consume(self, TokenType.SEMI_COLON, "Expected ';' after break");
			yield self.b().break_stmt(line, col);
		}
		TokenType.KW_CONTINUE -> {
			advance(self);
			consume(self, TokenType.SEMI_COLON, "Expected ';' after continue");
			yield self.b().continue_stmt(line, col);
		}
		TokenType.KW_YIELD -> {
			advance(self);
			var value: *AstNode = null;
			if (!check(self, TokenType.SEMI_COLON)) value = parse_expression(self, PREC_NONE);
			consume(self, TokenType.SEMI_COLON, "Expected ';' after yield");
			yield self.b().yield_stmt(value, line, col);
		}
		else -> {
			val expr = parse_expression(self, PREC_NONE);
			var res_stmt: *AstNode = null;
			if (match_token(self, TokenType.PLUS_PLUS)) {
				val op_tok = previous(self);
				consume(self, TokenType.SEMI_COLON, "Expected ';' after '++'");
				res_stmt = self.b().expr_stmt(self.b().update(TokenType.PLUS_PLUS, expr, op_tok.line, op_tok.col), line, col);
			} else if (match_token(self, TokenType.MINUS_MINUS)) {
				val op_tok = previous(self);
				consume(self, TokenType.SEMI_COLON, "Expected ';' after '--'");
				res_stmt = self.b().expr_stmt(self.b().update(TokenType.MINUS_MINUS, expr, op_tok.line, op_tok.col), line, col);
			} else {
				consume(self, TokenType.SEMI_COLON, "Expected ';' after expression statement");
				res_stmt = self.b().expr_stmt(expr, line, col);
			}
			yield res_stmt;
		}
	};
}
