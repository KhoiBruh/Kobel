mod compiler.parser.decl;

use compiler.lexer.token.*;

use compiler.ast.builder.*;
use compiler.ast.node.AstNode;
use compiler.ast.decl.*;

use compiler.parser.parser.*;

use compiler.parser.types.parse_type;
use compiler.parser.expr.*;
use compiler.parser.stmt.*;

use std.collections.list.*;

// ============================================================================
// Generic Parameter Parsing
// ============================================================================

impl Parser {

	pub fn parse_generic_params(var self): List<GenericParam> {
		var params = List<GenericParam>();
		if (!self.match_token(TokenType.LESS)) return params;

		if (!self.check(TokenType.GREATER)) {
			val p_tok = self.consume(TokenType.IDENTIFIER, "Expected generic parameter name");
			var bounds = List<str>();
			if (self.match_token(TokenType.COLON)) {
				val b_tok = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
				bounds.add(b_tok.text);
				while (self.match_token(TokenType.PLUS)) {
					val b2 = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
					bounds.add(b2.text);
				}
			}
			params.add(GenericParam(p_tok.text, bounds));

			while (self.match_token(TokenType.COMMA)) {
				val next_p = self.consume(TokenType.IDENTIFIER, "Expected generic parameter name");
				var next_bounds = List<str>();
				if (self.match_token(TokenType.COLON)) {
					val b_tok = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
					next_bounds.add(b_tok.text);
					while (self.match_token(TokenType.PLUS)) {
						val b2 = self.consume(TokenType.IDENTIFIER, "Expected trait bound name");
						next_bounds.add(b2.text);
					}
				}
				params.add(GenericParam(next_p.text, next_bounds));
			}
		}

		self.consume(TokenType.GREATER, "Expected '>' after generic parameters");
		return params;
	}

	// ============================================================================
	// Top-Level Declarations
	// ============================================================================

	pub fn parse_fn_decl(var self, is_pub: bool): *AstNode {
		val kw = self.advance(); // 'fn'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected function name");
		val type_params = self.parse_generic_params();

		self.consume(TokenType.OPEN_PAREN, "Expected '(' after function name");
		var params = List<Param>();

		if (!self.check(TokenType.CLOSE_PAREN)) {
			var is_mut = false;
			var has_val = false;
			if (self.match_token(TokenType.KW_VAR)) is_mut = true;
			else if (self.match_token(TokenType.KW_VAL)) has_val = true;

			val pname = self.consume(TokenType.IDENTIFIER, "Expected parameter name");
			var ptype: *AstNode = null;
			if (self.match_token(TokenType.COLON)) {
				ptype = self.parse_type();
			} else if (pname.text != "self") {
				self.consume(TokenType.COLON, "Expected ':' after parameter name");
				ptype = self.parse_type();
			}
			params.add(Param(pname.text, ptype, is_mut, has_val));

			while (self.match_token(TokenType.COMMA)) {
				var p_is_mut = false;
				var p_has_val = false;
				if (self.match_token(TokenType.KW_VAR)) p_is_mut = true;
				else if (self.match_token(TokenType.KW_VAL)) p_has_val = true;

				val p_name = self.consume(TokenType.IDENTIFIER, "Expected parameter name");
				var p_type: *AstNode = null;
				if (self.match_token(TokenType.COLON)) {
					p_type = self.parse_type();
				} else if (p_name.text != "self") {
					self.consume(TokenType.COLON, "Expected ':' after parameter name");
					p_type = self.parse_type();
				}
				params.add(Param(p_name.text, p_type, p_is_mut, p_has_val));
			}
		}

		self.consume(TokenType.CLOSE_PAREN, "Expected ')' after parameters");

		val return_type = if (self.match_token(TokenType.COLON)) self.parse_type() else null;

		var body = when {
			// Expression body: => expr;
			self.match_token(TokenType.FAT_ARROW) -> {
				val expr = self.parse_expression(PREC_NONE);
				self.consume(TokenType.SEMI_COLON, "Expected ';' after expression body");
				yield self.b().expr_stmt(expr, expr.line, expr.col);
			}

			// Block body: { ... }
			self.check(TokenType.OPEN_BRACE) -> self.parse_block_stmt();

			// Extern or prototype: ;
			else -> {
				self.consume(TokenType.SEMI_COLON, "Expected ';' or '{' for function body");
				yield null;
			}
		};
		
		return self.b().fn_decl(name_tok.text, type_params, params, return_type, body, is_pub, kw.line, kw.col);
	}

	pub fn parse_struct_decl(var self, is_pub: bool): *AstNode {
		val kw = self.advance(); // 'struct'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected struct name");
		val type_params = self.parse_generic_params();

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before struct fields");
		var fields = List<StructField>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var f_pub = false;
			if (self.match_token(TokenType.KW_PUB)) f_pub = true;

			val fname = self.consume(TokenType.IDENTIFIER, "Expected field name");
			self.consume(TokenType.COLON, "Expected ':' after field name");
			val ftype = self.parse_type();
			fields.add(StructField(fname.text, ftype, f_pub));

			self.match_token(TokenType.COMMA);
			self.match_token(TokenType.SEMI_COLON);
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after struct fields");
		return self.b().struct_decl(name_tok.text, type_params, fields, is_pub, kw.line, kw.col);
	}

	pub fn parse_trait_decl(var self, is_pub: bool): *AstNode {
		val kw = self.advance(); // 'trait'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected trait name");
		val type_params = self.parse_generic_params();

		var bases = List<str>();
		if (self.match_token(TokenType.COLON)) {
			val base1 = self.consume(TokenType.IDENTIFIER, "Expected base trait name");
			bases.add(base1.text);
			while (self.match_token(TokenType.PLUS)) {
				val next_base = self.consume(TokenType.IDENTIFIER, "Expected base trait name");
				bases.add(next_base.text);
			}
		}

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before trait body");
		var methods = List<*AstNode>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var m_pub = false;

			when {
				self.match_token(TokenType.KW_PUB) -> m_pub = true;

				self.check(TokenType.KW_FN) -> methods.add(self.parse_fn_decl(m_pub));

				else -> {
					val tok = self.peek();
					self.error(tok, "Expected method declaration inside trait");
					self.advance();
				}
			}
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after trait body");
		return self.b().trait_decl(name_tok.text, type_params, bases, methods, is_pub, kw.line, kw.col);
	}

	pub fn parse_impl_decl(var self): *AstNode {
		val kw = self.advance(); // 'impl'
		var type_params = self.parse_generic_params();
		val first_name = self.consume(TokenType.IDENTIFIER, "Expected struct or trait name").text;

		if (
			type_params.is_empty() && 
			self.check(TokenType.LESS)
		) type_params = self.parse_generic_params();

		var struct_name = first_name;
		var trait_name = "";

		if (self.match_token(TokenType.KW_FOR)) {
			trait_name = first_name;
			val s_tok = self.consume(TokenType.IDENTIFIER, "Expected struct name after 'for'");
			struct_name = s_tok.text;
			if (self.check(TokenType.LESS)) {
				val s_params = self.parse_generic_params();
				for (p in s_params) type_params.add(p);
			}
		}

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before impl body");
		var methods = List<*AstNode>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			var m_pub = false;

			when {
				self.match_token(TokenType.KW_PUB) -> m_pub = true;

				self.check(TokenType.KW_FN) -> methods.add(self.parse_fn_decl(m_pub));

				else -> {
					val tok = self.peek();
					self.error(tok, "Expected method declaration inside impl");
					self.advance();
				}
			}
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after impl body");
		return self.b().impl_decl(struct_name, type_params, trait_name, methods, kw.line, kw.col);
	}

	pub fn parse_enum_decl(var self, is_pub: bool): *AstNode {
		val kw = self.advance(); // 'enum'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected enum name");
		val underlying_type = if (self.match_token(TokenType.COLON)) self.parse_type() else null;

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before enum members");
		var members = List<EnumMember>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			val m_tok = self.consume(TokenType.IDENTIFIER, "Expected enum member name");
			val m_val = if (self.match_token(TokenType.EQUAL)) self.parse_expression(PREC_NONE) else null;
			members.add(EnumMember(m_tok.text, m_val, m_tok.line, m_tok.col));

			self.match_token(TokenType.COMMA);
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after enum members");
		return self.b().enum_decl(name_tok.text, underlying_type, members, is_pub, kw.line, kw.col);
	}

	pub fn parse_const_decl(var self, is_pub: bool): *AstNode {
		val kw = self.advance(); // 'const'
		val name_tok = self.consume(TokenType.IDENTIFIER, "Expected constant name");
		val type_node = if (self.match_token(TokenType.COLON)) self.parse_type() else null;

		self.consume(TokenType.EQUAL, "Expected '=' in const declaration");
		val val_node = self.parse_expression(PREC_NONE);
		self.consume(TokenType.SEMI_COLON, "Expected ';' after const declaration");

		return self.b().const_decl(name_tok.text, type_node, val_node, is_pub, kw.line, kw.col);
	}

	pub fn parse_module_decl(var self): *AstNode {
		val kw = self.advance(); // 'mod'
		var path = List<str>();
		val first_seg = self.consume(TokenType.IDENTIFIER, "Expected module path segment").text;
		path.add(first_seg);
		var full_path = first_seg;

		while (self.match_token(TokenType.DOT)) {
			val seg = self.consume(TokenType.IDENTIFIER, "Expected module path segment after '.'").text;
			path.add(seg);
			full_path = "${full_path}.${seg}";
		}

		self.consume(TokenType.SEMI_COLON, "Expected ';' after module declaration");
		return self.b().module_decl(path, full_path, kw.line, kw.col);
	}

	pub fn parse_use_decl(var self): *AstNode {
		val kw = self.advance(); // 'use'
		var path = List<str>();
		val first_seg = self.consume(TokenType.IDENTIFIER, "Expected path in use declaration").text;
		path.add(first_seg);
		var full_path = first_seg;
		var is_wildcard = false;
		var symbol_name = first_seg;
		var alias = "";

		while (self.match_token(TokenType.DOT)) {
			if (self.match_token(TokenType.STAR)) {
				is_wildcard = true;
				full_path = "${full_path}.*";
				break;
			}
			val seg = self.consume(TokenType.IDENTIFIER, "Expected path segment after '.'").text;
			path.add(seg);
			symbol_name = seg;
			full_path = "${full_path}.${seg}";
		}

		if (self.match_token(TokenType.KW_AS)) {
			alias = self.consume(TokenType.IDENTIFIER, "Expected alias after 'as'").text;
		}

		self.consume(TokenType.SEMI_COLON, "Expected ';' after use declaration");
		return self.b().use_decl(path, full_path, symbol_name, alias, is_wildcard, kw.line, kw.col);
	}

	pub fn parse_extern_block(var self): *AstNode {
		val kw = self.advance(); // 'extern'
		var abi = "C";
		if (self.check(TokenType.STRING)) abi = self.advance().text;

		self.consume(TokenType.OPEN_BRACE, "Expected '{' before extern declarations");
		var declarations = List<*AstNode>();

		while (!self.check(TokenType.CLOSE_BRACE) && !self.is_end()) {
			declarations.add(self.parse_declaration());
		}

		self.consume(TokenType.CLOSE_BRACE, "Expected '}' after extern declarations");
		return self.b().extern_block(abi, declarations, kw.line, kw.col);
	}

	pub fn parse_declaration(var self): *AstNode {
		var is_pub = false;
		if (self.match_token(TokenType.KW_PUB)) is_pub = true;

		val tok = self.peek();
		return when (tok.type) {
			TokenType.KW_FN -> self.parse_fn_decl(is_pub);
			TokenType.KW_STRUCT -> self.parse_struct_decl(is_pub);
			TokenType.KW_TRAIT -> self.parse_trait_decl(is_pub);
			TokenType.KW_IMPL -> self.parse_impl_decl();
			TokenType.KW_ENUM -> self.parse_enum_decl(is_pub);
			TokenType.KW_CONST -> self.parse_const_decl(is_pub);
			TokenType.KW_MOD -> self.parse_module_decl();
			TokenType.KW_USE -> self.parse_use_decl();
			TokenType.KW_EXTERN -> self.parse_extern_block();
			else -> {
				// Top-level statement or syntax error
				if (is_pub) self.error(tok, "'pub' modifier is not allowed on this statement");
				val stmt = self.parse_statement();
				yield stmt;
			}
		};
	}

	pub fn parse_program(var self): *AstNode {
		var declarations = List<*AstNode>();

		while (!self.is_end()) {
			declarations.add(self.parse_declaration());
		}

		return self.b().program(declarations, 1, 1);
	}

}
