mod compiler.core;

use std.ascii.*;
use std.collections.*;
use std.filesystem.*;
use std.io.*;
use std.string.*;

/*
 * ============================================================================
 * compiler.core.diagnostic — Structured compiler diagnostics and reporting
 *
 * Every compiler pass reports `Diagnostic` records (severity + span + file);
 * `DiagnosticBag` adds deduplication for passes that want it.
 * ============================================================================
 */

pub enum Severity: i64 {
	ERROR,
	WARNING,
	NOTE
}

pub struct Diagnostic {
	pub severity: Severity,
	// Location fields are stored flat (not as a nested `Span`): the compiler
	// lays out a struct as soon as its declaration is collected, and a nested
	// struct declared in a later file would still have size 0 at that point.
	pub file_id: u32,
	pub line: usz,
	pub col: usz,
	pub length: usz,
	pub file_path: str,
	pub message: str,
	pub hint: str = ""
}

impl Diagnostic {

	pub init(
		severity: Severity,
		span: Span,
		file_path: str,
		message: str,
		hint: str = ""
	) => Self(
		severity, span.file_id, span.line, span.col, span.length,
		file_path, message, hint
	);

	pub fn error(span: Span, file_path: str, message: str, hint: str = "")
		=> Diagnostic(Severity.ERROR, span, file_path, message, hint);

	pub fn warning(span: Span, file_path: str, message: str, hint: str = "")
		=> Diagnostic(Severity.WARNING, span, file_path, message, hint);

	pub fn span(*self): Span => Span(self.file_id, self.line, self.col, self.length);

	pub fn key(*self) => "${self.file_path}:${self.line}:${self.col}:${self.message}";

	pub fn render(*self, sources: *SourceMap? = null): str {
		val c_red = "\x1b[1;31m";
		val c_yellow = "\x1b[1;33m";
		val c_blue = "\x1b[1;34m";
		val c_bold = "\x1b[1m";
		val c_reset = "\x1b[0m";

		val prefix = when (self.severity) {
			Severity.WARNING -> "${c_yellow}warning${c_reset}";
			Severity.NOTE -> "${c_blue}note${c_reset}";
			else -> "${c_red}error${c_reset}";
		};

		var sb = StringBuilder(256);
		defer sb.free();

		sb += prefix;
		sb += c_bold;
		sb += ": ";
		sb += self.message;
		sb += c_reset;
		sb += '\n';

		if (!self.file_path.empty()) {
			sb += "  ";
			sb += c_blue;
			sb += "-->";
			sb += c_reset;
			sb += ' ';
			sb += self.file_path;

			if (self.line > 0) {
				sb += ':';
				sb += self.line;
				sb += ':';
				sb += self.col;
			}
			sb += '\n';
		}

		var raw_line = "";
		var have_line = false;

		if (self.line > 0) {
			if (sources != null) {
				val sf = if (self.file_id > 0) sources.get_file(self.file_id)
						else sources.find_by_path(self.file_path);

				if (sf != null && self.line <= sf.lines.len) {
					raw_line = sf.line_text(self.line);
					have_line = true;
				}
			}

			if (!have_line && !self.file_path.empty()) {
				val fp = Path(self.file_path);
				if (fp.exists()) {
					val content = fp.read_text();
				if (!content.empty()) {
					val lines = content.split_lines();
					defer lines.free();

					if (self.line in 1..lines.len) {
						raw_line = lines[self.line - 1];
						have_line = true;
					}
				}
				}
			}
		}

		if (have_line) {
			val line_str = "${self.line}";
			val gutter_w = if (line_str.len < 2) 2 else line_str.len;

			sb += ' ';
			if (gutter_w > line_str.len) sb.append_repeat(' ', gutter_w - line_str.len);
			sb.append_repeat(' ', line_str.len);
			sb += ' ';
			sb += c_blue;
			sb += '|';
			sb += c_reset;
			sb += '\n';

			sb += ' ';
			sb += c_blue;
			if (gutter_w > line_str.len) sb.append_repeat(' ', gutter_w - line_str.len);
			sb += line_str;
			sb += " |";
			sb += c_reset;
			sb += ' ';
			sb += raw_line;
			sb += '\n';

			sb += ' ';
			sb.append_repeat(' ', gutter_w);
			sb += ' ';
			sb += c_blue;
			sb += '|';
			sb += c_reset;
			sb += ' ';

			val limit = if (self.col > 1) self.col - 1 else 0;
			for (i in 0..<limit) {
				if (i < raw_line.len && raw_line[i] == '\t') {
					sb += '\t';
				} else {
					sb += ' ';
				}
			}

			val caret_color = if (self.severity == Severity.WARNING) c_yellow else c_red;
			sb += caret_color;
			val caret_len = if (self.length > 1) self.length else 1;
			sb.append_repeat('^', caret_len);
			sb += c_reset;
			sb += '\n';
		}

		if (!self.hint.empty()) {
			sb += "  ";
			sb += c_blue;
			sb += "= help: ";
			sb += c_reset;
			sb += self.hint;
			sb += '\n';
		}

		return sb.to_str();
	}

}

pub struct DiagnosticBag {
	pub items: List<Diagnostic>,
	seen: HashSet<str>,
	pub error_count: usz = 0,
	pub warning_count: usz = 0
}

impl DiagnosticBag {

	pub init() => Self(List<Diagnostic>(), HashSet<str>());

	pub fn has_errors(*self) => self.error_count > 0;

	pub fn empty(*self) => self.items.empty();

	pub fn add(&self, diagnostic: Diagnostic) {
		val key = diagnostic.key();
		if (key in self.seen) return;

		self.seen += key;
		self.items += diagnostic;

		when (diagnostic.severity) {
			Severity.ERROR -> self.error_count++;
			Severity.WARNING -> self.warning_count++;
		}
	}

	pub fn report_error(
		&self, span: Span,
		file_path: str, message: str, hint: str = ""
	) => self.add(Diagnostic.error(span, file_path, message, hint));

	pub fn report_warning(
		&self, span: Span,
		file_path: str, message: str, hint: str = ""
	) => self.add(Diagnostic.warning(span, file_path, message, hint));

	pub fn print_all(*self, default_file: str, sources: *SourceMap? = null) {
		for (d in self.items) {
			print(d.render(sources));
			println("");
		}

		if (self.error_count > 0) {
			println("\x1b[1;31merror\x1b[0m: could not compile '${default_file}' due to ${self.error_count} previous error(s)");
		}
	}

	pub fn free(self) {
		self.items.free();
		self.seen.free();
	}

}
