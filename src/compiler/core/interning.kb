mod compiler.core;

use std.collections.*;

/*
 * ============================================================================
 * compiler.core.interning — String interning pool
 *
 * Maps strings to compact 32-bit `SymbolId` handles (and back in O(1)) so
 * identifier comparisons, module names, and symbol lookups can operate on
 * integer IDs without repeated string hashing or byte comparisons.
 * ============================================================================
 */

pub struct SymbolId {
	pub id: u32 = 0
}

impl SymbolId {

	pub init(id: u32 = 0) => Self(id);

	pub fn is_valid(val self) => self.id != 0;

	pub op equals(val self, other: Self) => self.id == other.id;

}

impl Hash for SymbolId {
	fn hash(val self): usz => (self.id as usz).hash();
}

impl Stringer for SymbolId {
	fn to_str(val self): str => "${self.id}";
}

pub struct InternPool {
	strings: List<str>,
	lookup: HashMap<str, u32>
}

impl InternPool {

	pub init() => Self(List<str>(), HashMap<str, u32>());

	pub fn intern(var self, text: str): SymbolId {
		if (text.empty()) {
			return SymbolId(0);
		}
		val found = self.lookup[text];
		if (found != null) {
			return SymbolId(*found);
		}
		val next_id = (self.strings.len + 1) as u32;
		self.strings += text;
		self.lookup[text] = next_id;
		return SymbolId(next_id);
	}

	pub fn resolve(val self, sym: SymbolId): str {
		if (sym.id == 0 || (sym.id as usz) > self.strings.len) {
			return "";
		}
		return self.strings[(sym.id - 1) as usz];
	}

	pub fn count(val self) => self.strings.len;

	pub fn free(self) {
		self.strings.free();
		self.lookup.free();
	}

}
