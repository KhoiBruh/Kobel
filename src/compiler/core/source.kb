mod compiler.core;

use std.collections.*;

/*
 * ============================================================================
 * compiler.core.source — Source spans, files, and compilation source map
 *
 * Provides strongly-typed source location tracking (`Span`) and an indexed
 * table of loaded source files (`SourceMap`) so diagnostics and IDE tooling
 * never need to re-read files from disk or depend on the module loader.
 * ============================================================================
 */

pub struct Span {
	pub file_id: u32 = 0,
	pub line: usz = 0,
	pub col: usz = 0,
	pub length: usz = 1
}

impl Span {

	pub init(file_id: u32 = 0, line: usz = 0, col: usz = 0, length: usz = 1)
		=> Self(file_id, line, col, if (length == 0) 1 else length);

	pub fn is_valid(*self) => self.line > 0;

	pub op unpack(*self, line: &usz, col: &usz) {
		line.write(self.line);
		col.write(self.col);
	}

	pub op unpack(*self, file_id: &u32, line: &usz, col: &usz, length: &usz) {
		file_id.write(self.file_id);
		line.write(self.line);
		col.write(self.col);
		length.write(self.length);
	}

}

pub struct SourceFile {
	pub id: u32,
	pub path: str,
	pub module_name: str,
	pub content: str
}

impl SourceFile {

	pub init(id: u32, path: str, module_name: str, content: str)
		=> Self(id, path, module_name, content);

	pub fn line_count(*self): usz {
		if (self.content.empty()) return 0;
		var count: usz = 1;
		for (i in 0..<self.content.len) {
			if (self.content[i] == '\n') count++;
		}
		return count;
	}

	pub fn line_text(*self, line_num: usz): str {
		if (line_num == 0 || self.content.empty()) return "";
		var curr_line: usz = 1;
		var line_start: usz = 0;
		for (i in 0..<self.content.len) {
			val c = self.content[i];
			if (c == '\n') {
				if (curr_line == line_num) {
					var line_end = i;
					if (line_end > line_start && self.content[line_end - 1] == '\r') {
						line_end--;
					}
					return self.content.slice(line_start, line_end);
				}
				curr_line++;
				line_start = i + 1;
			}
		}
		if (curr_line == line_num && line_start <= self.content.len) {
			var line_end = self.content.len;
			if (line_end > line_start && self.content[line_end - 1] == '\r') {
				line_end--;
			}
			return self.content.slice(line_start, line_end);
		}
		return "";
	}

}

pub struct SourceMap {
	pub files: List<SourceFile>,
	path_index: HashMap<str, u32>,
	module_index: HashMap<str, u32>
}

impl SourceMap {

	pub init() => Self(
		List<SourceFile>(),
		HashMap<str, u32>(),
		HashMap<str, u32>()
	);

	pub fn add_file(&self, path: str, module_name: str, content: str): u32 {
		val existing = self.path_index[path];
		if (existing != null) return *existing;

		val id = (self.files.len + 1) as u32;
		self.files += SourceFile(id, path, module_name, content);
		self.path_index[path] = id;
		if (!module_name.empty()) self.module_index[module_name] = id;

		return id;
	}

	pub fn get_file(*self, file_id: u32): ?*SourceFile {
		if (file_id == 0 || file_id > self.files.len) return null;
		return &self.files.data[file_id - 1];
	}

	pub fn find_by_path(*self, path: str): ?*SourceFile {
		val id_ptr = self.path_index[path] ?: return null;
		return self.get_file(*id_ptr);
	}

	pub fn find_by_module(*self, module_name: str): ?*SourceFile {
		val id_ptr = self.module_index[module_name] ?: return null;
		return self.get_file(*id_ptr);
	}

	pub fn count(*self) => self.files.len;

	pub fn free(self) {
		self.files.free();
		self.path_index.free();
		self.module_index.free();
	}

}
