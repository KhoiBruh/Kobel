mod compiler.core;

use std.string.*;
use std.filesystem.str_is_sep;
use std.memory.*;
use std.collections.List;

/*
 * ============================================================================
 * compiler.core.naming — Compiler module paths, symbol mangling, and stamps
 *
 * Shared across loader, semantic analysis, driver, and LSP. Depends only on
 * the standard library (Layer 0).
 * ============================================================================
 */

impl str {

	// "std.io" -> "std/io" (module path -> relative file path, without extension)
	pub fn module_to_rel(*self) => self.replace_char('.', '/');

	// "sub/x.kb" -> "sub.x" (relative file path -> module name)
	pub fn path_to_module(*self): str {
		val stem = self.strip_kb();
		val buf = Heap.create_array<u8>(stem.len + 1);
		for (i in 0..<stem.len) {
			val c = stem[i];
			if (str_is_sep(c)) {
				buf[i] = '.'.code();
			} else {
				buf[i] = c.code();
			}
		}
		buf[stem.len] = 0;
		return str_from_bytes(buf, stem.len);
	}

	pub fn has_kb_suffix(*self) => self.ends_with(".kb");

	// Strips a trailing ".kb" extension when present.
	pub fn strip_kb(*self) => if (self.ends_with(".kb")) self.strip_suffix(3) else self;

	/*
	 * Builds the C identifier used for a top-level symbol of a module.
	 * "std.io" + "println" -> "std__io__println"
	 */
	pub fn mangle_symbol(*self, name: str): str {
		if (self.empty()) return name;

		// Each '.' is written as 2 '_' characters, so allocate extra (2x the module part) to be safe.
		val total = self.len * 2 + 2 + name.len;
		val buf = Heap.create_array<u8>(total + 1);

		var w = 0;
		for (c in self) {
			when (c) {
				'.' -> {
					buf[w] = '_'.code();
					buf[w + 1] = '_'.code();
					w += 2;
				}
				'_', '-' -> {
					// keep '_' as is, map '-' to '_' to stay a valid C identifier
					buf[w] = '_'.code();
					w++;
				}
				else -> {
					buf[w] = c.code();
					w++;
				}
			}
		}

		buf[w] = '_'.code();
		buf[w + 1] = '_'.code();
		w += 2;
		for (c in name) {
			buf[w] = c.code();
			w++;
		}

		buf[w] = 0;
		return str_from_bytes(buf, w);
	}

	pub fn hash_stamp(*self): str {
		var h = 5381;
		for (c in self) h = ((h * 33) + c.code()) % 1000000007;
		return "${h}_${self.len}";
	}

}

pub fn str_join_dots(parts: List<str>, count: usz): str {
	var total = 0;
	for (i in 0..<count) total += parts[i].len;
	if (count > 1) total += (count - 1);

	val buf = Heap.create_array<u8>(total + 1);
	var w = 0;
	for (i in 0..<count) {
		val p = parts[i];
		for (c in p) {
			buf[w] = c.code();
			w++;
		}
		if (i + 1 < count) {
			buf[w] = '.'.code();
			w++;
		}
	}

	buf[w] = 0;
	return str_from_bytes(buf, w);
}
