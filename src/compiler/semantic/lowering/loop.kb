mod compiler.semantic.lowering;

/*
 * ============================================================================
 * For-Loop AST Lowering (Desugaring)
 *
 * Rewrites `for (x in seq)` (Iterable vs `.len`/`.data`) and the three range
 * forms into a block + `while`, keeping `continue` semantics (step injection)
 * and unsigned-safe counters.
 * ============================================================================
 */

use std.memory.Arena;
use std.collections.List;

use compiler.lexer.TokenType;
use compiler.ast.*;

/*
 * A `continue` rewrite discovered while building the loop body. The checker
 * owns the semantic side table, so lowering hands these back instead of
 * writing annotations itself (that write is what used to couple lowering to
 * BodyChecker).
 */
pub struct PendingResolve {
	pub node: *AstNode,
	pub target: *AstNode
}

// The iterated expression is re-evaluated on every iteration, so only lvalues
// are accepted: a temporary would dangle and a call would run once per element.
pub fn for_is_lvalue(node: *AstNode?): bool {
	if (node == null) return false;
	val target = node!;
	return when (target) {
		is MemberExpr -> if (target.is_safe) false else for_is_lvalue(target.object);
		is GroupExpr -> for_is_lvalue(target.expr);
		is IdentifierExpr -> true;
		is UnaryExpr -> if (target.op == TokenType.AMPERSAND) for_is_lvalue(target.operand) else false;
		else -> false;
	};
}

pub fn parse_destruct_names(text: str): List<str> {
	var names = List<str>();
	var start: isz = -1;
	for (i in 0..<text.len) {
		val ch = text[i];
		if (ch == '(' || ch == ')' || ch == ' ' || ch == '\t' || ch == ',') {
			if (start >= 0) {
				names += text.slice(start as usz, i);
				start = -1;
			}
		} else {
			if (start < 0) {
				start = i as isz;
			}
		}
	}
	if (start >= 0) {
		names += text.slice(start as usz);
	}
	return names;
}

/*
 * Loop lowering owns an `Arena` for node construction; it must not add methods to the
 * stdlib Arena type (module path = file path, and std stays compiler-agnostic).
 */
pub struct LoopLowerer {
	pub arena: Arena
}

impl LoopLowerer {

	fn loop_block(var self, stmts: List<*AstNode>, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.BlockStmt(stmts), line, col);

	fn loop_expr(var self, expr: *AstNode, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.ExprStmt(expr), line, col);

	fn loop_var(
		var self,
		mutable: bool,
		name: str,
		ty: *AstNode?,
		initializer: *AstNode?,
		line: usz,
		col: usz
	): *AstNode => self.arena.node(NodeData.VarDeclStmt(mutable, name, ty, initializer), line, col);

	fn loop_var_or_destruct(
		var self,
		var_name: str,
		elem_expr: *AstNode,
		line: usz,
		col: usz
	): *AstNode {
		val is_var_destruct = var_name.starts_with("var (") && var_name.ends_with(")");
		val is_val_destruct = var_name.starts_with("(") && var_name.ends_with(")");
		if (is_var_destruct || is_val_destruct) {
			val raw = if (is_var_destruct) var_name.slice(4) else var_name;
			val names = parse_destruct_names(raw);
			return self.arena.node(
				NodeData.DestructDeclStmt(is_var_destruct, names, elem_expr),
				line, col
			);
		}
		return self.loop_var(false, var_name, null, elem_expr, line, col);
	}

	fn loop_if(
		var self,
		cond: *AstNode,
		then_b: *AstNode,
		else_b: *AstNode?,
		line: usz,
		col: usz
	): *AstNode => self.arena.node(NodeData.IfStmt(cond, then_b, else_b), line, col);

	fn loop_while(var self, cond: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.WhileStmt(cond, body), line, col);

	pub fn for_usz_type(var self, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.NamedType("usz", List<*AstNode>()), line, col);

	pub fn for_id(var self, name: str, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.IdentifierExpr(name), line, col);

	pub fn for_num(var self, text: str, line: usz, col: usz): *AstNode =>
		self.arena.node(NodeData.LiteralExpr(Literal.INTEGER, text), line, col);

	// `__for_i <cmp> __for_e`
	pub fn for_i_cmp(var self, op: TokenType, line: usz, col: usz): *AstNode {
		val lhs = self.for_id("__for_i", line, col);
		val rhs = self.for_id("__for_e", line, col);
		return self.arena.node(NodeData.BinaryExpr(lhs, op, rhs), line, col);
	}

	// `__for_go = <value>;`
	pub fn for_set_go(var self, value: *AstNode, line: usz, col: usz): *AstNode {
		val lhs = self.for_id("__for_go", line, col);
		val asgn = self.arena.node(NodeData.AssignExpr(lhs, TokenType.EQUAL, value), line, col);
		return self.loop_expr(asgn, line, col);
	}

	// `__for_i = __for_i <+|-> 1;`
	pub fn for_bump(var self, op: TokenType, line: usz, col: usz): *AstNode {
		val target = self.for_id("__for_i", line, col);
		val lhs = self.for_id("__for_i", line, col);
		val one = self.for_num("1", line, col);
		val bin = self.arena.node(NodeData.BinaryExpr(lhs, op, one), line, col);
		val asgn = self.arena.node(NodeData.AssignExpr(target, TokenType.EQUAL, bin), line, col);
		return self.loop_expr(asgn, line, col);
	}

	// `if (__for_up) { <up_stmt> } else { <down_stmt> }`
	pub fn for_by_dir(
		var self,
		up_stmt: *AstNode,
		down_stmt: *AstNode,
		line: usz,
		col: usz
	): *AstNode {
		var up_stmts = List<*AstNode>();
		up_stmts += up_stmt;
		var down_stmts = List<*AstNode>();
		down_stmts += down_stmt;
		return self.loop_if(
			self.for_id("__for_up", line, col),
			self.loop_block(up_stmts, line, col),
			self.loop_block(down_stmts, line, col),
			line, col
		);
	}

	// Replaces every `continue` belonging to this loop with `{ <step>; continue; }`
	// so `continue` cannot skip the counter update.
	pub fn for_inject_step(
		var self,
		node: *AstNode?,
		step: &List<*AstNode>,
		pending: &List<PendingResolve>
	) {
		if (node == null) return;

		val target = node;
		when (target) {
			is BlockStmt -> for (stmt in target.statements) self.for_inject_step(stmt, step, pending);
			is IfStmt -> {
				self.for_inject_step(target.then_branch, step, pending);
				self.for_inject_step(target.else_branch, step, pending);
			}
			is WhenStmt -> for (arm in target.arms) self.for_inject_step(arm.body, step, pending);
			is VarDeclStmt -> self.for_inject_step_expr(target.initializer, step, pending);
			is DestructDeclStmt -> self.for_inject_step_expr(target.initializer, step, pending);
			is ExprStmt -> self.for_inject_step_expr(target.expr, step, pending);
			is ContinueStmt -> {
				var stmts = List<*AstNode>();
				for (s in step) stmts += s;
				stmts += self.arena.node(NodeData.ContinueStmt, node.line, node.col);
				val block = self.loop_block(stmts, node.line, node.col);
				pending += PendingResolve(node!, block);
			}
		}
	}

	fn for_inject_step_expr(
		var self,
		expr: *AstNode?,
		step: &List<*AstNode>,
		pending: &List<PendingResolve>
	) {
		if (expr == null) return;
		var cur = expr;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		if (cur == null) return;
		if (cur is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
			self.for_inject_step(bin.right, step, pending);
		} else if (cur is AssignExpr as asg) {
			self.for_inject_step_expr(asg.value, step, pending);
		}
	}

	// `for (v in seq)` where `seq` implements `Iterable`: index through the trait.
	pub fn desugar_for_iter_method(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_n: usz = <iterable>.count();
		val count_mem = self.arena.node(NodeData.MemberExpr(fs.iterable!, "count", false), line, col);
		val count_call = self.arena.node(
			NodeData.CallExpr(count_mem, List<*AstNode>(), List<*AstNode>()),
			line, col
		);
		pre += self.loop_var(false, "__for_n", self.for_usz_type(line, col), count_call, line, col);

		// var __for_i: usz = 0;
		pre += self.loop_var(
			true, "__for_i", self.for_usz_type(line, col),
			self.for_num("0", line, col), line, col
		);

		// val <v> = <iterable>.at(__for_i);
		var at_args = List<*AstNode>();
		at_args += self.for_id("__for_i", line, col);
		val at_mem = self.arena.node(NodeData.MemberExpr(fs.iterable!, "at", false), line, col);
		val at_call = self.arena.node(NodeData.CallExpr(at_mem, at_args, List<*AstNode>()), line, col);
		head += self.loop_var_or_destruct(fs.var_name, at_call, line, col);

		step += self.for_bump(TokenType.PLUS, line, col);

		// __for_i < __for_n
		return self.arena.node(
			NodeData.BinaryExpr(
				self.for_id("__for_i", line, col),
				TokenType.LESS,
				self.for_id("__for_n", line, col)
			),
			line, col
		);
	}

	// `for (v in <iterable>)`: index over the container's `.data` storage.
	pub fn desugar_for_iterable(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_n: usz = <iterable>.len;
		val len_mem = self.arena.node(NodeData.MemberExpr(fs.iterable!, "len", false), line, col);
		pre += self.loop_var(false, "__for_n", self.for_usz_type(line, col), len_mem, line, col);

		// var __for_i: usz = 0;
		pre += self.loop_var(
			true, "__for_i", self.for_usz_type(line, col),
			self.for_num("0", line, col), line, col
		);

		// val <v> = <iterable>.data[__for_i];
		val data_mem = self.arena.node(NodeData.MemberExpr(fs.iterable!, "data", false), line, col);
		val idx_expr = self.arena.node(
			NodeData.IndexExpr(data_mem, self.for_id("__for_i", line, col)),
			line, col
		);
		head += self.loop_var_or_destruct(fs.var_name, idx_expr, line, col);

		step += self.for_bump(TokenType.PLUS, line, col);

		// __for_i < __for_n
		return self.arena.node(
			NodeData.BinaryExpr(
				self.for_id("__for_i", line, col),
				TokenType.LESS,
				self.for_id("__for_n", line, col)
			),
			line, col
		);
	}

	// `for (v in a..b)` (closed) / `for (v in a..<b)` (half-open) /
	// `for (v in a>..<b)` (open, exclusive ends).
	pub fn desugar_for_range(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_e = <end>;
		pre += self.loop_var(false, "__for_e", null, fs.range_end, line, col);

		// var __for_i = __for_e;  then __for_i = <start>;
		pre += self.loop_var(true, "__for_i", null, self.for_id("__for_e", line, col), line, col);
		val init_asgn = self.arena.node(
			NodeData.AssignExpr(self.for_id("__for_i", line, col), TokenType.EQUAL, fs.range_start!),
			line, col
		);
		pre += self.loop_expr(init_asgn, line, col);

		// val __for_up = __for_i <= __for_e;
		val cmp_up = self.for_i_cmp(TokenType.LESS_EQUAL, line, col);
		pre += self.loop_var(false, "__for_up", null, cmp_up, line, col);

		if (fs.is_open) {
			pre += self.for_by_dir(
				self.for_bump(TokenType.PLUS, line, col),
				self.for_bump(TokenType.MINUS, line, col),
				line, col
			);
		}

		val false_lit = self.arena.node(NodeData.LiteralExpr(Literal.BOOLEAN, "false"), line, col);
		pre += self.loop_var(true, "__for_go", null, false_lit, line, col);

		if (fs.is_open || fs.is_half_open) {
			pre += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER, line, col), line, col),
				line, col
			);
		} else {
			pre += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS_EQUAL, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER_EQUAL, line, col), line, col),
				line, col
			);
		}

		// val <v> = __for_i;
		head += self.loop_var_or_destruct(fs.var_name, self.for_id("__for_i", line, col), line, col);

		// Next element check
		if (fs.is_open || fs.is_half_open) {
			val up_inc = self.arena.node(
				NodeData.BinaryExpr(
					self.for_id("__for_i", line, col),
					TokenType.PLUS,
					self.for_num("1", line, col)
				),
				line, col
			);
			val up_chk = self.arena.node(
				NodeData.BinaryExpr(up_inc, TokenType.LESS, self.for_id("__for_e", line, col)),
				line, col
			);
			val dn_dec = self.arena.node(
				NodeData.BinaryExpr(
					self.for_id("__for_i", line, col),
					TokenType.MINUS,
					self.for_num("1", line, col)
				),
				line, col
			);
			val dn_chk = self.arena.node(
				NodeData.BinaryExpr(dn_dec, TokenType.GREATER, self.for_id("__for_e", line, col)),
				line, col
			);
			step += self.for_by_dir(
				self.for_set_go(up_chk, line, col),
				self.for_set_go(dn_chk, line, col),
				line, col
			);
		} else {
			step += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER, line, col), line, col),
				line, col
			);
		}

		val bump_dir = self.for_by_dir(
			self.for_bump(TokenType.PLUS, line, col),
			self.for_bump(TokenType.MINUS, line, col),
			line, col
		);
		step += self.loop_if(self.for_id("__for_go", line, col), bump_dir, null, line, col);

		return self.for_id("__for_go", line, col);
	}

	// Builds the block that replaces a STMT_FOR: hidden locals plus a while-loop.
	// `pending` receives the `continue` rewrites the caller must record.
	pub fn desugar_for(
		var self,
		node: *AstNode,
		fs: *ForStmt,
		use_iter_trait: bool,
		pending: &List<PendingResolve>
	): *AstNode {
		val line = node.line;
		val col = node.col;

		var pre = List<*AstNode>();
		var head = List<*AstNode>();
		var step = List<*AstNode>();
		val cond = when {
			fs.is_range -> self.desugar_for_range(&pre, &head, &step, fs, line, col);
			use_iter_trait -> self.desugar_for_iter_method(&pre, &head, &step, fs, line, col);
			else -> self.desugar_for_iterable(&pre, &head, &step, fs, line, col);
		};

		var body_stmts = List<*AstNode>();
		for (s in head) body_stmts += s;
		val fbody = fs.body;
		if (fbody is BlockStmt as b) {
			for (s in b.statements) body_stmts += s;
		} else if (fbody != null) {
			body_stmts += fbody;
		}
		for (s in step) body_stmts += s;

		// A `continue` inside the body must still advance the counter.
		self.for_inject_step(fs.body, &step, pending);

		pre += self.loop_while(cond, self.loop_block(body_stmts, line, col), line, col);
		return self.loop_block(pre, line, col);
	}

}
