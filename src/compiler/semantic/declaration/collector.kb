mod compiler.semantic.declaration;

/*
 * ============================================================================
 * compiler.semantic.declaration.collector — Top-level Declaration Collector
 *
 * Drives the ordered multi-pass collection of declarations across all modules:
 * - Pass 0:   Generic templates and trait declarations
 * - Pass 0.4: Wildcard imports
 * - Pass 0.5: Struct forward-declaration shells (supports import cycles)
 * - Pass 0.6: Trait implementation records
 * - Pass 1a:  Ordinary enums
 * - Pass 1a2: Payload enums
 * - Pass 1b:  Ordinary declarations (structs, functions, consts, externs)
 * - Pass 1c:  Impl blocks
 * - Pass 2:   Generic AST rewrite over non-template declarations
 * - Pass 3:   Drain monomorphization worklist to fixpoint
 * - Pass 4:   Append monomorphized instances to program AST
 * ============================================================================
 */

use std.string.*;
use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.TokenType;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.resolution.*;

use compiler.ast.StructField as AstStructField;
use compiler.semantic.types.StructField;

// A trait may declare overloads, so a method is identified by name + arity.
fn trait_method_in(list: List<*TraitMethod>, name: str, arity: usz): ?*TraitMethod {
	for (m in list) {
		if (m.name == name && m.arity == arity) return m;
	}
	return null;
}

pub struct DeclarationCollector {
	pub symtab: SymbolTable = SymbolTable(),
	pub arena: Arena = Arena(),
	pub current_module: str = "",
	pub errors: List<Diagnostic> = List(),
	pub is_extern: bool = false,
	pub current_self_type: ?*Type = null,
	pub subst_names: List<str> = List(),
	pub subst_types: List<*Type> = List(),
	pub current_fn_return_type: ?*AstNode = null,
	pub mat_rec: ?*InstanceRecord = null
}

impl DeclarationCollector {

	pub init() {
		val arena = Arena();
		return Self(SymbolTable(arena), arena, "", List<Diagnostic>());
	}

	pub init(arena: Arena) => Self(SymbolTable(arena), arena, "", List<Diagnostic>());

	pub fn prims(*self) => self.symtab.prims;

	pub fn enter_module(&self, module: str): str {
		val prev = self.current_module;
		if (module.len > 0) {
			self.current_module = module;
			self.symtab.set_current_module(module);
		}
		return prev;
	}

	pub fn leave_module(&self, prev: str) {
		self.current_module = prev;
		self.symtab.set_current_module(prev);
	}

	pub fn c_name_for(*self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return self.current_module.mangle_symbol(name);
	}

	pub fn report_error(&self, node: *AstNode, msg: str) {
		self.errors += Diagnostic.error(node.span, self.current_module, msg);
	}

	// ============================================================================
	// Resolution Bridge — delegates to TypeResolver
	// ============================================================================

	pub fn to_resolver(*self): TypeResolver {
		var r = TypeResolver(
			self.symtab, self.arena, self.current_module,
			self.errors, self.is_extern, self.current_self_type
		);
		r.current_fn_return_type = self.current_fn_return_type;
		r.mat_rec = self.mat_rec;
		r.subst.names = self.subst_names;
		r.subst.types = self.subst_types;
		return r;
	}

	pub fn apply_resolver(&self, r: TypeResolver) {
		self.symtab = r.symtab;
		self.arena = r.arena;
		self.current_module = r.current_module;
		self.errors = r.errors;
		self.is_extern = r.is_extern;
		self.current_self_type = r.current_self_type;
		self.current_fn_return_type = r.current_fn_return_type;
		self.mat_rec = r.mat_rec;
		self.subst_names = r.subst.names;
		self.subst_types = r.subst.types;
	}

	pub fn resolve_ast_type(&self, node: *AstNode): *Type {
		var r = self.to_resolver();
		val res = r.resolve_ast_type(node);
		self.apply_resolver(r);
		return res;
	}

	pub fn instantiate_struct(&self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): *Type {
		var r = self.to_resolver();
		val res = r.instantiate_struct(tmpl, arg_asts);
		self.apply_resolver(r);
		return res;
	}

	pub fn instantiate_fn(&self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): str {
		var r = self.to_resolver();
		val res = r.instantiate_fn(tmpl, arg_asts);
		self.apply_resolver(r);
		return res;
	}

	pub fn find_fn_template(&self, name: str): ?*GenericTemplate {
		var r = self.to_resolver();
		val res = r.find_fn_template(name);
		self.apply_resolver(r);
		return res;
	}

	pub fn find_struct_template(&self, name: str): ?*GenericTemplate {
		var r = self.to_resolver();
		val res = r.find_struct_template(name);
		self.apply_resolver(r);
		return res;
	}

	pub fn find_method_template(&self, name: str, self_type: str = ""): ?*GenericTemplate {
		var r = self.to_resolver();
		val res = r.find_method_template(name, self_type);
		self.apply_resolver(r);
		return res;
	}

	pub fn validate_fn_lambda_rules(&self, node: *AstNode, f: *FnDecl) {
		var r = self.to_resolver();
		r.validate_fn_lambda_rules(node, f);
		self.apply_resolver(r);
	}

	pub fn register_template(&self, node: *AstNode) {
		var r = self.to_resolver();
		r.register_template(node);
		self.apply_resolver(r);
	}

	pub fn template_in_module(&self, module: str, name: str): bool {
		var r = self.to_resolver();
		val res = r.template_in_module(module, name);
		self.apply_resolver(r);
		return res;
	}

	pub fn find_instance_symbol(*self, name: str): ?*Symbol {
		val r = self.to_resolver();
		return r.find_instance_symbol(name);
	}

	pub fn drain_instances(&self) {
		var r = self.to_resolver();
		r.drain_instances();
		self.apply_resolver(r);
	}

	pub fn rewrite_generics(&self, node: ?*AstNode) {
		var r = self.to_resolver();
		r.rewrite_generics(node);
		self.apply_resolver(r);
	}

	pub fn propagate_target_type(&self, target_type_node: ?*AstNode, init_node: ?*AstNode) {
		var r = self.to_resolver();
		r.propagate_target_type(target_type_node, init_node);
		self.apply_resolver(r);
	}

	pub fn materialize_body(&self, rec: *InstanceRecord): *AstNode {
		var r = self.to_resolver();
		val res = r.materialize_body(rec);
		self.apply_resolver(r);
		return res;
	}

	pub fn clone_expr(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		var r = self.to_resolver();
		val res = r.clone_expr(node, subst);
		self.apply_resolver(r);
		return res;
	}

	pub fn clone_fn(&self, node: *AstNode, subst: ?*GenericSubst = null, new_name: str = ""): *AstNode {
		var r = self.to_resolver();
		val res = r.clone_fn(node, subst, new_name);
		self.apply_resolver(r);
		return res;
	}

	pub fn clone_stmt(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		var r = self.to_resolver();
		val res = r.clone_stmt(node, subst);
		self.apply_resolver(r);
		return res;
	}

	pub fn clone_type(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		var r = self.to_resolver();
		val res = r.clone_type(node, subst);
		self.apply_resolver(r);
		return res;
	}

	// ============================================================================
	// Top-level Item Collection Passes
	// ============================================================================

	pub fn collect_module(&self, node: *AstNode) {
		if (node is ModuleDecl as m) {
			self.current_module = m.full_path;
			self.symtab.set_current_module(m.full_path);
		}
	}

	// `use a.b.c.Sym as Alias;` -> writes an ImportBinding:
	// the name `Alias` (or `Sym` when there is no alias) resolves to `Sym` of the module.
	// `use a.b.c.*;` -> wildcard import of the whole module a.b.c
	pub fn collect_use(&self, node: *AstNode) {
		if (node is UseDecl as u) {
			if (u.wildcard) {
				val w_mod = str_join_dots(u.path, u.path.len);
				if (!self.symtab.has_wildcard(self.current_module, w_mod)) {
					self.symtab.add_import(w_mod, "", "", true);
				}
				return;
			}

			// The last segment of the path is the symbol name, the rest is the module path
			if (u.path.len < 2) return;
			val mod_name = str_join_dots(u.path, u.path.len - 1);

			// Missing/failed module was already reported by ModuleLoader
			if (!self.symtab.module_exists(mod_name)) return;

			val target = self.symtab.lookup_in_module(mod_name, u.symbol_name);
			if (target == null) {
				// Generic struct/function templates are not registered as symbols.
				if (self.template_in_module(mod_name, u.symbol_name)) return;
				if (self.symtab.find_trait(u.symbol_name) != null) return;
				self.report_error(node, "Symbol '${u.symbol_name}' not found in module '${mod_name}'");
				return;
			}

			var local_name = u.symbol_name;
			if (!u.alias.empty()) local_name = u.alias;
			if (self.symtab.explicit_imports["${self.current_module}::${local_name}"] != null) return;
			self.symtab.add_import(mod_name, u.symbol_name, local_name, false);
		}
	}

	// Registers a struct's name with an opaque type, without resolving its fields.
	// Every struct gets one before the definition pass, so a field may mention a
	// type from a module that imports us back (import cycles). Idempotent.
	fn declare_struct_shell(&self, node: *AstNode, s: *StructDecl) {
		val c_name = self.c_name_for(s.name);
		val s_type = self.arena.struct_type(s.name, List<StructField>());
		val st = s_type.as_struct()!;
		st.c_name = c_name;
		st.module = self.current_module;
		st.is_defined = false;
		val ok = self.symtab.define_global(
			Symbol(s.name, c_name, SymbolKind.STRUCT, s_type, false, s.public, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate struct declaration '${s.name}'");
	}

	pub fn collect_struct(&self, node: *AstNode) {
		if (node is StructDecl as s) {
			// Generic structs are registered as templates and instantiated on use.
			if (s.type_params.len > 0) return;

			// A forward declaration (`struct A;`) registers an opaque type; the later
			// definition fills that same type in, so pointers may refer to it early.
			if (s.forward) {
				val existing_fwd = self.symtab.lookup_in_module(self.current_module, s.name);
				if (existing_fwd != null) {
					s.name = existing_fwd.c_name;
					return;
				}
				self.declare_struct_shell(node, s);
				val created = self.symtab.lookup_in_module(self.current_module, s.name);
				if (created != null) s.name = created.c_name;
				return;
			}

			val existing = self.symtab.lookup_in_module(self.current_module, s.name);
			if (
				existing != null &&
				existing.kind == SymbolKind.STRUCT &&
				existing.type_ptr.kind == DataType.STRUCT &&
				!existing.type_ptr.as_struct()!.is_defined
			) {
				// Definition of a forward-declared struct: complete the same type.
				val fwd_type = existing.type_ptr;
				val fwd_st = fwd_type.as_struct()!;
				fwd_st.is_defined = true;
				// A forward declaration elsewhere already emits this type's typedef.
				if (existing.ast_node != node) s.emit_typedef = false;
				val def_name = s.name;
				s.name = fwd_st.c_name;
				var fwd_private = false;
				for (f in s.fields) {
					val f_type = self.resolve_ast_type(f.type_node);
					if (f_type.kind == DataType.FN) {
						self.report_error(f.type_node, "Struct field '${f.name}' cannot have a lambda/closure type");
					}
					fwd_st.fields += StructField(f.name, f_type, 0, f.public, f.default_val);
					if (!f.public) fwd_private = true;
				}
				fwd_st.has_private = fwd_private;
				fwd_type.layout_struct();

				// The definition lives in a different module than the forward
				// declaration, so that module needs its own handle on the type.
				self.symtab.define_global(Symbol(
					def_name, fwd_st.c_name, SymbolKind.STRUCT, fwd_type,
					false, s.public, node.line, node.col, node
				));
				return;
			}

			val c_name = self.c_name_for(s.name);
			val s_type = self.arena.struct_type(s.name, List<StructField>());
			val s_info = s_type.as_struct()!;
			s_info.c_name = c_name;
			val ok = self.symtab.define_global(
				Symbol(s.name, c_name, SymbolKind.STRUCT, s_type, false, s.public, node.line, node.col, node)
			);
			if (!ok) self.report_error(node, "Duplicate struct declaration '${s.name}'");

			// Rename the AST node to the C name so the backend emits a unique name
			s.name = c_name;

			var has_private = false;
			for (f in s.fields) {
				val f_type = self.resolve_ast_type(f.type_node);
				if (f_type.kind == DataType.FN) {
					self.report_error(f.type_node, "Struct field '${f.name}' cannot have a lambda/closure type");
				}
				s_info.fields += StructField(f.name, f_type, 0, f.public, f.default_val);
				if (!f.public) has_private = true;
			}
			s_info.module = self.current_module;
			s_type.layout_struct();
		}
	}

	pub fn collect_fn(&self, node: *AstNode) {
		if (node is FnDecl as f) {
			// Generic functions are registered as templates and instantiated on use.
			if (f.type_params.len > 0) return;
			self.validate_fn_lambda_rules(node, f);
			var param_types = List<*Type>();

			var is_vararg = false;
			for (p in f.params) {
				if (p.name == "self") {
					self.report_error(node, "Top-level function '${f.name}' cannot have a 'self' parameter");
				}
				if (p.type_node is VariadicType) is_vararg = true;
				val p_type = if (p.type_node != null) self.resolve_ast_type(p.type_node!) else self.prims().t_none();
				param_types += p_type;
			}

			var ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type!)
			else self.infer_decl_return_type(f) ?: self.prims().t_none();

			val fn_type = self.arena.fn_type(param_types, ret_type, is_vararg);
			val c_name = self.c_name_for(f.name);
			val ok = self.symtab.define_global(
				Symbol(f.name, c_name, SymbolKind.FN, fn_type, false, f.public, node.line, node.col, node)
			);
			if (!ok) self.report_error(node, "Duplicate function declaration '${f.name}'");

			// Rename the AST node to the C name so the backend emits a unique name
			f.name = c_name;
		}
	}

	pub fn collect_enum(&self, node: *AstNode) {
		if (node is EnumDecl as e) {
			val under_type = if (e.underlying_type != null) self.resolve_ast_type(e.underlying_type!)
			else self.prims().t_prim(Type.i32());

			val is_payload = e.members.any { m -> !m.payload.empty() };
			if (is_payload) {
				self.collect_payload_enum(node, e, under_type);
				return;
			}

			val is_int = under_type.is_integer();
			val is_str = under_type.kind == DataType.STR;
			val is_char = under_type.kind == DataType.CHAR;
			val is_float = under_type.is_float();
			val is_bool = under_type.kind == DataType.BOOL;

			if (!is_int && !is_str && !is_char && !is_float && !is_bool) {
				self.report_error(node, "Enum underlying type must be a primitive type (integer, float, char, str, or bool)");
			}

			var members = List<*EnumMemberInfo>();
			var next_int_val: i64 = 0;
			for (m in e.members) {
				val mi = self.collect_enum_member(node, m, under_type, next_int_val);
				if (under_type.is_integer()) next_int_val = mi.value + 1;
				members += mi;
			}

			val c_name = self.c_name_for(e.name);
			val info = self.arena.create_val(EnumInfo(e.name, c_name, under_type, members));

			// The symbol's type is an integer type that carries the EnumInfo, so enum
			// values stay usable in arithmetic/comparisons while `.value` is recognized.
			val carrier = self.arena.create_val(Type(under_type.kind, under_type.size, under_type.align, TypePayload.Enum(info)));

			val ok = self.symtab.define_global(
				Symbol(e.name, c_name, SymbolKind.ENUM, carrier, false, e.public, node.line, node.col, node)
			);
			if (!ok) self.report_error(node, "Duplicate enum declaration '${e.name}'");

			self.symtab.register_enum_info(info);
			e.name = c_name;
		}
	}

	fn collect_enum_member(
		&self, node: *AstNode, m: EnumMember, under_type: *Type, current_int_val: i64
	): *EnumMemberInfo {
		var v: i64 = 0;
		var raw_text = "";
		var lit_kind = Literal.INTEGER;

		when (under_type) {
			.is_integer() -> {
				v = current_int_val;
				if (m.value != null) v = self.enum_const_i64(m.value!);
				raw_text = "${v}";
				lit_kind = Literal.INTEGER;
			}
			.kind == DataType.STR -> {
				lit_kind = Literal.STRING;
				raw_text = self.eval_str_enum_member(node, m);
			}
			.kind == DataType.CHAR -> {
				lit_kind = Literal.CHARACTER;
				raw_text = self.eval_char_enum_member(node, m);
			}
			.is_float() -> {
				lit_kind = Literal.FLOAT;
				raw_text = self.eval_float_enum_member(node, m);
			}
			.kind == DataType.BOOL -> {
				lit_kind = Literal.BOOLEAN;
				raw_text = self.eval_bool_enum_member(node, m);
			}
		}

		return self.arena.create_val(EnumMemberInfo(m.name, v, null, "", raw_text, lit_kind));
	}

	fn eval_str_enum_member(&self, node: *AstNode, m: EnumMember): str {
		if (m.value == null) return "\"${m.name}\"";
		if (m.value is LiteralExpr as lit && lit.literal_kind == Literal.STRING) return lit.raw_text;
		self.report_error(m.value!, "Enum member value for 'str' enum must be a string literal");
		return "\"${m.name}\"";
	}

	fn eval_char_enum_member(&self, node: *AstNode, m: EnumMember): str {
		if (m.value != null) {
			if (m.value is LiteralExpr as lit && lit.literal_kind == Literal.CHARACTER) return lit.raw_text;
			self.report_error(m.value!, "Enum member value for 'char' enum must be a character literal");
			return "'?'";
		}
		self.report_error(node, "Enum member '${m.name}' of 'char' enum requires an explicit character literal");
		return "'?'";
	}

	fn eval_float_enum_member(&self, node: *AstNode, m: EnumMember): str {
		if (m.value != null) {
			if (m.value is LiteralExpr as lit && lit.literal_kind in [Literal.FLOAT, Literal.INTEGER]) {
				return lit.raw_text;
			}
			self.report_error(m.value!, "Enum member value for float enum must be a number literal");
			return "0.0";
		}
		self.report_error(node, "Enum member '${m.name}' of float enum requires an explicit float literal");
		return "0.0";
	}

	fn eval_bool_enum_member(&self, node: *AstNode, m: EnumMember): str {
		if (m.value != null) {
			if (m.value is LiteralExpr as lit && lit.literal_kind == Literal.BOOLEAN) return lit.raw_text;
			self.report_error(m.value!, "Enum member value for 'bool' enum must be a bool literal");
			return "false";
		}
		self.report_error(node, "Enum member '${m.name}' of 'bool' enum requires an explicit bool literal");
		return "false";
	}

	// A payload enum becomes a struct: a `tag` field plus a union of per-variant
	// payload structs. Each variant gets its own struct type named `Enum.Variant`
	// (so an `is` pattern can name it) and an `Enum.Variant__TAG` constant symbol.
	fn collect_payload_enum(&self, node: *AstNode, e: *EnumDecl, under_type: *Type) {
		if (e.underlying_type != null) {
			self.report_error(node, "A payload enum cannot declare an underlying type");
		}

		val c_name = self.c_name_for(e.name);
		val tag_ty = self.prims().t_prim(Type.i32());
		val enum_ty = self.arena.struct_type(e.name, List<StructField>());
		val enum_st = enum_ty.as_struct()!;
		enum_st.c_name = c_name;
		enum_st.module = self.current_module;
		enum_st.fields += StructField("tag", tag_ty, 0, true, null);

		var members = List<*EnumMemberInfo>();
		var max_payload: usz = 1;
		var max_align: usz = tag_ty.align;
		var idx: i64 = 0;

		for (m in e.members) {
			val v_name = "${e.name}.${m.name}";
			val v_c = "${c_name}__${m.name}";
			val v_ty = self.arena.struct_type(v_name, List<StructField>());
			val v_st = v_ty.as_struct()!;
			v_st.c_name = v_c;
			v_st.module = self.current_module;
			for (f in m.payload) {
				val f_ty = self.resolve_ast_type(f.type_node);
				if (f_ty.kind == DataType.FN) {
					self.report_error(f.type_node, "Enum payload field '${f.name}' cannot have a lambda/closure type");
				}
				v_st.fields += StructField(f.name, f_ty, 0, true, null);
			}
			v_ty.layout_struct();
			if (v_ty.size == 0) {
				v_ty.size = 1;
				v_ty.align = 1;
			}

			self.symtab.define_global(
				Symbol(v_name, v_c, SymbolKind.STRUCT, v_ty, false, e.public, m.line, m.col, node)
			);
			if (self.symtab.lookup(m.name) == null) {
				self.symtab.define_global(
					Symbol(m.name, v_c, SymbolKind.STRUCT, v_ty, false, e.public, m.line, m.col, node)
				);
			}
			self.symtab.define_global(
				Symbol("${v_name}__TAG", "${v_c}__TAG", SymbolKind.CONST, tag_ty, false, false, m.line, m.col, null)
			);

			val mi = self.arena.create_val(EnumMemberInfo(m.name, idx, v_ty, "u.${m.name}", "", Literal.INTEGER));
			members += mi;

			if (v_ty.size > max_payload) max_payload = v_ty.size;
			if (v_ty.align > max_align) max_align = v_ty.align;
			idx = idx + 1;
		}

		// Layout: tag, padded up to the union's alignment, then the largest payload.
		var body_off = tag_ty.size;
		val rem = tag_ty.size % max_align;
		if (rem != 0) body_off = tag_ty.size + (max_align - rem);
		var pay = max_payload;
		val prem = pay % max_align;
		if (prem != 0) pay = pay + (max_align - prem);
		enum_ty.align = max_align;
		enum_ty.size = body_off + pay;

		val info = self.arena.create_val(EnumInfo(e.name, c_name, under_type, members, true, "tag"));
		self.symtab.register_enum_info(info);

		val ok = self.symtab.define_global(
			Symbol(e.name, c_name, SymbolKind.STRUCT, enum_ty, false, e.public, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate enum declaration '${e.name}'");
		e.name = c_name;
	}

	pub fn collect_const(&self, node: *AstNode) {
		if (node is ConstDecl as c) {
			val c_type = if (c.type_node != null) self.resolve_ast_type(c.type_node!)
			else self.infer_const_type(c.value) ?: self.prims().t_prim(Type.i32());
			if (c_type.kind == DataType.FN) {
				self.report_error(node, "Constant '${c.name}' cannot have a lambda/closure type");
			}
			if (c.type_node == null) c.type_node = self.arena.ast_type_from_type(c_type);

			val c_name = self.c_name_for(c.name);
			val ok = self.symtab.define_global(
				Symbol(c.name, c_name, SymbolKind.CONST, c_type, false, c.public, node.line, node.col, node)
			);
			if (!ok) self.report_error(node, "Duplicate const declaration '${c.name}'");

			c.name = c_name;
		}
	}

	pub fn collect_extern_block(&self, node: *AstNode) {
		if (node is ExternBlock as ext) {
			val prev_is_extern = self.is_extern;
			self.is_extern = true;
			for (d in ext) self.collect_declaration(d);
			self.is_extern = prev_is_extern;
		}
	}

	// Records a `trait` declaration so `impl Trait for Struct` blocks can be
	// checked against it and pick up its default methods. Method signatures are
	// resolved lazily; only the method names and whether each one has a body are
	// kept here.
	pub fn collect_trait(&self, node: *AstNode) {
		if (node is TraitDecl as t) {
			if (self.symtab.find_trait(t.name) != null) {
				self.report_error(node, "Duplicate trait declaration '${t.name}'");
				return;
			}

			var methods = List<*TraitMethod>();
			for (m in t.methods) {
				if (m is FnDecl as f) {
					self.validate_fn_lambda_rules(m, f);
					if (trait_method_in(methods, f.name, f.params.len) != null) {
						self.report_error(m,
							"Duplicate method '${f.name}' with ${f.params.len} "
							"parameter(s) in trait '${t.name}'"
						);
						continue;
					}
					val tm = self.arena.create_val(TraitMethod(f.name, f.params.len, f.body != null, m));
					methods += tm;
				}
			}

			for (a in t.assoc_types) {
				var seen_before = false;
				for (a2 in t.assoc_types) {
					if (a2 == a) {
						if (seen_before) {
							self.report_error(node, "Duplicate associated type '${a}' in trait '${t.name}'");
						}
						seen_before = true;
					}
				}
			}

			val ti = self.arena.create_val(TraitInfo(t.name, t.bases, methods, List<str>(), t.assoc_types));
			self.symtab.register_trait(ti);
		}
	}

	pub fn collect_declaration(&self, node: *AstNode) {
		val target = node;
		when (target) {
			is ModuleDecl -> self.collect_module(node);
			is UseDecl -> self.collect_use(node);
			is StructDecl -> self.collect_struct(node);
			is FnDecl -> self.collect_fn(node);
			is EnumDecl -> self.collect_enum(node);
			is ConstDecl -> self.collect_const(node);
			is ImplDecl -> self.collect_impl(node);
			is TraitDecl -> {} // already recorded in Pass 0
			is ExternBlock -> self.collect_extern_block(node);
		}
	}

	pub fn collect_program(&self, program_node: *AstNode) {
		if (program_node is Program as prog) {
			self.pass0_register_templates(prog);
			self.pass0_wildcard_imports(prog);
			self.pass0_struct_shells(prog);
			self.pass0_trait_records(prog);
			self.pass1_enums(prog, false);
			self.pass1_enums(prog, true);
			self.pass1_declarations(prog);
			self.pass1_impls(prog);
			self.symtab.relayout_structs();
			self.pass2_rewrite_generics(prog);
			self.drain_instances();
			self.append_monomorphized_instances(prog);
		}
	}

	fn pass0_register_templates(&self, prog: *Program) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is TraitDecl -> self.collect_trait(d);
				else -> self.register_template(d);
			}
		}
	}

	fn pass0_wildcard_imports(&self, prog: *Program) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is UseDecl as u -> if (u.wildcard) self.collect_use(d);
			}
		}
	}

	fn pass0_struct_shells(&self, prog: *Program) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is StructDecl as s -> {
					if (s.type_params.empty()) {
						val existing = self.symtab.lookup_in_module(self.current_module, s.name);
						if (existing == null) self.declare_struct_shell(d, s);
					}
				}
			}
		}
	}

	fn pass0_trait_records(&self, prog: *Program) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is ImplDecl as im -> {
					if (im.type_params.empty() && !im.trait_name.empty()) {
						val tr = self.symtab.find_trait(im.trait_name);
						if (tr != null) self.trait_record_impl(tr, im.struct_name);
					}
				}
			}
		}
	}

	fn pass1_enums(&self, prog: *Program, want_payload: bool) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is EnumDecl as e -> {
					val has_p = e.members.any { m -> !m.payload.empty() };
					if (has_p == want_payload) self.collect_enum(d);
				}
			}
		}
	}

	fn pass1_declarations(&self, prog: *Program) {
		for (d in prog) {
			if (d !is [ImplDecl, EnumDecl]) self.collect_declaration(d);
		}
	}

	fn pass1_impls(&self, prog: *Program) {
		for (d in prog) {
			val t = d;
			when (t) {
				is ModuleDecl -> self.collect_module(d);
				is ImplDecl -> self.collect_impl(d);
			}
		}
	}

	fn pass2_rewrite_generics(&self, prog: *Program) {
		for (d in prog) {
			if (d is ModuleDecl as m) {
				self.current_module = m.full_path;
				self.symtab.set_current_module(m.full_path);
			} else if (!is_template_decl(d)) {
				self.rewrite_generics(d);
			}
		}
	}

	fn append_monomorphized_instances(*self, prog: *Program) {
		if (self.symtab.gen.instances.empty()) return;
		var combined = List<*AstNode>();
		for (d in prog.declarations) combined += d;
		for (pn in self.symtab.gen.instances) combined += pn;
		prog.declarations = combined;
	}
}
