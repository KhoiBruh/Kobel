mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Type Checker & Semantic Body Analyzer Core Dispatcher
 *
 * Coordinates statement and expression checking across AST nodes.
 * Specific node checks are factored into:
 * - `checker/statement.kb`: statement analysis (blocks, declarations, loops, returns)
 * - `checker/expression.kb`: expression analysis (operators, accessors, assignments)
 * - `checker/call.kb`: call resolution, methods, and constructors
 * - `checker/inference.kb`: generic type argument deduction and pattern matching
 * - `checker/access.kb`: member access, indexing, assignments, and mutations
 * - `checker/pattern.kb`: when expressions, is patterns, and smart casts
 * - `checker/interpolation.kb`: string interpolation and Stringer checking
 * - `checker/program.kb`: module, function, and impl declaration drivers
 * ============================================================================
 */

use std.string.*;
use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.resolution.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

pub struct BodyChecker {
	pub symtab: SymbolTable = SymbolTable(),
	pub arena: Arena = Arena(),
	pub current_fn_return_type: *Type? = null,
	pub loop_depth: usz = 0,
	pub errors: List<Diagnostic> = List(),
	pub current_self_type: *Type? = null,
	pub has_symtab: bool = false,
	pub when_depth: usz = 0,
	pub checked_fns: List<*AstNode> = List(),
	pub is_stmt_level: bool = false,
	pub in_safe_nav_context: bool = false,
	pub defer_depth: usz = 0,
	pub decl: DeclarationCollector = DeclarationCollector(),
	pub has_decl: bool = false,
	pub infer_blocked: bool = false,
	pub inferring: bool = false,
	pub inferring_fn_return: bool = false,
	pub current_rec: *InstanceRecord? = null,
	pub env_saved_names: List<str> = List(),
	pub env_saved_types: List<*Type> = List(),
	pub has_env_saved: bool = false,
	pub warnings: List<Diagnostic> = List(),
	pub current_trait_name: str = ""
}

impl BodyChecker {

	pub init() {
		var arena = Arena();
		var decl_p = DeclarationCollector();
		val none_ty = decl_p.symtab.prims.t_none();
		return Self(decl_p.symtab, arena, none_ty, 0, List<Diagnostic>(), null, false);
	}

	pub init(symtab: SymbolTable) {
		var arena = Arena();
		val none_ty = symtab.prims.t_none();
		return Self(symtab, arena, none_ty, 0, List<Diagnostic>(), null, true);
	}

	pub init(symtab: SymbolTable, decl: DeclarationCollector) {
		var arena = Arena();
		val none_ty = symtab.prims.t_none();
		var bc = Self(symtab, arena, none_ty, 0, List<Diagnostic>(), null, true);
		bc.decl = decl;
		bc.has_decl = true;
		bc.symtab.prims = decl.symtab.prims;
		bc.symtab.sem = decl.symtab.sem;
		return bc;
	}

	pub fn type_display(val self, ty: *Type): str {
		if (ty == null) return "null";
		if (ty.kind == DataType.STRUCT) return ty.as_struct().c_name;
		if (ty.kind == DataType.POINTER) return "*${self.type_display(ty.as_pointer().pointee)}";
		if (ty.kind == DataType.ARRAY) return "[${self.type_display(ty.as_array().elem)}]";
		if (ty.is_enum()) return ty.as_enum().c_name;
		return primitive_type_name(ty);
	}

	pub fn copy_expr(var self, node: *AstNode) => self.decl.clone_expr(node, null);

	pub fn prims(val self) => self.symtab.prims;

	pub fn ensure(var self, cond: bool, node: *AstNode, msg: str) {
		if (!cond) self.report_error(node, msg);
	}

	pub fn enter_module(var self, module: str): str {
		val prev = self.symtab.current_module;
		if (module.len > 0) self.symtab.set_current_module(module);
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.symtab.set_current_module(prev);
	}

	pub fn check_expr_stmt(var self, expr: *AstNode, expected: *Type? = null): *Type {
		val prev = self.is_stmt_level;
		self.is_stmt_level = true;
		val ty = self.check_expr(expr, expected);
		self.is_stmt_level = prev;
		return ty;
	}

	pub fn report_warning(var self, node: *AstNode?, msg: str) {
		val span = if (node != null) node!.span else Span();
		self.warnings += Diagnostic.warning(span, self.symtab.current_module, msg);
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		self.errors += Diagnostic.error(node.span, self.symtab.current_module, msg);
	}

	pub fn lower_program(var self, program_node: *AstNode) {
		var lp = LoweringPass(self.symtab, self.arena, self.decl);
		lp.lower_program(program_node);
		self.symtab = lp.symtab;
		self.arena = lp.arena;
		self.decl = lp.decl;
	}

	pub fn resolve_type(var self, node: *AstNode): *Type {
		if (self.has_decl) {
			self.decl.symtab = self.symtab;
			self.decl.current_module = self.symtab.current_module;
			self.decl.current_self_type = self.current_self_type;
			self.decl.errors = self.errors;
			val ty = self.decl.resolve_ast_type(node);
			self.symtab = self.decl.symtab;
			self.errors = self.decl.errors;
			return ty;
		}

		var decl_p = DeclarationCollector(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val ty = decl_p.resolve_ast_type(node);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return ty;
	}

	pub fn find_method_template_for(var self, name: str, self_type: str): *GenericTemplate? {
		if (self.has_decl) return self.decl.find_method_template(name, self_type);

		var decl_p = DeclarationCollector(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_method_template(name, self_type);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	pub fn instantiate_method(
		var self,
		tmpl: *GenericTemplate,
		arg_asts: List<*AstNode>,
		obj_ty: *Type
	): str {
		if (self.has_decl) {
			self.decl.symtab = self.symtab;
			self.decl.current_module = self.symtab.current_module;
			self.decl.current_self_type = obj_ty;
			self.decl.errors = self.errors;
			val cname = self.decl.instantiate_fn(tmpl, arg_asts);
			self.symtab = self.decl.symtab;
			self.errors = self.decl.errors;
			return cname;
		}

		var decl_p = DeclarationCollector(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, obj_ty
		);
		val cname = decl_p.instantiate_fn(tmpl, arg_asts);
		self.arena = decl_p.arena;
		self.symtab = decl_p.symtab;
		self.errors = decl_p.errors;
		return cname;
	}

	pub fn check_expr(var self, node: *AstNode, expected: *Type? = null): *Type {
		if (node == null) return self.prims().t_none();
		if (node is GroupExpr as g) return self.check_expr(g.expr, expected);

		if (!(node is BinaryExpr) && !(node is AssignExpr)) {
			self.is_stmt_level = false;
		}

		val ty = self.check_expr_node(node, expected);
		self.annotate_type(node, ty);
		return ty;
	}

	fn annotate_type(var self, node: *AstNode, ty: *Type) {
		if (node == null || ty == null) return;
		if (self.current_rec != null) {
			self.ann_entry(node).ty = ty;
			return;
		}
		self.symtab.set_node_type(node, ty);
	}

	pub fn set_resolved(var self, node: *AstNode, r: *AstNode) {
		if (self.current_rec != null) self.ann_entry(node).resolved = r;
		else self.symtab.set_resolved_node(node, r);
	}

	pub fn set_method(var self, node: *AstNode, mi: *MethodInfo) {
		if (self.current_rec != null) self.ann_entry(node).method = mi;
		else self.symtab.set_resolved_method(node, mi);
	}

	pub fn set_is_pattern(var self, node: *AstNode, info: IsPatternInfo) {
		if (self.current_rec != null) {
			var e = self.ann_entry(node);
			e.is_info = info;
			e.has_is_info = true;
		}
		self.symtab.set_is_pattern(node, info);
	}

	pub fn set_ann_ty(var self, node: *AstNode, ty: *Type) {
		if (self.current_rec == null) return;
		self.ann_entry(node).ty = ty;
	}

	pub fn set_ann_var_ty(var self, node: *AstNode, ty: *Type) {
		if (self.current_rec == null) return;
		self.ann_entry(node).var_ty = ty;
	}

	pub fn set_ann_obj(var self, node: *AstNode, obj: *AstNode) {
		if (self.current_rec == null) return;
		self.ann_entry(node).obj_replace = obj;
	}

	pub fn set_ann_init_override(var self, node: *AstNode, r: *AstNode) {
		if (self.current_rec == null) return;
		self.ann_entry(node).init_override = r;
	}

	pub fn set_ident_name(var self, node: *AstNode, name: str) {
		if (self.current_rec != null) {
			val e = self.ann_entry(node);
			e.ident_name = name;
			e.has_ident_name = true;
			return;
		}
		if (node is IdentifierExpr as id) {
			id.name = name;
		}
	}

	pub fn ann_entry(var self, node: *AstNode): *AnnotationEntry {
		val rec = self.current_rec;
		val ex = rec.find_ann(node);
		if (ex != null) return ex;
		val e = self.arena.create_val(AnnotationEntry(node));
		rec.ann_map[node.addr()] = e;
		return e;
	}

	pub fn push_instance_env(var self, rec: *InstanceRecord) {
		if (!self.has_decl) return;
		self.env_saved_names = self.decl.subst_names;
		self.env_saved_types = self.decl.subst_types;
		self.has_env_saved = true;
		self.decl.subst_names = rec.template.param_names();
		self.decl.subst_types = rec.args;
	}

	pub fn pop_instance_env(var self) {
		if (!self.has_decl) return;
		if (!self.has_env_saved) return;
		self.decl.subst_names = self.env_saved_names;
		self.decl.subst_types = self.env_saved_types;
		self.has_env_saved = false;
	}

	pub fn push_instance(var self, rec: *InstanceRecord?): *InstanceRecord? {
		val saved = self.current_rec;
		if (rec == null) return saved;
		self.current_rec = rec;
		self.push_instance_env(rec!);
		return saved;
	}

	pub fn pop_instance(var self, saved: *InstanceRecord?, rec: *InstanceRecord?) {
		if (rec == null) return;
		self.pop_instance_env();
		self.current_rec = saved;
	}

	fn type_param_index(val self, name: str): i64 {
		if (!self.has_decl) return -1;
		for (i in 0..<self.decl.subst_names.len) {
			if (self.decl.subst_names[i] == name) return i as i64;
		}
		return -1;
	}

	fn type_c_size_num(var self, ty: *Type): usz {
		if (ty == null) return 8;
		return when (ty.kind) {
			DataType.NONE -> 0;
			DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
			DataType.I16, DataType.U16 -> 2;
			DataType.I32, DataType.U32, DataType.F32 -> 4;
			DataType.I64, DataType.U64, DataType.ISZ, DataType.USZ, DataType.F64 -> 8;
			DataType.STR -> 16;
			DataType.POINTER -> 8;
			DataType.ARRAY -> ty.as_array().length * self.type_c_size_num(ty.as_array().elem);
			DataType.STRUCT -> ty.size;
			else -> 8;
		};
	}

	fn type_c_size_text(var self, ty: *Type?): str {
		if (ty == null) return "0";
		val n = self.type_c_size_num(ty!);
		return "${n}";
	}

	fn arrow_pending(val self, ast: *AstNode): bool {
		if (ast is FnDecl as f) {
			if (f.return_type != null) return false;
			return f.body is ExprStmt;
		}
		return false;
	}

	fn check_expr_node(var self, node: *AstNode, expected: *Type? = null): *Type {
		val target = node;
		return when (target) {
			is LiteralExpr -> self.check_literal_expr(node, expected);
			is IdentifierExpr -> self.check_ident_expr(node);
			is BinaryExpr -> self.check_binary_expr(node, expected);
			is UnaryExpr -> self.check_unary_expr(node, expected);
			is CallExpr -> self.check_call_expr(node);
			is MemberExpr -> self.check_member_expr(node);
			is IndexExpr -> self.check_index_expr(node);
			is AssignExpr -> self.check_assign_expr(node);
			is UpdateExpr -> self.check_update_expr(node);
			is CastExpr -> self.check_cast_expr(node);
			is IfExpr -> self.check_if_expr(node, expected);
			is WhenExpr -> self.check_when_expr(node, expected);
			is ArrayLiteralExpr -> self.check_array_literal_expr(node);
			is InterpExpr -> self.check_interp_expr(node);
			is IsExpr -> self.check_is_expr(node);
			else -> self.prims().t_none();
		};
	}

	pub fn check_statement(var self, node: *AstNode) {
		if (node == null) return;
		val target = node;
		when (target) {
			is ExprStmt as es -> {
				self.check_expr_stmt(es.expr);
				return;
			}
			is DeferStmt as ds -> {
				if (self.defer_depth > 0) {
					self.report_error(node, "Nested defer statement is not allowed inside defer");
				}
				self.defer_depth++;
				self.check_statement(ds.body);
				self.defer_depth--;
				return;
			}
			is YieldStmt as ys -> {
				if (self.defer_depth > 0) {
					self.report_error(node, "Yield statement is not allowed inside defer");
				}
				if (self.when_depth == 0) {
					self.report_error(node, "Yield statement outside of when expression");
				}
				if (ys.value != null) self.check_expr(ys.value!);
				return;
			}
			is BlockStmt -> self.check_block_stmt(node);
			is VarDeclStmt -> self.check_var_decl_stmt(node);
			is IfStmt -> self.check_if_stmt(node);
			is WhileStmt -> self.check_while_stmt(node);
			is ForStmt -> self.check_for_stmt(node);
			is ReturnStmt -> self.check_return_stmt(node);
			is BreakStmt, is ContinueStmt -> {
				if (self.defer_depth > 0) {
					self.report_error(node, "Break or continue statement is not allowed inside defer");
				}
				if (self.loop_depth == 0) {
					self.report_error(node, "Break or continue statement outside of loop");
				}
			}
			is WhenStmt -> self.check_when_stmt(node);
		}
	}

}
