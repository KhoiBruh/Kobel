mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - When Expressions and Patterns
 *
 * `when` expressions and `is` patterns, including arm bodies and the
 * smart-cast bookkeeping they drive.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

impl BodyChecker {

	pub fn check_when_expr(var self, node: *AstNode, expected: *Type? = null): *Type {
		if (node is WhenExpr as we) {
			val cond_ty = if (we.condition != null) self.check_expr(we.condition!) else null;

			self.when_depth++;
			var result_ty: *Type? = expected;
			var has_else = false;
			for (arm in we.arms) {
				if (arm.is_else) has_else = true;

				val smart_cast_ty = self.resolve_arm_patterns(arm.patterns, we.condition, cond_ty);
				val sym = self.arm_smart_cast_sym(arm.patterns, we.condition);
				val mutable = self.arm_smart_cast_mutable(arm.patterns, we.condition);
				val body_ty = self.check_arm_body(arm.body, sym, smart_cast_ty, mutable, result_ty);

				if (result_ty == null) {
					result_ty = body_ty;
				} else {
					if (result_ty.kind == DataType.POINTER && body_ty.kind == DataType.POINTER) {
						val r_ptr = result_ty.as_pointer();
						val b_ptr = body_ty.as_pointer();
						if (b_ptr.pointee.kind == DataType.NONE && !r_ptr.nullable) {
							result_ty = self.arena.nullable_pointer_type(r_ptr.pointee, r_ptr.mutable);
						} else if (r_ptr.pointee.kind == DataType.NONE && !b_ptr.nullable) {
							result_ty = self.arena.nullable_pointer_type(b_ptr.pointee, b_ptr.mutable);
						} else if (r_ptr.nullable != b_ptr.nullable && r_ptr.pointee.equals(b_ptr.pointee)) {
							val mutable = r_ptr.mutable || b_ptr.mutable;
							result_ty = self.arena.nullable_pointer_type(r_ptr.pointee, mutable);
						}
					}
					self.ensure(
						result_ty.can_assign(body_ty),
						arm.body,
						"When arm type does not match previous arms"
					);
				}
			}
			self.when_depth--;

			val is_exhaustive = self.check_when_exhaustiveness(node, we, cond_ty);
			if (has_else && is_exhaustive) {
				self.report_error(node, "Redundant 'else' arm: all cases are already covered");
			}
			if (!has_else && !is_exhaustive) {
				self.report_error(node, "'when' expression is not exhaustive and requires an 'else' arm");
			}

			if (result_ty == null) return self.prims().t_none();
			return result_ty!;
		}
		return self.prims().t_none();
	}

	fn check_when_exhaustiveness(var self, node: *AstNode, we: *WhenExpr, cond_ty: *Type?): bool {
		if (cond_ty == null) return false;

		var base_ty = cond_ty;
		if (base_ty.kind == DataType.POINTER) {
			base_ty = base_ty.as_pointer().pointee;
		}

		if (base_ty.kind == DataType.BOOL) {
			var has_true = false;
			var has_false = false;
			for (arm in we.arms) {
				if (arm.is_else) continue;
				for (pat in arm.patterns) {
					if (pat is LiteralExpr as lit && lit.literal_kind == Literal.BOOLEAN) {
						if (lit.raw_text == "true") has_true = true;
						if (lit.raw_text == "false") has_false = true;
					} else if (pat is IdentifierExpr as id) {
						if (id.name == "true") has_true = true;
						if (id.name == "false") has_false = true;
					}
				}
			}
			return has_true && has_false;
		}

		var enum_info: *EnumInfo? = null;
		if (base_ty.is_enum()) {
			enum_info = base_ty.as_enum();
		} else if (base_ty.kind == DataType.STRUCT) {
			enum_info = self.symtab.find_enum_info(base_ty.as_struct().name);
		}

		if (enum_info == null || enum_info.members.empty()) return false;

		var covered = List<str>();
		for (arm in we.arms) {
			if (arm.is_else) continue;
			for (pat in arm.patterns) {
				val vname = self.match_enum_variant(pat, enum_info!);
				if (!vname.empty()) {
					var already = false;
					for (c in covered) {
						if (c == vname) already = true;
					}
					if (!already) covered += vname;
				}
			}
		}

		return covered.len == enum_info.members.len;
	}

	fn match_enum_variant(var self, pat: *AstNode, enum_info: *EnumInfo): str {
		if (pat is MemberExpr as mem) {
			var target_matches = true;
			if (mem.object is IdentifierExpr as tid) {
				target_matches = (tid.name == enum_info.name || tid.name == enum_info.c_name);
			}
			if (target_matches) {
				val m = enum_info.find_member(mem.member);
				if (m != null) return m.name;
			}
		} else if (pat is IsExpr as is_e) {
			if (is_e.target_type != null) {
				val target_ty = self.resolve_type(is_e.target_type);
				if (target_ty?.kind == DataType.STRUCT) {
					val target_s = target_ty.as_struct();
					for (m in enum_info.members) {
						val full_vname = "${enum_info.name}.${m.name}";
						if (target_s.name == full_vname || target_s.name == m.name) {
							return m.name;
						}
					}
				}
			}
		} else if (pat is IdentifierExpr as id) {
			val m = enum_info.find_member(id.name);
			if (m != null) return m.name;
		}
		return "";
	}

	pub fn arm_smart_cast_sym(val self, patterns: List<*AstNode>, cond: *AstNode?): str {
		if (cond == null || patterns.len != 1) return "";
		val pat = patterns.first();
		if (pat is IsExpr as is_e) {
			if (!is_e.alias.empty()) return is_e.alias;
			if (cond is IdentifierExpr as cond_id) return cond_id.name;
		}
		return "";
	}

	pub fn arm_smart_cast_mutable(val self, patterns: List<*AstNode>, cond: *AstNode?): bool {
		if (cond == null || patterns.len != 1) return false;
		val pat = patterns.first();
		if (pat is IsExpr as is_e) {
			if (!is_e.alias.empty()) return is_e.mutable;
			if (cond is IdentifierExpr as cond_id) {
				val subj_sym = self.symtab.lookup(cond_id.name);
				return subj_sym != null && subj_sym.mutable;
			}
		}
		return false;
	}

	pub fn resolve_arm_patterns(
		var self,
		patterns: List<*AstNode>,
		cond: *AstNode?,
		cond_ty: *Type?
	): *Type? {
		if (!self.arm_smart_cast_sym(patterns, cond).empty()) {
			val pat = patterns.first();
			if (pat is IsExpr as var is_e) {
				if (is_e.expr == null) is_e.expr = cond;
				return self.check_is_pattern(cond, cond_ty, pat);
			}
			return null;
		}

		for (pat in patterns) {
			val p_ty = self.check_arm_pattern(pat, cond, cond_ty);
			if (cond == null && p_ty.kind != DataType.BOOL) {
				self.report_error(pat, "Boolean when arm condition must be bool");
			}
		}
		return null;
	}

	fn check_arm_pattern(var self, pat: *AstNode, cond: *AstNode?, cond_ty: *Type?): *Type {
		if (cond == null) return self.check_expr(pat);
		if (pat is IsExpr as var is_e) {
			if (is_e.expr == null) is_e.expr = cond;
			self.check_is_pattern(cond, cond_ty, pat);
			return self.prims().t_bool();
		}
		val unwrapped = self.unwrap_group(pat);
		if (unwrapped is BinaryExpr as bin && (bin.op == TokenType.DOT_DOT || bin.op == TokenType.DOT_DOT_LESS)) {
			val r_ty = self.check_expr(pat);
			if (cond_ty != null && r_ty.kind == DataType.STRUCT) {
				val s = r_ty.as_struct();
				if (s.fields.len > 0) {
					val elem_ty = s.fields[0].type_ptr;
					self.ensure(
						cond_ty.can_assign(elem_ty) || elem_ty.can_assign(cond_ty),
						pat,
						"Range pattern element type does not match 'when' condition type"
					);
				}
			}
			return r_ty;
		}
		return self.check_expr(pat);
	}

	fn check_arm_body(
		var self,
		body: *AstNode,
		sym: str,
		smart_cast_ty: *Type?,
		mutable: bool,
		expected: *Type? = null
	): *Type {
		if (sym.empty() || smart_cast_ty == null) return self.check_when_arm_body(body, expected);
		self.symtab.enter_scope(false);
		defer self.symtab.exit_scope();
		self.symtab.define(Symbol(sym, sym, SymbolKind.VAR, smart_cast_ty!, mutable, false, 0, 0));
		return self.check_when_arm_body(body, expected);
	}

	pub fn check_when_arm_body(var self, body: *AstNode, expected: *Type? = null): *Type {
		if (body is BlockStmt as blk) {
			var yield_ty: *Type? = null;
			self.symtab.enter_scope(false);
			defer self.symtab.exit_scope();
			for (stmt in blk.statements) {
				if (stmt is YieldStmt as ys) {
					yield_ty = if (ys.value != null)
						self.check_expr(ys.value!, expected)
					else
						self.prims().t_none();
				} else {
					self.check_statement(stmt);
				}
			}
			if (yield_ty == null) {
				self.report_error(body, "When arm block must yield a value");
				return self.prims().t_none();
			}
			return yield_ty!;
		}
		return self.check_expr(body, expected);
	}

	pub fn check_is_pattern(var self, subject: *AstNode?, subj_ty: *Type?, is_node: *AstNode): *Type? {
		if (is_node == null) return null;
		if (is_node is IsExpr as is_e) {
			val target_ty = self.resolve_type(is_e.target_type);
			if (target_ty.kind != DataType.STRUCT) {
				self.report_error(is_node, "Target type of 'is' must be a struct");
				return null;
			}

			val target_s = target_ty.as_struct();

			var base_ty = subj_ty;
			var is_ptr = false;
			var subj_mutable = false;
			if (base_ty?.kind == DataType.POINTER) {
				is_ptr = true;
				subj_mutable = base_ty.as_pointer().mutable;
				base_ty = base_ty.as_pointer().pointee;
			}
			if (base_ty == null || base_ty.kind != DataType.STRUCT) {
				self.report_error(is_node, "Subject of 'is' must be a struct or pointer to struct");
				return null;
			}

			val base_s = base_ty.as_struct()!;

			val data_ty = self.field_type_of(base_s, "data");
			val data_enum = if (data_ty?.kind == DataType.STRUCT)
				self.symtab.find_enum_info(data_ty.as_struct()!.name)
			else null;
			var is_payload_data = false;
			var tag_field_name = "";
			var tag_const_c_name = "";

			var matched_data_member: *EnumMemberInfo? = null;
			if (data_enum?.is_payload) {
				for (m in data_enum.members) {
					if (m.name == target_s.name || "${data_enum.name}.${m.name}" == target_s.name) {
						is_payload_data = true;
						matched_data_member = m;
						tag_field_name = "data.tag";
						val auto_tag = self.symtab.lookup("${data_enum.name}.${m.name}__TAG");
						tag_const_c_name = if (auto_tag != null) auto_tag.c_name
							else "${data_enum.c_name}__${m.name}__TAG";
					}
				}
			}

			if (!is_payload_data) {
				val tag_const_sym = self.find_tag_const(target_s.name);
				if (tag_const_sym == null || tag_const_sym.kind != SymbolKind.CONST) {
					self.report_error(
						is_node,
						"Cannot smart cast to '${target_s.name}': " +
						"struct '${target_s.name}' must declare a 'const TAG'"
					);
					return null;
				}

				tag_field_name = self.tag_field_name_of(base_s);
				if (tag_field_name.empty()) {
					self.report_error(
						is_node,
						"Subject struct '${base_s.name}' must have a tag field as its first field"
					);
					return null;
				}

				val tag_field_ty = self.field_type_of(base_s, tag_field_name);
				if (!tag_field_ty.can_assign(tag_const_sym.type_ptr)) {
					self.report_error(
						is_node,
						"Tag type mismatch: '${base_s.name}.${tag_field_name}' does not match '${target_s.name}.TAG'"
					);
					return null;
				}
				tag_const_c_name = tag_const_sym.c_name;
			}

			var payload_path = "";
			var payload_ptr = false;

			if (is_payload_data) {
				var is_inner_ptr = true;
				var member_name = target_s.name;
				if (matched_data_member != null) {
					member_name = matched_data_member.name;
					val p_ty = matched_data_member.payload_ty;
					if (p_ty != null && p_ty.kind == DataType.STRUCT) {
						val s = p_ty.as_struct();
						var has_inner = false;
						for (f in s.fields) {
							if (f.name == "inner") has_inner = true;
						}
						if (!has_inner) is_inner_ptr = false;
					}
				}

				if (is_inner_ptr) {
					payload_path = "data.u.${member_name}.inner";
					payload_ptr = true;
				} else {
					payload_path = "data.u.${member_name}";
					payload_ptr = false;
				}
			}

			val enum_info = self.symtab.find_enum_info(base_s.name);
			if (enum_info?.is_payload) {
				for (m in enum_info.members) {
					if (m.payload_ty != null && m.payload_ty.equals(target_ty)) {
						payload_path = m.payload_path;
					}
				}
			}

			self.set_is_pattern(
				is_node,
				IsPatternInfo(
					tag_field_name, base_s.c_name, is_ptr,
					payload_path, payload_ptr, tag_const_c_name
				)
			);

			if (!payload_path.empty()) {
				return self.arena.pointer_type(target_ty, is_e.mutable || (is_ptr && subj_mutable));
			}

			if (is_ptr) {
				return self.arena.pointer_type(
					target_ty,
					is_e.mutable || (is_e.alias.empty() && subj_mutable)
				);
			}
			return target_ty;
		}
		return null;
	}

	fn find_tag_const(val self, struct_name: str): *Symbol? {
		return self.symtab.lookup("${struct_name}__TAG")
			?: self.symtab.lookup_struct_const(struct_name, "TAG")
			?: self.symtab.lookup("${struct_name}__KIND")
			?: self.symtab.lookup_struct_const(struct_name, "KIND");
	}

	fn tag_field_name_of(val self, base_s: *StructType): str {
		if (base_s.fields.empty()) return "";
		return base_s.fields[0].name;
	}

	fn field_type_of(val self, base_s: *StructType, name: str): *Type? {
		for (f in base_s.fields) {
			if (f.name == name) return f.type_ptr;
		}
		return null;
	}

	pub fn check_is_expr(var self, node: *AstNode): *Type {
		if (node is IsExpr as is_e) {
			if (is_e.expr == null) {
				self.report_error(node, "'is' expression requires a subject");
				return self.prims().t_bool();
			}
			val subj_ty = self.check_expr(is_e.expr!);
			self.check_is_pattern(is_e.expr, subj_ty, node);
		}
		return self.prims().t_bool();
	}

}
