mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Primaries and Operators
 *
 * Literals, identifiers, binary operator families (including the elvis form),
 * unary operators, `if` expressions, and `in [...]` candidate lists.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

impl BodyChecker {

	pub fn is_untyped_literal(*self, node: *AstNode): bool {
		if (node == null) return false;

		if (node is LiteralExpr as lit) {
			if (lit.literal_kind == Literal.INTEGER) return lit.raw_text.num_suffix().empty();
			if (lit.literal_kind == Literal.FLOAT) {
				val raw = lit.raw_text;
				return !raw.ends_with("f") && !raw.ends_with("F");
			}
		}

		if (node is GroupExpr as g) return self.is_untyped_literal(g.expr);

		if (node is UnaryExpr as un && un.op in [TokenType.MINUS, TokenType.PLUS]) {
			return self.is_untyped_literal(un.operand);
		}

		return false;
	}

	pub fn check_literal_expr(&self, node: *AstNode, expected: ?*Type = null): *Type {
		if (node is LiteralExpr as lit) {
			return when (lit.literal_kind) {
				Literal.INTEGER -> {
					val sfx = lit.raw_text.num_suffix();
					if (!sfx.empty()) yield int_literal_type(self.symtab.prims!, lit.raw_text);
					if (expected != null && (expected.is_integer() || expected.is_float())) {
						yield expected;
					}
					yield self.prims().get(DataType.I32);
				}
				Literal.FLOAT -> {
					val raw = lit.raw_text;
					val is_f32 = raw.ends_with("f") || raw.ends_with("F");
					if (is_f32) yield self.prims().t_prim(Type.f32());
					if (expected?.is_float()) {
						yield expected;
					}
					yield self.prims().t_prim(Type.f64());
				}
				Literal.BOOLEAN -> self.prims().t_bool();
				Literal.STRING -> {
					val str_ty = self.prims().t_str();
					if (expected != null && expected.kind == DataType.POINTER && expected.can_assign(str_ty)) {
						yield expected;
					}
					yield str_ty;
				}
				Literal.CHARACTER -> self.prims().t_char();
				Literal.NULL_VAL -> self.arena.nullable_pointer_type(self.prims().t_none(), false);
			};
		}
		return self.prims().t_none();
	}

	pub fn record_lambda_capture(&self, sym: *Symbol) {
		val cap_ty = sym.orig_type ?: sym.type_ptr;
		if (self.lambda_captures.any { c -> c.name == sym.name }) return;
		self.lambda_captures += LambdaCapture(sym.name, cap_ty, sym.mutable);
	}

	pub fn check_ident_expr(&self, node: *AstNode): *Type {
		if (node is IdentifierExpr as id) {
			if (id.name.empty()) {
				if (self.when_subject == null) {
					self.report_error(node, "Leading '.' member access is only allowed inside a 'when (subject)' pattern");
					return self.prims().t_none();
				}
				val subj_copy = self.copy_expr(self.when_subject!);
				self.set_resolved(node, subj_copy);
				return self.check_expr(subj_copy);
			}

			if (id.name == "Self" && self.current_self_type != null) {
				val cur_self = self.current_self_type!;
				if (self.current_rec == null) id.name = cur_self.as_struct().c_name;
				return cur_self;
			}

			val sym = self.symtab.lookup(id.name);
			if (sym == null) {
				self.report_error(node, "Undeclared identifier '${id.name}'");
				return self.prims().t_none();
			}

			if (sym.is_moved && !self.is_assign_target) {
				self.report_error(node, "Use of moved value '${id.name}'");
				return self.prims().t_none();
			}

			if (
				sym.type_ptr.kind == DataType.FN
				&& sym.kind in [SymbolKind.PARAM, SymbolKind.VAR]
				&& !self.allowing_fn_param_ref
			) {
				self.report_error(
					node,
					"Lambda parameter '${id.name}' cannot escape; it can only be called or forwarded as the final argument of a call"
				);
			}

			if (self.in_lambda) {
				val outer_sym = self.symtab.lookup_local_at_or_above(id.name, self.lambda_scope);
				if (outer_sym != null) {
					self.record_lambda_capture(outer_sym);
				}
			}

			if (!sym.c_name.empty() && sym.c_name != id.name) {
				self.set_ident_name(node, sym.c_name);
			}
			return sym.type_ptr;
		}
		return self.prims().t_none();
	}

	pub fn check_binary_expr(&self, node: *AstNode, expected: ?*Type = null): *Type {
		if (node is BinaryExpr as bin) {
			val was_stmt = self.is_stmt_level;
			self.is_stmt_level = false;

			if (bin.op == TokenType.QUESTION_COLON) {
				return self.check_elvis_expr(node, bin, was_stmt);
			}

			val num_expected = if (expected?.is_numeric()) expected else null;

			val is_cmp = bin.op in [
				TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL,
				TokenType.LESS, TokenType.LESS_EQUAL,
				TokenType.GREATER, TokenType.GREATER_EQUAL,
				TokenType.AND_AND, TokenType.OR_OR,
				TokenType.KW_IN
			];

			val prev_sn = self.in_safe_nav_context;
			if (is_cmp) self.in_safe_nav_context = true;

			var lt_num = self.check_expr(bin.left, num_expected);
			var lt = lt_num;
			if (bin.op == TokenType.KW_IN && self.unwrap_group(bin.right) is ArrayLiteralExpr as al) {
				self.in_safe_nav_context = prev_sn;
				return self.check_in_list_op(node, bin, lt, al);
			}
			var r_expected: ?*Type = num_expected;
			if (lt.is_numeric()) r_expected = lt;
			var rt = self.check_expr(bin.right, r_expected);

			self.in_safe_nav_context = prev_sn;

			if (self.is_untyped_literal(bin.left) && rt.is_numeric() && !lt.equals(rt)) {
				lt = self.check_expr(bin.left, rt);
			}
			if (self.is_untyped_literal(bin.right) && lt.is_numeric() && !rt.equals(lt)) {
				rt = self.check_expr(bin.right, lt);
			}

			return when (bin.op) {
				TokenType.PLUS, TokenType.MINUS, TokenType.STAR,
				TokenType.SLASH, TokenType.PERCENT -> self.check_arith_op(node, bin, lt, rt);
				TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL -> self.check_equality_op(node, bin, lt, rt);
				TokenType.LESS, TokenType.LESS_EQUAL,
				TokenType.GREATER, TokenType.GREATER_EQUAL -> self.check_ordering_op(node, lt, rt);
				TokenType.AND_AND, TokenType.OR_OR -> self.check_logic_op(node, lt, rt);
				TokenType.KW_IN -> self.check_in_op(node, bin, lt, rt);
				TokenType.DOT_DOT, TokenType.DOT_DOT_LESS -> self.check_range_op(node, bin, lt, rt);
				else -> lt;
			};
		}

		return self.prims().t_none();
	}

	fn is_safe_nav_expr(*self, expr: ?*AstNode): bool {
		if (expr == null) return false;
		val cur = self.unwrap_group(expr!);
		if (cur is MemberExpr as mem) return mem.is_safe;
		if (cur is CallExpr as call && call.callee is MemberExpr as cmem) return cmem.is_safe;
		return false;
	}

	fn check_elvis_expr(&self, node: *AstNode, bin: *BinaryExpr, was_stmt: bool): *Type {
		val num_expected: ?*Type = null;
		val prev_sn = self.in_safe_nav_context;
		self.in_safe_nav_context = true;
		var lt_num = self.check_expr(bin.left, num_expected);
		self.in_safe_nav_context = prev_sn;
		var lt = lt_num;
		val is_safe_nav = self.is_safe_nav_expr(bin.left);
		self.ensure(
			lt.kind in [DataType.POINTER, DataType.STR] || is_safe_nav,
			bin.left,
			"Left-hand side of Elvis operator '?:' must be a pointer, string, or safe navigation '?'"
		);

		val is_jump = bin.right is [ReturnStmt, BreakStmt, ContinueStmt, YieldStmt, BlockStmt];

		var rt: ?*Type = null;
		if (is_jump) {
			self.ensure(
				was_stmt,
				bin.right,
				"Elvis operator with jump statement ('return', 'yield', 'break', 'continue') is " +
				"only allowed in variable declarations, assignments, or statement expressions"
			);
			self.check_statement(bin.right);
		} else {
			self.is_stmt_level = was_stmt;
			rt = self.check_expr(bin.right, lt);
			self.is_stmt_level = false;
			val lt_is_null_lit = lt.kind == DataType.POINTER &&
				lt.as_pointer().pointee.kind == DataType.NONE;
			self.ensure(
				lt.can_assign(rt!) || lt_is_null_lit || rt!.can_assign(lt),
				bin.right,
				"Right-hand side of Elvis operator '?:' has incompatible type"
			);
		}

		if (is_safe_nav && lt.kind !in [DataType.POINTER, DataType.STR]) {
			return lt;
		}

		if (lt.kind == DataType.POINTER) {
			val pt = lt.as_pointer();
			if (pt.pointee.kind == DataType.NONE && !is_jump && rt != null) return rt;
			if (pt.nullable) {
				if (is_jump || (rt != null && rt.kind == DataType.POINTER && !rt.as_pointer().nullable)) {
					return self.arena.pointer_type(pt.pointee, pt.mutable);
				}
			}
		}
		return lt;
	}

	fn check_arith_op(&self, node: *AstNode, bin: *BinaryExpr, lt: *Type, rt: *Type): *Type {
		if (bin.op == TokenType.PLUS && lt.kind == DataType.STR) return self.prims().t_str();
		if (lt.is_numeric() && rt.is_numeric()) {
			if (lt.is_float() && !rt.is_float()) return lt;
			if (!lt.is_float() && rt.is_float()) return rt;
			if (lt.size > rt.size) return lt;
			if (rt.size > lt.size) return rt;
			if (lt.is_unsigned_integer() && rt.is_signed_integer()) return lt;
			if (lt.is_signed_integer() && rt.is_unsigned_integer()) return rt;
			return lt;
		}

		if (lt.kind == DataType.CHAR) {
			if (bin.op == TokenType.PLUS && rt.is_integer()) return lt;
			if (bin.op == TokenType.MINUS && rt.is_integer()) return lt;
			if (bin.op == TokenType.MINUS && rt.kind == DataType.CHAR) return self.prims().t_i32();
		}
		if (rt.kind == DataType.CHAR && bin.op == TokenType.PLUS && lt.is_integer()) {
			return rt;
		}

		if (lt.kind == DataType.STRUCT) {
			val op_name = when (bin.op) {
				TokenType.PLUS -> "plus";
				TokenType.MINUS -> "minus";
				TokenType.STAR -> "mul";
				TokenType.SLASH -> "div";
				TokenType.PERCENT -> "rem";
				else -> "";
			};
			if (!op_name.empty()) {
				val s_info = lt.as_struct();
				var arg_types = List<*Type>();
				arg_types += lt;
				arg_types += rt;
				val mi = s_info.find_operator(op_name, arg_types);
				if (mi != null) {
					self.set_method(node, mi);
					return mi.fn_type.as_fn().return_type;
				}
			}
		}

		self.report_error(node, "Arithmetic operator not supported for these types");
		return lt;
	}

	fn check_equality_op(&self, node: *AstNode, bin: *BinaryExpr, lt: *Type, rt: *Type): *Type {
		if (lt.kind == DataType.STR && rt.kind == DataType.STR) return self.prims().t_bool();

		if (lt.kind == DataType.STRUCT) {
			self.ensure(lt.can_assign(rt) || rt.can_assign(lt), node, "Cannot compare different types");
			val s_info = lt.as_struct();
			var arg_types = List<*Type>();
			arg_types += lt;
			arg_types += rt;
			val mi = s_info.find_operator("equals", arg_types);
			if (mi != null) self.set_method(node, mi);
			return self.prims().t_bool();
		}

		self.ensure(lt.can_assign(rt) || rt.can_assign(lt), node, "Cannot compare different types");
		return self.prims().t_bool();
	}

	fn check_ordering_op(&self, node: *AstNode, lt: *Type, rt: *Type): *Type {
		val is_num_comp = lt.is_numeric() && rt.is_numeric();
		val is_char_comp = lt.kind == DataType.CHAR && rt.kind == DataType.CHAR;
		self.ensure(is_num_comp || is_char_comp, node, "Comparison requires numeric or char operands");
		return self.prims().t_bool();
	}

	fn check_logic_op(&self, node: *AstNode, lt: *Type, rt: *Type): *Type {
		self.ensure(
			lt.kind == DataType.BOOL && rt.kind == DataType.BOOL,
			node,
			"Logical operators require bool operands"
		);
		return self.prims().t_bool();
	}

	fn check_in_op(&self, node: *AstNode, bin: *BinaryExpr, lt: *Type, rt: *Type): *Type {
		var l_ty = lt;
		val r_is_ptr = rt.kind == DataType.POINTER;
		val r_struct_ty = if (r_is_ptr) rt.as_pointer().pointee else rt;
		if (r_struct_ty?.kind == DataType.STRUCT) {
			val s_info = r_struct_ty.as_struct();
			if (self.is_untyped_literal(bin.left) && s_info.fields.len > 0) {
				val elem_ty = s_info.fields[0].type_ptr;
				if (elem_ty != null && (elem_ty.is_numeric() || elem_ty.kind == DataType.CHAR)) {
					l_ty = self.check_expr(bin.left, elem_ty);
				}
			}
			var arg_types = List<*Type>();
			arg_types += r_struct_ty;
			arg_types += l_ty;
			val mi = s_info.find_operator("contains", arg_types);
			if (mi != null) {
				self.set_method(node, mi);
				return self.prims().t_bool();
			}
		}

		if (rt.is_list()) {
			val s = rt.as_struct();
			if (
				s.fields.len > 0 &&
				s.fields[0].type_ptr != null &&
				s.fields[0].type_ptr.kind == DataType.POINTER
			) {
				val elem_t = s.fields[0].type_ptr.as_pointer().pointee;
				if (elem_t != null && elem_t.kind == DataType.STR && lt.kind == DataType.STR) {
					var args = List<*AstNode>();
					args += bin.right;
					val mem = self.arena.node(
						NodeData.MemberExpr(bin.left, "in_list", false),
						node.line, node.col
					);
					val call_node = self.arena.node(
						NodeData.CallExpr(mem, args, List<*AstNode>()),
						node.line, node.col
					);
					self.set_resolved(node, call_node);
					return self.check_expr(call_node);
				}
			}
		}

		var args = List<*AstNode>();
		args += bin.left;
		val mem = self.arena.node(NodeData.MemberExpr(bin.right, "contains", false), node.line, node.col);
		val call_node = self.arena.node(
			NodeData.CallExpr(mem, args, List<*AstNode>()),
			node.line, node.col
		);
		self.set_resolved(node, call_node);
		return self.check_expr(call_node);
	}

	fn check_in_list_op(&self, node: *AstNode, bin: *BinaryExpr, lt: *Type, al: *ArrayLiteralExpr): *Type {
		if (al.elements.empty()) {
			self.report_error(bin.right, "Candidate list in 'in' operator cannot be empty");
			return self.prims().t_bool();
		}

		var subj_ty = lt;
		var base_ty = subj_ty;
		var is_ptr = false;
		if (base_ty.kind == DataType.POINTER) {
			is_ptr = true;
			base_ty = base_ty.as_pointer().pointee;
		}

		var enum_info: ?*EnumInfo = null;
		if (base_ty.is_enum()) {
			enum_info = base_ty.as_enum();
		} else if (base_ty.kind == DataType.STRUCT) {
			enum_info = self.symtab.find_enum_info(base_ty.as_struct().name);
		}

		for (el in al.elements) {
			val unwrapped_el = self.unwrap_group(el);
			if (
				unwrapped_el is BinaryExpr as rbin &&
				rbin.op in [TokenType.DOT_DOT, TokenType.DOT_DOT_LESS]
			) {
				self.check_in_list_elem(rbin.left, bin, subj_ty, base_ty, is_ptr, enum_info);
				self.check_in_list_elem(rbin.right, bin, subj_ty, base_ty, is_ptr, enum_info);
				val is_valid_range_subj = subj_ty.is_numeric() ||
					subj_ty.kind == DataType.CHAR ||
					(subj_ty.is_enum() && (subj_ty.as_enum().underlying.is_numeric() || subj_ty.as_enum().underlying.kind == DataType.CHAR));
				self.ensure(
					is_valid_range_subj,
					unwrapped_el,
					"Range in 'in' list requires a numeric or char operand"
				);
				self.annotate_type(unwrapped_el, self.prims().t_bool());
			} else {
				val el_ty = self.check_in_list_elem(el, bin, subj_ty, base_ty, is_ptr, enum_info);
				if (self.is_untyped_literal(bin.left) && el_ty.is_numeric() && !subj_ty.equals(el_ty)) {
					subj_ty = self.check_expr(bin.left, el_ty);
					base_ty = subj_ty;
				}
			}
		}

		self.annotate_type(bin.right, self.prims().t_none());
		return self.prims().t_bool();
	}

	fn check_in_list_elem(
		&self,
		el: *AstNode,
		bin: *BinaryExpr,
		subj_ty: *Type,
		base_ty: *Type,
		is_ptr: bool,
		enum_info: ?*EnumInfo
	): *Type {
		val unwrapped_el = self.unwrap_group(el);
		if (enum_info != null) {
			val ei = enum_info;
			var vname = "";
			var is_explicit_enum_mem = false;
			if (unwrapped_el is MemberExpr as mem && mem.object is IdentifierExpr as oid) {
				if (oid.name.empty() || oid.name in [ei.name, ei.c_name]) {
					vname = mem.member;
					is_explicit_enum_mem = true;
				}
			} else if (unwrapped_el is IdentifierExpr as id) {
				if (self.symtab.lookup(id.name) == null && ei.find_member(id.name) != null) {
					vname = id.name;
				}
			}

			if (!vname.empty()) {
				val mi = ei.find_member(vname);
				if (mi == null) {
					self.report_error(el, "Enum '${ei.name}' has no member '${vname}'");
					return subj_ty;
				}
				if (ei.is_payload) {
					val base_s = base_ty.as_struct()!;
					val dummy_t = self.arena.node(
						NodeData.NamedType(base_s.c_name, List<*AstNode>()),
						unwrapped_el.line, unwrapped_el.col
					);
					val is_node = self.arena.node(
						NodeData.IsExpr(bin.left, dummy_t, "", false),
						unwrapped_el.line, unwrapped_el.col
					);
					val pat_info = IsPatternInfo(
						ei.tag_field, base_s.c_name, is_ptr,
						"", false, "${mi.value}"
					);
					self.set_is_pattern(unwrapped_el, pat_info);
					self.set_is_pattern(is_node, pat_info);
					self.set_resolved(unwrapped_el, is_node);
					self.annotate_type(unwrapped_el, self.prims().t_bool());
					self.annotate_type(is_node, self.prims().t_bool());
					return subj_ty;
				}
				val lit = self.arena.node(
					NodeData.LiteralExpr(mi.lit_kind, mi.raw_text),
					unwrapped_el.line, unwrapped_el.col
				);
				val carrier = self.arena.create_val(
					Type(ei.underlying.kind, ei.underlying.size, ei.underlying.align, TypePayload.Enum(ei))
				);
				self.set_resolved(unwrapped_el, lit);
				self.annotate_type(lit, carrier);
				self.annotate_type(unwrapped_el, carrier);
				return carrier;
			} else if (is_explicit_enum_mem) {
				self.report_error(el, "Enum '${ei.name}' has no member '${vname}'");
				return subj_ty;
			}
		}

		val exp_ty = if (subj_ty.is_numeric()) subj_ty else null;
		var el_ty = self.check_expr(el, exp_ty);
		if (self.is_untyped_literal(el) && subj_ty.is_numeric() && !el_ty.equals(subj_ty)) {
			el_ty = self.check_expr(el, subj_ty);
		}
		self.ensure(
			subj_ty.can_assign(el_ty) || el_ty.can_assign(subj_ty),
			el,
			"Element type in 'in' list does not match left-hand operand type"
		);
		return el_ty;
	}

	fn check_range_op(&self, node: *AstNode, bin: *BinaryExpr, lt: *Type, rt: *Type): *Type {
		var l_ty = lt;
		var r_ty = rt;
		if (self.is_untyped_literal(bin.left) && r_ty.is_numeric() && !l_ty.equals(r_ty)) {
			l_ty = self.check_expr(bin.left, r_ty);
		}
		if (self.is_untyped_literal(bin.right) && l_ty.is_numeric() && !r_ty.equals(l_ty)) {
			r_ty = self.check_expr(bin.right, l_ty);
		}

		val is_num_range = l_ty.is_integer() && r_ty.is_integer();
		val is_char_range = l_ty.kind == DataType.CHAR && r_ty.kind == DataType.CHAR;
		self.ensure(
			is_num_range || is_char_range,
			node,
			"Range operands must both be integers or both be chars"
		);

		var elem_ty = l_ty;
		if (is_num_range) {
			if (r_ty.size > l_ty.size) elem_ty = r_ty;
			else if (l_ty.is_signed_integer() && r_ty.is_unsigned_integer()) elem_ty = r_ty;
		}

		var targs = List<*AstNode>();
		targs += self.arena.ast_type_from_type(elem_ty);
		val tmpl = self.find_struct_template_for("Range");
		if (tmpl != null) {
			val range_ty = self.instantiate_template_struct(tmpl, targs);
			return range_ty;
		}

		self.report_error(node, "Type 'Range' not found");
		return self.prims().t_none();
	}

	pub fn check_unary_expr(&self, node: *AstNode, expected: ?*Type = null): *Type {
		if (node is UnaryExpr as un) {
			val op_ty = self.check_expr(un.operand, expected);

			if (un.is_postfix && un.op == TokenType.BANG) {
				if (op_ty.kind == DataType.POINTER) {
					val pt = op_ty.as_pointer();
					if (pt.nullable) {
						return self.arena.pointer_type(pt.pointee, pt.mutable);
					}
				}
				self.report_error(node, "Force unwrap operator '!' requires a nullable pointer");
				return op_ty;
			}

			if (op_ty.kind == DataType.STRUCT) {
				val op_name = when (un.op) {
					TokenType.MINUS -> "negate";
					TokenType.BANG -> "not";
					else -> "";
				};
				if (!op_name.empty()) {
					val s_info = op_ty.as_struct();
					var arg_types = List<*Type>();
					arg_types += op_ty;
					val mi = s_info.find_operator(op_name, arg_types);
					if (mi != null) {
						self.set_method(node, mi);
						return mi.fn_type.as_fn().return_type;
					}
				}
			}

			return when (un.op) {
				TokenType.MINUS -> {
					self.ensure(op_ty.is_numeric(), node, "Unary minus requires numeric operand");
					yield op_ty;
				}
				TokenType.BANG -> {
					self.ensure(op_ty.kind == DataType.BOOL, node, "Logical NOT requires bool operand");
					yield self.prims().t_bool();
				}
				TokenType.STAR -> {
					if (op_ty.kind != DataType.POINTER) {
						self.report_error(node, "Cannot dereference non-pointer type");
						yield op_ty;
					}
					yield op_ty.as_pointer().pointee;
				}
				TokenType.AMPERSAND -> self.arena.pointer_type(op_ty, true);
				else -> op_ty;
			};
		}
		return self.prims().t_none();
	}

	pub fn check_if_expr(&self, node: *AstNode, expected: ?*Type = null): *Type {
		if (node is IfExpr as if_e) {
			val prev_sn = self.in_safe_nav_context;
			self.in_safe_nav_context = true;
			val cond_ty = self.check_expr(if_e.condition);
			self.in_safe_nav_context = prev_sn;
			self.ensure(cond_ty.kind == DataType.BOOL, node, "If expression condition must be bool");
			var then_ty = self.check_expr(if_e.then_branch, expected);
			val else_ty = self.check_expr(if_e.else_branch, if (expected != null) expected else then_ty);

			val can_widen = self.is_untyped_literal(if_e.then_branch) &&
				else_ty.is_numeric() && !then_ty.equals(else_ty);
			if (can_widen) {
				then_ty = self.check_expr(if_e.then_branch, else_ty);
			}

			if (then_ty.kind == DataType.POINTER && else_ty.kind == DataType.POINTER) {
				val t_ptr = then_ty.as_pointer();
				val e_ptr = else_ty.as_pointer();
				if (e_ptr.pointee.kind == DataType.NONE && !t_ptr.nullable) {
					then_ty = self.arena.nullable_pointer_type(t_ptr.pointee, t_ptr.mutable);
				} else if (t_ptr.pointee.kind == DataType.NONE && !e_ptr.nullable) {
					then_ty = self.arena.nullable_pointer_type(e_ptr.pointee, e_ptr.mutable);
				} else if (t_ptr.nullable != e_ptr.nullable && t_ptr.pointee.equals(e_ptr.pointee)) {
					val mutable = t_ptr.mutable || e_ptr.mutable;
					then_ty = self.arena.nullable_pointer_type(t_ptr.pointee, mutable);
				}
			}

			self.ensure(then_ty.can_assign(else_ty), node, "If expression branches have incompatible types");
			return then_ty;
		}
		return self.prims().t_none();
	}

	pub fn check_array_literal_expr(&self, node: *AstNode): *Type {
		self.report_error(
			node,
			"Candidate list '[...]' is only allowed on the right-hand side of 'in' or '!in'"
		);
		return self.prims().t_none();
	}

}
