mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Function & Program Entry Points
 *
 * Driver layer of the body checker: walks the merged program and dispatches
 * each function / impl method to the core checker.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

/*
 * One arrow-bodied function whose return type is still unknown, together with
 * the context its body has to be checked in (defining module and `Self` type).
 */
struct ArrowCandidate {
	pub node: *AstNode,
	pub fn_type: *Type,
	pub self_ty: ?*Type = null,
	pub module: str
}

impl BodyChecker {

	pub fn check_fn(&self, fn_node: *AstNode) {
		if (fn_node is FnDecl as f) {
			val sym = self.symtab.lookup(f.name) ?: return;
			if (sym.type_ptr.kind != DataType.FN) return;

			val saved_mod = self.symtab.current_module;
			if (!f.module.empty()) self.symtab.set_current_module(f.module);

			var self_ty: ?*Type = null;
			val fn_info = sym.type_ptr.as_fn();
			if (
				f.params.len > 0 &&
				f.params[0].name == "self" &&
				fn_info.param_types.len > 0
			) {
				val p0 = fn_info.param_types[0];
				if (p0?.kind == DataType.POINTER && p0.as_pointer().pointee?.kind == DataType.STRUCT) {
					self_ty = p0.as_pointer().pointee;
				}
			}

			val rec = self.symtab.get_node_instance(fn_node);
			val saved_rec = self.push_instance(rec);

			if (self_ty == null) {
				self.check_fn_body(fn_node, sym.type_ptr);
			} else {
				val saved_self = self.current_self_type;
				self.current_self_type = self_ty;
				self.check_fn_body(fn_node, sym.type_ptr);
				self.current_self_type = saved_self;
			}

			self.pop_instance(saved_rec, rec);
			self.symtab.set_current_module(saved_mod);
		}
	}

	pub fn check_fn_body(&self, fn_node: *AstNode, fn_type: *Type) {
		if (fn_node in self.checked_fns) return;
		if (fn_node is FnDecl as f) {
			self.checked_fns += fn_node;

			val fn_info = fn_type.as_fn();
			val saved_ret = self.current_fn_return_type;
			val saved_inferring = self.inferring_fn_return;
			self.current_fn_return_type = fn_info.return_type;
			self.inferring_fn_return = (f.return_type == null);

			var saved_names = List<str>();
			var saved_types = List<*Type>();
			var had_env = false;
			if (self.has_decl && self.current_rec == null && !self.decl.subst_names.empty()) {
				saved_names = self.decl.subst_names;
				saved_types = self.decl.subst_types;
				had_env = true;
				self.decl.subst_names = List<str>();
				self.decl.subst_types = List<*Type>();
			}

			self.symtab.enter_scope(true);
			defer self.symtab.exit_scope();

			for (i in 0..<f.params.len) {
				val p = f.params[i];
				var p_ty = fn_info.param_types[i];
				var is_vararg = false;
				if (fn_info.is_variadic && i == f.params.len - 1) {
					p_ty = self.arena.array_type(p_ty, 0);
					is_vararg = true;
				}
				var sym = Symbol(
					p.name, p.name, SymbolKind.PARAM, p_ty, p.receiver == ReceiverKind.PTR_MUT, false,
					fn_node.line, fn_node.col, null
				);
				sym.is_vararg = is_vararg;
				self.symtab.define(sym);
			}

			val f_body = f.body;
			when (f_body) {
				is BlockStmt as blk -> {
					for (stmt in blk.statements) {
						self.check_statement(stmt);
					}
					if (f.return_type == null && self.current_fn_return_type != null) {
						val cur_ret = self.current_fn_return_type!;
						val fn_info_mut = fn_type.as_fn();
						fn_info_mut.return_type = cur_ret;
						f.return_type = self.arena.ast_type_from_type(cur_ret);
					}
				}
				is ExprStmt as es -> {
					val body_ty = self.check_expr(es.expr);
					if (body_ty.kind == DataType.FN) {
						self.report_error(fn_node, "Function cannot return a lambda/closure");
					}
					if (f.return_type == null) {
						val fn_info_mut = fn_type.as_fn();
						fn_info_mut.return_type = body_ty;
						self.current_fn_return_type = body_ty;
						f.return_type = self.arena.ast_type_from_type(body_ty);
					} else if (!self.current_fn_return_type.can_assign(body_ty)) {
						self.report_error(fn_node, "Expression body type does not match function return type");
					}
				}
			}

			val is_trait_impl = !self.current_trait_name.empty();
			if (!f.params.empty() && f.params[0].receiver == ReceiverKind.PTR_MUT) {
				val sym = self.symtab.lookup(f.params[0].name);
				if (sym != null && !sym.mutated && !is_trait_impl) {
					self.report_warning(
						fn_node,
						"In function '${f.name}': Receiver 'self' is declared mutable " +
						"with '&self', but is never mutated; consider using '*self'"
					);
				}
			}

			if (had_env) {
				self.decl.subst_names = saved_names;
				self.decl.subst_types = saved_types;
			}

			self.current_fn_return_type = saved_ret;
			self.inferring_fn_return = saved_inferring;
		}
	}

	pub fn check_impl(&self, node: *AstNode) {
		if (node is ImplDecl as im) {
			if (im.struct_name.empty()) {
				for (m_node in im.methods) {
					if (m_node is FnDecl as f) {
						if (f.type_params.len > 0) continue;
						val mi = self.symtab.find_prim_method_c(f.name);
						if (mi != null) self.check_fn_body(m_node, mi.fn_type);
					}
				}
				return;
			}

			val st_sym = self.symtab.lookup(im.struct_name) ?: return;
			if (st_sym.type_ptr.kind != DataType.STRUCT) return;
			val st_info = st_sym.type_ptr.as_struct();

			val prev_trait = self.current_trait_name;
			self.current_trait_name = im.trait_name;

			self.current_self_type = st_sym.type_ptr;
			for (m_node in im.methods) {
				if (m_node is FnDecl as f) {
					if (f.type_params.len > 0) continue;
					val mi = st_info.find_method_c(f.name);
					if (mi == null) continue;
					val rec = self.symtab.get_node_instance(m_node);
					val saved_rec = self.push_instance(rec);
					self.check_fn_body(m_node, mi.fn_type);
					self.pop_instance(saved_rec, rec);
				}
			}
			self.current_self_type = null;
			self.current_trait_name = prev_trait;
		}
	}

	pub fn check_program(&self, program_node: *AstNode) {
		if (!self.has_symtab) {
			var decl_p = DeclarationCollector(self.arena);
			decl_p.collect_program(program_node);

			self.symtab = decl_p.symtab;
			self.symtab.prims = decl_p.symtab.prims;
			self.symtab.sem = decl_p.symtab.sem;
			self.decl = decl_p;
			self.has_decl = true;
			for (d in decl_p.errors) self.errors += d;
		}

		val inst_mark = self.symtab.gen.instances.len;
		self.infer_arrow_returns(program_node);

		if (program_node is Program as prog) {
			for (decl in prog) {
				when (decl) {
					is ModuleDecl as m -> self.symtab.set_current_module(m.full_path);
					is FnDecl as f -> self.check_fn(decl);
					is ImplDecl as im -> self.check_impl(decl);
					is ConstDecl as c -> {
						var c_expected: ?*Type = null;
						if (c.type_node != null) c_expected = self.resolve_type(c.type_node!);
						if (c.value != null) self.check_expr(c.value!, c_expected);
					}
				}
			}
		}

		self.flush_instances(program_node, inst_mark);
	}

	pub fn flush_instances(&self, program_node: *AstNode, from: usz) {
		if (program_node is Program as prog) {
			var added = List<*AstNode>();
			var i = from;
			while (i + 1 < self.symtab.gen.instances.len) {
				val marker = self.symtab.gen.instances[i];
				val decl = self.symtab.gen.instances[i + 1];
				i += 2;

				if (marker is ModuleDecl as m) {
					self.symtab.set_current_module(m.full_path);
				}
				val t_decl = decl;
				if (t_decl is FnDecl) self.check_fn(decl);
				else if (t_decl is ImplDecl) self.check_impl(decl);

				added += marker;
				added += decl;
			}
			if (added.empty()) return;

			prog.declarations.reserve(prog.declarations.len + added.len);
			prog.declarations.extend(added);
			added.free();
		}
	}

	pub fn infer_arrow_returns(&self, program_node: *AstNode) {
		if (program_node is Program as prog) {
			val saved_mod = self.symtab.current_module;
			self.inferring = true;
			var pending = List<*ArrowCandidate>();
			var seen = List<*AstNode>();

			for (decl in prog) {
				if (decl is ModuleDecl as m) {
					self.symtab.set_current_module(m.full_path);
					continue;
				}
				val cur_mod = self.symtab.current_module;
				val ast_node = decl;
				if (decl is FnDecl) {
					self.add_fn_arrow_candidate(ast_node, cur_mod, &pending, &seen);
				} else if (decl is ImplDecl as im) {
					self.add_impl_arrow_candidates(im, cur_mod, &pending, &seen);
				}
			}

			var inst_scanned: usz = 0;
			var progress = true;
			while (!pending.empty() && progress) {
				progress = false;
				inst_scanned = self.collect_instance_arrow_candidates(&pending, &seen, inst_scanned);
				var next_pending = List<*ArrowCandidate>();
				for (c in pending) {
					if (self.try_infer_arrow(c)) {
						progress = true;
					} else {
						next_pending += c;
					}
				}
				pending = next_pending;
			}

			for (c in pending) {
				self.report_error(c.node, "Could not infer return type for arrow function (cyclic dependency)");
			}
			self.inferring = false;
			self.symtab.set_current_module(saved_mod);
		}
	}

	fn collect_instance_arrow_candidates(
		&self,
		pending: &List<*ArrowCandidate>,
		seen: &List<*AstNode>,
		from: usz
	): usz {
		var i = from;
		var cur_mod = self.symtab.current_module;
		while (i + 1 < self.symtab.gen.instances.len) {
			val marker = self.symtab.gen.instances[i];
			val decl = self.symtab.gen.instances[i + 1];
			i += 2;
			if (marker is ModuleDecl as m) cur_mod = m.full_path;
			val ast_node = decl;
			if (decl is FnDecl) {
				self.add_fn_arrow_candidate(ast_node, cur_mod, pending, seen);
			} else if (decl is ImplDecl as im) {
				self.add_impl_arrow_candidates(im, cur_mod, pending, seen);
			}
		}
		return i;
	}

	fn arrow_candidate(
		&self,
		node: *AstNode,
		fn_type: *Type,
		self_ty: ?*Type = null,
		module: str
	): *ArrowCandidate => self.arena.create_val(ArrowCandidate(node, fn_type, self_ty, module));

	fn add_fn_arrow_candidate(
		&self,
		decl: *AstNode,
		module: str,
		pending: &List<*ArrowCandidate>,
		seen: &List<*AstNode>
	) {
		val ast_node = decl;
		if (decl is FnDecl as f) {
			if (f.type_params.len > 0) return;
			if (ast_node in seen) return;
			if (!self.arrow_pending(ast_node)) return;
			val sym = self.symtab.lookup(f.name) ?: return;
			seen += ast_node;
			pending += self.arrow_candidate(ast_node, sym.type_ptr, null, module);
		}
	}

	fn add_impl_arrow_candidates(
		&self,
		im: *ImplDecl,
		module: str,
		pending: &List<*ArrowCandidate>,
		seen: &List<*AstNode>
	) {
		if (im.type_params.len > 0) return;
		if (im.struct_name.empty()) {
			for (m_node in im.methods) {
				if (m_node in seen) continue;
				if (!self.arrow_pending(m_node)) continue;
				if (m_node is FnDecl as mf) {
					val mi = self.symtab.find_prim_method_c(mf.name) ?: continue;
					val self_ty = mi.fn_type.as_fn().param_types[0];
					seen += m_node;
					pending += self.arrow_candidate(m_node, mi.fn_type, self_ty, module);
				}
			}
			return;
		}
		val st_sym = self.symtab.lookup(im.struct_name) ?: return;
		if (st_sym.type_ptr.kind != DataType.STRUCT) return;
		val st_info = st_sym.type_ptr.as_struct();
		for (m_node in im.methods) {
			if (m_node in seen) continue;
			if (!self.arrow_pending(m_node)) continue;
			if (m_node is FnDecl as mf) {
				val mi = st_info.find_method_c(mf.name) ?: continue;
				seen += m_node;
				pending += self.arrow_candidate(m_node, mi.fn_type, st_sym.type_ptr, module);
			}
		}
	}

	fn try_infer_arrow(&self, c: *ArrowCandidate): bool {
		if (c.node is FnDecl as f) {
			if (f.return_type != null) return true;
			if (c.fn_type == null) return true;
			val fn_info = c.fn_type.as_fn();

			val err_mark = self.errors.len;
			val saved_blocked = self.infer_blocked;
			val saved_self = self.current_self_type;
			val saved_ret = self.current_fn_return_type;

			self.infer_blocked = false;
			self.current_self_type = c.self_ty;
			self.current_fn_return_type = fn_info.return_type;
			val prev_mod = self.enter_module(c.module);

			self.symtab.enter_scope(true);
			for (i in 0..<f.params.len) {
				val p = f.params[i];
				val p_ty = if (i < fn_info.param_types.len) fn_info.param_types[i] else self.prims().t_none();
				self.symtab.define(Symbol(
					p.name, p.name, SymbolKind.PARAM, p_ty, p.receiver == ReceiverKind.PTR_MUT, false,
					c.node.line, c.node.col, null
				));
			}
			val rec = self.symtab.get_node_instance(c.node);
			val saved_rec = self.push_instance(rec);
			var body_expr: ?*AstNode = null;
			if (f.body is ExprStmt as es) {
				body_expr = es.expr;
			}
			if (body_expr == null) {
				self.pop_instance(saved_rec, rec);
				self.symtab.exit_scope();
				self.current_self_type = saved_self;
				self.current_fn_return_type = saved_ret;
				self.leave_module(prev_mod);
				return true;
			}
			val body_ty = self.check_expr(body_expr!);
			self.pop_instance(saved_rec, rec);
			self.symtab.exit_scope();

			self.current_self_type = saved_self;
			self.current_fn_return_type = saved_ret;
			self.leave_module(prev_mod);

			if (self.infer_blocked) {
				self.infer_blocked = saved_blocked;
				while (self.errors.len > err_mark) self.errors.pop();
				return false;
			}
			self.infer_blocked = saved_blocked;

			val fn_mut = c.fn_type.as_fn();
			fn_mut.return_type = body_ty;
			f.return_type = self.arena.ast_type_from_type(body_ty);
			self.checked_fns += c.node;
			return true;
		}
		return true;
	}

}
