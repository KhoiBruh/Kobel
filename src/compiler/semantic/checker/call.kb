mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Call Expression & Constructor Resolution
 *
 * Resolves function calls, instance and primitive methods, type size queries,
 * string slicing, and struct construction (both `new` constructors and field lists).
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;

impl BodyChecker {

	pub fn check_call_expr(&self, node: *AstNode): *Type {
		if (node is CallExpr as call) {
			// Primitive char constructor: char(code)
			if (call.callee is IdentifierExpr as id && id.name == "char") {
				return self.check_char_ctor(node, self.prims().t_char(), call);
			}
			// Primitive str constructor: str(c_str)
			if (call.callee is IdentifierExpr as id && id.name == "str") {
				return self.check_str_ctor(node, self.prims().t_str(), call);
			}

			// Check member call queries: T.size(), s.slice(...) or instance/primitive methods
			val callee = call.callee;
			if (callee is MemberExpr as var mem) {
				if (mem.object is IdentifierExpr as id && id.name.empty() && self.when_subject != null) {
					val subj_copy = self.copy_expr(self.when_subject!);
					if (self.current_rec != null) self.set_ann_obj(callee, subj_copy);
					else mem.object = subj_copy;
				}
				if (mem.member == "size") return self.lower_size_query(node, mem);
				if (mem.member == "slice") return self.check_slice_call(node, mem, call);

				// `Shape.Circle(1.5)`: a payload-enum variant.
				val enum_ty = self.check_enum_ctor_call(node, mem, call);
				if (enum_ty != null) return enum_ty;

				// Static method call: Type.method(args) or Self.method(args)
				val static_ty = self.check_static_method_call(node, mem, call);
				if (static_ty != null) return static_ty;

				// Instance method call or primitive method call
				val m_ty = self.check_method_call(node, mem, call);
				if (m_ty != null) return m_ty;
			}

			var callee_is_self = false;
			if (callee is IdentifierExpr as id) {
				callee_is_self = (id.name == "Self");
			}

			if (!call.type_args.empty() && callee is IdentifierExpr as cid) {
				val explicit_ty = self.check_explicit_generic_call(node, call, cid);
				if (explicit_ty != null) return explicit_ty;
			}

			if (call.type_args.empty() && callee is IdentifierExpr as cid) {
				val inferred_ty = self.check_inferred_generic_call(node, call, cid);
				if (inferred_ty != null) return inferred_ty;
			}

			val prev_allow_fn = self.allowing_fn_param_ref;
			self.allowing_fn_param_ref = true;
			val callee_ty = self.check_expr(call.callee);
			self.allowing_fn_param_ref = prev_allow_fn;

			// 1. Function call
			if (callee_ty.kind == DataType.FN) {
				if (call.callee is IdentifierExpr as cid) {
					val c_sym = self.symtab.lookup(cid.name);
					if (c_sym != null && c_sym.kind in [SymbolKind.PARAM, SymbolKind.VAR]) {
						self.set_closure_call(call.callee);
					}
				}
				return self.check_fn_call(node, callee_ty, call);
			}

			// 2. Struct construction: Point(1, 2)
			if (callee_ty.kind == DataType.STRUCT) {
				return self.check_struct_ctor(node, callee_ty, call, callee_is_self);
			}

			// 3. Enum construction: HttpMethod("GET"), Status(200)
			if (callee_ty.is_enum() && !callee_ty.as_enum().is_payload) {
				return self.check_enum_value_ctor(node, callee_ty, call);
			}

			self.report_error(node, "Callee is not a function, struct, or enum");
			return self.prims().t_none();
		}
		return self.prims().t_none();
	}

	fn check_explicit_generic_call(
		&self,
		node: *AstNode,
		call: *CallExpr,
		cid: *IdentifierExpr
	): *Type? {
		val ft = self.find_fn_template_for(cid.name);
		if (ft != null) {
			val cname = self.instantiate_template_fn(ft, call.type_args);
			val sym = self.symtab.lookup(cname);
			if (sym?.type_ptr?.kind == DataType.FN) {
				self.ensure_callee_ready(sym);
				val callee_id = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
				val new_call = self.arena.node(
					NodeData.CallExpr(callee_id, call.args, List<*AstNode>()),
					node.line, node.col
				);
				if (new_call is CallExpr as new_cc) {
					self.set_resolved(node, new_call);
					return self.check_fn_call(new_call, sym.type_ptr, new_cc);
				}
			}
		}

		val st = self.find_struct_template_for(cid.name);
		if (st != null) {
			val cty = self.instantiate_template_struct(st, call.type_args);
			if (cty.kind == DataType.STRUCT) {
				val cname = cty.as_struct().name;
				val callee_id = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
				val new_call = self.arena.node(
					NodeData.CallExpr(callee_id, call.args, List<*AstNode>()),
					node.line, node.col
				);
				if (new_call is CallExpr as new_cc) {
					self.set_resolved(node, new_call);
					return self.check_struct_ctor(new_call, cty, new_cc, false);
				}
			}
		}
		return null;
	}

	fn check_inferred_generic_call(
		&self,
		node: *AstNode,
		call: *CallExpr,
		cid: *IdentifierExpr
	): *Type? {
		val local_sym = self.symtab.lookup(cid.name);
		if (
			local_sym?.kind in [
				SymbolKind.VAR, SymbolKind.PARAM,
				SymbolKind.FN, SymbolKind.STRUCT
			]
		) return null;

		val ft = self.find_fn_template_for(cid.name);
		if (ft != null && ft.node is FnDecl as f_tmpl) {
			val inferred_targs = self.infer_type_args_for_fn(f_tmpl, call.args, false);
			if (!inferred_targs.empty()) {
				val cname = self.instantiate_template_fn(ft, inferred_targs);
				val sym = self.symtab.lookup(cname);
				if (sym?.type_ptr?.kind == DataType.FN) {
					self.ensure_callee_ready(sym);
					val callee_id = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
					val new_call = self.arena.node(
						NodeData.CallExpr(callee_id, call.args, List<*AstNode>()),
						node.line, node.col
					);
					if (new_call is CallExpr as new_cc) {
						self.set_resolved(node, new_call);
						return self.check_fn_call(new_call, sym.type_ptr, new_cc);
					}
				}
			} else {
				self.report_error(
					node,
					"Cannot infer type arguments for generic function '${cid.name}'; provide them explicitly"
				);
				return self.prims().t_none();
			}
		}

		val st = self.find_struct_template_for(cid.name);
		if (st != null && st.node is StructDecl as s_tmpl) {
			val inferred_targs = self.infer_type_args_for_struct(s_tmpl, call.args);
			if (!inferred_targs.empty()) {
				val cty = self.instantiate_template_struct(st, inferred_targs);
				if (cty.kind == DataType.STRUCT) {
					val cname = cty.as_struct().name;
					val callee_id = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
					val new_call = self.arena.node(
						NodeData.CallExpr(callee_id, call.args, List<*AstNode>()),
						node.line, node.col
					);
					if (new_call is CallExpr as new_cc) {
						self.set_resolved(node, new_call);
						return self.check_struct_ctor(new_call, cty, new_cc, false);
					}
				}
			}
		}
		return null;
	}

	fn check_enum_value_ctor(&self, node: *AstNode, enum_ty: *Type, call: *CallExpr): *Type {
		val info = enum_ty.as_enum();
		if (call.args.len != 1) {
			self.report_error(node, "Enum constructor '${info.name}' requires exactly 1 argument");
			return enum_ty;
		}

		val under = info.underlying;
		val arg = call.args[0];
		val arg_ty = self.check_expr(arg, under);

		if (!under.can_assign(arg_ty)) {
			self.report_error(
				arg,
				"Cannot initialize enum '${info.name}' with value of type " +
				"'${self.type_display(arg_ty)}' (expected '${self.type_display(under)}')"
			);
		}

		self.set_resolved(node, arg);
		return enum_ty;
	}

	fn check_char_ctor(&self, node: *AstNode, char_ty: *Type, call: *CallExpr): *Type {
		if (call.args.len != 1) {
			self.report_error(node, "Constructor 'char' requires exactly 1 argument");
			return char_ty;
		}
		val arg = call.args[0];
		val arg_ty = self.check_expr(arg, self.prims().t_i32());
		if (!arg_ty.is_integer()) {
			self.report_error(
				arg,
				"Cannot initialize 'char' with value of type '${self.type_display(arg_ty)}' (expected integer)"
			);
		}
		self.annotate_type(call.callee, char_ty);
		return char_ty;
	}

	fn check_str_ctor(&self, node: *AstNode, str_ty: *Type, call: *CallExpr): *Type {
		if (call.args.len != 1) {
			self.report_error(node, "Constructor 'str' requires exactly 1 argument");
			return str_ty;
		}
		val arg = call.args[0];
		val arg_ty = self.check_expr(arg);
		var valid = false;
		if (arg_ty.kind == DataType.POINTER) {
			val pt = arg_ty.as_pointer().pointee;
			valid = pt.kind in [DataType.CHAR, DataType.U8, DataType.I8];
		}
		if (!valid) {
			self.report_error(
				arg,
				"Cannot initialize 'str' with value of type '${self.type_display(arg_ty)}' " +
				"(expected '*char' or '*u8')"
			);
		}
		self.annotate_type(call.callee, str_ty);
		return str_ty;
	}

	fn lower_size_query(&self, node: *AstNode, mem: *MemberExpr): *Type {
		val obj = mem.object;
		if (obj is IdentifierExpr as var id) {
			val idx = self.type_param_index(id.name);
			if (idx >= 0) {
				val arg_ty = if (self.has_decl && (idx as usz) < self.decl.subst_types.len)
					self.decl.subst_types[idx as usz] else null;
				val size_text = self.type_c_size_text(arg_ty);
				val sz_node = self.arena.node(
					NodeData.SizeOfParam(idx as usz, size_text),
					node.line, node.col
				);
				self.set_resolved(node, sz_node);
				return self.prims().t_usz();
			}

			val csize = prim_c_size(id.name);
			if (csize > 0) {
				val lit = self.arena.node(
					NodeData.LiteralExpr(Literal.INTEGER, "${csize}"),
					node.line, node.col
				);
				self.set_resolved(node, lit);
				return self.prims().t_usz();
			}

			val tsym = self.symtab.lookup(id.name);
			if (tsym != null && tsym.c_name != id.name) {
				self.set_ident_name(obj, tsym.c_name);
			}
		}
		return self.prims().t_usz();
	}

	fn check_slice_call(&self, node: *AstNode, mem: *MemberExpr, call: *CallExpr): *Type {
		val slice_recv = self.check_expr(mem.object);
		self.ensure(slice_recv.kind == DataType.STR, node, "slice() requires a str receiver");
		for (arg in call.args) {
			val at = self.check_expr(arg);
			self.ensure(at.is_integer(), node, "slice() bounds must be integers");
		}
		return self.prims().t_str();
	}

	fn append_defaults(&self, node: *AstNode, argc: usz, call: *CallExpr): bool {
		if (node is FnDecl as f && argc < f.params.len) {
			for (i in argc..<f.params.len) {
				if (f.params[i].default_val == null) return false;
			}
			for (i in argc..<f.params.len) {
				call.args += self.copy_expr(f.params[i].default_val!);
			}
			return true;
		}
		return false;
	}

	fn method_with_defaults(
		&self,
		name: str,
		argc: usz,
		cands: List<*MethodInfo>,
		call: *CallExpr,
		found: *MethodInfo?
	): *MethodInfo? {
		if (found != null) return found;
		for (m in cands) {
			if (m.name != name || m.ast_node == null) continue;
			val ast_n = m.ast_node ?: continue;
			if (!self.append_defaults(ast_n, argc, call)) continue;
			return m;
		}
		return null;
	}

	fn check_receiver_mutability(
		&self,
		node: *AstNode,
		obj_node: *AstNode,
		member: str,
		obj_raw_ty: *Type
	) {
		if (self.is_immutable_self(obj_node)) {
			self.report_error(
				node,
				"Cannot call mutating method '${member}' on immutable receiver '*self'"
			);
			return;
		}

		if (obj_raw_ty.kind != DataType.POINTER) {
			val cur = self.unwrap_group(obj_node);
			when (cur) {
				is IdentifierExpr as id -> {
					val sym = self.symtab.lookup(id.name);
					if (sym != null && !sym.mutable) {
						self.report_error(
							node,
							"Cannot call mutating method '${member}' on immutable variable '${id.name}' " +
							"declared with 'val'. Use 'var' instead."
						);
					}
				}
				is MemberExpr as m -> {
					val obj_expr = self.unwrap_group(m.object);
					if (obj_expr is IdentifierExpr as id) {
						val sym = self.symtab.lookup(id.name);
						if (sym != null && sym.type_ptr.kind != DataType.POINTER && !sym.mutable) {
							self.report_error(
								node,
								"Cannot call mutating method '${member}' on immutable variable '${id.name}' " +
								"declared with 'val'. Use 'var' instead."
							);
						}
					}
				}
			}
		}
	}

	fn bind_method_call(
		&self,
		node: *AstNode,
		mem: *MemberExpr,
		call: *CallExpr,
		mi: *MethodInfo,
		obj_ty: *Type,
		obj_raw_ty: *Type
	): *Type {
		val fn_info = mi.fn_type.as_fn();
		if (fn_info.param_types.len > 0) {
			val recv_ty = fn_info.param_types[0];
			if (recv_ty?.kind == DataType.POINTER && recv_ty.as_pointer().mutable) {
				self.check_receiver_mutability(node, mem.object, mem.member, obj_raw_ty);
				self.mark_node_mutated(mem.object);
			} else if (mi.is_move) {
				if (obj_raw_ty.kind == DataType.POINTER) {
					self.report_error(
						node,
						"Cannot call move method '${mem.member}' on a pointer receiver; moving requires value ownership"
					);
				} else if (self.defer_depth == 0) {
					val obj_expr = self.unwrap_group(mem.object);
					if (obj_expr is IdentifierExpr as id) {
						val sym = self.symtab.lookup(id.name);
						if (sym != null) {
							if (sym.is_moved) {
								self.report_error(node, "Use of moved value '${id.name}'");
							} else {
								sym.is_moved = true;
							}
						}
					}
				}
			}
		}

		if (fn_info.is_variadic) {
			val min_user_args = if (fn_info.param_types.len >= 2) fn_info.param_types.len - 2 else 0;
			if (call.args.len < min_user_args) {
				self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
			} else {
				val elem_ty = fn_info.param_types.last();
				for (i in 0..<min_user_args) {
					val param_ty = fn_info.param_types[i + 1];
					val arg_n = call.args[i];
					if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
						self.mark_node_mutated(arg_n);
					}
					val is_fn_forward = (
						param_ty?.kind == DataType.FN
						&& i == call.args.len - 1
						&& arg_n is IdentifierExpr
					);
					val prev_allow = self.allowing_fn_param_ref;
					if (is_fn_forward) self.allowing_fn_param_ref = true;
					val arg_ty = self.check_expr(arg_n, param_ty);
					self.allowing_fn_param_ref = prev_allow;
					self.ensure(
						param_ty.can_assign(arg_ty),
						node,
						"Argument type mismatch in method call '${mem.member}'"
					);
				}
				for (i in min_user_args..<call.args.len) {
					val arg_n = call.args[i];
					val arg_ty = self.check_expr(arg_n, elem_ty);
					self.ensure(
						elem_ty.can_assign(arg_ty),
						node,
						"Argument type mismatch in variadic arguments of '${mem.member}'"
					);
				}
			}
		} else if (call.args.len + 1 != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
		} else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i + 1];
				val arg_n = call.args[i];
				if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
					self.mark_node_mutated(arg_n);
				}
				val is_fn_forward = (
					param_ty?.kind == DataType.FN
					&& i == call.args.len - 1
					&& arg_n is IdentifierExpr
				);
				val prev_allow = self.allowing_fn_param_ref;
				if (is_fn_forward) self.allowing_fn_param_ref = true;
				val arg_ty = self.check_expr(arg_n, param_ty);
				self.allowing_fn_param_ref = prev_allow;
				self.ensure(
					param_ty.can_assign(arg_ty),
					node,
					"Argument type mismatch in method call '${mem.member}'"
				);
			}
		}

		if (self.arrow_pending(mi.ast_node)) self.infer_blocked = true;

		var ret_ty = fn_info.return_type;
		if (mem.is_safe) {
			if (ret_ty.kind == DataType.POINTER) {
				val pt = ret_ty.as_pointer();
				ret_ty = self.arena.nullable_pointer_type(pt.pointee, pt.mutable);
			} else if (ret_ty.kind != DataType.STR) {
				self.ensure(
					self.in_safe_nav_context,
					node,
					"Safe method call '?.' on non-pointer returning method '${mem.member}' " +
					"requires handling null with '?:' or being used in a condition"
				);
			}
		}

		self.set_method(node, mi);
		return ret_ty;
	}

	pub fn check_static_method_call(
		&self,
		node: *AstNode,
		mem: *MemberExpr,
		call: *CallExpr
	): *Type? {
		var s_info: *StructType? = null;
		var struct_ty: *Type? = null;

		if (mem.object is IdentifierExpr as id) {
			if (id.name == "Self" && self.current_self_type != null) {
				struct_ty = self.current_self_type;
				s_info = self.current_self_type!.as_struct();
			} else {
				val sym = self.symtab.lookup(id.name);
				if (sym?.kind == SymbolKind.STRUCT && sym.type_ptr.kind == DataType.STRUCT) {
					struct_ty = sym.type_ptr;
					s_info = sym.type_ptr.as_struct();
				}
			}
		}

		if (s_info == null) return null;
		val st = s_info!;

		if (mem.is_safe) {
			self.report_error(node, "Safe call operator '?.' cannot be used on a static method call");
			return self.prims().t_none();
		}

		var tmpl = self.find_method_template_for(mem.member, st.name);
		if (tmpl == null) tmpl = self.find_method_template_for(mem.member, "");
		if (tmpl != null && tmpl.is_method) {
			var is_static = false;
			if (tmpl.node is FnDecl as f) {
				is_static = f.params.empty() || f.params[0].name != "self";
			}
			if (is_static) {
				var targs = call.type_args;
				if (targs.empty() && tmpl.node is FnDecl as tmpl_f) {
					targs = self.infer_type_args_for_fn(tmpl_f, call.args, false);
					if (targs.empty()) return null;
				}

				val cname = self.instantiate_method(tmpl, targs, struct_ty!);
				val sym = self.symtab.lookup(cname);
				if (sym == null || sym.type_ptr.kind != DataType.FN) return null;

				if (sym.ast_node != null) self.append_defaults(sym.ast_node!, call.args.len, call);
				self.ensure_callee_ready(sym);
				val fn_info = sym.type_ptr.as_fn();

				val callee = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
				val new_call = self.arena.node(
					NodeData.CallExpr(callee, call.args, List<*AstNode>()),
					node.line, node.col
				);

				if (call.args.len != fn_info.param_types.len) {
					self.report_error(node, "Argument count mismatch in call to '${st.name}.${mem.member}'");
				} else {
					for (i in 0..<call.args.len) {
						val param_ty = fn_info.param_types[i];
						val arg_n = call.args[i];
						val is_fn_forward = (
							param_ty?.kind == DataType.FN
							&& i == call.args.len - 1
							&& arg_n is IdentifierExpr
						);
						val prev_allow = self.allowing_fn_param_ref;
						if (is_fn_forward) self.allowing_fn_param_ref = true;
						val arg_ty = self.check_expr(arg_n, param_ty);
						self.allowing_fn_param_ref = prev_allow;
						self.ensure(
							param_ty.can_assign(arg_ty),
							node,
							"Argument type mismatch in call to '${st.name}.${mem.member}'"
						);
					}
				}

				self.set_resolved(node, new_call);
				return fn_info.return_type;
			}
		}

		val cand = st.find_static_method(mem.member);
		if (cand == null) {
			val inst_cand = st.find_method(mem.member);
			if (inst_cand != null && !inst_cand.is_static) {
				self.report_error(
					node,
					"Cannot call instance method '${mem.member}' statically without an instance of '${st.name}'"
				);
				return self.prims().t_none();
			}
			return null;
		}

		if (st.count_static_method_arity(mem.member, call.args.len) > 1) {
			self.report_error(
				node,
				"Ambiguous call to '${mem.member}': overloading by parameter type is not supported"
			);
		}

		val mi_def = self.method_with_defaults(
			mem.member, call.args.len, st.methods, call,
			st.find_static_method_arity(mem.member, call.args.len)
		);
		val mi = (mi_def ?: cand)!;

		val fn_info = mi.fn_type.as_fn();
		if (fn_info.is_variadic) {
			val min_args = fn_info.param_types.len - 1;
			if (call.args.len < min_args) {
				self.report_error(node, "Argument count mismatch in call to '${st.name}.${mem.member}'");
			} else {
				val elem_ty = fn_info.param_types[min_args];
				for (i in 0..<min_args) {
					val param_ty = fn_info.param_types[i];
					val arg_n = call.args[i];
					if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
						self.mark_node_mutated(arg_n);
					}
					val is_fn_forward = (
						param_ty?.kind == DataType.FN
						&& i == call.args.len - 1
						&& arg_n is IdentifierExpr
					);
					val prev_allow = self.allowing_fn_param_ref;
					if (is_fn_forward) self.allowing_fn_param_ref = true;
					val arg_ty = self.check_expr(arg_n, param_ty);
					self.allowing_fn_param_ref = prev_allow;
					self.ensure(
						param_ty.can_assign(arg_ty),
						node,
						"Argument type mismatch in call to '${st.name}.${mem.member}'"
					);
				}
				for (i in min_args..<call.args.len) {
					val arg_n = call.args[i];
					val arg_ty = self.check_expr(arg_n, elem_ty);
					self.ensure(
						elem_ty.can_assign(arg_ty),
						node,
						"Argument type mismatch in variadic arguments of '${st.name}.${mem.member}'"
					);
				}
			}
		} else if (call.args.len != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in call to '${st.name}.${mem.member}'");
		} else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i];
				val arg_n = call.args[i];
				if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
					self.mark_node_mutated(arg_n);
				}
				val is_fn_forward = (
					param_ty?.kind == DataType.FN
					&& i == call.args.len - 1
					&& arg_n is IdentifierExpr
				);
				val prev_allow = self.allowing_fn_param_ref;
				if (is_fn_forward) self.allowing_fn_param_ref = true;
				val arg_ty = self.check_expr(arg_n, param_ty);
				self.allowing_fn_param_ref = prev_allow;
				self.ensure(
					param_ty.can_assign(arg_ty),
					node,
					"Argument type mismatch in call to '${st.name}.${mem.member}'"
				);
			}
		}

		self.set_method(node, mi);
		if (self.arrow_pending(mi.ast_node)) self.infer_blocked = true;
		return fn_info.return_type;
	}

	pub fn check_method_call(&self, node: *AstNode, mem: *MemberExpr, call: *CallExpr): *Type? {
		val obj_raw_ty = self.check_expr(mem.object);
		var obj_ty = obj_raw_ty;
		var obj_is_ptr = false;
		if (obj_ty.kind == DataType.POINTER) {
			obj_is_ptr = true;
			obj_ty = obj_ty.as_pointer().pointee;
		}

		if (obj_is_ptr && mem.member == "addr") {
			if (call.args.len != 0) {
				self.report_error(node, "Method 'addr' takes no arguments");
			}
			return self.prims().t_usz();
		}

		if (obj_raw_ty.kind == DataType.CHAR && mem.member == "code") {
			if (call.args.len != 0) {
				self.report_error(node, "Method 'code' takes no arguments");
			}
			return self.prims().t_i32();
		}

		if (mem.is_safe && !obj_is_ptr) {
			self.report_error(node, "Safe call operator '?.' requires a pointer receiver");
			return self.prims().t_none();
		}
		val argc = call.args.len + 1;

		if (call.type_args.len > 0) {
			val g_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr, obj_raw_ty);
			if (g_ty != null) return g_ty;
		}

		if (obj_ty.kind == DataType.STRUCT) {
			val s_info = obj_ty.as_struct();
			if (s_info.count_method_arity(mem.member, argc) > 1) {
				self.report_error(
					node,
					"Ambiguous call to '${mem.member}': overloading by parameter type is not supported"
				);
			}
			val mi = self.method_with_defaults(
				mem.member, argc, s_info.methods, call, s_info.find_method_arity(mem.member, argc)
			) ?: s_info.find_method(mem.member);
			if (mi != null) return self.bind_method_call(node, mem, call, mi, obj_ty, obj_raw_ty);
		}

		if (obj_is_ptr && mem.member == "write") {
			if (!obj_raw_ty.as_pointer().mutable) {
				self.report_error(
					node,
					"Cannot call mutating method 'write' on read-only pointer of type '${obj_raw_ty.to_str()}'"
				);
				return self.prims().t_none();
			}
			if (call.args.len != 1) {
				self.report_error(node, "Method 'write' takes exactly 1 argument");
				return self.prims().t_none();
			}
			val pointee_ty = obj_raw_ty.as_pointer().pointee;
			val arg_ty = self.check_expr(call.args[0], pointee_ty);
			if (!pointee_ty.can_assign(arg_ty)) {
				self.report_error(
					call.args[0],
					"Type mismatch in 'write': cannot write value of type '${arg_ty.to_str()}' " +
					"into pointer to '${pointee_ty.to_str()}'"
				);
			}
			return self.prims().t_none();
		}

		if (obj_is_ptr && mem.member == "read") {
			if (call.args.len != 0) {
				self.report_error(node, "Method 'read' takes no arguments");
			}
			var ret_ty = obj_raw_ty.as_pointer().pointee;
			if (mem.is_safe) {
				if (ret_ty.kind == DataType.POINTER) {
					val pt = ret_ty.as_pointer();
					ret_ty = self.arena.nullable_pointer_type(pt.pointee, pt.mutable);
				} else if (ret_ty.kind != DataType.STR) {
					self.ensure(
						self.in_safe_nav_context,
						node,
						"Safe method call '?.' on non-pointer returning method 'read' " +
						"requires handling null with '?:' or being used in a condition"
					);
				}
			}
			return ret_ty;
		}

		val pmi = self.method_with_defaults(
			mem.member, argc, self.symtab.prim_methods_of(obj_ty.kind), call,
			self.symtab.find_prim_method_arity(obj_ty.kind, mem.member, argc)
		) ?: self.symtab.find_prim_method(obj_ty.kind, mem.member);
		if (pmi != null) return self.bind_method_call(node, mem, call, pmi, obj_ty, obj_raw_ty);

		if (obj_ty.kind == DataType.STRUCT) {
			val g_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr, obj_raw_ty);
			if (g_ty != null) return g_ty;
			self.report_error(node, "Method '${mem.member}' not found on type '${obj_ty.as_struct().name}'");
			return self.prims().t_none();
		}

		val g_prim_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr, obj_raw_ty);
		if (g_prim_ty != null) return g_prim_ty;

		return null;
	}

	fn check_generic_method_call(
		&self,
		node: *AstNode,
		mem: *MemberExpr,
		call: *CallExpr,
		obj_ty: *Type,
		obj_is_ptr: bool,
		obj_raw_ty: *Type
	): *Type? {
		val recv_name = if (obj_ty.kind == DataType.STRUCT) obj_ty.as_struct().name
			else primitive_type_name(obj_ty);
		if (recv_name.empty()) return null;

		var tmpl = self.find_method_template_for(mem.member, recv_name);
		if (tmpl == null) tmpl = self.find_method_template_for(mem.member, "");
		if (tmpl == null) return null;

		var targs = call.type_args;
		if (targs.empty() && tmpl.node is FnDecl as tmpl_f) {
			targs = self.infer_type_args_for_fn(tmpl_f, call.args, true, obj_ty);
			if (targs.empty()) return null;
		}

		val cname = self.instantiate_method(tmpl!, targs, obj_ty);
		val sym = self.symtab.lookup(cname);
		if (sym == null || sym.type_ptr.kind != DataType.FN) return null;

		self.ensure_callee_ready(sym);
		val fn_info = sym.type_ptr.as_fn();
		if (fn_info.param_types.len > 0) {
			val recv_ty = fn_info.param_types[0];
			if (recv_ty?.kind == DataType.POINTER && recv_ty.as_pointer().mutable) {
				self.check_receiver_mutability(node, mem.object, mem.member, obj_raw_ty);
				self.mark_node_mutated(mem.object);
			}
		}

		var args = List<*AstNode>();
		if (obj_ty.kind == DataType.STRUCT && !obj_is_ptr) {
			val ref_arg = self.arena.node(
				NodeData.UnaryExpr(TokenType.AMPERSAND, mem.object, false),
				node.line, node.col
			);
			args += ref_arg;
		} else {
			args += mem.object;
		}
		for (a in call.args) args += a;

		val callee = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
		val new_call = self.arena.node(
			NodeData.CallExpr(callee, args, List<*AstNode>()),
			node.line, node.col
		);

		if (new_call is CallExpr as new_cc) {
			if (sym.ast_node != null) self.append_defaults(sym.ast_node!, new_cc.args.len, new_cc);
			if (new_cc.args.len != fn_info.param_types.len) {
				self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
			} else {
				for (i in 1..<new_cc.args.len) {
					val param_ty = fn_info.param_types[i];
					val arg_n = new_cc.args[i];
					if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
						self.mark_node_mutated(arg_n);
					}
					val is_fn_forward = (
						param_ty?.kind == DataType.FN
						&& i == new_cc.args.len - 1
						&& arg_n is IdentifierExpr
					);
					val prev_allow = self.allowing_fn_param_ref;
					if (is_fn_forward) self.allowing_fn_param_ref = true;
					val arg_ty = self.check_expr(arg_n, param_ty);
					self.allowing_fn_param_ref = prev_allow;
					self.ensure(
						param_ty.can_assign(arg_ty),
						node,
						"Argument type mismatch in method call '${mem.member}'"
					);
				}
			}
		}

		self.set_resolved(node, new_call);
		return fn_info.return_type;
	}

	fn find_fn_template_for(&self, name: str): *GenericTemplate? {
		if (self.has_decl) return self.decl.find_fn_template(name);
		var decl_p = DeclarationCollector(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_fn_template(name);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	fn find_struct_template_for(&self, name: str): *GenericTemplate? {
		if (self.has_decl) return self.decl.find_struct_template(name);
		var decl_p = DeclarationCollector(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_struct_template(name);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	fn instantiate_template_fn(&self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): str {
		self.decl.symtab = self.symtab;
		self.decl.current_module = self.symtab.current_module;
		self.decl.current_self_type = self.current_self_type;
		self.decl.errors = self.errors;
		val cname = self.decl.instantiate_fn(tmpl, arg_asts);
		self.symtab = self.decl.symtab;
		self.errors = self.decl.errors;
		return cname;
	}

	fn instantiate_template_struct(&self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): *Type {
		self.decl.symtab = self.symtab;
		self.decl.current_module = self.symtab.current_module;
		self.decl.current_self_type = self.current_self_type;
		self.decl.errors = self.errors;
		val ty = self.decl.instantiate_struct(tmpl, arg_asts);
		self.symtab = self.decl.symtab;
		self.errors = self.decl.errors;
		return ty;
	}

	fn ensure_callee_ready(&self, sym: *Symbol?) {
		val ast = sym?.ast_node ?: return;
		if (!self.arrow_pending(ast)) return;

		val saved_ret = self.current_fn_return_type;
		self.check_fn(ast);
		self.current_fn_return_type = saved_ret;

		if (self.arrow_pending(ast)) self.infer_blocked = true;
	}

	fn check_enum_ctor_call(&self, node: *AstNode, mem: *MemberExpr, call: *CallExpr): *Type? {
		val obj = mem.object;
		if (obj is IdentifierExpr as enum_id) {
			val ei = self.symtab.find_enum_info(enum_id.name);
			if (ei == null || !ei.is_payload) return null;

			val e_sym = self.symtab.lookup(ei.name) ?: return null;
			val mi = ei.find_member(mem.member);
			if (mi == null) {
				self.report_error(node, "Enum '${enum_id.name}' has no variant '${mem.member}'");
				return self.prims().t_none();
			}

			var field_types = List<*Type>();
			if (mi.payload_ty != null) {
				field_types = mi.payload_ty.as_struct().fields.map { f -> f.type_ptr };
			}

			if (call.args.len != field_types.len) {
				self.report_error(node, "Argument count mismatch in variant '${enum_id.name}.${mem.member}'");
			} else {
				for (i in 0..<call.args.len) {
					val f_ty = field_types[i];
					val arg_n = call.args[i];
					val arg_ty = self.check_expr(arg_n, f_ty);
					self.ensure(
						f_ty.can_assign(arg_ty),
						node,
						"Field type mismatch in variant '${enum_id.name}.${mem.member}'"
					);
				}
			}

			val payload_path = if (field_types.empty()) "" else mi.payload_path;
			self.set_resolved(node, self.arena.node(NodeData.EnumCtorExpr(
				ei.c_name, ei.tag_field, mi.value, payload_path, call.args
			), node.line, node.col));
			return e_sym.type_ptr;
		}
		return null;
	}

	pub fn check_fn_call(&self, node: *AstNode, callee_ty: *Type, call: *CallExpr): *Type {
		val callee = call.callee;
		if (callee is IdentifierExpr as id) {
			val sym = self.symtab.lookup(id.name);
			if (sym != null) {
				if (sym.ast_node != null) self.append_defaults(sym.ast_node!, call.args.len, call);
				self.ensure_callee_ready(sym);
			}
		}
		val fn_info = callee_ty.as_fn();
		if (fn_info.is_variadic) {
			val min_args = fn_info.param_types.len - 1;
			if (call.args.len < min_args) {
				self.report_error(node, "Argument count mismatch in function call");
			} else {
				val elem_ty = fn_info.param_types[min_args];
				for (i in 0..<min_args) {
					val param_ty = fn_info.param_types[i];
					val arg_n = call.args[i];
					if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
						self.mark_node_mutated(arg_n);
					}
					val is_fn_forward = (
						param_ty?.kind == DataType.FN
						&& i == call.args.len - 1
						&& arg_n is IdentifierExpr
					);
					val prev_allow = self.allowing_fn_param_ref;
					if (is_fn_forward) self.allowing_fn_param_ref = true;
					val arg_ty = self.check_expr(arg_n, param_ty);
					self.allowing_fn_param_ref = prev_allow;
					if (!param_ty.can_assign(arg_ty)) {
						if (param_ty.kind == DataType.POINTER && arg_ty.kind == DataType.STRUCT) {
							val p_pointee = param_ty.as_pointer().pointee;
							if (p_pointee.equals(arg_ty)) {
								val ref_arg = self.arena.node(
									NodeData.UnaryExpr(TokenType.AMPERSAND, arg_n, false),
									arg_n.line, arg_n.col
								);
								call.args[i] = ref_arg;
								continue;
							}
						}
						self.report_error(node, "Argument type mismatch in function call");
					}
				}
				for (i in min_args..<call.args.len) {
					val arg_n = call.args[i];
					val arg_ty = self.check_expr(arg_n, elem_ty);
					if (!elem_ty.can_assign(arg_ty)) {
						self.report_error(node, "Argument type mismatch in variadic arguments");
					}
				}
			}
		} else if (call.args.len != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in function call");
		} else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i];
				val arg_n = call.args[i];
				if (param_ty?.kind == DataType.POINTER && param_ty.as_pointer().mutable) {
					self.mark_node_mutated(arg_n);
				}
				val is_fn_forward = (
					param_ty?.kind == DataType.FN
					&& i == call.args.len - 1
					&& arg_n is IdentifierExpr
				);
				val prev_allow = self.allowing_fn_param_ref;
				if (is_fn_forward) self.allowing_fn_param_ref = true;
				val arg_ty = self.check_expr(arg_n, param_ty);
				self.allowing_fn_param_ref = prev_allow;
				if (!param_ty.can_assign(arg_ty)) {
					if (param_ty.kind == DataType.POINTER && arg_ty.kind == DataType.STRUCT) {
						val p_pointee = param_ty.as_pointer().pointee;
						if (p_pointee.equals(arg_ty)) {
							val ref_arg = self.arena.node(
								NodeData.UnaryExpr(TokenType.AMPERSAND, arg_n, false),
								arg_n.line, arg_n.col
							);
							call.args[i] = ref_arg;
							continue;
						}
					}
					self.report_error(node, "Argument type mismatch in function call");
				}
			}
		}
		return fn_info.return_type;
	}

	pub fn check_lambda_expr(&self, node: *AstNode, expected: *Type? = null): *Type {
		if (node is LambdaExpr as lam) {
			if (!lam.is_trailing) {
				self.report_error(
					node,
					"Lambda must be passed outside parentheses as a trailing lambda (e.g. 'fn { x -> ... }' or 'fn(arg) { x -> ... }')"
				);
			}
			if (lam.had_empty_parens) {
				self.report_error(
					node,
					"Redundant empty parentheses '()' before trailing lambda; write 'fn { ... }' instead"
				);
			}
			if (expected == null || expected.kind != DataType.FN) {
				self.report_error(node, "Unexpected lambda expression; target parameter does not expect a function type");
				return self.prims().t_none();
			}

			val fn_info = expected.as_fn();
			if (lam.params.len != fn_info.param_types.len) {
				self.report_error(
					node,
					"Lambda parameter count mismatch: expected ${fn_info.param_types.len}, got ${lam.params.len}"
				);
				return expected!;
			}

			var resolved_param_types = List<*Type>();
			for (i in 0..<lam.params.len) {
				val p = lam.params[i];
				val exp_pt = fn_info.param_types[i];
				var p_ty = exp_pt;
				if (p.type_node != null) {
					p_ty = self.resolve_type(p.type_node!);
					if (exp_pt.kind != DataType.NONE && !exp_pt.equals(p_ty)) {
						self.report_error(
							p.type_node!,
							"Lambda parameter '${p.name}' type '${self.type_display(p_ty)}' does not match expected '${self.type_display(exp_pt)}'"
						);
					}
				}
				if (p_ty.kind == DataType.NONE) {
					self.report_error(node, "Cannot infer type for lambda parameter '${p.name}'");
				}
				resolved_param_types += p_ty;

				val outer_local = self.symtab.lookup_any_local(p.name);
				if (outer_local != null) {
					self.report_error(
						node,
						"Lambda parameter '${p.name}' cannot shadow outer local variable or parameter '${p.name}'"
					);
				}
			}

			val outer_in_lambda = self.in_lambda;
			val outer_lambda_scope = self.lambda_scope;
			val outer_lambda_ret = self.lambda_return_type;
			val outer_has_yield = self.lambda_has_yield;
			val outer_inferring_ret = self.lambda_inferring_return;
			val outer_captures = self.lambda_captures;
			val outer_loop_depth = self.loop_depth;
			val outer_when_depth = self.when_depth;
			val outer_defer_depth = self.defer_depth;
			val outer_when_subj = self.when_subject;

			self.in_lambda = true;
			self.lambda_scope = self.symtab.current_scope;
			self.lambda_return_type = fn_info.return_type;
			self.lambda_has_yield = false;
			self.lambda_captures = List<LambdaCapture>();
			self.loop_depth = 0;
			self.when_depth = 0;
			self.defer_depth = 0;
			self.when_subject = null;

			self.symtab.enter_scope(false);
			for (i in 0..<lam.params.len) {
				val p = lam.params[i];
				val p_ty = resolved_param_types[i];
				val ok = self.symtab.define(
					Symbol(p.name, p.name, SymbolKind.PARAM, p_ty, false, false, node.line, node.col, null)
				);
				if (!ok) {
					self.report_error(node, "Duplicate lambda parameter '${p.name}'");
				}
			}

			var inferred_ret = fn_info.return_type;
			if (lam.body is BlockStmt) {
				self.check_statement(lam.body);
				inferred_ret = self.lambda_return_type ?: self.prims().t_none();
				if (inferred_ret.kind != DataType.NONE && !self.lambda_has_yield) {
					self.report_error(
						node,
						"Multi-statement lambda expecting return type '${self.type_display(inferred_ret)}' must return a value using 'yield'"
					);
				}
			} else {
				if (lam.body is LambdaExpr) {
					self.report_error(lam.body, "Lambda cannot return another lambda/closure");
				}
				if (inferred_ret != null && inferred_ret.kind != DataType.NONE) {
					val body_ty = self.check_expr(lam.body, inferred_ret);
					if (body_ty.kind == DataType.FN) {
						self.report_error(lam.body, "Lambda cannot return another lambda/closure");
					}
					self.ensure(
						inferred_ret.can_assign(body_ty),
						lam.body,
						"Lambda body type '${self.type_display(body_ty)}' does not match expected return type '${self.type_display(inferred_ret)}'"
					);
				} else {
					val body_ty = self.check_expr_stmt(lam.body);
					if (body_ty.kind == DataType.FN) {
						self.report_error(lam.body, "Lambda cannot return another lambda/closure");
					}
					if (self.lambda_inferring_return && fn_info.return_type.kind == DataType.NONE) {
						inferred_ret = body_ty;
					}
				}
			}

			val final_ret = if (fn_info.return_type.kind != DataType.NONE) fn_info.return_type else inferred_ret;
			val final_fn_ty = self.arena.fn_type(resolved_param_types, final_ret);
			val captures = self.lambda_captures;

			self.symtab.exit_scope();

			self.in_lambda = outer_in_lambda;
			self.lambda_scope = outer_lambda_scope;
			self.lambda_return_type = outer_lambda_ret;
			self.lambda_has_yield = outer_has_yield;
			self.lambda_inferring_return = outer_inferring_ret;
			self.lambda_captures = outer_captures;
			self.loop_depth = outer_loop_depth;
			self.when_depth = outer_when_depth;
			self.defer_depth = outer_defer_depth;
			self.when_subject = outer_when_subj;

			// If this lambda is nested inside an outer lambda, propagate captures that belong
			// outside the outer lambda's boundary scope so the outer lambda also captures them.
			if (self.in_lambda && self.lambda_scope != null) {
				for (cap in captures) {
					val outer_sym = self.symtab.lookup_local_at_or_above(cap.name, self.lambda_scope);
					if (outer_sym != null) {
						self.record_lambda_capture(outer_sym);
					}
				}
			}

			val existing_id = if (self.symtab.has_lambda_info(node)) self.symtab.get_lambda_info(node).id else 0;
			val lam_id = if (existing_id > 0) existing_id else self.symtab.alloc_lambda_id();
			self.set_lambda_info(node, LambdaInfo(lam_id, final_fn_ty, captures));
			return final_fn_ty;
		}
		return self.prims().t_none();
	}

	pub fn check_struct_ctor(
		&self,
		node: *AstNode,
		callee_ty: *Type,
		call: *CallExpr,
		callee_is_self: bool
	): *Type {
		val s_info = callee_ty.as_struct();

		if (!callee_is_self) {
			val init_cand = s_info.find_static_method_arity("init", call.args.len);
			var nm = self.method_with_defaults(
				"init", call.args.len, s_info.methods, call, init_cand
			);
			if (nm == null) {
				val new_cand = s_info.find_static_method_arity("new", call.args.len);
				nm = self.method_with_defaults(
					"new", call.args.len, s_info.methods, call, new_cand
				);
			}
			if (nm != null) {
				val n_info = nm.fn_type.as_fn();
				if (n_info.is_variadic) {
					val min_args = n_info.param_types.len - 1;
					val elem_ty = n_info.param_types[min_args];
					for (i in 0..<min_args) {
						val param_ty = n_info.param_types[i];
						val arg_n = call.args[i];
						val arg_ty = self.check_expr(arg_n, param_ty);
						self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in call to constructor");
					}
					for (i in min_args..<call.args.len) {
						val arg_n = call.args[i];
						val arg_ty = self.check_expr(arg_n, elem_ty);
						self.ensure(elem_ty.can_assign(arg_ty), node, "Argument type mismatch in variadic arguments");
					}
				} else {
					for (i in 0..<call.args.len) {
						val param_ty = n_info.param_types[i];
						val arg_n = call.args[i];
						val arg_ty = self.check_expr(arg_n, param_ty);
						self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in call to 'new'");
					}
				}
				self.set_method(node, nm);
				if (self.arrow_pending(nm.ast_node)) self.infer_blocked = true;
				return n_info.return_type;
			}
		}

		if (s_info.has_private && s_info.module != self.symtab.current_module) {
			self.report_error(
				node,
				"Cannot construct '${s_info.name}' from its fields: they are private to " +
				"module '${s_info.module}'; add a 'new' constructor"
			);
		}

		if (call.args.len < s_info.fields.len) {
			var all_default = true;
			for (i in call.args.len..<s_info.fields.len) {
				if (s_info.fields[i].default_val == null) {
					all_default = false;
					break;
				}
			}
			if (all_default) {
				for (i in call.args.len..<s_info.fields.len) {
					call.args += self.copy_expr(s_info.fields[i].default_val!);
				}
			}
		}

		if (call.args.len != s_info.fields.len) {
			self.report_error(node, "Argument count mismatch in struct constructor");
		} else {
			for (i in 0..<call.args.len) {
				val f_ty = s_info.fields[i].type_ptr;
				val arg_n = call.args[i];
				val arg_ty = self.check_expr(arg_n, f_ty);
				self.ensure(
					f_ty.can_assign(arg_ty),
					node,
					"Field type mismatch in struct constructor: '${s_info.c_name}.${s_info.fields[i].name}' " +
					"expects ${self.type_display(f_ty)} got ${self.type_display(arg_ty)}"
				);
			}
		}

		val ctor_expr = self.arena.node(
			NodeData.StructCtorExpr(s_info.c_name, call.args),
			node.line, node.col
		);
		self.set_resolved(node, ctor_expr);
		return callee_ty;
	}

}
