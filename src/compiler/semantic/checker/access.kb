mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Member, Index and Assignment Checking
 *
 * Receiver access (member, index), lvalue mutability, assignment, compound
 * updates, and lowering of indexed writes into get/set calls.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

impl BodyChecker {

	pub fn unwrap_group_mut(*self, node: &AstNode): &AstNode {
		var cur = node;
		while (true) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		return cur;
	}

	pub fn check_member_expr(&self, node: &AstNode): *Type {
		if (node is MemberExpr as mem) {
			val const_ty = self.check_const_member(node, mem);
			if (const_ty != null) return const_ty;

			var obj_expr = mem.object;
			if (obj_expr is IdentifierExpr as id && id.name.empty() && self.when_subject != null) {
				val subj_copy = self.copy_expr(self.when_subject);
				if (self.current_rec != null) self.set_ann_obj(node, subj_copy);
				else mem.object = subj_copy;
				obj_expr = subj_copy;
			}
			val prev_elvis = self.in_elvis_lhs;
			val was_assign_target = self.is_assign_target;
			self.in_elvis_lhs = false;
			self.is_assign_target = false;
			var obj_ty = self.check_expr(obj_expr);
			self.is_assign_target = was_assign_target;

			if (!mem.is_safe && obj_ty.kind == DataType.POINTER && obj_ty.as_pointer()!.nullable) {
				self.report_error(
					node,
					"Cannot access member '${mem.member}' on nullable pointer " +
					"'${self.type_display(obj_ty)}'; use '?.' or unwrap with '!' first"
				);
			} else if (!mem.is_safe && obj_ty.kind == DataType.POINTER && obj_expr !is IdentifierExpr) {
				val deref = self.arena.node(
					NodeData.UnaryExpr(TokenType.STAR, obj_expr, false),
					node.line, node.col
				);
				if (self.current_rec != null) self.set_ann_obj(node, deref);
				else mem.object = deref;
				obj_expr = deref;
				obj_ty = self.check_expr(obj_expr);
			}

			if (obj_ty.kind == DataType.ERROR_UNION) {
				self.report_error(
					node,
					"Cannot access member '${mem.member}' on unhandled error union " +
					"'${self.type_display(obj_ty)}'; handle with '!:', '?', or '!'"
				);
				return self.prims().t_none();
			}

			var obj_was_ptr = false;
			if (obj_ty.kind == DataType.POINTER) {
				obj_was_ptr = true;
				obj_ty = obj_ty.as_pointer()!.pointee;
			}

			if (mem.is_safe && !obj_was_ptr) {
				self.report_error(node, "Safe call operator '?.' requires a pointer receiver");
				return self.prims().t_none();
			}

			if (mem.member == "value" && !obj_was_ptr && obj_ty.is_enum()) {
				return obj_ty.as_enum()!.underlying;
			}

			var ret_ty = self.prims().t_none();
			if (obj_ty.kind == DataType.STR) {
				ret_ty = self.member_on_str(node, mem);
			} else if (obj_ty.kind == DataType.ARRAY) {
				ret_ty = self.member_on_array(node, mem, obj_ty);
			} else if (obj_ty.kind != DataType.STRUCT) {
				self.report_error(
					node,
					"Member access on non-struct type '${mem.member}' of ${self.type_display(obj_ty)}"
				);
				return self.prims().t_none();
			} else {
				ret_ty = self.member_on_struct(node, mem, obj_ty);
			}

			if (mem.is_safe) {
				if (ret_ty.kind == DataType.POINTER) {
					val pt = ret_ty.as_pointer();
					ret_ty = self.arena.nullable_pointer_type(pt!.pointee, pt!.mutable);
				} else if (ret_ty.kind != DataType.STR) {
					val scalar_safe = self.type_has_safe_default(ret_ty);
					val allow_safe = prev_elvis || (self.in_safe_nav_context && scalar_safe);
					self.ensure(
						allow_safe,
						node,
						if (scalar_safe)
							"Safe navigation '?.' on non-pointer field '${mem.member}' requires " +
							"handling null with '?:' or being used in a condition"
						else
							"Safe navigation '?.' on non-pointer field '${mem.member}' of type " +
							"'${self.type_display(ret_ty)}' requires handling null with '?:'"
					);
				}
			}
			self.in_elvis_lhs = prev_elvis;

			if (
				!mem.is_safe &&
				!was_assign_target &&
				ret_ty.kind == DataType.POINTER &&
				ret_ty.as_pointer()!.nullable
			) {
				val p_key = self.non_null_path_key(node);
				if (!p_key.empty() && self.is_path_non_null(p_key)) {
					val pt = ret_ty.as_pointer()!;
					ret_ty = self.arena.pointer_type(pt.pointee, pt.mutable);
				}
			}

			return ret_ty;
		}
		return self.prims().t_none();
	}

	fn check_const_member(&self, node: &AstNode, mem: &MemberExpr): ?*Type {
		val obj = mem.object;
		if (obj is IdentifierExpr as enum_id) {
			val sym = self.symtab.lookup(enum_id.name);
			val ei = if (sym != null) self.symtab.find_enum_info(sym.c_name)
				else self.symtab.find_enum_info(enum_id.name);
			if (ei != null) {
				val mi = ei.find_member(mem.member);
				if (mi == null) {
					val kind_lbl = if (ei.is_fault) "Fault" else "Enum";
					self.report_error(node, "${kind_lbl} '${enum_id.name}' has no member '${mem.member}'");
					return self.prims().t_none();
				}

				if (ei.is_payload) {
					val e_sym = sym ?: self.symtab.lookup(ei.c_name) ?: self.symtab.lookup(ei.name)
						?: return self.prims().t_none();
					val payload_st = mi?.payload_ty?.as_struct();
					if (payload_st != null && !payload_st.fields.empty()) {
						self.report_error(
							node,
							"Variant '${enum_id.name}.${mem.member}' carries data; " +
							"construct it with '${enum_id.name}.${mem.member}(...)'"
						);
						return self.prims().t_none();
					}
					val err_code: u32 = if (ei.is_fault) mi.err_code else 0;
					val o_file = if (ei.is_fault) self.node_file_path(node) else "";
					val o_line: usz = if (ei.is_fault) node.line else 0;
					val o_col: usz = if (ei.is_fault) node.col else 0;
					val o_fn = if (ei.is_fault) self.current_fn_display_name else "";
					var ctor = self.arena.node(NodeData.EnumCtorExpr(
						ei.c_name, ei.tag_field, mi.value, "",
						List<&AstNode>(), err_code, o_file, o_line, o_col, o_fn
					), node.line, node.col);
					ctor.span = node.span;
					self.set_resolved(node, ctor);
					return e_sym.type_ptr;
				}

				val lit = self.arena.node(NodeData.LiteralExpr(mi.lit_kind, mi.raw_text), node.line, node.col);
				self.set_resolved(node, lit);
				val carrier = self.arena.create_val(
					Type(ei.underlying.kind, ei.underlying.size, ei.underlying.align, TypePayload.Enum(ei))
				);
				return carrier;
			}

			val s_sym = self.symtab.lookup(enum_id.name);
			var target_ty: ?*Type = null;
			if (
				enum_id.name == "Self" &&
				self.current_self_type != null
			) target_ty = self.current_self_type;
			else if (
				s_sym != null &&
				s_sym.kind in [SymbolKind.STRUCT, SymbolKind.OBJECT]
			) target_ty = s_sym.type_ptr;

			if (target_ty != null && target_ty.kind == DataType.STRUCT) {
				val owner_st = target_ty.as_struct();
				val owner_mod = owner_st?.module ?: "";
				val owner_orig_name = owner_st?.name ?: enum_id.name;
				var c_sym: ?*Symbol = null;
				if (!owner_mod.empty()) {
					c_sym = self.symtab.lookup_in_module(owner_mod, "${owner_orig_name}__${mem.member}");
				}
				if (c_sym == null) c_sym = self.symtab.lookup("${enum_id.name}__${mem.member}");
				if (c_sym == null) c_sym = self.symtab.lookup_struct_const(enum_id.name, mem.member);
				if (c_sym == null) c_sym = self.symtab.lookup_struct_const(owner_orig_name, mem.member);
				if (c_sym != null && c_sym.kind == SymbolKind.CONST) {
					if (mem.is_safe) {
						self.report_error(node, "Safe navigation '?.' cannot be used on constant '${owner_orig_name}.${mem.member}'");
						return self.prims().t_none();
					}
					if (
						owner_st != null
						&& owner_st.is_object
						&& !owner_mod.empty()
						&& owner_mod != self.symtab.current_module
						&& !c_sym.public
					) {
						self.report_error(
							node,
							"Constant '${mem.member}' of object '${owner_orig_name}' is private to module '${owner_mod}'"
						);
					}
					val id_expr = self.arena.node(
						NodeData.IdentifierExpr(c_sym.c_name),
						node.line, node.col
					);
					self.set_resolved(node, id_expr);
					return c_sym.type_ptr;
				}
				if (owner_st != null && owner_st.is_object) {
					self.report_error(
						node,
						"Constant or member '${mem.member}' not found on object '${owner_orig_name}'"
					);
					return self.prims().t_none();
				}
			}
		}
		return null;
	}

	fn member_on_str(&self, node: *AstNode, mem: *MemberExpr): *Type => when (mem.member) {
		"len", "size" -> self.prims().t_usz();
		"cap" -> self.prims().t_usz();
		"c_str" -> {
			val char_ty = self.prims().t_char();
			val char_ptr = self.arena.pointer_type(char_ty, false);
			yield self.arena.fn_type(List<*Type>(), char_ptr);
		}
		"data" -> {
			val char_ty = self.prims().t_char();
			yield self.arena.pointer_type(char_ty, false);
		}
		else -> {
			self.report_error(node, "Member access on non-struct type");
			yield self.prims().t_none();
		}
	};

	fn member_on_array(&self, node: *AstNode, mem: *MemberExpr, obj_ty: *Type): *Type {
		val arr = obj_ty.as_array();
		if (mem.member in ["len", "size"]) return self.prims().t_usz();
		if (mem.member == "data") return self.arena.pointer_type(arr!.elem, true);
		self.report_error(node, "Member access on non-struct type");
		return self.prims().t_none();
	}

	fn member_on_struct(&self, node: *AstNode, mem: *MemberExpr, obj_ty: *Type): *Type {
		val s_info = obj_ty.as_struct() ?: return self.prims().t_none();
		for (f in s_info.fields) {
			if (f.name != mem.member) continue;
			if (!f.public && s_info.module != self.symtab.current_module) {
				self.report_error(
					node,
					"Field '${mem.member}' of '${s_info.name}' is private to module '${s_info.module}'"
				);
			}
			return f.type_ptr;
		}
		self.report_error(node, "Struct '${s_info.name}' has no member named '${mem.member}'");
		return self.prims().t_none();
	}

	pub fn check_index_expr(&self, node: &AstNode): *Type {
		if (node is IndexExpr as idx) {
			val target_ty = self.check_expr(idx.target);
			val index_ty = self.check_expr(idx.index);

			if (target_ty.kind == DataType.ERROR_UNION) {
				self.report_error(
					node,
					"Cannot index unhandled error union '${self.type_display(target_ty)}'; " +
					"handle with '!:', '?', or '!'"
				);
				return self.prims().t_none();
			}

			if (target_ty.kind == DataType.POINTER && target_ty.as_pointer()!.nullable) {
				self.report_error(
					node,
					"Cannot index nullable pointer '${self.type_display(target_ty)}'; " +
					"check for null or unwrap with '!' first"
				);
			}

			if (
				target_ty.kind in [DataType.ARRAY, DataType.STR] ||
				(target_ty.kind == DataType.POINTER && index_ty.is_integer())
			) {
				self.ensure(index_ty.is_integer(), node, "Index must be integer");
				return when (target_ty.kind) {
					DataType.ARRAY -> target_ty.as_array()!.elem;
					DataType.STR -> self.prims().t_char();
					DataType.POINTER -> target_ty.as_pointer()!.pointee;
					else -> self.prims().t_none();
				};
			}

			val t_is_ptr = target_ty.kind == DataType.POINTER;
			val t_struct_ty = if (t_is_ptr) target_ty.as_pointer()!.pointee else target_ty;
			if (t_struct_ty?.kind == DataType.STRUCT) {
				val s_info = t_struct_ty.as_struct();
				var arg_types = List<*Type>();
				arg_types += t_struct_ty;
				arg_types += index_ty;
				val mi = s_info!.find_operator("get", arg_types)
					?: s_info!.find_method_arity("get", 2)
					?: s_info!.find_method("get");

				if (mi != null) {
					val fn_info = mi.fn_type.as_fn();
					val param_ty = fn_info!.param_types[1];
					if (self.is_untyped_literal(idx.index)) self.check_expr(idx.index, param_ty);
					self.ensure(param_ty.can_assign(index_ty), node, "Argument type mismatch in index access");

					if (self.arrow_pending(mi.ast_node)) self.infer_blocked = true;
					self.set_method(node, mi);
					return fn_info!.return_type;
				}
			}

			if (target_ty.kind == DataType.POINTER) {
				self.ensure(index_ty.is_integer(), node, "Index must be integer");
				return target_ty.as_pointer()!.pointee;
			}

			self.report_error(node, "Index access on non-indexable type");
			return self.prims().t_none();
		}
		return self.prims().t_none();
	}

	pub fn mark_symbol_mutated(*self, name: str) {
		val sym = self.symtab.lookup_local_mut(name);
		if (sym != null) {
			sym.mutated = true;
			if (!sym.decl_key.empty()) {
				self.symtab.sem.mutated_decl_keys[sym.decl_key] = true;
			}
		}
	}

	pub fn mark_node_mutated(&self, node: ?*AstNode) {
		if (node == null) return;
		val cur = self.unwrap_group(node);
		when (cur) {
			is IdentifierExpr -> self.mark_symbol_mutated(cur.name);
			is MemberExpr -> self.mark_node_mutated(cur.object);
			is IndexExpr -> self.mark_node_mutated(cur.target);
			is UnaryExpr -> if (cur.op == TokenType.AMPERSAND) self.mark_node_mutated(cur.operand);
		}
	}

	pub fn check_lvalue_mutability(
		&self,
		target_node: *AstNode,
		op_node: *AstNode,
		is_update: bool
	) {
		val cur = self.unwrap_group(target_node) ?: return;

		when (cur) {
			is IdentifierExpr -> {
				self.check_ident_assignable(op_node, cur.name, self.symtab.lookup(cur.name), is_update);
				self.mark_symbol_mutated(cur.name);
			}
			is MemberExpr -> {
				if (cur.is_safe) {
					self.report_error(op_node, "Cannot assign to safe navigation expression");
				}
				self.check_lvalue_base_mutability(
					cur.object, op_node, "field '${cur.member}'", false, is_update
				);
				self.mark_node_mutated(cur.object);
			}
			is IndexExpr -> {
				self.check_lvalue_base_mutability(
					cur.target, op_node, "through index", true, is_update
				);
				self.mark_node_mutated(cur.target);
			}
			else -> self.report_error(op_node, "Invalid target for ${self.target_word(is_update)}");
		}
	}

	fn check_ro_pointer_write(
		&self,
		ptr_node: *AstNode,
		ptr_ty: *Type,
		op_node: *AstNode,
		target_desc: str,
		act: str
	) {
		if (!ptr_ty.as_pointer()!.mutable) {
			if (self.is_immutable_self(ptr_node)) {
				self.report_error(
					op_node,
					"Cannot ${act} ${target_desc} on immutable receiver 'self' in '*self' method"
				);
			} else if (!ptr_ty.as_pointer()!.nullable) {
				self.report_error(
					op_node,
					"Cannot ${act} ${target_desc} through read-only pointer '${self.type_display(ptr_ty)}'"
				);
			}
		}
	}

	fn check_lvalue_base_mutability(
		&self,
		expr_node: *AstNode,
		op_node: *AstNode,
		target_desc: str,
		is_index: bool,
		is_update: bool
	) {
		val cur = self.unwrap_group(expr_node) ?: return;
		val act = if (is_update) "update" else "mutate";

		if (cur is UnaryExpr as un && un.op == TokenType.STAR) {
			val ptr_ty = self.node_type_of(un.operand);
			if (ptr_ty?.kind == DataType.POINTER) {
				self.check_ro_pointer_write(un.operand, ptr_ty, op_node, target_desc, act);
			}
			return;
		}

		val expr_ty = self.node_type_of(cur);
		if (is_index && expr_ty?.kind == DataType.STR) {
			self.report_error(op_node, "Cannot ${act} through index on immutable string type 'str'");
			return;
		}
		if (expr_ty?.kind == DataType.POINTER) {
			self.check_ro_pointer_write(cur, expr_ty, op_node, target_desc, act);
			return;
		}

		when (cur) {
			is IdentifierExpr as id -> {
				val sym = self.symtab.lookup(id.name);
				if (sym?.type_ptr?.kind == DataType.POINTER) {
					self.check_ro_pointer_write(cur, sym.type_ptr, op_node, target_desc, act);
				} else if (sym != null && !sym.mutable) {
					self.report_error(
						op_node,
						"Cannot ${act} ${target_desc} on immutable variable '${id.name}' " +
						"declared with 'val'. Use 'var' instead."
					);
				}
			}
			is MemberExpr as mem ->
				self.check_lvalue_base_mutability(mem.object, op_node, target_desc, false, is_update);
			is IndexExpr as idx ->
				self.check_lvalue_base_mutability(idx.target, op_node, target_desc, false, is_update);
		}
	}

	fn target_word(*self, update: bool) =>
		if (update) "increment/decrement operator" else "assignment";

	pub fn unwrap_group(*self, node: *AstNode): *AstNode {
		var cur = node;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		return cur;
	}

	fn is_immutable_self(*self, obj_node: *AstNode): bool {
		val obj = self.unwrap_group(obj_node);
		if (obj is IdentifierExpr as obj_id && obj_id.name == "self") {
			val self_sym = self.symtab.lookup("self");
			return self_sym != null && !self_sym.mutable;
		}
		return false;
	}

	fn check_ident_assignable(&self, op_node: *AstNode, name: str, sym: ?*Symbol, is_update: bool) {
		if (sym == null) return;
		val act = if (is_update) "update" else "assign to";
		when (sym.kind) {
			SymbolKind.CONST -> self.report_error(op_node, "Cannot ${act} constant '${name}'");
			SymbolKind.VAR -> {
				if (!sym.mutable) {
					self.report_error(op_node, "Cannot ${act} immutable variable '${name}' declared with 'val'");
				}
			}
			SymbolKind.PARAM -> {
				if (!sym.mutable) {
					self.report_error(op_node, "Cannot ${act} immutable parameter '${name}'");
				}
			}
			else -> self.report_error(op_node, "Cannot ${act} '${name}'");
		}
	}

	pub fn check_assign_expr(&self, node: &AstNode): *Type {
		if (node is AssignExpr as asgn) {
			val was_stmt = self.is_stmt_level;
			self.is_stmt_level = false;
			val target_expr = self.unwrap_group_mut(asgn.target);

			if (target_expr is IndexExpr as idx) {
				val lowered = self.lower_index_assign(node, asgn, idx);
				if (lowered != null) {
					self.check_lvalue_mutability(target_expr, node, false);
					return lowered;
				}
			}

			val prev_asgn_target = self.is_assign_target;
			if (asgn.op == TokenType.EQUAL) self.is_assign_target = true;
			var target_ty = self.check_expr(asgn.target);
			self.is_assign_target = prev_asgn_target;
			var sym_to_update: ?&Symbol = null;
			if (target_expr is IdentifierExpr as id) {
				val sym = self.symtab.lookup_local_mut(id.name);
				if (sym != null) {
					if (asgn.op == TokenType.EQUAL) sym.is_moved = false;
					if (asgn.op == TokenType.EQUAL && sym.orig_type != null) {
						target_ty = sym.orig_type;
						sym_to_update = sym;
					}
				}
			}
			val prev_stmt = self.is_stmt_level;
			self.is_stmt_level = was_stmt;
			val val_ty = self.check_expr(asgn.value, target_ty);
			self.is_stmt_level = prev_stmt;

			if (asgn.op != TokenType.EQUAL) {
				val t_is_ptr = target_ty.kind == DataType.POINTER;
				val t_struct_ty = if (t_is_ptr) target_ty.as_pointer()!.pointee else target_ty;
				if (t_struct_ty?.kind == DataType.STRUCT) {
					val op_name = when (asgn.op) {
						TokenType.PLUS_EQUAL -> "plus_assign";
						TokenType.MINUS_EQUAL -> "minus_assign";
						TokenType.STAR_EQUAL -> "mul_assign";
						TokenType.SLASH_EQUAL -> "div_assign";
						TokenType.PERCENT_EQUAL -> "rem_assign";
						else -> "";
					};
					if (!op_name.empty()) {
						val s_info = t_struct_ty.as_struct();
						var arg_types = List<*Type>();
						arg_types += t_struct_ty;
						arg_types += val_ty;
						val mi = s_info!.find_operator(op_name, arg_types);
						if (mi != null) {
							if (!t_is_ptr) self.check_lvalue_mutability(target_expr, node, false);
							else if (target_ty.as_pointer()!.nullable) {
								self.report_error(
									node,
									"Cannot call operator '${op_name}' on nullable pointer " +
									"'${self.type_display(target_ty)}'; check for null or unwrap with '!' first"
								);
							} else {
								self.check_ro_pointer_write(target_expr, target_ty, node, "value", "mutate");
							}
							self.mark_node_mutated(target_expr);
							self.set_method(node, mi);
							return mi.fn_type.as_fn()!.return_type;
						}
					}
				}
			}

			self.check_lvalue_mutability(target_expr, node, false);

			if (asgn.op == TokenType.PLUS_EQUAL && target_ty.kind == DataType.STR) return target_ty;

			if (asgn.op != TokenType.EQUAL) {
				self.ensure(
					target_ty.is_numeric() && val_ty.is_numeric(),
					node,
					"Compound assignment operator requires numeric operands"
				);
			}

			self.ensure(target_ty.can_assign(val_ty), node, "Type mismatch in assignment");
			if (sym_to_update != null) {
				sym_to_update.type_ptr = val_ty;
				sym_to_update.is_moved = false;
			}
			if (asgn.op == TokenType.EQUAL) {
				val t_path = self.non_null_path_key(target_expr);
				if (!t_path.empty()) {
					val assigned_non_null = val_ty.kind == DataType.POINTER && !val_ty.as_pointer()!.nullable;
					if (assigned_non_null) {
						self.invalidate_non_null_path(t_path);
						self.add_non_null_path(t_path);
					} else {
						self.invalidate_non_null_path(t_path);
					}
				}
			}
			return target_ty;
		}
		return self.prims().t_none();
	}

	fn lower_index_assign(&self, node: &AstNode, asgn: &AssignExpr, idx: &IndexExpr): ?*Type {
		val bin_op = when (asgn.op) {
			TokenType.PLUS_EQUAL -> TokenType.PLUS;
			TokenType.MINUS_EQUAL -> TokenType.MINUS;
			TokenType.STAR_EQUAL -> TokenType.STAR;
			TokenType.SLASH_EQUAL -> TokenType.SLASH;
			TokenType.PERCENT_EQUAL -> TokenType.PERCENT;
			else -> TokenType.EQUAL;
		};
		return self.lower_index_write(node, idx, bin_op, asgn.value, "assignment");
	}

	fn lower_index_write(
		&self,
		node: &AstNode,
		idx: *IndexExpr,
		op: TokenType,
		rhs: ?&AstNode,
		what: str
	): ?*Type {
		val target_raw_ty = self.check_expr(idx.target);
		val t_is_ptr = target_raw_ty.kind == DataType.POINTER;
		val t_struct_ty = if (t_is_ptr) target_raw_ty.as_pointer()!.pointee else target_raw_ty;
		if (t_struct_ty == null || t_struct_ty.kind != DataType.STRUCT) return null;

		val idx_ty_raw = self.check_expr(idx.index);
		if (t_is_ptr && idx_ty_raw.is_integer()) return null;

		val s_info = t_struct_ty.as_struct();
		val val_ty_raw = if (rhs != null) self.check_expr(rhs) else null;

		var arg_types = List<*Type>();
		arg_types += t_struct_ty;
		arg_types += idx_ty_raw;
		if (val_ty_raw != null) arg_types += val_ty_raw;

		val mi = s_info!.find_operator("set", arg_types)
			?: s_info!.find_method_arity("set", 3)
			?: s_info!.find_method("set")
			?: return null;

		if (t_is_ptr && target_raw_ty.as_pointer()!.nullable && op == TokenType.EQUAL) {
			self.report_error(
				node,
				"Cannot index nullable pointer '${self.type_display(target_raw_ty)}'; " +
				"check for null or unwrap with '!' first"
			);
		}

		val fn_info = mi.fn_type.as_fn();
		val idx_param_ty = fn_info!.param_types[1];
		val val_param_ty = fn_info!.param_types[2];

		val operand = if (rhs != null) rhs
			else if (val_param_ty.is_float()) self.arena.node(
				NodeData.LiteralExpr(Literal.FLOAT, "1.0"),
				node.line, node.col
			) else self.arena.node(
				NodeData.LiteralExpr(Literal.INTEGER, "1"),
				node.line, node.col
			);

		var val_expr: &AstNode = operand;
		if (op != TokenType.EQUAL) {
			val get_expr = self.arena.node(NodeData.IndexExpr(idx.target, idx.index), node.line, node.col);
			val_expr = self.arena.node(NodeData.BinaryExpr(get_expr, op, operand), node.line, node.col);
		}

		if (self.is_untyped_literal(idx.index)) self.check_expr(idx.index, idx_param_ty);
		self.ensure(idx_param_ty.can_assign(idx_ty_raw), node, "Index type mismatch in index ${what}");

		val val_ty = if (op != TokenType.EQUAL) self.check_expr(val_expr, val_param_ty)
			else if (rhs != null && self.is_untyped_literal(rhs)) self.check_expr(rhs, val_param_ty)
			else val_ty_raw;
		self.ensure(
			val_ty == null || val_param_ty.can_assign(val_ty),
			node,
			"Value type mismatch in index ${what}"
		);

		var new_args = List<&AstNode>();
		val target_arg = if (t_is_ptr) idx.target else self.arena.node(
			NodeData.UnaryExpr(TokenType.AMPERSAND, idx.target, false),
			node.line, node.col
		);
		new_args += target_arg;
		new_args += idx.index;
		new_args += val_expr;

		val callee = self.arena.node(NodeData.IdentifierExpr(mi.c_name), node.line, node.col);
		val call_node = self.arena.node(
			NodeData.CallExpr(callee, new_args, List<&AstNode>()),
			node.line, node.col
		);
		self.set_resolved(node, call_node);
		return val_param_ty;
	}

	pub fn check_update_expr(&self, node: &AstNode): *Type {
		if (node is UpdateExpr as u) {
			val target_expr = self.unwrap_group(u.target);

			if (target_expr is IndexExpr as idx) {
				val op = if (u.op == TokenType.PLUS_PLUS) TokenType.PLUS else TokenType.MINUS;
				val lowered = self.lower_index_write(node, idx, op, null, "update");
				if (lowered != null) {
					self.check_lvalue_mutability(target_expr, node, true);
					return lowered;
				}
			}

			val target_ty = self.check_expr(u.target);
			self.check_lvalue_mutability(target_expr, node, true);
			self.ensure(
				target_ty.is_numeric(),
				node,
				"Increment/decrement operator requires numeric operand"
			);
			return target_ty;
		}

		return self.prims().t_none();
	}

	pub fn check_cast_expr(&self, node: &AstNode): *Type {
		if (node is CastExpr as cst) {
			val src_ty = if (cst.expr != null) self.check_expr(cst.expr) else self.prims().t_none();
			val ty = self.resolve_type(cst.target_type);
			if (self.current_rec != null) self.set_ann_ty(cst.target_type, ty);

			if (cst.expr != null && self.is_null_literal(cst.expr)) {
				self.report_error(
					node,
					"Cannot cast 'null' with 'as'. Use an explicit type annotation instead"
				);
				return ty;
			}

			if (src_ty?.is_enum()) {
				self.report_error(
					node,
					"Cannot cast enum '${src_ty.as_enum()!.name}' with 'as'. " +
					"Use '.value' to access its underlying value"
				);
			}
			if (src_ty?.kind == DataType.ERROR_UNION || ty?.kind == DataType.ERROR_UNION || src_ty?.is_fault() || ty?.is_fault()) {
				self.report_error(node, "Cannot cast fault or error union with 'as'");
			}
			if (ty?.is_enum()) {
				self.report_error(
					node,
					"Cannot cast to enum type '${ty.as_enum()!.name}' with 'as'. " +
					"Use constructor '${ty.as_enum()!.name}(value)' instead"
				);
			}
			if (src_ty?.kind == DataType.POINTER && ty?.is_integer()) {
				self.report_error(node, "Cannot cast pointer to integer with 'as'. Use '.addr()' instead");
			}
			if (src_ty?.is_integer() && ty?.kind == DataType.POINTER) {
				self.report_error(node, "Cannot cast integer to pointer with 'as'");
			}
			if (src_ty?.kind == DataType.CHAR && ty?.is_integer()) {
				self.report_error(node, "Cannot cast 'char' with 'as'. Use '.code()' instead");
			}
			if (src_ty?.is_integer() && ty?.kind == DataType.CHAR) {
				self.report_error(node, "Cannot cast integer to 'char' with 'as'. Use 'char(code)' instead");
			}
			if (src_ty?.kind == DataType.POINTER && ty?.kind == DataType.POINTER) {
				val src_ptr = src_ty.as_pointer()!;
				val dst_ptr = ty.as_pointer()!;
				if (src_ptr.nullable && !dst_ptr.nullable) {
					self.report_error(
						node,
						"Cannot cast nullable pointer '${self.type_display(src_ty)}' to non-nullable pointer " +
						"'${self.type_display(ty)}'. Use nullable pointer type " +
						"'?${self.type_display(ty)}' or force unwrap '!' instead"
					);
				} else if (!src_ptr.mutable && dst_ptr.mutable) {
					self.report_error(
						node,
						"Cannot cast read-only pointer '${self.type_display(src_ty)}' " +
						"to mutable pointer '${self.type_display(ty)}'"
					);
				}
			}
			return ty;
		}
		return self.prims().t_none();
	}

}
