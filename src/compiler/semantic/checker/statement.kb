mod compiler.semantic.checker;

/*
 * ============================================================================
 * BodyChecker - Statement Type Checking
 *
 * Analyzes statement nodes (blocks, variables, loops, conditionals, returns).
 * Handles lowering for `for` loops through `Iterable`.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.ast.*;
use compiler.lexer.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.lowering.*;

impl BodyChecker {

	pub fn check_block_stmt(&self, node: *AstNode) {
		if (node is BlockStmt as blk) {
			self.symtab.enter_scope(false);
			defer self.symtab.exit_scope();
			for (stmt in blk.statements) {
				self.check_statement(stmt);
			}
		}
	}

	pub fn check_var_decl_stmt(&self, node: *AstNode) {
		if (node is VarDeclStmt as vd) {
			var var_ty = self.prims().t_none();
			var has_init = false;

			if (vd.type_annotation != null) {
				var_ty = self.resolve_type(vd.type_annotation!);
				if (self.current_rec != null) {
					self.set_ann_ty(vd.type_annotation!, var_ty);
				}
				if (vd.initializer != null) {
					has_init = true;
					var init_expr = vd.initializer;
					if (self.current_rec != null) {
						val init_ov = self.propagate_instance_init(vd.initializer!, var_ty);
						if (init_ov != null) {
							self.set_ann_init_override(node, init_ov);
							init_expr = init_ov;
						}
					}
					val init_ty = self.check_expr_stmt(init_expr!, var_ty);
					self.ensure(
						var_ty.can_assign(init_ty),
						node,
						"Type mismatch in variable declaration for '${vd.name}'"
					);
				}
			} else {
				if (vd.initializer != null) {
					has_init = true;
					var_ty = self.check_expr_stmt(vd.initializer!);
				} else {
					self.report_error(node, "Variable '${vd.name}' without type must have initializer");
				}
			}

			if (vd.type_annotation == null && has_init) {
				if (self.current_rec != null) {
					self.set_ann_var_ty(node, var_ty);
				} else {
					vd.type_annotation = self.arena.ast_type_from_type(var_ty);
				}
			}

			if (var_ty.kind == DataType.FN) {
				self.report_error(node, "Lambda closure cannot be stored in a variable; pass it directly to a function call");
			}

			val ok = self.symtab.define(
				Symbol(vd.name, vd.name, SymbolKind.VAR, var_ty, vd.mutable, false, node.line, node.col, null)
			);
			self.ensure(ok, node, "Variable '${vd.name}' is already defined in this scope");
		}
	}

	pub fn check_destruct_decl_stmt(&self, node: *AstNode) {
		if (node is DestructDeclStmt as ds) {
			val init_ty = self.check_expr_stmt(ds.initializer);
			self.ensure(init_ty.kind != DataType.NONE, node, "Cannot destructure void expression");

			var struct_ty = init_ty;
			if (struct_ty.kind == DataType.POINTER) {
				val ptr_ty = struct_ty.as_pointer();
				if (ptr_ty.nullable) {
					self.report_error(node, "Cannot destructure nullable pointer '${self.type_display(init_ty)}'. Use '!' or null-check first");
					return;
				}
				struct_ty = ptr_ty.pointee;
			}

			self.ensure(
				struct_ty.kind == DataType.STRUCT,
				node,
				"Cannot destructure non-struct type"
			);
			if (struct_ty.kind != DataType.STRUCT) return;

			val s_info = struct_ty.as_struct()!;
			var found_mi: ?*MethodInfo = null;
			var is_indexed = false;

			// Check Form A: unpack(self, p1, p2, ... pn) where n == ds.names.len
			// Every unpacked parameter in Form A must be a pointer type (&T or *T).
			for (m in s_info.methods) {
				if (m.operator && m.name == "unpack") {
					val fn_t = m.fn_type.as_fn();
					if (fn_t.param_types.len == ds.names.len + 1) {
						var all_ptrs = true;
						for (i in 1..<fn_t.param_types.len) {
							if (fn_t.param_types[i].kind != DataType.POINTER) {
								all_ptrs = false;
								break;
							}
						}
						if (all_ptrs) {
							found_mi = m;
							is_indexed = false;
							break;
						}
					}
				}
			}

			// If Form A not found, check Form B: unpack(self, idx: integer): T
			if (found_mi == null) {
				for (m in s_info.methods) {
					if (m.operator && m.name == "unpack") {
						val fn_t = m.fn_type.as_fn();
						if (
							fn_t.param_types.len == 2 &&
							fn_t.param_types[1].is_integer() &&
							fn_t.return_type.kind != DataType.NONE
						) {
							found_mi = m;
							is_indexed = true;
							break;
						}
					}
				}
			}

			if (found_mi == null) {
				self.report_error(
					node,
					"Type '${s_info.name}' does not implement operator 'unpack' for ${ds.names.len} elements"
				);
				return;
			}

			val mi = found_mi!;
			self.set_method(node, mi);

			if (is_indexed) {
				val elem_t = mi.fn_type.as_fn().return_type;
				for (i in 0..<ds.names.len) {
					if (ds.names[i] != "_") {
						val sym = Symbol(
							ds.names[i], ds.names[i], SymbolKind.VAR,
							elem_t, ds.mutable, false, node.line, node.col, null
						);
						val ok = self.symtab.define(sym);
						self.ensure(ok, node, "Variable '${ds.names[i]}' is already defined in this scope");
					}
				}
			} else {
				val fn_t = mi.fn_type.as_fn();
				for (i in 0..<ds.names.len) {
					if (ds.names[i] != "_") {
						val param_t = fn_t.param_types[i + 1];
						val var_t = if (param_t.kind == DataType.POINTER) param_t.as_pointer().pointee else param_t;
						val sym = Symbol(
							ds.names[i], ds.names[i], SymbolKind.VAR,
							var_t, ds.mutable, false, node.line, node.col, null
						);
						val ok = self.symtab.define(sym);
						self.ensure(ok, node, "Variable '${ds.names[i]}' is already defined in this scope");
					}
				}
			}
		}
	}

	fn collect_and_conditions(&self, expr: *AstNode): List<*AstNode> {
		var res = List<*AstNode>();
		if (expr == null) return res;
		val cur = self.unwrap_group(expr) ?: return res;

		if (cur is BinaryExpr as bin && bin.op == TokenType.AND_AND) {
			val left = self.collect_and_conditions(bin.left);
			val right = self.collect_and_conditions(bin.right);
			for (l in left) res += l;
			for (r in right) res += r;
			return res;
		}

		res += cur;
		return res;
	}

	fn is_null_literal(*self, node: *AstNode): bool {
		if (node == null) return false;
		val cur = self.unwrap_group(node);
		if (cur is LiteralExpr) return cur.literal_kind == Literal.NULL_VAL;
		return false;
	}

	fn promote_to_non_null(&self, var_name: str) {
		if (var_name.empty()) return;

		val sym = self.symtab.lookup(var_name) ?: return;
		val type_ptr = sym.type_ptr ?: return;
		if (type_ptr.kind != DataType.POINTER) return;
		val ptr_ty = type_ptr.as_pointer();
		if (!ptr_ty.nullable) return;

		val non_null_ty = self.arena.pointer_type(ptr_ty.pointee, ptr_ty.mutable);
		val orig_ty = sym.orig_type ?: sym.type_ptr;
		self.symtab.define(
			Symbol(var_name, sym.c_name, sym.kind, non_null_ty, sym.mutable, sym.public, 0, 0, null, orig_ty)
		);
	}

	fn check_null_guard(&self, left: *AstNode, right: *AstNode) {
		val l = self.unwrap_group(left);
		val r = self.unwrap_group(right);
		var var_name = "";
		if (self.is_null_literal(r) && l is IdentifierExpr as l_id) {
			var_name = l_id.name;
		} else if (self.is_null_literal(l) && r is IdentifierExpr as r_id) {
			var_name = r_id.name;
		}
		if (!var_name.empty()) {
			self.promote_to_non_null(var_name);
		}
	}

	fn promote_expr_receiver(&self, obj: ?*AstNode) {
		if (obj == null) return;
		val un = self.unwrap_group(obj!);
		if (un is IdentifierExpr as id) {
			self.promote_to_non_null(id.name);
		}
	}

	fn extract_safe_receivers(&self, expr: ?*AstNode) {
		if (expr == null) return;
		val cur = self.unwrap_group(expr!);
		if (cur == null) return;

		if (cur is BinaryExpr as bin) {
			val has_null = self.is_null_literal(bin.left) || self.is_null_literal(bin.right);
			if (bin.op == TokenType.BANG_EQUAL) {
				self.extract_safe_receivers(bin.left);
				self.extract_safe_receivers(bin.right);
			} else if (bin.op == TokenType.EQUAL_EQUAL) {
				if (!has_null) {
					self.extract_safe_receivers(bin.left);
					self.extract_safe_receivers(bin.right);
				}
			} else if (bin.op != TokenType.OR_OR) {
				self.extract_safe_receivers(bin.left);
				self.extract_safe_receivers(bin.right);
			}
			return;
		}

		if (cur is CallExpr as call) {
			if (call.callee is MemberExpr as mem) {
				if (mem.is_safe) {
					self.promote_expr_receiver(mem.object);
				}
				self.extract_safe_receivers(mem.object);
			} else {
				self.extract_safe_receivers(call.callee);
			}
			for (arg in call.args) {
				self.extract_safe_receivers(arg);
			}
			return;
		}

		if (cur is MemberExpr as mem) {
			if (mem.is_safe) {
				self.promote_expr_receiver(mem.object);
			}
			self.extract_safe_receivers(mem.object);
			return;
		}
	}

	pub fn check_if_stmt(&self, node: *AstNode) {
		if (node is IfStmt as if_s) {
			val conds = self.collect_and_conditions(if_s.condition);

			self.symtab.enter_scope(false);

			var no_alias_syms = List<str>();
			var no_alias_tys = List<*Type>();
			var no_alias_muts = List<bool>();

			for (c in conds) {
				val prev_sn = self.in_safe_nav_context;
				self.in_safe_nav_context = true;
				val c_ty = self.check_expr(c);
				self.in_safe_nav_context = prev_sn;
				self.ensure(c_ty.kind == DataType.BOOL, c, "If statement condition must be bool");

				val unwrapped_c = self.unwrap_group(c);
				if (unwrapped_c is IsExpr as is_e) {
					val prev_sn = self.in_safe_nav_context;
					self.in_safe_nav_context = true;
					val subj_ty = if (is_e.expr != null) self.check_expr(is_e.expr!) else self.prims().t_none();
					self.in_safe_nav_context = prev_sn;
					val cast_ty = self.check_is_pattern(is_e.expr, subj_ty, unwrapped_c);
					if (cast_ty != null) {
						if (!is_e.alias.empty()) {
							val sym = Symbol(
								is_e.alias, is_e.alias, SymbolKind.VAR,
								cast_ty, false, false, 0, 0
							);
							self.symtab.define(sym);
						} else if (is_e.expr is IdentifierExpr as id) {
							val subj_sym = self.symtab.lookup(id.name);
							val mutable = subj_sym?.mutable ?: false;
							no_alias_syms += id.name;
							no_alias_tys += cast_ty;
							no_alias_muts += mutable;
						}
					}
				}

				if (unwrapped_c is BinaryExpr as bin && bin.op == TokenType.BANG_EQUAL) {
					self.check_null_guard(bin.left, bin.right);
				}

				self.extract_safe_receivers(unwrapped_c);
			}

			for (i in 0..<no_alias_syms.len) {
				self.symtab.define(Symbol(
					no_alias_syms[i], no_alias_syms[i], SymbolKind.VAR,
					no_alias_tys[i], no_alias_muts[i], false, 0, 0
				));
			}

			self.check_statement(if_s.then_branch);
			self.symtab.exit_scope();

			if (if_s.else_branch != null) {
				var else_null_guard = false;
				var else_neg_is = false;
				val single_c = self.unwrap_group(if_s.condition);
				if (single_c is BinaryExpr as eq_bin && eq_bin.op == TokenType.EQUAL_EQUAL) {
					self.symtab.enter_scope(false);
					self.check_null_guard(eq_bin.left, eq_bin.right);
					else_null_guard = true;
				} else if (
					single_c is UnaryExpr as neg_un &&
					neg_un.op == TokenType.BANG &&
					!neg_un.is_postfix
				) {
					val inner_is = self.unwrap_group(neg_un.operand);
					if (inner_is is IsExpr as is_e && is_e.alias.empty() && is_e.expr is IdentifierExpr as id) {
						val prev_sn = self.in_safe_nav_context;
						self.in_safe_nav_context = true;
						val subj_ty = self.check_expr(is_e.expr!);
						self.in_safe_nav_context = prev_sn;
						val cast_ty = self.check_is_pattern(is_e.expr, subj_ty, inner_is);
						if (cast_ty != null) {
							self.symtab.enter_scope(false);
							val subj_sym = self.symtab.lookup(id.name);
							val mutable = subj_sym?.mutable ?: false;
							self.symtab.define(Symbol(
								id.name, id.name, SymbolKind.VAR,
								cast_ty, mutable, false, 0, 0
							));
							else_neg_is = true;
						}
					}
				}

				self.check_statement(if_s.else_branch!);

				if (else_null_guard || else_neg_is) {
					self.symtab.exit_scope();
				}
			}
		}
	}

	pub fn check_while_stmt(&self, node: *AstNode) {
		if (node is WhileStmt as wh) {
			val conds = self.collect_and_conditions(wh.condition);

			self.loop_depth++;
			defer self.loop_depth--;
			self.symtab.enter_scope(false);
			defer self.symtab.exit_scope();

			for (c in conds) {
				val prev_sn = self.in_safe_nav_context;
				self.in_safe_nav_context = true;
				val c_ty = self.check_expr(c);
				self.in_safe_nav_context = prev_sn;
				self.ensure(c_ty.kind == DataType.BOOL, c, "While statement condition must be bool");

				val unwrapped_c = self.unwrap_group(c);
				if (unwrapped_c is BinaryExpr as bin && bin.op == TokenType.BANG_EQUAL) {
					self.check_null_guard(bin.left, bin.right);
				}

				self.extract_safe_receivers(unwrapped_c);
			}

			self.check_statement(wh.body);
		}
	}

	pub fn check_for_stmt(&self, node: *AstNode) {
		if (node is ForStmt as fs) {
			self.ensure(
				fs.is_range || for_is_lvalue(fs.iterable),
				node,
				"The iterated expression of a 'for' must be a variable or a field"
			);

			var use_iter_trait = false;
			if (!fs.is_range) {
				use_iter_trait = self.struct_implements_iterable(self.for_iterable_type(fs.iterable));
			}

			var pending = List<PendingResolve>();
			var lowerer = LoopLowerer(self.arena);
			val block = lowerer.desugar_for(node, fs, use_iter_trait, &pending);
			for ((p_node, target) in pending) self.set_resolved(p_node, target);
			self.set_resolved(node, block);
			self.check_statement(block);
		}
	}

	pub fn check_return_stmt(&self, node: *AstNode) {
		if (self.in_lambda) {
			self.report_error(node, "Cannot use 'return' inside a lambda; use 'yield' to return a value from the lambda");
			if (node is ReturnStmt as r && r.value != null) {
				self.check_expr(r.value!);
			}
			return;
		}
		if (self.defer_depth > 0) {
			self.report_error(node, "Return statement is not allowed inside defer");
		}
		if (node is ReturnStmt as ret) {
			if (ret.value != null) {
				val needs_infer = self.inferring_fn_return && (
					self.current_fn_return_type == null ||
					self.current_fn_return_type.kind == DataType.NONE
				);
				if (needs_infer) {
					val val_ty = self.check_expr(ret.value!);
					if (val_ty.kind == DataType.FN) {
						self.report_error(node, "Function cannot return a lambda/closure");
					}
					self.current_fn_return_type = val_ty;
				} else {
					val val_ty = self.check_expr(ret.value!, self.current_fn_return_type);
					self.ensure(
						self.current_fn_return_type.can_assign(val_ty),
						node,
						"Return value type does not match function return type"
					);
				}
			} else {
				self.ensure(
					self.current_fn_return_type.kind == DataType.NONE,
					node,
					"Non-none function must return a value"
				);
			}
		}
	}

	pub fn check_when_stmt(&self, node: *AstNode) {
		if (node is WhenStmt as ws) {
			if (ws.condition != null && self.expr_has_call(ws.condition)) {
				self.report_error(
					ws.condition!,
					"Function or method call is not allowed in 'when' subject; bind the result to a variable first"
				);
			}
			val cond_ty = if (ws.condition != null) self.check_expr(ws.condition!) else null;

			for (arm in ws.arms) {
				val smart_cast_ty = self.resolve_arm_patterns(arm.patterns, ws.condition, cond_ty);
				val sym = self.arm_smart_cast_sym(arm.patterns, ws.condition);
				val mutable = self.arm_smart_cast_mutable(arm.patterns, ws.condition);

				if (!sym.empty() && smart_cast_ty != null) {
					self.symtab.enter_scope(false);
					val s = Symbol(sym, sym, SymbolKind.VAR, smart_cast_ty, mutable, false, 0, 0);
					self.symtab.define(s);
					self.check_statement(arm.body);
					self.symtab.exit_scope();
				} else {
					self.check_statement(arm.body);
				}
			}
		}
	}

	fn for_iterable_type(&self, node: ?*AstNode): ?*Type {
		if (node == null) return null;
		val target = node!;
		if (target is GroupExpr as g) return self.for_iterable_type(g.expr);
		if (target is UnaryExpr as un) {
			if (un.op == TokenType.AMPERSAND) {
				val inner = self.for_iterable_type(un.operand) ?: return null;
				return self.arena.pointer_type(inner, false);
			}
		}
		if (target is IdentifierExpr as id) {
			val sym = self.symtab.lookup(id.name) ?: return null;
			return sym.type_ptr;
		}
		if (target is MemberExpr as mem) {
			var obj = self.for_iterable_type(mem.object) ?: return null;
			if (obj.kind == DataType.POINTER) obj = obj.as_pointer().pointee;
			if (obj.kind != DataType.STRUCT) return null;
			val s_mem = obj.as_struct();
			for (f in s_mem.fields) {
				if (f.name == mem.member) return f.type_ptr;
			}
			return null;
		}
		return null;
	}

	fn propagate_instance_init(&self, init_node: *AstNode, var_ty: *Type): ?*AstNode {
		if (var_ty == null || var_ty.kind != DataType.STRUCT) return null;
		var cur = init_node;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		if (cur is CallExpr as call) {
			if (!call.type_args.empty()) return null;
			if (call.callee is IdentifierExpr as cid) {
				val tmpl = self.find_struct_template_for(cid.name) ?: return null;
				val prefix = "${tmpl.module.mangle_symbol(tmpl.name)}_";
				val s = var_ty.as_struct();
				if (!s.c_name.starts_with(prefix)) return null;
				val callee = self.arena.node(NodeData.IdentifierExpr(s.c_name), init_node.line, init_node.col);
				return self.arena.node(
					NodeData.CallExpr(callee, call.args, List<*AstNode>()),
					init_node.line, init_node.col
				);
			}
		}
		return null;
	}

	fn struct_implements_iterable(*self, ty: ?*Type): bool {
		var cur = ty;
		if (cur?.kind == DataType.POINTER) cur = cur.as_pointer().pointee;
		if (cur == null || cur.kind != DataType.STRUCT) return false;
		val t = self.symtab.find_trait("Iterable") ?: return false;
		return t.has_impl(cur.as_struct().name);
	}

}
