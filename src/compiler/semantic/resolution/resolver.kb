mod compiler.semantic.resolution;

use std.string.*;
use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.TokenType;
use compiler.ast.*;
use compiler.ast.PointerType;
use compiler.ast.ArrayType;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

/*
 * ============================================================================
 * compiler.semantic.resolution.resolver — Standalone AST Type Resolver
 *
 * Resolves AST type annotation nodes into canonical `*Type` instances,
 * managing type parameter substitution, `Self` and `Self.Item` bindings,
 * primitive types, and generic struct instantiation.
 * ============================================================================
 */

pub struct TypeResolver {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_module: str = "",
	pub errors: List<Diagnostic> = List(),
	pub is_extern: bool = false,
	pub current_self_type: *Type? = null,
	pub subst: TypeSubst = TypeSubst(),
	pub current_fn_return_type: *AstNode? = null,
	pub mat_rec: *InstanceRecord? = null
}

impl TypeResolver {

	pub fn prims(*self) => self.symtab.prims;

	pub fn enter_module(&self, module: str): str {
		val prev = self.current_module;
		if (module.len > 0) {
			self.current_module = module;
			self.symtab.set_current_module(module);
		}
		return prev;
	}

	pub fn leave_module(&self, prev: str) {
		self.current_module = prev;
		self.symtab.set_current_module(prev);
	}

	pub fn c_name_for(*self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return self.current_module.mangle_symbol(name);
	}

	pub fn report_error(&self, node: *AstNode, msg: str) {
		self.errors += Diagnostic.error(node.span, self.current_module, msg);
	}

	pub fn resolve_ast_type(&self, node: *AstNode): *Type {
		if (node == null) return self.prims().t_none();

		return when (node) {
			is NamedType as var named -> {
				val name = named.name;

				val subst_res = self.subst.lookup(name);
				if (subst_res != null) yield subst_res;

				if (name == "Self" && self.current_self_type != null) {
					if (self.subst.empty()) {
						val sinfo = self.current_self_type.as_struct();
						if (!sinfo.c_name.empty()) named.name = sinfo.c_name;
						else named.name = sinfo.name;
					}
					yield self.current_self_type;
				}

				if (name.starts_with("Self.")) {
					val assoc = name.slice(5, name.len);
					if (self.current_self_type == null || self.current_self_type.kind != DataType.STRUCT) {
						self.report_error(node, "Associated type '${name}' used outside of an impl");
						yield self.prims().t_none();
					}
					val self_name = self.current_self_type.as_struct().name;
					val bound = self.symtab.find_assoc_type(self_name, assoc);
					if (bound == null) {
						self.report_error(node, "Trait associated type '${assoc}' is not bound for '${self_name}'");
						yield self.prims().t_none();
					}
					if (bound.kind == DataType.POINTER || bound.kind == DataType.ARRAY) {
						self.report_error(node, "Associated type '${assoc}' must be a named type (struct, enum or primitive)");
						yield self.prims().t_none();
					}
					if (self.subst.empty()) named.name = self.ast_type_name_of(bound!);
					yield bound;
				}

				val prim = resolve_primitive_name(self.symtab.prims!, name);
				if (prim != null) yield prim;

				if (named.type_args.len > 0) {
					val tmpl = self.find_struct_template(name);
					if (tmpl != null) {
						val cty = self.instantiate_struct(tmpl, named.type_args);
						if (self.subst.empty()) {
							named.name = cty.as_struct().name;
							named.type_args = List<*AstNode>();
						}
						yield cty;
					}
				}

				val sym = self.symtab.lookup(name);
				if (sym != null) {
					if (sym.c_name != name) named.name = sym.c_name;
					yield sym.type_ptr;
				}

				self.report_error(node, "Unknown type '${name}'");
				yield self.prims().t_none();
			}

			is PointerType as ptr_ast -> {
				val pointee = self.resolve_ast_type(ptr_ast.pointee);
				if (pointee.kind == DataType.FN) {
					self.report_error(node, "Pointer to a lambda/closure type is not allowed");
				}
				yield self.arena.pointer_type(pointee, ptr_ast.mutable);
			}

			is ArrayType as arr_ast -> {
				val elem = self.resolve_ast_type(arr_ast.element_type);
				if (elem.kind == DataType.FN) {
					self.report_error(node, "Array of lambda/closure types is not allowed");
				}
				yield self.arena.array_type(elem, arr_ast.size);
			}

			is FnType as fn_ast -> {
				var p_types = List<*Type>();
				for (pt in fn_ast.param_types) {
					val resolved_pt = self.resolve_ast_type(pt);
					if (resolved_pt.kind == DataType.FN) {
						self.report_error(pt, "Nested lambda/closure parameter types are not allowed");
					}
					p_types += resolved_pt;
				}
				val ret_ty = self.resolve_ast_type(fn_ast.return_type);
				if (ret_ty.kind == DataType.FN) {
					self.report_error(fn_ast.return_type, "Lambda/closure type cannot return another lambda/closure type");
				}
				yield self.arena.fn_type(p_types, ret_ty);
			}

			is NullableType as null_ast -> {
				val inner_ty = self.resolve_ast_type(null_ast.inner_type);
				var res_ty = inner_ty;
				if (inner_ty.kind == DataType.POINTER) {
					val pt = inner_ty.as_pointer();
					res_ty = self.arena.nullable_pointer_type(pt.pointee, pt.mutable);
				} else {
					self.report_error(node, "Nullable modifier '?' is only supported on pointer types");
				}
				yield res_ty;
			}

			else -> self.prims().t_none();
		};
	}

	fn ast_type_name_of(*self, ty: *Type): str {
		if (ty.kind == DataType.STRUCT) {
			val s_info = ty.as_struct();
			if (!s_info.c_name.empty()) return s_info.c_name;
			return s_info.name;
		}

		if (ty.is_enum()) return ty.as_enum().c_name;

		return primitive_type_name(ty);
	}

}
