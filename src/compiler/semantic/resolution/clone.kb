mod compiler.semantic.resolution;

use std.memory.*;
use std.collections.*;

use compiler.lexer.TokenType;
use compiler.ast.*;
use compiler.ast.PointerType;
use compiler.ast.ArrayType;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

/*
 * ============================================================================
 * compiler.semantic.resolution.clone — AST Cloning and Body Materialization
 *
 * Implements AST deep copying with type substitution:
 *   - Materializes private AST bodies for specialized function/method instances,
 *     stamping per-node annotations recorded in `InstanceRecord.ann_map`.
 *   - Clones trait default methods when synthesizing missing implementations.
 * ============================================================================
 */

impl TypeResolver {

	fn mat_ann(*self, node: ?*AstNode): ?*AnnotationEntry {
		if (node == null || self.mat_rec == null) return null;
		return self.mat_rec.find_ann(node!);
	}

	pub fn clone_type(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		val e = self.mat_ann(node);
		if (e?.ty != null) return self.arena.ast_type_from_type(e.ty!);

		val target = node;
		return when (target) {
			is NamedType as nt -> {
				val sa = subst?.lookup(nt.name);
				if (sa != null) yield self.clone_type(sa, null);

				if (nt.type_args.len > 0) {
					val args = self.clone_type_args(nt.type_args, subst);
					val has_unsubstituted = args.any { ca ->
						if (ca is NamedType as t_nt) {
							yield resolve_primitive_name(self.symtab.prims!, t_nt.name) == null
								&& self.symtab.lookup(t_nt.name) == null
								&& self.find_struct_template(t_nt.name) == null;
						}
						yield false;
					};
					val tmpl = if (!has_unsubstituted) self.find_struct_template(nt.name) else null;
					if (tmpl != null) {
						val cty = self.instantiate_struct(tmpl, args);

						yield self.arena.node(
							NodeData.NamedType(cty.as_struct()!.name, List<*AstNode>()),
							node.line, node.col
						);
					}
				}

				val targs = self.clone_type_args(nt.type_args, subst);
				yield self.arena.node(NodeData.NamedType(nt.name, targs), node.line, node.col);
			}

			is PointerType as pt -> self.arena.node(
				NodeData.PointerType(pt.mutable, pt.nullable, self.clone_type(pt.pointee, subst)),
				node.line, node.col
			);

			is ArrayType as at -> self.arena.node(
				NodeData.ArrayType(self.clone_type(at.element_type, subst), at.size),
				node.line, node.col
			);

			is ArrayLiteralExpr as al -> self.arena.node(
				NodeData.ArrayLiteralExpr(self.clone_type_args(al.elements, subst)),
				node.line, node.col
			);

			is VariadicType as vt -> self.arena.node(
				NodeData.VariadicType(self.clone_type(vt.element_type, subst)),
				node.line, node.col
			);

			is FnType as ft -> self.arena.node(
				NodeData.FnType(
					self.clone_type_args(ft.param_types, subst),
					self.clone_type(ft.return_type, subst)
				),
				node.line, node.col
			);

			else -> self.arena.node(
				NodeData.NamedType("none", List<*AstNode>()),
				node.line, node.col
			);
		};
	}

	pub fn clone_expr(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		val raw_node = node;
		if (raw_node is [ReturnStmt, BreakStmt, ContinueStmt, YieldStmt, BlockStmt]) {
			return self.clone_stmt(node, subst);
		}

		val e = self.mat_ann(node);
		if (e?.resolved != null) {
			val r = self.clone_expr(e.resolved!, subst);
			if (e.ty != null) self.symtab.set_node_type(r, e.ty);
			if (e.has_is_info) self.symtab.set_is_pattern(r, e.is_info);
			if (e.is_predicate) self.symtab.set_predicate_pattern(r);
			return r;
		}

		val target = node;
		var out = when (target) {
			is LiteralExpr as l -> self.arena.node(
				NodeData.LiteralExpr(l.literal_kind, l.raw_text),
				node.line, node.col
			);

			is IdentifierExpr as id -> self.arena.node(
				NodeData.IdentifierExpr(if (e?.has_ident_name) e.ident_name else id.name),
				node.line, node.col
			);

			is BinaryExpr as b -> self.arena.node(
				NodeData.BinaryExpr(self.clone_expr(b.left, subst), b.op, self.clone_expr(b.right, subst)),
				node.line, node.col
			);

			is UnaryExpr as u -> self.arena.node(
				NodeData.UnaryExpr(u.op, self.clone_expr(u.operand, subst), u.is_postfix),
				node.line, node.col
			);

			is CallExpr -> self.clone_call_expr(node, subst);

			is MemberExpr as m -> {
				val obj_src = e?.obj_replace ?: m.object;
				val cloned_obj = self.clone_expr(obj_src, subst);
				yield self.arena.node(
					NodeData.MemberExpr(cloned_obj, m.member, m.is_safe),
					node.line, node.col
				);
			}

			is IndexExpr as ix -> self.arena.node(
				NodeData.IndexExpr(self.clone_expr(ix.target, subst), self.clone_expr(ix.index, subst)),
				node.line, node.col
			);

			is AssignExpr as a -> self.arena.node(
				NodeData.AssignExpr(self.clone_expr(a.target, subst), a.op, self.clone_expr(a.value, subst)),
				node.line, node.col
			);

			is UpdateExpr as u -> self.arena.node(
				NodeData.UpdateExpr(u.op, self.clone_expr(u.target, subst)),
				node.line, node.col
			);

			is CastExpr as cst -> self.arena.node(
				NodeData.CastExpr(
					if (cst.expr != null) self.clone_expr(cst.expr!, subst) else null,
					self.clone_type(cst.target_type, subst)
				),
				node.line, node.col
			);

			is GroupExpr as g -> self.arena.node(
				NodeData.GroupExpr(self.clone_expr(g.expr, subst)),
				node.line, node.col
			);

			is IfExpr as ie -> self.arena.node(
				NodeData.IfExpr(
					self.clone_expr(ie.condition, subst),
					self.clone_expr(ie.then_branch, subst),
					self.clone_expr(ie.else_branch, subst)
				),
				node.line, node.col
			);

			is ArrayLiteralExpr as al -> self.arena.node(
				NodeData.ArrayLiteralExpr(self.clone_expr_list(al.elements, subst)),
				node.line, node.col
			);

			is WhenExpr as we -> self.arena.node(
				NodeData.WhenExpr(
					if (we.condition != null) self.clone_expr(we.condition!, subst) else null,
					self.clone_when_arms(node, subst)
				),
				node.line, node.col
			);

			is InterpExpr -> self.arena.node(
				NodeData.InterpExpr(self.clone_interp_parts(node, subst)),
				node.line, node.col
			);

			is IsExpr as is_e -> {
				val expr_clone = if (is_e.expr != null) self.clone_expr(is_e.expr!, subst) else null;
				val res_is = self.arena.node(
					NodeData.IsExpr(expr_clone, self.clone_type(is_e.target_type, subst), is_e.alias, is_e.mutable),
					node.line, node.col
				);

				if (!is_e.alias.empty() && res_is is IsExpr as res_e) {
					res_e.alias = is_e.alias;
					res_e.mutable = is_e.mutable;
				}

				yield res_is;
			}

			is StructCtorExpr as sc -> self.arena.node(
				NodeData.StructCtorExpr(sc.c_name, self.clone_expr_list(sc.args, subst)),
				node.line, node.col
			);

			is EnumCtorExpr as ec -> self.arena.node(
				NodeData.EnumCtorExpr(
					ec.c_name, ec.tag_field, ec.tag_value, ec.payload_path,
					self.clone_expr_list(ec.args, subst)
				),
				node.line, node.col
			);

			is SizeOfParam as sop -> self.arena.node(
				NodeData.SizeOfParam(sop.param_index, sop.size_text),
				node.line, node.col
			);

			is LambdaExpr as lam -> {
				val c_params = lam.params.map { p ->
					val pt = if (p.type_node != null) self.clone_type(p.type_node!, subst) else null;
					yield Param(p.name, pt, p.mutable, p.has_val, null);
				};
				val c_body = if (lam.body is BlockStmt)
					self.clone_stmt(lam.body, subst)
				else
					self.clone_expr(lam.body, subst);
				yield self.arena.node(
					NodeData.LambdaExpr(c_params, c_body, lam.is_trailing, lam.had_empty_parens),
					node.line, node.col
				);
			}

			else -> self.arena.node(
				NodeData.IdentifierExpr("<unsupported-expr>"),
				node.line, node.col
			);
		};

		if (e != null) {
			if (e.ty != null) self.symtab.set_node_type(out, e.ty);
			if (e.method != null) self.symtab.set_resolved_method(out, e.method);
			if (e.has_is_info) self.symtab.set_is_pattern(out, e.is_info);
			if (e.is_predicate) self.symtab.set_predicate_pattern(out);
			if (e.has_lambda_info) {
				var linfo = e.lambda_info;
				linfo.id = self.symtab.alloc_lambda_id();
				self.symtab.set_lambda_info(out, linfo);
			}
			if (e.is_closure_call) self.symtab.set_closure_call(out);
		} else {
			if (self.symtab.has_is_pattern(node)) {
				self.symtab.set_is_pattern(out, self.symtab.get_is_pattern(node));
			}
			if (self.symtab.is_predicate_pattern(node)) {
				self.symtab.set_predicate_pattern(out);
			}
			if (self.symtab.has_lambda_info(node)) {
				var linfo = self.symtab.get_lambda_info(node);
				linfo.id = self.symtab.alloc_lambda_id();
				self.symtab.set_lambda_info(out, linfo);
			}
			if (self.symtab.is_closure_call(node)) {
				self.symtab.set_closure_call(out);
			}
		}
		return out;
	}

	fn clone_call_expr(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		val special = self.clone_size_query(node, subst) ?: self.clone_template_call(node, subst);
		if (special != null) return special;

		if (node is CallExpr as c) {
			val args = self.clone_expr_list(c.args, subst);
			return self.arena.node(
				NodeData.CallExpr(self.clone_expr(c.callee, subst), args, List<*AstNode>()),
				node.line, node.col
			);
		}
		return node;
	}

	fn clone_size_query(&self, node: *AstNode, subst: ?*GenericSubst = null): ?*AstNode {
		if (node is CallExpr as c) {
			if (c.callee is MemberExpr as m) {
				if (m.member == "size" && m.object is IdentifierExpr as obj_id) {
					val sa = subst?.lookup(obj_id.name) ?: return null;
					return self.arena.node(
						NodeData.LiteralExpr(Literal.INTEGER, "${self.ast_type_size(sa)}"),
						node.line, node.col
					);
				}
			}
		}
		return null;
	}

	fn clone_template_call(&self, node: *AstNode, subst: ?*GenericSubst = null): ?*AstNode {
		if (node is CallExpr as c) {
			if (c.type_args.empty()) return null;

			val callee = c.callee;
			if (callee is MemberExpr as mem) {
				var ft: ?*GenericTemplate = null;
				if (mem.object is IdentifierExpr as id) ft = self.find_method_template(mem.member, id.name);
				if (ft == null) ft = self.find_method_template(mem.member);
				if (ft == null) return null;

				var is_static = false;
				if (ft.node is FnDecl as f) is_static = f.params.empty() || f.params[0].name != "self";

				val callee_ann = self.mat_ann(callee);
				val obj_src = callee_ann?.obj_replace ?: mem.object;
				val mem_obj = self.clone_expr(obj_src, subst);
				val targs = self.clone_type_args(c.type_args, subst);
				var new_args = List<*AstNode>();
				if (!is_static) new_args += mem_obj;
				for (a in c.args) new_args += self.clone_expr(a, subst);

				val cname = self.instantiate_fn(ft!, targs);
				val callee = self.arena.node(
					NodeData.IdentifierExpr(cname),
					node.line, node.col
				);

				val call_node = self.arena.node(
					NodeData.CallExpr(callee, new_args, List<*AstNode>()),
					node.line, node.col
				);

				if (!is_static && mem.is_safe) {
					val null_lit = self.arena.node(
						NodeData.LiteralExpr(Literal.NULL_VAL, "null"),
						node.line, node.col
					);
					val cond = self.arena.node(
						NodeData.BinaryExpr(mem_obj, TokenType.BANG_EQUAL, null_lit),
						node.line, node.col
					);

					val else_null = self.arena.node(
						NodeData.LiteralExpr(Literal.NULL_VAL, "null"),
						node.line, node.col
					);

					return self.arena.node(
						NodeData.IfExpr(cond, call_node, else_null),
						node.line, node.col
					);
				}

				return call_node;
			}

			if (callee is IdentifierExpr as cid) {
				val ft = self.find_fn_template(cid.name);
				if (ft != null) {
					val targs = self.clone_type_args(c.type_args, subst);
					val cname = self.instantiate_fn(ft, targs);
					var cargs = List<*AstNode>();
					for (a in c.args) cargs += self.clone_expr(a, subst);
					val callee = self.arena.node(NodeData.IdentifierExpr(cname), node.line, node.col);
					return self.arena.node(
						NodeData.CallExpr(callee, cargs, List<*AstNode>()),
						node.line, node.col
					);
				}

				val st = self.find_struct_template(cid.name);
				if (st != null) {
					val targs = self.clone_type_args(c.type_args, subst);
					val has_unsubstituted = targs.any { ca ->
						if (ca is NamedType as t_nt) {
							yield resolve_primitive_name(self.symtab.prims!, t_nt.name) == null
								&& self.symtab.lookup(t_nt.name) == null
								&& self.find_struct_template(t_nt.name) == null;
						}
						yield false;
					};
					if (!has_unsubstituted) {
						val cty = self.instantiate_struct(st, targs);
						val cargs = self.clone_expr_list(c.args, subst);

						val callee = self.arena.node(
							NodeData.IdentifierExpr(cty.as_struct()!.name),
							node.line, node.col
						);

						return self.arena.node(
							NodeData.CallExpr(callee, cargs, List<*AstNode>()),
							node.line, node.col
						);
					}
					val cargs = self.clone_expr_list(c.args, subst);
					val callee = self.arena.node(NodeData.IdentifierExpr(cid.name), node.line, node.col);
					return self.arena.node(
						NodeData.CallExpr(callee, cargs, targs),
						node.line, node.col
					);
				}
			}
		}

		return null;
	}

	fn clone_expr_list(&self, nodes: List<*AstNode>, subst: ?*GenericSubst = null): List<*AstNode> =>
		nodes.map { n -> self.clone_expr(n, subst) };

	fn clone_type_args(&self, nodes: List<*AstNode>, subst: ?*GenericSubst = null): List<*AstNode> =>
		nodes.map { n -> self.clone_type(n, subst) };

	fn clone_when_arms(&self, node: *AstNode, subst: ?*GenericSubst = null): List<WhenArm> {
		var arms = List<WhenArm>();
		if (node is WhenExpr as we) {
			for (arm in we.arms) {
				val pats = self.clone_expr_list(arm.patterns, subst);
				val arm_body = if (arm.body is BlockStmt)
					self.clone_stmt(arm.body, subst)
				else
					self.clone_expr(arm.body, subst);

				arms += WhenArm(pats, arm.is_else, arm_body, arm.line, arm.col);
			}
		}

		return arms;
	}

	fn clone_interp_parts(&self, node: *AstNode, subst: ?*GenericSubst = null): List<InterpPart> {
		var parts = List<InterpPart>();
		if (node is InterpExpr as ie) {
			for (part in ie.parts) {
				when (part) {
					is InterpPart.Literal -> parts += InterpPart.Literal(self.clone_expr(part.node, subst));
					is InterpPart.Hole -> parts += InterpPart.Hole(self.clone_expr(part.node, subst));
				}
			}
		}

		return parts;
	}

	pub fn clone_stmt(&self, node: *AstNode, subst: ?*GenericSubst = null): *AstNode {
		val se = self.mat_ann(node);
		if (se?.resolved != null) return self.clone_stmt(se.resolved!, subst);

		val target = node;
		return when (target) {
			is BlockStmt as b -> self.arena.node(
				NodeData.BlockStmt(b.statements.map { s -> self.clone_stmt(s, subst) }),
				node.line, node.col
			);

			is ExprStmt as e -> self.arena.node(
				NodeData.ExprStmt(self.clone_expr(e.expr, subst)),
				node.line, node.col
			);

			is VarDeclStmt as v -> {
				var ta = if (v.type_annotation != null) self.clone_type(v.type_annotation!, subst) else null;
				if (se?.var_ty != null && ta == null) ta = self.arena.ast_type_from_type(se.var_ty!);

				var init_src = v.initializer;
				if (se?.init_override != null) init_src = se.init_override;

				val init_expr = if (init_src != null) self.clone_expr(init_src!, subst) else null;
				if (ta != null && init_expr != null) self.propagate_target_type(ta, init_expr);

				yield self.arena.node(
					NodeData.VarDeclStmt(v.mutable, v.name, ta, init_expr),
					node.line, node.col
				);
			}

			is DestructDeclStmt as d -> self.arena.node(
				NodeData.DestructDeclStmt(
					d.mutable, d.names.clone(),
					self.clone_expr(d.initializer, subst)
				),
				node.line, node.col
			);

			is IfStmt as s -> self.arena.node(
				NodeData.IfStmt(
					self.clone_expr(s.condition, subst),
					self.clone_stmt(s.then_branch, subst),
					if (s.else_branch != null) self.clone_stmt(s.else_branch!, subst) else null
				),
				node.line, node.col
			);

			is WhileStmt as w -> self.arena.node(
				NodeData.WhileStmt(
					self.clone_expr(w.condition, subst),
					self.clone_stmt(w.body, subst)
				),
				node.line, node.col
			);

			is ForStmt as f -> self.arena.node(
				NodeData.ForStmt(
					f.var_name, f.is_range, f.is_open, f.is_half_open,
					if (f.iterable != null) self.clone_expr(f.iterable!, subst) else null,
					if (f.range_start != null) self.clone_expr(f.range_start!, subst) else null,
					if (f.range_end != null) self.clone_expr(f.range_end!, subst) else null,
					self.clone_stmt(f.body, subst)
				),
				node.line, node.col
			);

			is ReturnStmt as r -> self.arena.node(
				NodeData.ReturnStmt(if (r.value != null) self.clone_expr(r.value!, subst) else null),
				node.line, node.col
			);

			is YieldStmt as y -> self.arena.node(
				NodeData.YieldStmt(if (y.value != null) self.clone_expr(y.value!, subst) else null),
				node.line, node.col
			);

			is BreakStmt -> self.arena.node(NodeData.BreakStmt, node.line, node.col);

			is ContinueStmt -> self.arena.node(NodeData.ContinueStmt, node.line, node.col);

			is WhenStmt as w -> {
				val arms = w.arms.map { arm ->
					WhenArm(
						self.clone_expr_list(arm.patterns, subst),
						arm.is_else,
						self.clone_stmt(arm.body, subst),
						arm.line, arm.col
					)
				};

				yield self.arena.node(
					NodeData.WhenStmt(if (w.condition != null) self.clone_expr(w.condition!, subst) else null, arms),
					node.line, node.col
				);
			}

			is DeferStmt as d -> self.arena.node(
				NodeData.DeferStmt(self.clone_stmt(d.body, subst)),
				node.line, node.col
			);

			else -> self.arena.node(NodeData.ExprStmt(self.clone_expr(target, subst)), node.line, node.col);
		};
	}

	pub fn clone_fn(&self, node: *AstNode, subst: ?*GenericSubst = null, new_name: str = ""): *AstNode {
		if (node is FnDecl as f) {
			val params = f.params.map { p ->
				val pt = if (p.type_node != null) self.clone_type(p.type_node!, subst) else null;
				val dflt = if (p.default_val != null) self.clone_expr(p.default_val!, subst) else null;
				yield Param(p.name, pt, p.mutable, p.has_val, dflt);
			};
			val rt = if (f.return_type != null) self.clone_type(f.return_type!, subst) else null;
			return self.arena.node(
				NodeData.FnDecl(
					new_name,
					List<GenericParam>(),
					params, rt,
					if (f.body != null) self.clone_stmt(f.body!, subst) else null,
					f.public, f.operator, f.initializer, self.current_module
				),
				node.line, node.col
			);
		}
		return node;
	}

	pub fn materialize_body(&self, rec: *InstanceRecord): *AstNode {
		val saved = self.mat_rec;
		self.mat_rec = rec;
		var body: ?*AstNode = null;
		if (rec.decl is FnDecl as f && f.body != null) {
			body = self.clone_stmt(f.body!, null);
		}
		self.mat_rec = saved;
		return body ?: self.arena.node(NodeData.BlockStmt(List<*AstNode>()), 0, 0);
	}

}
