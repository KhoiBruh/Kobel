mod compiler.semantic.resolution;

use std.memory.*;
use std.collections.*;
use std.traits.*;

use compiler.lexer.TokenType;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

/*
 * ============================================================================
 * compiler.semantic.resolution.registry — Generic Template Registry & Worklist
 *
 * Coordinates generic template registration across struct, function, and impl
 * blocks, visible template lookup, trait bounds checking, and worklist draining.
 * ============================================================================
 */

fn template_matches(kind: TemplateKind, t: *GenericTemplate, name: str) => when (kind) {
	TemplateKind.FN -> !t.is_method && t.name == name;
	TemplateKind.METHOD -> t.is_method && t.name == name;
	else -> t.name == name;
};

impl TypeResolver {

	pub fn register_template(var self, node: *AstNode) {
		val cur = node;
		when (cur) {
			is StructDecl as s -> {
				if (s.type_params.len > 0) self.symtab.gen.struct_templates += self.generic_template(s.name, node, false);
			}
			is FnDecl as f -> {
				if (f.type_params.len > 0) {
					self.validate_fn_lambda_rules(node, f);
					self.symtab.gen.fn_templates += self.generic_template(f.name, node, false);
				}
			}
			is ImplDecl as im -> {
				if (im.type_params.len > 0) {
					for (m in im.methods) {
						if (m is FnDecl as mf) self.validate_fn_lambda_rules(m, mf);
					}
					self.symtab.gen.impl_templates += self.generic_template(im.struct_name, node, true);
				} else {
					self.collect_generic_impl_methods(im);
				}
			}
		}
	}

	pub fn validate_fn_lambda_rules(var self, node: *AstNode, f: *FnDecl) {
		if (f.return_type != null && f.return_type is FnType) {
			self.report_error(f.return_type!, "Function cannot return a lambda/closure type");
		}
		var fn_param_count = 0;
		for (i in 0..<f.params.len) {
			val p = f.params[i];
			if (p.type_node != null && p.type_node is FnType) {
				fn_param_count++;
				if (p.mutable) {
					self.report_error(node, "Lambda parameter '${p.name}' cannot be declared 'var'");
				}
				if (p.default_val != null) {
					self.report_error(node, "Lambda parameter '${p.name}' cannot have a default value");
				}
				if (fn_param_count > 1) {
					self.report_error(p.type_node!, "Function can have at most one lambda parameter");
				} else if (i != f.params.len - 1) {
					self.report_error(p.type_node!, "Lambda parameter must be the last parameter of '${f.name}'");
				}
			}
		}
	}

	fn collect_generic_impl_methods(var self, im: *ImplDecl) {
		for (m in im.methods) {
			if (m is FnDecl as var f) {
				if (f.type_params.len == 0) continue;
				self.validate_fn_lambda_rules(m, f);
				self.normalize_generic_self_param(f, im.struct_name, m.line, m.col);
				self.symtab.gen.fn_templates += self.generic_template(f.name, m, true, im.struct_name);
			}
		}
	}

	fn normalize_generic_self_param(var self, var f: *FnDecl, struct_name: str, line: i32, col: i32) {
		for (i in 0..<f.params.len) {
			val p = f.params[i];
			if (p.name != "self" || p.type_node != null) continue;

			val prim = resolve_primitive_name(self.symtab.prims!, struct_name);
			val named = self.arena.node(NodeData.NamedType(struct_name, List<*AstNode>()), line, col);
			val self_ty_node = if (prim != null) named
				else self.arena.node(NodeData.PointerType(p.mutable, named), line, col);
			f.params[i] = Param(p.name, self_ty_node, p.mutable, p.has_val, p.default_val);
		}
	}

	pub fn generic_template(
		var self, name: str, node: *AstNode,
		is_method: bool, self_type: str = ""
	): *GenericTemplate => self.arena.create_val(
		GenericTemplate(name, self.current_module, node, is_method, self_type)
	);

	pub fn template_in_module(val self, module: str, name: str): bool {
		for (t in self.symtab.gen.struct_templates) {
			if (t.name == name && t.module == module) return true;
		}
		for (f in self.symtab.gen.fn_templates) {
			if (f.name == name && f.module == module) return true;
		}
		return false;
	}

	pub fn find_instance_symbol(val self, name: str) => self.symtab.gen.find_instance_symbol(name);

	fn templates_of(val self, kind: TemplateKind) =>
		if (kind == TemplateKind.STRUCT) self.symtab.gen.struct_templates
		else self.symtab.gen.fn_templates;

	fn template_fits(val self, kind: TemplateKind, t: *GenericTemplate, name: str, self_type: str): bool {
		if (!template_matches(kind, t, name)) return false;
		if (self_type.empty()) return true;
		return t.self_type == self_type;
	}

	fn find_template(val self, kind: TemplateKind, name: str, self_type: str = ""): *GenericTemplate? {
		val list = self.templates_of(kind);
		for (t in list) if (
			self.template_fits(kind, t, name, self_type)
			&& t.module == self.current_module
		) return t;

		val b = self.symtab.explicit_imports["${self.current_module}::${name}"];
		if (b != null) for (t in list) if (
			self.template_fits(kind, t, b.symbol_name, self_type)
			&& t.module == b.module_name
		) return t;

		for (i in 0..<self.symtab.wildcard_owners.len) {
			if (self.symtab.wildcard_owners[i] == self.current_module) {
				val wmod = self.symtab.wildcard_modules[i];
				for (t in list) if (
					self.template_fits(kind, t, name, self_type)
					&& t.module == wmod
				) return t;
			}
		}

		for (t in list) if (self.template_fits(kind, t, name, self_type)) return t;

		return null;
	}

	pub fn find_fn_template(val self, name: str) => self.find_template(TemplateKind.FN, name);

	pub fn find_method_template(val self, name: str, self_type: str = "") => self.find_template(TemplateKind.METHOD, name, self_type);

	pub fn find_struct_template(val self, name: str) => self.find_template(TemplateKind.STRUCT, name);

	pub fn type_token(val self, ty: *Type): str => when (ty.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> "ptr_${self.type_token(ty.as_pointer().pointee)}";
		DataType.ARRAY -> {
			val at = ty.as_array();
			yield "arr${at.length}_${self.type_token(at.elem)}";
		}
		DataType.STRUCT -> ty.as_struct().name;
		else -> "x";
	};

	pub fn ast_type_size(var self, node: *AstNode): usz {
		if (node == null) return 8;
		return when (node) {
			is PointerType -> 8;

			is ArrayType -> node.size * self.ast_type_size(node.element_type);

			is NamedType -> {
				val name = node.name;
				yield when (name) {
					"i8", "u8", "bool", "char" -> 1;
					"i16", "u16" -> 2;
					"i32", "u32", "f32" -> 4;
					"i64", "u64", "isz", "usz", "f64" -> 8;
					"str" -> 16;
					else -> 8;
				};

				val sym = self.symtab.lookup(name);
				if (sym != null) yield sym.type_ptr.size;

				yield 8;
			}

			else -> 8;
		};
	}

	pub fn check_bounds(var self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>) {
		val params = tmpl.params();
		for (i in 0..<params.len) {
			val gp = params[i];
			if (gp.bounds.empty() || i >= arg_asts.len) continue;

			val arg = arg_asts[i];
			val ty = self.resolve_ast_type(arg);
			if (ty == null || ty.kind == DataType.NONE) continue;
			if (ty.kind == DataType.FN) {
				self.report_error(arg, "Lambda/closure type cannot be used as a generic type argument");
				continue;
			}

			var cur_ty = ty;
			if (cur_ty.kind == DataType.POINTER) cur_ty = cur_ty.as_pointer().pointee;

			var aname = "";
			if (cur_ty.kind == DataType.STRUCT) {
				aname = cur_ty.as_struct().name;
			} else {
				val prim = primitive_type_name(cur_ty);
				if (prim != "none") aname = prim;
				else aname = cur_ty.to_str();
			}

			for (b in gp.bounds) {
				val bt = self.symtab.find_trait(b);
				if (bt == null) {
					self.report_error(arg, "Unknown trait bound '${b}'");
					continue;
				}
				if (!bt.has_impl(aname)) {
					self.report_error(arg, "Type '${aname}' does not implement trait '${b}'");
				}
			}
		}
	}

	pub fn alloc_subst(
		var self,
		names: List<str>,
		args: List<*AstNode>
	) => self.arena.create_val(GenericSubst(names, args));

	pub fn queue_decl(var self, module: str, node: *AstNode) {
		val marker = self.arena.node(
			NodeData.ModuleDecl(module.split('.'), module),
			node.line, node.col
		);

		self.symtab.gen.instances += marker;
		self.symtab.gen.instances += node;
	}

	pub fn drain_instances(var self) {
		var i = 0;
		while (i + 1 < self.symtab.gen.instances.len) {
			val marker = self.symtab.gen.instances[i];
			val decl = self.symtab.gen.instances[i + 1];
			i += 2;

			if (marker is ModuleDecl as m) {
				self.current_module = m.full_path;
				self.symtab.set_current_module(m.full_path);
			}

			if (decl is FnDecl || decl is ImplDecl) continue;

			self.rewrite_generics(decl);
		}
	}

}
