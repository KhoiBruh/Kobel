mod compiler.semantic.symbols;

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.semantic.types.*;

/*
 * ============================================================================
 * compiler.semantic.symbols.table — Global Symbol Table
 *
 * Coordinates scoped symbol lookups, module registrations, imports, enum and
 * trait catalogues, canonical primitive methods, and semantic side-tables.
 * ============================================================================
 */

pub struct SymbolTable {
	pub current_scope: *Scope,
	pub arena: Arena,
	pub current_module: str = "",
	pub modules: List<*ModuleScope> = List(),
	pub module_map: HashMap<str, *ModuleScope> = HashMap(),
	pub imports: List<ImportBinding> = List(),
	pub enums: List<*EnumInfo> = List(),
	pub enum_map: HashMap<str, *EnumInfo> = HashMap(),
	pub traits: List<*TraitInfo> = List(),
	pub trait_map: HashMap<str, *TraitInfo> = HashMap(),
	pub c_name_map: HashMap<str, *Symbol> = HashMap(),
	pub struct_const_map: HashMap<str, *Symbol> = HashMap(),
	pub explicit_imports: HashMap<str, ImportBinding> = HashMap(),
	pub wildcard_owners: List<str> = List(),
	pub wildcard_modules: List<str> = List(),
	pub assoc_types: HashMap<str, *Type> = HashMap(),
	pub gen: GenericRegistry = GenericRegistry(),
	pub prims: *PrimTypes? = null,
	pub sem: *SemanticTable? = null
}

impl SymbolTable {

	pub init() {
		var arena = Arena();
		val root_scope = arena.create_val(Scope());
		var st = Self(root_scope, arena);
		st.prims = arena.create_val(PrimTypes(&arena));
		st.sem = arena.create_val(SemanticTable());
		return st;
	}

	pub fn set_node_type(*self, node: *AstNode?, ty: *Type?) {
		if (node == null || ty == null || self.sem == null) return;
		var s = self.sem;
		s.node_types[node.addr()] = ty!;
	}

	pub fn get_node_type(*self, node: *AstNode?): *Type? {
		if (node == null || self.sem == null) return null;
		val p = self.sem.node_types.get(node.addr()) ?: return null;
		return p.read();
	}

	pub fn set_resolved_method(*self, node: *AstNode?, mi: *MethodInfo?) {
		if (node == null || mi == null || self.sem == null) return;
		var s = self.sem;
		s.resolved_methods[node.addr()] = mi!;
	}

	pub fn get_resolved_method(*self, node: *AstNode?): *MethodInfo? {
		if (node == null || self.sem == null) return null;
		val p = self.sem.resolved_methods.get(node.addr()) ?: return null;
		return p.read();
	}

	pub fn set_resolved_node(*self, node: *AstNode?, r: *AstNode?) {
		if (node == null || r == null || self.sem == null) return;
		var s = self.sem;
		s.resolved_nodes[node.addr()] = r!;
	}

	pub fn get_resolved_node(*self, node: *AstNode?): *AstNode? {
		if (node == null || self.sem == null) return null;
		val p = self.sem.resolved_nodes.get(node.addr()) ?: return null;
		return p.read();
	}

	pub fn set_node_instance(*self, node: *AstNode?, rec: *InstanceRecord?) {
		if (node == null || rec == null || self.sem == null) return;
		var s = self.sem;
		s.node_instances[node.addr()] = rec!;
	}

	pub fn get_node_instance(*self, node: *AstNode?): *InstanceRecord? {
		if (node == null || self.sem == null) return null;
		val p = self.sem.node_instances.get(node.addr()) ?: return null;
		return p.read();
	}

	pub fn set_is_pattern(*self, node: *AstNode?, info: IsPatternInfo) {
		if (node == null || self.sem == null) return;
		var s = self.sem;
		s.is_patterns[node.addr()] = info;
	}

	pub fn has_is_pattern(*self, node: *AstNode?): bool {
		if (node == null || self.sem == null) return false;
		return self.sem.is_patterns.get(node.addr()) != null;
	}

	pub fn get_is_pattern(*self, node: *AstNode?): IsPatternInfo {
		if (node == null || self.sem == null) return IsPatternInfo();
		val p = self.sem.is_patterns.get(node.addr()) ?: return IsPatternInfo();
		return p.read();
	}

	pub fn set_predicate_pattern(*self, node: *AstNode?) {
		if (node == null || self.sem == null) return;
		var s = self.sem;
		s.predicate_patterns[node.addr()] = true;
	}

	pub fn is_predicate_pattern(*self, node: *AstNode?): bool {
		if (node == null || self.sem == null) return false;
		return self.sem.predicate_patterns.get(node.addr()) != null;
	}

	pub fn alloc_lambda_id(*self): usz {
		if (self.sem == null) return 0;
		var s = self.sem;
		val id = s.next_lambda_id;
		s.next_lambda_id = id + 1;
		return id;
	}

	pub fn set_lambda_info(*self, node: *AstNode?, info: LambdaInfo) {
		if (node == null || self.sem == null) return;
		var s = self.sem;
		s.lambdas[node.addr()] = info;
	}

	pub fn has_lambda_info(*self, node: *AstNode?): bool {
		if (node == null || self.sem == null) return false;
		return self.sem.lambdas.get(node.addr()) != null;
	}

	pub fn get_lambda_info(*self, node: *AstNode?): LambdaInfo {
		if (node == null || self.sem == null) return LambdaInfo();
		val p = self.sem.lambdas.get(node.addr()) ?: return LambdaInfo();
		return p.read();
	}

	pub fn set_closure_call(*self, node: *AstNode?) {
		if (node == null || self.sem == null) return;
		var s = self.sem;
		s.closure_calls[node.addr()] = true;
	}

	pub fn is_closure_call(*self, node: *AstNode?): bool {
		if (node == null || self.sem == null) return false;
		return self.sem.closure_calls.get(node.addr()) != null;
	}

	// Returns the enclosing local/parameter symbol if `name` is resolved in `boundary`
	// or an ancestor scope of `boundary`, or null if resolved inside the lambda or globally.
	pub fn lookup_local_at_or_above(*self, name: str, boundary: *Scope?): *Symbol? {
		if (boundary == null) return null;
		var curr: *Scope? = self.current_scope;
		var reached_boundary = false;
		while (curr != null) {
			if (curr == boundary) reached_boundary = true;
			for (sym in curr) {
				if (sym.name == name) {
					if (
						reached_boundary
						&& (sym.kind == SymbolKind.VAR || sym.kind == SymbolKind.PARAM)
					) return sym;
					return null;
				}
			}
			curr = curr.parent;
		}
		return null;
	}

	// Returns the local/parameter symbol if `name` is defined in any enclosing local scope.
	pub fn lookup_any_local(*self, name: str): *Symbol? {
		var curr: *Scope? = self.current_scope;
		while (curr != null) {
			for (sym in curr) {
				if (
					sym.name == name
					&& (sym.kind == SymbolKind.VAR || sym.kind == SymbolKind.PARAM)
				) return sym;
			}
			curr = curr.parent;
		}
		return null;
	}

	pub fn register_prim_method(*self, prim: *Type, mi: *MethodInfo) {
		var target = prim;
		target.add_method(mi);
	}

	pub fn find_prim_method(*self, kind: DataType, name: str): *MethodInfo? {
		val t = self.prims.get(kind) ?: return null;
		return t.method_named(name);
	}

	pub fn find_prim_method_arity(*self, kind: DataType, name: str, argc: usz): *MethodInfo? {
		val t = self.prims.get(kind) ?: return null;
		return t.method_arity(name, argc);
	}

	pub fn prim_methods_of(*self, kind: DataType): List<*MethodInfo> {
		val t = self.prims.get(kind) ?: return List();
		return t.method_list();
	}

	pub fn find_prim_method_c(*self, c_name: str): *MethodInfo? {
		for (t in self.prims.types) {
			val m = t.method_by_c_name(c_name);
			if (m != null) return m;
		}
		return null;
	}

	pub fn register_trait(&self, info: *TraitInfo) {
		self.traits += info;
		self.trait_map[info.name] = info;
	}

	pub fn find_trait(*self, name: str): *TraitInfo? {
		val p = self.trait_map.get(name) ?: return null;
		return p.read();
	}

	pub fn register_enum_info(&self, info: *EnumInfo) {
		self.enums += info;
		self.enum_map[info.name] = info;
		if (
			!info.c_name.empty()
			&& info.c_name != info.name
		) self.enum_map[info.c_name] = info;
	}

	pub fn find_enum_info(*self, name: str): *EnumInfo? {
		val p = self.enum_map.get(name) ?: return null;
		return p.read();
	}

	pub fn enter_scope(&self, is_fn_boundary: bool): *Scope {
		val new_sc = self.arena.create_val(Scope(self.current_scope, List<*Symbol>(), is_fn_boundary));
		self.current_scope = new_sc;
		return new_sc;
	}

	pub fn exit_scope(&self) {
		self.current_scope = self.current_scope.parent ?: return;
	}

	pub fn is_in_function(*self): bool {
		var curr: *Scope? = self.current_scope;
		while (curr != null) {
			if (curr.is_fn_boundary) return true;
			curr = curr.parent;
		}

		return false;
	}

	pub fn lookup_current(*self, name: str): *Symbol? {
		val scope = self.current_scope;
		for (sym in scope) if (sym.name == name) return sym;
		return null;
	}

	pub fn lookup(*self, name: str): *Symbol? {
		var curr: *Scope? = self.current_scope;
		while (curr != null) {
			for (sym in curr) if (sym.name == name) return sym;
			curr = curr.parent;
		}

		val own = self.lookup_in_module(self.current_module, name);
		if (own != null) return own;

		val b = self.explicit_imports["${self.current_module}::${name}"];
		if (b != null) {
			val found = self.lookup_in_module(b.module_name, b.symbol_name);
			if (found != null) return found;
		}

		for (i in 0..<self.wildcard_owners.len) {
			if (self.wildcard_owners[i] == self.current_module) {
				val found = self.lookup_in_module(self.wildcard_modules[i], name);
				if (found != null) return found;
			}
		}

		return self.gen.find_instance_symbol(name) ?: self.lookup_c_name(name);
	}

	pub fn define(&self, sym: Symbol): bool {
		val existing = self.lookup_current(sym.name);
		if (existing != null) return false;

		val sym_ptr = self.arena.create_val(sym);
		self.current_scope += sym_ptr;
		return true;
	}

	pub fn set_current_module(&self, name: str) => self.current_module = name;

	/*
	 * Struct layouts are computed when a declaration is collected, but a by-value
	 * field may reference a struct whose own layout is still pending (a forward
	 * shell, or a type declared later in the same module). Once collection is
	 * complete, re-layout every struct until the sizes stop changing; this makes
	 * the layout independent of declaration and file order.
	 */
	/*
	 * Struct layouts are computed when a declaration is collected, but a by-value
	 * field may reference a struct whose own layout is still pending (a forward
	 * shell, or a type declared later in the same module). Once collection is
	 * complete, re-layout every struct until the sizes stop changing; this makes
	 * the layout independent of declaration and file order.
	 *
	 * Payload enums are also registered as STRUCT symbols, but their size is a
	 * tag + payload union computed by `collect_payload_enum`, not a plain field
	 * layout, so they must be skipped here.
	 */
	pub fn relayout_structs(*self) {
		var changed = true;
		var round = 0;
		while (changed && round < 32) {
			changed = false;
			for (ms in self.modules) {
				for (sym in ms.symbols) {
					if (sym.kind != SymbolKind.STRUCT) continue;
					if (sym.type_ptr == null) continue;
					if (sym.type_ptr.is_enum()) continue;
					if (self.find_enum_info(sym.name) != null) continue;
					if (self.find_enum_info(sym.c_name) != null) continue;
					val before = sym.type_ptr.size;
					sym.type_ptr.layout_struct();
					if (sym.type_ptr.size != before) changed = true;
				}
			}
			round++;
		}
	}

	pub fn find_module(*self, name: str): *ModuleScope? {
		val p = self.module_map.get(name) ?: return null;
		return p.read();
	}

	pub fn module_exists(*self, name: str) => name in self.module_map;

	pub fn has_wildcard(*self, owner: str, module_name: str): bool {
		for (i in 0..<self.wildcard_owners.len) {
			if (
				self.wildcard_owners[i] == owner
				&& self.wildcard_modules[i] == module_name
			) return true;
		}
		return false;
	}

	pub fn set_assoc_type(
		&self, struct_name: str,
		assoc: str, ty: *Type
	) {
		self.assoc_types["${struct_name}.${assoc}"] = ty;
	}

	pub fn find_assoc_type(*self, struct_name: str, assoc: str): *Type? {
		val p = self.assoc_types.get("${struct_name}.${assoc}") ?: return null;
		return p.read();
	}

	pub fn define_in_module(&self, module_name: str, sym: Symbol): bool {
		val sc = self.find_module(module_name);
		if (sc != null) {
			if (sym.name in sc) return false;
			val sym_ptr = self.arena.create_val(sym);
			sc += sym_ptr;

			if (
				!sym.c_name.empty()
				&& sym.c_name != sym.name
			) self.c_name_map[sym.c_name] = sym_ptr;

			if (sym.kind == SymbolKind.CONST) self.struct_const_map[sym.name] = sym_ptr;

			return true;
		}

		val fresh = self.arena.create_val(ModuleScope(module_name));
		val sym_ptr2 = self.arena.create_val(sym);
		fresh += sym_ptr2;
		self.modules += fresh;
		self.module_map[module_name] = fresh;
		if (
			!sym.c_name.empty()
			&& sym.c_name != sym.name
		) self.c_name_map[sym.c_name] = sym_ptr2;

		if (sym.kind == SymbolKind.CONST) self.struct_const_map[sym.name] = sym_ptr2;
		return true;
	}

	pub fn define_global(&self, sym: Symbol) => self.define_in_module(self.current_module, sym);

	pub fn add_import(&self, module_name: str, symbol_name: str, local_name: str, wildcard: bool) {
		val binding = ImportBinding(module_name, symbol_name, local_name, wildcard, self.current_module);
		self.imports += binding;

		if (wildcard) {
			self.wildcard_owners += self.current_module;
			self.wildcard_modules += module_name;
		} else {
			self.explicit_imports["${self.current_module}::${local_name}"] = binding;
		}
	}

	pub fn lookup_in_module(*self, module_name: str, name: str): *Symbol? {
		val sc = self.find_module(module_name) ?: return null;
		return sc.lookup(name);
	}

	pub fn lookup_c_name(*self, c_name: str): *Symbol? {
		if (c_name.empty()) return null;
		val p = self.c_name_map.get(c_name) ?: return null;
		return p.read();
	}

	pub fn lookup_struct_const(*self, struct_name: str, member_name: str): *Symbol? {
		val direct = "${struct_name}__${member_name}";
		val p = self.struct_const_map.get(direct);
		val s = p.read();
		if (s != null) return s;

		for (sc in self.modules) {
			val sc_s = sc.lookup(direct);
			if (sc_s?.kind == SymbolKind.CONST) return sc_s;
		}

		return null;
	}

}
