mod compiler.semantic.types;

use std.collections.*;
use std.memory.*;
use std.string.*;

/*
 * ============================================================================
 * compiler.semantic.types.primitive — Canonical primitive type singletons
 *
 * Allocates one `*Type` per primitive `DataType` for the entire compilation so
 * that built-in primitive methods (`impl i32 { ... }`) attach to a single
 * canonical instance and pointer identity is preserved.
 * ============================================================================
 */

// i think we should rename this to "Primitive" which is short and pretty
pub struct PrimTypes {
	pub types: List<*Type>
}

fn prim_with_methods(var arena: &Arena, kind: DataType): *Type {
	var t = arena.primitive_type(Type.primitive(kind));
	val pm = arena.create_val(PrimMethods());
	t.methods = pm;
	return t;
}

impl PrimTypes {

	pub init(var arena: &Arena) {
		var types = List<*Type>();
		types += prim_with_methods(arena, DataType.NONE);
		types += prim_with_methods(arena, DataType.BOOL);
		types += prim_with_methods(arena, DataType.CHAR);
		types += prim_with_methods(arena, DataType.I8);
		types += prim_with_methods(arena, DataType.I16);
		types += prim_with_methods(arena, DataType.I32);
		types += prim_with_methods(arena, DataType.I64);
		types += prim_with_methods(arena, DataType.ISZ);
		types += prim_with_methods(arena, DataType.U8);
		types += prim_with_methods(arena, DataType.U16);
		types += prim_with_methods(arena, DataType.U32);
		types += prim_with_methods(arena, DataType.U64);
		types += prim_with_methods(arena, DataType.USZ);
		types += prim_with_methods(arena, DataType.F32);
		types += prim_with_methods(arena, DataType.F64);
		types += prim_with_methods(arena, DataType.STR);
		return Self(types);
	}

	// Resolves a built-in primitive type name to its canonical `*Type` instance.
	pub fn resolve_name(*self, name: str): *Type? => when (name) {
		"none" -> self.get(DataType.NONE);
		"bool" -> self.get(DataType.BOOL);
		"char" -> self.get(DataType.CHAR);
		"i8" -> self.get(DataType.I8);
		"i16" -> self.get(DataType.I16);
		"i32" -> self.get(DataType.I32);
		"i64" -> self.get(DataType.I64);
		"isz" -> self.get(DataType.ISZ);
		"u8" -> self.get(DataType.U8);
		"u16" -> self.get(DataType.U16);
		"u32" -> self.get(DataType.U32);
		"u64" -> self.get(DataType.U64);
		"usz" -> self.get(DataType.USZ);
		"f32" -> self.get(DataType.F32);
		"f64" -> self.get(DataType.F64);
		"str" -> self.get(DataType.STR);
		else -> null;
	};

	// Determines the canonical integer type of an integer literal from its suffix.
	pub fn integer(*self, raw: str): *Type {
		val suffix = raw.num_suffix();

		return when (suffix) {
			"UB" -> self.get(DataType.U8);
			"US" -> self.get(DataType.U16);
			"UL" -> self.get(DataType.U64);
			"UZ" -> self.get(DataType.USZ);
			"U" -> self.get(DataType.U32);
			"L" -> self.get(DataType.I64);
			"S" -> self.get(DataType.I16);
			"Z" -> self.get(DataType.ISZ);
			"B" -> self.get(DataType.I8);
			else -> self.get(DataType.I32);
		};
	}

	pub fn get(*self, kind: DataType): *Type {
		for (t in self.types) if (t.kind == kind) return t;
		return self.types[0];
	}

	pub fn t_none(*self) => self.get(DataType.NONE);
	pub fn t_bool(*self) => self.get(DataType.BOOL);
	pub fn t_char(*self) => self.get(DataType.CHAR);
	pub fn t_str(*self) => self.get(DataType.STR);
	pub fn t_usz(*self) => self.get(DataType.USZ);
	pub fn t_i32(*self) => self.get(DataType.I32);
	pub fn t_f32(*self) => self.get(DataType.F32);
	pub fn t_f64(*self) => self.get(DataType.F64);
	pub fn t_prim(*self, base: Type) => self.get(base.kind);

}

// Resolves a built-in primitive type name to its canonical `*Type` instance.
pub fn resolve_primitive_name(prims: *PrimTypes, name: str): *Type? => when (name) {
	"none" -> prims.get(DataType.NONE);
	"bool" -> prims.get(DataType.BOOL);
	"char" -> prims.get(DataType.CHAR);
	"i8" -> prims.get(DataType.I8);
	"i16" -> prims.get(DataType.I16);
	"i32" -> prims.get(DataType.I32);
	"i64" -> prims.get(DataType.I64);
	"isz" -> prims.get(DataType.ISZ);
	"u8" -> prims.get(DataType.U8);
	"u16" -> prims.get(DataType.U16);
	"u32" -> prims.get(DataType.U32);
	"u64" -> prims.get(DataType.U64);
	"usz" -> prims.get(DataType.USZ);
	"f32" -> prims.get(DataType.F32);
	"f64" -> prims.get(DataType.F64);
	"str" -> prims.get(DataType.STR);
	else -> null;
};

// Determines the canonical integer type of an integer literal from its suffix.
pub fn int_literal_type(prims: *PrimTypes, raw: str): *Type {
	val sfx = raw.num_suffix();

	return when (sfx) {
		"UB" -> prims.get(DataType.U8);
		"US" -> prims.get(DataType.U16);
		"UL" -> prims.get(DataType.U64);
		"UZ" -> prims.get(DataType.USZ);

		"U" -> prims.get(DataType.U32);
		"L" -> prims.get(DataType.I64);
		"S" -> prims.get(DataType.I16);
		"Z" -> prims.get(DataType.ISZ);
		"B" -> prims.get(DataType.I8);

		else -> prims.get(DataType.I32);
	};

}

pub fn primitive_type_name(ty: *Type) => when (ty.kind) {
	DataType.BOOL -> "bool";
	DataType.CHAR -> "char";
	DataType.I8 -> "i8";
	DataType.I16 -> "i16";
	DataType.I32 -> "i32";
	DataType.I64 -> "i64";
	DataType.ISZ -> "isz";
	DataType.U8 -> "u8";
	DataType.U16 -> "u16";
	DataType.U32 -> "u32";
	DataType.U64 -> "u64";
	DataType.USZ -> "usz";
	DataType.F32 -> "f32";
	DataType.F64 -> "f64";
	DataType.STR -> "str";
	else -> "none";
};

// Returns the C size in bytes of a primitive type name, or 0 if not primitive.
pub fn prim_c_size(name: str) => when (name) {
	"bool", "char", "i8", "u8" -> 1;
	"i16", "u16" -> 2;
	"i32", "u32", "f32" -> 4;
	"i64", "u64", "isz", "usz", "f64" -> 8;
	"str" -> 16;
	else -> 0;
};
