mod compiler.semantic.types;

use std.collections.*;
use std.memory.*;

use compiler.ast.*;

/*
 * ============================================================================
 * compiler.semantic.types.bridge — Resolved Type to AST Type Node Synthesis
 *
 * Converts a resolved semantic `*Type` back into an explicit syntactic
 * `*AstNode` type annotation for synthesized locals and monomorphized
 * signatures consumed by the C99 code generator.
 * ============================================================================
 */

impl Arena {

	fn ast_named_type(var self, name: str): *AstNode
		=> self.node(NodeData.NamedType(name, List<*AstNode>()), 0, 0);

	pub fn ast_type_from_type(var self, ty: *Type): *AstNode {
		if (ty.is_enum()) return self.ast_named_type(ty.as_enum().c_name);

		return when (ty.kind) {
			DataType.POINTER -> {
				val pt = ty.as_pointer();
				val base_ptr = self.node(NodeData.PointerType(pt.mutable, self.ast_type_from_type(pt.pointee)), 0, 0);
				if (pt.nullable) yield self.node(NodeData.NullableType(base_ptr), 0, 0);
				yield base_ptr;
			}
			DataType.ARRAY -> {
				val at = ty.as_array();
				yield self.node(NodeData.ArrayType(self.ast_type_from_type(at.elem), at.length), 0, 0);
			}
			DataType.STRUCT -> {
				val st_info = ty.as_struct();
				var st_name = st_info.name;
				if (st_info.c_name.len > 0) st_name = st_info.c_name;
				yield self.ast_named_type(st_name);
			}
			DataType.NONE -> self.ast_named_type("none");
			DataType.STR -> self.ast_named_type("str");
			DataType.BOOL -> self.ast_named_type("bool");
			DataType.CHAR -> self.ast_named_type("char");
			DataType.I8 -> self.ast_named_type("i8");
			DataType.I16 -> self.ast_named_type("i16");
			DataType.I32 -> self.ast_named_type("i32");
			DataType.I64 -> self.ast_named_type("i64");
			DataType.ISZ -> self.ast_named_type("isz");
			DataType.U8 -> self.ast_named_type("u8");
			DataType.U16 -> self.ast_named_type("u16");
			DataType.U32 -> self.ast_named_type("u32");
			DataType.U64 -> self.ast_named_type("u64");
			DataType.USZ -> self.ast_named_type("usz");
			DataType.F32 -> self.ast_named_type("f32");
			DataType.F64 -> self.ast_named_type("f64");
			else -> self.ast_named_type("none");
		};
	}

}
