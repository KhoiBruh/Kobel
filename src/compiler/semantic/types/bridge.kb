mod compiler.semantic.types;

use std.collections.*;
use std.memory.*;

use compiler.ast.*;

/*
 * ============================================================================
 * compiler.semantic.types.bridge — Resolved Type to AST Type Node Synthesis
 *
 * Converts a resolved semantic `*Type` back into an explicit syntactic
 * `*AstNode` type annotation for synthesized locals and monomorphized
 * signatures consumed by the C99 code generator.
 * ============================================================================
 */

impl Arena {

	fn ast_named_type(&self, name: str)
		=> self.node(NodeData.NamedType(name, List<&AstNode>()));

	pub fn ast_type_from_type(&self, ty: *Type): &AstNode {
		if (ty.is_enum()) return self.ast_named_type(ty.as_enum()!.c_name);

		return when (ty.kind) {
			DataType.POINTER -> {
				val pt = ty.as_pointer()!;
				yield self.node(NodeData.PointerType(pt.mutable, pt.nullable, self.ast_type_from_type(pt.pointee)), 0, 0);
			}
			DataType.ARRAY -> {
				val at = ty.as_array()!;
				yield self.node(NodeData.ArrayType(self.ast_type_from_type(at.elem), at.length), 0, 0);
			}
			DataType.STRUCT -> {
				val st_info = ty.as_struct()!;
				var st_name = st_info.name;
				if (st_info.c_name.len > 0) st_name = st_info.c_name;
				yield self.ast_named_type(st_name);
			}
			DataType.FN -> {
				val fn_info = ty.as_fn()!;
				var p_nodes = List<&AstNode>();
				for (pt in fn_info.param_types) p_nodes += self.ast_type_from_type(pt);
				yield self.node(NodeData.FnType(p_nodes, self.ast_type_from_type(fn_info.return_type)), 0, 0);
			}
			DataType.ERROR_UNION -> {
				val eu = ty.as_error_union()!;
				val ok_n = if (eu.ok.kind == DataType.NONE) null else self.ast_type_from_type(eu.ok);
				yield self.node(NodeData.ErrorUnionType(ok_n, self.ast_type_from_type(eu.err)), 0, 0);
			}
			DataType.NONE -> self.ast_named_type("none");
			DataType.STR -> self.ast_named_type("str");
			DataType.BOOL -> self.ast_named_type("bool");
			DataType.CHAR -> self.ast_named_type("char");
			DataType.I8 -> self.ast_named_type("i8");
			DataType.I16 -> self.ast_named_type("i16");
			DataType.I32 -> self.ast_named_type("i32");
			DataType.I64 -> self.ast_named_type("i64");
			DataType.ISZ -> self.ast_named_type("isz");
			DataType.U8 -> self.ast_named_type("u8");
			DataType.U16 -> self.ast_named_type("u16");
			DataType.U32 -> self.ast_named_type("u32");
			DataType.U64 -> self.ast_named_type("u64");
			DataType.USZ -> self.ast_named_type("usz");
			DataType.F32 -> self.ast_named_type("f32");
			DataType.F64 -> self.ast_named_type("f64");
		};
	}

}

pub fn eu_ast_type_token(node: ?*AstNode): str {
	if (node == null) return "none";
	return when (node!) {
		is NamedType as nt -> nt.name;
		is PointerType as pt -> {
			val q = if (pt.nullable) "q" else "";
			val m = if (pt.mutable) "mut_" else "";
			yield "${q}${m}ptr_${eu_ast_type_token(pt.pointee)}";
		}
		is ArrayType as at -> "arr${at.size}_${eu_ast_type_token(at.element_type)}";
		is ErrorUnionType as eu -> "eu_${eu_ast_type_token(eu.ok_type)}__${eu_ast_type_token(eu.err_type)}";
		is FnType -> "fn";
		else -> "none";
	};
}

pub fn eu_c_name_from_ast(eu: *ErrorUnionType): str
	=> "__kobel_eu_${eu_ast_type_token(eu.ok_type)}__${eu_ast_type_token(eu.err_type)}";
