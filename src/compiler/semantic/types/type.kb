mod compiler.semantic.types;

use std.collections.*;
use std.memory.Arena;
use std.traits.*;
use std.string.*;

/*
 * ============================================================================
 * compiler.semantic.types.type — Core semantic type model
 *
 * Defines `DataType`, `TypePayload`, and `Type`, along with structural type
 * equality, assignment compatibility (`can_assign`), struct field layout
 * calculation, and string formatting.
 * ============================================================================
 */

pub enum DataType {
	NONE,
	BOOL,
	CHAR,
	I8, I16, I32, I64, ISZ,
	U8, U16, U32, U64, USZ,
	F32, F64,
	STR,
	POINTER,
	ARRAY,
	STRUCT,
	FN
}

/*
 * Variant payload carried by a `Type` in addition to `kind`, `size`, and `align`.
 * `NONE` covers primitive types; composite variants carry typed pointers.
 */
pub enum TypePayload {
	NONE,
	Pointer(pointee: *Type, mutable: bool, nullable: bool),
	Array(elem: *Type, length: usz),
	Struct(inner: *StructType),
	Fn(param_types: List<*Type>, return_type: *Type, is_variadic: bool),
	Enum(inner: *EnumInfo)
}

pub struct Type {
	pub kind: DataType,
	pub size: usz,
	pub align: usz,
	pub data: TypePayload,
	// Methods registered on a built-in primitive type (`impl i32 { ... }`).
	// Null for non-primitive types and non-canonical primitive values.
	pub methods: *PrimMethods? = null
}

// ============================================================================
// Primitive Type Value Constructors
// ============================================================================

impl Type {

	pub fn primitive(kind: DataType): Type {
		val size = when (kind) {
			DataType.NONE -> 0;
			DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
			DataType.I16, DataType.U16 -> 2;
			DataType.I32, DataType.U32, DataType.F32 -> 4;
			DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64 -> 8;
			DataType.STR -> 16;
			else -> 8;
		};
		val align = when (kind) {
			DataType.NONE, DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
			DataType.I16, DataType.U16 -> 2;
			DataType.I32, DataType.U32, DataType.F32 -> 4;
			DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64, DataType.STR -> 8;
			else -> 8;
		};
		return Type(kind, size, align, TypePayload.NONE);
	}

	pub fn none() => Type.primitive(DataType.NONE);
	pub fn bool() => Type.primitive(DataType.BOOL);
	pub fn char() => Type.primitive(DataType.CHAR);

	pub fn i8() => Type.primitive(DataType.I8);
	pub fn i16() => Type.primitive(DataType.I16);
	pub fn i32() => Type.primitive(DataType.I32);
	pub fn i64() => Type.primitive(DataType.I64);
	pub fn isz() => Type.primitive(DataType.ISZ);

	pub fn u8() => Type.primitive(DataType.U8);
	pub fn u16() => Type.primitive(DataType.U16);
	pub fn u32() => Type.primitive(DataType.U32);
	pub fn u64() => Type.primitive(DataType.U64);
	pub fn usz() => Type.primitive(DataType.USZ);

	pub fn f32() => Type.primitive(DataType.F32);
	pub fn f64() => Type.primitive(DataType.F64);

	pub fn str() => Type.primitive(DataType.STR);

}

// ============================================================================
// Arena Type Allocators
// ============================================================================

impl Arena {

	pub fn type_payload(
		&self, kind: DataType, size: usz,
		align: usz, data: TypePayload
	) => self.create_val(Type(kind, size, align, data));

	pub fn primitive_type(&self, base: Type) => self.create_val(base);

	pub fn pointer_type(&self, pointee: *Type, mutable: bool): *Type
		=> self.type_payload(DataType.POINTER, 8, 8, TypePayload.Pointer(pointee, mutable, false));

	pub fn nullable_pointer_type(&self, pointee: *Type, mutable: bool): *Type
		=> self.type_payload(DataType.POINTER, 8, 8, TypePayload.Pointer(pointee, mutable, true));

	pub fn array_type(&self, elem: *Type, length: usz): *Type
		=> self.type_payload(DataType.ARRAY, elem.size * length, elem.align, TypePayload.Array(elem, length));

	pub fn fn_type(&self, param_types: List<*Type>, return_type: *Type, is_variadic: bool = false): *Type
		=> self.type_payload(DataType.FN, 16, 8, TypePayload.Fn(param_types, return_type, is_variadic));

}

// ============================================================================
// Payload Accessors, Predicates, Layout & Compatibility
// ============================================================================

impl Type {

	pub fn as_pointer(*self): *TypePayload.Pointer? {
		return when (self.data) {
			is TypePayload.Pointer as p -> p;
			else -> null;
		};
	}

	pub fn as_array(*self): *TypePayload.Array? {
		return when (self.data) {
			is TypePayload.Array as p -> p;
			else -> null;
		};
	}

	pub fn as_struct(*self): *StructType? {
		val data = self.data;
		return when (data) {
			is TypePayload.Struct as p -> p.inner;
			else -> null;
		};
	}

	pub fn as_fn(*self): *TypePayload.Fn? {
		return when (self.data) {
			is TypePayload.Fn as p -> p;
			else -> null;
		};
	}

	pub fn as_enum(*self): *EnumInfo? {
		val data = self.data;
		return when (data) {
			is TypePayload.Enum as p -> p.inner;
			else -> null;
		};
	}

	// Appends a method to a canonical built-in primitive type from `PrimTypes`.
	pub fn add_method(*self, mi: *MethodInfo) {
		if (self.methods == null) return;
		self.methods.list += mi;
	}

	pub fn method_list(*self): List<*MethodInfo> {
		if (self.methods == null) return List();
		return self.methods.list;
	}

	pub fn method_named(*self, name: str): *MethodInfo? {
		val list = self.method_list();
		for (m in list) if (m.name == name) return m;
		return null;
	}

	pub fn method_arity(*self, name: str, argc: usz): *MethodInfo? {
		val list = self.method_list();
		for (m in list) {
			if (
				m.name == name
				&& m.fn_type.as_fn().param_types.len == argc
			) return m;
		}
		return null;
	}

	pub fn method_by_c_name(*self, c_name: str): *MethodInfo? {
		val list = self.method_list();
		for (m in list) if (m.c_name == c_name) return m;
		return null;
	}

	pub fn is_signed_integer(*self) => when (self.kind) {
		DataType.I8, DataType.I16, DataType.I32,
		DataType.I64, DataType.ISZ -> true;
		else -> false;
	};

	pub fn is_unsigned_integer(*self) => when (self.kind) {
		DataType.U8, DataType.U16, DataType.U32,
		DataType.U64, DataType.USZ -> true;
		else -> false;
	};

	pub fn is_integer(*self) => self.is_signed_integer() || self.is_unsigned_integer();

	pub fn is_float(*self) => when (self.kind) {
		DataType.F32, DataType.F64 -> true;
		else -> false;
	};

	pub fn is_enum(*self): bool => when (self.data) {
		is TypePayload.Enum -> true;
		else -> false;
	};

	pub fn is_numeric(*self) => self.is_integer() || self.is_float();

	pub fn is_list(*self): bool {
		if (self.kind != DataType.STRUCT) return false;
		val s = self.as_struct();
		if (
			s.module != "std.collections.list"
			&& s.module != "std.collections"
		) return false;

		return s.name.starts_with("std__collections__list__List")
			|| s.c_name.starts_with("std__collections__list__List")
			|| s.name.starts_with("std__collections__List")
			|| s.c_name.starts_with("std__collections__List");
	}

	pub fn layout_struct(&self) {
		val st = self.as_struct();
		var max_align = 1;
		var offset = 0;

		for (i in 0..<st.fields.len) {
			val field_align = st.fields[i].type_ptr.align;
			if (field_align > max_align) max_align = field_align;

			val remove = offset % field_align;
			if (remove != 0) offset += field_align - remove;

			var f = st.fields[i];
			f.offset = offset;
			st.fields[i] = f;
			offset += f.type_ptr.size;
		}

		val total = offset % max_align;
		if (total != 0) offset += max_align - total;

		self.size = offset;
		self.align = max_align;
	}

	pub op equals(*self, b: *Type): bool {
		if (self == b) return true;
		if (self.kind != b.kind) return false;

		if (self.is_enum() || b.is_enum()) {
			if (!self.is_enum() || !b.is_enum()) return false;
			val ea = self.as_enum();
			val eb = b.as_enum();
			val n_a = if (ea.c_name.empty()) ea.name else ea.c_name;
			val n_b = if (eb.c_name.empty()) eb.name else eb.c_name;
			return n_a == n_b;
		}

		return when (self.kind) {
			DataType.POINTER -> {
				val p_a = self.as_pointer();
				val p_b = b.as_pointer();
				yield p_a.mutable == p_b.mutable
					&& p_a.nullable == p_b.nullable
					&& p_a.pointee.equals(p_b.pointee);
			}
			DataType.ARRAY -> {
				val arr_a = self.as_array();
				val arr_b = b.as_array();
				yield arr_a.length == arr_b.length
					&& arr_a.elem.equals(arr_b.elem);
			}
			DataType.STRUCT -> {
				val s_a = self.as_struct();
				val s_b = b.as_struct();
				val n_a = if (s_a.c_name.empty()) s_a.name else s_a.c_name;
				val n_b = if (s_b.c_name.empty()) s_b.name else s_b.c_name;
				yield n_a == n_b;
			}
			DataType.FN -> {
				val f_a = self.as_fn();
				val f_b = b.as_fn();
				if (f_a.is_variadic != f_b.is_variadic) yield false;
				if (f_a.param_types.len != f_b.param_types.len) yield false;
				if (!f_a.return_type.equals(f_b.return_type)) yield false;

				for (i in 0..<f_a.param_types.len) {
					if (!f_a.param_types[i].equals(f_b.param_types[i])) yield false;
				}
				yield true;
			}
			else -> true;
		};
	}

	pub fn can_assign(*self, source: *Type): bool {
		if (self.equals(source)) return true;

		// Enum raw-value coercion to/from its underlying primitive type.
		if (self.is_enum() && !self.as_enum().is_payload) {
			if (!source.is_enum() && self.as_enum().underlying.can_assign(source)) return true;
		}
		if (source.is_enum() && !source.as_enum().is_payload) {
			if (!self.is_enum() && self.can_assign(source.as_enum().underlying)) return true;
		}

		// 1. Integer coercion
		if (self.is_integer() && source.is_integer()) return true;

		// 2. Float coercion
		if (self.is_float() && source.is_float()) return true;
		if (self.is_float() && source.is_integer()) return true;

		// 3. Passing/assigning str to *char, &char, *u8, &u8, *none
		if (self.kind == DataType.POINTER && source.kind == DataType.STR) {
			val t_ptr = self.as_pointer();
			if (
				t_ptr.pointee.kind == DataType.CHAR
				|| t_ptr.pointee.kind == DataType.U8
				|| t_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		// 4. Assigning a non-nullable char/u8 pointer to str
		if (self.kind == DataType.STR && source.kind == DataType.POINTER) {
			val s_ptr = source.as_pointer();
			if (s_ptr.nullable) return false;
			if (
				s_ptr.pointee.kind == DataType.CHAR
				|| s_ptr.pointee.kind == DataType.U8
			) return true;
		}

		// 5. Pointer mutability (&T -> *T), nullability (*T -> *T?), and raw byte pointers
		if (self.kind == DataType.POINTER && source.kind == DataType.POINTER) {
			val t_ptr = self.as_pointer();
			val s_ptr = source.as_pointer();

			if (s_ptr.nullable && !t_ptr.nullable) return false;

			if (
				(!t_ptr.mutable || s_ptr.mutable)
				&& t_ptr.pointee.equals(s_ptr.pointee)
			) return true;

			if (s_ptr.pointee.kind == DataType.NONE) return t_ptr.nullable;

			if (
				t_ptr.pointee.kind == DataType.U8
				|| t_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		return false;
	}

}

impl Stringer for Type {

	pub fn to_str(*self): str => when (self.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> {
			val ptr = self.as_pointer();
			val q = if (ptr.nullable) "?" else "";
			if (ptr.mutable) yield "&${ptr.pointee.to_str()}${q}";
			yield "*${ptr.pointee.to_str()}${q}";
		}
		DataType.ARRAY -> {
			val arr = self.as_array();
			yield "[${arr.elem.to_str()}]";
		}
		DataType.STRUCT -> {
			val s = self.as_struct();
			yield s.name;
		}
		DataType.FN -> {
			val fn_info = self.as_fn();
			var res = "(";
			for (i in 0..<fn_info.param_types.len) {
				if (i > 0) res = "${res}, ";
				if (fn_info.is_variadic && i == fn_info.param_types.len - 1) {
					res = "${res}..";
				}
				res = "${res}${fn_info.param_types[i].to_str()}";
			}
			yield "${res}) -> ${fn_info.return_type.to_str()}";
		}
	};

}
