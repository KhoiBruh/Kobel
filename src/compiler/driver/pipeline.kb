mod compiler.driver.pipeline;

use std.io.*;
use std.sys.exec;
use std.collections.list.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.sema.decl.pass.*;
use compiler.sema.decl.collect.*;
use compiler.sema.body.pass.*;
use compiler.sema.body.program.*;
use compiler.sema.lower.*;
use compiler.codegen.c_codegen.*;
use compiler.codegen.c_program.*;
use compiler.loader.loader.*;

// ============================================================================
// Compiler Driver Pipeline
// ============================================================================

pub fn print_error_list(errors: List<str>) {
	for (msg in errors) println("  [ERROR] ${msg}");
}

pub fn is_msvc_compiler(cc: str): bool {
	val base = cc.base_name();
	return base == "cl" || base == "cl.exe";
}

// Command line that turns `c_path` into `exe_path` with the given backend.
// `obj_path` is only used by MSVC; `quiet` silences the backend's diagnostics.
// Shared by `compile()` and the fixpoint gate so both invoke the same toolchain.
pub fn c_compile_cmd(c_path: str, exe_path: str, obj_path: str, cc: str, quiet: bool): str {
	val is_path_with_spaces = ("/" in cc || "\\" in cc) && (" " in cc) && !cc.starts_with("\"");
	val cc_bin = if (is_path_with_spaces) "\"${cc}\"" else cc;

	val win_exe = exe_path.to_win_path();
	val win_obj = obj_path.to_win_path();
	val win_c = c_path.to_win_path();

	val exe_arg = if (" " in win_exe) "\"${win_exe}\"" else win_exe;
	val obj_arg = if (" " in win_obj) "\"${win_obj}\"" else win_obj;
	val c_arg = if (" " in win_c) "\"${win_c}\"" else win_c;

	var cmd = if (is_msvc_compiler(cc)) {
		"${cc_bin} /nologo /O2 /std:c11 /Fe:${exe_arg} /Fo:${obj_arg} ${c_arg}"
	} else {
		"${cc_bin} -O2 -o ${exe_arg} ${c_arg}"
	};

	if (quiet) cmd = "${cmd} >nul 2>nul";
	return cmd;
}

pub struct CompileOptions {
	pub input_path: str = "",
	pub output_bin: str = "",
	pub emit_c_path: str = "",
	pub c_compiler: str = "cl",
	pub only_emit_c: bool = false,
	pub extra_roots: List<str> = List(),
	pub quiet: bool = false
}

impl CompileOptions {

	pub fn compile(val self): i32 {
		val input_path = self.input_path;
		val src = read_file(input_path);
		if (src.empty()) {
			println("Error: Could not read source file or file is empty: ${input_path}");
			return 1;
		}

		if (!self.quiet) println("[1/4] Loading modules (lex + parse)...");
		var loader = ModuleLoader(input_path.dir_of(), self.extra_roots);

		// String interpolation lowers to the `ToStr` trait, whose built-in
		// implementations live under std/traits (reachable through std.fmt). Load
		// it whenever it is available so the primitive methods exist even when the
		// input does not import the formatting module.
		if (loader.find_module("std.fmt").found) loader.ensure_module("std.fmt");
		if (loader.find_module("std.traits.hash").found) loader.ensure_module("std.traits.hash");

		val loaded_prog = loader.load_program(input_path, src);
		if (!loader.errors.empty()) {
			println("Module Errors in ${input_path}:");
			print_error_list(loader.errors);
			return 1;
		}
		if (loaded_prog == null) {
			println("Error: Could not parse source file: ${input_path}");
			return 1;
		}
		val prog = loaded_prog!;
		if (!self.quiet) println("  ${loader.count()} module(s) loaded");

		if (!self.quiet) println("[2/4] Semantic analysis (declarations)...");
		val decl_p = DeclPass();
		decl_p.collect_program(prog);
		if (!decl_p.errors.empty()) {
			println("Semantic Declaration Errors in ${input_path}:");
			print_error_list(decl_p.errors);
			return 1;
		}

		if (!self.quiet) println("[3/4] Semantic analysis (bodies)...");
		val body_p = BodyPass(decl_p.symtab, decl_p);
		body_p.check_program(prog);
		if (!body_p.errors.empty()) {
			println("Semantic Type Errors in ${input_path}:");
			print_error_list(body_p.errors);
			return 1;
		}

		// Sugar that needs no further checking is lowered in a separate pass, so
		// the checker never rewrites a node's kind in place.
		body_p.lower_program(prog);

		if (!self.quiet) println("[4/4] Generating C99 code...");
		val codegen = CCodeGen();
		val c_code = codegen.gen_program(prog);

		if (self.only_emit_c) {
			val ok = write_file(self.emit_c_path, c_code);
			if (!ok) {
				println("Error: Failed to write output file: ${self.emit_c_path}");
				return 1;
			}
			if (!self.quiet) println("[SUCCESS] C99 source written to ${self.emit_c_path}");
			return 0;
		}

		// Native binary compilation
		var out_path = self.output_bin;
		if (out_path.empty()) out_path = "${input_path.strip_kb()}.exe";

		val out_dir = out_path.dir_of();
		if (!out_dir.empty() && !file_exists(out_dir)) exec("cmd /c mkdir \"${out_dir.to_win_path()}\" >nul 2>nul");

		val c_tmp_path = "${out_path}.tmp.c";
		val obj_tmp_path = "${out_path}.tmp.obj";
		val write_ok = write_file(c_tmp_path, c_code);
		if (!write_ok) {
			println("Error: Failed to write temporary C file: ${c_tmp_path}");
			return 1;
		}

		if (!self.quiet) println("[BUILDING] Invoking backend compiler (${self.c_compiler})...");

		// If the output binary already exists, move it aside to avoid Windows LNK1104
		// file locking issues (especially during self-hosting builds).
		val old_bin = "${out_path}.old";
		if (file_exists(out_path)) {
			exec("del /f /q \"${old_bin.to_win_path()}\" >nul 2>nul");
			exec("move /y \"${out_path.to_win_path()}\" \"${old_bin.to_win_path()}\" >nul 2>nul");
		}

		var compile_cmd = c_compile_cmd(c_tmp_path, out_path, obj_tmp_path, self.c_compiler, self.quiet);

		val exit_code = exec(compile_cmd);
		if (exit_code != 0) {
			// Restore previous binary if compilation failed
			if (file_exists(old_bin) && !file_exists(out_path))
				exec("move /y \"${old_bin.to_win_path()}\" \"${out_path.to_win_path()}\" >nul 2>nul");
			println("Error: Backend C compiler failed with exit code ${exit_code}: cmd was '${compile_cmd}'");
			return exit_code;
		}

		// Exit code zero is not proof of success: a shell quirk (or a backend that
		// silently skipped the link step) can return 0 without writing the binary.
		// Without this check the build would report success while the previous
		// executable sits moved aside as `<out>.old`.
		if (!file_exists(out_path)) {
			if (file_exists(old_bin))
				exec("move /y \"${old_bin.to_win_path()}\" \"${out_path.to_win_path()}\" >nul 2>nul");
			println("Error: Backend C compiler returned 0 but produced no executable: ${out_path}");
			return 1;
		}

		// Clean up temporary C, object, and old binary files
		val base_obj = "${out_path.base_name()}.tmp.obj";
		val del_cmd = "del /f /q \"${c_tmp_path.to_win_path()}\" \"${obj_tmp_path.to_win_path()}\" \"${base_obj}\" \"${old_bin.to_win_path()}\" >nul 2>nul";
		exec(del_cmd);

		if (!self.quiet) println("[SUCCESS] Executable created: ${out_path}");
		return 0;
	}

}
