mod compiler.driver;

use std.io.*;
use std.filesystem.*;
use std.process.*;
use std.system.*;
use std.collections.*;

use compiler.core.*;

use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.declaration.*;
use compiler.semantic.checker.*;
use compiler.semantic.lowering.*;
use compiler.codegen.*;
use compiler.loader.*;

// ============================================================================
// Compiler Driver Pipeline
// ============================================================================

/*
 * The backend compiler is invoked exactly as configured; Kobel does not
 * discover a toolchain, load vcvars or translate per-compiler flags.
 *
 * The one environment value it does set is the child's temp directory. IDEs and
 * sandboxed shells routinely deny the user's %TEMP% to a process spawned by
 * another process, which makes every backend fail with "cannot create
 * temporary file"; pointing TMP/TEMP (TMPDIR on POSIX) at build/ keeps the
 * scratch space writable and inside the project.
 */
pub fn c_compile_cmd(c_path: str, exe_path: str, cc: str, quiet: bool): str {
	val cc_bin = if ((" " in cc) && !cc.starts_with("\"")) "\"${cc}\"" else cc;
	val exe_arg = if (" " in exe_path) "\"${exe_path}\"" else exe_path;
	val c_arg = if (" " in c_path) "\"${c_path}\"" else c_path;

	if (System.is_windows()) {
		var cmd = "set \"TMP=%CD%\\build\" && set \"TEMP=%CD%\\build\""
			" && ${cc_bin} -o ${exe_arg} ${c_arg}";
		if (quiet) cmd = "${cmd} >nul 2>nul";
		return cmd;
	}

	var cmd = "TMPDIR=\"build\" ${cc_bin} -o ${exe_arg} ${c_arg}";
	if (quiet) cmd = "${cmd} >/dev/null 2>&1";
	return cmd;
}

pub struct CompileOptions {
	pub input_path: str = "",
	pub output_bin: str = "",
	pub emit_c_path: str = "",
	pub c_compiler: str = "cl",
	pub only_emit_c: bool = false,
	pub extra_roots: List<str> = List(),
	pub quiet: bool = false
}

impl CompileOptions {

	pub fn compile(val self): i32 {
		val input_path = self.input_path;
		val in_p = Path(input_path);
		val src = in_p.read_text();
		if (src.empty()) {
			println("Error: Could not read source file or file is empty: ${input_path}");
			return 1;
		}

		if (!self.quiet) println("[1/4] Loading modules (lex + parse)...");
		var loader = ModuleLoader(input_path.dir_of(), self.extra_roots);

		/*
		 * String interpolation lowers to the `Stringer` trait, whose built-in
		 * implementations live in `std.traits`. Load `std.traits` and `std.string`
		 * whenever available so primitive formatting methods exist automatically.
		 */
		if (loader.find_module("std.traits").found) loader.ensure_module("std.traits");
		if (loader.find_module("std.string").found) loader.ensure_module("std.string");
		if (loader.find_module("std.range").found) loader.ensure_module("std.range");

		val loaded_prog = loader.load_program(input_path, src);
		if (!loader.errors.empty()) {
			print_diagnostics(loader.errors, input_path, &loader);
			return 1;
		}
		if (loaded_prog == null) {
			println("Error: Could not parse source file: ${input_path}");
			return 1;
		}

		val prog = loaded_prog!;
		if (!self.quiet) println("  ${loader.count()} module(s) loaded");

		if (!self.quiet) println("[2/4] Semantic analysis (declarations)...");
		var decl_p = DeclarationCollector();
		decl_p.collect_program(prog);
		if (!decl_p.errors.empty()) {
			print_diagnostics(decl_p.errors, input_path, &loader);
			return 1;
		}

		if (!self.quiet) println("[3/4] Semantic analysis (bodies)...");
		var body_p = BodyChecker(decl_p.symtab, decl_p);
		body_p.check_program(prog);
		if (!body_p.warnings.empty() && !self.quiet) {
			print_warnings(body_p.warnings, input_path, &loader);
		}
		if (!body_p.errors.empty()) {
			print_diagnostics(body_p.errors, input_path, &loader);
			return 1;
		}

		// Sugar that needs no further checking is lowered in a separate pass, so
		// the checker never rewrites a node's kind in place.
		var lower_p = LoweringPass(body_p.symtab, body_p.arena, decl_p);
		lower_p.lower_program(prog);

		if (!self.quiet) println("[4/4] Generating C99 code...");
		var codegen = CCodeGen(&lower_p.symtab);
		val c_code = codegen.gen_program(prog);

		if (self.only_emit_c) {
			val emit_p = Path(self.emit_c_path);
			val ok = emit_p.write_text(c_code);
			if (!ok) {
				println("Error: Failed to write output file: ${self.emit_c_path}");
				return 1;
			}
			if (!self.quiet) println("[SUCCESS] C99 source written to ${self.emit_c_path}");
			return 0;
		}

		// Native binary compilation
		var out_path = self.output_bin;
		if (out_path.empty()) out_path = "${input_path.strip_kb()}.exe";

		val out_p = Path(out_path);
		val out_dir = out_p.parent();
		if (!out_dir.empty() && !out_dir.exists()) out_dir.create_dir_all();

		val build_dir = Path("build");
		if (!build_dir.exists()) build_dir.create_dir_all();

		val base_name = out_p.file_name();
		val c_tmp_p = build_dir.join("${base_name}.tmp.c");
		val obj_tmp_p = build_dir.join("${base_name}.tmp.obj");
		val stage_p = Path("${out_path}.new");
		if (stage_p.exists()) stage_p.remove();

		val write_ok = c_tmp_p.write_text(c_code);
		if (!write_ok) {
			println("Error: Failed to write temporary C file: ${c_tmp_p.raw}");
			return 1;
		}

		if (!self.quiet) println("[BUILDING] Invoking backend compiler (${self.c_compiler})...");

		// Build to a staging path: a failed backend must never remove the working
		// executable, and the linker must not have to overwrite a running image.
		var compile_cmd = c_compile_cmd(c_tmp_p.raw, stage_p.raw, self.c_compiler, self.quiet);

		val exit_code = Process.exec(compile_cmd);
		if (exit_code != 0 || !stage_p.exists()) {
			stage_p.remove();
			if (exit_code != 0) {
				println("Error: Backend C compiler failed with exit code ${exit_code}:");
			} else {
				println("Error: Backend C compiler produced no executable: ${stage_p.raw}");
			}
			println("  cmd was '${compile_cmd}'");
			return if (exit_code != 0) exit_code else 1;
		}

		// Swap the new binary in. `<out>.old` is only a parking spot for the
		// previous image; if the swap fails the old executable is restored.
		val old_p = Path("${out_path}.old");
		if (out_p.exists()) {
			if (old_p.exists()) old_p.remove();
			out_p.rename_to(old_p);
		}
		if (!stage_p.rename_to(out_p)) {
			if (old_p.exists() && !out_p.exists()) old_p.rename_to(out_p);
			println("Error: Could not move the new executable into place: ${out_path}");
			return 1;
		}

		c_tmp_p.remove();
		obj_tmp_p.remove();
		old_p.remove();

		if (!self.quiet) println("[SUCCESS] Executable created: ${out_path}");
		return 0;
	}

}
