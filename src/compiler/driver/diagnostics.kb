mod compiler.driver;

use std.io.*;
use std.filesystem.*;
use std.collections.*;

use compiler.core.Severity;
use compiler.core.Diagnostic;
use compiler.loader.ModuleLoader;

/*
 * ============================================================================
 * compiler.driver.diagnostics — Driver diagnostic rendering
 *
 * Every pass emits `Diagnostic` records directly (span + module/path + message);
 * this module resolves a module name or an empty path to a real file path,
 * deduplicates, and renders with a source snippet.
 * ============================================================================
 */

fn resolve_file_path(target: str, default_file: str, loader: ?*ModuleLoader): str {
	if (target.empty()) return default_file;

	if (
		target.ends_with(".kb")
		|| "/" in target
		|| "\\" in target
	) return target.to_posix_path();

	if (loader != null) {
		val resolved = loader.find_module(target);
		if (resolved.found) return resolved.path.to_posix_path();
	}

	val rel = "${target.module_to_rel()}.kb";
	val src_p = Path("src/${rel}");
	if (src_p.exists()) return "src/${rel}";

	val lib_p = Path("lib/${rel}");
	if (lib_p.exists()) return "lib/${rel}";

	val rel_p = Path(rel);
	if (rel_p.exists()) return rel;

	return target;
}

pub fn print_diagnostics(diags: List<Diagnostic>, default_file: str, loader: ?*ModuleLoader = null) {
	var seen = HashSet<str>();
	defer seen.free();

	var printed_count = 0;
	val src_map = if (loader != null) &loader.sources else null;

	for (d in diags) {
		var diag = d;
		if (diag.file_id > 0 && loader != null) {
			val sf = loader.sources.get_file(diag.file_id);
			if (sf != null) diag.file_path = sf.path;
		}
		diag.file_path = resolve_file_path(diag.file_path, default_file, loader);
		val key = diag.key();
		if (key in seen) continue;
		seen += key;

		print(diag.render(src_map));
		println("");
		printed_count++;
	}

	val summary = "\x1b[1;31merror\x1b[0m: could not compile '${default_file}'"
		" due to ${printed_count} previous error(s)";
	println(summary);
}

pub fn print_warnings(warnings: List<Diagnostic>, default_file: str, loader: ?*ModuleLoader = null) {
	var seen = HashSet<str>();
	defer seen.free();

	val src_map = if (loader != null) &loader.sources else null;

	for (w in warnings) {
		var diag = w;
		if (diag.file_id > 0 && loader != null) {
			val sf = loader.sources.get_file(diag.file_id);
			if (sf != null) diag.file_path = sf.path;
		}
		diag.file_path = resolve_file_path(diag.file_path, default_file, loader);
		val key = diag.key();
		if (key in seen) continue;
		seen += key;

		print(diag.render(src_map));
		println("");
	}
}
