mod compiler.driver;

use std.io.*;
use std.filesystem.*;
use std.collections.*;


use compiler.core.Span;
use compiler.core.Severity;
use compiler.core.Diagnostic as CoreDiagnostic;
use compiler.loader.ModuleLoader;

/*
 * ============================================================================
 * compiler.driver.diagnostics — Driver diagnostic bridge
 *
 * Bridges legacy `List<str>` pass error lists and `ModuleLoader` module paths
 * into `compiler.core.Diagnostic` rendering.
 * ============================================================================
 */

fn resolve_file_path(target: str, default_file: str, loader: *ModuleLoader?): str {
	if (target.empty()) {
		return default_file;
	}
	if (target.ends_with(".kb") || "/" in target || "\\" in target) {
		return target.to_posix_path();
	}

	if (loader != null) {
		val resolved = loader.find_module(target);
		if (resolved.found) {
			return resolved.path.to_posix_path();
		}
	}

	val rel = "${target.module_to_rel()}.kb";
	if (File.exists("src/${rel}")) {
		return "src/${rel}";
	}
	if (File.exists("lib/${rel}")) {
		return "lib/${rel}";
	}
	if (File.exists(rel)) {
		return rel;
	}

	return target;
}

pub fn print_diagnostics(errors: List<str>, default_file: str, loader: *ModuleLoader? = null) {
	var seen = HashSet<str>();
	defer seen.free();
	var printed_count: usz = 0;

	for (err in errors) {
		var diag = CoreDiagnostic.parse_legacy(err, default_file, Severity.ERROR, null);
		diag.file_path = resolve_file_path(diag.file_path, default_file, loader);
		val key = diag.key();
		if (key in seen) {
			continue;
		}
		seen += key;

		print(diag.render());
		println("");
		printed_count++;
	}

	println("\x1b[1;31merror\x1b[0m: could not compile '${default_file}' due to ${printed_count} previous error(s)");
}

pub fn print_warnings(warnings: List<str>, default_file: str, loader: *ModuleLoader? = null) {
	var seen = HashSet<str>();
	defer seen.free();

	for (w in warnings) {
		var diag = CoreDiagnostic.parse_legacy(w, default_file, Severity.WARNING, null);
		diag.file_path = resolve_file_path(diag.file_path, default_file, loader);
		val key = diag.key();
		if (key in seen) {
			continue;
		}
		seen += key;

		print(diag.render());
		println("");
	}
}
