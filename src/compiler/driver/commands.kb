mod compiler.driver;

use std.io.*;
use std.filesystem.*;
use std.process.*;
use std.system.*;
use std.collections.*;

use compiler.core.*;

use config.*;

// ============================================================================
// Native Project Commands: build, run, test
// ============================================================================

fn str_before(a: str, b: str): bool {
	val min_len = if (a.len < b.len) a.len else b.len;
	for (i in 0..<min_len) {
		if (a[i] < b[i]) return true;
		if (a[i] > b[i]) return false;
	}
	return a.len < b.len;
}

pub fn collect_kb_files(dir: str, prefix: str, var out: &List<str>) {
	val dir_p = Path(dir);
	val entries = dir_p.list_dir();
	defer entries.free();

	if (entries.empty()) return;

	var sorted = List<str>();
	defer sorted.free();

	for (e in entries) sorted += e;
	for (i in 0..<sorted.len) {
		for (j in (i + 1)..<sorted.len) {
			if (str_before(sorted[j], sorted[i])) {
				val tmp = sorted[i];
				sorted[i] = sorted[j];
				sorted[j] = tmp;
			}
		}
	}

	for (e in sorted) {
		val full_p = dir_p.join(e);
		if (e.ends_with(".kb")) {
			if (prefix.empty() || e.starts_with(prefix)) out += full_p.to_posix_path().raw;
		} else if (!("." in e)) {
			collect_kb_files(full_p.raw, prefix, out);
		}
	}
}

pub fn compute_project_stamp(cfg: ProjectConfig, manifest_path: str): str {
	val man_p = Path(manifest_path);
	var stamp_seed = man_p.read_text();
	val entry_p = Path(cfg.entry);
	val entry_dir = entry_p.parent();
	val root_dir = if (!entry_dir.empty()) entry_dir.raw else "src";

	var files = List<str>();
	defer files.free();
	collect_kb_files(root_dir, "", &files);
	if (!files.empty()) {
		for (fpath in files) {
			val fp = Path(fpath);
			val content = fp.read_text();
			stamp_seed = "${stamp_seed}:${content.hash_stamp()}";
		}
	} else {
		val entry_p = Path(cfg.entry);
		stamp_seed += entry_p.read_text();
	}

	return stamp_seed.hash_stamp();
}

pub fn cmd_build(manifest_path: str): i32 {
	val man_p = Path(manifest_path);
	if (!man_p.exists()) {
		println("Error: Project manifest '${manifest_path}' not found.");
		return 1;
	}

	val cfg = ProjectConfig(manifest_path);
	println("Building ${cfg.name} v${cfg.version} [${cfg.entry} -> ${cfg.output}]...");

	var opts = CompileOptions();
	opts.input_path = cfg.entry;
	opts.output_bin = cfg.output;
	opts.c_compiler = cfg.cc;

	val exit_code = opts.compile();
	if (exit_code == 0) {
		val build_dir = Path("build");
		if (!build_dir.exists()) build_dir.create_dir_all();
		val stamp_p = build_dir.join(".kobel_stamp");
		val stamp = compute_project_stamp(cfg, manifest_path);
		stamp_p.write_text(stamp);
		println("[SUCCESS] Build complete: ${cfg.output}");
	}
	return exit_code;
}

pub fn cmd_run(manifest_path: str, extra_args: List<str>): i32 {
	val man_p = Path(manifest_path);
	if (!man_p.exists()) {
		println("Error: Project manifest '${manifest_path}' not found.");
		return 1;
	}

	val cfg = ProjectConfig(manifest_path);
	val build_dir = Path("build");
	if (!build_dir.exists()) build_dir.create_dir_all();
	val stamp_p = build_dir.join(".kobel_stamp");
	val current_stamp = compute_project_stamp(cfg, manifest_path);

	val out_p = Path(cfg.output);
	var needs_build = when {
		!out_p.exists() -> {
			println("Target '${cfg.output}' not found. Building first...");
			yield true;
		}
		!stamp_p.exists() -> {
			println("No previous build stamp found. Rebuilding...");
			yield true;
		}
		else -> {
			val saved_stamp = stamp_p.read_text().trim();
			if (saved_stamp != current_stamp) {
				println("Source changes detected. Rebuilding...");
				yield true;
			}
			yield false;
		}
	};

	if (needs_build) {
		val build_code = cmd_build(manifest_path);
		if (build_code != 0) {
			println("Build failed with code ${build_code}. Aborting run.");
			return build_code;
		}
	} else println("No changes detected. Running '${cfg.output}'...");

	// Prepare run command safely without triggering Windows cmd /c quote stripping
	var out_bin = if (System.is_windows()) cfg.output.to_win_path()
				else cfg.output.to_posix_path();

	if (
		System.is_windows()
		&& !out_bin.starts_with(".")
		&& !out_bin.starts_with("\\")
		&& out_bin.index_of(":") < 0
	) out_bin = ".\\${out_bin}";
	else if (
		!out_bin.starts_with(".")
		&& !out_bin.starts_with("/")
	) out_bin = "./${out_bin}";

	var run_cmd = if (" " in out_bin) "\"${out_bin}\"" else out_bin;
	for (arg in extra_args) {
		run_cmd = if (" " in arg) "${run_cmd} \"${arg}\""
		else "${run_cmd} ${arg}";
	}

	return Process.exec(run_cmd);
}

pub fn discover_test_files(test_dir: str): List<str> {
	var list = List<str>();
	collect_kb_files(test_dir, "test_", &list);
	return list;
}

pub fn cmd_test(manifest_path: str, filter: str): i32 {
	val man_p = Path(manifest_path);
	val cfg = if (man_p.exists()) ProjectConfig(manifest_path)
			else ProjectConfig();

	val all_tests = discover_test_files(cfg.test_dir);
	var active_tests = List<str>();

	for (t in all_tests) if (
		filter.empty() ||
		filter in t
	) active_tests += t;

	println("============================================================");
	if (filter.empty()) println("  Running Kobel Test Suite (${active_tests.len} tests)");
	else println("  Running Kobel Test Suite (filter: '${filter}', ${active_tests.len} tests)");
	println("============================================================");

	if (active_tests.empty()) {
		println("No tests matched filter '${filter}'.");
		return 0;
	}

	var pass_count = 0;
	var fail_count = 0;
	var failed_names = List<str>();

	val build_dir = Path("build");
	if (!build_dir.exists()) build_dir.create_dir_all();

	for (tpath in active_tests) {
		print("[*] ${tpath} ... ");

		val test_p = Path(tpath);
		val test_name = test_p.stem();
		val test_bin_p = build_dir.join("${test_name}.test_bin.exe");
		var opts = CompileOptions();
		opts.input_path = tpath;
		opts.output_bin = test_bin_p.raw;
		opts.c_compiler = cfg.cc;
		opts.quiet = true;
		// Shared fixtures live under `tests/testsupport`, importable as
		// `testsupport.*` from every suite.
		opts.extra_roots += cfg.test_dir;

		val compile_res = opts.compile();
		if (compile_res != 0) {
			println("FAIL (compilation error)");
			fail_count++;
			failed_names += tpath;
			continue;
		}

		var run_cmd = "";
		if (System.is_windows()) {
			val win_bin = test_bin_p.to_win_path().raw;
			run_cmd = if (" " in win_bin) "\"${win_bin}\" >nul 2>nul" else "${win_bin} >nul 2>nul";
		} else {
			var posix_bin = test_bin_p.to_posix_path().raw;
			if (!posix_bin.starts_with(".") && !posix_bin.starts_with("/")) posix_bin = "./${posix_bin}";
			val bin_str = if (" " in posix_bin) "\"${posix_bin}\"" else posix_bin;
			run_cmd = "${bin_str} >/dev/null 2>&1";
		}
		val test_res = Process.exec(run_cmd);

		// Clean up the temporary test binary
		test_bin_p.remove();

		if (test_res == 0) {
			println("PASS");
			pass_count++;
		} else {
			println("FAIL (exit code ${test_res})");
			fail_count++;
			failed_names += tpath;
		}
	}

	println("""
		============================================================
		                      TEST SUMMARY                          
		============================================================
		Passed: ${pass_count}
		Failed: ${fail_count}
		Total:  ${active_tests.len}
	""");

	if (fail_count > 0) {
		println("");
		println("[ERROR] The following tests failed:");
		for (name in failed_names) println("  - ${name}");
		return 1;
	}

	println("");
	println("[SUCCESS] All tests passed successfully!");
	return 0;
}

// ============================================================================
// Snapshot & Fixpoint Gates
//
// `snap` pins the C emitted for the compiler source and the test corpus: any
// change in semantic analysis or codegen shows up as a digest diff instead of
// leaking into a binary that happens to still pass its own tests.
//
// `fixpoint` pins self-hosting: the compiler rebuilt from its own C output must
// emit byte-identical C. This is the bootstrap contract from docs/architecture.md.
// ============================================================================

// Snapshot corpus: every behavioural test plus the compiler itself.
pub fn snap_corpus(test_dir: str): List<str> {
	var corpus = discover_test_files(test_dir);
	corpus += "src/main.kb";
	return corpus;
}

// Flat name for a source path: `tests/unit/test_lexer.kb` becomes
// `tests_unit_test_lexer_kb`, so goldens stay one file per entry.
pub fn snap_name(path: str): str {
	var out = "";
	for (c in path) {
		if (c == '/' || c == '\\' || c == '.') out += "_";
		else out += "${c}";
	}
	return out;
}

/*
 * Feature tests keep the emitted C text, so a codegen change is reviewable as a
 * git diff. Entries that pull in the compiler modules (the unit suites and the
 * compiler itself) emit megabytes of C; those stay as a digest to keep the
 * repository small while still pinning the output.
 */
pub fn snapshot_as_text(src: str): bool => src.starts_with("tests/features/");

pub fn cmd_snap(manifest_path: str, update: bool): i32 {
	val man_p = Path(manifest_path);
	val cfg = if (man_p.exists()) ProjectConfig(manifest_path) else ProjectConfig();
	val golden_dir = Path("tests/golden");
	val tmp_dir = Path("build/snap");
	if (!golden_dir.exists()) golden_dir.create_dir_all();
	if (!tmp_dir.exists()) tmp_dir.create_dir_all();

	val corpus = snap_corpus(cfg.test_dir);
	println("============================================================");
	if (update) println("  Updating C snapshots (${corpus.len} sources)");
	else println("  Checking C snapshots (${corpus.len} sources)");
	println("============================================================");

	var fail_count = 0;
	for (src in corpus) {
		print("[*] ${src} ... ");
		val flat = snap_name(src);
		val c_p = tmp_dir.join("${flat}.c");

		var opts = CompileOptions();
		opts.input_path = src;
		opts.emit_c_path = c_p.raw;
		opts.only_emit_c = true;
		opts.quiet = true;
		opts.extra_roots += cfg.test_dir;
		if (opts.compile() != 0) {
			println("FAIL (emit-c error)");
			fail_count++;
			continue;
		}

		val c_text = c_p.read_text();
		val digest = c_text.hash_stamp();
		val as_text = snapshot_as_text(src);
		val golden_txt_p = golden_dir.join("${flat}.txt");
		val golden_c_p = golden_dir.join("${flat}.c");
		val golden_p = if (as_text) golden_c_p else golden_txt_p;

		if (update) {
			if (as_text) {
				golden_c_p.write_text(c_text);
				if (golden_txt_p.exists()) golden_txt_p.remove();
			} else {
				golden_txt_p.write_text("${digest}\n");
				if (golden_c_p.exists()) golden_c_p.remove();
			}
			println("UPDATED");
			continue;
		}

		if (!golden_p.exists()) {
			println("FAIL (missing golden; run 'kobel snap --update')");
			fail_count++;
			continue;
		}

		val expected = if (as_text) golden_c_p.read_text() else golden_txt_p.read_text().trim();
		val actual = if (as_text) c_text else digest;
		if (expected == actual) println("PASS");
		else {
			println("FAIL");
			if (as_text) println("    ${src} C output differs from ${golden_c_p.raw}");
			else {
				println("    expected ${expected}");
				println("    actual   ${actual}");
			}
			fail_count++;
		}
	}

	println("------------------------------------------------------------");
	if (fail_count > 0) {
		println("[ERROR] ${fail_count} snapshot(s) changed. "
			"If the change is intended, run 'kobel snap --update' and commit tests/golden.");
		return 1;
	}
	println("[SUCCESS] All ${corpus.len} snapshots match.");
	return 0;
}

pub fn cmd_fixpoint(manifest_path: str): i32 {
	val man_p = Path(manifest_path);
	val cfg = if (man_p.exists()) ProjectConfig(manifest_path) else ProjectConfig();
	val dir = Path("build/fixpoint");
	if (!dir.exists()) dir.create_dir_all();

	val s1_p = dir.join("stage1.c");
	val s2_p = dir.join("stage2.c");
	val s2_exe_p = dir.join("kobel_v2.exe");

	println("[1/3] Emitting C from the current compiler...");
	var opts = CompileOptions();
	opts.input_path = cfg.entry;
	opts.emit_c_path = s1_p.raw;
	opts.only_emit_c = true;
	opts.quiet = true;
	if (opts.compile() != 0) {
		println("[ERROR] Could not emit C for '${cfg.entry}'.");
		return 1;
	}

	println("[2/3] Building the second-generation compiler...");
	s2_exe_p.remove();
	val compile_res = Process.exec(c_compile_cmd(s1_p.raw, s2_exe_p.raw, cfg.cc, true));
	if (compile_res != 0 || !s2_exe_p.exists()) {
		println("[ERROR] Backend compiler did not produce '${s2_exe_p.raw}'.");
		return 1;
	}

	println("[3/3] Re-emitting C with the second-generation compiler...");
	var run_exe = if (System.is_windows()) s2_exe_p.to_win_path().raw else s2_exe_p.to_posix_path().raw;
	if (!System.is_windows() && !run_exe.starts_with(".") && !run_exe.starts_with("/")) {
		run_exe = "./${run_exe}";
	}
	if (" " in run_exe) run_exe = "\"${run_exe}\"";
	val exit_code = Process.exec("${run_exe} ${cfg.entry} -emit-c ${s2_p.raw}");
	if (exit_code != 0) {
		println("[ERROR] Second-generation compiler failed (exit ${exit_code}).");
		return 1;
	}

	val first = s1_p.read_text();
	val second = s2_p.read_text();
	if (first == second) {
		println("[SUCCESS] Fixpoint reached: stage1.c == stage2.c (${first.len} bytes).");
		return 0;
	}

	println("[ERROR] Fixpoint broken: stage1.c (${first.len} bytes) != "
		"stage2.c (${second.len} bytes).");
	val a_lines = first.split_lines();
	val b_lines = second.split_lines();
	var i: usz = 0;
	while (i < a_lines.len && i < b_lines.len && a_lines[i] == b_lines[i]) i++;
	println("  First difference at line ${i + 1}:");
	if (i < a_lines.len) println("    stage1: ${a_lines[i]}");
	if (i < b_lines.len) println("    stage2: ${b_lines[i]}");
	return 1;
}
