mod compiler.driver.commands;

use std.io.*;
use std.sys.exec;
use std.collections.list.*;

use util.strutil.*;

use config.project.*;

use compiler.driver.pipeline.*;

// ============================================================================
// Native Project Commands: build, run, test
// ============================================================================

pub fn compute_project_stamp(cfg: ProjectConfig, manifest_path: str): str {
	var stamp_seed = read_file(manifest_path);
	val stamp_dir = cfg.output.dir_of();
	val build_dir = if (!stamp_dir.empty()) stamp_dir else "build";
	if (!file_exists(build_dir)) exec("cmd /c mkdir \"${build_dir.to_win_path()}\" >nul 2>nul");

	val tmp_file = "${build_dir}/.kobel_src_files.tmp";
	val entry_dir = cfg.entry.dir_of();
	val root_dir = if (!entry_dir.empty()) entry_dir else "src";
	val find_cmd = "cmd /c dir /b /s \"${root_dir.to_win_path()}\\*.kb\" > \"${tmp_file.to_win_path()}\" 2>nul";
	exec(find_cmd);

	if (file_exists(tmp_file)) {
		val file_list = read_file(tmp_file);
		exec("del /f /q \"${tmp_file.to_win_path()}\" >nul 2>nul");
		val lines = file_list.split_lines();
		for (line in lines) {
			val fpath = line.trim();
			if (!fpath.empty() && file_exists(fpath)) {
				val content = read_file(fpath);
				stamp_seed = "${stamp_seed}:${content.hash_stamp()}";
			}
		}
	} else stamp_seed += read_file(cfg.entry);

	return stamp_seed.hash_stamp();
}

pub fn cmd_build(manifest_path: str): i32 {
	if (!file_exists(manifest_path)) {
		println("Error: Project manifest '${manifest_path}' not found.");
		return 1;
	}

	val cfg = ProjectConfig(manifest_path);
	println("Building ${cfg.name} v${cfg.version} [${cfg.entry} -> ${cfg.output}]...");

	val opts = CompileOptions();
	opts.input_path = cfg.entry;
	opts.output_bin = cfg.output;
	opts.c_compiler = cfg.cc;

	val exit_code = opts.compile();
	if (exit_code == 0) {
		val stamp_dir = cfg.output.dir_of();
		val build_dir = if (!stamp_dir.empty()) stamp_dir else "build";
		val stamp_file = "${build_dir}/.kobel_stamp";
		val stamp = compute_project_stamp(cfg, manifest_path);
		write_file(stamp_file, stamp);
		println("[SUCCESS] Build complete: ${cfg.output}");
	}
	return exit_code;
}

pub fn cmd_run(manifest_path: str, extra_args: List<str>): i32 {
	if (!file_exists(manifest_path)) {
		println("Error: Project manifest '${manifest_path}' not found.");
		return 1;
	}

	val cfg = ProjectConfig(manifest_path);
	val stamp_dir = cfg.output.dir_of();
	val build_dir = if (!stamp_dir.empty()) stamp_dir else "build";
	val stamp_file = "${build_dir}/.kobel_stamp";
	val current_stamp = compute_project_stamp(cfg, manifest_path);

	var needs_build = when {
		!file_exists(cfg.output) -> {
			println("Target '${cfg.output}' not found. Building first...");
			yield true;
		}
		!file_exists(stamp_file) -> {
			println("No previous build stamp found. Rebuilding...");
			yield true;
		}
		else -> {
			val saved_stamp = read_file(stamp_file).trim();
			if (saved_stamp != current_stamp) {
				println("Source changes detected. Rebuilding...");
				yield true;
			}
			yield false;
		}
	};

	if (needs_build) {
		val build_code = cmd_build(manifest_path);
		if (build_code != 0) {
			println("Build failed with code ${build_code}. Aborting run.");
			return build_code;
		}
	} else println("No changes detected. Running '${cfg.output}'...");

	// Prepare run command safely without trigger Windows cmd /c quote stripping
	var out_bin = cfg.output.to_win_path();
	if (
		!out_bin.starts_with(".") &&
		!out_bin.starts_with("\\") &&
		out_bin.index_of(":") < 0
	) out_bin = ".\\${out_bin}";

	var run_cmd = if (out_bin.contains(" ")) "\"${out_bin}\"" else out_bin;
	for (arg in extra_args) {
		run_cmd = if (arg.contains(" ")) "${run_cmd} \"${arg}\""
		else "${run_cmd} ${arg}";
	}

	return exec(run_cmd);
}

pub fn discover_test_files(test_dir: str): List<str> {
	val list = List<str>();
	if (!file_exists("build")) exec("cmd /c mkdir build >nul 2>nul");
	val tmp_list_file = "build/.kobel_test_list.tmp";
	val find_cmd = "cmd /c dir /b /s \"${test_dir.to_win_path()}\\test_*.kb\" > \"${tmp_list_file}\" 2>nul";
	exec(find_cmd);

	if (file_exists(tmp_list_file)) {
		val content = read_file(tmp_list_file);
		exec("del /f /q \"${tmp_list_file}\" >nul 2>nul");
		val lines = content.split_lines();
		val search_token = "/${test_dir}/";
		for (line in lines) {
			val trimmed = line.trim();
			if (!trimmed.empty()) {
				var normalized = trimmed.to_posix_path();
				val tests_idx = normalized.index_of(search_token);
				if (tests_idx >= 0) normalized = normalized.slice(tests_idx + 1, normalized.len);
				list.add(normalized);
			}
		}
	}

	return list;
}

pub fn cmd_test(manifest_path: str, filter: str): i32 {
	val cfg = if (file_exists(manifest_path)) ProjectConfig(manifest_path) else ProjectConfig();
	val all_tests = discover_test_files(cfg.test_dir);
	val active_tests = List<str>();

	for (t in all_tests) if (
		filter.empty() ||
		t.contains(filter)
	) active_tests.add(t);

	println("============================================================");
	if (filter.empty()) println("  Running Kobel Test Suite (${active_tests.len} tests)");
	else println("  Running Kobel Test Suite (filter: '${filter}', ${active_tests.len} tests)");
	println("============================================================");

	if (active_tests.empty()) {
		println("No tests matched filter '${filter}'.");
		return 0;
	}

	var pass_count = 0;
	var fail_count = 0;
	val failed_names = List<str>();

	if (!file_exists("build")) exec("cmd /c mkdir build >nul 2>nul");

	for (tpath in active_tests) {
		print("[*] ${tpath} ... ");

		val test_name = tpath.strip_kb().base_name();
		val test_bin = "build/${test_name}.test_bin.exe";
		val opts = CompileOptions();
		opts.input_path = tpath;
		opts.output_bin = test_bin;
		opts.c_compiler = cfg.cc;
		opts.quiet = true;

		val compile_res = opts.compile();
		if (compile_res != 0) {
			println("FAIL (compilation error)");
			fail_count++;
			failed_names.add(tpath);
			continue;
		}

		val win_bin = test_bin.to_win_path();
		val run_cmd = if (win_bin.contains(" ")) "\"${win_bin}\" >nul 2>nul" else "${win_bin} >nul 2>nul";
		val test_res = exec(run_cmd);

		// Clean up the temporary test binary
		val del_cmd = "del /f /q \"${win_bin}\" >nul 2>nul";
		exec(del_cmd);

		if (test_res == 0) {
			println("PASS");
			pass_count++;
		} else {
			println("FAIL (exit code ${test_res})");
			fail_count++;
			failed_names.add(tpath);
		}
	}

	println("");
	println("============================================================");
	println("                      TEST SUMMARY                          ");
	println("============================================================");
	println("Passed: ${pass_count}");
	println("Failed: ${fail_count}");
	println("Total:  ${active_tests.len}");

	if (fail_count > 0) {
		println("");
		println("[ERROR] The following tests failed:");
		for (name in failed_names) println("  - ${name}");
		return 1;
	}

	println("");
	println("[SUCCESS] All tests passed successfully!");
	return 0;
}
