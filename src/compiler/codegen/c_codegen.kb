mod compiler.codegen.c_codegen;

use std.str.*;
use std.collections.list.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

// ============================================================================
// C99 Backend Code Generator
// ============================================================================

pub struct CCodeGen {
	pub indent_level: usz = 0,
	pub struct_names: List<str> = List<str>(),
	pub pointer_vars: List<str> = List<str>(),
	pub str_vars: List<str> = List<str>(),
	pub fn_names: List<str> = List<str>(),
	pub fn_ret_types: List<str> = List<str>(),
	pub errors: List<str> = List<str>(),
	// C element type for the array literal being emitted, when the surrounding
	// declaration already knows it (`val a: [T; N] = [...]`).
	pub array_elem_hint: str = "",
	pub yield_target: str = "",
	pub is_yield_return: bool = false,
	pub current_fn_ret_type: str = ""
}

impl CCodeGen {

	pub fn is_pointer_var(val self, name: str) => name.in_list(self.pointer_vars);

	pub fn is_str_var(val self, name: str) => name.in_list(self.str_vars);

	pub fn lookup_fn_ret_type(val self, name: str): str {
		val idx = name.index_in_list(self.fn_names);
		if (idx >= 0) return self.fn_ret_types[idx];
		return "";
	}

	pub fn register_fn(var self, name: str, ret_type: str) {
		self.fn_names.add(name);
		self.fn_ret_types.add(ret_type);
	}

}

pub fn get_indent(level: usz) => "    ".repeat(level);

// ============================================================================
// Type Mapping (Kobel -> C99 Standard Types)
// ============================================================================

pub fn c_type_from_ast(node: *AstNode): str {
	if (node == null) return "void";

	return when (node) {
		is NamedType as named -> {
			val name = named.name;

			yield when (name) {
				"none" -> "void";
				"bool" -> "bool";
				"char" -> "char";
				"i8" -> "int8_t";
				"i16" -> "int16_t";
				"i32" -> "int32_t";
				"i64" -> "int64_t";
				"isz" -> "intptr_t";
				"u8" -> "uint8_t";
				"u16" -> "uint16_t";
				"u32" -> "uint32_t";
				"u64" -> "uint64_t";
				"usz" -> "size_t";
				"f32" -> "float";
				"f64" -> "double";
				"str" -> "const char*";
				else -> name;
			};
		}

		is PointerType as ptr -> {
			val sub = c_type_from_ast(ptr.pointee);
			if (ptr.is_mut) return sub + "*";

			val pointee = ptr.pointee;
			if (pointee is NamedType as named) {
				// `str` and `*char` stay const so string literals and `.c_str()`
				// results can be passed. Other read-only pointers are emitted as
				// plain pointers: the language does not enforce const-correctness
				// and the compiler's own source writes through `*T`.
				if (named.name == "str") yield "${sub}*";
				if (named.name == "char") yield "const ${sub}*";
			}

			yield "${sub}*";
		}

		is ArrayType as arr -> {
			val sub = c_type_from_ast(arr.element_type);
			yield "${sub}*";
		}

		is NullableType as null_t ->  c_type_from_ast(null_t.inner);

		else -> "void*";
	};
}

pub fn c_format_int_literal(raw: str): str {
	// The suffix is stripped through `num_suffix` so a hex digit is never taken for
	// one: `0xBB` stays 187 instead of becoming `0xB` with an i8 suffix. The `_`
	// digit separators are not C syntax, so they go too.
	val sfx = raw.num_suffix();
	val body = raw.strip_suffix(sfx.len).strip_char('_');
	return when (sfx) {
		// signed integer
		"Z" -> "((intptr_t)${body}LL)";
		"L" -> "${body}LL";
		"S" -> "((int16_t)${body})";
		"B" -> "((int8_t)${body})";

		// unsigned integer
		"U" -> "${body}U";
		"UZ" -> "((size_t)${body}ULL)";
		"UL" -> "${body}ULL";
		"UB" -> "((uint8_t)${body})";
		"US" -> "((uint16_t)${body})";
		else -> body
	};
}

pub fn c_int_literal_c_type(raw: str) => when (raw.num_suffix()) {
	// signed integer
	"Z" -> "intptr_t";
	"L" -> "int64_t";
	"S" -> "int16_t";
	"B" -> "int8_t";

	// unsigned integer
	"U" -> "uint32_t";
	"UZ" -> "size_t";
	"UL" -> "uint64_t";
	"US" -> "uint16_t";
	"UB" -> "uint8_t";
	else -> "int32_t"
};

pub fn c_float_literal_c_type(raw: str) => if (raw.ends_with("F")) "float" else "double";

pub fn c_format_float_literal(raw: str): str {
	// `_` digit separators are not C syntax, so they are dropped first.
	val text = raw.strip_char('_');
	var has_dot = false;
	for (c in text) {
		if (c == '.' || c == 'e' || c == 'E') {
			has_dot = true;
			break;
		}
	}
	if (has_dot) return text;

	val len = text.len;
	return when {
		text.ends_with("F") -> "${text.slice(0, len - 1)}.0f";
		text.ends_with("D") -> "${text.slice(0, len - 1)}.0";
		else -> "${text}.0"
	};
}

// ============================================================================
// Expression Code Generation
// ============================================================================

pub fn expr_needs_parens_for_member(node: *AstNode): bool {
	if (node == null) return false;
	return when (node.kind) {
		NodeKind.EXPR_IDENTIFIER,
		NodeKind.EXPR_MEMBER,
		NodeKind.EXPR_CALL,
		NodeKind.EXPR_INDEX,
		NodeKind.EXPR_GROUP -> false;
		else -> true;
	};
}

impl CCodeGen {

	pub fn gen_expr(var self, node: *AstNode): str {
		if (node == null) return "";

		when (node) {
			is LiteralExpr as lit -> { return self.gen_literal_expr(lit); }

			is IdentifierExpr as id -> return id.name;

			is GroupExpr as g -> {
				val inner = self.gen_expr(g.expr);
				if (g.expr != null) {
					if (g.expr.kind == NodeKind.EXPR_BINARY || g.expr.kind == NodeKind.EXPR_GROUP) {
						return inner;
					}
				}
				return "(${inner})";
			}

			is BinaryExpr as bin -> { return self.gen_binary_expr(bin); }

			is UnaryExpr as un -> { return self.gen_unary_expr(un); }

			is ArrayLiteralExpr as al -> { return self.gen_array_literal_expr(al); }

			is CallExpr as call -> { return self.gen_call_expr(call); }

			is MemberExpr as mem -> { return self.gen_member_expr(mem); }

			is IndexExpr as idx -> {
				return "${self.gen_expr(idx.target)}[${self.gen_expr(idx.index)}]";
			}

			is AssignExpr as asgn -> { return self.gen_assign_expr(asgn); }

			is UpdateExpr as u -> {
				val op_str = if (u.op == TokenType.PLUS_PLUS) "++" else "--";
				return "${self.gen_expr(u.target)}${op_str}";
			}

			is CastExpr as cst -> {
				val ty = c_type_from_ast(cst.target_type);
				return "(${ty})${self.gen_expr(cst.expr)}";
			}

			is IfExpr as if_e -> {
				val cond = self.gen_expr(if_e.condition);
				val th = self.gen_expr(if_e.then_branch);
				val el = self.gen_expr(if_e.else_branch);
				return "(${cond} ? ${th} : ${el})";
			}

			is WhenExpr as we -> { return self.gen_when_expr(we); }

			is IsExpr as is_e -> return self.gen_is_expr(is_e);

			else -> return "";
		}
	}

	// Literals lower to their C spelling (ints/floats normalised, strings/chars keep quoting).
	fn gen_literal_expr(var self, lit: *LiteralExpr): str {
		return when (lit.literal_kind) {
			LiteralKind.INT -> c_format_int_literal(lit.raw_text);
			LiteralKind.FLOAT -> c_format_float_literal(lit.raw_text);
			LiteralKind.BOOL -> lit.raw_text;
			LiteralKind.STRING -> {
				if (
					lit.raw_text.len >= 2 &&
					lit.raw_text[0] == '"'
				) yield lit.raw_text;

				yield "\"${lit.raw_text}\"";
			}
			LiteralKind.CHAR -> {
				if (
					lit.raw_text.len >= 2 &&
					lit.raw_text[0] == '\''
				) yield lit.raw_text;

				yield "'${lit.raw_text}'";
			}
			LiteralKind.NULL_VAL -> "NULL";
			else -> lit.raw_text;
		};
	}

	// Binary expressions lower to a parenthesised C operator (?: for the elvis form).
	fn gen_binary_expr(var self, bin: *BinaryExpr): str {
		if (bin.op == TokenType.QUESTION_COLON) {
			val l = self.gen_expr(bin.left);
			val r = self.gen_expr(bin.right);
			return "(${l} != NULL ? ${l} : ${r})";
		}
		val l = self.gen_expr(bin.left);
		val r = self.gen_expr(bin.right);
		val op_str = when (bin.op) {
			TokenType.MINUS -> "-";
			TokenType.STAR -> "*";
			TokenType.SLASH -> "/";
			TokenType.PERCENT -> "%";
			TokenType.EQUAL_EQUAL -> "==";
			TokenType.BANG_EQUAL -> "!=";
			TokenType.LESS -> "<";
			TokenType.LESS_EQUAL -> "<=";
			TokenType.GREATER -> ">";
			TokenType.GREATER_EQUAL -> ">=";
			TokenType.AND_AND -> "&&";
			TokenType.OR_OR -> "||";
			else -> "+";
		};

		return "(${l} ${op_str} ${r})";
	}

	// Unary operators lower to a C prefix operator (- guards a negative operand).
	fn gen_unary_expr(var self, un: *UnaryExpr): str {
		val opnd = self.gen_expr(un.operand);

		return when (un.op) {
			TokenType.MINUS -> if (opnd.starts_with("-")) "- (${opnd})" else "-${opnd}",
			TokenType.BANG -> "!${opnd}",
			TokenType.STAR -> "*${opnd}",
			TokenType.AMPERSAND -> "&${opnd}",
			else -> opnd;
		};
	}

	// `[1, 2, 3]` -> a C99 compound literal, `(int32_t[]){1, 2, 3}`. It decays
	// to a pointer, which is how this backend represents an array value.
	fn gen_array_literal_expr(var self, al: *ArrayLiteralExpr): str {
		var elem_c = self.array_elem_hint;
		if (al.elem_type_node != null) elem_c = c_type_from_ast(al.elem_type_node);
		else if (elem_c.empty() && !al.elements.empty()) elem_c = self.infer_type_from_expr(al.elements.first());
		if (elem_c.empty()) elem_c = "int32_t";

		if (!al.list_struct_name.empty()) {
			if (al.elements.empty()) return "${al.list_struct_name}_from_array(NULL, 0)";
			var arr_res = "(${elem_c}[]){";
			for (i in 0..<al.elements.len) {
				if (i > 0) arr_res = "${arr_res}, ";
				arr_res = "${arr_res}${self.gen_expr(al.elements[i])}";
			}
			arr_res = "${arr_res}}";
			return "${al.list_struct_name}_from_array(${arr_res}, ${al.elements.len})";
		}

		var res = "(${elem_c}[]){";
		for (i in 0..<al.elements.len) {
			if (i > 0) res = "${res}, ";
			res = "${res}${self.gen_expr(al.elements[i])}";
		}
		return "${res}}";
	}

	// Calls lower to a C call, a struct compound literal, or an inlined string/size helper.
	fn gen_call_expr(var self, call: *CallExpr): str {
		// Static or string method call: T.size() -> sizeof(T), s.c_str() -> s
		val callee = call.callee;
		if (callee is MemberExpr as mem) {
			if (mem.member == "size") {
				val obj_name = self.gen_expr(mem.object);
				val c_type = when (obj_name) {
					"str" -> "const char*",
					"usz", "isz" -> "size_t",
					else -> obj_name
				};
				return "sizeof(${c_type})";
			}
			if (mem.member == "c_str") return self.gen_expr(mem.object);
			if (mem.member == "slice") {
				val slice_obj = self.gen_expr(mem.object);
				if (call.args.len >= 2) return "kobel_slice(${slice_obj}, "
												"${self.gen_expr(call.args.first())}, "
												"${self.gen_expr(call.args[1])})";
				if (call.args.len == 1) return "kobel_slice(${slice_obj}, "
												"${self.gen_expr(call.args.first())}, "
												"strlen(${slice_obj}))";
				return slice_obj;
			}
		}

		val callee_str = self.gen_expr(call.callee);

		// Check whether this calls a struct constructor: Point(1, 2) -> (Point){ 1, 2 }
		var is_struct = false;
		if (callee is IdentifierExpr as id) {
			is_struct = id.name.in_list(self.struct_names);
		}

		if (is_struct) {
			var res = "(${callee_str}){ ";
			for (i in 0..<call.args.len) {
				if (i > 0) res = "${res}, ";
				res = "${res}${self.gen_expr(call.args[i])}";
			}
			return "${res} }";
		}

		// Ordinary C function call: func(arg1, arg2)
		var res = "${callee_str}(";
		for (i in 0..<call.args.len) {
			if (i > 0) res = "${res}, ";
			res = "${res}${self.gen_expr(call.args[i])}";
		}
		return "${res})";
	}

	// Member access lowers to ./->; len/size on strings inlines strlen.
	fn gen_member_expr(var self, mem: *MemberExpr): str {
		val obj_node = mem.object;
		if (mem.member == "len" || mem.member == "size") {
			val is_str = when (obj_node) {
				is IdentifierExpr as id -> self.is_str_var(id.name),
				is LiteralExpr as lit -> lit.literal_kind == LiteralKind.STRING,
				else -> self.infer_type_from_expr(obj_node) == "const char*"
			};
			if (is_str) return "(uint64_t)strlen(${self.gen_expr(obj_node)})";
		}
		val obj = self.gen_expr(obj_node);
		var is_ptr = false;
		if (obj_node is IdentifierExpr as id) {
			is_ptr = self.is_pointer_var(id.name);
		}
		val obj_str = if (expr_needs_parens_for_member(obj_node)) "(${obj})" else obj;
		if (is_ptr) return "${obj_str}->${mem.member}";
		return "${obj_str}.${mem.member}";
	}

	// Assignments lower to the matching C compound-assignment operator.
	fn gen_assign_expr(var self, asgn: *AssignExpr): str {
		val op_str = when (asgn.op) {
			TokenType.PLUS_EQUAL -> "+=",
			TokenType.MINUS_EQUAL -> "-=",
			TokenType.STAR_EQUAL -> "*=",
			TokenType.SLASH_EQUAL -> "/=",
			TokenType.PERCENT_EQUAL -> "%=",
			else -> "="
		};
		return "${self.gen_expr(asgn.target)} ${op_str} ${self.gen_expr(asgn.value)}";
	}

	// when expressions lower to nested C ternaries, evaluated from the last arm back.
	fn gen_when_expr(var self, we: *WhenExpr): str {
		var cond = "";
		if (we.condition != null) cond = self.gen_expr(we.condition);
		var res = "0";
		var i = we.arms.len;
		while (i > 0) {
			i--;
			val arm = we.arms[i];
			res = if (arm.is_else) self.gen_expr(arm.body)
			else "(${self.gen_when_test(cond, arm.patterns)} ? ${self.gen_expr(arm.body)} : ${res})";
		}
		return res;
	}

	// Tag test of a smart cast. A pointer subject is compared against NULL
	// first: reading the tag would dereference it, and a null subject matches no
	// struct pattern, so the caller takes its `else` path.
	//
	// ponytail: the subject is re-evaluated for the NULL test. Safe today
	// because every subject is a plain path (`p`, `obj.field`); upgrade by
	// hoisting `void* __subj = ...;` in statement position if a call ever
	// becomes a subject.
	pub fn gen_tag_test(var self, subject: str, is_ptr: bool, tag_field: str, target_name: str): str {
		if (!is_ptr) return "${subject}.${tag_field} == ${target_name}__TAG";
		return "${subject} != NULL && ${subject}->${tag_field} == ${target_name}__TAG";
	}

	pub fn gen_is_expr(var self, is_e: *IsExpr): str {
		val obj = self.gen_expr(is_e.expr);
		val target_name = c_type_from_ast(is_e.target_type);
		var tag_field = is_e.tag_field;
		if (tag_field.empty()) tag_field = "tag";
		val obj_str = if (expr_needs_parens_for_member(is_e.expr)) "(${obj})" else obj;
		return "(${self.gen_tag_test(obj_str, is_e.is_ptr, tag_field, target_name)})";
	}

	// Builds the test expression of a `when` arm: `c == p1 || c == p2`.
	// For the boolean form (`cond` empty) each pattern is itself the test.
	// String patterns compare with strcmp since `str` lowers to `const char*`.
	pub fn gen_when_test(var self, cond: str, patterns: List<*AstNode>): str {
		var res = "";
		for (i in 0..<patterns.len) {
			val p = patterns[i];
			var test = "";
			if (cond.empty()) {
				test = self.gen_expr(p);
			} else if (p is IsExpr as is_e) {
				val target_name = c_type_from_ast(is_e.target_type);
				var tag_field = is_e.tag_field;
				if (tag_field.empty()) tag_field = "tag";
				test = self.gen_tag_test(cond, is_e.is_ptr, tag_field, target_name);
			} else if (p is LiteralExpr as lit) {
				if (lit.literal_kind == LiteralKind.STRING) {
					test = "strcmp(${cond}, ${self.gen_expr(p)}) == 0";
				} else {
					test = "${cond} == ${self.gen_expr(p)}";
				}
			} else {
				test = "${cond} == ${self.gen_expr(p)}";
			}
			res = if (i == 0) test else "${res} || ${test}";
		}
		if (res.empty()) res = "1";
		return res;
	}

	pub fn infer_type_from_expr(var self, expr: *AstNode): str {
		if (expr == null) return "int32_t";

		when (expr) {
			is LiteralExpr as lit -> {
				return when (lit.literal_kind) {
					LiteralKind.STRING -> "const char*",
					LiteralKind.CHAR -> "char",
					LiteralKind.FLOAT -> c_float_literal_c_type(lit.raw_text),
					LiteralKind.BOOL -> "bool",
					else -> c_int_literal_c_type(lit.raw_text)
				};
			}

			is IdentifierExpr as id -> {
				if (self.is_str_var(id.name)) return "const char*";
				if (self.is_pointer_var(id.name)) return "void*";
				val ret_ty = self.lookup_fn_ret_type(id.name);
				if (!ret_ty.empty()) return ret_ty;
				return "int32_t";
			}

			is CallExpr as call -> {
				val callee = call.callee;
				if (callee is MemberExpr as m) {
					return when (m.member) {
						"c_str", "slice", "data" -> "const char*";
						"len", "size", "cap" -> "size_t";
						else -> "int32_t";
					};
				}
				if (callee is IdentifierExpr as id) {
					// Runtime string helpers injected by the semantic analyzer.
					if (id.name == "kobel_concat") return "const char*";
					if (id.name == "kobel_slice") return "const char*";
					if (id.name == "kobel_streq") return "bool";
					if (id.name == "kobel_slen") return "size_t";
					if (id.name.in_list(self.struct_names)) return id.name;
					val ret_ty = self.lookup_fn_ret_type(id.name);
					if (!ret_ty.empty()) return ret_ty;
				}
				return "int32_t";
			}

			is BinaryExpr as bin -> {
				return when (bin.op) {
					TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL,
					TokenType.LESS, TokenType.LESS_EQUAL,
					TokenType.GREATER, TokenType.GREATER_EQUAL,
					TokenType.AND_AND, TokenType.OR_OR -> "bool";
					else -> self.infer_type_from_expr(bin.left);
				};
			}

			is UnaryExpr as un -> {
				return when (un.op) {
					TokenType.BANG -> "bool";
					TokenType.AMPERSAND -> {
						val sub = self.infer_type_from_expr(un.operand);
						yield sub + "*";
					}
					else -> self.infer_type_from_expr(un.operand);
				};
			}

			is GroupExpr as g -> {
				return self.infer_type_from_expr(g.expr);
			}

			is IfExpr as if_e -> {
				return self.infer_type_from_expr(if_e.then_branch);
			}

			is ArrayLiteralExpr as al -> {
				if (!al.list_struct_name.empty()) return al.list_struct_name;
				var elem_c = self.array_elem_hint;
				if (al.elem_type_node != null) elem_c = c_type_from_ast(al.elem_type_node);
				else if (elem_c.empty() && !al.elements.empty()) elem_c = self.infer_type_from_expr(al.elements.first());
				if (elem_c.empty()) elem_c = "int32_t";
				return "${elem_c}*";
			}

			is WhenExpr as we -> {
				for (arm in we.arms) {
					val arm_b = arm.body;
					if (arm_b is BlockStmt as blk) {
						for (s in blk.statements) {
							if (s is YieldStmt as ys) {
								if (ys.value != null) return self.infer_type_from_expr(ys.value);
							}
						}
					} else {
						return self.infer_type_from_expr(arm_b);
					}
				}
				return "int32_t";
			}

			is CastExpr as cst -> {
				return c_type_from_ast(cst.target_type);
			}

			is UpdateExpr as u -> {
				return self.infer_type_from_expr(u.target);
			}

			else -> {
				return "int32_t";
			}
		}

		return "int32_t";
	}

}

// ============================================================================
// Statement Code Generation
// ============================================================================

impl WhenExpr {
	pub fn has_blocks(val self): bool {
		for (arm in self.arms) {
			val arm_b = arm.body;
			if (arm_b is BlockStmt) return true;
			for (p in arm.patterns) {
				if (p is IsExpr) return true;
			}
		}
		return false;
	}
}

impl CCodeGen {

	pub fn gen_cond(var self, cond: *AstNode): str {
		val s = self.gen_expr(cond);
		if (cond != null) {
			if (cond.kind == NodeKind.EXPR_BINARY || cond.kind == NodeKind.EXPR_GROUP) {
				return s;
			}
		}
		return "(${s})";
	}

	pub fn gen_block_body(var self, node: *AstNode): str {
		if (node == null) return "";
		if (node is BlockStmt as blk) {
			var res = "";
			for (s in blk.statements) {
				res += self.gen_statement(s);
			}
			return res;
		}
		return self.gen_statement(node);
	}

	pub fn gen_statement(var self, node: *AstNode): str {
		if (node == null) return "";

		return when (node) {
			is BlockStmt as blk -> { yield self.gen_block_stmt(blk); }

			is VarDeclStmt as vd -> { yield self.gen_var_decl_stmt(vd); }

			is IfStmt as ifs -> { yield self.gen_if_stmt(ifs); }

			is WhileStmt as wh -> { yield self.gen_while_stmt(wh); }

			is ReturnStmt as ret -> { yield self.gen_return_stmt(ret); }

			is ExprStmt as es -> { yield self.gen_expr_stmt(es); }

			is BreakStmt -> "${get_indent(self.indent_level)}break;\n";

			is ContinueStmt -> "${get_indent(self.indent_level)}continue;\n";

			is YieldStmt as ys -> { yield self.gen_yield_stmt(ys); }

			is WhenStmt as ws -> { yield self.gen_when_stmt(ws); }

			else -> "";
		};
	}

	fn gen_block_stmt(var self, blk: *BlockStmt): str {
		val ind = get_indent(self.indent_level);
		var res = ind + "{\n";
		self.indent_level++;
		for (stmt in blk.statements) {
			res += self.gen_statement(stmt);
		}
		self.indent_level--;
		return res + ind + "}\n";
	}

	fn gen_var_decl_stmt(var self, vd: *VarDeclStmt): str {
		val ind = get_indent(self.indent_level);
		var ty_str = "int32_t";
		var is_ptr = false;

		var elem_hint = "";
		val t_ann = vd.type_annotation;
		if (t_ann != null) {
			ty_str = c_type_from_ast(t_ann);
			if (
				t_ann.kind == NodeKind.TYPE_POINTER ||
				t_ann.kind == NodeKind.TYPE_NULLABLE
			) is_ptr = true;

			// `[T; N]` is emitted as a pointer, and its literal needs the
			// element type spelled out.
			if (t_ann is ArrayType as arr_ast) {
				is_ptr = true;
				elem_hint = c_type_from_ast(arr_ast.element_type);
			}
		} else if (vd.initializer != null) {
			val init_e = vd.initializer;
			ty_str = self.infer_type_from_expr(init_e);
			if (init_e is CastExpr as cst) {
				val cst_ty = cst.target_type;
				if (
					cst_ty != null && (
						cst_ty.kind == NodeKind.TYPE_POINTER ||
						cst_ty.kind == NodeKind.TYPE_NULLABLE
					)
				) is_ptr = true;
			}
			if (ty_str.ends_with("*")) is_ptr = true;
		}

		if (is_ptr) self.pointer_vars.add(vd.name);
		if (ty_str == "const char*") self.str_vars.add(vd.name);

		var init_e = vd.initializer;
		while (init_e != null) {
			if (init_e is GroupExpr as g) init_e = g.expr;
			else break;
		}
		if (init_e is WhenExpr as we) {
			if (we.has_blocks()) {
				var res = "${ind}${ty_str} ${vd.name};\n";
				res = "${res}${self.gen_when_with_target(we, vd.name, false)}";
				return res;
			}
		}
		if (init_e is BinaryExpr as bin) {
			if (bin.op == TokenType.QUESTION_COLON) {
				var cur = init_e;
				var first = true;
				var res = "";
				while (cur != null) {
					while (cur != null) {
						if (cur is GroupExpr as g) cur = g.expr;
						else break;
					}
					if (cur == null) break;
					if (cur is BinaryExpr as b) {
						if (b.op == TokenType.QUESTION_COLON) {
							if (first) {
								res = "${ind}${ty_str} ${vd.name} = ${self.gen_expr(b.left)};\n";
								first = false;
							} else {
								res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(b.left)};\n";
							}
							cur = b.right;
						} else {
							res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(cur)};\n";
							break;
						}
					} else {
						val is_jump = cur.kind == NodeKind.STMT_RETURN ||
							cur.kind == NodeKind.STMT_BREAK ||
							cur.kind == NodeKind.STMT_CONTINUE;
						if (is_jump) {
							res = "${res}${ind}if (${vd.name} == NULL) {\n";
							self.indent_level++;
							res = "${res}${self.gen_statement(cur)}";
							self.indent_level--;
							res = "${res}${ind}}\n";
						} else {
							res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(cur)};\n";
						}
						break;
					}
				}
				return res;
			}
		}

		var res = "${ind}${ty_str} ${vd.name}";
		if (vd.initializer != null) {
			val saved_hint = self.array_elem_hint;
			self.array_elem_hint = elem_hint;
			res = "${res} = ${self.gen_expr(vd.initializer)}";
			self.array_elem_hint = saved_hint;
		}

		return "${res};\n";
	}

	fn gen_if_stmt(var self, ifs: *IfStmt): str {
		var cond = ifs.condition;
		while (cond != null) {
			if (cond is GroupExpr as g) cond = g.expr;
			else break;
		}

		var cast_decl = "";
		if (cond is IsExpr as is_e) {
			val e = is_e.expr;
			if (e is IdentifierExpr as id) {
				val var_name = id.name;
				cast_decl = self.gen_smart_cast_decl(is_e, var_name, self.indent_level + 1);
			}
		}

		val ind = get_indent(self.indent_level);
		var res = "${ind}if ${self.gen_cond(ifs.condition)} {\n";
		self.indent_level++;
		if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
		res = "${res}${self.gen_block_body(ifs.then_branch)}";
		self.indent_level--;

		var cur_else = ifs.else_branch;
		while (cur_else != null) {
			if (cur_else is IfStmt as elif) {
				var elif_cond = elif.condition;
				while (elif_cond != null) {
					if (elif_cond is GroupExpr as g) {
						elif_cond = g.expr;
					} else {
						break;
					}
				}
				var elif_cast = "";
				if (elif_cond is IsExpr as elif_is_e) {
					val e = elif_is_e.expr;
					if (e is IdentifierExpr as id) {
						elif_cast = self.gen_smart_cast_decl(elif_is_e, id.name, self.indent_level + 1);
					}
				}

				res = "${res}${ind}} else if ${self.gen_cond(elif.condition)} {\n";
				self.indent_level++;
				if (!elif_cast.empty()) res += get_indent(self.indent_level) + elif_cast + "\n";
				res = "${res}${self.gen_block_body(elif.then_branch)}";
				self.indent_level--;

				cur_else = elif.else_branch;
			} else break;
		}

		if (cur_else != null) {
			res = "${res}${ind}} else {\n";
			self.indent_level++;
			res = "${res}${self.gen_block_body(cur_else)}";
			self.indent_level--;
		}
		return "${res}${ind}}\n";
	}

	fn gen_while_stmt(var self, wh: *WhileStmt): str {
		val ind = get_indent(self.indent_level);
		var res = "${ind}while ${self.gen_cond(wh.condition)} {\n";
		self.indent_level++;
		res = "${res}${self.gen_block_body(wh.body)}";
		self.indent_level--;
		return "${res}${ind}}\n";
	}

	fn gen_return_stmt(var self, ret: *ReturnStmt): str {
		val ind = get_indent(self.indent_level);

		val ret_val = ret.value;
		if (ret_val != null) {
			if (ret_val is WhenExpr as we) {
				if (we.has_blocks()) {
					return self.gen_when_with_target(we, "", true);
				}
			}

			var ret_candidate = ret_val;
			while (ret_candidate != null) {
				if (ret_candidate is GroupExpr as g) ret_candidate = g.expr;
				else break;
			}
			if (ret_candidate is BinaryExpr as bin) {
				if (bin.op == TokenType.QUESTION_COLON) {
					var ret_ty = self.current_fn_ret_type;
					if (ret_ty.empty() || ret_ty == "void") ret_ty = self.infer_type_from_expr(bin.left);
					var cur = ret_candidate;
					var res = "${ind}{\n";
					self.indent_level++;
					val inner_ind = get_indent(self.indent_level);
					res = "${res}${inner_ind}${ret_ty} __ret_tmp;\n";
					while (cur != null) {
						while (cur != null) {
							if (cur is GroupExpr as g) cur = g.expr;
							else break;
						}
						if (cur == null) break;
						if (cur is BinaryExpr as b) {
							if (b.op == TokenType.QUESTION_COLON) {
								res = "${res}${inner_ind}__ret_tmp = ${self.gen_expr(b.left)};\n";
								res = "${res}${inner_ind}if (__ret_tmp != NULL) return __ret_tmp;\n";
								cur = b.right;
							} else {
								res = "${res}${inner_ind}return ${self.gen_expr(cur)};\n";
								break;
							}
						} else {
							res = "${res}${inner_ind}return ${self.gen_expr(cur)};\n";
							break;
						}
					}
					self.indent_level--;
					res = "${res}${ind}}\n";
					return res;
				}
			}

			return "${ind}return ${self.gen_expr(ret_val)};\n";
		}

		return "${ind}return;\n";
	}

	fn gen_expr_stmt(var self, es: *ExprStmt): str {
		val ind = get_indent(self.indent_level);
		val e = es.expr;
		if (e != null) {
			var asg_candidate = e;
			while (asg_candidate != null) {
				if (asg_candidate is GroupExpr as g) asg_candidate = g.expr;
				else break;
			}
			if (asg_candidate is AssignExpr as asg) {
				var asg_val = asg.value;
				while (asg_val != null) {
					if (asg_val is GroupExpr as g) asg_val = g.expr;
					else break;
				}
				if (asg_val is BinaryExpr as bin) {
					if (bin.op == TokenType.QUESTION_COLON) {
						val tgt = self.gen_expr(asg.target);
						var cur = asg_val;
						var first = true;
						var res = "";
						while (cur != null) {
							while (cur != null) {
								if (cur is GroupExpr as g) cur = g.expr;
								else break;
							}
							if (cur == null) break;
							if (cur is BinaryExpr as b) {
								if (b.op == TokenType.QUESTION_COLON) {
									if (first) {
										res = "${ind}${tgt} = ${self.gen_expr(b.left)};\n";
										first = false;
									} else {
										res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(b.left)};\n";
									}
									cur = b.right;
								} else {
									res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(cur)};\n";
									break;
								}
							} else {
								val is_jump = cur.kind == NodeKind.STMT_RETURN ||
									cur.kind == NodeKind.STMT_BREAK ||
									cur.kind == NodeKind.STMT_CONTINUE;
								if (is_jump) {
									res = "${res}${ind}if (${tgt} == NULL) {\n";
									self.indent_level++;
									res = "${res}${self.gen_statement(cur)}";
									self.indent_level--;
									res = "${res}${ind}}\n";
								} else {
									res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(cur)};\n";
								}
								break;
							}
						}
						return res;
					}
				}
			}

			var bin_candidate = e;
			while (bin_candidate != null) {
				if (bin_candidate is GroupExpr as g) bin_candidate = g.expr;
				else break;
			}
			if (bin_candidate is BinaryExpr as bin) {
				if (bin.op == TokenType.QUESTION_COLON) {
					val is_jump = bin.right.kind == NodeKind.STMT_RETURN ||
						bin.right.kind == NodeKind.STMT_BREAK ||
						bin.right.kind == NodeKind.STMT_CONTINUE;

					if (is_jump) {
						var res = "${ind}if (${self.gen_expr(bin.left)} == NULL) {\n";
						self.indent_level++;
						res = "${res}${self.gen_statement(bin.right)}";
						self.indent_level--;
						res = "${res}${ind}}\n";
						return res;
					}
				}
			}
		}
		return "${ind}${self.gen_expr(es.expr)};\n";
	}

	fn gen_yield_stmt(var self, ys: *YieldStmt): str {
		val ind = get_indent(self.indent_level);
		if (self.is_yield_return) {
			if (ys.value != null) return "${ind}return ${self.gen_expr(ys.value)};\n";
			return "${ind}return;\n";
		}
		if (!self.yield_target.empty()) {
			if (ys.value != null) return "${ind}${self.yield_target} = ${self.gen_expr(ys.value)};\n";
			return "";
		}
		if (ys.value != null) return "${ind}${self.gen_expr(ys.value)};\n";
		return "";
	}

	fn gen_when_stmt(var self, ws: *WhenStmt): str {
		var cond = "";
		if (ws.condition != null) cond = self.gen_expr(ws.condition);
		val ind = get_indent(self.indent_level);
		var res = "";
		var first = true;
		for (arm in ws.arms) {
			var cast_decl = "";
			val ws_cond = ws.condition;
			if (ws_cond is IdentifierExpr as id) {
				if (arm.patterns.len == 1) {
					val pat = arm.patterns.first();
					if (pat is IsExpr as is_e) {
						cast_decl = self.gen_smart_cast_decl(is_e, id.name, self.indent_level + 1);
					}
				}
			}

			if (arm.is_else) {
				if (first) res += ind + "{\n";
				else res += ind + "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				if (first) res += ind + "if (" + test + ") {\n";
				else res += ind + "} else if (" + test + ") {\n";
			}
			self.indent_level++;
			if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
			res += self.gen_block_body(arm.body);
			self.indent_level--;
			first = false;
		}
		if (!first) res += ind + "}\n";
		return res;
	}
	pub fn gen_smart_cast_decl(var self, is_e: *IsExpr, var_name: str, ind_level: usz): str {
		val target_name = c_type_from_ast(is_e.target_type);
		val bound_name = if (!is_e.alias.empty()) is_e.alias else var_name;
		val is_ptr = if (is_e.is_ptr) true else self.is_pointer_var(var_name);
		val next_ind = get_indent(ind_level);
		if (!is_e.alias.empty()) {
			if (is_ptr) {
				self.pointer_vars.add(bound_name);
				if (is_e.has_data && !is_e.base_c_name.empty()) {
					return "${target_name}* ${bound_name} = (${target_name}*)"
							"(((${is_e.base_c_name}*)${var_name})->data);";
				} else {
					return "${target_name}* ${bound_name} = (${target_name}*)${var_name};";
				}
			} else {
				self.pointer_vars.add(bound_name);
				return "${target_name}* ${bound_name} = (${target_name}*)&${var_name};";
			}
		} else {
			if (is_ptr) {
				if (is_e.has_data && !is_e.base_c_name.empty()) {
					return "void* __orig_${var_name} = (void*)${var_name};"
							"\n${next_ind}${target_name}* ${var_name} = (${target_name}*)"
							"(((${is_e.base_c_name}*)__orig_${var_name})->data);";
				} else {
					return "void* __orig_${var_name} = (void*)${var_name};"
							"\n${next_ind}${target_name}* ${var_name} = "
							"(${target_name}*)__orig_${var_name};";
				}
			} else {
				return "void* __orig_${var_name} = (void*)&${var_name};"
						"\n${next_ind}${target_name}* ${var_name} = "
						"(${target_name}*)__orig_${var_name};";
			}
		}
	}

	pub fn gen_when_with_target(var self, we: *WhenExpr, target_name: str, is_ret: bool): str {
		var cond = "";
		if (we.condition != null) cond = self.gen_expr(we.condition);
		val ind = get_indent(self.indent_level);
		var res = "";
		var first = true;

		val prev_target = self.yield_target;
		val prev_is_ret = self.is_yield_return;
		self.yield_target = target_name;
		self.is_yield_return = is_ret;

		for (arm in we.arms) {
			var cast_decl = "";
			val we_cond = we.condition;
			if (we_cond is IdentifierExpr as id) {
				if (arm.patterns.len == 1) {
					val pat = arm.patterns.first();
					if (pat is IsExpr as is_e) {
						cast_decl = self.gen_smart_cast_decl(is_e, id.name, self.indent_level + 1);
					}
				}
			}

			if (arm.is_else) {
				res += if (first) ind + "{\n" else ind + "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				res += if (first) ind + "if (" + test + ") {\n"
				else ind + "} else if (" + test + ") {\n";
			}
			self.indent_level++;
			if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
			val arm_b = arm.body;
			if (arm_b is BlockStmt as blk) {
				for (s in blk.statements) {
					res += self.gen_statement(s);
				}
			} else {
				val arm_ind = get_indent(self.indent_level);
				res += if (is_ret) arm_ind + "return " + self.gen_expr(arm_b) + ";\n"
				else arm_ind + target_name + " = " + self.gen_expr(arm_b) + ";\n";
			}
			self.indent_level--;
			first = false;
		}
		if (!first) res += ind + "}\n";

		self.yield_target = prev_target;
		self.is_yield_return = prev_is_ret;
		return res;
	}

}
