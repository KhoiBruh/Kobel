mod compiler.codegen.c_codegen;

use std.str.*;
use std.collections.list.*;
use std.collections.hash_set.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.sema.types.Type;
use compiler.sema.types.DataType;
use compiler.codegen.c_type.*;

// ============================================================================
// C99 Backend Code Generator
// ============================================================================

pub struct ConditionAlias {
	pub name: str,
	pub c_type: str,
	pub decl: str
}

pub struct CCodeGen {
	pub indent_level: usz = 0,
	pub struct_names: List<str> = List<str>(),
	pub struct_map: HashSet = HashSet(),
	pub errors: List<str> = List<str>(),
	// C element type for the array literal being emitted, when the surrounding
	// declaration already knows it (`val a: [T; N] = [...]`).
	pub array_elem_hint: str = "",
	pub yield_target: str = "",
	pub is_yield_return: bool = false,
	pub current_fn_ret_type: str = "",
	pub yield_exit_label: str = "",
	pub when_label_counter: usz = 0,
	pub defer_nodes: List<*AstNode> = List<*AstNode>(),
	pub scope_starts: List<usz> = List<usz>(),
	pub scope_jumped: List<bool> = List<bool>(),
	pub loop_defer_depths: List<usz> = List<usz>()
}

impl CCodeGen {

	pub fn new(): Self => Self(
		0,
		List<str>(),
		HashSet(),
		List<str>(),
		"",
		"",
		false,
		"",
		"",
		0,
		List<*AstNode>(),
		List<usz>(),
		List<bool>(),
		List<usz>()
	);

	pub fn enter_defer_scope(var self) {
		self.scope_starts += self.defer_nodes.len;
		self.scope_jumped += false;
	}

	pub fn add_defer(var self, stmt: *AstNode) {
		self.defer_nodes += stmt;
	}

	pub fn mark_current_scope_jumped(var self) {
		if (!self.scope_jumped.empty()) {
			self.scope_jumped.pop();
			self.scope_jumped += true;
		}
	}

	pub fn exit_defer_scope(var self): str {
		if (self.scope_starts.empty()) return "";
		val start_idx = self.scope_starts.pop();
		val jumped = self.scope_jumped.pop();
		var res = "";
		if (!jumped) {
			var i = self.defer_nodes.len;
			while (i > start_idx) {
				i--;
				res += self.gen_statement(self.defer_nodes[i]);
			}
		}
		while (self.defer_nodes.len > start_idx) {
			self.defer_nodes.pop();
		}
		return res;
	}

	pub fn has_active_defers(val self): bool => !self.defer_nodes.empty();

	pub fn gen_defers_unwind(var self, target_depth: usz): str {
		var res = "";
		if (self.defer_nodes.empty()) return res;
		val min_idx = if (target_depth < self.scope_starts.len) self.scope_starts[target_depth] else 0UZ;
		var i = self.defer_nodes.len;
		while (i > min_idx) {
			i--;
			res += self.gen_statement(self.defer_nodes[i]);
		}
		return res;
	}

	pub fn is_struct_name(val self, name: str): bool => name in self.struct_map;

	pub fn register_struct(var self, name: str) {
		self.struct_names += name;
		self.struct_map += name;
	}

}

pub fn get_indent(level: usz): str => "    ".repeat(level);

pub fn c_format_int_literal(raw: str): str {
	// The suffix is stripped through `num_suffix` so a hex digit is never taken for
	// one: `0xBB` stays 187 instead of becoming `0xB` with an i8 suffix. The `_`
	// digit separators are not C syntax, so they go too.
	val sfx = raw.num_suffix();
	val body = raw.strip_suffix(sfx.len).strip_char('_');
	return when (sfx) {
		// signed integer
		"Z" -> "((intptr_t)${body}LL)";
		"L" -> "${body}LL";
		"S" -> "((int16_t)${body})";
		"B" -> "((int8_t)${body})";

		// unsigned integer
		"U" -> "${body}U";
		"UZ" -> "((size_t)${body}ULL)";
		"UL" -> "${body}ULL";
		"UB" -> "((uint8_t)${body})";
		"US" -> "((uint16_t)${body})";
		else -> body
	};
}

pub fn c_int_literal_c_type(raw: str) => when (raw.num_suffix()) {
	// signed integer
	"Z" -> "intptr_t";
	"L" -> "int64_t";
	"S" -> "int16_t";
	"B" -> "int8_t";

	// unsigned integer
	"U" -> "uint32_t";
	"UZ" -> "size_t";
	"UL" -> "uint64_t";
	"US" -> "uint16_t";
	"UB" -> "uint8_t";
	else -> "int32_t"
};

pub fn c_float_literal_c_type(raw: str) => if (raw.ends_with("F")) "float" else "double";

pub fn c_format_float_literal(raw: str): str {
	// `_` digit separators are not C syntax, so they are dropped first.
	val text = raw.strip_char('_');
	var has_dot = false;
	for (c in text) {
		if (c == '.' || c == 'e' || c == 'E') {
			has_dot = true;
			break;
		}
	}
	if (has_dot) return text;

	val len = text.len;
	return when {
		text.ends_with("F") -> "${text.slice(0, len - 1)}.0f";
		text.ends_with("D") -> "${text.slice(0, len - 1)}.0";
		else -> "${text}.0"
	};
}

// ============================================================================
// Expression Code Generation
// ============================================================================

pub fn expr_needs_parens_for_member(node: *AstNode): bool {
	return when (node) {
		is IdentifierExpr,
		is MemberExpr,
		is CallExpr,
		is IndexExpr,
		is GroupExpr -> false;
		else -> true;
	};
}

impl CCodeGen {

	pub fn gen_expr(var self, node: *AstNode): str {
		if (node == null) return "";

		return when (node) {
			is LiteralExpr -> self.gen_literal_expr(node);

			is IdentifierExpr -> node.name;

			is GroupExpr -> {
				val inner = self.gen_expr(node.expr);
				val ne = node.expr;
				if (ne is BinaryExpr || ne is GroupExpr) yield inner;
				yield "(${inner})";
			}

			is BinaryExpr -> self.gen_binary_expr(node);

			is UnaryExpr -> self.gen_unary_expr(node);

			is ArrayLiteralExpr -> self.gen_array_literal_expr(node);

			is CallExpr -> self.gen_call_expr(node);

			is MemberExpr -> self.gen_member_expr(node);

			is IndexExpr -> "${self.gen_expr(node.target)}[${self.gen_expr(node.index)}]";

			is AssignExpr -> self.gen_assign_expr(node);

			is UpdateExpr -> {
				val op_str = if (node.op == TokenType.PLUS_PLUS) "++" else "--";
				yield "${self.gen_expr(node.target)}${op_str}";
			}

			is CastExpr -> {
				val ty = c_type_from_ast(node.target_type);
				yield "(${ty})${self.gen_expr(node.expr)}";
			}

			is IfExpr -> {
				val cond = self.gen_expr(node.condition);
				val th = self.gen_expr(node.then_branch);
				val el = self.gen_expr(node.else_branch);
				yield "(${cond} ? ${th} : ${el})";
			}

			is WhenExpr -> self.gen_when_expr(node);

			is IsExpr -> self.gen_is_expr(node);

			else -> "";
		};
	}

	// Literals lower to their C spelling (ints/floats normalised, strings/chars keep quoting).
	fn gen_literal_expr(var self, lit: *LiteralExpr): str {
		return when (lit.literal_kind) {
			LiteralKind.INT -> c_format_int_literal(lit.raw_text);
			LiteralKind.FLOAT -> c_format_float_literal(lit.raw_text);
			LiteralKind.BOOL -> lit.raw_text;
			LiteralKind.STRING -> {
				if (
					lit.raw_text.len >= 2 &&
					lit.raw_text[0] == '"'
				) yield lit.raw_text;

				yield "\"${lit.raw_text}\"";
			}
			LiteralKind.CHAR -> {
				if (
					lit.raw_text.len >= 2 &&
					lit.raw_text[0] == '\''
				) yield lit.raw_text;

				yield "'${lit.raw_text}'";
			}
			LiteralKind.NULL_VAL -> "NULL";
			else -> lit.raw_text;
		};
	}

	// Binary expressions lower to a parenthesised C operator (?: for the elvis form).
	fn gen_binary_expr(var self, bin: *BinaryExpr): str {
		if (bin.op == TokenType.QUESTION_COLON) {
			val l = self.gen_expr(bin.left);
			val r = self.gen_expr(bin.right);
			return "(${l} != NULL ? ${l} : ${r})";
		}

		val l = self.gen_expr(bin.left);
		val r = self.gen_expr(bin.right);
		val op_str = when (bin.op) {
			TokenType.MINUS -> "-";
			TokenType.STAR -> "*";
			TokenType.SLASH -> "/";
			TokenType.PERCENT -> "%";
			TokenType.EQUAL_EQUAL -> "==";
			TokenType.BANG_EQUAL -> "!=";
			TokenType.LESS -> "<";
			TokenType.LESS_EQUAL -> "<=";
			TokenType.GREATER -> ">";
			TokenType.GREATER_EQUAL -> ">=";
			TokenType.AND_AND -> "&&";
			TokenType.OR_OR -> "||";
			else -> "+";
		};

		return "(${l} ${op_str} ${r})";
	}

	// Unary operators lower to a C prefix operator (- guards a negative operand).
	fn gen_unary_expr(var self, un: *UnaryExpr): str {
		val opnd = self.gen_expr(un.operand);

		return when (un.op) {
			TokenType.MINUS -> if (opnd.starts_with("-")) "- (${opnd})" else "-${opnd}",
			TokenType.BANG -> "!${opnd}",
			TokenType.STAR -> "*${opnd}",
			TokenType.AMPERSAND -> "&${opnd}",
			else -> opnd;
		};
	}

	// `[1, 2, 3]` -> a C99 compound literal, `(int32_t[]){1, 2, 3}`. It decays
	// to a pointer, which is how this backend represents an array value.
	fn gen_array_literal_expr(var self, al: *ArrayLiteralExpr): str {
		val elem_c = when {
			al.elem_type_node != null -> c_type_from_ast(al.elem_type_node);

			!self.array_elem_hint.empty() -> self.array_elem_hint;

			!al.elements.empty() -> self.c_type_or(al.elements.first(), "int32_t");

			else -> "int32_t";
		};

		var elems_str = List<str>();
		for (el in al.elements) elems_str += self.gen_expr(el);
		val joined_elems = ", ".join(elems_str);
		val arr_res = "(${elem_c}[]){${joined_elems}}";

		if (!al.list_struct_name.empty()) {
			return if (al.elements.empty()) "${al.list_struct_name}_from_array(NULL, 0)"
			else "${al.list_struct_name}_from_array(${arr_res}, ${al.elements.len})";
		}

		return arr_res;
	}

	// Calls lower to a C call, a struct compound literal, or an inlined string/size helper.
	fn gen_call_expr(var self, call: *CallExpr): str {
		// Static or string method call: T.size() -> sizeof(T), s.c_str() -> s
		val callee = call.callee;
		if (callee is MemberExpr as mem) {
			if (mem.member == "size") {
				val obj_name = self.gen_expr(mem.object);
				val c_type = when (obj_name) {
					"str" -> "const char*",
					"usz", "isz" -> "size_t",
					else -> obj_name
				};
				return "sizeof(${c_type})";
			}
			if (mem.member == "c_str") return self.gen_expr(mem.object);
		}

		val callee_str = self.gen_expr(call.callee);

		// Check whether this calls a struct constructor: Point(1, 2) -> (Point){ 1, 2 }
		var is_struct = false;
		if (callee is IdentifierExpr as id) is_struct = self.is_struct_name(id.name);

		var args_str = List<str>();
		for (arg in call.args) args_str += self.gen_expr(arg);
		val joined_args = ", ".join(args_str);

		if (is_struct) return "(${callee_str}){ ${joined_args} }";

		// Ordinary C function call: func(arg1, arg2)
		return "${callee_str}(${joined_args})";
	}

	// Member access lowers to ./->. `str`/array `len` and `data` were already
	// rewritten by the lower pass, so this only sees real fields.
	fn gen_member_expr(var self, mem: *MemberExpr): str {
		val obj_node = mem.object;
		val obj = self.gen_expr(obj_node);
		// A member access on a pointer value needs `->`; the receiver of a
		// non-identifier pointer is dereferenced by sema instead.
		var is_ptr = false;
		if (obj_node.kind == NodeKind.EXPR_IDENTIFIER) is_ptr = self.c_type_of(obj_node).ends_with("*");
		val obj_str = if (expr_needs_parens_for_member(obj_node)) "(${obj})" else obj;
		if (mem.is_safe) return "(${obj_str} != NULL ? ${obj_str}->${mem.member} : NULL)";
		if (is_ptr) return "${obj_str}->${mem.member}";
		return "${obj_str}.${mem.member}";
	}

	// Assignments lower to the matching C compound-assignment operator.
	fn gen_assign_expr(var self, asgn: *AssignExpr): str {
		val op_str = when (asgn.op) {
			TokenType.PLUS_EQUAL -> "+=",
			TokenType.MINUS_EQUAL -> "-=",
			TokenType.STAR_EQUAL -> "*=",
			TokenType.SLASH_EQUAL -> "/=",
			TokenType.PERCENT_EQUAL -> "%=",
			else -> "="
		};
		return "${self.gen_expr(asgn.target)} ${op_str} ${self.gen_expr(asgn.value)}";
	}

	// when expressions lower to nested C ternaries, evaluated from the last arm back.
	fn gen_when_expr(var self, we: *WhenExpr): str {
		val cond = if (we.condition != null) self.gen_expr(we.condition) else "";
		var res = "0";
		var i = we.arms.len;
		while (i > 0) {
			i--;
			val arm = we.arms[i];
			res = if (arm.is_else) self.gen_expr(arm.body)
			else "(${self.gen_when_test(cond, arm.patterns)} ? ${self.gen_expr(arm.body)} : ${res})";
		}
		return res;
	}

	// Tag test of a smart cast. A pointer subject is compared against NULL
	// first: reading the tag would dereference it, and a null subject matches no
	// struct pattern, so the caller takes its `else` path.
	//
	// ponytail: the subject is re-evaluated for the NULL test. Safe today
	// because every subject is a plain path (`p`, `obj.field`); upgrade by
	// hoisting `void* __subj = ...;` in statement position if a call ever
	// becomes a subject.
	pub fn gen_tag_test(var self, subject: str, is_ptr: bool, tag_field: str, target_name: str): str {
		if (!is_ptr) return "${subject}.${tag_field} == ${target_name}__TAG";
		return "${subject} != NULL && ${subject}->${tag_field} == ${target_name}__TAG";
	}

	pub fn gen_is_expr(var self, is_e: *IsExpr): str {
		val obj = self.gen_expr(is_e.expr);
		val target_name = c_type_from_ast(is_e.target_type);
		var tag_field = is_e.tag_field;
		if (tag_field.empty()) tag_field = "tag";
		val obj_str = if (expr_needs_parens_for_member(is_e.expr)) "(${obj})" else obj;
		val tag_test = self.gen_tag_test(obj_str, is_e.is_ptr, tag_field, target_name);
		if (!is_e.alias.empty()) {
			val cast_val = if (is_e.is_ptr) {
				if (is_e.has_data && !is_e.base_c_name.empty()) {
					"(${target_name}*)(((${is_e.base_c_name}*)${obj_str})->data)"
				} else {
					"(${target_name}*)${obj_str}"
				}
			} else {
				"(${target_name}*)&${obj_str}"
			};
			return "(${tag_test} && (${is_e.alias} = ${cast_val}, 1))";
		}
		return "(${tag_test})";
	}

	// Builds the test expression of a `when` arm: `c == p1 || c == p2`.
	// For the boolean form (`cond` empty) each pattern is itself the test.
	// String patterns compare with strcmp since `str` lowers to `const char*`.
	pub fn gen_when_test(var self, cond: str, patterns: List<*AstNode>): str {
		var res = "";
		for (i in 0..<patterns.len) {
			val p = patterns[i];
			var test = "";
			if (cond.empty()) {
				test = self.gen_expr(p);
			} else if (p is IsExpr as is_e) {
				val target_name = c_type_from_ast(is_e.target_type);
				var tag_field = is_e.tag_field;
				if (tag_field.empty()) tag_field = "tag";
				test = self.gen_tag_test(cond, is_e.is_ptr, tag_field, target_name);
			} else if (p is LiteralExpr as lit) {
				if (lit.literal_kind == LiteralKind.STRING) {
					test = "strcmp(${cond}, ${self.gen_expr(p)}) == 0";
				} else {
					test = "${cond} == ${self.gen_expr(p)}";
				}
			} else {
				test = "${cond} == ${self.gen_expr(p)}";
			}
			res = if (i == 0) test else "${res} || ${test}";
		}
		if (res.empty()) res = "1";
		return res;
	}

	// C type of an expression: sema resolved it and stored the result on the
	// node, so the backend never re-derives a type from syntax or from variable
	// names. Empty for nodes that desugaring synthesised and were never checked.
	pub fn c_type_of(val self, expr: *AstNode): str {
		if (expr == null) return "";
		val ty = expr.type_ptr as *Type;
		if (ty == null) return "";
		return c_type_from_type(ty);
	}

	// Same, with a fallback for synthesised nodes.
	pub fn c_type_or(val self, expr: *AstNode, fallback: str): str {
		val ty = self.c_type_of(expr);
		if (ty.empty()) return fallback;
		return ty;
	}

	// True when the value is a pointer: a smart cast over a pointer casts the
	// value itself, while a struct value has to be addressed.
	fn is_pointer_value(val self, node: *AstNode): bool {
		if (node == null) return false;
		val ty = node.type_ptr as *Type;
		if (ty == null) return false;
		return ty.kind == DataType.POINTER;
	}

}

// ============================================================================
// Statement Code Generation
// ============================================================================

impl WhenExpr {
	pub fn has_blocks(val self): bool {
		for (arm in self.arms) {
			val arm_b = arm.body;
			if (arm_b is BlockStmt) return true;
			for (p in arm.patterns) {
				if (p is IsExpr) return true;
			}
		}
		return false;
	}
}

impl CCodeGen {

	pub fn gen_cond(var self, cond: *AstNode): str {
		val s = self.gen_expr(cond);
		if (
			cond != null && (
				cond.kind == NodeKind.EXPR_BINARY ||
				cond.kind == NodeKind.EXPR_GROUP
			)
		) return s;
		return "(${s})";
	}

	pub fn gen_block_body(var self, node: *AstNode): str {
		if (node == null) return "";
		if (node is BlockStmt as blk) {
			self.enter_defer_scope();
			var res = "";
			for (s in blk.statements) {
				res += self.gen_statement(s);
			}
			res += self.exit_defer_scope();
			return res;
		}
		self.enter_defer_scope();
		var res = self.gen_statement(node);
		res += self.exit_defer_scope();
		return res;
	}

	pub fn gen_statement(var self, node: *AstNode) => when (node) {
		is BlockStmt -> self.gen_block_stmt(node);
		is VarDeclStmt -> self.gen_var_decl_stmt(node);
		is IfStmt -> self.gen_if_stmt(node);
		is WhileStmt -> self.gen_while_stmt(node);
		is ReturnStmt -> self.gen_return_stmt(node);
		is ExprStmt -> self.gen_expr_stmt(node);
		is BreakStmt -> self.gen_break_stmt();
		is ContinueStmt -> self.gen_continue_stmt();
		is YieldStmt -> self.gen_yield_stmt(node);
		is WhenStmt -> self.gen_when_stmt(node);
		is DeferStmt as ds -> {
			self.add_defer(ds.body);
			yield "";
		}
		else -> "";
	};

	fn gen_block_stmt(var self, blk: *BlockStmt): str {
		val ind = get_indent(self.indent_level);
		var res = ind + "{\n";
		self.indent_level++;
		self.enter_defer_scope();
		for (stmt in blk.statements) {
			res += self.gen_statement(stmt);
		}
		res += self.exit_defer_scope();
		self.indent_level--;
		return res + ind + "}\n";
	}

	fn gen_break_stmt(var self): str {
		val ind = get_indent(self.indent_level);
		self.mark_current_scope_jumped();
		if (self.loop_defer_depths.empty()) return ind + "break;\n";
		val target_depth = self.loop_defer_depths.last();
		val defers = self.gen_defers_unwind(target_depth);
		return defers + ind + "break;\n";
	}

	fn gen_continue_stmt(var self): str {
		val ind = get_indent(self.indent_level);
		self.mark_current_scope_jumped();
		if (self.loop_defer_depths.empty()) return ind + "continue;\n";
		val target_depth = self.loop_defer_depths.last();
		val defers = self.gen_defers_unwind(target_depth);
		return defers + ind + "continue;\n";
	}

	fn gen_var_decl_stmt(var self, vd: *VarDeclStmt): str {
		val ind = get_indent(self.indent_level);
		var ty_str = "int32_t";

		var elem_hint = "";
		val t_ann = vd.type_annotation;
		if (t_ann != null) {
			ty_str = c_type_from_ast(t_ann);

			// `[T; N]` is emitted as a pointer, and its literal needs the
			// element type spelled out.
			if (t_ann is ArrayType as arr_ast) {
				elem_hint = c_type_from_ast(arr_ast.element_type);
			}
		} else if (vd.initializer != null) {
			val init_e = vd.initializer;
			ty_str = self.c_type_or(init_e, "int32_t");
		}

		var init_e = vd.initializer;
		while (init_e != null) {
			if (init_e is GroupExpr as g) init_e = g.expr;
			else break;
		}
		if (init_e is WhenExpr as we) {
			if (we.has_blocks()) {
				var res = "${ind}${ty_str} ${vd.name};\n";
				res = "${res}${self.gen_when_with_target(we, vd.name, false)}";
				return res;
			}
		}
		if (init_e is BinaryExpr as bin) {
			if (bin.op == TokenType.QUESTION_COLON) {
				return self.gen_var_elvis_init(vd, init_e, ind, ty_str);
			}
		}

		var res = "${ind}${ty_str} ${vd.name}";
		if (vd.initializer != null) {
			val saved_hint = self.array_elem_hint;
			self.array_elem_hint = elem_hint;
			res = "${res} = ${self.gen_expr(vd.initializer)}";
			self.array_elem_hint = saved_hint;
		}

		return "${res};\n";
	}

	// Emit a `a ?: b ?: c` initializer chain as a run of NULL checks.
	fn gen_var_elvis_init(var self, vd: *VarDeclStmt, init_e: *AstNode, ind: str, ty_str: str): str {
		var cur = init_e;
		var first = true;
		var res = "";
		while (cur != null) {
			while (cur != null) {
				if (cur is GroupExpr as g) cur = g.expr;
				else break;
			}
			if (cur == null) break;
			if (cur is BinaryExpr as b) {
				if (b.op == TokenType.QUESTION_COLON) {
					if (first) {
						res = "${ind}${ty_str} ${vd.name} = ${self.gen_expr(b.left)};\n";
						first = false;
					} else {
						res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(b.left)};\n";
					}
					cur = b.right;
				} else {
					res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(cur)};\n";
					break;
				}
			} else {
				val is_jump = cur.kind == NodeKind.STMT_RETURN ||
					cur.kind == NodeKind.STMT_BREAK ||
					cur.kind == NodeKind.STMT_CONTINUE ||
					cur.kind == NodeKind.STMT_YIELD ||
					cur.kind == NodeKind.STMT_BLOCK;
				if (is_jump) {
					res = "${res}${ind}if (${vd.name} == NULL) {\n";
					self.indent_level++;
					res = "${res}${self.gen_statement(cur)}";
					self.indent_level--;
					res = "${res}${ind}}\n";
				} else {
					res = "${res}${ind}if (${vd.name} == NULL) ${vd.name} = ${self.gen_expr(cur)};\n";
				}
				break;
			}
		}
		return res;
	}

	pub fn collect_condition_aliases(var self, expr: *AstNode): List<ConditionAlias> {
		var res = List<ConditionAlias>();
		if (expr == null) return res;
		var cur = expr;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		if (cur == null) return res;

		if (cur is BinaryExpr as bin) {
			if (bin.op == TokenType.AND_AND) {
				val left = self.collect_condition_aliases(bin.left);
				val right = self.collect_condition_aliases(bin.right);
				for (l in left) {
					var found = false;
					for (item in res) {
						if (item.name == l.name) {
							found = true;
							break;
						}
					}
					if (!found) res += l;
				}
				for (r in right) {
					var found = false;
					for (item in res) {
						if (item.name == r.name) {
							found = true;
							break;
						}
					}
					if (!found) res += r;
				}
				return res;
			}
		}

		if (cur is IsExpr as is_e && !is_e.alias.empty()) {
			val target_name = c_type_from_ast(is_e.target_type);
			val decl = "${target_name}* ${is_e.alias} = NULL;";
			res += ConditionAlias(is_e.alias, target_name, decl);
		}

		return res;
	}

	fn has_alias_type_conflict(var self, expr: *AstNode, aliases: List<ConditionAlias>): bool {
		val cond_aliases = self.collect_condition_aliases(expr);
		for (ca in cond_aliases) {
			for (a in aliases) {
				if (ca.name == a.name && ca.c_type != a.c_type) return true;
			}
		}
		return false;
	}

	fn gen_if_stmt(var self, ifs: *IfStmt): str {
		var aliases = self.collect_condition_aliases(ifs.condition);

		var cur_elif = ifs.else_branch;
		while (cur_elif != null) {
			if (cur_elif is IfStmt as elif) {
				if (self.has_alias_type_conflict(elif.condition, aliases)) {
					break;
				}
				val elif_aliases = self.collect_condition_aliases(elif.condition);
				for (ea in elif_aliases) {
					var found = false;
					for (a in aliases) {
						if (a.name == ea.name) {
							found = true;
							break;
						}
					}
					if (!found) aliases += ea;
				}
				cur_elif = elif.else_branch;
			} else break;
		}

		var cond = ifs.condition;
		while (cond != null) {
			if (cond is GroupExpr as g) cond = g.expr;
			else break;
		}

		var cast_decl = "";
		if (cond is IsExpr as is_e && is_e.alias.empty() && is_e.expr is IdentifierExpr as id) {
			cast_decl = self.gen_smart_cast_decl(is_e, is_e.expr, id.name, self.indent_level + 1);
		}

		val ind = get_indent(self.indent_level);
		val has_aliases = !aliases.empty();
		var res = "";

		if (has_aliases) {
			res = "${ind}{\n";
			self.indent_level++;
			for (a in aliases) {
				res = "${res}${get_indent(self.indent_level)}${a.decl}\n";
			}
		}

		val if_ind = get_indent(self.indent_level);
		res = "${res}${if_ind}if ${self.gen_cond(ifs.condition)} {\n";
		self.indent_level++;
		if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
		res = "${res}${self.gen_block_body(ifs.then_branch)}";
		self.indent_level--;

		var cur_else = ifs.else_branch;
		while (cur_else != null) {
			if (cur_else is IfStmt as elif) {
				if (self.has_alias_type_conflict(elif.condition, aliases)) {
					break;
				}

				var elif_cond = elif.condition;
				while (elif_cond != null) {
					if (elif_cond is GroupExpr as g) elif_cond = g.expr;
					else break;
				}

				var elif_cast = "";
				if (elif_cond is IsExpr as elif_is_e && elif_is_e.alias.empty() && elif_is_e.expr is IdentifierExpr as id) {
					elif_cast = self.gen_smart_cast_decl(elif_is_e, elif_is_e.expr, id.name, self.indent_level + 1);
				}

				res = "${res}${if_ind}} else if ${self.gen_cond(elif.condition)} {\n";
				self.indent_level++;
				if (!elif_cast.empty()) res += get_indent(self.indent_level) + elif_cast + "\n";
				res = "${res}${self.gen_block_body(elif.then_branch)}";
				self.indent_level--;

				cur_else = elif.else_branch;
			} else break;
		}

		if (cur_else != null) {
			res = "${res}${if_ind}} else {\n";
			self.indent_level++;
			res = "${res}${self.gen_block_body(cur_else)}";
			self.indent_level--;
		}

		res = "${res}${if_ind}}\n";

		if (has_aliases) {
			self.indent_level--;
			res = "${res}${ind}}\n";
		}

		return res;
	}

	fn gen_while_stmt(var self, wh: *WhileStmt): str {
		val ind = get_indent(self.indent_level);
		var res = "${ind}while ${self.gen_cond(wh.condition)} {\n";
		self.indent_level++;
		self.loop_defer_depths += self.scope_starts.len;
		res = "${res}${self.gen_block_body(wh.body)}";
		self.loop_defer_depths.pop();
		self.indent_level--;
		return "${res}${ind}}\n";
	}

	fn gen_return_stmt(var self, ret: *ReturnStmt): str {
		val ind = get_indent(self.indent_level);

		val ret_val = ret.value;
		if (ret_val is WhenExpr as we && we.has_blocks()) {
			return self.gen_when_with_target(we, "", true);
		}

		if (!self.has_active_defers()) {
			if (ret_val != null) {
				var ret_candidate = ret_val;
				while (ret_candidate != null) {
					if (ret_candidate is GroupExpr as g) ret_candidate = g.expr;
					else break;
				}
				if (ret_candidate is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
					var ret_ty = self.current_fn_ret_type;
					if (ret_ty.empty() || ret_ty == "void") ret_ty = self.c_type_or(bin.left, "int32_t");
					var cur = ret_candidate;
					var res = "${ind}{\n";
					self.indent_level++;
					val inner_ind = get_indent(self.indent_level);
					res = "${res}${inner_ind}${ret_ty} __ret_tmp;\n";
					while (cur != null) {
						while (cur != null) {
							if (cur is GroupExpr as g) cur = g.expr;
							else break;
						}
						if (cur == null) break;
						if (cur is BinaryExpr as b && b.op == TokenType.QUESTION_COLON) {
							res = "${res}${inner_ind}__ret_tmp = ${self.gen_expr(b.left)};\n";
							res = "${res}${inner_ind}if (__ret_tmp != NULL) return __ret_tmp;\n";
							cur = b.right;
						} else {
							res = "${res}${inner_ind}return ${self.gen_expr(cur)};\n";
							break;
						}
					}
					self.indent_level--;
					res = "${res}${ind}}\n";
					return res;
				}

				return "${ind}return ${self.gen_expr(ret_val)};\n";
			}

			return "${ind}return;\n";
		}

		self.mark_current_scope_jumped();
		if (ret_val != null) {
			var ret_ty = self.current_fn_ret_type;
			if (ret_ty.empty() || ret_ty == "void") ret_ty = self.c_type_or(ret_val, "int32_t");
			var res = "${ind}{\n";
			self.indent_level++;
			val inner_ind = get_indent(self.indent_level);
			res = "${res}${inner_ind}${ret_ty} __ret_tmp = ${self.gen_expr(ret_val)};\n";
			res = res + self.gen_defers_unwind(0UZ);
			res = "${res}${inner_ind}return __ret_tmp;\n";
			self.indent_level--;
			res = "${res}${ind}}\n";
			return res;
		}

		return self.gen_defers_unwind(0UZ) + ind + "return;\n";
	}

	fn gen_expr_stmt(var self, es: *ExprStmt): str {
		val ind = get_indent(self.indent_level);
		val e = es.expr;
		if (e != null) {
			var asg_candidate = e;
			while (asg_candidate != null) {
				if (asg_candidate is GroupExpr as g) asg_candidate = g.expr;
				else break;
			}
			if (asg_candidate is AssignExpr as asg) {
				var asg_val = asg.value;
				while (asg_val != null) {
					if (asg_val is GroupExpr as g) asg_val = g.expr;
					else break;
				}
				if (asg_val is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
					return self.gen_assign_elvis_stmt(asg, asg_val, ind);
				}
			}

			var bin_candidate = e;
			while (bin_candidate != null) {
				if (bin_candidate is GroupExpr as g) bin_candidate = g.expr;
				else break;
			}
			if (bin_candidate is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
				val is_jump = bin.right.kind == NodeKind.STMT_RETURN ||
					bin.right.kind == NodeKind.STMT_BREAK ||
					bin.right.kind == NodeKind.STMT_CONTINUE ||
					bin.right.kind == NodeKind.STMT_YIELD ||
					bin.right.kind == NodeKind.STMT_BLOCK;

				if (is_jump) {
					return self.gen_elvis_jump_stmt(bin, ind);
				}
			}
		}
		return "${ind}${self.gen_expr(es.expr)};\n";
	}

	// `x = a ?: b ?: c` assigns the first non-NULL value through a chain of NULL checks.
	fn gen_assign_elvis_stmt(var self, asg: *AssignExpr, asg_val: *AstNode, ind: str): str {
		val tgt = self.gen_expr(asg.target);
		var cur = asg_val;
		var first = true;
		var res = "";
		while (cur != null) {
			while (cur != null) {
				if (cur is GroupExpr as g) cur = g.expr;
				else break;
			}
			if (cur == null) break;
			if (cur is BinaryExpr as b) {
				if (b.op == TokenType.QUESTION_COLON) {
					if (first) {
						res = "${ind}${tgt} = ${self.gen_expr(b.left)};\n";
						first = false;
					} else {
						res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(b.left)};\n";
					}
					cur = b.right;
				} else {
					res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(cur)};\n";
					break;
				}
			} else {
				val is_jump = cur.kind == NodeKind.STMT_RETURN ||
					cur.kind == NodeKind.STMT_BREAK ||
					cur.kind == NodeKind.STMT_CONTINUE ||
					cur.kind == NodeKind.STMT_YIELD ||
					cur.kind == NodeKind.STMT_BLOCK;
				if (is_jump) {
					res = "${res}${ind}if (${tgt} == NULL) {\n";
					self.indent_level++;
					res = "${res}${self.gen_statement(cur)}";
					self.indent_level--;
					res = "${res}${ind}}\n";
				} else {
					res = "${res}${ind}if (${tgt} == NULL) ${tgt} = ${self.gen_expr(cur)};\n";
				}
				break;
			}
		}
		return res;
	}

	// A `cond ?: jump` statement emits a NULL guard that runs the jump statement.
	fn gen_elvis_jump_stmt(var self, bin: *BinaryExpr, ind: str): str {
		var res = "${ind}if (${self.gen_expr(bin.left)} == NULL) {\n";
		self.indent_level++;
		res = "${res}${self.gen_statement(bin.right)}";
		self.indent_level--;
		res = "${res}${ind}}\n";
		return res;
	}

	fn gen_yield_stmt(var self, ys: *YieldStmt): str {
		val ind = get_indent(self.indent_level);
		if (self.is_yield_return) {
			if (ys.value != null) return "${ind}return ${self.gen_expr(ys.value)};\n";
			return "${ind}return;\n";
		}
		if (!self.yield_target.empty()) {
			val val_str = if (ys.value != null) self.gen_expr(ys.value) else "";
			var res = if (!val_str.empty()) "${ind}${self.yield_target} = ${val_str};\n" else "";
			if (!self.yield_exit_label.empty()) {
				res = "${res}${ind}goto ${self.yield_exit_label};\n";
			}
			return res;
		}
		if (ys.value != null) return "${ind}${self.gen_expr(ys.value)};\n";
		return "";
	}

	fn gen_when_stmt(var self, ws: *WhenStmt): str {
		val cond = if (ws.condition != null) self.gen_expr(ws.condition) else "";
		val ind = get_indent(self.indent_level);
		var res = "";
		var first = true;
		for (arm in ws.arms) {
			var cast_decl = "";
			val ws_cond = ws.condition;
			if (ws_cond is IdentifierExpr as id) {
				if (arm.patterns.len == 1) {
					val pat = arm.patterns.first();
					if (pat is IsExpr as is_e) {
						cast_decl = self.gen_smart_cast_decl(is_e, is_e.expr, id.name, self.indent_level + 1);
					}
				}
			}

			if (arm.is_else) {
				if (first) res += ind + "{\n";
				else res += ind + "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				if (first) res += ind + "if (" + test + ") {\n";
				else res += ind + "} else if (" + test + ") {\n";
			}
			self.indent_level++;
			if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
			res += self.gen_block_body(arm.body);
			self.indent_level--;
			first = false;
		}
		if (!first) res += ind + "}\n";
		return res;
	}
	pub fn gen_smart_cast_decl(var self, is_e: *IsExpr, subject: *AstNode, var_name: str, ind_level: usz): str {
		val target_name = c_type_from_ast(is_e.target_type);
		val bound_name = if (!is_e.alias.empty()) is_e.alias else var_name;
		val is_ptr = if (is_e.is_ptr) true else self.is_pointer_value(subject);
		val next_ind = get_indent(ind_level);
		if (!is_e.alias.empty()) {
			if (is_ptr) {
				if (is_e.has_data && !is_e.base_c_name.empty()) {
					return "${target_name}* ${bound_name} = (${target_name}*)"
							"(((${is_e.base_c_name}*)${var_name})->data);";
				} else {
					return "${target_name}* ${bound_name} = (${target_name}*)${var_name};";
				}
			} else {
				return "${target_name}* ${bound_name} = (${target_name}*)&${var_name};";
			}
		} else {
			if (is_ptr) {
				if (is_e.has_data && !is_e.base_c_name.empty()) {
					return "void* __orig_${var_name} = (void*)${var_name};"
							"\n${next_ind}${target_name}* ${var_name} = (${target_name}*)"
							"(((${is_e.base_c_name}*)__orig_${var_name})->data);";
				} else {
					return "void* __orig_${var_name} = (void*)${var_name};"
							"\n${next_ind}${target_name}* ${var_name} = "
							"(${target_name}*)__orig_${var_name};";
				}
			} else {
				return "void* __orig_${var_name} = (void*)&${var_name};"
						"\n${next_ind}${target_name}* ${var_name} = "
						"(${target_name}*)__orig_${var_name};";
			}
		}
	}

	pub fn gen_when_with_target(var self, we: *WhenExpr, target_name: str, is_ret: bool): str {
		val cond = if (we.condition != null) self.gen_expr(we.condition) else "";
		val ind = get_indent(self.indent_level);
		var res = "";
		var first = true;

		val prev_target = self.yield_target;
		val prev_is_ret = self.is_yield_return;
		val prev_exit = self.yield_exit_label;

		self.when_label_counter++;
		val when_id = self.when_label_counter;

		self.yield_exit_label = if (is_ret) "" else "__when_end_${when_id}";

		self.yield_target = target_name;
		self.is_yield_return = is_ret;

		for (arm in we.arms) {
			var cast_decl = "";
			val we_cond = we.condition;
			if (we_cond is IdentifierExpr as id) {
				if (arm.patterns.len == 1) {
					val pat = arm.patterns.first();
					if (pat is IsExpr as is_e) {
						cast_decl = self.gen_smart_cast_decl(is_e, is_e.expr, id.name, self.indent_level + 1);
					}
				}
			}

			if (arm.is_else) {
				res += if (first) ind + "{\n" else ind + "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				res += if (first) ind + "if (" + test + ") {\n"
				else ind + "} else if (" + test + ") {\n";
			}
			self.indent_level++;
			if (!cast_decl.empty()) res += get_indent(self.indent_level) + cast_decl + "\n";
			val arm_b = arm.body;
			if (arm_b is BlockStmt as blk) {
				for (s in blk.statements) {
					res += self.gen_statement(s);
				}
			} else {
				val arm_ind = get_indent(self.indent_level);
				res += if (is_ret) arm_ind + "return " + self.gen_expr(arm_b) + ";\n"
				else arm_ind + target_name + " = " + self.gen_expr(arm_b) + ";\n";
			}
			self.indent_level--;
			first = false;
		}
		if (!first) res += ind + "}\n";

		if (!is_ret) res = "${res}${ind}${self.yield_exit_label}:;\n";

		self.yield_target = prev_target;
		self.is_yield_return = prev_is_ret;
		self.yield_exit_label = prev_exit;
		return res;
	}

}
