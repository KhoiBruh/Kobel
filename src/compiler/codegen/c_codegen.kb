mod compiler.codegen.c_codegen;

use std.collections.list.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

// ============================================================================
// C99 Backend Code Generator
// ============================================================================

pub struct CCodeGen {
	pub indent_level: usz,
	pub struct_names: List<str>,
	pub pointer_vars: List<str>,
	pub str_vars: List<str>,
	pub fn_names: List<str>,
	pub fn_ret_types: List<str>,
	pub errors: List<str>,
	// C element type for the array literal being emitted, when the surrounding
	// declaration already knows it (`val a: [T; N] = [...]`).
	pub array_elem_hint: str,
	pub yield_target: str,
	pub is_yield_return: bool
}

impl CCodeGen {

	pub fn new() => Self(
		0,
		List<str>(),
		List<str>(),
		List<str>(),
		List<str>(),
		List<str>(),
		List<str>(),
		"",
		"",
		false
	);

}

pub fn is_pointer_var(self: &CCodeGen, name: str): bool {
	for (v in self.pointer_vars) {
		if (v == name) return true;
	}
	return false;
}

pub fn is_str_var(self: &CCodeGen, name: str): bool {
	for (v in self.str_vars) {
		if (v == name) return true;
	}
	return false;
}

pub fn lookup_fn_ret_type(self: &CCodeGen, name: str): str {
	for (i in 0..<self.fn_names.len) {
		if (self.fn_names.get(i) == name) return self.fn_ret_types.get(i);
	}
	return "";
}

pub fn register_fn(var self: &CCodeGen, name: str, ret_type: str) {
	self.fn_names.add(name);
	self.fn_ret_types.add(ret_type);
}

pub fn get_indent(level: usz): str {
	var res = "";
	for (i in 0..<level) {
		res = "${res}    ";
	}
	return res;
}

// ============================================================================
// Type Mapping (Kobel -> C99 Standard Types)
// ============================================================================

pub fn c_type_from_ast(node: *AstNode): str {
	if (node == null) return "void";

	when (node.kind) {
		NodeKind.TYPE_NAMED -> {
			val named = node.to<NamedType>();
			val name = named.name;

			if (name == "none") return "void";
			if (name == "bool") return "bool";
			if (name == "char") return "char";
			if (name == "i8") return "int8_t";
			if (name == "i16") return "int16_t";
			if (name == "i32") return "int32_t";
			if (name == "i64") return "int64_t";
			if (name == "isz") return "intptr_t";
			if (name == "u8") return "uint8_t";
			if (name == "u16") return "uint16_t";
			if (name == "u32") return "uint32_t";
			if (name == "u64") return "uint64_t";
			if (name == "usz") return "size_t";
			if (name == "f32") return "float";
			if (name == "f64") return "double";
			if (name == "str") return "const char*";

			return name;
		}

		NodeKind.TYPE_POINTER -> {
			val ptr = node.to<PointerType>();
			val sub = c_type_from_ast(ptr.pointee);
			if (ptr.is_mut) return sub + "*";
			if (ptr.pointee.kind == NodeKind.TYPE_NAMED) {
				val named = ptr.pointee.to<NamedType>();
				// `str` and `*char` stay const so string literals and `.c_str()`
				// results can be passed. Other read-only pointers are emitted as
				// plain pointers: the language does not enforce const-correctness
				// and the compiler's own source writes through `*T`.
				if (named.name == "str") return "${sub}*";
				if (named.name == "char") return "const ${sub}*";
			}
			return "${sub}*";
		}

		NodeKind.TYPE_ARRAY -> {
			val arr = node.to<ArrayType>();
			val sub = c_type_from_ast(arr.element_type);
			return "${sub}*";
		}

		else -> return "void*";
	}
}

pub fn c_format_int_literal(raw: str): str {
	val len = raw.len;
	if (len >= 2) {
		val last = raw[len - 1];
		val prev = raw[len - 2];
		if (prev == 'U' && last == 'Z') return "((size_t)${strip_suffix(raw, 2)}ULL)";
		if (prev == 'U' && last == 'L') return "${strip_suffix(raw, 2)}ULL";
		if (prev == 'U' && last == 'B') return "((uint8_t)${strip_suffix(raw, 2)})";
		if (prev == 'U' && last == 'S') return "((uint16_t)${strip_suffix(raw, 2)})";
	}
	if (len >= 1) {
		val last = raw[len - 1];
		if (last == 'L') return "${strip_suffix(raw, 1)}LL";
		if (last == 'Z') return "((intptr_t)${strip_suffix(raw, 1)}LL)";
		if (last == 'B') return "((int8_t)${strip_suffix(raw, 1)})";
		if (last == 'S') return "((int16_t)${strip_suffix(raw, 1)})";
		if (last == 'U') return "${strip_suffix(raw, 1)}U";
	}
	return raw;
}

// ============================================================================
// Expression Code Generation
// ============================================================================

pub fn gen_expr(var self: &CCodeGen, node: *AstNode): str {
	if (node == null) return "";

	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = node.to<LiteralExpr>();
			when (lit.literal_kind) {
				LiteralKind.INT -> return c_format_int_literal(lit.raw_text);
				LiteralKind.FLOAT,
				LiteralKind.BOOL -> return lit.raw_text;
				LiteralKind.STRING -> {
					if (lit.raw_text.len >= 2 && lit.raw_text[0] == '"') return lit.raw_text;
					return "\"${lit.raw_text}\"";
				}
				LiteralKind.CHAR -> {
					if (lit.raw_text.len >= 2 && lit.raw_text[0] == '\'') return lit.raw_text;
					return "'${lit.raw_text}'";
				}
				LiteralKind.NULL_VAL -> return "NULL";
				else -> return lit.raw_text;
			}
		}

		NodeKind.EXPR_IDENTIFIER -> return node.to<IdentifierExpr>().name;

		NodeKind.EXPR_GROUP -> return "(${gen_expr(self, node.to<GroupExpr>().expr)})";

		NodeKind.EXPR_BINARY -> {
			val bin = node.to<BinaryExpr>();
			val l = gen_expr(self, bin.left);
			val r = gen_expr(self, bin.right);
			var op_str = "+";

			when (bin.op) {
				TokenType.PLUS -> op_str = "+";
				TokenType.MINUS -> op_str = "-";
				TokenType.STAR -> op_str = "*";
				TokenType.SLASH -> op_str = "/";
				TokenType.PERCENT -> op_str = "%";
				TokenType.EQUAL_EQUAL -> op_str = "==";
				TokenType.BANG_EQUAL -> op_str = "!=";
				TokenType.LESS -> op_str = "<";
				TokenType.LESS_EQUAL -> op_str = "<=";
				TokenType.GREATER -> op_str = ">";
				TokenType.GREATER_EQUAL -> op_str = ">=";
				TokenType.AND_AND -> op_str = "&&";
				TokenType.OR_OR -> op_str = "||";
				else -> op_str = "+";
			}

			return "(${l} ${op_str} ${r})";
		}

		NodeKind.EXPR_UNARY -> {
			val un = node.to<UnaryExpr>();
			val opnd = gen_expr(self, un.operand);

			return when (un.op) {
				TokenType.MINUS -> "(-${opnd})",
				TokenType.BANG -> "(!${opnd})",
				TokenType.STAR -> "(*${opnd})",
				TokenType.AMPERSAND -> "(&${opnd})",
				else -> opnd;
			};
		}

		// `[1, 2, 3]` -> a C99 compound literal, `(int32_t[]){1, 2, 3}`. It decays
		// to a pointer, which is how this backend represents an array value.
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = node.to<ArrayLiteralExpr>();
			var elem_c = self.array_elem_hint;
			if (elem_c == "" && !al.elements.is_empty()) elem_c = infer_type_from_expr(self, al.elements.first());
			if (elem_c == "") elem_c = "int32_t";

			var res = "(${elem_c}[]){";
			for (i in 0..<al.elements.len) {
				if (i > 0) res = "${res}, ";
				res = "${res}${gen_expr(self, al.elements.get(i))}";
			}
			return "${res}}";
		}

		NodeKind.EXPR_CALL -> {
			val call = node.to<CallExpr>();

			// Static or string method call: T.size() -> sizeof(T), s.c_str() -> s
			if (call.callee.kind == NodeKind.EXPR_MEMBER) {
				val mem = call.callee.to<MemberExpr>();
				if (mem.member == "size") {
					val obj_name = gen_expr(self, mem.object);
					return "sizeof(${obj_name})";
				}
				if (mem.member == "c_str") return gen_expr(self, mem.object);
				if (mem.member == "slice") {
					val slice_obj = gen_expr(self, mem.object);
					if (call.args.len >= 2) return "kobel_slice(${slice_obj}, ${gen_expr(self, call.args.first())}, ${gen_expr(self, call.args.get(1))})";
					if (call.args.len == 1) return "kobel_slice(${slice_obj}, ${gen_expr(self, call.args.first())}, strlen(${slice_obj}))";
					return slice_obj;
				}
			}

			val callee_str = gen_expr(self, call.callee);

			// Check whether this calls a struct constructor: Point(1, 2) -> (Point){ 1, 2 }
			var is_struct = false;
			if (call.callee.kind == NodeKind.EXPR_IDENTIFIER) {
				val id = call.callee.to<IdentifierExpr>();
				for (sn in self.struct_names) {
					if (sn == id.name) is_struct = true;
				}
			}

			if (is_struct) {
				var res = "(${callee_str}){ ";
				for (i in 0..<call.args.len) {
					if (i > 0) res = "${res}, ";
					res = "${res}${gen_expr(self, call.args.get(i))}";
				}
				return "${res} }";
			}

			// Ordinary C function call: func(arg1, arg2)
			var res = "${callee_str}(";
			for (i in 0..<call.args.len) {
				if (i > 0) res = "${res}, ";
				res = "${res}${gen_expr(self, call.args.get(i))}";
			}
			return "${res})";
		}

		NodeKind.EXPR_MEMBER -> {
			val mem = node.to<MemberExpr>();
			if (mem.member == "len" || mem.member == "size") {
				val is_str = when (mem.object.kind) {
					NodeKind.EXPR_IDENTIFIER -> is_str_var(self, mem.object.to<IdentifierExpr>().name),
					NodeKind.EXPR_LITERAL -> mem.object.to<LiteralExpr>().literal_kind == LiteralKind.STRING,
					else -> infer_type_from_expr(self, mem.object) == "const char*"
				};
				if (is_str) return "(uint64_t)strlen(${gen_expr(self, mem.object)})";
			}
			val obj = gen_expr(self, mem.object);
			var is_ptr = false;
			if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
				val id = mem.object.to<IdentifierExpr>();
				is_ptr = is_pointer_var(self, id.name);
			}
			if (is_ptr) return "(${obj})->${mem.member}";
			return "(${obj}).${mem.member}";
		}

		NodeKind.EXPR_INDEX -> {
			val idx = node.to<IndexExpr>();
			return "${gen_expr(self, idx.target)}[${gen_expr(self, idx.index)}]";
		}

		NodeKind.EXPR_ASSIGN -> {
			val asgn = node.to<AssignExpr>();
			return "${gen_expr(self, asgn.target)} = ${gen_expr(self, asgn.value)}";
		}

		NodeKind.EXPR_CAST -> {
			val cst = node.to<CastExpr>();
			val ty = c_type_from_ast(cst.target_type);
			return "((${ty})${gen_expr(self, cst.expr)})";
		}

		NodeKind.EXPR_IF -> {
			val if_e = node.to<IfExpr>();
			val cond = gen_expr(self, if_e.condition);
			val th = gen_expr(self, if_e.then_branch);
			val el = gen_expr(self, if_e.else_branch);
			return "(${cond} ? ${th} : ${el})";
		}

		NodeKind.EXPR_WHEN -> {
			val we = node.to<WhenExpr>();
			var cond = "";
			if (we.condition != null) cond = gen_expr(self, we.condition);
			var res = "0";
			var i = we.arms.len;
			while (i > 0) {
				i = i - 1;
				val arm = we.arms.get(i);
				if (arm.is_else) res = gen_expr(self, arm.body);
				else res = "(${gen_when_test(self, cond, arm.patterns)} ? ${gen_expr(self, arm.body)} : ${res})";
			}
			return res;
		}

		else -> return "";
	}
}

// Builds the test expression of a `when` arm: `c == p1 || c == p2`.
// For the boolean form (`cond` empty) each pattern is itself the test.
// String patterns compare with strcmp since `str` lowers to `const char*`.
pub fn gen_when_test(var self: &CCodeGen, cond: str, patterns: List<*AstNode>): str {
	var res = "";
	for (i in 0..<patterns.len) {
		val p = patterns.get(i);
		val test = when {
			cond == "" -> gen_expr(self, p),
			p.kind == NodeKind.EXPR_LITERAL && p.to<LiteralExpr>().literal_kind == LiteralKind.STRING ->
				"strcmp(${cond}, ${gen_expr(self, p)}) == 0",
			else -> "(${cond} == ${gen_expr(self, p)})"
		};
		if (i == 0) res = test;
		else res = "${res} || ${test}";
	}
	if (res == "") res = "1";
	return res;
}

pub fn infer_type_from_expr(var self: &CCodeGen, expr: *AstNode): str {
	if (expr == null) return "int32_t";

	when (expr.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = expr.to<LiteralExpr>();
			return when (lit.literal_kind) {
				LiteralKind.STRING -> "const char*";
				LiteralKind.CHAR -> "char";
				LiteralKind.FLOAT -> "double";
				LiteralKind.BOOL -> "bool";
				else -> "int32_t";
			};
		}

		NodeKind.EXPR_CALL -> {
			val call = expr.to<CallExpr>();
			if (call.callee.kind == NodeKind.EXPR_MEMBER) {
				val m = call.callee.to<MemberExpr>();
				if (m.member == "c_str" || m.member == "slice" || m.member == "data") return "const char*";
				if (m.member == "len" || m.member == "size" || m.member == "cap") return "size_t";
				return "int32_t";
			}
			if (call.callee.kind == NodeKind.EXPR_IDENTIFIER) {
				val id = call.callee.to<IdentifierExpr>();
				// Runtime string helpers injected by the semantic analyzer.
				if (id.name == "kobel_concat") return "const char*";
				if (id.name == "kobel_slice") return "const char*";
				if (id.name == "kobel_streq") return "bool";
				if (id.name == "kobel_slen") return "size_t";
				for (sn in self.struct_names) {
					if (sn == id.name) return id.name;
				}
				val ret_ty = lookup_fn_ret_type(self, id.name);
				if (ret_ty != "") return ret_ty;
			}
			return "int32_t";
		}

		NodeKind.EXPR_BINARY -> {
			val bin = expr.to<BinaryExpr>();
			return when (bin.op) {
				TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL,
				TokenType.LESS, TokenType.LESS_EQUAL,
				TokenType.GREATER, TokenType.GREATER_EQUAL,
				TokenType.AND_AND, TokenType.OR_OR -> "bool";
				else -> infer_type_from_expr(self, bin.left);
			};
		}

		NodeKind.EXPR_UNARY -> {
			val un = expr.to<UnaryExpr>();
			if (un.op == TokenType.BANG) return "bool";
			if (un.op == TokenType.AMPERSAND) {
				val sub = infer_type_from_expr(self, un.operand);
				return sub + "*";
			}
			return infer_type_from_expr(self, un.operand);
		}

		NodeKind.EXPR_GROUP -> return infer_type_from_expr(self, expr.to<GroupExpr>().expr);

		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = expr.to<ArrayLiteralExpr>();
			if (!al.elements.is_empty()) return "${infer_type_from_expr(self, al.elements.first())}*";
			return "int32_t*";
		}

		NodeKind.EXPR_WHEN -> {
			val we = expr.to<WhenExpr>();
			for (arm in we.arms) {
				if (arm.body.kind == NodeKind.STMT_BLOCK) {
					val blk = arm.body.to<BlockStmt>();
					for (s in blk.statements) {
						if (s.kind == NodeKind.STMT_YIELD) {
							val ys = s.to<YieldStmt>();
							if (ys.value != null) return infer_type_from_expr(self, ys.value);
						}
					}
				} else {
					return infer_type_from_expr(self, arm.body);
				}
			}
			return "int32_t";
		}

		NodeKind.EXPR_CAST -> {
			val cst = expr.to<CastExpr>();
			return c_type_from_ast(cst.target_type);
		}

		else -> return "int32_t";
	}
}

// ============================================================================
// Statement Code Generation
// ============================================================================

pub fn when_expr_has_blocks(we: *WhenExpr): bool {
	for (arm in we.arms) {
		if (arm.body.kind == NodeKind.STMT_BLOCK) return true;
	}
	return false;
}

pub fn gen_statement(var self: &CCodeGen, node: *AstNode): str {
	if (node == null) return "";

	when (node.kind) {
		NodeKind.STMT_BLOCK -> {
			val blk = node.to<BlockStmt>();
			val ind = get_indent(self.indent_level);
			var res = ind + "{\n";
			self.indent_level = self.indent_level + 1;
			for (stmt in blk.statements) {
				res = res + gen_statement(self, stmt);
			}
			self.indent_level = self.indent_level - 1;
			return res + ind + "}\n";
		}

		NodeKind.STMT_VAR_DECL -> {
			val vd = node.to<VarDeclStmt>();
			val ind = get_indent(self.indent_level);
			var ty_str = "int32_t";
			var is_ptr = false;

			var elem_hint = "";
			if (vd.type_annotation != null) {
				ty_str = c_type_from_ast(vd.type_annotation);
				if (vd.type_annotation.kind == NodeKind.TYPE_POINTER) is_ptr = true;
				// `[T; N]` is emitted as a pointer, and its literal needs the
				// element type spelled out.
				if (vd.type_annotation.kind == NodeKind.TYPE_ARRAY) {
					is_ptr = true;
					val arr_ast = vd.type_annotation.to<ArrayType>();
					elem_hint = c_type_from_ast(arr_ast.element_type);
				}
			} else if (vd.initializer != null) {
				ty_str = infer_type_from_expr(self, vd.initializer);
				if (vd.initializer.kind == NodeKind.EXPR_CAST) {
					val cst = vd.initializer.to<CastExpr>();
					if (cst.target_type != null && cst.target_type.kind == NodeKind.TYPE_POINTER) is_ptr = true;
				}
				if (ty_str.len > 0 && ty_str[ty_str.len - 1] == '*') is_ptr = true;
			}

			if (is_ptr) self.pointer_vars.add(vd.name);
			if (ty_str == "const char*") self.str_vars.add(vd.name);

			if (vd.initializer != null && vd.initializer.kind == NodeKind.EXPR_WHEN && when_expr_has_blocks(vd.initializer.to<WhenExpr>())) {
				var res = "${ind}${ty_str} ${vd.name};\n";
				res = "${res}${gen_when_with_target(self, vd.initializer.to<WhenExpr>(), vd.name, false)}";
				return res;
			}

			var res = "${ind}${ty_str} ${vd.name}";
			if (vd.initializer != null) {
				val saved_hint = self.array_elem_hint;
				self.array_elem_hint = elem_hint;
				res = "${res} = ${gen_expr(self, vd.initializer)}";
				self.array_elem_hint = saved_hint;
			}
			return "${res};\n";
		}

		NodeKind.STMT_IF -> {
			val ifs = node.to<IfStmt>();
			val ind = get_indent(self.indent_level);
			var res = "${ind}if (${gen_expr(self, ifs.condition)}) {\n";
			self.indent_level = self.indent_level + 1;
			res = "${res}${gen_statement(self, ifs.then_branch)}";
			self.indent_level = self.indent_level - 1;

			if (ifs.else_branch != null) {
				res = "${res}${ind}} else {\n";
				self.indent_level = self.indent_level + 1;
				res = "${res}${gen_statement(self, ifs.else_branch)}";
				self.indent_level = self.indent_level - 1;
			}
			return "${res}${ind}}\n";
		}

		NodeKind.STMT_WHILE -> {
			val wh = node.to<WhileStmt>();
			val ind = get_indent(self.indent_level);
			var res = "${ind}while (${gen_expr(self, wh.condition)}) {\n";
			self.indent_level = self.indent_level + 1;
			res = "${res}${gen_statement(self, wh.body)}";
			self.indent_level = self.indent_level - 1;
			return "${res}${ind}}\n";
		}

		NodeKind.STMT_RETURN -> {
			val ret = node.to<ReturnStmt>();
			val ind = get_indent(self.indent_level);
			if (ret.value != null) {
				if (ret.value.kind == NodeKind.EXPR_WHEN && when_expr_has_blocks(ret.value.to<WhenExpr>())) {
					return gen_when_with_target(self, ret.value.to<WhenExpr>(), "", true);
				}
				return "${ind}return ${gen_expr(self, ret.value)};\n";
			}
			return "${ind}return;\n";
		}

		NodeKind.STMT_EXPR -> {
			val es = node.to<ExprStmt>();
			val ind = get_indent(self.indent_level);
			return "${ind}${gen_expr(self, es.expr)};\n";
		}

		NodeKind.STMT_BREAK -> return "${get_indent(self.indent_level)}break;\n";

		NodeKind.STMT_CONTINUE -> return "${get_indent(self.indent_level)}continue;\n";

		NodeKind.STMT_YIELD -> {
			val ys = node.to<YieldStmt>();
			val ind = get_indent(self.indent_level);
			if (self.is_yield_return) {
				if (ys.value != null) return "${ind}return ${gen_expr(self, ys.value)};\n";
				return "${ind}return;\n";
			}
			if (self.yield_target != "") {
				if (ys.value != null) return "${ind}${self.yield_target} = ${gen_expr(self, ys.value)};\n";
				return "";
			}
			if (ys.value != null) return "${ind}${gen_expr(self, ys.value)};\n";
			return "";
		}

		NodeKind.STMT_WHEN -> {
			val ws = node.to<WhenStmt>();
			var cond = "";
			if (ws.condition != null) cond = gen_expr(self, ws.condition);
			val ind = get_indent(self.indent_level);
			var res = "";
			var first = true;
			for (arm in ws.arms) {
				if (arm.is_else) {
					if (first) res = res + ind + "{\n";
					else res = res + ind + "} else {\n";
				} else {
					val test = gen_when_test(self, cond, arm.patterns);
					if (first) res = res + ind + "if (" + test + ") {\n";
					else res = res + ind + "} else if (" + test + ") {\n";
				}
				self.indent_level = self.indent_level + 1;
				res = res + gen_statement(self, arm.body);
				self.indent_level = self.indent_level - 1;
				first = false;
			}
			if (!first) res = res + ind + "}\n";
			return res;
		}

		else -> return "";
	}
}

pub fn gen_when_with_target(var self: &CCodeGen, we: *WhenExpr, target_name: str, is_ret: bool): str {
	var cond = "";
	if (we.condition != null) cond = gen_expr(self, we.condition);
	val ind = get_indent(self.indent_level);
	var res = "";
	var first = true;

	val prev_target = self.yield_target;
	val prev_is_ret = self.is_yield_return;
	self.yield_target = target_name;
	self.is_yield_return = is_ret;

	for (arm in we.arms) {
		if (arm.is_else) {
			if (first) res = res + ind + "{\n";
			else res = res + ind + "} else {\n";
		} else {
			val test = gen_when_test(self, cond, arm.patterns);
			if (first) res = res + ind + "if (" + test + ") {\n";
			else res = res + ind + "} else if (" + test + ") {\n";
		}
		self.indent_level = self.indent_level + 1;
		if (arm.body.kind == NodeKind.STMT_BLOCK) {
			val blk = arm.body.to<BlockStmt>();
			for (s in blk.statements) {
				res = res + gen_statement(self, s);
			}
		} else {
			val arm_ind = get_indent(self.indent_level);
			if (is_ret) {
				res = res + arm_ind + "return " + gen_expr(self, arm.body) + ";\n";
			} else {
				res = res + arm_ind + target_name + " = " + gen_expr(self, arm.body) + ";\n";
			}
		}
		self.indent_level = self.indent_level - 1;
		first = false;
	}
	if (!first) res = res + ind + "}\n";

	self.yield_target = prev_target;
	self.is_yield_return = prev_is_ret;
	return res;
}
