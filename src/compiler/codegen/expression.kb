mod compiler.codegen;

// ============================================================================
// Expression Code Generation
//
// Expression emission: literals, operators, calls, member/index access,
// assignments, array literals, `when`/`is` tests and the tag helpers.
// ============================================================================

use std.string.*;
use std.collections.*;

use compiler.lexer.*;
use compiler.ast.*;

use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

// ============================================================================
// Expression Code Generation
// ============================================================================

const PREC_NONE: i32 = 0;
const PREC_ASSIGN: i32 = 1;
const PREC_TERNARY: i32 = 2;
const PREC_OR: i32 = 3;
const PREC_AND: i32 = 4;
const PREC_EQ: i32 = 5;
const PREC_REL: i32 = 6;
const PREC_ADD: i32 = 7;
const PREC_MUL: i32 = 8;
const PREC_UNARY: i32 = 9;
const PREC_POSTFIX: i32 = 10;
const PREC_ATOM: i32 = 11;

pub fn wrap_prec(s: str, prec: i32, min_prec: i32): str {
	if (prec < min_prec) return "(${s})";
	return s;
}

pub fn unwrap_group_expr(node: ?*AstNode): ?*AstNode {
	var cur = node;
	while (cur != null) {
		if (cur is GroupExpr as g) cur = g.expr;
		else break;
	}
	return cur;
}

pub fn expr_needs_parens_for_member(node: *AstNode): bool {
	val cur = unwrap_group_expr(node) ?: return true;
	if (cur is MemberExpr as m) return m.is_safe;
	return when (cur) {
		is IdentifierExpr,
		CallExpr,
		IndexExpr -> false;
		else -> true;
	};
}

impl CCodeGen {

	pub fn gen_expr(&self, node: ?*AstNode): str => self.gen_expr_prec(node, PREC_NONE);

	pub fn gen_expr_prec(&self, node: ?*AstNode, min_prec: i32): str {
		if (node == null) return "";
		val ast_node = node!;

		return when (node) {
			is LiteralExpr -> self.gen_literal_expr(ast_node, node);

			is IdentifierExpr -> self.gen_ident_expr(node.name);

			is GroupExpr -> self.gen_expr_prec(node.expr, min_prec);

			is BinaryExpr -> self.gen_binary_expr(ast_node, node, min_prec);

			is UnaryExpr -> self.gen_unary_expr(node, min_prec);

			is CallExpr -> self.gen_call_expr(ast_node, node, min_prec);

			is MemberExpr -> self.gen_member_expr(ast_node, node, min_prec);

			is IndexExpr -> {
				val tgt = self.gen_expr_prec(node.target, PREC_POSTFIX);
				val idx = self.gen_expr(node.index);
				val tgt_ty = self.node_type(node.target);
				if (tgt_ty?.kind == DataType.ARRAY && tgt_ty.as_array().length == 0 && node.target is IdentifierExpr as id) {
					yield "${id.name}_data[${idx}]";
				}
				if (node.target is IdentifierExpr as id) {
					val sym = self.symtab?.lookup(id.name);
					if (sym != null && sym.is_vararg) {
						yield "${id.name}_data[${idx}]";
					}
				}
				if (self.is_str_value(node.target)) {
					yield "${tgt}.data[${idx}]";
				}
				yield "${tgt}[${idx}]";
			}

			is AssignExpr -> self.gen_assign_expr(node, min_prec);

			is UpdateExpr -> {
				val op_str = if (node.op == TokenType.PLUS_PLUS) "++" else "--";
				yield "${self.gen_expr_prec(node.target, PREC_POSTFIX)}${op_str}";
			}

			is CastExpr as cst -> self.gen_cast_expr(cst, min_prec);

			is IfExpr -> {
				val cond = self.gen_expr_prec(node.condition, PREC_TERNARY + 1);
				val th = self.gen_expr_prec(node.then_branch, PREC_TERNARY + 1);
				val el = self.gen_expr_prec(node.else_branch, PREC_TERNARY);
				yield wrap_prec("${cond} ? ${th} : ${el}", PREC_TERNARY, min_prec);
			}

			is WhenExpr -> self.gen_when_expr(node, min_prec);

			is IsExpr -> self.gen_is_expr(ast_node, node, min_prec);

			// A struct value built from its fields: `(Point){ 1, 2 }`.
			is StructCtorExpr -> {
				val ctor_args = node.args.map { a -> self.gen_expr(a) };
				val joined = ", ".join(ctor_args);
				yield "(${node.c_name}){ ${joined} }";
			}

			// A payload-enum value: tag plus the variant's union member.
			is EnumCtorExpr -> {
				if (node.payload_path.empty()) {
					yield "(${node.c_name}){ .${node.tag_field} = ${node.tag_value} }";
				}
				val ctor_args = node.args.map { a -> self.gen_expr(a) };
				val joined = ", ".join(ctor_args);
				yield "(${node.c_name}){ .${node.tag_field} = ${node.tag_value}, "
					".${node.payload_path} = { ${joined} } }";
			}

			// `T.size()`: the checker folded the concrete argument's C size into
			// the node; emit it as an integer constant (same spelling as the
			// literal path, so generated C stays byte-identical).
			is SizeOfParam -> c_format_int_literal(node.size_text);

			is LambdaExpr -> self.gen_lambda_expr(ast_node);

			else -> "";
		};
	}

	pub fn gen_ident_expr(*self, name: str): str {
		for (cap in self.active_lambda_captures) {
			if (cap.name == name) {
				if (cap.is_mutable) return "(*(__env->${name}))";
				return "(__env->${name})";
			}
		}
		return name;
	}

	fn gen_lambda_expr(*self, ast_node: *AstNode): str {
		val info = self.lambda_info_of(ast_node);
		if (info.id == 0) return "(kobel_closure){ NULL, NULL }";
		if (info.captures.empty()) {
			return "(kobel_closure){ (void*)__lambda_fn_${info.id}, NULL }";
		}
		val cap_inits = info.captures.map { cap ->
			val expr_s = self.gen_ident_expr(cap.name);
			yield if (cap.is_mutable) "&${expr_s}" else expr_s;
		};
		val joined = ", ".join(cap_inits);
		return "(kobel_closure){ (void*)__lambda_fn_${info.id}, (void*)&(struct __lambda_env_${info.id}){ ${joined} } }";
	}

	// Literals lower to their C spelling (ints/floats normalised, strings wrapped in KOBEL_STR).
	fn gen_literal_expr(*self, ast_node: *AstNode, lit: *LiteralExpr): str {
		return when (lit.literal_kind) {
			Literal.INTEGER -> c_format_int_literal(lit.raw_text);
			Literal.FLOAT -> c_format_float_literal(lit.raw_text);
			Literal.BOOLEAN -> lit.raw_text;
			Literal.STRING -> {
				val lit_ty = self.node_type(ast_node);
				val is_ptr_lit = lit_ty != null && lit_ty.kind == DataType.POINTER;
				val quoted = if (lit.raw_text.len >= 2 && lit.raw_text[0] == '"') lit.raw_text
					else "\"${lit.raw_text}\"";
				if (is_ptr_lit) {
					yield quoted;
				}
				yield "KOBEL_STR(${quoted})";
			}
			Literal.CHARACTER -> {
				if (
					lit.raw_text.len >= 2 &&
					lit.raw_text[0] == '\''
				) yield lit.raw_text;

				yield "'${lit.raw_text}'";
			}
			Literal.NULL_VAL -> "NULL";
		};
	}

	// Binary expressions lower to a C operator (`?:` lowers to C `?:`, with parens only as needed).
	fn gen_binary_expr(&self, ast_node: *AstNode, bin: *BinaryExpr, min_prec: i32): str {
		if (bin.op in [TokenType.DOT_DOT, TokenType.DOT_DOT_LESS]) {
			val c_ty = self.c_type_of(ast_node);
			val l = self.gen_expr(bin.left);
			val r = self.gen_expr(bin.right);
			val inc = if (bin.op == TokenType.DOT_DOT) "true" else "false";
			return "(${c_ty}){ ${l}, ${r}, ${inc} }";
		}

		if (bin.op == TokenType.QUESTION_COLON) {
			val unwrapped_l = unwrap_group_expr(bin.left);
			if (unwrapped_l != null && unwrapped_l is MemberExpr as mem && mem.is_safe) {
				val obj_wrap = self.gen_expr_prec(mem.object, PREC_POSTFIX);
				val r_s = self.gen_expr_prec(bin.right, PREC_TERNARY);
				val mem_val = "${obj_wrap}->${mem.member}";
				if (self.is_str_value(unwrapped_l) || self.is_str_value(bin.right)) {
					return wrap_prec("${obj_wrap} != NULL && ${mem_val}.data != NULL ? ${mem_val} : ${r_s}", PREC_TERNARY, min_prec);
				}
				if (self.is_pointer_value(unwrapped_l) || self.is_pointer_value(bin.right)) {
					return wrap_prec("${obj_wrap} != NULL && ${mem_val} != NULL ? ${mem_val} : ${r_s}", PREC_TERNARY, min_prec);
				}
				return wrap_prec("${obj_wrap} != NULL ? ${mem_val} : ${r_s}", PREC_TERNARY, min_prec);
			}
			val l = self.gen_expr_prec(bin.left, PREC_TERNARY + 1);
			val r = self.gen_expr_prec(bin.right, PREC_TERNARY);
			if (self.is_str_value(bin.left)) {
				val l_wrap = self.gen_expr_prec(bin.left, PREC_POSTFIX);
				return wrap_prec("${l_wrap}.data != NULL ? ${l} : ${r}", PREC_TERNARY, min_prec);
			}
			val l_cmp = self.gen_expr_prec(bin.left, PREC_EQ + 1);
			return wrap_prec("${l_cmp} != NULL ? ${l} : ${r}", PREC_TERNARY, min_prec);
		}

		if (bin.op == TokenType.KW_IN) {
			val unwrapped_r = unwrap_group_expr(bin.right);
			if (unwrapped_r != null && unwrapped_r is ArrayLiteralExpr as al) {
				val unwrapped_l = unwrap_group_expr(bin.left);
				if (unwrapped_l != null && unwrapped_l is MemberExpr as mem && mem.is_safe) {
					val obj_wrap = self.gen_expr_prec(mem.object, PREC_POSTFIX);
					val cond = "${obj_wrap}->${mem.member}";
					val test_s = self.gen_when_test_prec(cond, al.elements, PREC_AND);
					return wrap_prec("${obj_wrap} != NULL && ${test_s}", PREC_AND, min_prec);
				}
				val cond = self.gen_expr_prec(bin.left, PREC_POSTFIX);
				return self.gen_when_test_prec(cond, al.elements, min_prec);
			}
		}

		val is_cmp = bin.op in [
			TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL,
			TokenType.LESS, TokenType.LESS_EQUAL,
			TokenType.GREATER, TokenType.GREATER_EQUAL
		];
		if (is_cmp) {
			val unwrapped_l = unwrap_group_expr(bin.left);
			val unwrapped_r = unwrap_group_expr(bin.right);

			var l_is_safe = false;
			if (unwrapped_l != null && unwrapped_l is MemberExpr as mem_l) l_is_safe = mem_l.is_safe;
			var r_is_safe = false;
			if (unwrapped_r != null && unwrapped_r is MemberExpr as mem_r) r_is_safe = mem_r.is_safe;

			val cmp_prec = if (bin.op in [TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL]) PREC_EQ else PREC_REL;
			val op_str = when (bin.op) {
				TokenType.EQUAL_EQUAL -> "==";
				TokenType.BANG_EQUAL -> "!=";
				TokenType.LESS -> "<";
				TokenType.LESS_EQUAL -> "<=";
				TokenType.GREATER -> ">";
				TokenType.GREATER_EQUAL -> ">=";
				else -> "==";
			};

			var l_is_null = false;
			if (unwrapped_l != null && unwrapped_l is LiteralExpr as lit_l) {
				l_is_null = (lit_l.literal_kind == Literal.NULL_VAL);
			}
			var r_is_null = false;
			if (unwrapped_r != null && unwrapped_r is LiteralExpr as lit_r) {
				r_is_null = (lit_r.literal_kind == Literal.NULL_VAL);
			}

			if (l_is_safe && !r_is_safe && unwrapped_l is MemberExpr as mem) {
				val obj_wrap = self.gen_expr_prec(mem.object, PREC_POSTFIX);
				val r_s = self.gen_expr_prec(bin.right, cmp_prec + 1);
				if (bin.op == TokenType.EQUAL_EQUAL && r_is_null) {
					return wrap_prec("${obj_wrap} == NULL || ${obj_wrap}->${mem.member} ${op_str} ${r_s}", PREC_OR, min_prec);
				}
				return wrap_prec("${obj_wrap} != NULL && ${obj_wrap}->${mem.member} ${op_str} ${r_s}", PREC_AND, min_prec);
			}
			if (r_is_safe && !l_is_safe && unwrapped_r is MemberExpr as mem) {
				val obj_wrap = self.gen_expr_prec(mem.object, PREC_POSTFIX);
				val l_s = self.gen_expr_prec(bin.left, cmp_prec + 1);
				if (bin.op == TokenType.EQUAL_EQUAL && l_is_null) {
					return wrap_prec("${obj_wrap} == NULL || ${l_s} ${op_str} ${obj_wrap}->${mem.member}", PREC_OR, min_prec);
				}
				return wrap_prec("${obj_wrap} != NULL && ${l_s} ${op_str} ${obj_wrap}->${mem.member}", PREC_AND, min_prec);
			}
			if (
				l_is_safe && r_is_safe &&
				unwrapped_l is MemberExpr as mem_l_val &&
				unwrapped_r is MemberExpr as mem_r_val
			) {
				val obj_l_wrap = self.gen_expr_prec(mem_l_val.object, PREC_POSTFIX);
				val obj_r_wrap = self.gen_expr_prec(mem_r_val.object, PREC_POSTFIX);
				val l_acc = "${obj_l_wrap}->${mem_l_val.member}";
				val r_acc = "${obj_r_wrap}->${mem_r_val.member}";
				return wrap_prec("${obj_l_wrap} != NULL && ${obj_r_wrap} != NULL && ${l_acc} ${op_str} ${r_acc}", PREC_AND, min_prec);
			}
		}

		val op_str = when (bin.op) {
			TokenType.MINUS -> "-";
			TokenType.STAR -> "*";
			TokenType.SLASH -> "/";
			TokenType.PERCENT -> "%";
			TokenType.EQUAL_EQUAL -> "==";
			TokenType.BANG_EQUAL -> "!=";
			TokenType.LESS -> "<";
			TokenType.LESS_EQUAL -> "<=";
			TokenType.GREATER -> ">";
			TokenType.GREATER_EQUAL -> ">=";
			TokenType.AND_AND -> "&&";
			TokenType.OR_OR -> "||";
			else -> "+";
		};
		val op_prec = when (bin.op) {
			TokenType.STAR, TokenType.SLASH, TokenType.PERCENT -> PREC_MUL;
			TokenType.PLUS, TokenType.MINUS -> PREC_ADD;
			TokenType.LESS, TokenType.LESS_EQUAL, TokenType.GREATER, TokenType.GREATER_EQUAL -> PREC_REL;
			TokenType.EQUAL_EQUAL, TokenType.BANG_EQUAL -> PREC_EQ;
			TokenType.AND_AND -> PREC_AND;
			TokenType.OR_OR -> PREC_OR;
			else -> PREC_ADD;
		};

		if (bin.op in [TokenType.AND_AND, TokenType.OR_OR]) {
			// Parenthesize `&&` inside `||` to avoid `-Wlogical-op-parentheses`.
			val child_min = if (bin.op == TokenType.OR_OR) PREC_AND + 1 else PREC_AND;
			val l = self.gen_assoc_bin_part(bin.left, bin.op, op_str, child_min);
			val r = self.gen_assoc_bin_part(bin.right, bin.op, op_str, child_min);
			return wrap_prec("${l} ${op_str} ${r}", op_prec, min_prec);
		}

		val l_min = if (op_prec in [PREC_EQ, PREC_REL]) op_prec + 1 else op_prec;
		val l = self.gen_expr_prec(bin.left, l_min);
		val r = self.gen_expr_prec(bin.right, op_prec + 1);
		return wrap_prec("${l} ${op_str} ${r}", op_prec, min_prec);
	}

	fn gen_assoc_bin_part(&self, node: *AstNode, op: TokenType, op_str: str, child_min: i32): str {
		val cur = unwrap_group_expr(node);
		if (cur != null && cur is BinaryExpr as sub && sub.op == op) {
			val sl = self.gen_assoc_bin_part(sub.left, op, op_str, child_min);
			val sr = self.gen_assoc_bin_part(sub.right, op, op_str, child_min);
			return "${sl} ${op_str} ${sr}";
		}
		return self.gen_expr_prec(node, child_min);
	}

	// Unary operators lower to a C prefix operator (- guards a negative operand).
	fn gen_unary_expr(&self, un: *UnaryExpr, min_prec: i32): str {
		if (un.is_postfix && un.op == TokenType.BANG) {
			return self.gen_expr_prec(un.operand, min_prec);
		}
		val opnd = self.gen_expr_prec(un.operand, PREC_UNARY);

		val s = when (un.op) {
			TokenType.MINUS -> if (opnd.starts_with("-")) "- (${opnd})" else "-${opnd}";
			TokenType.BANG -> "!${opnd}";
			TokenType.STAR -> "*${opnd}";
			TokenType.AMPERSAND -> "&${opnd}";
			else -> opnd;
		};
		return wrap_prec(s, PREC_UNARY, min_prec);
	}

	// Calls lower to a C call, a struct compound literal, or an inlined string/size helper.
	fn gen_call_expr(&self, ast_node: *AstNode, call: *CallExpr, min_prec: i32): str {
		// Static or string method call: T.size() -> sizeof(T), s.c_str() -> kobel_cstr(s)
		val callee = call.callee;
		if (callee is MemberExpr as mem) {
			if (mem.member == "size") {
				val obj_name = self.gen_expr(mem.object);
				val c_type = when (obj_name) {
					"str" -> "kobel_str";
					"usz", "isz" -> "size_t";
					else -> obj_name;
				};
				return "sizeof(${c_type})";
			}
			if (mem.member == "c_str") return "kobel_cstr(${self.gen_expr(mem.object)})";
			if (mem.member == "addr" && self.is_pointer_value(mem.object)) {
				if (mem.is_safe) {
					val obj_cmp = self.gen_expr_prec(mem.object, PREC_EQ + 1);
					val obj_cast = self.gen_expr_prec(mem.object, PREC_UNARY);
					return wrap_prec("${obj_cmp} != NULL ? (uintptr_t)${obj_cast} : 0", PREC_TERNARY, min_prec);
				}
				val obj_str = self.gen_expr_prec(mem.object, PREC_UNARY);
				return wrap_prec("(uintptr_t)${obj_str}", PREC_UNARY, min_prec);
			}
			if (mem.member == "write" && self.is_pointer_value(mem.object) && call.args.len == 1) {
				if (mem.is_safe) {
					val obj_cmp = self.gen_expr_prec(mem.object, PREC_EQ + 1);
					val obj_deref = self.gen_expr_prec(mem.object, PREC_UNARY);
					val val_str = self.gen_expr_prec(call.args[0], PREC_TERNARY);
					return wrap_prec("${obj_cmp} != NULL ? (*${obj_deref} = ${val_str}) : 0", PREC_TERNARY, min_prec);
				}
				val obj_str = self.gen_expr_prec(mem.object, PREC_UNARY);
				val val_str = self.gen_expr(call.args[0]);
				return wrap_prec("*${obj_str} = ${val_str}", PREC_ASSIGN, min_prec);
			}
			if (mem.member == "read" && self.is_pointer_value(mem.object) && call.args.empty()) {
				if (mem.is_safe) {
					val obj_cmp = self.gen_expr_prec(mem.object, PREC_EQ + 1);
					val obj_deref = self.gen_expr_prec(mem.object, PREC_UNARY);
					return wrap_prec("${obj_cmp} != NULL ? *${obj_deref} : 0", PREC_TERNARY, min_prec);
				}
				val obj_str = self.gen_expr_prec(mem.object, PREC_UNARY);
				return wrap_prec("*${obj_str}", PREC_UNARY, min_prec);
			}
			if (mem.member == "code" && self.is_char_value(mem.object)) {
				val obj_str = self.gen_expr_prec(mem.object, PREC_UNARY);
				return wrap_prec("(int32_t)(uint8_t)${obj_str}", PREC_UNARY, min_prec);
			}
		}

		if (callee is IdentifierExpr as id && id.name == "char" && call.args.len == 1) {
			return wrap_prec("(char)${self.gen_expr_prec(call.args[0], PREC_UNARY)}", PREC_UNARY, min_prec);
		}
		if (callee is IdentifierExpr as id && id.name == "str" && call.args.len == 1) {
			return "kobel_from_cstr((const char*)${self.gen_expr_prec(call.args[0], PREC_UNARY)})";
		}

		val callee_str = self.gen_expr_prec(call.callee, PREC_POSTFIX);

		var is_vararg_call = false;
		var varg_fixed_count: usz = 0;
		var varg_elem_c = "";

		var fn_info: ?*TypePayload.Fn = null;
		val mi = self.symtab?.get_resolved_method(ast_node);
		val callee_ty = self.node_type(call.callee);
		if (mi != null && mi.fn_type.kind == DataType.FN) {
			fn_info = mi.fn_type.as_fn();
		} else if (callee_ty != null && callee_ty.kind == DataType.FN) {
			fn_info = callee_ty.as_fn();
		} else if (call.callee is IdentifierExpr as callee_id) {
			val sym = self.symtab?.lookup(callee_id.name);
			if (sym != null && sym.type_ptr.kind == DataType.FN) {
				fn_info = sym.type_ptr.as_fn();
			}
		}

		if (fn_info != null && fn_info.is_variadic && fn_info.param_types.len > 0) {
			is_vararg_call = true;
			varg_fixed_count = fn_info.param_types.len - 1;
			varg_elem_c = c_type_from_type(fn_info.param_types[varg_fixed_count]);
		}

		var args_str = List<str>();
		if (is_vararg_call) {
			for (i in 0..<varg_fixed_count) {
				if (i < call.args.len) args_str += self.gen_expr(call.args[i]);
			}
			val varg_count = if (call.args.len >= varg_fixed_count) call.args.len - varg_fixed_count else 0;
			if (varg_count > 0) {
				var vargs = List<str>();
				for (i in varg_fixed_count..<call.args.len) {
					vargs += self.gen_expr(call.args[i]);
				}
				args_str += "(${varg_elem_c}[]){ ${", ".join(vargs)} }";
				args_str += "${varg_count}";
			} else {
				args_str += "NULL";
				args_str += "0";
			}
		} else {
			for (arg in call.args) args_str += self.gen_expr(arg);
		}
		val joined_args = ", ".join(args_str);

		if (
			callee_ty != null
			&& callee_ty.kind == DataType.FN
			&& self.symtab?.is_closure_call(call.callee)
		) {
			val c_fn_info = callee_ty.as_fn();
			val ret_c = c_type_from_type(c_fn_info.return_type);
			var param_c = "void*";
			for (pt in c_fn_info.param_types) {
				param_c = "${param_c}, ${c_type_from_type(pt)}";
			}
			val env_and_args = if (joined_args.empty()) "${callee_str}.env"
				else "${callee_str}.env, ${joined_args}";
			return "((${ret_c} (*)(${param_c}))${callee_str}.fn)(${env_and_args})";
		}

		// Ordinary C function call: func(arg1, arg2)
		return "${callee_str}(${joined_args})";
	}

	// Member access lowers to ./->. `str` is a struct (`kobel_str`), so `.len` and
	// `.data` emit directly as field accesses.
	fn gen_member_expr(&self, ast_node: *AstNode, mem: *MemberExpr, min_prec: i32): str {
		val obj_node = mem.object;
		val obj_ty = self.node_type(obj_node);
		if (obj_ty?.kind == DataType.ARRAY && obj_ty.as_array().length == 0 && obj_node is IdentifierExpr as id) {
			if (mem.member in ["len", "size"]) return "${id.name}_len";
			if (mem.member == "data") return "${id.name}_data";
		}
		if (obj_node is IdentifierExpr as id) {
			val sym = self.symtab?.lookup(id.name);
			if (sym != null && sym.is_vararg) {
				if (mem.member in ["len", "size"]) return "${id.name}_len";
				if (mem.member == "data") return "${id.name}_data";
			}
		}
		// A member access on a pointer value needs `->`; the receiver of a
		// non-identifier pointer is dereferenced by sema instead.
		var is_ptr = false;
		val raw_obj = obj_node;
		if (raw_obj is IdentifierExpr) {
			is_ptr = self.c_type_of(obj_node).ends_with("*");
		}
		val obj_str = self.gen_expr_prec(obj_node, PREC_POSTFIX);
		if (mem.is_safe) {
			val mem_ty = self.node_type(ast_node);
			if (mem_ty != null) {
				val mk = mem_ty.kind;
				if (mk == DataType.BOOL) {
					return wrap_prec("${obj_str} != NULL && ${obj_str}->${mem.member}", PREC_AND, min_prec);
				}
				if (mk == DataType.STR) {
					return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : kobel_null_str()", PREC_TERNARY, min_prec);
				}
				if (mem_ty.is_integer() || mem_ty.is_enum() || mk == DataType.CHAR) {
					return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : 0", PREC_TERNARY, min_prec);
				}
				if (mk in [DataType.F32, DataType.F64]) {
					return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : 0.0", PREC_TERNARY, min_prec);
				}
			}
			val unwrapped_obj = unwrap_group_expr(obj_node);
			val obj_ty = self.node_type(unwrapped_obj);
			if (obj_ty != null) {
				var inner = obj_ty;
				if (inner.kind == DataType.POINTER) inner = inner.as_pointer().pointee;
				if (inner.kind == DataType.STRUCT) {
					val st = inner.as_struct();
					for (f in st.fields) {
						if (f.name == mem.member) {
							val fk = f.type_ptr.kind;
							if (fk == DataType.BOOL) {
								return wrap_prec("${obj_str} != NULL && ${obj_str}->${mem.member}", PREC_AND, min_prec);
							}
							if (fk == DataType.STR) {
								return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : kobel_null_str()", PREC_TERNARY, min_prec);
							}
							if (f.type_ptr.is_integer() || f.type_ptr.is_enum() || fk == DataType.CHAR) {
								return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : 0", PREC_TERNARY, min_prec);
							}
							if (fk in [DataType.F32, DataType.F64]) {
								return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : 0.0", PREC_TERNARY, min_prec);
							}
							return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : NULL", PREC_TERNARY, min_prec);
						}
					}
				}
			}
			return wrap_prec("${obj_str} != NULL ? ${obj_str}->${mem.member} : NULL", PREC_TERNARY, min_prec);
		}
		if (is_ptr) return "${obj_str}->${mem.member}";
		return "${obj_str}.${mem.member}";
	}

	// Assignments lower to the matching C compound-assignment operator.
	fn gen_assign_expr(&self, asgn: *AssignExpr, min_prec: i32): str {
		val op_str = when (asgn.op) {
			TokenType.PLUS_EQUAL -> "+=";
			TokenType.MINUS_EQUAL -> "-=";
			TokenType.STAR_EQUAL -> "*=";
			TokenType.SLASH_EQUAL -> "/=";
			TokenType.PERCENT_EQUAL -> "%=";
			else -> "=";
		};
		val tgt = self.gen_expr_prec(asgn.target, PREC_POSTFIX);
		val val_s = self.gen_expr(asgn.value);
		return wrap_prec("${tgt} ${op_str} ${val_s}", PREC_ASSIGN, min_prec);
	}

	// when expressions lower to nested C ternaries, evaluated from the last arm back.
	fn gen_when_expr(&self, we: *WhenExpr, min_prec: i32): str {
		if (we.arms.empty()) return "0";
		val cond = if (we.condition != null) self.gen_expr_prec(we.condition!, PREC_POSTFIX) else "";
		val has_else = we.arms.any { arm -> arm.is_else };

		if (we.arms.len == 1) {
			val only = we.arms[0];
			if (only.is_else || !has_else) {
				return self.gen_expr_prec(only.body, min_prec);
			}
		}

		var res = "0";
		var i = we.arms.len;
		if (!has_else) {
			i--;
			res = self.gen_expr_prec(we.arms[i].body, PREC_TERNARY);
		}
		while (i > 0) {
			i--;
			val arm = we.arms[i];
			res = if (arm.is_else) self.gen_expr_prec(arm.body, PREC_TERNARY)
			else "${self.gen_when_test_prec(cond, arm.patterns, PREC_TERNARY + 1)} ? ${self.gen_expr_prec(arm.body, PREC_TERNARY + 1)} : ${res}";
		}
		return wrap_prec(res, PREC_TERNARY, min_prec);
	}

	// Tag test of a smart cast. A pointer subject is compared against NULL
	// first: reading the tag would dereference it, and a null subject matches no
	// struct pattern, so the caller takes its `else` path.
	//
	// ponytail: the subject is re-evaluated for the NULL test. Safe today
	// because every subject is a plain path (`p`, `obj.field`); upgrade by
	// hoisting `void* __subj = ...;` in statement position if a call ever
	// becomes a subject.
	pub fn gen_tag_test(
		*self, subject: str, is_ptr: bool, tag_field: str, tag_const: str
	): str => if (is_ptr) "${subject} != NULL && ${subject}->${tag_field} == ${tag_const}"
		else "${subject}.${tag_field} == ${tag_const}";

	pub fn gen_cast_expr(&self, cst: *CastExpr, min_prec: i32): str {
		val ty = c_type_from_ast(cst.target_type);
		if (ty == "kobel_str" && cst.expr != null && self.is_pointer_value(cst.expr!)) {
			return "kobel_from_cstr((const char*)${self.gen_expr_prec(cst.expr, PREC_UNARY)})";
		}
		return wrap_prec("(${ty})${self.gen_expr_prec(cst.expr, PREC_UNARY)}", PREC_UNARY, min_prec);
	}

	fn gen_is_single_test(*self, obj_str: str, info_node: *AstNode, target_node: *AstNode): str {
		val pat_info = self.is_pattern_info(info_node);
		val target_name = c_type_from_ast(target_node);
		var tag_field = pat_info.tag_field;
		if (tag_field.empty()) tag_field = "tag";
		val tag_const = if (pat_info.tag_const.empty()) "${target_name}__TAG" else pat_info.tag_const;
		return self.gen_tag_test(obj_str, pat_info.is_ptr, tag_field, tag_const);
	}

	pub fn gen_is_expr(&self, ast_node: *AstNode, is_e: *IsExpr, min_prec: i32): str {
		var prefix = "";
		var obj_str = "";
		if (is_e.expr != null) {
			val unwrapped_subj = unwrap_group_expr(is_e.expr!);
			if (unwrapped_subj != null && unwrapped_subj is MemberExpr as mem && mem.is_safe) {
				val base_wrap = self.gen_expr_prec(mem.object, PREC_POSTFIX);
				prefix = "${base_wrap} != NULL && ";
				obj_str = "${base_wrap}->${mem.member}";
			} else {
				obj_str = self.gen_expr_prec(is_e.expr!, PREC_POSTFIX);
			}
		}

		if (is_e.target_type is ArrayLiteralExpr as al) {
			var res = "";
			for (i in 0..<al.elements.len) {
				val t_node = al.elements[i];
				val raw_t = self.gen_is_single_test(obj_str, t_node, t_node);
				val t_is_ptr = self.is_pattern_info(t_node).is_ptr;
				val t_str = if (al.elements.len > 1 && t_is_ptr) "(${raw_t})" else raw_t;
				res = if (i == 0) t_str else "${res} || ${t_str}";
			}
			if (!prefix.empty()) {
				val inner = if (al.elements.len > 1) "(${res})" else res;
				return wrap_prec("${prefix}${inner}", PREC_AND, min_prec);
			}
			val r_prec = if (al.elements.len > 1) PREC_OR
				else if (!al.elements.empty() && self.is_pattern_info(al.elements[0]).is_ptr) PREC_AND
				else PREC_EQ;
			return wrap_prec(res, r_prec, min_prec);
		}

		val pat_info = self.is_pattern_info(ast_node);
		val target_name = c_type_from_ast(is_e.target_type);
		val tag_test = self.gen_is_single_test(obj_str, ast_node, is_e.target_type);
		if (!is_e.alias.empty()) {
			val cast_val = if (pat_info.is_ptr) {
				if (!pat_info.payload_path.empty()) {
					if (pat_info.payload_ptr) "${obj_str}->${pat_info.payload_path}"
					else "(${target_name}*)(&${obj_str}->${pat_info.payload_path})"
				} else {
					"(${target_name}*)${obj_str}"
				}
			} else {
				if (!pat_info.payload_path.empty()) {
					if (pat_info.payload_ptr) "${obj_str}.${pat_info.payload_path}"
					else "(${target_name}*)(&${obj_str}.${pat_info.payload_path})"
				} else {
					"(${target_name}*)&${obj_str}"
				}
			};
			return wrap_prec("${prefix}${tag_test} && (${is_e.alias} = ${cast_val}, 1)", PREC_AND, min_prec);
		}
		val r_prec = if (!prefix.empty() || pat_info.is_ptr) PREC_AND else PREC_EQ;
		return wrap_prec("${prefix}${tag_test}", r_prec, min_prec);
	}

	// Builds the test expression of a `when` arm: `c == p1 || c == p2`.
	// For the boolean form (`cond` empty) each pattern is itself the test.
	// String patterns compare with `kobel_streq`.
	pub fn gen_when_test(&self, cond: str, patterns: List<*AstNode>): str {
		return self.gen_when_test_prec(cond, patterns, PREC_NONE);
	}

	pub fn gen_when_test_prec(&self, cond: str, patterns: List<*AstNode>, min_prec: i32): str {
		if (patterns.empty()) return "1";
		val multi_or = patterns.len > 1;
		var res = "";
		var res_prec = PREC_ATOM;
		for (i in 0..<patterns.len) {
			val p = patterns[i];
			var test = "";
			var test_prec = PREC_ATOM;
			val unwrapped_p = unwrap_group_expr(p);
			if (cond.empty() || self.is_predicate_pattern(p)) {
				if (!multi_or) return self.gen_expr_prec(p, min_prec);
				test = self.gen_expr_prec(p, PREC_AND + 1);
				test_prec = PREC_AND + 1;
			} else if (p is IsExpr as is_e) {
				if (is_e.target_type is ArrayLiteralExpr as al) {
					for (k in 0..<al.elements.len) {
						val el = al.elements[k];
						val raw_el = self.gen_is_single_test(cond, el, el);
						val el_ptr = self.is_pattern_info(el).is_ptr;
						val el_test = if (al.elements.len > 1 && el_ptr) "(${raw_el})" else raw_el;
						test = if (k == 0) el_test else "${test} || ${el_test}";
					}
					test_prec = if (al.elements.len > 1) PREC_OR
						else if (!al.elements.empty() && self.is_pattern_info(al.elements[0]).is_ptr) PREC_AND
						else PREC_EQ;
				} else {
					test = self.gen_is_single_test(cond, p, is_e.target_type);
					test_prec = if (self.is_pattern_info(p).is_ptr) PREC_AND else PREC_EQ;
				}
			} else if (unwrapped_p is BinaryExpr as bin && bin.op in [TokenType.DOT_DOT, TokenType.DOT_DOT_LESS]) {
				val s = self.gen_expr_prec(bin.left, PREC_REL + 1);
				val e = self.gen_expr_prec(bin.right, PREC_REL + 1);
				val op1 = if (bin.op == TokenType.DOT_DOT) "<=" else "<";
				val op2 = if (bin.op == TokenType.DOT_DOT) ">=" else ">";
				test = "(${cond} >= ${s} && ${cond} ${op1} ${e}) || (${cond} <= ${s} && ${cond} ${op2} ${e})";
				test_prec = PREC_OR;
			} else if (p is LiteralExpr as lit) {
				if (lit.literal_kind == Literal.STRING) {
					test = "kobel_streq(${cond}, ${self.gen_expr(p)})";
					test_prec = PREC_POSTFIX;
				} else {
					test = "${cond} == ${self.gen_expr_prec(p, PREC_EQ + 1)}";
					test_prec = PREC_EQ;
				}
			} else if (self.is_str_value(p)) {
				test = "kobel_streq(${cond}, ${self.gen_expr(p)})";
				test_prec = PREC_POSTFIX;
			} else {
				test = "${cond} == ${self.gen_expr_prec(p, PREC_EQ + 1)}";
				test_prec = PREC_EQ;
			}
			if (multi_or && test_prec <= PREC_AND && test_prec != PREC_OR) {
				test = "(${test})";
			}
			res = if (i == 0) test else "${res} || ${test}";
			res_prec = if (i == 0) test_prec else PREC_OR;
		}
		if (res.empty()) return "1";
		return wrap_prec(res, res_prec, min_prec);
	}

	// C type of an expression: sema resolved it and stored the result on the
	// node, so the backend never re-derives a type from syntax or from variable
	// names. Empty for nodes that desugaring synthesised and were never checked.
	pub fn c_type_of(*self, expr: *AstNode): str {
		val ty = self.node_type(expr) ?: return "";
		return c_type_from_type(ty);
	}

	// Same, with a fallback for synthesised nodes.
	pub fn c_type_or(*self, expr: *AstNode, fallback: str): str {
		val ty = self.c_type_of(expr);
		if (ty.empty()) return fallback;
		return ty;
	}

	// True when the value is a pointer: a smart cast over a pointer casts the
	// value itself, while a struct value has to be addressed.
	pub fn is_pointer_value(*self, node: *AstNode): bool {
		val ty = self.node_type(node) ?: return false;
		return ty.kind == DataType.POINTER;
	}

	pub fn is_str_value(*self, node: *AstNode): bool {
		val ty = self.node_type(node) ?: return false;
		return ty.kind == DataType.STR;
	}

	fn is_char_value(*self, node: *AstNode): bool {
		val ty = self.node_type(node) ?: return false;
		return ty.kind == DataType.CHAR;
	}

}
