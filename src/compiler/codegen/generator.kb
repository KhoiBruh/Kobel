mod compiler.codegen;

use std.string.*;
use std.collections.*;
use std.string.StringBuilder;

use compiler.lexer.*;
use compiler.ast.*;

use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

// ============================================================================
// C99 Backend Code Generator
// ============================================================================

pub struct ConditionAlias {
	pub name: str,
	pub c_type: str,
	pub decl: str
}

impl ConditionAlias {

	pub init(name: str, c_type: str, decl: str) => Self(name, c_type, decl);

	pub op unpack(*self, name: &str, c_type: &str) {
		name.write(self.name);
		c_type.write(self.c_type);
	}

	pub op unpack(*self, name: &str, c_type: &str, decl: &str) {
		name.write(self.name);
		c_type.write(self.c_type);
		decl.write(self.decl);
	}

}

pub struct CCodeGen {
	pub out: StringBuilder,

	pub errors: List<str> = List(),
	// C element type for the array literal being emitted, when the surrounding
	// declaration already knows it (`val a: [T; N] = [...]`).
	pub array_elem_hint: str = "",
	pub yield_target: str = "",
	pub is_yield_return: bool = false,
	pub current_fn_ret_type: str = "",
	pub yield_exit_label: str = "",
	pub when_label_counter: usz = 0,
	pub destruct_counter: usz = 0,
	pub defer_nodes: List<*AstNode> = List(),
	pub scope_starts: List<usz> = List(),
	pub scope_jumped: List<bool> = List(),
	pub loop_defer_depths: List<usz> = List(),
	pub symtab: *SymbolTable? = null,
	pub active_lambda_captures: List<LambdaCapture> = List()
}

impl CCodeGen {

	pub init(symtab: *SymbolTable? = null) {
		var cg = Self(StringBuilder());
		cg.symtab = symtab;
		return cg;
	}

	pub fn node_type(*self, node: *AstNode?): *Type? {
		if (node == null || self.symtab == null) return null;
		return self.symtab!.get_node_type(node);
	}

	pub fn is_pattern_info(*self, node: *AstNode?): IsPatternInfo {
		if (node == null || self.symtab == null) return IsPatternInfo();
		return self.symtab!.get_is_pattern(node);
	}

	pub fn is_predicate_pattern(*self, node: *AstNode?): bool {
		if (node == null || self.symtab == null) return false;
		return self.symtab!.is_predicate_pattern(node);
	}

	pub fn lambda_info_of(*self, node: *AstNode?): LambdaInfo {
		if (node == null || self.symtab == null) return LambdaInfo();
		return self.symtab!.get_lambda_info(node);
	}

	pub fn enter_defer_scope(&self) {
		self.scope_starts += self.defer_nodes.len;
		self.scope_jumped += false;
	}

	pub fn add_defer(&self, stmt: *AstNode) => self.defer_nodes += stmt;

	pub fn mark_current_scope_jumped(&self) {
		if (!self.scope_jumped.empty()) {
			self.scope_jumped.pop();
			self.scope_jumped += true;
		}
	}

	pub fn exit_defer_scope(&self) {
		if (self.scope_starts.empty()) return;
		val start_idx = self.scope_starts.pop();
		val jumped = self.scope_jumped.pop();
		if (jumped || self.defer_nodes.len <= start_idx) {
			while (self.defer_nodes.len > start_idx) {
				self.defer_nodes.pop();
			}
			return;
		}
		var i = self.defer_nodes.len;
		while (i > start_idx) {
			i--;
			self.gen_statement(self.defer_nodes[i]);
		}
		while (self.defer_nodes.len > start_idx) {
			self.defer_nodes.pop();
		}
	}

	pub fn has_active_defers(*self) => !self.defer_nodes.empty();

	pub fn gen_defers_unwind(&self, depth: usz) {
		if (self.defer_nodes.empty()) return;
		val min_idx = if (depth < self.scope_starts.len) self.scope_starts[depth] else 0;
		if (self.defer_nodes.len <= min_idx) return;
		var i = self.defer_nodes.len;
		while (i > min_idx) {
			i--;
			self.gen_statement(self.defer_nodes[i]);
		}
	}

	// True when the enum carries data on at least one variant; such an enum is
	// emitted as a struct instead of a plain integer typedef.
	pub fn enum_has_payload(*self, e: *EnumDecl): bool =>
		e.members.any { m -> !m.payload.empty() };

}

pub fn c_format_int_literal(raw: str): str {
	// The suffix is stripped through `num_suffix` so a hex digit is never taken for
	// one: `0xBB` stays 187 instead of becoming `0xB` with an i8 suffix. The `_`
	// digit separators are not C syntax, so they go too.
	val sfx = raw.num_suffix();
	val body = raw.strip_suffix(sfx.len).strip_char('_');
	return when (sfx) {
		// signed integer
		"Z" -> "((intptr_t)${body}LL)";
		"L" -> "${body}LL";
		"S" -> "((int16_t)${body})";
		"B" -> "((int8_t)${body})";

		// unsigned integer
		"U" -> "${body}U";
		"UZ" -> "((size_t)${body}ULL)";
		"UL" -> "${body}ULL";
		"UB" -> "((uint8_t)${body})";
		"US" -> "((uint16_t)${body})";
		else -> body;
	};
}

pub fn c_int_literal_c_type(raw: str): str {
	val suffix = raw.num_suffix();
	return when (suffix) {
		// signed integer
		"Z" -> "intptr_t";
		"L" -> "int64_t";
		"S" -> "int16_t";
		"B" -> "int8_t";

		// unsigned integer
		"U" -> "uint32_t";
		"UZ" -> "size_t";
		"UL" -> "uint64_t";
		"US" -> "uint16_t";
		"UB" -> "uint8_t";
		else -> "int32_t";
	};
}

pub fn c_float_literal_c_type(raw: str) => if (raw.ends_with("F")) "float" else "double";

pub fn c_format_float_literal(raw: str): str {
	// `_` digit separators are not C syntax, so they are dropped first.
	val text = raw.strip_char('_');
	if (text.any { c -> c == '.' || c == 'e' || c == 'E' }) return text;

	val len = text.len;
	return when (text) {
		.ends_with("F") -> "${text.slice(0, len - 1)}.0f";
		.ends_with("D") -> "${text.slice(0, len - 1)}.0";
		else -> "${text}.0";
	};
}
