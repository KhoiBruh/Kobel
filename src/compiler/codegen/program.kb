mod compiler.codegen;

use std.collections.*;

use compiler.lexer.*;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

// ============================================================================
// Declaration Code Generation
// ============================================================================

// Generic declarations are templates: monomorphized instances are appended by
// the semantic analyzer, so the backend must skip the templates themselves.

impl CCodeGen {

	pub fn gen_program(&self, program_node: *AstNode): str {
		if (program_node is Program as prog) {
			self.out.clear();
			defer self.out.free();

			// 1. C Standard Headers & Runtime Helpers
			self.out += C_PRELUDE;

			// 2. First collect struct names, function names and return types
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is StructDecl as s -> {
						// A forward declaration and its definition are two AST nodes for
						// one C type; the declaration pass marks which one emits it.
						if (s.forward || s.emit_typedef) {
							self.out += "typedef struct ";
							self.out += s.name;
							self.out += ' ';
							self.out += s.name;
							self.out += ";\n";
						}
					}
					is EnumDecl as e -> {
						if (self.enum_has_payload(e)) {
							// A payload enum is a struct: tag + union of variant payloads.
							self.out += "typedef struct ";
							self.out += e.name;
							self.out += ' ';
							self.out += e.name;
							self.out += ";\n";
							for (i in 0..<e.members.len) {
								val m = e.members[i];
								self.out += "typedef struct ";
								self.out += e.name;
								self.out += "__";
								self.out += m.name;
								self.out += ' ';
								self.out += e.name;
								self.out += "__";
								self.out += m.name;
								self.out += ";\n";
								self.out += "#define ";
								self.out += e.name;
								self.out += "__";
								self.out += m.name;
								self.out += "__TAG ";
								self.out += i;
								self.out += '\n';
							}
						} else {
							// Enums lower to their underlying integer type; member access becomes
							// an integer literal during semantic analysis.
							val under = if (e.underlying_type != null) {
								c_type_from_ast(e.underlying_type!)
							} else "int32_t";
							self.out += "typedef ";
							self.out += under;
							self.out += ' ';
							self.out += e.name;
							self.out += ";\n";
						}
					}
					is ConstDecl as c -> {
						// Module-level constants become preprocessor macros.
						val c_val_str = if (c.value != null) self.gen_expr(c.value!) else "0";
						self.out += "#define ";
						self.out += c.name;
						self.out += ' ';
						self.out += c_val_str;
						self.out += '\n';
					}
				}
			}
			self.out += "\n\n";

			// 3. Struct bodies, in dependency order: a by-value field needs its struct
			// complete first, and a monomorphized instance may embed a struct that is
			// declared later in the program. A payload enum emits its variant structs
			// together with its tag/union struct, and may itself be embedded by value.
			var items = List<*AstNode>();
			var pending = HashSet<str>();
			defer pending.free();
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				if (decl is StructDecl as s) {
					if (!s.forward) {
						items += decl;
						pending += s.name;
					}
				} else if (decl is EnumDecl as e) {
					if (self.enum_has_payload(e)) {
						items += decl;
						pending += e.name;
					}
				}
			}
			var order = List<*AstNode>();
			defer order.free();
			var emitted = HashSet<str>();
			defer emitted.free();
			while (!items.empty()) {
				var next = List<*AstNode>();
				var progressed = false;
				for (item in items) {
					val item_name = self.body_item_name(item);
					var ready = true;
					val deps = self.body_item_deps(item);
					for (dep in deps) {
						if (dep.empty() || dep == item_name) continue;
						if (dep in emitted) continue;
						if (dep in pending) ready = false;
					}
					deps.free();
					if (ready) {
						order += item;
						emitted += item_name;
						pending.remove(item_name);
						progressed = true;
					} else {
						next += item;
					}
				}
				items.free();
				if (!progressed) {
					// A by-value cycle cannot exist in C; keep the program order.
					for (item in next) order += item;
					break;
				}
				items = next;
			}
			for (item in order) {
				if (item is StructDecl as s) self.gen_struct_decl(s);
				else if (item is EnumDecl as e) self.gen_payload_enum(e);
			}

			// 3b. List constructors (emitted after all struct types are fully defined)
			for (decl_list in prog) {
				if (
					!decl_is_template(decl_list) &&
					decl_list is StructDecl as s &&
					(
						s.name.starts_with("std__collections__list__List") ||
						s.name.starts_with("std__collections__List")
					)
				) {
					self.out += """
						static inline ${s.name} ${s.name}_from_array(const void* src, size_t n) {
							size_t elem_size = sizeof(*(((${s.name}*)0)->data));
							size_t cap = (n < 4) ? 4 : n;
							void* data = malloc(cap * elem_size);
							if (n > 0 && src != NULL) memcpy(data, src, n * elem_size);
							${s.name} l;
							l.data = data;
							l.len = n;
							l.cap = cap;
							return l;
						}
					""";
				}
			}

			// 4. Function Prototypes
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is FnDecl -> self.gen_fn_decl(decl, true, "");
					is ImplDecl as im -> {
						for (mnode in im.methods) {
							if (mnode is FnDecl as f && f.type_params.empty()) {
								self.gen_fn_decl(f, true, im.struct_name);
							}
						}
					}
				}
			}
			self.out += "\n";

			// 5. Function Implementations
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is FnDecl -> self.gen_fn_decl(decl, false, "");
					is ImplDecl as im -> {
						for (mnode in im.methods) {
							if (mnode is FnDecl as f && f.type_params.empty()) {
								self.gen_fn_decl(f, false, im.struct_name);
							}
						}
					}
				}
			}

			return self.out.to_str();
		}
		return "";
	}

	// C name of the struct a field embeds by value ("" for pointers, arrays and
	// primitives): such a struct must be emitted before the field's owner.
	fn by_value_struct_name(*self, node: *AstNode): str {
		if (node == null) return "";
		if (node is NamedType as nt) return nt.name;
		return "";
	}

	fn body_item_name(*self, item: *AstNode) => when (item) {
		is StructDecl -> item.name;
		is EnumDecl -> item.name;
		else -> "";
	};

	// Names a body item needs complete before it can be emitted.
	fn body_item_deps(*self, item: *AstNode): List<str> {
		var deps = List<str>();
		if (item is StructDecl as s) {
			for (f in s.fields) deps += self.by_value_struct_name(f.type_node);
		} else if (item is EnumDecl as e) {
			for (m in e.members) {
				for (f in m.payload) deps += self.by_value_struct_name(f.type_node);
			}
		}
		return deps;
	}

	pub fn gen_struct_decl(&self, s: *StructDecl) {
		// The definition carries the fields; a forward declaration only
		// contributes the typedef emitted in the first pass.
		if (s.forward) return;

		self.out += "struct ";
		self.out += s.name;
		self.out += " {\n";
		for (f in s.fields) {
			val ty = c_type_from_ast(f.type_node);
			self.out += "    ";
			self.out += ty;
			self.out += ' ';
			self.out += f.name;
			self.out += ";\n";
		}
		self.out += "};\n\n";
	}

	// A payload enum is emitted as a tag plus a union of one payload struct per
	// variant, so a pattern binding can point straight at the active payload.
	pub fn gen_payload_enum(&self, e: *EnumDecl) {
		if (!self.enum_has_payload(e)) return;

		for (m in e.members) {
			self.out += "struct ";
			self.out += e.name;
			self.out += "__";
			self.out += m.name;
			self.out += " {\n";
			if (m.payload.empty()) self.out += "    char __empty;\n";
			for (f in m.payload) {
				self.out += "    ";
				self.out += c_type_from_ast(f.type_node);
				self.out += ' ';
				self.out += f.name;
				self.out += ";\n";
			}
			self.out += "};\n";
		}

		self.out += "struct ";
		self.out += e.name;
		self.out += " {\n    int32_t tag;\n    union {\n";
		for (m in e.members) {
			self.out += "        struct ";
			self.out += e.name;
			self.out += "__";
			self.out += m.name;
			self.out += ' ';
			self.out += m.name;
			self.out += ";\n";
		}
		self.out += "    } u;\n};\n\n";
	}

	// `self_c_type` is the C name of the enclosing struct when generating an impl
	// method ("" for free functions). It types the untyped `self` receiver.
	pub fn gen_fn_decl(&self, f: *FnDecl, is_proto: bool, self_c_type: str) {
		val ret_ty = self.fn_ret_c_type(f);
		val f_body = f.body;
		if (!is_proto && f_body == null) return;

		if (!is_proto && f_body != null) {
			var lambdas = List<*AstNode>();
			defer lambdas.free();
			self.collect_lambdas_in_node(f_body, &lambdas);
			for (lam_node in lambdas) {
				self.gen_lambda_helper(lam_node);
			}
		}

		self.out += ret_ty;
		self.out += ' ';
		self.out += f.name;
		self.out += '(';
		if (f.params.empty()) self.out += "void";
		else {
			for (i in 0..<f.params.len) {
				if (i > 0) self.out += ", ";
				val p = f.params[i];
				if (p.type_node is VariadicType as vt) {
					val elem_c = c_type_from_ast(vt.element_type);
					self.out += "${elem_c}* ${p.name}_data, size_t ${p.name}_len";
					continue;
				}
				var p_ty = if (p.type_node != null) c_type_from_ast(p.type_node!) else "void*";

				if (
					!self_c_type.empty() &&
					p.name == "self" &&
					p.type_node == null
				) {
					if (p.mutable || p.has_val) p_ty = "${self_c_type}*";
					else p_ty = self_c_type;
				}
				self.out += p_ty;
				self.out += ' ';
				self.out += p.name;
			}
		}
		self.out += ')';

		if (is_proto) {
			self.out += ";\n";
			return;
		}

		self.current_fn_ret_type = ret_ty;

		self.defer_nodes.clear();
		self.scope_starts.clear();
		self.scope_jumped.clear();
		self.loop_defer_depths.clear();

		self.out += " {\n";

		when (f_body) {
			is BlockStmt as blk -> self.gen_block_body(f_body!);
			is ExprStmt as es -> {
				val es_e = es.expr;
				var is_special = false;
				if (ret_ty != "void" && es_e != null) {
					if (es_e is WhenExpr as we && we.has_blocks()) {
						self.gen_when_with_target(we, "", true);
						is_special = true;
					}
					var es_candidate = es_e;
					while (es_candidate != null) {
						if (es_candidate is GroupExpr as g) es_candidate = g.expr;
						else break;
					}

					if (
						!is_special &&
						es_candidate is BinaryExpr as bin &&
						bin.op == TokenType.QUESTION_COLON
					) {
						val is_str_ret = ret_ty == "kobel_str" || self.is_str_value(bin.left);
						val not_null_chk = if (is_str_ret) ".data != NULL" else " != NULL";
						self.out += "    ";
						self.out += ret_ty;
						self.out += " __ret_tmp;\n";
						var cur = es_candidate;
						while (cur != null) {
							while (cur != null) {
								if (cur is GroupExpr as g) cur = g.expr;
								else break;
							}
							if (cur == null) break;
							if (cur is BinaryExpr as b && b.op == TokenType.QUESTION_COLON) {
								self.out += "    __ret_tmp = ";
								self.out += self.gen_expr(b.left);
								self.out += ";\n    if (__ret_tmp";
								self.out += not_null_chk;
								self.out += ") return __ret_tmp;\n";
								cur = b.right;
							} else {
								self.out += "    return ";
								self.out += self.gen_expr(cur);
								self.out += ";\n";
								break;
							}
						}
						is_special = true;
					}
				}

				if (!is_special) {
					if (ret_ty == "void") {
						self.out += "    ";
						self.out += self.gen_expr(es.expr);
						self.out += ";\n";
					} else {
						self.out += "    return ";
						self.out += self.gen_expr(es.expr);
						self.out += ";\n";
					}
				}
			}
		}

		self.out += "}\n\n";
	}

// ============================================================================
// Full Program Code Generation
// ============================================================================

// C return type of a function: explicit annotation, else inferred from an
// arrow body (used by both the prototype and the definition).
	pub fn fn_ret_c_type(*self, f: *FnDecl): str {
		if (f.return_type != null) return c_type_from_ast(f.return_type!);

		val f_body = f.body;
		if (f_body is ExprStmt) {
			val ty = self.c_type_of(f_body.expr);
			if (!ty.empty()) return ty;
		}
		return "void";
	}

	pub fn collect_lambdas_in_node(*self, node: *AstNode?, var out: &List<*AstNode>) {
		if (node == null) return;
		val cur = node!;
		when (cur) {
			is LambdaExpr as lam -> {
				self.collect_lambdas_in_node(lam.body, out);
				out += cur;
			}
			is BlockStmt as b -> {
				for (s in b.statements) self.collect_lambdas_in_node(s, out);
			}
			is ExprStmt as e -> self.collect_lambdas_in_node(e.expr, out);
			is VarDeclStmt as v -> self.collect_lambdas_in_node(v.initializer, out);
			is DestructDeclStmt as d -> self.collect_lambdas_in_node(d.initializer, out);
			is IfStmt as s -> {
				self.collect_lambdas_in_node(s.condition, out);
				self.collect_lambdas_in_node(s.then_branch, out);
				self.collect_lambdas_in_node(s.else_branch, out);
			}
			is WhileStmt as w -> {
				self.collect_lambdas_in_node(w.condition, out);
				self.collect_lambdas_in_node(w.body, out);
			}
			is ForStmt as f -> {
				self.collect_lambdas_in_node(f.iterable, out);
				self.collect_lambdas_in_node(f.range_start, out);
				self.collect_lambdas_in_node(f.range_end, out);
				self.collect_lambdas_in_node(f.body, out);
			}
			is ReturnStmt as r -> self.collect_lambdas_in_node(r.value, out);
			is YieldStmt as y -> self.collect_lambdas_in_node(y.value, out);
			is DeferStmt as d -> self.collect_lambdas_in_node(d.body, out);
			is WhenStmt as w -> {
				self.collect_lambdas_in_node(w.condition, out);
				for (arm in w.arms) {
					for (p in arm.patterns) self.collect_lambdas_in_node(p, out);
					self.collect_lambdas_in_node(arm.body, out);
				}
			}
			is CallExpr as c -> {
				self.collect_lambdas_in_node(c.callee, out);
				for (a in c.args) self.collect_lambdas_in_node(a, out);
			}
			is BinaryExpr as b -> {
				self.collect_lambdas_in_node(b.left, out);
				self.collect_lambdas_in_node(b.right, out);
			}
			is UnaryExpr as u -> self.collect_lambdas_in_node(u.operand, out);
			is MemberExpr as m -> self.collect_lambdas_in_node(m.object, out);
			is IndexExpr as ix -> {
				self.collect_lambdas_in_node(ix.target, out);
				self.collect_lambdas_in_node(ix.index, out);
			}
			is AssignExpr as a -> {
				self.collect_lambdas_in_node(a.target, out);
				self.collect_lambdas_in_node(a.value, out);
			}
			is UpdateExpr as u -> self.collect_lambdas_in_node(u.target, out);
			is CastExpr as cst -> self.collect_lambdas_in_node(cst.expr, out);
			is GroupExpr as g -> self.collect_lambdas_in_node(g.expr, out);
			is IfExpr as ie -> {
				self.collect_lambdas_in_node(ie.condition, out);
				self.collect_lambdas_in_node(ie.then_branch, out);
				self.collect_lambdas_in_node(ie.else_branch, out);
			}
			is ArrayLiteralExpr as al -> {
				for (el in al.elements) self.collect_lambdas_in_node(el, out);
			}
			is WhenExpr as we -> {
				self.collect_lambdas_in_node(we.condition, out);
				for (arm in we.arms) {
					for (p in arm.patterns) self.collect_lambdas_in_node(p, out);
					self.collect_lambdas_in_node(arm.body, out);
				}
			}
			is StructCtorExpr as sc -> {
				for (a in sc.args) self.collect_lambdas_in_node(a, out);
			}
			is EnumCtorExpr as ec -> {
				for (a in ec.args) self.collect_lambdas_in_node(a, out);
			}
		}
	}

	pub fn gen_lambda_helper(&self, node: *AstNode) {
		if (node is LambdaExpr as lam) {
			val info = self.lambda_info_of(node);
			if (info.id == 0 || info.fn_type == null) return;
			val fn_info = info.fn_type!.as_fn();
			val ret_c = c_type_from_type(fn_info.return_type);

			if (!info.captures.empty()) {
				self.out += "struct __lambda_env_";
				self.out += info.id;
				self.out += " {\n";
				for (cap in info.captures) {
					val cap_c = if (cap.ty != null) c_type_from_type(cap.ty!) else "int32_t";
					self.out += "    ";
					self.out += cap_c;
					if (cap.is_mutable) self.out += '*';
					self.out += ' ';
					self.out += cap.name;
					self.out += ";\n";
				}
				self.out += "};\n\n";
			}

			self.out += "static ";
			self.out += ret_c;
			self.out += " __lambda_fn_";
			self.out += info.id;
			self.out += "(void* __raw_env";
			for (i in 0..<lam.params.len) {
				val p = lam.params[i];
				val p_c = if (i < fn_info.param_types.len) c_type_from_type(fn_info.param_types[i]) else "int32_t";
				self.out += ", ";
				self.out += p_c;
				self.out += ' ';
				self.out += p.name;
			}
			self.out += ") {\n";
			if (!info.captures.empty()) {
				self.out += "    struct __lambda_env_";
				self.out += info.id;
				self.out += "* __env = (struct __lambda_env_";
				self.out += info.id;
				self.out += "*)__raw_env;\n";
			} else {
				self.out += "    (void)__raw_env;\n";
			}

			val saved_ret_ty = self.current_fn_ret_type;
			val saved_yield_ret = self.is_yield_return;
			val saved_yield_target = self.yield_target;
			val saved_yield_exit = self.yield_exit_label;
			val saved_captures = self.active_lambda_captures;
			val saved_defers = self.defer_nodes.clone();
			val saved_starts = self.scope_starts.clone();
			val saved_jumped = self.scope_jumped.clone();
			val saved_loop_depths = self.loop_defer_depths.clone();

			self.current_fn_ret_type = ret_c;
			self.is_yield_return = true;
			self.yield_target = "";
			self.yield_exit_label = "";
			self.active_lambda_captures = info.captures;
			self.defer_nodes.clear();
			self.scope_starts.clear();
			self.scope_jumped.clear();
			self.loop_defer_depths.clear();

			if (lam.body is BlockStmt) {
				self.gen_block_body(lam.body);
			} else if (ret_c == "void") {
				self.out += "    ";
				self.out += self.gen_expr(lam.body);
				self.out += ";\n";
			} else if (lam.body is WhenExpr as we && we.has_blocks()) {
				self.gen_when_with_target(we, "", true);
			} else {
				self.out += "    return ";
				self.out += self.gen_expr(lam.body);
				self.out += ";\n";
			}

			self.current_fn_ret_type = saved_ret_ty;
			self.is_yield_return = saved_yield_ret;
			self.yield_target = saved_yield_target;
			self.yield_exit_label = saved_yield_exit;
			self.active_lambda_captures = saved_captures;
			self.defer_nodes = saved_defers;
			self.scope_starts = saved_starts;
			self.scope_jumped = saved_jumped;
			self.loop_defer_depths = saved_loop_depths;

			self.out += "}\n\n";
		}
	}

}
