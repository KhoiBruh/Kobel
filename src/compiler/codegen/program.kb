mod compiler.codegen;

use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

// ============================================================================
// Declaration Code Generation
// ============================================================================

// Generic declarations are templates: monomorphized instances are appended by
// the semantic analyzer, so the backend must skip the templates themselves.

impl CCodeGen {

	pub fn gen_program(&self, program_node: *AstNode): str {
		if (program_node is Program as prog) {
			self.out.clear();
			defer self.out.free();

			// 1. C Standard Headers & Runtime Helpers & Reachability Analysis
			self.out += C_PRELUDE;
			val live = self.compute_reachable(prog);
			defer live.free();

			// 2. First collect struct names, function names and return types
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is StructDecl as s -> {
						if (!live.has_type(s.name)) continue;
						// A forward declaration and its definition are two AST nodes for
						// one C type; the declaration pass marks which one emits it.
						if (s.forward || s.emit_typedef) {
							self.out += "typedef struct ";
							self.out += s.name;
							self.out += ' ';
							self.out += s.name;
							self.out += ";\n";
						}
					}
					is EnumDecl as e -> {
						if (!live.has_type(e.name)) continue;
						if (self.enum_has_payload(e)) {
							self.gen_tagged_typedefs(e.name, e.members);
						} else {
							// Enums lower to their underlying integer type; member access becomes
							// an integer literal during semantic analysis.
							val under = if (e.underlying_type != null) {
								c_type_from_ast(e.underlying_type!)
							} else "int32_t";
							self.out += "typedef ";
							self.out += under;
							self.out += ' ';
							self.out += e.name;
							self.out += ";\n";
						}
					}
					is FaultDecl as flt -> {
						if (!live.has_type(flt.name)) continue;
						self.gen_tagged_typedefs(flt.name, flt.members);
					}
					is ConstDecl as c -> {
						if (!live.has_const(c.name)) continue;
						self.gen_const_macro(c);
					}
					is ObjectDecl as obj -> {
						for (cnode in obj.consts) {
							if (cnode is ConstDecl as c && live.has_const(c.name)) {
								self.gen_const_macro(c);
							}
						}
					}
				}
			}
			for (eu in live.error_unions) {
				self.out += "typedef struct ";
				self.out += eu.c_name;
				self.out += ' ';
				self.out += eu.c_name;
				self.out += ";\n";
			}
			self.out += "\n\n";
			self.gen_fault_runtime_helpers(prog, &live);

			// 3. Struct bodies, in dependency order: a by-value field needs its struct
			// complete first, and a monomorphized instance may embed a struct that is
			// declared later in the program. A payload enum / fault emits its variant
			// structs together with its tag/union struct, and ErrorUnions emit after their ok/err types.
			var items = List<&AstNode>();
			var eu_items = List<ErrorUnionDesc>();
			var pending = HashSet<str>();
			defer pending.free();
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is StructDecl as s -> if (
						!s.forward &&
						live.has_type(s.name)
					) {
						items += decl;
						pending += s.name;
					}

					is EnumDecl as e -> if (
						self.enum_has_payload(e) &&
						live.has_type(e.name)
					) {
						items += decl;
						pending += e.name;
					}

					is FaultDecl as flt -> if (live.has_type(flt.name)) {
						items += decl;
						pending += flt.name;
					}
				}
			}
			for (eu in live.error_unions) {
				eu_items += eu;
				pending += eu.c_name;
			}
			var order = List<&AstNode>();
			defer order.free();
			var emitted = HashSet<str>();
			defer emitted.free();
			while (!items.empty() || !eu_items.empty()) {
				var next = List<&AstNode>();
				var next_eu = List<ErrorUnionDesc>();
				var progressed = false;
				for (item in items) {
					val item_name = self.body_item_name(item);
					var ready = true;
					val deps = self.body_item_deps(item);
					for (dep in deps) {
						if (dep.empty() || dep == item_name) continue;
						if (dep in emitted) continue;
						if (dep in pending) ready = false;
					}
					deps.free();
					if (ready) {
						order += item;
						emitted += item_name;
						pending.remove(item_name);
						progressed = true;
					} else {
						next += item;
					}
				}
				items.free();
				for (eu in eu_items) {
					var ready = true;
					for (dep in eu.deps) {
						if (dep.empty() || dep == eu.c_name) continue;
						if (dep in emitted) continue;
						if (dep in pending) ready = false;
					}
					if (ready) {
						for (em in order) {
							if (em is StructDecl as s) self.gen_struct_decl(s);
							else if (em is EnumDecl as e) self.gen_payload_enum(e);
							else if (em is FaultDecl as flt) self.gen_fault_decl(flt);
						}
						order.clear();
						self.gen_error_union_decl(eu);
						emitted += eu.c_name;
						pending.remove(eu.c_name);
						progressed = true;
					} else {
						next_eu += eu;
					}
				}
				eu_items.free();
				items = next;
				eu_items = next_eu;
				if (!progressed) {
					for (item in items) {
						if (item is StructDecl as s) self.gen_struct_decl(s);
						else if (item is EnumDecl as e) self.gen_payload_enum(e);
						else if (item is FaultDecl as flt) self.gen_fault_decl(flt);
					}
					for (eu in eu_items) self.gen_error_union_decl(eu);
					items.free();
					eu_items.free();
					break;
				}
			}
			for (item in order) {
				if (item is StructDecl as s) self.gen_struct_decl(s);
				else if (item is EnumDecl as e) self.gen_payload_enum(e);
				else if (item is FaultDecl as flt) self.gen_fault_decl(flt);
			}

			// 4. Function Prototypes
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is FnDecl -> {
						if (live.has_fn(decl.name)) self.gen_fn_decl(decl, true, "");
					}
					is ImplDecl as im -> {
						for (mnode in im.methods) {
							if (mnode is FnDecl as f && f.type_params.empty() && live.has_fn(f.name)) {
								self.gen_fn_decl(f, true, im.struct_name);
							}
						}
					}
					is ObjectDecl as obj -> {
						for (mnode in obj.methods) {
							if (mnode is FnDecl as f && f.type_params.empty() && live.has_fn(f.name)) {
								self.gen_fn_decl(f, true, "");
							}
						}
					}
				}
			}
			self.out += "\n";

			// 5. Function Implementations
			for (decl in prog) {
				if (decl_is_template(decl)) continue;
				when (decl) {
					is FnDecl -> {
						if (live.has_fn(decl.name)) self.gen_fn_decl(decl, false, "");
					}
					is ImplDecl as im -> {
						for (mnode in im.methods) {
							if (mnode is FnDecl as f && f.type_params.empty() && live.has_fn(f.name)) {
								self.gen_fn_decl(f, false, im.struct_name);
							}
						}
					}
					is ObjectDecl as obj -> {
						for (mnode in obj.methods) {
							if (mnode is FnDecl as f && f.type_params.empty() && live.has_fn(f.name)) {
								self.gen_fn_decl(f, false, "");
							}
						}
					}
				}
			}

			return self.out.to_str();
		}
		return "";
	}

	fn gen_const_macro(&self, c: *ConstDecl) {
		val c_val_str = if (c.value != null) self.gen_expr_prec(c.value!, PREC_POSTFIX) else "0";
		self.out += "#define ";
		self.out += c.name;
		self.out += ' ';
		self.out += c_val_str;
		self.out += '\n';
	}

	// C name of the struct a field embeds by value ("" for pointers, arrays and
	// primitives): such a struct must be emitted before the field's owner.
	fn by_value_struct_name(*self, node: *AstNode): str {
		if (node == null) return "";
		if (node is NamedType as nt) return nt.name;
		if (node is ErrorUnionType as eu) return eu_c_name_from_ast(eu);
		return "";
	}

	fn body_item_name(*self, item: *AstNode) => when (item) {
		is StructDecl -> item.name;
		is EnumDecl -> item.name;
		is FaultDecl -> item.name;
		else -> "";
	};

	// Names a body item needs complete before it can be emitted.
	fn body_item_deps(*self, item: *AstNode): List<str> {
		var deps = List<str>();
		if (item is StructDecl as s) {
			for (f in s.fields) deps += self.by_value_struct_name(f.type_node);
		} else if (item is EnumDecl as e) {
			for (m in e.members) {
				for (f in m.payload) deps += self.by_value_struct_name(f.type_node);
			}
		} else if (item is FaultDecl as flt) {
			for (m in flt.members) {
				for (f in m.payload) deps += self.by_value_struct_name(f.type_node);
			}
		}
		return deps;
	}

	pub fn gen_struct_decl(&self, s: *StructDecl) {
		// The definition carries the fields; a forward declaration only
		// contributes the typedef emitted in the first pass.
		if (s.forward) return;

		self.out += "struct ";
		self.out += s.name;
		self.out += " {\n";
		for (f in s.fields) {
			val ty = c_type_from_ast(f.type_node);
			self.out += "    ";
			self.out += ty;
			self.out += ' ';
			self.out += f.name;
			self.out += ";\n";
		}
		self.out += "};\n\n";
	}

	fn gen_tagged_typedefs(&self, name: str, members: List<EnumMember>) {
		self.out += "typedef struct ";
		self.out += name;
		self.out += ' ';
		self.out += name;
		self.out += ";\n";
		for (i in 0..<members.len) {
			val m = members[i];
			self.out += "typedef struct ";
			self.out += name;
			self.out += "__";
			self.out += m.name;
			self.out += ' ';
			self.out += name;
			self.out += "__";
			self.out += m.name;
			self.out += ";\n";
			self.out += "#define ";
			self.out += name;
			self.out += "__";
			self.out += m.name;
			self.out += "__TAG ";
			self.out += i;
			self.out += '\n';
		}
	}

	fn gen_tagged_struct(&self, name: str, members: List<EnumMember>, is_fault: bool = false) {
		for (m in members) {
			self.out += "struct ";
			self.out += name;
			self.out += "__";
			self.out += m.name;
			self.out += " {\n";
			if (m.payload.empty()) self.out += "    char __empty;\n";
			for (f in m.payload) {
				self.out += "    ";
				self.out += c_type_from_ast(f.type_node);
				self.out += ' ';
				self.out += f.name;
				self.out += ";\n";
			}
			self.out += "};\n";
		}

		self.out += "struct ";
		self.out += name;
		self.out += " {\n    int32_t tag;\n";
		if (is_fault) {
			self.out += "    uint32_t __err_code;\n    kobel_loc __origin;\n";
		}
		self.out += "    union {\n";
		for (m in members) {
			self.out += "        struct ";
			self.out += name;
			self.out += "__";
			self.out += m.name;
			self.out += ' ';
			self.out += m.name;
			self.out += ";\n";
		}
		self.out += "    } u;\n};\n\n";
	}

	// A payload enum is emitted as a tag plus a union of one payload struct per
	// variant, so a pattern binding can point straight at the active payload.
	pub fn gen_payload_enum(&self, e: *EnumDecl) {
		if (!self.enum_has_payload(e)) return;
		self.gen_tagged_struct(e.name, e.members, false);
	}

	fn gen_fault_runtime_helpers(&self, prog: *Program, live: *ReachableSet) {
		var has_faults = !live.error_unions.empty() || (self.symtab?.sem?.main_uses_any_fault);
		if (!has_faults) {
			for (decl in prog) {
				if (!decl_is_template(decl) && decl is FaultDecl as flt && live.has_type(flt.name)) {
					has_faults = true;
					break;
				}
			}
		}
		if (!has_faults) return;

		self.out += "static inline kobel_fault_meta __kobel_lookup_fault(uint32_t code) {\n";
		self.out += "    switch (code) {\n";
		for (decl in prog) {
			if (decl_is_template(decl)) continue;
			if (decl is FaultDecl as flt && live.has_type(flt.name)) {
				val short_name = c_escape_str(short_symbol_name(flt.name));
				for (m in flt.members) {
					if (m.err_code == 0) continue;
					val m_name = "${short_name}.${m.name}";
					val m_desc = if (!m.description.empty()) m.description else m_name;
					self.out += "        case ${m.err_code}U: return (kobel_fault_meta){ ${m.err_code}U, \"${m_name}\", \"${m_desc}\" };\n";
				}
			}
		}
		self.out += "        default: return (kobel_fault_meta){ code, \"UnknownFault\", \"Unknown error\" };\n";
		self.out += "    }\n}\n\n";

		self.out += """static inline void __kobel_report_fault(
    const char* kind,
    uint32_t code,
    kobel_loc origin,
    kobel_loc fail_at
) {
    kobel_fault_meta meta = __kobel_lookup_fault(code);
    if (meta.desc && meta.name && strcmp(meta.desc, meta.name) != 0) {
        fprintf(stderr, "panic: %s E%04u (%s): %s\\n", kind, (unsigned)code, meta.name, meta.desc);
    } else if (meta.name) {
        fprintf(stderr, "panic: %s E%04u (%s)\\n", kind, (unsigned)code, meta.name);
    } else {
        fprintf(stderr, "panic: %s E%04u\\n", kind, (unsigned)code);
    }
    if (origin.file && origin.file[0] != 0) {
        fprintf(stderr, "  origin: %s:%zu:%zu", origin.file, origin.line, origin.col);
        if (origin.fn && origin.fn[0] != 0) fprintf(stderr, " in %s", origin.fn);
        fputc(10, stderr);
    }
    if (fail_at.file && fail_at.file[0] != 0) {
        bool same = origin.file && strcmp(origin.file, fail_at.file) == 0
            && origin.line == fail_at.line && origin.col == fail_at.col;
        if (!same) {
            fprintf(stderr, "  at:     %s:%zu:%zu", fail_at.file, fail_at.line, fail_at.col);
            if (fail_at.fn && fail_at.fn[0] != 0) fprintf(stderr, " in %s", fail_at.fn);
            fputc(10, stderr);
        }
    }
}

""";
	}

	pub fn gen_fault_decl(&self, flt: *FaultDecl) {
		self.gen_tagged_struct(flt.name, flt.members, true);
		val short_name = short_symbol_name(flt.name);
		self.out += "static inline kobel_str __kobel_fault_str_${flt.name}(${flt.name} e) {\n";
		self.out += "    switch (e.tag) {\n";
		for (i in 0..<flt.members.len) {
			val m = flt.members[i];
			self.out += "        case ${i}: return KOBEL_STR(\"${short_name}.${m.name}\");\n";
		}
		self.out += "        default: return KOBEL_STR(\"${short_name}\");\n";
		self.out += "    }\n}\n\n";
	}

	pub fn gen_error_union_decl(&self, eu: ErrorUnionDesc) {
		self.out += "struct ${eu.c_name} {\n    bool is_ok;\n    union {\n";
		if (!eu.ok_is_void) {
			self.out += "        ${eu.ok_c} ok;\n";
		}
		self.out += "        ${eu.err_c} err;\n    } u;\n};\n\n";

		val unwrap_ret = if (eu.ok_is_void) "void" else eu.ok_c;
		self.out += "static inline ${unwrap_ret} __kobel_unwrap_${eu.c_name}(${eu.c_name} r, const char* file, size_t line, size_t col, const char* fn) {\n";
		self.out += "    if (!r.is_ok) {\n";
		self.out += "        kobel_loc at = { file, line, col, fn };\n";
		self.out += "        __kobel_report_fault(\"unwrapped error\", r.u.err.__err_code, r.u.err.__origin, at);\n";
		self.out += "        exit(1);\n";
		self.out += "    }\n";
		if (!eu.ok_is_void) {
			self.out += "    return r.u.ok;\n";
		}
		self.out += "}\n\n";
	}

	fn ast_is_none_or_null(*self, node: ?*AstNode): bool {
		if (node == null) return true;
		if (node is NamedType as nt) return nt.name == "none";
		return false;
	}

	fn fn_display_name_for_c(*self, f: *FnDecl): str {
		if (f.name == "main") return "main";
		return short_symbol_name(f.name, f.module);
	}

	// `self_c_type` is the C name of the enclosing struct when generating an impl
	// method ("" for free functions). It types the untyped `self` receiver.
	pub fn gen_fn_decl(&self, f: *FnDecl, is_proto: bool, self_c_type: str) {
		val ret_ty = self.fn_ret_c_type(f);
		val f_body = f.body;
		if (!is_proto && f_body == null) return;

		val is_any_fault_main = f.name == "main" && f.return_type == null
			&& self.symtab?.sem?.main_uses_any_fault;
		val is_eu_main = f.name == "main" && !is_any_fault_main && ret_ty.starts_with("__kobel_eu_");
		val is_plain_main = f.name == "main" && !is_any_fault_main && !is_eu_main && ret_ty == "void";
		val is_wrapped_main = is_any_fault_main || is_eu_main || is_plain_main;
		val eff_ret_ty = if (is_any_fault_main) "__kobel_main_result" else ret_ty;
		val c_fn_name = if (is_wrapped_main) "__kobel_user_main" else f.name;
		if (is_wrapped_main) self.out += "static ";

		if (!is_proto && f_body != null) {
			var lambdas = List<&AstNode>();
			defer lambdas.free();
			self.collect_lambdas_in_node(f_body, &lambdas);
			for (lam_node in lambdas) {
				self.gen_lambda_helper(lam_node);
			}
		}

		self.out += eff_ret_ty;
		self.out += ' ';
		self.out += c_fn_name;
		self.out += '(';
		if (is_eu_main) {
			self.out += "kobel_loc* __fail_loc_out";
			if (!f.params.empty()) self.out += ", ";
		}
		if (f.params.empty() && !is_eu_main) self.out += "void";
		else {
			for (i in 0..<f.params.len) {
				if (i > 0) self.out += ", ";
				val p = f.params[i];
				if (p.type_node is VariadicType as vt) {
					val elem_c = c_type_from_ast(vt.element_type);
					self.out += "${elem_c}* ${p.name}_data, size_t ${p.name}_len";
					continue;
				}
				var p_ty = if (p.type_node != null) c_type_from_ast(p.type_node!) else "void*";

				if (
					!self_c_type.empty() &&
					p.name == "self" &&
					p.type_node == null
				) {
					p_ty = when (p.receiver) {
						ReceiverKind.PTR_CONST, ReceiverKind.PTR_MUT -> "${self_c_type}*";
						else -> self_c_type;
					};
				}
				self.out += p_ty;
				self.out += ' ';
				self.out += p.name;
			}
		}
		self.out += ')';

		if (is_proto) {
			self.out += ";\n";
			return;
		}

		self.current_fn_ret_type = eff_ret_ty;
		self.current_fn_display_name = self.fn_display_name_for_c(f);
		self.in_eu_main = is_eu_main;

		self.defer_nodes.clear();
		self.scope_starts.clear();
		self.scope_jumped.clear();
		self.loop_defer_depths.clear();

		self.out += " {\n";

		when (f_body) {
			is BlockStmt as blk -> self.gen_block_body(f_body!);
			is ExprStmt as es -> {
				val es_e = es.expr;
				var is_special = false;
				if (ret_ty != "void" && es_e != null) {
					if (es_e is WhenExpr as we && we.has_blocks()) {
						self.gen_when_with_target(we, "", true);
						is_special = true;
					}
					var es_candidate = es_e;
					while (es_candidate != null) {
						if (es_candidate is GroupExpr as g) es_candidate = g.expr;
						else break;
					}

					if (
						!is_special &&
						es_candidate is BinaryExpr as bin &&
						bin.op == TokenType.QUESTION_COLON
					) {
						val is_str_ret = ret_ty == "kobel_str" || self.is_str_value(bin.left);
						val not_null_chk = if (is_str_ret) ".data != NULL" else " != NULL";
						self.out += "    ";
						self.out += ret_ty;
						self.out += " __ret_tmp;\n";
						var cur = es_candidate;
						while (cur != null) {
							while (cur != null) {
								if (cur is GroupExpr as g) cur = g.expr;
								else break;
							}
							if (cur == null) break;
							if (cur is BinaryExpr as b && b.op == TokenType.QUESTION_COLON) {
								self.out += "    __ret_tmp = ";
								self.out += self.gen_expr(b.left);
								self.out += ";\n    if (__ret_tmp";
								self.out += not_null_chk;
								self.out += ") return __ret_tmp;\n";
								cur = b.right;
							} else {
								self.out += "    return ";
								self.out += self.gen_expr(cur);
								self.out += ";\n";
								break;
							}
						}
						is_special = true;
					}
				}

				if (!is_special) {
					if (ret_ty == "void") {
						self.out += "    ";
						self.out += self.gen_expr(es.expr);
						self.out += ";\n";
					} else {
						self.out += "    return ";
						self.out += self.gen_expr(es.expr);
						self.out += ";\n";
					}
				}
			}
		}

		if (is_any_fault_main && f_body is BlockStmt) {
			self.out += "    return (__kobel_main_result){ .is_ok = true };\n";
		} else if (
			f_body is BlockStmt &&
			f.return_type != null &&
			f.return_type! is ErrorUnionType as eu &&
			self.ast_is_none_or_null(eu.ok_type)
		) {
			self.out += "    return (${ret_ty}){ .is_ok = true };\n";
		}

		self.in_eu_main = false;
		self.current_fn_display_name = "";
		self.out += "}\n\n";

		if (is_wrapped_main) {
			val has_cli_args = f.params.len == 2;
			val sig = if (has_cli_args) "int main(int argc, char** argv)" else "int main(void)";
			val args_pass = if (has_cli_args) "(int32_t)argc, (const char**)argv" else "";
			self.out += "${sig} {\n";
			if (is_plain_main) {
				self.out += "    __kobel_user_main(${args_pass});\n";
				self.out += "    return 0;\n";
			} else if (is_any_fault_main) {
				self.out += "    __kobel_main_result __eu_main = __kobel_user_main(${args_pass});\n";
				self.out += "    if (!__eu_main.is_ok) {\n";
				self.out += "        __kobel_report_fault(\"unhandled error in main\", __eu_main.code, __eu_main.origin, __eu_main.fail_at);\n";
				self.out += "        return 1;\n";
				self.out += "    }\n";
				self.out += "    return 0;\n";
			} else if (f.return_type != null && f.return_type! is ErrorUnionType as meu) {
				val sep = if (has_cli_args) ", " else "";
				self.out += "    kobel_loc __main_fail_loc = { NULL, 0, 0, \"main\" };\n";
				self.out += "    ${ret_ty} __eu_main = __kobel_user_main(&__main_fail_loc${sep}${args_pass});\n";
				self.out += "    if (!__eu_main.is_ok) {\n";
				self.out += "        __kobel_report_fault(\"unhandled error in main\", __eu_main.u.err.__err_code, __eu_main.u.err.__origin, __main_fail_loc);\n";
				self.out += "        return 1;\n";
				self.out += "    }\n";
				self.out += "    return 0;\n";
			}
			self.out += "}\n\n";
		}
	}

// ============================================================================
// Full Program Code Generation
// ============================================================================

// C return type of a function: explicit annotation, else inferred from an
// arrow body (used by both the prototype and the definition).
	pub fn fn_ret_c_type(*self, f: *FnDecl): str {
		if (f.name == "main" && f.return_type == null) return "void";
		if (f.return_type != null) return c_type_from_ast(f.return_type!);

		val f_body = f.body;
		if (f_body is ExprStmt) {
			val ty = self.c_type_of(f_body.expr);
			if (!ty.empty()) return ty;
		}
		return "void";
	}

	pub fn collect_lambdas_in_node(*self, node: ?&AstNode, out: &List<&AstNode>) {
		if (node == null) return;
		val cur = node!;
		when (cur) {
			is LambdaExpr as lam -> {
				self.collect_lambdas_in_node(lam.body, out);
				out += cur;
			}
			is BlockStmt as b -> {
				for (s in b.statements) self.collect_lambdas_in_node(s, out);
			}
			is ExprStmt as e -> self.collect_lambdas_in_node(e.expr, out);
			is VarDeclStmt as v -> self.collect_lambdas_in_node(v.initializer, out);
			is DestructDeclStmt as d -> self.collect_lambdas_in_node(d.initializer, out);
			is IfStmt as s -> {
				self.collect_lambdas_in_node(s.condition, out);
				self.collect_lambdas_in_node(s.then_branch, out);
				self.collect_lambdas_in_node(s.else_branch, out);
			}
			is WhileStmt as w -> {
				self.collect_lambdas_in_node(w.condition, out);
				self.collect_lambdas_in_node(w.body, out);
			}
			is ForStmt as f -> {
				self.collect_lambdas_in_node(f.iterable, out);
				self.collect_lambdas_in_node(f.range_start, out);
				self.collect_lambdas_in_node(f.range_end, out);
				self.collect_lambdas_in_node(f.body, out);
			}
			is ReturnStmt as r -> self.collect_lambdas_in_node(r.value, out);
			is YieldStmt as y -> self.collect_lambdas_in_node(y.value, out);
			is DeferStmt as d -> self.collect_lambdas_in_node(d.body, out);
			is WhenStmt as w -> {
				self.collect_lambdas_in_node(w.condition, out);
				for (arm in w.arms) {
					for (p in arm.patterns) self.collect_lambdas_in_node(p, out);
					self.collect_lambdas_in_node(arm.body, out);
				}
			}
			is CallExpr as c -> {
				self.collect_lambdas_in_node(c.callee, out);
				for (a in c.args) self.collect_lambdas_in_node(a, out);
			}
			is BinaryExpr as b -> {
				self.collect_lambdas_in_node(b.left, out);
				self.collect_lambdas_in_node(b.right, out);
			}
			is UnaryExpr as u -> self.collect_lambdas_in_node(u.operand, out);
			is MemberExpr as m -> self.collect_lambdas_in_node(m.object, out);
			is IndexExpr as ix -> {
				self.collect_lambdas_in_node(ix.target, out);
				self.collect_lambdas_in_node(ix.index, out);
			}
			is AssignExpr as a -> {
				self.collect_lambdas_in_node(a.target, out);
				self.collect_lambdas_in_node(a.value, out);
			}
			is UpdateExpr as u -> self.collect_lambdas_in_node(u.target, out);
			is CastExpr as cst -> self.collect_lambdas_in_node(cst.expr, out);
			is GroupExpr as g -> self.collect_lambdas_in_node(g.expr, out);
			is IfExpr as ie -> {
				self.collect_lambdas_in_node(ie.condition, out);
				self.collect_lambdas_in_node(ie.then_branch, out);
				self.collect_lambdas_in_node(ie.else_branch, out);
			}
			is ArrayLiteralExpr as al -> {
				for (el in al.elements) self.collect_lambdas_in_node(el, out);
			}
			is WhenExpr as we -> {
				self.collect_lambdas_in_node(we.condition, out);
				for (arm in we.arms) {
					for (p in arm.patterns) self.collect_lambdas_in_node(p, out);
					self.collect_lambdas_in_node(arm.body, out);
				}
			}
			is StructCtorExpr as sc -> {
				for (a in sc.args) self.collect_lambdas_in_node(a, out);
			}
			is EnumCtorExpr as ec -> {
				for (a in ec.args) self.collect_lambdas_in_node(a, out);
			}
			is CatchExpr as ce -> {
				self.collect_lambdas_in_node(ce.expr, out);
				self.collect_lambdas_in_node(ce.handler, out);
			}
			is ErrorUnionWrapExpr as w -> self.collect_lambdas_in_node(w.value, out);
		}
	}

	pub fn gen_lambda_helper(&self, node: *AstNode) {
		if (node is LambdaExpr as lam) {
			val info = self.lambda_info_of(node);
			if (info.id == 0 || info.fn_type == null) return;
			val fn_info = info.fn_type!.as_fn()!;
			val ret_c = c_type_from_type(fn_info.return_type);

			if (!info.captures.empty()) {
				self.out += "struct __lambda_env_";
				self.out += info.id;
				self.out += " {\n";
				for (cap in info.captures) {
					val cap_c = if (cap.ty != null) c_type_from_type(cap.ty!) else "int32_t";
					self.out += "    ";
					self.out += cap_c;
					if (cap.is_mutable) self.out += '*';
					self.out += ' ';
					self.out += cap.name;
					self.out += ";\n";
				}
				self.out += "};\n\n";
			}

			self.out += "static ";
			self.out += ret_c;
			self.out += " __lambda_fn_";
			self.out += info.id;
			self.out += "(void* __raw_env";
			for (i in 0..<lam.params.len) {
				val p = lam.params[i];
				val p_c = if (i < fn_info.param_types.len) c_type_from_type(fn_info.param_types[i]) else "int32_t";
				self.out += ", ";
				self.out += p_c;
				self.out += ' ';
				self.out += p.name;
			}
			self.out += ") {\n";
			if (!info.captures.empty()) {
				self.out += "    struct __lambda_env_";
				self.out += info.id;
				self.out += "* __env = (struct __lambda_env_";
				self.out += info.id;
				self.out += "*)__raw_env;\n";
			} else {
				self.out += "    (void)__raw_env;\n";
			}

			val saved_ret_ty = self.current_fn_ret_type;
			val saved_yield_ret = self.is_yield_return;
			val saved_yield_target = self.yield_target;
			val saved_yield_exit = self.yield_exit_label;
			val saved_captures = self.active_lambda_captures;
			val saved_defers = self.defer_nodes.clone();
			val saved_starts = self.scope_starts.clone();
			val saved_jumped = self.scope_jumped.clone();
			val saved_loop_depths = self.loop_defer_depths.clone();

			self.current_fn_ret_type = ret_c;
			self.is_yield_return = true;
			self.yield_target = "";
			self.yield_exit_label = "";
			self.active_lambda_captures = info.captures;
			self.defer_nodes.clear();
			self.scope_starts.clear();
			self.scope_jumped.clear();
			self.loop_defer_depths.clear();

			if (lam.body is BlockStmt) {
				self.gen_block_body(lam.body);
			} else if (ret_c == "void") {
				self.out += "    ";
				self.out += self.gen_expr(lam.body);
				self.out += ";\n";
			} else if (lam.body is WhenExpr as we && we.has_blocks()) {
				self.gen_when_with_target(we, "", true);
			} else {
				self.out += "    return ";
				self.out += self.gen_expr(lam.body);
				self.out += ";\n";
			}

			self.current_fn_ret_type = saved_ret_ty;
			self.is_yield_return = saved_yield_ret;
			self.yield_target = saved_yield_target;
			self.yield_exit_label = saved_yield_exit;
			self.active_lambda_captures = saved_captures;
			self.defer_nodes = saved_defers;
			self.scope_starts = saved_starts;
			self.scope_jumped = saved_jumped;
			self.loop_defer_depths = saved_loop_depths;

			self.out += "}\n\n";
		}
	}

}
