mod compiler.codegen.c_runtime;

// ============================================================================
// C Runtime Prelude & Standard Helpers
// ============================================================================

const C_PRELUDE = """
/* Generated by Kobel compiler Compiler v1 */
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#ifdef _WIN32
#include <io.h>
#include <fcntl.h>
#else
#include <dirent.h>
#endif

typedef struct {
	const char* data;
	size_t len;
} kobel_str;

#define KOBEL_STR(s) ((kobel_str){ (s), sizeof(s) - 1 })

static inline kobel_str kobel_null_str(void) {
	return (kobel_str){ NULL, 0 };
}

static inline kobel_str kobel_from_cstr(const char* s) {
	return s ? (kobel_str){ s, strlen(s) } : (kobel_str){ NULL, 0 };
}

static inline const char* kobel_cstr(kobel_str s) {
	if (!s.data) return "";
	if (s.data[s.len] == 0) return s.data;
	char* r = (char*)malloc(s.len + 1);
	memcpy(r, s.data, s.len);
	r[s.len] = 0;
	return r;
}

/* str.slice(start, end) helper — O(1) zero-allocation view */
static inline kobel_str kobel_slice(kobel_str s, size_t start, size_t end) {
	if (!s.data) return (kobel_str){ NULL, 0 };
	if (end > s.len) end = s.len;
	if (start > end) start = end;
	return (kobel_str){ s.data + start, end - start };
}

static inline kobel_str kobel_slice1(kobel_str s, size_t start) {
	return kobel_slice(s, start, s.len);
}

/* str + str helpers — O(1) length lookup, single allocation */
static kobel_str kobel_concat(kobel_str a, kobel_str b) {
	size_t total = a.len + b.len;
	char* r = (char*)malloc(total + 1);
	if (a.len > 0) memcpy(r, a.data, a.len);
	if (b.len > 0) memcpy(r + a.len, b.data, b.len);
	r[total] = 0;
	return (kobel_str){ r, total };
}

static kobel_str kobel_concat3(kobel_str a, kobel_str b, kobel_str c) {
	size_t total = a.len + b.len + c.len;
	char* r = (char*)malloc(total + 1);
	size_t off = 0;
	if (a.len > 0) { memcpy(r + off, a.data, a.len); off += a.len; }
	if (b.len > 0) { memcpy(r + off, b.data, b.len); off += b.len; }
	if (c.len > 0) { memcpy(r + off, c.data, c.len); }
	r[total] = 0;
	return (kobel_str){ r, total };
}

static kobel_str kobel_concat4(kobel_str a, kobel_str b, kobel_str c, kobel_str d) {
	size_t total = a.len + b.len + c.len + d.len;
	char* r = (char*)malloc(total + 1);
	size_t off = 0;
	if (a.len > 0) { memcpy(r + off, a.data, a.len); off += a.len; }
	if (b.len > 0) { memcpy(r + off, b.data, b.len); off += b.len; }
	if (c.len > 0) { memcpy(r + off, c.data, c.len); off += c.len; }
	if (d.len > 0) { memcpy(r + off, d.data, d.len); }
	r[total] = 0;
	return (kobel_str){ r, total };
}

static kobel_str kobel_concat5(kobel_str a, kobel_str b, kobel_str c, kobel_str d, kobel_str e) {
	size_t total = a.len + b.len + c.len + d.len + e.len;
	char* r = (char*)malloc(total + 1);
	size_t off = 0;
	if (a.len > 0) { memcpy(r + off, a.data, a.len); off += a.len; }
	if (b.len > 0) { memcpy(r + off, b.data, b.len); off += b.len; }
	if (c.len > 0) { memcpy(r + off, c.data, c.len); off += c.len; }
	if (d.len > 0) { memcpy(r + off, d.data, d.len); off += d.len; }
	if (e.len > 0) { memcpy(r + off, e.data, e.len); }
	r[total] = 0;
	return (kobel_str){ r, total };
}

/* str == str helper — fast length check + memcmp */
static inline int kobel_streq(kobel_str a, kobel_str b) {
	return a.len == b.len && (a.len == 0 || memcmp(a.data, b.data, a.len) == 0);
}

/* struct == struct fallback helper */
static inline int kobel_memeq(const void* a, const void* b, size_t n) {
	return memcmp(a, b, n) == 0;
}

/* Directory listing helper — returns newline-separated filenames */
static kobel_str kobel_list_dir(kobel_str dir_path) {
#ifdef _WIN32
	char pattern[1024];
	if (dir_path.len >= 1020) return (kobel_str){ NULL, 0 };
	memcpy(pattern, dir_path.data, dir_path.len);
	pattern[dir_path.len] = 92;
	pattern[dir_path.len + 1] = '*';
	pattern[dir_path.len + 2] = 0;

	struct _finddata_t data;
	intptr_t handle = _findfirst(pattern, &data);
	if (handle == -1) return (kobel_str){ NULL, 0 };

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)malloc(cap);

	do {
		if (strcmp(data.name, ".") == 0 || strcmp(data.name, "..") == 0) continue;
		size_t nlen = strlen(data.name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			buf = (char*)realloc(buf, cap);
		}
		memcpy(buf + len, data.name, nlen);
		len += nlen;
		buf[len++] = 10;
	} while (_findnext(handle, &data) == 0);

	_findclose(handle);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#else
	char path[1024];
	if (dir_path.len >= 1023) return (kobel_str){ NULL, 0 };
	memcpy(path, dir_path.data, dir_path.len);
	path[dir_path.len] = 0;

	DIR* d = opendir(path);
	if (!d) return (kobel_str){ NULL, 0 };

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)malloc(cap);

	struct dirent* ent;
	while ((ent = readdir(d)) != NULL) {
		if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
		size_t nlen = strlen(ent->d_name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			buf = (char*)realloc(buf, cap);
		}
		memcpy(buf + len, ent->d_name, nlen);
		len += nlen;
		buf[len++] = 10;
	}
	closedir(d);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#endif
}

""";
