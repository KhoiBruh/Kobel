mod compiler.codegen;

// ============================================================================
// C Runtime Prelude & Standard Helpers
// ============================================================================

const C_PRELUDE = """
/* Generated by Kobel compiler Compiler v1 */
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <errno.h>

#ifdef _WIN32
#include <io.h>
#include <fcntl.h>
#include <direct.h>
#include <sys/stat.h>
__declspec(dllimport) void* __stdcall HeapCreate(uint32_t flOptions, size_t dwInitialSize, size_t dwMaximumSize);
__declspec(dllimport) int __stdcall HeapDestroy(void* hHeap);
__declspec(dllimport) void* __stdcall HeapAlloc(void* hHeap, uint32_t dwFlags, size_t dwBytes);
__declspec(dllimport) void* __stdcall HeapReAlloc(void* hHeap, uint32_t dwFlags, void* lpMem, size_t dwBytes);
__declspec(dllimport) int __stdcall HeapFree(void* hHeap, uint32_t dwFlags, void* lpMem);
#define KOBEL_HEAP_NO_SERIALIZE 0x00000001u
#else
#include <dirent.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#endif

typedef struct {
	const char* data;
	size_t len;
} kobel_str;

typedef struct {
	void* fn;
	void* env;
} kobel_closure;

/* Scoped heap pool allocator: routes every Kobel allocation to the active pool
 * (or the default CRT heap when NULL) while tagging each block with its owner
 * pool so cross-pool realloc/free is always safe. */
typedef struct kobel_heap_pool kobel_heap_pool;
#ifdef _WIN32
typedef struct {
	kobel_heap_pool* pool;
	size_t size;
} kobel_alloc_hdr;

struct kobel_heap_pool {
	void* hHeap;
	size_t live_bytes;
	size_t alloc_count;
};
#else
typedef struct kobel_alloc_hdr {
	kobel_heap_pool* pool;
	size_t size;
	struct kobel_alloc_hdr* prev;
	struct kobel_alloc_hdr* next;
} kobel_alloc_hdr;

struct kobel_heap_pool {
	kobel_alloc_hdr* head;
	size_t live_bytes;
	size_t alloc_count;
};
#endif

static kobel_heap_pool* kobel_active_pool = NULL;
static size_t kobel_default_live_bytes = 0;

static uint8_t* kobel_null_ptr(void) {
	return NULL;
}

static size_t kobel_default_heap_bytes(void) {
	return kobel_default_live_bytes;
}

static uint8_t* kobel_pool_create(void) {
	kobel_heap_pool* p = (kobel_heap_pool*)malloc(sizeof(kobel_heap_pool));
	if (!p) return NULL;
#ifdef _WIN32
	p->hHeap = HeapCreate(KOBEL_HEAP_NO_SERIALIZE, 0, 0);
	if (!p->hHeap) {
		free(p);
		return NULL;
	}
#else
	p->head = NULL;
#endif
	p->live_bytes = 0;
	p->alloc_count = 0;
	return (uint8_t*)p;
}

static void kobel_pool_destroy(uint8_t* raw) {
	if (!raw) return;
	kobel_heap_pool* p = (kobel_heap_pool*)raw;
	if (kobel_active_pool == p) kobel_active_pool = NULL;
#ifdef _WIN32
	if (p->hHeap) HeapDestroy(p->hHeap);
#else
	kobel_alloc_hdr* cur = p->head;
	while (cur) {
		kobel_alloc_hdr* nxt = cur->next;
		free(cur);
		cur = nxt;
	}
#endif
	free(p);
}

static void kobel_pool_reset(uint8_t* raw) {
	if (!raw) return;
	kobel_heap_pool* p = (kobel_heap_pool*)raw;
#ifdef _WIN32
	if (p->hHeap) HeapDestroy(p->hHeap);
	p->hHeap = HeapCreate(KOBEL_HEAP_NO_SERIALIZE, 0, 0);
#else
	kobel_alloc_hdr* cur = p->head;
	while (cur) {
		kobel_alloc_hdr* nxt = cur->next;
		free(cur);
		cur = nxt;
	}
	p->head = NULL;
#endif
	p->live_bytes = 0;
	p->alloc_count = 0;
}

static uint8_t* kobel_pool_push(uint8_t* raw) {
	kobel_heap_pool* prev = kobel_active_pool;
	kobel_active_pool = (kobel_heap_pool*)raw;
	return (uint8_t*)prev;
}

static void kobel_pool_pop(uint8_t* prev) {
	kobel_active_pool = (kobel_heap_pool*)prev;
}

static size_t kobel_pool_live_bytes(uint8_t* raw) {
	if (!raw) return 0;
	return ((kobel_heap_pool*)raw)->live_bytes;
}

static uint8_t* kobel_alloc(size_t size) {
	size_t req = size == 0 ? 1 : size;
	kobel_heap_pool* p = kobel_active_pool;
	kobel_alloc_hdr* hdr = NULL;
	if (p) {
#ifdef _WIN32
		if (p->hHeap) hdr = (kobel_alloc_hdr*)HeapAlloc(p->hHeap, 0, sizeof(kobel_alloc_hdr) + req);
#else
		hdr = (kobel_alloc_hdr*)malloc(sizeof(kobel_alloc_hdr) + req);
#endif
		if (!hdr) return NULL;
		hdr->pool = p;
		hdr->size = req;
#ifndef _WIN32
		hdr->prev = NULL;
		hdr->next = p->head;
		if (p->head) p->head->prev = hdr;
		p->head = hdr;
#endif
		p->live_bytes += req;
		p->alloc_count++;
	} else {
		hdr = (kobel_alloc_hdr*)malloc(sizeof(kobel_alloc_hdr) + req);
		if (!hdr) return NULL;
		hdr->pool = NULL;
		hdr->size = req;
#ifndef _WIN32
		hdr->prev = NULL;
		hdr->next = NULL;
#endif
		kobel_default_live_bytes += req;
	}
	return (uint8_t*)(hdr + 1);
}

static uint8_t* kobel_realloc(uint8_t* ptr, size_t size) {
	if (!ptr) return kobel_alloc(size);
	size_t req = size == 0 ? 1 : size;
	kobel_alloc_hdr* old_hdr = ((kobel_alloc_hdr*)ptr) - 1;
	kobel_heap_pool* p = old_hdr->pool;
	size_t old_sz = old_hdr->size;
	if (p) {
#ifdef _WIN32
		if (!p->hHeap) return NULL;
		kobel_alloc_hdr* nh = (kobel_alloc_hdr*)HeapReAlloc(p->hHeap, 0, old_hdr, sizeof(kobel_alloc_hdr) + req);
		if (!nh) return NULL;
		nh->pool = p;
		nh->size = req;
		p->live_bytes = p->live_bytes - old_sz + req;
		return (uint8_t*)(nh + 1);
#else
		if (old_hdr->prev) old_hdr->prev->next = old_hdr->next;
		else p->head = old_hdr->next;
		if (old_hdr->next) old_hdr->next->prev = old_hdr->prev;
		kobel_alloc_hdr* nh = (kobel_alloc_hdr*)realloc(old_hdr, sizeof(kobel_alloc_hdr) + req);
		if (!nh) {
			old_hdr->prev = NULL;
			old_hdr->next = p->head;
			if (p->head) p->head->prev = old_hdr;
			p->head = old_hdr;
			return NULL;
		}
		nh->pool = p;
		nh->size = req;
		nh->prev = NULL;
		nh->next = p->head;
		if (p->head) p->head->prev = nh;
		p->head = nh;
		p->live_bytes = p->live_bytes - old_sz + req;
		return (uint8_t*)(nh + 1);
#endif
	} else {
		kobel_alloc_hdr* nh = (kobel_alloc_hdr*)realloc(old_hdr, sizeof(kobel_alloc_hdr) + req);
		if (!nh) return NULL;
		nh->pool = NULL;
		nh->size = req;
		kobel_default_live_bytes = kobel_default_live_bytes - old_sz + req;
		return (uint8_t*)(nh + 1);
	}
}

static void kobel_free(uint8_t* ptr) {
	if (!ptr) return;
	kobel_alloc_hdr* hdr = ((kobel_alloc_hdr*)ptr) - 1;
	kobel_heap_pool* p = hdr->pool;
	size_t sz = hdr->size;
	if (p) {
		if (p->live_bytes >= sz) p->live_bytes -= sz;
		else p->live_bytes = 0;
		if (p->alloc_count > 0) p->alloc_count--;
#ifdef _WIN32
		if (p->hHeap) HeapFree(p->hHeap, 0, hdr);
#else
		if (hdr->prev) hdr->prev->next = hdr->next;
		else p->head = hdr->next;
		if (hdr->next) hdr->next->prev = hdr->prev;
		free(hdr);
#endif
	} else {
		if (kobel_default_live_bytes >= sz) kobel_default_live_bytes -= sz;
		else kobel_default_live_bytes = 0;
		free(hdr);
	}
}

#define KOBEL_STR(s) ((kobel_str){ (s), sizeof(s) - 1 })

static inline kobel_str kobel_null_str(void) {
	return (kobel_str){ NULL, 0 };
}

static inline kobel_str kobel_from_cstr(const char* s) {
	return s ? (kobel_str){ s, strlen(s) } : (kobel_str){ NULL, 0 };
}

static kobel_str kobel_str_clone(kobel_str s) {
	if (!s.data || s.len == 0) return KOBEL_STR("");
	char* r = (char*)kobel_alloc(s.len + 1);
	if (!r) return KOBEL_STR("");
	memcpy(r, s.data, s.len);
	r[s.len] = 0;
	return (kobel_str){ r, s.len };
}

static void kobel_str_free(kobel_str s) {
	if (s.data && s.len > 0) kobel_free((uint8_t*)s.data);
}

static inline const char* kobel_cstr(kobel_str s) {
	if (!s.data) return "";
	if (s.data[s.len] == 0) return s.data;
	char* r = (char*)kobel_alloc(s.len + 1);
	memcpy(r, s.data, s.len);
	r[s.len] = 0;
	return r;
}

static inline void kobel_print(kobel_str s) {
	if (s.data && s.len > 0) {
		fwrite(s.data, 1, s.len, stdout);
	}
}

static inline void kobel_println(kobel_str s) {
	if (s.data && s.len > 0) {
		fwrite(s.data, 1, s.len, stdout);
	}
	putchar(10);
}

/* str.slice(start, end) helper — O(1) zero-allocation view */
static inline kobel_str kobel_slice(kobel_str s, size_t start, size_t end) {
	if (!s.data) return (kobel_str){ NULL, 0 };
	if (end > s.len) end = s.len;
	if (start > end) start = end;
	return (kobel_str){ s.data + start, end - start };
}

static inline kobel_str kobel_slice1(kobel_str s, size_t start) {
	return kobel_slice(s, start, s.len);
}

/* str concat helper — variadic, single allocation across all parts */
static kobel_str kobel_concat(size_t count, ...) {
	va_list args;
	va_start(args, count);
	size_t total = 0;
	for (size_t i = 0; i < count; i++) {
		kobel_str s = va_arg(args, kobel_str);
		total += s.len;
	}
	va_end(args);

	char* r = (char*)kobel_alloc(total + 1);
	size_t off = 0;
	va_start(args, count);
	for (size_t i = 0; i < count; i++) {
		kobel_str s = va_arg(args, kobel_str);
		if (s.len > 0) {
			memcpy(r + off, s.data, s.len);
			off += s.len;
		}
	}
	va_end(args);
	r[total] = 0;
	return (kobel_str){ r, total };
}


/* str == str helper — fast length check + memcmp */
static inline int kobel_streq(kobel_str a, kobel_str b) {
	return a.len == b.len && (a.len == 0 || memcmp(a.data, b.data, a.len) == 0);
}

/* struct == struct fallback helper */
static inline int kobel_memeq(const void* a, const void* b, size_t n) {
	return memcmp(a, b, n) == 0;
}

/* Path buffer helper — small-buffer optimization (SBO) for NUL-terminated paths */
typedef struct {
	char stack[1024];
	char* buf;
} kobel_path_buf;

static inline char* kobel_path_buf_init(kobel_path_buf* pb, kobel_str s) {
	if (!s.data || s.len == 0) {
		pb->buf = NULL;
		return NULL;
	}
	if (s.len < sizeof(pb->stack)) {
		pb->buf = pb->stack;
	} else {
		pb->buf = (char*)malloc(s.len + 1);
		if (!pb->buf) {
			pb->buf = NULL;
			return NULL;
		}
	}
	memcpy(pb->buf, s.data, s.len);
	pb->buf[s.len] = 0;
	return pb->buf;
}

static inline void kobel_path_buf_free(kobel_path_buf* pb) {
	if (pb->buf && pb->buf != pb->stack) {
		free(pb->buf);
	}
}

/* Platform-abstracted stat & mkdir helpers */
#ifdef _WIN32
typedef struct _stat kobel_stat_t;
#define kobel_stat_fn _stat
static inline int kobel_mkdir(const char* path) { return _mkdir(path); }
#else
typedef struct stat kobel_stat_t;
#define kobel_stat_fn stat
static inline int kobel_mkdir(const char* path) { return mkdir(path, 0777); }
#endif

static int kobel_path_stat(kobel_str p, kobel_stat_t* st) {
	if (!p.data || p.len == 0) return 0;
	kobel_path_buf pb;
	char* path = kobel_path_buf_init(&pb, p);
	if (!path) return 0;
	int res = kobel_stat_fn(path, st);
	kobel_path_buf_free(&pb);
	return res == 0;
}

static int kobel_path_exists(kobel_str p) {
	kobel_stat_t st;
	return kobel_path_stat(p, &st);
}

static int kobel_path_is_dir(kobel_str p) {
	kobel_stat_t st;
	if (!kobel_path_stat(p, &st)) return 0;
#ifdef _WIN32
	return (st.st_mode & _S_IFDIR) != 0;
#else
	return S_ISDIR(st.st_mode);
#endif
}

static int kobel_path_is_file(kobel_str p) {
	kobel_stat_t st;
	if (!kobel_path_stat(p, &st)) return 0;
#ifdef _WIN32
	return (st.st_mode & _S_IFREG) != 0;
#else
	return S_ISREG(st.st_mode);
#endif
}

static int64_t kobel_path_mtime(kobel_str p) {
	kobel_stat_t st;
	if (!kobel_path_stat(p, &st)) return -1;
	return (int64_t)st.st_mtime;
}

static int64_t kobel_path_size(kobel_str p) {
	kobel_stat_t st;
	if (!kobel_path_stat(p, &st)) return -1;
	return (int64_t)st.st_size;
}

/* Maps C errno values to std.filesystem error kind codes (0 = none/unknown). */
static inline int32_t kobel_errno_kind(void) {
	switch (errno) {
		case 0: return 0;
#ifdef ENOENT
		case ENOENT: return 1;
#endif
#ifdef EACCES
		case EACCES: return 2;
#endif
#ifdef EPERM
		case EPERM: return 2;
#endif
#ifdef EEXIST
		case EEXIST: return 3;
#endif
#ifdef ENOTDIR
		case ENOTDIR: return 4;
#endif
#ifdef EISDIR
		case EISDIR: return 5;
#endif
#ifdef EINVAL
		case EINVAL: return 6;
#endif
#ifdef ENAMETOOLONG
		case ENAMETOOLONG: return 6;
#endif
#ifdef ENOMEM
		case ENOMEM: return 7;
#endif
		default: return 8;
	}
}

static void* kobel_fs_fopen(kobel_str path, kobel_str mode, int32_t* err_out) {
	if (!path.data || path.len == 0 || !mode.data || mode.len == 0) {
		if (err_out) *err_out = 6;
		return NULL;
	}
	kobel_path_buf pb;
	kobel_path_buf mb;
	char* p = kobel_path_buf_init(&pb, path);
	if (!p) {
		if (err_out) *err_out = 7;
		return NULL;
	}
	char* m = kobel_path_buf_init(&mb, mode);
	if (!m) {
		kobel_path_buf_free(&pb);
		if (err_out) *err_out = 7;
		return NULL;
	}
	errno = 0;
	FILE* f = fopen(p, m);
	int saved_err = errno;
	kobel_path_buf_free(&pb);
	kobel_path_buf_free(&mb);
	if (!f) {
		errno = saved_err;
		if (kobel_path_is_dir(path)) {
			if (err_out) *err_out = 5;
		} else {
			int32_t k = kobel_errno_kind();
			if (err_out) *err_out = k != 0 ? k : 8;
		}
		return NULL;
	}
	if (err_out) *err_out = 0;
	return (void*)f;
}

static inline int32_t kobel_fs_stream_err(void* f) {
	if (!f) return 9;
	return ferror((FILE*)f) ? 8 : 0;
}

static int32_t kobel_fs_remove(kobel_str p) {
	if (!p.data || p.len == 0) return 6;
	kobel_path_buf pb;
	char* path = kobel_path_buf_init(&pb, p);
	if (!path) return 7;
	errno = 0;
	int rc = remove(path);
	int saved_err = errno;
	kobel_path_buf_free(&pb);
	if (rc == 0) return 0;
	errno = saved_err;
	int32_t k = kobel_errno_kind();
	return k != 0 ? k : 8;
}

static int32_t kobel_fs_rename(kobel_str old_p, kobel_str new_p) {
	if (!old_p.data || old_p.len == 0 || !new_p.data || new_p.len == 0) return 6;
	kobel_path_buf ob;
	kobel_path_buf nb;
	char* os = kobel_path_buf_init(&ob, old_p);
	if (!os) return 7;
	char* ns = kobel_path_buf_init(&nb, new_p);
	if (!ns) {
		kobel_path_buf_free(&ob);
		return 7;
	}
	errno = 0;
	int rc = rename(os, ns);
	int saved_err = errno;
	kobel_path_buf_free(&ob);
	kobel_path_buf_free(&nb);
	if (rc == 0) return 0;
	errno = saved_err;
	int32_t k = kobel_errno_kind();
	return k != 0 ? k : 8;
}

static int32_t kobel_fs_mkdir(kobel_str dir_path) {
	if (!dir_path.data || dir_path.len == 0) return 6;
	kobel_path_buf pb;
	char* path = kobel_path_buf_init(&pb, dir_path);
	if (!path) return 7;
	errno = 0;
	int res = kobel_mkdir(path);
	int saved_err = errno;
	kobel_path_buf_free(&pb);
	if (res == 0) return 0;
	if (kobel_path_is_dir(dir_path)) return 0;
	if (kobel_path_exists(dir_path)) return 3;
	errno = saved_err;
	int32_t k = kobel_errno_kind();
	return k != 0 ? k : 8;
}

static int32_t kobel_fs_mkdir_all(kobel_str dir_path) {
	if (!dir_path.data || dir_path.len == 0) return 6;
	if (kobel_path_is_dir(dir_path)) return 0;
	if (kobel_path_exists(dir_path)) return 4;
	kobel_path_buf pb;
	char* path = kobel_path_buf_init(&pb, dir_path);
	if (!path) return 7;

	int saved_err = 0;
	for (size_t i = 1; i < dir_path.len; i++) {
		if (path[i] == '/' || path[i] == 92) {
			char saved = path[i];
			path[i] = 0;
			if (i == 2 && path[1] == ':') {
				path[i] = saved;
				continue;
			}
			errno = 0;
			if (kobel_mkdir(path) != 0 && saved_err == 0) saved_err = errno;
			path[i] = saved;
		}
	}
	errno = 0;
	int final_rc = kobel_mkdir(path);
	if (final_rc != 0) saved_err = errno;
	kobel_path_buf_free(&pb);
	if (kobel_path_is_dir(dir_path)) return 0;
	if (kobel_path_exists(dir_path)) return 4;
	errno = saved_err;
	int32_t k = kobel_errno_kind();
	return k != 0 ? k : 8;
}

static kobel_str kobel_fs_list_dir(kobel_str dir_path, int32_t* err_out) {
	if (err_out) *err_out = 0;
	if (!dir_path.data || dir_path.len == 0) {
		if (err_out) *err_out = 6;
		return (kobel_str){ NULL, 0 };
	}
	kobel_stat_t st;
	errno = 0;
	if (!kobel_path_stat(dir_path, &st)) {
		int32_t k = kobel_errno_kind();
		if (err_out) *err_out = k != 0 ? k : 1;
		return (kobel_str){ NULL, 0 };
	}
#ifdef _WIN32
	if ((st.st_mode & _S_IFDIR) == 0) {
#else
	if (!S_ISDIR(st.st_mode)) {
#endif
		if (err_out) *err_out = 4;
		return (kobel_str){ NULL, 0 };
	}
#ifdef _WIN32
	char stack_pat[1024];
	char* pattern = stack_pat;
	if (dir_path.len + 3 > sizeof(stack_pat)) {
		pattern = (char*)malloc(dir_path.len + 3);
		if (!pattern) {
			if (err_out) *err_out = 7;
			return (kobel_str){ NULL, 0 };
		}
	}
	memcpy(pattern, dir_path.data, dir_path.len);
	pattern[dir_path.len] = 92;
	pattern[dir_path.len + 1] = '*';
	pattern[dir_path.len + 2] = 0;

	struct _finddata_t data;
	errno = 0;
	intptr_t handle = _findfirst(pattern, &data);
	int saved_err = errno;
	if (pattern != stack_pat) free(pattern);
	if (handle == -1) {
		errno = saved_err;
		if (saved_err == ENOENT) {
			if (err_out) *err_out = 0;
			return (kobel_str){ NULL, 0 };
		}
		int32_t k = kobel_errno_kind();
		if (err_out) *err_out = k != 0 ? k : 8;
		return (kobel_str){ NULL, 0 };
	}

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)kobel_alloc(cap);
	if (!buf) {
		_findclose(handle);
		if (err_out) *err_out = 7;
		return (kobel_str){ NULL, 0 };
	}

	do {
		if (strcmp(data.name, ".") == 0 || strcmp(data.name, "..") == 0) continue;
		size_t nlen = strlen(data.name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			char* next_buf = (char*)kobel_realloc((uint8_t*)buf, cap);
			if (!next_buf) {
				kobel_free((uint8_t*)buf);
				_findclose(handle);
				if (err_out) *err_out = 7;
				return (kobel_str){ NULL, 0 };
			}
			buf = next_buf;
		}
		memcpy(buf + len, data.name, nlen);
		len += nlen;
		buf[len++] = 10;
	} while (_findnext(handle, &data) == 0);

	_findclose(handle);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#else
	kobel_path_buf pb;
	char* path = kobel_path_buf_init(&pb, dir_path);
	if (!path) {
		if (err_out) *err_out = 7;
		return (kobel_str){ NULL, 0 };
	}

	errno = 0;
	DIR* d = opendir(path);
	int saved_err = errno;
	kobel_path_buf_free(&pb);
	if (!d) {
		errno = saved_err;
		int32_t k = kobel_errno_kind();
		if (err_out) *err_out = k != 0 ? k : 8;
		return (kobel_str){ NULL, 0 };
	}

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)kobel_alloc(cap);
	if (!buf) {
		closedir(d);
		if (err_out) *err_out = 7;
		return (kobel_str){ NULL, 0 };
	}

	struct dirent* ent;
	while ((ent = readdir(d)) != NULL) {
		if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
		size_t nlen = strlen(ent->d_name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			char* next_buf = (char*)kobel_realloc((uint8_t*)buf, cap);
			if (!next_buf) {
				kobel_free((uint8_t*)buf);
				closedir(d);
				if (err_out) *err_out = 7;
				return (kobel_str){ NULL, 0 };
			}
			buf = next_buf;
		}
		memcpy(buf + len, ent->d_name, nlen);
		len += nlen;
		buf[len++] = 10;
	}
	closedir(d);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#endif
}

typedef struct {
	const char* file;
	size_t line;
	size_t col;
	const char* fn;
} kobel_loc;

typedef struct {
	uint32_t code;
	const char* name;
	const char* desc;
} kobel_fault_meta;

typedef struct {
	bool is_ok;
	uint32_t code;
	kobel_loc origin;
	kobel_loc fail_at;
} __kobel_main_result;

""";
