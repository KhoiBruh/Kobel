mod compiler.codegen;

// ============================================================================
// C Runtime Prelude & Standard Helpers
// ============================================================================

const C_PRELUDE = """
/* Generated by Kobel compiler Compiler v1 */
#include <stdint.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>

#ifdef _WIN32
#include <io.h>
#include <fcntl.h>
#include <direct.h>
#include <sys/stat.h>
#else
#include <dirent.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <unistd.h>
#endif

typedef struct {
	const char* data;
	size_t len;
} kobel_str;

#define KOBEL_STR(s) ((kobel_str){ (s), sizeof(s) - 1 })

static inline kobel_str kobel_null_str(void) {
	return (kobel_str){ NULL, 0 };
}

static inline kobel_str kobel_from_cstr(const char* s) {
	return s ? (kobel_str){ s, strlen(s) } : (kobel_str){ NULL, 0 };
}

static inline const char* kobel_cstr(kobel_str s) {
	if (!s.data) return "";
	if (s.data[s.len] == 0) return s.data;
	char* r = (char*)malloc(s.len + 1);
	memcpy(r, s.data, s.len);
	r[s.len] = 0;
	return r;
}

/* str.slice(start, end) helper — O(1) zero-allocation view */
static inline kobel_str kobel_slice(kobel_str s, size_t start, size_t end) {
	if (!s.data) return (kobel_str){ NULL, 0 };
	if (end > s.len) end = s.len;
	if (start > end) start = end;
	return (kobel_str){ s.data + start, end - start };
}

static inline kobel_str kobel_slice1(kobel_str s, size_t start) {
	return kobel_slice(s, start, s.len);
}

/* str concat helper — variadic, single allocation across all parts */
static kobel_str kobel_concat(size_t count, ...) {
	va_list args;
	va_start(args, count);
	size_t total = 0;
	for (size_t i = 0; i < count; i++) {
		kobel_str s = va_arg(args, kobel_str);
		total += s.len;
	}
	va_end(args);

	char* r = (char*)malloc(total + 1);
	size_t off = 0;
	va_start(args, count);
	for (size_t i = 0; i < count; i++) {
		kobel_str s = va_arg(args, kobel_str);
		if (s.len > 0) {
			memcpy(r + off, s.data, s.len);
			off += s.len;
		}
	}
	va_end(args);
	r[total] = 0;
	return (kobel_str){ r, total };
}


/* str == str helper — fast length check + memcmp */
static inline int kobel_streq(kobel_str a, kobel_str b) {
	return a.len == b.len && (a.len == 0 || memcmp(a.data, b.data, a.len) == 0);
}

/* struct == struct fallback helper */
static inline int kobel_memeq(const void* a, const void* b, size_t n) {
	return memcmp(a, b, n) == 0;
}

/* Directory listing helper — returns newline-separated filenames */
static kobel_str kobel_list_dir(kobel_str dir_path) {
#ifdef _WIN32
	char pattern[1024];
	if (dir_path.len >= 1020) return (kobel_str){ NULL, 0 };
	memcpy(pattern, dir_path.data, dir_path.len);
	pattern[dir_path.len] = 92;
	pattern[dir_path.len + 1] = '*';
	pattern[dir_path.len + 2] = 0;

	struct _finddata_t data;
	intptr_t handle = _findfirst(pattern, &data);
	if (handle == -1) return (kobel_str){ NULL, 0 };

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)malloc(cap);

	do {
		if (strcmp(data.name, ".") == 0 || strcmp(data.name, "..") == 0) continue;
		size_t nlen = strlen(data.name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			buf = (char*)realloc(buf, cap);
		}
		memcpy(buf + len, data.name, nlen);
		len += nlen;
		buf[len++] = 10;
	} while (_findnext(handle, &data) == 0);

	_findclose(handle);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#else
	char path[1024];
	if (dir_path.len >= 1023) return (kobel_str){ NULL, 0 };
	memcpy(path, dir_path.data, dir_path.len);
	path[dir_path.len] = 0;

	DIR* d = opendir(path);
	if (!d) return (kobel_str){ NULL, 0 };

	size_t cap = 1024;
	size_t len = 0;
	char* buf = (char*)malloc(cap);

	struct dirent* ent;
	while ((ent = readdir(d)) != NULL) {
		if (strcmp(ent->d_name, ".") == 0 || strcmp(ent->d_name, "..") == 0) continue;
		size_t nlen = strlen(ent->d_name);
		while (len + nlen + 2 > cap) {
			cap *= 2;
			buf = (char*)realloc(buf, cap);
		}
		memcpy(buf + len, ent->d_name, nlen);
		len += nlen;
		buf[len++] = 10;
	}
	closedir(d);
	buf[len] = 0;
	return (kobel_str){ buf, len };
#endif
}

/* Directory creation and filesystem status helpers */
static int kobel_mkdir(const char* path) {
#ifdef _WIN32
	return _mkdir(path);
#else
	return mkdir(path, 0777);
#endif
}

static int kobel_path_exists(kobel_str p) {
	if (!p.data || p.len == 0) return 0;
	char path[1024];
	if (p.len >= 1023) return 0;
	memcpy(path, p.data, p.len);
	path[p.len] = 0;
#ifdef _WIN32
	struct _stat st;
	return _stat(path, &st) == 0;
#else
	struct stat st;
	return stat(path, &st) == 0;
#endif
}

static int kobel_path_is_dir(kobel_str p) {
	if (!p.data || p.len == 0) return 0;
	char path[1024];
	if (p.len >= 1023) return 0;
	memcpy(path, p.data, p.len);
	path[p.len] = 0;
#ifdef _WIN32
	struct _stat st;
	if (_stat(path, &st) != 0) return 0;
	return (st.st_mode & _S_IFDIR) != 0;
#else
	struct stat st;
	if (stat(path, &st) != 0) return 0;
	return S_ISDIR(st.st_mode);
#endif
}

static int kobel_path_is_file(kobel_str p) {
	if (!p.data || p.len == 0) return 0;
	char path[1024];
	if (p.len >= 1023) return 0;
	memcpy(path, p.data, p.len);
	path[p.len] = 0;
#ifdef _WIN32
	struct _stat st;
	if (_stat(path, &st) != 0) return 0;
	return (st.st_mode & _S_IFREG) != 0;
#else
	struct stat st;
	if (stat(path, &st) != 0) return 0;
	return S_ISREG(st.st_mode);
#endif
}

static int kobel_create_dir(kobel_str dir_path) {
	if (!dir_path.data || dir_path.len == 0) return 0;
	char path[1024];
	if (dir_path.len >= 1023) return 0;
	memcpy(path, dir_path.data, dir_path.len);
	path[dir_path.len] = 0;
	if (kobel_mkdir(path) == 0) return 1;
	return kobel_path_is_dir(dir_path);
}

static int kobel_create_dir_all(kobel_str dir_path) {
	if (!dir_path.data || dir_path.len == 0) return 1;
	if (kobel_path_is_dir(dir_path)) return 1;
	char path[1024];
	if (dir_path.len >= 1023) return 0;
	memcpy(path, dir_path.data, dir_path.len);
	path[dir_path.len] = 0;

	for (size_t i = 1; i < dir_path.len; i++) {
		if (path[i] == '/' || path[i] == 92) {
			char saved = path[i];
			path[i] = 0;
			if (i == 2 && path[1] == ':') {
				path[i] = saved;
				continue;
			}
			kobel_mkdir(path);
			path[i] = saved;
		}
	}
	kobel_mkdir(path);
	return kobel_path_is_dir(dir_path);
}

""";
