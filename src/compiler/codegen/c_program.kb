mod compiler.codegen.c_program;

use std.collections.list.*;
use std.collections.string_builder.*;

use util.strutil.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.codegen.c_codegen.*;
use compiler.codegen.c_runtime.*;

// ============================================================================
// Declaration Code Generation
// ============================================================================

// Generic declarations are templates: monomorphized instances are appended by
// the semantic analyzer, so the backend must skip the templates themselves.

impl CCodeGen {

	pub fn gen_program(var self, program_node: *AstNode): str {
		if (program_node is Program as prog) {

		var sb = StringBuilder();
		defer sb.delete();

		// 1. C Standard Headers & Runtime Helpers
		sb += C_PRELUDE;

		// 2. First collect struct names, function names and return types
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is StructDecl as s -> {
					self.register_struct(s.name);
					sb += "typedef struct ${s.name} ${s.name};\n";
				}
				is EnumDecl as e -> {
					// Enums lower to their underlying integer type; member access becomes
					// an integer literal during semantic analysis.
					val under = if (e.underlying_type != null) c_type_from_ast(e.underlying_type) else "int32_t";
					sb += "typedef ${under} ${e.name};\n";
				}
				is ConstDecl as c -> {
					// Module-level constants become preprocessor macros.
					sb += "#define ${c.name} ${self.gen_expr(c.value)}\n";
				}
			}
		}
		sb += "\n\n";

		// 3. Struct Definitions
		for (decl in prog) {
			if (!decl.is_template() && decl is StructDecl as s) {
				sb += self.gen_struct_decl(s);
			}
		}

		// 3b. List constructors (emitted after all struct types are fully defined)
		for (decl_list in prog) {
			if (!decl_list.is_template() && decl_list is StructDecl as s && s.name.starts_with("std__collections__list__List")) {
				sb += "static inline ${s.name} ${s.name}_from_array(const void* src, size_t n) {\n"
					"    size_t elem_size = sizeof(*(((${s.name}*)0)->data));\n"
					"    size_t cap = (n < 4) ? 4 : n;\n"
					"    void* data = malloc(cap * elem_size);\n"
					"    if (n > 0 && src != NULL) memcpy(data, src, n * elem_size);\n"
					"    ${s.name} l;\n"
					"    l.data = data;\n"
					"    l.len = n;\n"
					"    l.cap = cap;\n"
					"    return l;\n"
					"}\n\n";
			}
		}

		// 4. Function Prototypes
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is FnDecl -> sb += self.gen_fn_decl(decl, true, "");
				is ImplDecl as im -> {
					for (mnode in im.methods) {
						if (mnode is FnDecl as f && f.type_params.len == 0) {
							sb += self.gen_fn_decl(f, true, im.struct_name);
						}
					}
				}
			}
		}
		sb += "\n";

		// 5. Function Implementations
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is FnDecl -> sb += self.gen_fn_decl(decl, false, "");
				is ImplDecl as im -> {
					for (mnode in im.methods) {
						if (mnode is FnDecl as f && f.type_params.len == 0) {
							sb += self.gen_fn_decl(f, false, im.struct_name);
						}
					}
				}
			}
		}

		return sb.to_str();
	}
	return "";
}

	pub fn gen_struct_decl(var self, s: *StructDecl): str {
		self.register_struct(s.name);

		var res = "struct ${s.name} {\n";
		for (f in s.fields) {
			val ty = c_type_from_ast(f.type_node);
			res = "${res}    ${ty} ${f.name};\n";
		}
		res = "${res}};\n";
		return "${res}\n";
	}

	// `self_c_type` is the C name of the enclosing struct when generating an impl
	// method ("" for free functions). It types the untyped `self` receiver.
	pub fn gen_fn_decl(var self, f: *FnDecl, is_proto: bool, self_c_type: str): str {
		val ret_ty = self.fn_ret_c_type(f);
		val f_body = f.body;

		var proto = "${ret_ty} ${f.name}(";
		if (f.params.empty()) proto = "${proto}void";
		else {
			for (i in 0..<f.params.len) {
				if (i > 0) proto = "${proto}, ";
				val p = f.params[i];
				var p_ty = c_type_from_ast(p.type_node);
				if (!self_c_type.empty() && p.name == "self" && p.type_node == null) {
					p_ty = "${self_c_type}*";
				}
				proto = "${proto}${p_ty} ${p.name}";
			}
		}
		proto = "${proto})";

		if (is_proto) return "${proto};\n";
		if (f_body == null) return "";

		self.current_fn_ret_type = ret_ty;

		self.defer_nodes.clear();
		self.scope_starts.clear();
		self.scope_jumped.clear();
		self.loop_defer_depths.clear();

		var res = "${proto} {\n";
		self.indent_level = 1;

		when (f_body) {
			is BlockStmt as blk -> {
				res = "${res}${self.gen_block_body(f_body)}";
			}
			is ExprStmt as es -> {
				val es_e = es.expr;
				var is_special = false;
				if (ret_ty != "void" && es_e != null) {
					if (es_e is WhenExpr as we && we.has_blocks()) {
						res = "${res}${self.gen_when_with_target(we, "", true)}";
						is_special = true;
					}
					var es_candidate = es_e;
					while (es_candidate != null) {
						if (es_candidate is GroupExpr as g) es_candidate = g.expr;
						else break;
					}
					if (!is_special && es_candidate is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
						var cur = es_candidate;
						res = "${res}    ${ret_ty} __ret_tmp;\n";
						while (cur != null) {
							while (cur != null) {
								if (cur is GroupExpr as g) cur = g.expr;
								else break;
							}
							if (cur == null) break;
							if (cur is BinaryExpr as b && b.op == TokenType.QUESTION_COLON) {
								res = "${res}    __ret_tmp = ${self.gen_expr(b.left)};\n";
								res = "${res}    if (__ret_tmp != NULL) return __ret_tmp;\n";
								cur = b.right;
							} else {
								res = "${res}    return ${self.gen_expr(cur)};\n";
								break;
							}
						}
						is_special = true;
					}
				}
				if (!is_special) {
					if (ret_ty == "void") {
						res = "${res}    ${self.gen_expr(es.expr)};\n";
					} else {
						res = "${res}    return ${self.gen_expr(es.expr)};\n";
					}
				}
			}
		}

		self.indent_level = 0;
		return "${res}}\n\n";
	}

// ============================================================================
// Full Program Code Generation
// ============================================================================

// C return type of a function: explicit annotation, else inferred from an
// arrow body (used by both the prototype and the definition).
	pub fn fn_ret_c_type(var self, f: *FnDecl): str {
		if (f.return_type != null) return c_type_from_ast(f.return_type);
		val f_body = f.body;
		if (f_body is ExprStmt as es) {
			val ty = self.c_type_of(es.expr);
			if (!ty.empty()) return ty;
		}
		return "void";
	}

}
