mod compiler.codegen.c_program;

use std.collections.list.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.codegen.c_codegen.*;
use util.strutil.*;

// ============================================================================
// Declaration Code Generation
// ============================================================================

// Generic declarations are templates: monomorphized instances are appended by
// the semantic analyzer, so the backend must skip the templates themselves.

impl CCodeGen {

	pub fn gen_program(var self, program_node: *AstNode): str {
		if (program_node is Program as prog) {

		// 1. C Standard Headers
		var c_code = "/* Generated by Kobel compiler Compiler v1 */\n" +
			"#include <stdint.h>\n" +
			"#include <stdbool.h>\n" +
			"#include <stddef.h>\n" +
			"#include <stdio.h>\n" +
			"#include <stdlib.h>\n" +
			"#include <string.h>\n\n" +
			"/* str.slice(start, end) helper */\n" +
			"static const char* kobel_slice(const char* s, size_t start, size_t end) {\n" +
			"    size_t n = (end > start) ? (end - start) : 0;\n" +
			"    char* r = (char*)malloc(n + 1);\n" +
			"    for (size_t i = 0; i < n; i++) r[i] = s[start + i];\n" +
			"    r[n] = 0;\n" +
			"    return r;\n" +
			"}\n" +
			"/* str + str helper */\n" +
			"static const char* kobel_concat(const char* a, const char* b) {\n" +
			"    size_t la = strlen(a), lb = strlen(b);\n" +
			"    char* r = (char*)malloc(la + lb + 1);\n" +
			"    memcpy(r, a, la);\n" +
			"    memcpy(r + la, b, lb + 1);\n" +
			"    return r;\n" +
			"}\n" +
			"/* str == str helper */\n" +
			"static int kobel_streq(const char* a, const char* b) {\n" +
			"    return strcmp(a, b) == 0;\n" +
			"}\n" +

			"/* str length helper */\n" +
			"static size_t kobel_slen(const char* s) {\n" +
			"    return strlen(s);\n" +
			"}\n\n";

		// 2. First collect struct names, function names and return types
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is StructDecl as s -> {
					self.struct_names.add(s.name);
					c_code = "${c_code}typedef struct ${s.name} ${s.name};\n";
				}
				is EnumDecl as e -> {
					// Enums lower to their underlying integer type; member access becomes
					// an integer literal during semantic analysis.
					val under = if (e.underlying_type != null) c_type_from_ast(e.underlying_type) else "int32_t";
					c_code = "${c_code}typedef ${under} ${e.name};\n";
				}
				is ConstDecl as c -> {
					// Module-level constants become preprocessor macros.
					c_code = "${c_code}#define ${c.name} ${self.gen_expr(c.value)}\n";
				}
			}
		}
		c_code = "${c_code}\n";

		// 2b. Register function return types (arrow bodies are inferred). Done after
		// all struct names are known so inference can resolve struct constructors.
		for (decl2 in prog) {
			if (decl2.is_template()) continue;
			when (decl2) {
				is FnDecl as f -> {
					self.register_fn(f.name, self.fn_ret_c_type(f));
				}
				is ImplDecl as im -> {
					for (mnode in im.methods) {
						if (mnode is FnDecl as f) {
							if (f.type_params.len > 0) continue;
							self.register_fn(f.name, self.fn_ret_c_type(f));
						}
					}
				}
				is ExternBlock as ext -> {
					for (e_decl in ext) {
						if (e_decl is FnDecl as f) {
							self.register_fn(f.name, self.fn_ret_c_type(f));
						}
					}
				}
			}
		}
		c_code = "${c_code}\n";

		// 3. Struct Definitions
		for (decl in prog) {
			if (!decl.is_template()) {
				if (decl is StructDecl) {
					c_code = "${c_code}${self.gen_struct_decl(decl)}";
				}
			}
		}

		// 3b. List constructors (emitted after all struct types are fully defined)
		for (decl_list in prog) {
			if (!decl_list.is_template()) {
				if (decl_list is StructDecl as s) {
					if (s.name.starts_with("std__collections__list__List")) {
						c_code = "${c_code}static inline ${s.name} ${s.name}_from_array(const void* src, size_t n) {\n" +
							"    size_t elem_size = sizeof(*(((${s.name}*)0)->data));\n" +
							"    size_t cap = (n < 4) ? 4 : n;\n" +
							"    void* data = malloc(cap * elem_size);\n" +
							"    if (n > 0 && src != NULL) memcpy(data, src, n * elem_size);\n" +
							"    ${s.name} l;\n" +
							"    l.data = data;\n" +
							"    l.len = n;\n" +
							"    l.cap = cap;\n" +
							"    return l;\n" +
							"}\n\n";
					}
				}
			}
		}

		// 4. Function Prototypes
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is FnDecl -> c_code = "${c_code}${self.gen_fn_decl(decl, true, "")}";
				is ImplDecl as im -> {
					for (mnode in im.methods) {
						if (mnode is FnDecl as f) {
							if (f.type_params.len > 0) continue;
							c_code = "${c_code}${self.gen_fn_decl(f, true, im.struct_name)}";
						}
					}
				}
			}
		}
		c_code = "${c_code}\n";

		// 5. Function Implementations
		for (decl in prog) {
			if (decl.is_template()) continue;
			when (decl) {
				is FnDecl -> c_code = "${c_code}${self.gen_fn_decl(decl, false, "")}";
				is ImplDecl as im -> {
					for (mnode in im.methods) {
						if (mnode is FnDecl as f) {
							if (f.type_params.len > 0) continue;
							c_code = "${c_code}${self.gen_fn_decl(f, false, im.struct_name)}";
						}
					}
				}
			}
		}

		return c_code;
	}
	return "";
}

	pub fn gen_struct_decl(var self, s: *StructDecl): str {
		self.struct_names.add(s.name);

		var res = "struct ${s.name} {\n";
		for (f in s.fields) {
			val ty = c_type_from_ast(f.type_node);
			res = "${res}    ${ty} ${f.name};\n";
		}
		res = "${res}};\n";
		return "${res}\n";
	}

	// `self_c_type` is the C name of the enclosing struct when generating an impl
	// method ("" for free functions). It types the untyped `self` receiver.
	pub fn gen_fn_decl(var self, f: *FnDecl, is_proto: bool, self_c_type: str): str {
		var ret_ty = "void";
		val f_body = f.body;
		if (f.return_type != null) ret_ty = c_type_from_ast(f.return_type);
		else if (f_body != null) {
			if (f_body is ExprStmt as es) {
				ret_ty = self.infer_type_from_expr(es.expr);
			}
		}

		var proto = "${ret_ty} ${f.name}(";
		if (f.params.is_empty()) proto = "${proto}void";
		else {
			for (i in 0..<f.params.len) {
				if (i > 0) proto = "${proto}, ";
				val p = f.params[i];
				var p_ty = c_type_from_ast(p.type_node);
				if (self_c_type != "" && p.name == "self" && p.type_node == null) {
					p_ty = "${self_c_type}*";
				}
				proto = "${proto}${p_ty} ${p.name}";
			}
		}
		proto = "${proto})";

		if (is_proto) return "${proto};\n";
		if (f_body == null) return "";

		self.pointer_vars = List<str>();
		self.str_vars = List<str>();
		for (p in f.params) {
			val p_tn = p.type_node;
			if (self_c_type != "" && p.name == "self" && p_tn == null) {
				self.pointer_vars.add(p.name);
			} else if (p_tn != null) {
				when (p_tn) {
					is PointerType -> self.pointer_vars.add(p.name);
					is NamedType as named -> {
						if (named.name == "str") self.str_vars.add(p.name);
					}
				}
			}
		}

		var res = "${proto} {\n";
		self.indent_level = 1;

		when (f_body) {
			is BlockStmt as blk -> {
				for (stmt in blk.statements) {
					res = "${res}${self.gen_statement(stmt)}";
				}
			}
			is ExprStmt as es -> {
				val es_e = es.expr;
				var is_when_block = false;
				if (ret_ty != "void" && es_e != null) {
					if (es_e is WhenExpr as we) {
						if (we.has_blocks()) {
							res = "${res}${self.gen_when_with_target(we, "", true)}";
							is_when_block = true;
						}
					}
				}
				if (!is_when_block) {
					if (ret_ty == "void") {
						res = "${res}    ${self.gen_expr(es.expr)};\n";
					} else {
						res = "${res}    return ${self.gen_expr(es.expr)};\n";
					}
				}
			}
		}

		self.indent_level = 0;
		return "${res}}\n\n";
	}

// ============================================================================
// Full Program Code Generation
// ============================================================================

// C return type of a function: explicit annotation, else inferred from an
// arrow body (used by both the prototype and the definition).
	pub fn fn_ret_c_type(var self, f: *FnDecl): str {
		if (f.return_type != null) return c_type_from_ast(f.return_type);
		val f_body = f.body;
		if (f_body != null) {
			if (f_body is ExprStmt as es) {
				return self.infer_type_from_expr(es.expr);
			}
		}
		return "void";
	}

}
