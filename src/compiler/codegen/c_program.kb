mod compiler.codegen.c_program;

use std.collections.list.*;

use compiler.lexer.token.*;
use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.codegen.c_codegen.*;

// ============================================================================
// Declaration Code Generation
// ============================================================================

pub fn gen_struct_decl(var self: &CCodeGen, node: *AstNode): str {
	val s = as_struct_decl(node);
	self.struct_names.add(s.name);

	var res = "struct " + s.name + " {\n";
	for (f in s.fields) {
		val ty = c_type_from_ast(f.type_node);
		res = res + "    " + ty + " " + f.name + ";\n";
	}
	return res + "};\n\n";
}

// `self_c_type` is the C name of the enclosing struct when generating an impl
// method ("" for free functions). It types the untyped `self` receiver.
pub fn gen_fn_decl(var self: &CCodeGen, node: *AstNode, is_proto: bool, self_c_type: str): str {
	val f = as_fn_decl(node);
	var ret_ty = "void";
	if (f.return_type != null) ret_ty = c_type_from_ast(f.return_type);
	else if (f.body != null && f.body.kind == NodeKind.STMT_EXPR) {
		val es = as_expr_stmt(f.body);
		ret_ty = infer_type_from_expr(self, es.expr);
	}

	var proto = ret_ty + " " + f.name + "(";
	if (f.params.len == 0) proto = proto + "void";
	else {
		for (i in 0..<f.params.len) {
			if (i > 0) proto = proto + ", ";
			val p = f.params.get(i);
			var p_ty = c_type_from_ast(p.type_node);
			if (self_c_type != "" && p.name == "self" && p.type_node == null) {
				if (p.is_mut) p_ty = self_c_type + "*";
				else p_ty = "const " + self_c_type + "*";
			}
			proto = proto + p_ty + " " + p.name;
		}
	}
	proto = proto + ")";

	if (is_proto) return proto + ";\n";

	if (f.body == null) return "";

	self.pointer_vars = new_list<str>();
	self.str_vars = new_list<str>();
	for (p in f.params) {
		if (self_c_type != "" && p.name == "self" && p.type_node == null) {
			self.pointer_vars.add(p.name);
		} else if (p.type_node != null) {
			if (p.type_node.kind == NodeKind.TYPE_POINTER) {
				self.pointer_vars.add(p.name);
			} else if (p.type_node.kind == NodeKind.TYPE_NAMED) {
				val named = as_named_type(p.type_node);
				if (named.name == "str") self.str_vars.add(p.name);
			}
		}
	}

	var res = proto + " {\n";
	self.indent_level = 1;

	if (f.body.kind == NodeKind.STMT_BLOCK) {
		val blk = as_block_stmt(f.body);
		for (stmt in blk.statements) {
			res = res + gen_statement(self, stmt);
		}
	} else if (f.body.kind == NodeKind.STMT_EXPR) {
		val es = as_expr_stmt(f.body);
		if (ret_ty == "void") res = res + "    " + gen_expr(self, es.expr) + ";\n";
		else res = res + "    return " + gen_expr(self, es.expr) + ";\n";
	}

	self.indent_level = 0;
	return res + "}\n\n";
}

// ============================================================================
// Full Program Code Generation
// ============================================================================

// C return type of a function: explicit annotation, else inferred from an
// arrow body (used by both the prototype and the definition).
pub fn fn_ret_c_type(var self: &CCodeGen, f: *FnDecl): str {
	if (f.return_type != null) return c_type_from_ast(f.return_type);
	if (f.body != null && f.body.kind == NodeKind.STMT_EXPR) {
		val es = as_expr_stmt(f.body);
		return infer_type_from_expr(self, es.expr);
	}
	return "void";
}

// Generic declarations are templates: monomorphized instances are appended by
// the semantic analyzer, so the backend must skip the templates themselves.
pub fn is_generic_decl(node: *AstNode): bool {
	if (node.kind == NodeKind.DECL_STRUCT) return as_struct_decl(node).type_params.len > 0;
	if (node.kind == NodeKind.DECL_FN) return as_fn_decl(node).type_params.len > 0;
	if (node.kind == NodeKind.DECL_IMPL) return as_impl_decl(node).type_params.len > 0;
	return false;
}

pub fn gen_program(var self: &CCodeGen, program_node: *AstNode): str {
	val prog = as_program(program_node);

	// 1. C Standard Headers
	var c_code = "/* Generated by Kobel compiler Compiler v1 */\n" +
		"#include <stdint.h>\n" +
		"#include <stdbool.h>\n" +
		"#include <stddef.h>\n" +
		"#include <stdio.h>\n" +
		"#include <stdlib.h>\n" +
		"#include <string.h>\n\n" +
		"/* str.slice(start, end) helper */\n" +
		"static const char* kobel_slice(const char* s, size_t start, size_t end) {\n" +
		"    size_t n = (end > start) ? (end - start) : 0;\n" +
		"    char* r = (char*)malloc(n + 1);\n" +
		"    for (size_t i = 0; i < n; i++) r[i] = s[start + i];\n" +
		"    r[n] = 0;\n" +
		"    return r;\n" +
		"}\n" +
		"/* str + str helper */\n" +
		"static const char* kobel_concat(const char* a, const char* b) {\n" +
		"    size_t la = strlen(a), lb = strlen(b);\n" +
		"    char* r = (char*)malloc(la + lb + 1);\n" +
		"    memcpy(r, a, la);\n" +
		"    memcpy(r + la, b, lb + 1);\n" +
		"    return r;\n" +
		"}\n" +
		"/* str == str helper */\n" +
		"static int kobel_streq(const char* a, const char* b) {\n" +
		"    return strcmp(a, b) == 0;\n" +
		"}\n" +
		"/* str length helper */\n" +
		"static size_t kobel_slen(const char* s) {\n" +
		"    return strlen(s);\n" +
		"}\n\n";

	// 2. First collect struct names, function names and return types
	for (decl in prog.declarations) {
		if (is_generic_decl(decl)) continue;
		if (decl.kind == NodeKind.DECL_STRUCT) {
			val s = as_struct_decl(decl);
			self.struct_names.add(s.name);
			c_code = c_code + "typedef struct " + s.name + " " + s.name + ";\n";
		} else if (decl.kind == NodeKind.DECL_ENUM) {
			// Enums lower to their underlying integer type; member access becomes
			// an integer literal during semantic analysis.
			val e = as_enum_decl(decl);
			var under = "int32_t";
			if (e.underlying_type != null) under = c_type_from_ast(e.underlying_type);
			c_code = c_code + "typedef " + under + " " + e.name + ";\n";
		} else if (decl.kind == NodeKind.DECL_CONST) {
			// Module-level constants become preprocessor macros.
			val c = as_const_decl(decl);
			c_code = c_code + "#define " + c.name + " " + gen_expr(self, c.value) + "\n";
		}
	}
	c_code = c_code + "\n";

	// 2b. Register function return types (arrow bodies are inferred). Done after
	// all struct names are known so inference can resolve struct constructors.
	for (decl2 in prog.declarations) {
		if (is_generic_decl(decl2)) continue;
		if (decl2.kind == NodeKind.DECL_FN) {
			val f = as_fn_decl(decl2);
			register_fn(self, f.name, fn_ret_c_type(self, f));
		} else if (decl2.kind == NodeKind.DECL_IMPL) {
			val im = as_impl_decl(decl2);
			for (mnode in im.methods) {
				val f = as_fn_decl(mnode);
				register_fn(self, f.name, fn_ret_c_type(self, f));
			}
		} else if (decl2.kind == NodeKind.DECL_EXTERN_BLOCK) {
			val ext = as_extern_block(decl2);
			for (e_decl in ext.declarations) {
				if (e_decl.kind == NodeKind.DECL_FN) {
					val f = as_fn_decl(e_decl);
					register_fn(self, f.name, fn_ret_c_type(self, f));
				}
			}
		}
	}
	c_code = c_code + "\n";

	// 3. Struct Definitions
	for (decl in prog.declarations) {
		if (!is_generic_decl(decl) && decl.kind == NodeKind.DECL_STRUCT) c_code = c_code + gen_struct_decl(self, decl);
	}

	// 4. Function Prototypes
	for (decl in prog.declarations) {
		if (is_generic_decl(decl)) continue;
		if (decl.kind == NodeKind.DECL_FN) c_code = c_code + gen_fn_decl(self, decl, true, "");
		else if (decl.kind == NodeKind.DECL_IMPL) {
			val im = as_impl_decl(decl);
			for (mnode in im.methods) {
				c_code = c_code + gen_fn_decl(self, mnode, true, im.struct_name);
			}
		}
	}
	c_code = c_code + "\n";

	// 5. Function Implementations
	for (decl in prog.declarations) {
		if (is_generic_decl(decl)) continue;
		if (decl.kind == NodeKind.DECL_FN) c_code = c_code + gen_fn_decl(self, decl, false, "");
		else if (decl.kind == NodeKind.DECL_IMPL) {
			val im = as_impl_decl(decl);
			for (mnode in im.methods) {
				c_code = c_code + gen_fn_decl(self, mnode, false, im.struct_name);
			}
		}
	}

	return c_code;
}
