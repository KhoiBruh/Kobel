mod compiler.codegen;

// ============================================================================
// Statement Code Generation
//
// Statement emission: blocks, declarations, if/while/return, defer unwinding,
// smart-cast declarations and `when` statements.
// ============================================================================

use std.string.*;
use std.collections.*;
use std.string.StringBuilder;

use compiler.lexer.*;
use compiler.ast.*;

use compiler.semantic.types.*;
use compiler.semantic.symbols.*;

// ============================================================================
// Statement Code Generation
// ============================================================================

impl WhenExpr {
	pub fn has_blocks(*self): bool => self.arms.any { arm ->
		arm.body is BlockStmt || arm.patterns.any { p -> p is IsExpr }
	};
}

impl CCodeGen {

	pub fn gen_cond(&self, cond: *AstNode): str {
		val s = self.gen_expr(cond);
		if (
			cond != null && (
				cond is BinaryExpr ||
				cond is GroupExpr
			)
		) return s;
		return "(${s})";
	}

	pub fn gen_block_body(&self, node: *AstNode) {
		if (node == null) return;
		if (node is BlockStmt as blk) {
			self.enter_defer_scope();
			for (s in blk.statements) {
				self.gen_statement(s);
			}
			self.exit_defer_scope();
			return;
		}
		self.enter_defer_scope();
		self.gen_statement(node);
		self.exit_defer_scope();
	}

	pub fn gen_statement(&self, node: *AstNode) {
		when (node) {
			is BlockStmt -> self.gen_block_stmt(node);
			is VarDeclStmt -> self.gen_var_decl_stmt(node);
			is DestructDeclStmt as ds -> self.gen_destruct_decl_stmt(node, ds);
			is IfStmt -> self.gen_if_stmt(node);
			is WhileStmt -> self.gen_while_stmt(node);
			is ReturnStmt -> self.gen_return_stmt(node);
			is ExprStmt -> self.gen_expr_stmt(node);
			is BreakStmt -> self.gen_break_stmt();
			is ContinueStmt -> self.gen_continue_stmt();
			is YieldStmt -> self.gen_yield_stmt(node);
			is WhenStmt -> self.gen_when_stmt(node);
			is DeferStmt -> self.add_defer(node.body);
		}
	}

	fn gen_block_stmt(&self, blk: *BlockStmt) {
		self.out += "{\n";
		self.enter_defer_scope();
		for (stmt in blk.statements) {
			self.gen_statement(stmt);
		}
		self.exit_defer_scope();
		self.out += "}\n";
	}

	fn gen_break_stmt(&self) {
		self.mark_current_scope_jumped();
		if (!self.loop_defer_depths.empty()) {
			val target_depth = self.loop_defer_depths.last();
			self.gen_defers_unwind(target_depth);
		}
		self.out += "break;\n";
	}

	fn gen_continue_stmt(&self) {
		self.mark_current_scope_jumped();
		if (!self.loop_defer_depths.empty()) {
			val target_depth = self.loop_defer_depths.last();
			self.gen_defers_unwind(target_depth);
		}
		self.out += "continue;\n";
	}

	fn gen_var_decl_stmt(&self, vd: *VarDeclStmt) {
		var ty_str = "int32_t";

		val t_ann = vd.type_annotation;
		if (t_ann != null) {
			ty_str = c_type_from_ast(t_ann);
		} else if (vd.initializer != null) {
			val init_e = vd.initializer;
			ty_str = self.c_type_or(init_e!, "int32_t");
		}

		var init_e = vd.initializer;
		while (init_e != null) {
			if (init_e is GroupExpr as g) init_e = g.expr;
			else break;
		}

		if (init_e is WhenExpr as we && we.has_blocks()) {
			self.out += ty_str;
			self.out += ' ';
			self.out += vd.name;
			self.out += ";\n";
			self.gen_when_with_target(we, vd.name, false);
			return;
		}

		if (
			init_e is BinaryExpr as bin &&
			bin.op == TokenType.QUESTION_COLON
		) {
			self.gen_var_elvis_init(vd, init_e!, ty_str);
			return;
		}

		if (vd.initializer != null) {
			val init_s = self.gen_expr(vd.initializer!);
			self.out += ty_str;
			self.out += ' ';
			self.out += vd.name;
			self.out += " = ";
			self.out += init_s;
			self.out += ";\n";
			return;
		}

		self.out += ty_str;
		self.out += ' ';
		self.out += vd.name;
		self.out += ";\n";
	}

	// Emit a `a ?: b ?: c` initializer chain as a run of NULL checks.
	fn gen_var_elvis_init(
		&self, vd: *VarDeclStmt, init_e: *AstNode,
		ty_str: str
	) {
		val unwrapped_init = unwrap_group_expr(init_e);
		if (
			unwrapped_init != null &&
			unwrapped_init is BinaryExpr as eb &&
			eb.op == TokenType.QUESTION_COLON
		) {
			val unwrapped_l = unwrap_group_expr(eb.left);
			if (
				unwrapped_l != null &&
				unwrapped_l is MemberExpr as mem &&
				mem.is_safe &&
				!self.is_pointer_value(unwrapped_l) &&
				!self.is_str_value(unwrapped_l)
			) {
				val unwrapped_r = unwrap_group_expr(eb.right);
				val is_jump = unwrapped_r != null && is_jump_or_block(unwrapped_r);
				val obj_s = self.gen_expr(mem.object);
				val obj_wrap = if (expr_needs_parens_for_member(mem.object)) "(${obj_s})" else obj_s;
				if (is_jump) {
					self.out += "if (";
					self.out += obj_wrap;
					self.out += " == NULL) {\n";
					self.gen_statement(unwrapped_r!);
					self.out += "}\n";
					self.out += ty_str;
					self.out += ' ';
					self.out += vd.name;
					self.out += " = ";
					self.out += obj_wrap;
					self.out += "->";
					self.out += mem.member;
					self.out += ";\n";
					return;
				}
				val r_s = self.gen_expr(eb.right);
				self.out += ty_str;
				self.out += ' ';
				self.out += vd.name;
				self.out += " = (";
				self.out += obj_wrap;
				self.out += " != NULL ? ";
				self.out += obj_wrap;
				self.out += "->";
				self.out += mem.member;
				self.out += " : ";
				self.out += r_s;
				self.out += ");\n";
				return;
			}
		}

		var is_str_var = ty_str == "kobel_str";
		if (unwrapped_init is BinaryExpr as eb2) {
			if (self.is_str_value(eb2.left)) {
				is_str_var = true;
			}
		}
		val null_chk = if (is_str_var) ".data == NULL" else " == NULL";

		var cur = init_e;
		var first = true;
		while (cur != null) {
			while (cur != null) {
				if (cur is GroupExpr as g) cur = g.expr;
				else break;
			}
			if (cur == null) break;
			if (cur is BinaryExpr as b) {
				if (b.op == TokenType.QUESTION_COLON) {
					if (first) {
						self.out += ty_str;
						self.out += ' ';
						self.out += vd.name;
						self.out += " = ";
						self.out += self.gen_expr(b.left);
						self.out += ";\n";
						first = false;
					} else {
						self.out += "if (";
						self.out += vd.name;
						self.out += null_chk;
						self.out += ") ";
						self.out += vd.name;
						self.out += " = ";
						self.out += self.gen_expr(b.left);
						self.out += ";\n";
					}
					cur = b.right;
				} else {
					self.out += "if (";
					self.out += vd.name;
					self.out += null_chk;
					self.out += ") ";
					self.out += vd.name;
					self.out += " = ";
					self.out += self.gen_expr(cur);
					self.out += ";\n";
					break;
				}
			} else {
				val is_jump = is_jump_or_block(cur);
				if (is_jump) {
					self.out += "if (";
					self.out += vd.name;
					self.out += null_chk;
					self.out += ") {\n";
					self.gen_statement(cur);
					self.out += "}\n";
				} else {
					self.out += "if (";
					self.out += vd.name;
					self.out += null_chk;
					self.out += ") ";
					self.out += vd.name;
					self.out += " = ";
					self.out += self.gen_expr(cur);
					self.out += ";\n";
				}
				break;
			}
		}
	}

	fn gen_destruct_decl_stmt(&self, node: *AstNode, ds: *DestructDeclStmt) {
		val mi = self.symtab?.get_resolved_method(node);
		if (mi == null) return;

		self.destruct_counter++;
		val destruct_id = self.destruct_counter;

		val fn_t = mi.fn_type.as_fn();
		val is_indexed = (
			fn_t.param_types.len == 2 &&
			fn_t.param_types[1].is_integer() &&
			fn_t.return_type.kind != DataType.NONE
		);

		var is_simple_id = false;
		var recv_name = "";
		if (ds.initializer is IdentifierExpr as id_expr) {
			is_simple_id = true;
			recv_name = id_expr.name;
		}

		val init_ty = self.node_type(ds.initializer);
		val init_is_ptr = (init_ty?.kind == DataType.POINTER);

		if (!is_simple_id) {
			val st_param = fn_t.param_types[0];
			val st_pointee = if (st_param.kind == DataType.POINTER) st_param.as_pointer().pointee else st_param;
			val st_c_name = c_type_from_type(st_pointee);
			val init_ty_str = if (init_is_ptr) "${st_c_name}*" else st_c_name;
			recv_name = "__destruct_tmp_${destruct_id}";
			val init_val = self.gen_expr(ds.initializer);
			self.out += "${init_ty_str} ${recv_name} = ${init_val};\n";
		}

		val pass_recv = if (init_is_ptr) recv_name else "&${recv_name}";

		if (is_indexed) {
			for (i in 0..<ds.names.len) {
				val vname = ds.names[i];
				if (vname == "_") continue;
				val vtype_str = c_type_from_type(fn_t.return_type);
				self.out += "${vtype_str} ${vname} = ${mi.c_name}(${pass_recv}, ${i});\n";
			}
		} else {
			for (i in 0..<ds.names.len) {
				val raw_name = ds.names[i];
				val vname = if (raw_name == "_") "__destruct_unused_${destruct_id}_${i}" else raw_name;
				val param_t = fn_t.param_types[i + 1];
				val var_t = if (param_t.kind == DataType.POINTER) param_t.as_pointer().pointee else param_t;
				val vtype_str = c_type_from_type(var_t);
				self.out += "${vtype_str} ${vname};\n";
			}
			self.out += "${mi.c_name}(${pass_recv}";
			for (i in 0..<ds.names.len) {
				val raw_name = ds.names[i];
				val vname = if (raw_name == "_") "__destruct_unused_${destruct_id}_${i}" else raw_name;
				self.out += ", &${vname}";
			}
			self.out += ");\n";
		}
	}

	pub fn collect_condition_aliases(&self, expr: *AstNode): List<ConditionAlias> {
		var res = List<ConditionAlias>();
		if (expr == null) return res;
		var cur = expr;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		if (cur == null) return res;

		if (cur is BinaryExpr as bin) {
			if (bin.op == TokenType.AND_AND) {
				val left = self.collect_condition_aliases(bin.left);
				defer left.free();
				val right = self.collect_condition_aliases(bin.right);
				defer right.free();
				for (l in left) {
					var found = false;
					for (item in res) {
						if (item.name == l.name) {
							found = true;
							break;
						}
					}
					if (!found) res += l;
				}
				for (r in right) {
					var found = false;
					for (item in res) {
						if (item.name == r.name) {
							found = true;
							break;
						}
					}
					if (!found) res += r;
				}
				return res;
			}
		}

		if (cur is IsExpr as is_e && !is_e.alias.empty()) {
			val target_name = c_type_from_ast(is_e.target_type);
			val decl = "${target_name}* ${is_e.alias} = NULL;";
			res += ConditionAlias(is_e.alias, target_name, decl);
		}

		return res;
	}

	fn has_alias_type_conflict(
		&self, expr: *AstNode,
		aliases: List<ConditionAlias>
	): bool {
		val cond_aliases = self.collect_condition_aliases(expr);
		defer cond_aliases.free();
		for ((ca_name, ca_type) in cond_aliases) {
			for ((a_name, a_type) in aliases) {
				if (ca_name == a_name && ca_type != a_type) return true;
			}
		}
		return false;
	}

	fn gen_if_stmt(&self, ifs: *IfStmt) {
		var aliases = self.collect_condition_aliases(ifs.condition);
		defer aliases.free();

		var cur_elif = ifs.else_branch;
		while (cur_elif != null) {
			if (cur_elif is IfStmt as elif) {
				if (self.has_alias_type_conflict(elif.condition, aliases)) break;
				val elif_aliases = self.collect_condition_aliases(elif.condition);
				defer elif_aliases.free();
				for (ea in elif_aliases) {
					var found = false;
					val (ea_name, _) = ea;
					for ((a_name, _) in aliases) {
						if (a_name == ea_name) {
							found = true;
							break;
						}
					}
					if (!found) aliases += ea;
				}
				cur_elif = elif.else_branch;
			} else break;
		}

		var cond = ifs.condition;
		while (cond != null) {
			if (cond is GroupExpr as g) cond = g.expr;
			else break;
		}

		var cast_decl = "";
		if (
			cond is IsExpr as is_e &&
			is_e.alias.empty() &&
			is_e.expr is IdentifierExpr as id
		) cast_decl = self.gen_smart_cast_decl(cond, is_e, is_e.expr!, id.name);

		val has_aliases = !aliases.empty();

		if (has_aliases) {
			self.out += "{\n";
			for (a in aliases) {
				self.out += a.decl;
				self.out += '\n';
			}
		}

		self.out += "if ";
		self.out += self.gen_cond(ifs.condition);
		self.out += " {\n";
		if (!cast_decl.empty()) {
			self.out += cast_decl;
			self.out += '\n';
		}
		self.gen_block_body(ifs.then_branch);

		var last_cond = cond;
		var cur_else = ifs.else_branch;
		while (cur_else != null) {
			if (cur_else is IfStmt as elif) {
				if (self.has_alias_type_conflict(elif.condition, aliases)) break;

				var elif_cond = elif.condition;
				while (elif_cond != null) {
					if (elif_cond is GroupExpr as g) elif_cond = g.expr;
					else break;
				}
				last_cond = elif_cond;

				var elif_cast = "";
				if (
					elif_cond is IsExpr as elif_is_e &&
					elif_is_e.alias.empty() &&
					elif_is_e.expr is IdentifierExpr as id
				) elif_cast = self.gen_smart_cast_decl(elif_cond, elif_is_e, elif_is_e.expr!, id.name);

				self.out += "} else if ";
				self.out += self.gen_cond(elif.condition);
				self.out += " {\n";
				if (!elif_cast.empty()) {
					self.out += elif_cast;
					self.out += '\n';
				}
				self.gen_block_body(elif.then_branch);

				cur_else = elif.else_branch;
			} else break;
		}

		if (cur_else != null) {
			var else_cast = "";
			if (
				last_cond is UnaryExpr as neg_un &&
				neg_un.op == TokenType.BANG &&
				!neg_un.is_postfix
			) {
				var inner_is = neg_un.operand;
				while (inner_is != null) {
					if (inner_is is GroupExpr as g) inner_is = g.expr;
					else break;
				}
				if (
					inner_is is IsExpr as else_is_e &&
					else_is_e.alias.empty() &&
					else_is_e.expr is IdentifierExpr as id
				) else_cast = self.gen_smart_cast_decl(inner_is, else_is_e, else_is_e.expr!, id.name);
			}
			self.out += "} else {\n";
			if (!else_cast.empty()) {
				self.out += else_cast;
				self.out += '\n';
			}
			self.gen_block_body(cur_else);
		}

		self.out += "}\n";

		if (has_aliases) {
			self.out += "}\n";
		}
	}

	fn gen_while_stmt(&self, wh: *WhileStmt) {
		self.out += "while ";
		self.out += self.gen_cond(wh.condition);
		self.out += " {\n";
		self.loop_defer_depths += self.scope_starts.len;
		self.gen_block_body(wh.body);
		self.loop_defer_depths.pop();
		self.out += "}\n";
	}

	fn gen_return_stmt(&self, ret: *ReturnStmt) {

		val ret_val = ret.value;
		if (
			ret_val is WhenExpr as we &&
			we.has_blocks()
		) {
			self.gen_when_with_target(we, "", true);
			return;
		}

		if (!self.has_active_defers()) {
			if (ret_val != null) {
				var ret_candidate = ret_val;
				while (ret_candidate != null) {
					if (ret_candidate is GroupExpr as g) ret_candidate = g.expr;
					else break;
				}

				if (
					ret_candidate is BinaryExpr as bin &&
					bin.op == TokenType.QUESTION_COLON
				) {
					var ret_ty = self.current_fn_ret_type;
					if (ret_ty.empty() || ret_ty == "void") ret_ty = self.c_type_or(bin.left, "int32_t");
					val is_str_ret = ret_ty == "kobel_str" || self.is_str_value(bin.left);
					val not_null_chk = if (is_str_ret) ".data != NULL" else " != NULL";
					var cur = ret_candidate;
					self.out += "{\n";
					self.out += ret_ty;
					self.out += " __ret_tmp;\n";
					while (cur != null) {
						while (cur != null) {
							if (cur is GroupExpr as g) cur = g.expr;
							else break;
						}

						if (cur == null) break;
						if (cur is BinaryExpr as b && b.op == TokenType.QUESTION_COLON) {
							self.out += "__ret_tmp = ";
							self.out += self.gen_expr(b.left);
							self.out += ";\n";
							self.out += "if (__ret_tmp";
							self.out += not_null_chk;
							self.out += ") return __ret_tmp;\n";
							cur = b.right;
						} else {
							self.out += "return ";
							self.out += self.gen_expr(cur);
							self.out += ";\n";
							break;
						}
					}

					self.out += "}\n";
					return;
				}

				self.out += "return ";
				self.out += self.gen_expr(ret_val);
				self.out += ";\n";
				return;
			}

			self.out += "return;\n";
			return;
		}

		self.mark_current_scope_jumped();
		if (ret_val != null) {
			var ret_ty = self.current_fn_ret_type;
			if (ret_ty.empty() || ret_ty == "void") ret_ty = self.c_type_or(ret_val, "int32_t");
			self.out += "{\n";
			self.out += ret_ty;
			self.out += " __ret_tmp = ";
			self.out += self.gen_expr(ret_val);
			self.out += ";\n";
			self.gen_defers_unwind(0);
			self.out += "return __ret_tmp;\n";
			self.out += "}\n";
			return;
		}

		self.gen_defers_unwind(0);
		self.out += "return;\n";
	}

	fn gen_expr_stmt(&self, es: *ExprStmt) {
		val e = es.expr;
		if (e != null) {
			var asg_candidate = e;
			while (asg_candidate != null) {
				if (asg_candidate is GroupExpr as g) asg_candidate = g.expr;
				else break;
			}
			if (asg_candidate is AssignExpr as asg) {
				var asg_val = asg.value;
				while (asg_val != null) {
					if (asg_val is GroupExpr as g) asg_val = g.expr;
					else break;
				}
				if (
					asg_val is BinaryExpr as bin &&
					bin.op == TokenType.QUESTION_COLON
				) {
					self.gen_assign_elvis_stmt(asg, asg_val);
					return;
				}
			}

			var bin_candidate = e;
			while (bin_candidate != null) {
				if (bin_candidate is GroupExpr as g) bin_candidate = g.expr;
				else break;
			}

			if (
				bin_candidate is BinaryExpr as bin &&
				bin.op == TokenType.QUESTION_COLON
			) {
				val is_jump = is_jump_or_block(bin.right);

				if (is_jump) {
					self.gen_elvis_jump_stmt(bin);
					return;
				}
			}
		}

		self.out += self.gen_expr(es.expr);
		self.out += ";\n";
	}

	// `x = a ?: b ?: c` assigns the first non-NULL value through a chain of NULL checks.
	fn gen_assign_elvis_stmt(&self, asg: *AssignExpr, asg_val: *AstNode) {
		val tgt = self.gen_expr(asg.target);
		val unwrapped_val = unwrap_group_expr(asg_val);
		if (
			unwrapped_val != null &&
			unwrapped_val is BinaryExpr as eb &&
			eb.op == TokenType.QUESTION_COLON
		) {
			val unwrapped_l = unwrap_group_expr(eb.left);
			if (
				unwrapped_l != null &&
				unwrapped_l is MemberExpr as mem &&
				mem.is_safe &&
				!self.is_pointer_value(unwrapped_l) &&
				!self.is_str_value(unwrapped_l)
			) {
				val unwrapped_r = unwrap_group_expr(eb.right);
				val is_jump = unwrapped_r != null && is_jump_or_block(unwrapped_r);
				val obj_s = self.gen_expr(mem.object);
				val obj_wrap = if (expr_needs_parens_for_member(mem.object)) "(${obj_s})" else obj_s;
				if (is_jump) {
					self.out += "if (";
					self.out += obj_wrap;
					self.out += " == NULL) {\n";
					self.gen_statement(unwrapped_r!);
					self.out += "}\n";
					self.out += tgt;
					self.out += " = ";
					self.out += obj_wrap;
					self.out += "->";
					self.out += mem.member;
					self.out += ";\n";
					return;
				}
				val r_s = self.gen_expr(eb.right);
				self.out += tgt;
				self.out += " = (";
				self.out += obj_wrap;
				self.out += " != NULL ? ";
				self.out += obj_wrap;
				self.out += "->";
				self.out += mem.member;
				self.out += " : ";
				self.out += r_s;
				self.out += ");\n";
				return;
			}
		}

		var is_str_tgt = self.is_str_value(asg.target);
		if (unwrapped_val is BinaryExpr as eb2) {
			if (self.is_str_value(eb2.left)) {
				is_str_tgt = true;
			}
		}
		val null_chk = if (is_str_tgt) ".data == NULL" else " == NULL";

		var cur = asg_val;
		var first = true;
		while (cur != null) {
			while (cur != null) {
				if (cur is GroupExpr as g) cur = g.expr;
				else break;
			}
			if (cur == null) break;
			if (cur is BinaryExpr as b) {
				if (b.op == TokenType.QUESTION_COLON) {
					if (first) {
						self.out += tgt;
						self.out += " = ";
						self.out += self.gen_expr(b.left);
						self.out += ";\n";
						first = false;
					} else {
						self.out += "if (";
						self.out += tgt;
						self.out += null_chk;
						self.out += ") ";
						self.out += tgt;
						self.out += " = ";
						self.out += self.gen_expr(b.left);
						self.out += ";\n";
					}
					cur = b.right;
				} else {
					self.out += "if (";
					self.out += tgt;
					self.out += null_chk;
					self.out += ") ";
					self.out += tgt;
					self.out += " = ";
					self.out += self.gen_expr(cur);
					self.out += ";\n";
					break;
				}
			} else {
				val is_jump = is_jump_or_block(cur);
				if (is_jump) {
					self.out += "if (";
					self.out += tgt;
					self.out += null_chk;
					self.out += ") {\n";
					self.gen_statement(cur);
					self.out += "}\n";
				} else {
					self.out += "if (";
					self.out += tgt;
					self.out += null_chk;
					self.out += ") ";
					self.out += tgt;
					self.out += " = ";
					self.out += self.gen_expr(cur);
					self.out += ";\n";
				}
				break;
			}
		}
	}

	// A `cond ?: jump` statement emits a NULL guard that runs the jump statement.
	fn gen_elvis_jump_stmt(&self, bin: *BinaryExpr) {
		val unwrapped_l = unwrap_group_expr(bin.left);
		if (
			unwrapped_l != null &&
			unwrapped_l is MemberExpr as mem &&
			mem.is_safe &&
			!self.is_pointer_value(unwrapped_l) &&
			!self.is_str_value(unwrapped_l)
		) {
			val obj_s = self.gen_expr(mem.object);
			val obj_wrap = if (expr_needs_parens_for_member(mem.object)) "(${obj_s})" else obj_s;
			self.out += "if (";
			self.out += obj_wrap;
			self.out += " == NULL) {\n";
			self.gen_statement(bin.right);
			self.out += "}\n";
			return;
		}
		val l_s = self.gen_expr(bin.left);
		self.out += "if (";
		if (self.is_str_value(bin.left)) {
			val l_wrap = if (expr_needs_parens_for_member(bin.left)) "(${l_s})" else l_s;
			self.out += l_wrap;
			self.out += ".data == NULL) {\n";
		} else {
			self.out += l_s;
			self.out += " == NULL) {\n";
		}
		self.gen_statement(bin.right);
		self.out += "}\n";
	}

	fn gen_yield_stmt(&self, ys: *YieldStmt) {
		if (self.is_yield_return) {
			if (self.has_active_defers()) {
				self.mark_current_scope_jumped();
				if (ys.value != null) {
					var ret_ty = self.current_fn_ret_type;
					if (ret_ty.empty() || ret_ty == "void") ret_ty = self.c_type_or(ys.value!, "int32_t");
					self.out += "{\n";
					self.out += ret_ty;
					self.out += " __ret_tmp = ";
					self.out += self.gen_expr(ys.value!);
					self.out += ";\n";
					self.gen_defers_unwind(0);
					self.out += "return __ret_tmp;\n";
					self.out += "}\n";
					return;
				}
				self.gen_defers_unwind(0);
				self.out += "return;\n";
				return;
			}
			if (ys.value != null) {
				self.out += "return ";
				self.out += self.gen_expr(ys.value!);
				self.out += ";\n";
				return;
			}
			self.out += "return;\n";
			return;
		}
		if (!self.yield_target.empty()) {
			val val_str = if (ys.value != null) self.gen_expr(ys.value!) else "";
			if (!val_str.empty()) {
				self.out += self.yield_target;
				self.out += " = ";
				self.out += val_str;
				self.out += ";\n";
			}
			if (!self.yield_exit_label.empty()) {
				self.out += "goto ";
				self.out += self.yield_exit_label;
				self.out += ";\n";
			}
			return;
		}
		if (ys.value != null) {
			self.out += self.gen_expr(ys.value!);
			self.out += ";\n";
		}
	}

	// Name an arm binds: its alias, or the subject's own name for a plain
	// identifier subject. Empty when the arm binds nothing.
	fn when_arm_binding(*self, patterns: List<*AstNode>, cond: *AstNode?): str {
		if (cond == null || patterns.len != 1) return "";
		val pat = patterns.first();
		if (pat is IsExpr as is_e) {
			if (!is_e.alias.empty()) return is_e.alias;
			if (cond is IdentifierExpr as id) return id.name;
		}
		return "";
	}

	fn gen_when_stmt(&self, ws: *WhenStmt) {
		val cond = if (ws.condition != null) self.gen_expr(ws.condition!) else "";
		var first = true;
		for (arm in ws.arms) {
			var cast_decl = "";
			val bound = self.when_arm_binding(arm.patterns, ws.condition);
			if (!bound.empty()) {
				val pat_node = arm.patterns.first();
				if (pat_node is IsExpr as is_e) {
					var subj_expr = self.gen_expr(ws.condition!);
					if (ws.condition! is IdentifierExpr as id) subj_expr = id.name;
					cast_decl = self.gen_smart_cast_decl(pat_node, is_e, is_e.expr!, subj_expr);
				}
			}

			if (arm.is_else) {
				self.out += if (first) "{\n" else "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				self.out += if (first) "if (" else "} else if (";
				self.out += test;
				self.out += ") {\n";
			}
			if (!cast_decl.empty()) {
				self.out += cast_decl;
				self.out += '\n';
			}
			self.gen_block_body(arm.body);
			first = false;
		}
		if (!first) {
			self.out += "}\n";
		}
	}

	pub fn gen_smart_cast_decl(
		*self, is_node: *AstNode, is_e: *IsExpr,
		subject: *AstNode, var_name: str
	): str {
		val pat_info = self.is_pattern_info(is_node);
		val target_name = c_type_from_ast(is_e.target_type);
		val bound_name = if (!is_e.alias.empty()) is_e.alias else var_name;
		val is_ptr = if (pat_info.is_ptr) true else self.is_pointer_value(subject);
		if (!is_e.alias.empty()) {
			if (is_ptr) {
				if (!pat_info.payload_path.empty()) {
					if (pat_info.payload_ptr) {
						return "${target_name}* ${bound_name} = (${var_name})->${pat_info.payload_path};";
					}
					return "${target_name}* ${bound_name} = (${target_name}*)"
							"(&(${var_name})->${pat_info.payload_path});";
				}
				return "${target_name}* ${bound_name} = (${target_name}*)${var_name};";
			} else {
				if (!pat_info.payload_path.empty()) {
					if (pat_info.payload_ptr) {
						return "${target_name}* ${bound_name} = (${var_name}).${pat_info.payload_path};";
					}
					return "${target_name}* ${bound_name} = (${target_name}*)"
							"(&(${var_name}).${pat_info.payload_path});";
				}
				return "${target_name}* ${bound_name} = (${target_name}*)&${var_name};";
			}
		} else {
			if (!pat_info.payload_path.empty()) {
				val src = if (is_ptr) var_name else "&${var_name}";
				val bound = if (pat_info.payload_ptr)
					"((${pat_info.base_c_name}*)__orig_${var_name})->${pat_info.payload_path}"
					else "(&((${pat_info.base_c_name}*)__orig_${var_name})->${pat_info.payload_path})";
				return "void* __orig_${var_name} = (void*)${src};"
						"\n${target_name}* ${var_name} = (${target_name}*)(${bound});";
			}

			if (is_ptr) {
				return "void* __orig_${var_name} = (void*)${var_name};"
						"\n${target_name}* ${var_name} = "
						"(${target_name}*)__orig_${var_name};";
			} else {
				return "void* __orig_${var_name} = (void*)&${var_name};"
						"\n${target_name}* ${var_name} = "
						"(${target_name}*)__orig_${var_name};";
			}
		}
	}

	pub fn gen_when_with_target(&self, we: *WhenExpr, target_name: str, is_ret: bool) {
		val cond = if (we.condition != null) self.gen_expr(we.condition!) else "";
		var first = true;

		val prev_target = self.yield_target;
		val prev_is_ret = self.is_yield_return;
		val prev_exit = self.yield_exit_label;

		self.when_label_counter++;
		val when_id = self.when_label_counter;

		self.yield_exit_label = if (is_ret) "" else "__when_end_${when_id}";

		self.yield_target = target_name;
		self.is_yield_return = is_ret;

		var has_else = false;
		for (arm in we.arms) {
			if (arm.is_else) has_else = true;
		}

		var arm_idx: usz = 0;
		for (arm in we.arms) {
			val is_last = (arm_idx == we.arms.len - 1);
			var cast_decl = "";
			val bound = self.when_arm_binding(arm.patterns, we.condition);
			if (!bound.empty()) {
				val pat_node = arm.patterns.first();
				if (pat_node is IsExpr as is_e) {
					var subj_expr = self.gen_expr(we.condition!);
					if (we.condition is IdentifierExpr as id) subj_expr = id.name;
					cast_decl = self.gen_smart_cast_decl(pat_node, is_e, is_e.expr!, subj_expr);
				}
			}

			if (arm.is_else) {
				self.out += if (first) "{\n" else "} else {\n";
			} else if (!has_else && is_last && !first) {
				self.out += "} else {\n";
			} else {
				val test = self.gen_when_test(cond, arm.patterns);
				self.out += if (first) "if (" else "} else if (";
				self.out += test;
				self.out += ") {\n";
			}
			if (!cast_decl.empty()) {
				self.out += cast_decl;
				self.out += '\n';
			}
			val arm_b = arm.body;
			if (arm_b is BlockStmt as blk) {
				for (s in blk.statements) {
					self.gen_statement(s);
				}
			} else {
				if (is_ret) {
					self.out += "return ";
					self.out += self.gen_expr(arm_b);
					self.out += ";\n";
				} else {
					self.out += target_name;
					self.out += " = ";
					self.out += self.gen_expr(arm_b);
					self.out += ";\n";
				}
			}
			first = false;
			arm_idx++;
		}
		if (!first) {
			self.out += "}\n";
		}
		if (!is_ret) {
			self.out += self.yield_exit_label;
			self.out += ":;\n";
		}

		self.yield_target = prev_target;
		self.is_yield_return = prev_is_ret;
		self.yield_exit_label = prev_exit;
	}

}

fn is_jump_or_block(node: *AstNode?) => node != null && (
	node is ReturnStmt ||
	node is BreakStmt ||
	node is ContinueStmt ||
	node is YieldStmt ||
	node is BlockStmt
);
