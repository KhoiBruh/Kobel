mod compiler;

use std.io.*;
use std.filesystem.*;
use std.collections.*;

use config.ProjectConfig;
use compiler.driver.*;

/*
 * ============================================================================
 * compiler.compiler — Central Compiler Orchestrator
 *
 * `Compiler` serves as the primary facade and orchestrator for the Kobel
 * compilation subsystem. It owns compilation options and arena lifecycle,
 * and dispatches both single-file compilation and project-level commands
 * (build, run, test, snap, fixpoint, emit-c).
 * ============================================================================
 */

pub struct Compiler {
	pub options: CompileOptions
}

impl Compiler {

	pub init(options: CompileOptions = CompileOptions()) => Self(options);

	// ------------------------------------------------------------------------
	// Compilation Pipeline
	// ------------------------------------------------------------------------

	pub fn compile(*self) => self.options.compile();

	// ------------------------------------------------------------------------
	// Project Commands Dispatch
	// ------------------------------------------------------------------------

	pub fn build(manifest_path: str = "kobel.toml") => cmd_build(manifest_path);

	pub fn run_project(
		manifest_path: str = "kobel.toml",
		extra_args: List<str> = List<str>()
	) => cmd_run(manifest_path, extra_args);

	pub fn test(
		manifest_path: str = "kobel.toml",
		filter: str = ""
	) => cmd_test(manifest_path, filter);

	pub fn snap(
		manifest_path: str = "kobel.toml",
		update: bool = false
	) => cmd_snap(manifest_path, update);

	pub fn fixpoint(manifest_path: str = "kobel.toml") => cmd_fixpoint(manifest_path);

	pub fn emit_c(
		&self,
		input_path: str,
		out_path: str = "dist/bootstrap.c"
	): i32 {
		self.options.input_path = input_path;
		self.options.emit_c_path = out_path;
		self.options.only_emit_c = true;
		return self.compile();
	}

}
