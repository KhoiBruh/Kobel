mod compiler.sema.decl;

// ============================================================================
// DeclPass - declaration collection driver (Compatibility Bridge)
// Delegates all collection passes to compiler.semantic.declaration.DeclarationCollector.
// ============================================================================

use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.resolution.*;
use compiler.semantic.declaration.*;

impl DeclPass {

	pub fn collect_module(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_module(node);
		self.apply_collector(c);
	}

	pub fn collect_use(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_use(node);
		self.apply_collector(c);
	}

	pub fn collect_struct(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_struct(node);
		self.apply_collector(c);
	}

	pub fn collect_fn(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_fn(node);
		self.apply_collector(c);
	}

	pub fn collect_enum(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_enum(node);
		self.apply_collector(c);
	}

	pub fn collect_const(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_const(node);
		self.apply_collector(c);
	}

	pub fn collect_extern_block(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_extern_block(node);
		self.apply_collector(c);
	}

	pub fn collect_trait(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_trait(node);
		self.apply_collector(c);
	}

	pub fn collect_declaration(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_declaration(node);
		self.apply_collector(c);
	}

	pub fn collect_program(var self, program_node: *AstNode) {
		var c = self.to_collector();
		c.collect_program(program_node);
		self.apply_collector(c);
	}
}
