mod compiler.sema.decl.collect;

// ============================================================================
// DeclPass - declaration collection driver
//
// Walks the merged program in ordered passes: register templates and module
// imports, forward-declare struct shells, collect ordinary declarations and
// impls, rewrite generic uses, drain the instance worklist, then merge the
// monomorphized declarations after the source program (instance graph order).
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.lexer.token.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;

use compiler.sema.types.*;
use compiler.sema.structs.StructField;
use compiler.sema.symbol.*;
use compiler.sema.decl.pass.*;
use compiler.sema.mono.registry.*;
use compiler.sema.mono.instantiate.*;
use compiler.sema.mono.clone.*;
use compiler.sema.mono.rewrite.*;

use compiler.sema.template.*;
use compiler.sema.traits.*;

use compiler.sema.enums.*;

use compiler.sema.decl.type.*;

// A trait may declare overloads, so a method is identified by name + arity.
fn trait_method_in(list: List<*TraitMethod>, name: str, arity: usz): *TraitMethod {
	for (m in list) {
		if (m.name == name && m.arity == arity) return m;
	}
	return null;
}

impl DeclPass {

	pub fn collect_module(var self, node: *AstNode) {
		val m = node.as_module_decl();
		self.current_module = m.full_path;
		self.symtab.set_current_module(m.full_path);
	}

// `use a.b.c.Sym as Alias;` -> writes an ImportBinding:
// the name `Alias` (or `Sym` when there is no alias) resolves to `Sym` of the module.
// `use a.b.c.*;` -> wildcard import of the whole module a.b.c
	pub fn collect_use(var self, node: *AstNode) {
		val u = node.as_use_decl();

		if (u.is_wildcard) {
			val w_mod = str_join_dots(u.path, u.path.len);
			if (!self.symtab.has_wildcard(self.current_module, w_mod)) {
				self.symtab.add_import(w_mod, "", "", true);
			}
			return;
		}

		// The last segment of the path is the symbol name, the rest is the module path
		if (u.path.len < 2) return;
		val mod_name = str_join_dots(u.path, u.path.len - 1);

		// Missing/failed module was already reported by ModuleLoader
		if (!self.symtab.module_exists(mod_name)) return;

		val target = self.symtab.lookup_in_module(mod_name, u.symbol_name);
		if (target == null) {
			// Generic struct/function templates are not registered as symbols.
			if (self.template_in_module(mod_name, u.symbol_name)) return;
			if (self.symtab.find_trait(u.symbol_name) != null) return;
			self.report_error(node, "Symbol '${u.symbol_name}' not found in module '${mod_name}'");
			return;
		}

		var local_name = u.symbol_name;
		if (!u.alias.empty()) local_name = u.alias;
		if (self.symtab.explicit_imports["${self.current_module}::${local_name}"] != null) return;
		self.symtab.add_import(mod_name, u.symbol_name, local_name, false);
	}

	// Registers a struct's name with an opaque type, without resolving its fields.
	// Every struct gets one before the definition pass, so a field may mention a
	// type from a module that imports us back (import cycles). Idempotent.
	fn declare_struct_shell(var self, node: *AstNode, s: *StructDecl) {
		val c_name = self.c_name_for(s.name);
		val s_type = self.arena.struct_type(s.name, List<StructField>());
		s_type.as_struct_mut().c_name = c_name;
		s_type.as_struct_mut().module = self.current_module;
		s_type.as_struct_mut().is_defined = false;
		val ok = self.symtab.define_global(
			Symbol(s.name, c_name, SymbolKind.STRUCT, s_type, false, s.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate struct declaration '${s.name}'");
	}

	pub fn collect_struct(var self, node: *AstNode) {
		val s = node.as_struct_decl() as &StructDecl;
		// Generic structs are registered as templates and instantiated on use.
		if (s.type_params.len > 0) return;

		// A forward declaration (`struct A;`) registers an opaque type; the later
		// definition fills that same type in, so pointers may refer to it early.
		if (s.is_forward) {
			val existing_fwd = self.symtab.lookup_in_module(self.current_module, s.name);
			if (existing_fwd != null) {
				s.name = existing_fwd.c_name;
				return;
			}
			self.declare_struct_shell(node, s);
			val created = self.symtab.lookup_in_module(self.current_module, s.name);
			if (created != null) s.name = created.c_name;
			return;
		}

		val existing = self.symtab.lookup(s.name);
		if (
			existing != null &&
			existing.kind == SymbolKind.STRUCT &&
			existing.type_ptr.kind == DataType.STRUCT &&
			!existing.type_ptr.as_struct().is_defined
		) {
			// Definition of a forward-declared struct: complete the same type.
			val fwd_type = existing.type_ptr;
			fwd_type.as_struct_mut().is_defined = true;
			// A forward declaration elsewhere already emits this type's typedef.
			if (existing.ast_node != node) s.emit_typedef = false;
			val def_name = s.name;
			s.name = fwd_type.as_struct().c_name;
			var fwd_private = false;
			for (f in s.fields) {
				val f_type = self.resolve_ast_type(f.type_node);
				fwd_type.as_struct_mut().fields += StructField(f.name, f_type, 0, f.is_pub, f.default_val);
				if (!f.is_pub) fwd_private = true;
			}
			fwd_type.as_struct_mut().has_private = fwd_private;
			fwd_type.layout_struct();

			// The definition lives in a different module than the forward
			// declaration, so that module needs its own handle on the type.
			self.symtab.define_global(Symbol(
				def_name, fwd_type.as_struct().c_name, SymbolKind.STRUCT, fwd_type,
				false, s.is_pub, node.line, node.col, node
			));
			return;
		}

		val c_name = self.c_name_for(s.name);
		val s_type = self.arena.struct_type(s.name, List<StructField>());
		s_type.as_struct_mut().c_name = c_name;
		val ok = self.symtab.define_global(
			Symbol(s.name, c_name, SymbolKind.STRUCT, s_type, false, s.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate struct declaration '${s.name}'");

		// Rename the AST node to the C name so the backend emits a unique name
		s.name = c_name;

		var has_private = false;
		for (f in s.fields) {
			val f_type = self.resolve_ast_type(f.type_node);
			val s_info = s_type.as_struct_mut();
			s_info.fields += StructField(f.name, f_type, 0, f.is_pub, f.default_val);
			if (!f.is_pub) has_private = true;
		}
		val st_info = s_type.as_struct_mut();
		st_info.module = self.current_module;
		s_type.layout_struct();
	}

	pub fn collect_fn(var self, node: *AstNode) {
		val f = node.as_fn_decl() as &FnDecl;
		// Generic functions are registered as templates and instantiated on use.
		if (f.type_params.len > 0) return;
		var param_types = List<*Type>();

		for (p in f.params) {
			val p_type = self.resolve_ast_type(p.type_node);
			param_types += p_type;
		}

		var ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type)
		else self.infer_decl_return_type(f) ?: self.prims().t_none();

		val fn_type = self.arena.fn_type(param_types, ret_type);
		val c_name = self.c_name_for(f.name);
		val ok = self.symtab.define_global(
			Symbol(f.name, c_name, SymbolKind.FN, fn_type, false, f.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate function declaration '${f.name}'");

		// Rename the AST node to the C name so the backend emits a unique name
		f.name = c_name;
	}

	pub fn collect_enum(var self, node: *AstNode) {
		val e = node.as_enum_decl() as &EnumDecl;
		val under_type = if (e.underlying_type != null) self.resolve_ast_type(e.underlying_type)
		else self.prims().t_prim(type_i32());

		var is_payload = false;
		for (m in e.members) {
			if (!m.payload.empty()) is_payload = true;
		}
		if (is_payload) {
			self.collect_payload_enum(node, e, under_type);
			return;
		}

		val is_int = under_type.is_integer();
		val is_str = under_type.kind == DataType.STR;
		val is_char = under_type.kind == DataType.CHAR;
		val is_float = under_type.is_float();
		val is_bool = under_type.kind == DataType.BOOL;

		if (!is_int && !is_str && !is_char && !is_float && !is_bool) {
			self.report_error(node, "Enum underlying type must be a primitive type (integer, float, char, str, or bool)");
		}

		var members = List<*EnumMemberInfo>();
		var next_int_val: i64 = 0;
		for (m in e.members) {
			var v: i64 = 0;
			var raw_text = "";
			var lit_kind = LiteralKind.INT;

			if (is_int) {
				v = next_int_val;
				if (m.value != null) v = self.enum_const_i64(m.value);
				raw_text = "${v}";
				lit_kind = LiteralKind.INT;
				next_int_val = v + 1;
			} else if (is_str) {
				lit_kind = LiteralKind.STRING;
				if (m.value != null) {
					if (m.value is LiteralExpr as lit && lit.literal_kind == LiteralKind.STRING) {
						raw_text = lit.raw_text;
					} else {
						self.report_error(m.value, "Enum member value for 'str' enum must be a string literal");
						raw_text = "\"${m.name}\"";
					}
				} else {
					raw_text = "\"${m.name}\"";
				}
			} else if (is_char) {
				lit_kind = LiteralKind.CHAR;
				if (m.value != null) {
					if (m.value is LiteralExpr as lit && lit.literal_kind == LiteralKind.CHAR) {
						raw_text = lit.raw_text;
					} else {
						self.report_error(m.value, "Enum member value for 'char' enum must be a character literal");
						raw_text = "'?'";
					}
				} else {
					self.report_error(node, "Enum member '${m.name}' of 'char' enum requires an explicit character literal");
					raw_text = "'?'";
				}
			} else if (is_float) {
				lit_kind = LiteralKind.FLOAT;
				if (m.value != null) {
					if (m.value is LiteralExpr as lit && (lit.literal_kind == LiteralKind.FLOAT || lit.literal_kind == LiteralKind.INT)) {
						raw_text = lit.raw_text;
					} else {
						self.report_error(m.value, "Enum member value for float enum must be a number literal");
						raw_text = "0.0";
					}
				} else {
					self.report_error(node, "Enum member '${m.name}' of float enum requires an explicit float literal");
					raw_text = "0.0";
				}
			} else if (is_bool) {
				lit_kind = LiteralKind.BOOL;
				if (m.value != null) {
					if (m.value is LiteralExpr as lit && lit.literal_kind == LiteralKind.BOOL) {
						raw_text = lit.raw_text;
					} else {
						self.report_error(m.value, "Enum member value for 'bool' enum must be a bool literal");
						raw_text = "false";
					}
				} else {
					self.report_error(node, "Enum member '${m.name}' of 'bool' enum requires an explicit bool literal");
					raw_text = "false";
				}
			}

			val mi = self.arena.alloc<EnumMemberInfo>();
			*mi = EnumMemberInfo(m.name, v, null, "", raw_text, lit_kind);
			members += mi;
		}

		val c_name = self.c_name_for(e.name);

		val info = self.arena.alloc<EnumInfo>();
		*info = EnumInfo(e.name, c_name, under_type, members);

		// The symbol's type is an integer type that carries the EnumInfo, so enum
		// values stay usable in arithmetic/comparisons while `.value` is recognized.
		val carrier = self.arena.alloc<Type>();
		*carrier = Type(under_type.kind, under_type.size, under_type.align, TypePayload.Enum(info));

		val ok = self.symtab.define_global(
			Symbol(e.name, c_name, SymbolKind.ENUM, carrier, false, e.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate enum declaration '${e.name}'");

		self.symtab.register_enum_info(info);

		e.name = c_name;
	}

	// A payload enum becomes a struct: a `tag` field plus a union of per-variant
	// payload structs. Each variant gets its own struct type named `Enum.Variant`
	// (so an `is` pattern can name it) and an `Enum.Variant__TAG` constant symbol.
	fn collect_payload_enum(var self, node: *AstNode, e: &EnumDecl, under_type: *Type) {
		if (e.underlying_type != null) {
			self.report_error(node, "A payload enum cannot declare an underlying type");
		}

		val c_name = self.c_name_for(e.name);
		val tag_ty = self.prims().t_prim(type_i32());
		val enum_ty = self.arena.struct_type(e.name, List<StructField>());
		enum_ty.as_struct_mut().c_name = c_name;
		enum_ty.as_struct_mut().module = self.current_module;
		enum_ty.as_struct_mut().fields += StructField("tag", tag_ty, 0, true, null);

		var members = List<*EnumMemberInfo>();
		var max_payload: usz = 1;
		var max_align: usz = tag_ty.align;
		var idx: i64 = 0;

		for (m in e.members) {
			val v_name = "${e.name}.${m.name}";
			val v_c = "${c_name}__${m.name}";
			val v_ty = self.arena.struct_type(v_name, List<StructField>());
			v_ty.as_struct_mut().c_name = v_c;
			v_ty.as_struct_mut().module = self.current_module;
			for (f in m.payload) {
				val f_ty = self.resolve_ast_type(f.type_node);
				v_ty.as_struct_mut().fields += StructField(f.name, f_ty, 0, true, null);
			}
			v_ty.layout_struct();
			if (v_ty.size == 0) {
				v_ty.size = 1;
				v_ty.align = 1;
			}

			self.symtab.define_global(
				Symbol(v_name, v_c, SymbolKind.STRUCT, v_ty, false, e.is_pub, m.line, m.col, node)
			);
			self.symtab.define_global(
				Symbol("${v_name}__TAG", "${v_c}__TAG", SymbolKind.CONST, tag_ty, false, false, m.line, m.col, null)
			);

			val mi = self.arena.alloc<EnumMemberInfo>();
			*mi = EnumMemberInfo(m.name, idx, v_ty, "u.${m.name}", "", LiteralKind.INT);
			members += mi;

			if (v_ty.size > max_payload) max_payload = v_ty.size;
			if (v_ty.align > max_align) max_align = v_ty.align;
			idx = idx + 1;
		}

		// Layout: tag, padded up to the union's alignment, then the largest payload.
		var body_off = tag_ty.size;
		val rem = tag_ty.size % max_align;
		if (rem != 0) body_off = tag_ty.size + (max_align - rem);
		var pay = max_payload;
		val prem = pay % max_align;
		if (prem != 0) pay = pay + (max_align - prem);
		enum_ty.align = max_align;
		enum_ty.size = body_off + pay;

		val info = self.arena.alloc<EnumInfo>();
		*info = EnumInfo(e.name, c_name, under_type, members, true, "tag");
		self.symtab.register_enum_info(info);

		val ok = self.symtab.define_global(
			Symbol(e.name, c_name, SymbolKind.STRUCT, enum_ty, false, e.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate enum declaration '${e.name}'");
		e.name = c_name;
	}

	pub fn collect_const(var self, node: *AstNode) {
		val c = node.as_const_decl() as &ConstDecl;
		val c_type = if (c.type_node != null) self.resolve_ast_type(c.type_node)
		else self.prims().t_prim(type_i32());
	
		val c_name = self.c_name_for(c.name);
		val ok = self.symtab.define_global(
			Symbol(c.name, c_name, SymbolKind.CONST, c_type, false, c.is_pub, node.line, node.col, node)
		);
		if (!ok) self.report_error(node, "Duplicate const declaration '${c.name}'");
	
		c.name = c_name;
	}

	pub fn collect_extern_block(var self, node: *AstNode) {
		val ext = node.as_extern_block();
		val prev_is_extern = self.is_extern;
		self.is_extern = true;
		for (d in ext) self.collect_declaration(d);
		self.is_extern = prev_is_extern;
	}

	// Records a `trait` declaration so `impl Trait for Struct` blocks can be
	// checked against it and pick up its default methods. Method signatures are
	// resolved lazily; only the method names and whether each one has a body are
	// kept here.
	pub fn collect_trait(var self, node: *AstNode) {
		val t = node.as_trait_decl();
		if (self.symtab.find_trait(t.name) != null) {
			self.report_error(node, "Duplicate trait declaration '${t.name}'");
			return;
		}
	
		var methods = List<*TraitMethod>();
		for (m in t.methods) {
			val f = m.as_fn_decl();
			if (trait_method_in(methods, f.name, f.params.len) != null) {
				self.report_error(m,
					"Duplicate method '${f.name}' with ${f.params.len} "
					"parameter(s) in trait '${t.name}'"
				);
				continue;
			}
			val tm = self.arena.alloc<TraitMethod>();
			*tm = TraitMethod(f.name, f.params.len, f.body != null, m);
			methods += tm;
		}
	
		for (a in t.assoc_types) {
			var seen_before = false;
			for (a2 in t.assoc_types) {
				if (a2 == a) {
					if (seen_before) {
						self.report_error(node, "Duplicate associated type '${a}' in trait '${t.name}'");
					}
					seen_before = true;
				}
			}
		}

		val ti = self.arena.alloc<TraitInfo>();
		*ti = TraitInfo(t.name, t.bases, methods, List<str>(), t.assoc_types);
		self.symtab.register_trait(ti);
	}

	pub fn collect_declaration(var self, node: *AstNode) {
		when (node.kind) {
			NodeKind.DECL_MODULE -> self.collect_module(node);
			NodeKind.DECL_USE -> self.collect_use(node);
			NodeKind.DECL_STRUCT -> self.collect_struct(node);
			NodeKind.DECL_FN -> self.collect_fn(node);
			NodeKind.DECL_ENUM -> self.collect_enum(node);
			NodeKind.DECL_CONST -> self.collect_const(node);
			NodeKind.DECL_IMPL -> self.collect_impl(node);
			NodeKind.DECL_TRAIT -> {} // already recorded in Pass 0
			NodeKind.DECL_EXTERN_BLOCK -> self.collect_extern_block(node);
			else -> {}
		}
	}

	pub fn collect_program(var self, program_node: *AstNode) {
		val prog = program_node.as_program();
	
		// Pass 0: register generic templates so any use can instantiate them.
		// Module markers are processed here too, so each template records its module.
		for (d0 in prog) {
			when (d0.kind) {
				NodeKind.DECL_MODULE -> self.collect_module(d0);
				NodeKind.DECL_TRAIT -> self.collect_trait(d0);
				else -> self.register_template(d0);
			}
		}
	

		// Pass 0.4: register wildcard imports before anything resolves a name, so
		// the shell pass below can find a type forward-declared in another module.
		// Explicit imports need their target symbol, so they wait for pass 1a.
		for (d_use in prog) {
			when (d_use.kind) {
				NodeKind.DECL_MODULE -> self.collect_module(d_use);
				NodeKind.DECL_USE -> {
					val u_wild = d_use.as_use_decl();
					if (u_wild.is_wildcard) self.collect_use(d_use);
				}
				else -> {}
			}
		}

		// Pass 0.5: declare every struct name with an opaque type before any field
		// is resolved. Imports may form cycles, so a field can mention a type from
		// a module that is collected later; the passes below fill these shells.
		for (d_half in prog) {
			when (d_half.kind) {
				NodeKind.DECL_MODULE -> self.collect_module(d_half);
				NodeKind.DECL_STRUCT -> {
					val s_half = d_half.as_struct_decl();
					if (s_half.type_params.len == 0) {
						// Global lookup: a forward declaration in another module is the
						// shell this definition will fill in.
						val existing_half = self.symtab.lookup(s_half.name);
						if (existing_half == null) self.declare_struct_shell(d_half, s_half);
					}
				}
				else -> {}
			}
		}

		// Pass 0.6: record trait implementations early so generic bound checks
		// can succeed during signature collection (struct fields, function parameters).
		for (d_impl in prog) {
			when (d_impl.kind) {
				NodeKind.DECL_MODULE -> self.collect_module(d_impl);
				NodeKind.DECL_IMPL -> {
					val im = d_impl.as_impl_decl();
					if (im.type_params.len == 0 && !im.trait_name.empty()) {
						val t = self.symtab.find_trait(im.trait_name);
						if (t != null) self.trait_record_impl(t, im.struct_name);
					}
				}
				else -> {}
			}
		}

		// Pass 1a: collect ordinary declarations (templates, impls and imports - the
		// imports were already registered in pass 0.4 - are deferred).
		for (d1 in prog) {
			if (d1.kind != NodeKind.DECL_IMPL) self.collect_declaration(d1);
		}

		// Pass 1b: collect impl blocks now that all types are registered.
		for (d1 in prog) {
			when (d1.kind) {
				NodeKind.DECL_MODULE -> self.collect_module(d1);
				NodeKind.DECL_IMPL -> self.collect_impl(d1);
				else -> {}
			}
		}
	
		// Pass 2: rewrite generic uses across signatures and bodies, instantiating
		// concrete structs / functions / methods as needed. Module markers are
		// replayed so each declaration resolves names in its own module.
		for (d in prog) {
			if (d is ModuleDecl as m2) {
				self.current_module = m2.full_path;
				self.symtab.set_current_module(m2.full_path);
			} else if (!is_template_decl(d)) {
				self.rewrite_generics(d);
			}
		}
	
		// Pass 3: drain the instance worklist. Each instance was cloned with type
		// arguments substituted syntactically, so its own generic uses are still
		// unresolved; rewriting it here (to a fixpoint) instantiates them in the
		// same declaration pass instead of leaving it to body checking.
		self.drain_instances();

		// Pass 4: append the monomorphized declarations after the source program,
		// in creation order (step 5 / instance graph). No prepend is needed:
		// - the worklist instantiates a dependency before the instance that needs
		//   it, so creation order already is a topological order;
		// - struct bodies are emitted in by-value dependency order by codegen,
		//   and every function gets a prototype before its definition, so no C
		//   ordering constraint remains;
		// - each instance carries its own module marker, so module context is
		//   still correct wherever the pair lands.
		if (self.symtab.gen.instances.len > 0) {
			var combined = List<*AstNode>();
			for (d in prog.declarations) combined += d;
			for (pn in self.symtab.gen.instances) combined += pn;
			val p_info = program_node.as_program() as &Program;
			p_info.declarations = combined;
		}
	}

}