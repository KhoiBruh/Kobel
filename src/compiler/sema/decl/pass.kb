mod compiler.sema.decl;

// ============================================================================
// DeclPass - Type Resolution & Declaration Semantics (Compatibility Bridge)
// Delegates all semantic registration to compiler.semantic.declaration.DeclarationCollector.
// ============================================================================

use std.string.*;
use std.memory.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.TokenType;
use compiler.ast.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.resolution.*;
use compiler.semantic.declaration.*;

pub struct DeclPass {
	pub symtab: SymbolTable = SymbolTable(),
	pub arena: Arena = Arena(),
	pub current_module: str = "",
	pub errors: List<str> = List(),
	pub is_extern: bool = false,
	pub current_self_type: *Type? = null,
	pub subst_names: List<str> = List(),
	pub subst_types: List<*Type> = List(),
	pub current_fn_return_type: *AstNode? = null,
	pub mat_rec: *InstanceRecord? = null
}

impl DeclPass {

	pub init() => Self(SymbolTable(), Arena(), "", List<str>());

	pub fn prims(val self) => self.symtab.prims;

	pub fn enter_module(var self, module: str): str {
		val prev = self.current_module;
		if (module.len > 0) {
			self.current_module = module;
			self.symtab.set_current_module(module);
		}
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.current_module = prev;
		self.symtab.set_current_module(prev);
	}

	pub fn c_name_for(val self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return self.current_module.mangle_symbol(name);
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		val loc = "Line ${node.line}, Column ${node.col}: ";
		if (self.current_module.len > 0) {
			self.errors += "${self.current_module}: ${loc}${msg}";
		} else self.errors += loc + msg;
	}

	pub fn to_collector(val self): DeclarationCollector {
		var c = DeclarationCollector(
			self.symtab, self.arena, self.current_module,
			self.errors, self.is_extern, self.current_self_type
		);
		c.current_fn_return_type = self.current_fn_return_type;
		c.mat_rec = self.mat_rec;
		c.subst_names = self.subst_names;
		c.subst_types = self.subst_types;
		return c;
	}

	pub fn apply_collector(var self, val c: DeclarationCollector) {
		self.symtab = c.symtab;
		self.arena = c.arena;
		self.current_module = c.current_module;
		self.errors = c.errors;
		self.is_extern = c.is_extern;
		self.current_self_type = c.current_self_type;
		self.current_fn_return_type = c.current_fn_return_type;
		self.mat_rec = c.mat_rec;
		self.subst_names = c.subst_names;
		self.subst_types = c.subst_types;
	}

	pub fn to_resolver(val self): TypeResolver {
		var c = self.to_collector();
		return c.to_resolver();
	}

	pub fn apply_resolver(var self, val r: TypeResolver) {
		var c = self.to_collector();
		c.apply_resolver(r);
		self.apply_collector(c);
	}

	pub fn enum_const_i64(var self, expr: *AstNode): i64 {
		var c = self.to_collector();
		val res = c.enum_const_i64(expr);
		self.apply_collector(c);
		return res;
	}

	pub fn collect_impl(var self, node: *AstNode) {
		var c = self.to_collector();
		c.collect_impl(node);
		self.apply_collector(c);
	}

	pub fn infer_const_type(var self, expr: *AstNode?): *Type? {
		var c = self.to_collector();
		val res = c.infer_const_type(expr);
		self.apply_collector(c);
		return res;
	}

	pub fn infer_decl_return_type(var self, f: *FnDecl): *Type? {
		var c = self.to_collector();
		val res = c.infer_decl_return_type(f);
		self.apply_collector(c);
		return res;
	}

	pub fn collect_prim_impl(var self, node: *AstNode, im: *ImplDecl, prim: *Type) {
		var c = self.to_collector();
		c.collect_prim_impl(node, im, prim);
		self.apply_collector(c);
	}

	pub fn trait_record_impl(var self, t: *TraitInfo?, struct_name: str) {
		var c = self.to_collector();
		c.trait_record_impl(t, struct_name);
		self.apply_collector(c);
	}

	pub fn trait_effective(var self, t: *TraitInfo?, out: &List<*TraitMethod>, seen: &HashSet<str>) {
		var c = self.to_collector();
		c.trait_effective(t, out, seen);
		self.apply_collector(c);
	}

	pub fn apply_trait(var self, node: *AstNode, im: *ImplDecl, struct_name: str) {
		var c = self.to_collector();
		c.apply_trait(node, im, struct_name);
		self.apply_collector(c);
	}

	pub fn resolve_ast_type(var self, node: *AstNode): *Type {
		var c = self.to_collector();
		val res = c.resolve_ast_type(node);
		self.apply_collector(c);
		return res;
	}

	pub fn instantiate_struct(var self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): *Type {
		var c = self.to_collector();
		val res = c.instantiate_struct(tmpl, arg_asts);
		self.apply_collector(c);
		return res;
	}

	pub fn instantiate_fn(var self, tmpl: *GenericTemplate, arg_asts: List<*AstNode>): str {
		var c = self.to_collector();
		val res = c.instantiate_fn(tmpl, arg_asts);
		self.apply_collector(c);
		return res;
	}

	pub fn find_fn_template(var self, name: str): *GenericTemplate? {
		var c = self.to_collector();
		val res = c.find_fn_template(name);
		self.apply_collector(c);
		return res;
	}

	pub fn find_struct_template(var self, name: str): *GenericTemplate? {
		var c = self.to_collector();
		val res = c.find_struct_template(name);
		self.apply_collector(c);
		return res;
	}

	pub fn find_method_template(var self, name: str, self_type: str = ""): *GenericTemplate? {
		var c = self.to_collector();
		val res = c.find_method_template(name, self_type);
		self.apply_collector(c);
		return res;
	}

	pub fn register_template(var self, node: *AstNode) {
		var c = self.to_collector();
		c.register_template(node);
		self.apply_collector(c);
	}

	pub fn template_in_module(var self, module: str, name: str): bool {
		var c = self.to_collector();
		val res = c.template_in_module(module, name);
		self.apply_collector(c);
		return res;
	}

	pub fn find_instance_symbol(val self, name: str): *Symbol? {
		val c = self.to_collector();
		return c.find_instance_symbol(name);
	}

	pub fn drain_instances(var self) {
		var c = self.to_collector();
		c.drain_instances();
		self.apply_collector(c);
	}

	pub fn rewrite_generics(var self, node: *AstNode?) {
		var c = self.to_collector();
		c.rewrite_generics(node);
		self.apply_collector(c);
	}

	pub fn propagate_target_type(var self, target_type_node: *AstNode?, init_node: *AstNode?) {
		var c = self.to_collector();
		c.propagate_target_type(target_type_node, init_node);
		self.apply_collector(c);
	}

	pub fn materialize_body(var self, rec: *InstanceRecord): *AstNode {
		var c = self.to_collector();
		val res = c.materialize_body(rec);
		self.apply_collector(c);
		return res;
	}

	pub fn clone_expr(var self, node: *AstNode, subst: *GenericSubst? = null): *AstNode {
		var c = self.to_collector();
		val res = c.clone_expr(node, subst);
		self.apply_collector(c);
		return res;
	}

	pub fn clone_fn(var self, node: *AstNode, subst: *GenericSubst? = null, new_name: str = ""): *AstNode {
		var c = self.to_collector();
		val res = c.clone_fn(node, subst, new_name);
		self.apply_collector(c);
		return res;
	}

	pub fn clone_stmt(var self, node: *AstNode, subst: *GenericSubst? = null): *AstNode {
		var c = self.to_collector();
		val res = c.clone_stmt(node, subst);
		self.apply_collector(c);
		return res;
	}

	pub fn clone_type(var self, node: *AstNode, subst: *GenericSubst? = null): *AstNode {
		var c = self.to_collector();
		val res = c.clone_type(node, subst);
		self.apply_collector(c);
		return res;
	}
}
