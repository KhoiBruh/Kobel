mod compiler.sema.decl.pass;

// ============================================================================
// DeclPass - type resolution and declaration semantics
//
// The declaration pass core. Resolves AST type nodes to `*Type` (with the
// type-parameter substitution stack `subst_names/subst_types`), instantiates
// generic structs/functions/methods, applies `impl Trait for T` contracts, and
// holds the symbol table it shares with the body pass.
//
// The ordered collection driver is `decl.collect`; monomorphization is split
// across `mono.registry` (registry) and the `mono.*` modules (instantiate,
// rewrite, clone).
// ============================================================================

use std.str.*;
use std.mem.arena.*;
use std.collections.list.*;
use std.collections.hash_set.*;

use util.strutil.*;

use compiler.lexer.token.TokenType;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;
use compiler.sema.symbol.*;
use compiler.sema.mono.registry.*;
use compiler.sema.desugar.interp.*;

use compiler.sema.types.DataType;
use compiler.sema.types.Type;
use compiler.sema.prims.PrimTypes;
use compiler.sema.structs.StructField;
use compiler.sema.types.type_none;
use compiler.sema.types.type_bool;
use compiler.sema.types.type_char;
use compiler.sema.types.type_i8;
use compiler.sema.types.type_i16;
use compiler.sema.types.type_i32;
use compiler.sema.types.type_i64;
use compiler.sema.types.type_isz;
use compiler.sema.types.type_u8;
use compiler.sema.types.type_u16;
use compiler.sema.types.type_u32;
use compiler.sema.types.type_u64;
use compiler.sema.types.type_usz;
use compiler.sema.types.type_f32;
use compiler.sema.types.type_f64;
use compiler.sema.types.type_str;
use compiler.sema.methods.MethodInfo;
use compiler.sema.enums.EnumInfo;
use compiler.sema.enums.EnumMemberInfo;

use compiler.sema.instance.*;
use compiler.sema.prims.*;
use compiler.sema.type_ast.*;
use compiler.sema.traits.*;

use compiler.sema.decl.type.*;

use compiler.ast.decl.StructField as AstStructField;

// ============================================================================
// DeclPass - Top-level Declarations Collector
// ============================================================================

pub struct DeclPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_module: str,
	pub errors: List<str>,
	// Currently collecting declarations inside the `extern "libc" { ... }` block
	pub is_extern: bool = false,
	pub current_self_type: *Type = null,
	// Type-parameter substitution while instantiating a generic struct: a type
	// parameter name resolves to the corresponding argument *Type. This is the
	// parameterised part of instantiation - the template AST is never rewritten.
	pub subst_names: List<str> = List<str>(),
	pub subst_types: List<*Type> = List<*Type>(),
	pub current_fn_return_type: *AstNode = null,
	// While materializing a function instance (see mono.clone), the instance
	// whose annotation side table drives the clone. Null otherwise.
	pub mat_rec: *InstanceRecord = null
}

pub fn alloc_primitive(var arena: &Arena, base: Type): *Type => arena.primitive_type(base);

// Source names carried by more than one method of an impl, i.e. overloads.
fn overloaded_names(im: &ImplDecl): List<str> {
	var names = List<str>();
	for (a in 0..<im.methods.len) {
		val na = im.methods[a].as_fn_decl().name;
		if (na in names) continue;
		for (b in (a + 1)..<im.methods.len) {
			if (im.methods[b].as_fn_decl().name == na) {
				names += na;
				break;
			}
		}
	}
	return names;
}

// Distinct C name of one method: `base`, or `<base>_<argc>` when the method name
// is overloaded, bumped to `<base>_<argc>_<k>` while that name is already taken.
// `taken` holds the owning type's mangled method names so far (struct methods ask
// their `StructType`, primitive methods track theirs locally).
fn method_c_name(base: str, argc: usz, overloaded: bool, taken: List<str>): str {
	var name = base;
	if (overloaded) name = "${base}_${argc}";
	var k: usz = 2;
	while (name in taken) {
		name = "${base}_${argc}_${k}";
		k++;
	}
	return name;
}

pub fn parse_decimal_i64(s: str): i64 {
	var v = 0L;
	for (c in s) {
		if (c >= '0' && c <= '9') {
			v = v * 10 + ((c as i32) - 48);
		} else if (c != '_') {
			break;
		}
	}
	return v;
}

// Inserts `m` into `out`, replacing a same-named entry so a derived trait's
// method wins over the base one it inherits.
fn trait_put_method(out: &List<*TraitMethod>, m: *TraitMethod) {
	for (i in 0..<out.len) {
		val e = (*out)[i];
		if (e.name == m.name && e.arity == m.arity) {
			(*out)[i] = m;
			return;
		}
	}
	out += m;
}

impl DeclPass {

	pub fn new() => Self(SymbolTable(), Arena(), "", List<str>());

// Primitive type shorthands: the canonical instance from the symbol table, so
// `i32` is one pointer for the whole compilation.
	pub fn t_none(var self): *Type => self.symtab.prims_of().get(DataType.NONE);
	pub fn t_bool(var self): *Type => self.symtab.prims_of().get(DataType.BOOL);
	pub fn t_char(var self): *Type => self.symtab.prims_of().get(DataType.CHAR);
	pub fn t_str(var self): *Type => self.symtab.prims_of().get(DataType.STR);
	pub fn t_usz(var self): *Type => self.symtab.prims_of().get(DataType.USZ);
	pub fn t_prim(var self, base: Type): *Type => self.symtab.prims_of().get(base.kind) ?: alloc_primitive(&self.arena, base);

	// Switches the module context (both the pass and its symbol table) and
	// returns the previous module so the caller can restore it.
	pub fn enter_module(var self, module: str): str {
		val prev = self.current_module;
		if (module.len > 0) {
			self.current_module = module;
			self.symtab.set_current_module(module);
		}
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.current_module = prev;
		self.symtab.set_current_module(prev);
	}

	pub fn c_name_for(self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return self.current_module.mangle_symbol(name);
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		val loc = "Line ${node.line}, Column ${node.col}: ";
		if (self.current_module.len > 0) {
			self.errors += "${self.current_module}: ${loc}${msg}";
		} else self.errors += loc + msg;
	}

// Evaluates a constant enum member value (integer literal, optionally negated).
	pub fn enum_const_i64(var self, expr: *AstNode): i64 {
		if (expr is LiteralExpr as lit) {
			return parse_decimal_i64(lit.raw_text);
		}
		if (expr is UnaryExpr as un && un.op == TokenType.MINUS) {
			return 0 - self.enum_const_i64(un.operand);
		}
		self.report_error(expr, "Enum member value must be an integer constant");
		return 0;
	}

	pub fn collect_impl(var self, node: *AstNode) {
		val im = node.as_impl_decl() as &ImplDecl;

		// Generic impls (e.g. `impl List<T>`) are lowered by monomorphization; skip here.
		if (im.type_params.len > 0) return;

		// `impl <primitive> { ... }`: the methods extend a built-in type.
		val prim = resolve_primitive_name(self.symtab.prims_of(), im.struct_name);
		if (prim != null) {
			self.collect_prim_impl(node, im, prim);
			return;
		}

		val st_sym = self.symtab.lookup(im.struct_name);
		if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) {
			self.report_error(node, "Cannot impl methods for unknown type '${im.struct_name}'");
			return;
		}

		val st_type = st_sym.type_ptr;
		val st_c_name = st_sym.c_name;
		val st_info = st_type.as_struct_mut();

		self.current_self_type = st_type;

		// Rename so the backend can learn the receiver type of each method.
		im.struct_name = st_c_name;

		// `type Item = ...;` bindings, resolved before any method signature or body
		// in this impl so `Self.Item` resolves.
		self.register_assoc_bindings(node, im, st_type, st_info.name);

		// `impl Trait for Struct`: verify the contract and pull in default methods.
		if (!im.trait_name.empty()) self.apply_trait(node, im, st_info.name);

		// Methods may be overloaded, so each needs a distinct C name.
		val overloaded = overloaded_names(im);
		// C names already owned by this struct (from earlier `impl` blocks too).
		var used_names = List<str>();
		for (m in st_info.methods) used_names += m.c_name;

		for (m_node in im.methods) {
			val f = m_node.as_fn_decl() as &FnDecl;
			if (f.type_params.len > 0) continue;

			if (f.name == "new") {
				for (p in f.params) {
					if (p.name == "self") {
						self.report_error(m_node,
							"Constructor 'new' cannot have a 'self' "
							"parameter in struct '${st_info.name}'"
						);
					}
				}
			}

			if (f.is_op) {
				if (f.params.len == 0 || f.params[0].name != "self") {
					self.report_error(m_node, "Operator '${f.name}' must have 'self' as its first parameter in struct '${st_info.name}'");
				} else {
					val is_mut_self = f.params[0].is_mut;
					when (f.name) {
						"plus", "minus", "mul", "div", "rem",
						"bit_and", "bit_or", "bit_xor", "shl", "shr",
						"equals", "compare", "contains" -> {
							if (f.params.len != 2) {
								self.report_error(m_node, "Binary operator '${f.name}' must take exactly 1 parameter besides 'self'");
							}
						}
						"plus_assign", "minus_assign", "mul_assign", "div_assign", "rem_assign",
						"bit_and_assign", "bit_or_assign", "bit_xor_assign", "shl_assign", "shr_assign" -> {
							if (!is_mut_self) {
								self.report_error(m_node, "Compound assignment operator '${f.name}' requires a mutable receiver 'var self'");
							}
							if (f.params.len != 2) {
								self.report_error(m_node, "Compound assignment operator '${f.name}' must take exactly 1 parameter besides 'self'");
							}
						}
						"get" -> {
							if (f.params.len < 2) {
								self.report_error(m_node, "Index operator 'get' must take at least 1 parameter besides 'self'");
							}
						}
						"set" -> {
							if (!is_mut_self) {
								self.report_error(m_node, "Index assignment operator 'set' requires a mutable receiver 'var self'");
							}
							if (f.params.len < 3) {
								self.report_error(m_node, "Index assignment operator 'set' must take at least 2 parameters besides 'self' (index and value)");
							}
						}
						"negate", "not" -> {
							if (f.params.len != 1) {
								self.report_error(m_node, "Unary operator '${f.name}' cannot take parameters besides 'self'");
							}
						}
						else -> {}
					}
				}
			}

			var param_types = List<*Type>();

			for (p in f.params) {
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver: `*Struct` for `val self`, `*mut Struct` for `var self`.
					pt = self.arena.pointer_type(st_type, p.is_mut);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types += pt;
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type)
			else self.infer_decl_return_type(f) ?: self.t_none();

			// A function-instance method view owns its own FnType (built at view
			// creation), so two instances never mutate a shared signature object.
			val rec_sig = if (m_node.instance != null) (m_node.instance as *InstanceRecord).sig else null;
			val fn_type = if (rec_sig != null) rec_sig else self.arena.fn_type(param_types, ret_type);

			// Two methods with the same name and arity still need distinct names.
			val m_c_name = method_c_name(
				"${st_c_name}_${f.name}", param_types.len, f.name in overloaded, used_names
			);
			used_names += m_c_name;

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type, m_node, self.current_module, f.is_op);
			st_info.methods += mi;

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}

		self.current_self_type = null;
	}

	pub fn infer_decl_return_type(var self, f: &FnDecl): *Type {
		if (f.body is ExprStmt as es && es.expr != null) {
			val expr = es.expr;

			if (expr is LiteralExpr as lit) {
				when (lit.literal_kind) {
					LiteralKind.INT -> {
						val p_type = int_literal_type(self.symtab.prims_of(), lit.raw_text);
						f.return_type = self.arena.named_type(primitive_type_name(p_type), List<*AstNode>(), f.body.line, f.body.col);
						return p_type;
					}
					LiteralKind.FLOAT -> {
						val raw = lit.raw_text;
						val is_f32 = raw.ends_with("f") || raw.ends_with("F");
						if (is_f32) {
							f.return_type = self.arena.named_type("f32", List<*AstNode>(), f.body.line, f.body.col);
							return self.t_prim(type_f32());
						}
						f.return_type = self.arena.named_type("f64", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_prim(type_f64());
					}
					LiteralKind.BOOL -> {
						f.return_type = self.arena.named_type("bool", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_bool();
					}
					LiteralKind.STRING -> {
						f.return_type = self.arena.named_type("str", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_str();
					}
					LiteralKind.CHAR -> {
						f.return_type = self.arena.named_type("char", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_char();
					}
					else -> {}
				}
			}

			if (expr is MemberExpr as mem && mem.object is IdentifierExpr as id) {
				val sym = self.symtab.lookup(id.name);
				if (sym != null && sym.kind == SymbolKind.ENUM && sym.type_ptr != null && sym.type_ptr.is_enum()) {
					val ei = sym.type_ptr.as_enum();
					if (ei.find_member(mem.member) != null) {
						f.return_type = self.arena.named_type(ei.c_name, List<*AstNode>(), f.body.line, f.body.col);
						return sym.type_ptr;
					}
				}
			}

			if (expr is UpdateExpr as u) {
				if (u.target is IdentifierExpr as id) {
					for (p in f.params) {
						if (p.name == id.name && p.type_node != null) {
							f.return_type = p.type_node;
							return self.resolve_ast_type(p.type_node);
						}
					}
				}
				if (
					u.target is MemberExpr as mem &&
					mem.object is IdentifierExpr as obj_id &&
					obj_id.name == "self" &&
					self.current_self_type != null &&
					self.current_self_type.kind == DataType.STRUCT
				) {
					val s_info = self.current_self_type.as_struct();
					for (fld in s_info.fields) {
						if (fld.name == mem.member) {
							val tname = primitive_type_name(fld.type_ptr);
							if (tname != "none") {
								f.return_type = self.arena.named_type(tname, List<*AstNode>(), f.body.line, f.body.col);
								return fld.type_ptr;
							}
						}
					}
				}
			}
		}

		return null;
	}

// Registers the methods of `impl <primitive> { ... }`. There is no C struct to
// hang them on, so the receiver is typed explicitly as the primitive name (the
// backend then passes it by value), and each method goes into the primitive
// method table so `x.m()` can find it.
	pub fn collect_prim_impl(var self, node: *AstNode, im: &ImplDecl, prim: *Type) {
		val prim_name = im.struct_name;
		// Clear the name so codegen does not treat `self` as a pointer receiver.
		im.struct_name = "";

		if (!im.trait_name.empty()) self.apply_trait(node, im, prim_name);

		val overloaded = overloaded_names(im);
		// C names this impl has handed out so far (the prim table is global, so
		// uniqueness is tracked per impl block).
		var used_names = List<str>();

		for (m_node in im.methods) {
			val f = m_node.as_fn_decl() as &FnDecl;
			if (f.type_params.len > 0) continue;
			var param_types = List<*Type>();

			for (i in 0..<f.params.len) {
				val p = f.params[i];
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver by value: spell its type so the backend emits `i32 self`.
					pt = prim;
					val rt = self.arena.named_type(prim_name, List<*AstNode>(), node.line, node.col);
					f.params[i] = Param(p.name, rt, p.is_mut, p.has_val, p.default_val);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types += pt;
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type)
			else self.infer_decl_return_type(f) ?: self.t_none();

			val fn_type = self.arena.fn_type(param_types, ret_type);

			val m_c_name = method_c_name(
				"${prim_name}_${f.name}", param_types.len, f.name in overloaded, used_names
			);
			used_names += m_c_name;

			if (self.symtab.find_prim_method_arity(prim.kind, f.name, f.params.len) != null) {
				self.report_error(m_node,
					"Duplicate method '${f.name}' "
					"with ${f.params.len} parameter(s) "
					"for built-in type '${prim_name}'"
				);
			}

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type, m_node, self.current_module, f.is_op);
			self.symtab.register_prim_method(prim, mi);

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}
	}

// Records that `struct_name` implements `t` and, transitively, every trait that
// `t` inherits: implementing a trait means implementing its base traits too, so
// a `<T: Base>` bound is satisfied by an `impl Derived for T` when
// `Derived : Base`. The already-recorded test also breaks a cyclic base chain.
	pub fn trait_record_impl(var self, t: *TraitInfo, struct_name: str) {
		if (t == null) return;
		if (t.has_impl(struct_name)) return;
		t.impls += struct_name;
		for (bname in t.bases) self.trait_record_impl(self.symtab.find_trait(bname), struct_name);
	}

// Flattens a trait and its base traits into one method list: base traits are
// visited first, so a method declared in a derived trait replaces a same-named
// inherited one. `seen` stops a cycle in a mis-declared `trait A : B` /
// `trait B : A` chain.
	pub fn trait_effective(var self, t: *TraitInfo, out: &List<*TraitMethod>, seen: &HashSet) {
		if (t == null) return;
		if (t.name in seen) return;
		seen += t.name;

		for (bname in t.bases) self.trait_effective(self.symtab.find_trait(bname), out, seen);
		for (m in t.methods) trait_put_method(out, m);
	}

// Applies the trait named by `im.trait_name` to an `impl Trait for Struct`
// block: every required method (one without a body) must be provided, and every
// default method the impl left out is copied in. A copy is an ordinary method
// AST node, so the backend emits it like a hand-written one. Generic impls
// return earlier, so no type substitution is ever needed here.
	// Resolves an impl's `type Item = T;` bindings and checks them against the
	// trait's `type Item;` declarations. The binding is stored by struct name, so
	// `Self.Item` can be resolved during declaration collection and later while
	// checking method bodies.
	fn register_assoc_bindings(var self, node: *AstNode, im: &ImplDecl, st_type: *Type, struct_name: str) {
		var trait_info: *TraitInfo = null;
		if (!im.trait_name.empty()) trait_info = self.symtab.find_trait(im.trait_name);
		if (trait_info == null) {
			if (!im.assoc_bindings.empty()) {
				self.report_error(node,
					"Associated types can only be bound in an impl of a known trait"
				);
			}
			return;
		}

		val assoc_decls = trait_info.assoc_types;
		for (b in im.assoc_bindings) {
			var declared = false;
			for (a in assoc_decls) if (a == b.name) declared = true;
			if (!declared) {
				self.report_error(node,
					"Trait '${trait_info.name}' has no associated type '${b.name}'"
				);
			}
			if (self.symtab.find_assoc_type(struct_name, b.name) != null) {
				self.report_error(node,
					"Duplicate binding of associated type '${b.name}' for '${struct_name}'"
				);
				continue;
			}
			val bound = self.resolve_ast_type(b.type_node);
			if (bound.kind == DataType.POINTER || bound.kind == DataType.ARRAY) {
				self.report_error(b.type_node,
					"Associated type '${b.name}' must be a named type (struct, enum or primitive)"
				);
				continue;
			}
			self.symtab.set_assoc_type(struct_name, b.name, bound);
		}

		for (required in assoc_decls) {
			if (self.symtab.find_assoc_type(struct_name, required) == null) {
				self.report_error(node,
					"Impl of trait '${trait_info.name}' must bind associated type '${required}'"
				);
			}
		}
	}

	pub fn apply_trait(var self, node: *AstNode, im: &ImplDecl, struct_name: str) {
		val t = self.symtab.find_trait(im.trait_name);
		if (t == null) {
			self.report_error(node, "Unknown trait '${im.trait_name}'");
			return;
		}

		// Remember the implementation so a `<T: Trait>` bound can be checked later.
		self.trait_record_impl(t, struct_name);

		// A trait inherits every method of its base traits, so the contract covers
// the flattened set rather than just the methods written in this trait.
		var effective = List<*TraitMethod>();
		var seen = HashSet();
		self.trait_effective(t, &effective, &seen);

		for (tm in effective) {
			var have = false;
			for (m in im.methods) {
				val f = m.as_fn_decl();
				if (f.name == tm.name && f.params.len == tm.arity) have = true;
			}
			if (have) continue;

			if (!tm.has_default) {
				self.report_error(node,
					"Struct '${struct_name}' does not implement "
					"required trait method '${tm.name}' "
					"of trait '${t.name}'"
				);
				continue;
			}
			im.methods += self.clone_fn(tm.node, null, tm.name);
		}
	}
}
