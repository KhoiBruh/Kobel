mod compiler.sema.body.call;

// ============================================================================
// BodyPass - Call Expression & Constructor Resolution
//
// Resolves function calls, instance and primitive methods, type size queries,
// string slicing, and struct construction (both `new` constructors and field lists).
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl.pass.*;
use compiler.sema.body.pass.*;
use compiler.sema.body.expr.*;

use compiler.sema.template.*;

use compiler.sema.methods.*;

use compiler.sema.prims.*;
use compiler.sema.type_ast.*;

impl BodyPass {

	pub fn check_call_expr(var self, node: *AstNode): *Type {
		val call = node.as_call_expr() as &CallExpr;

		// Primitive char constructor: char(code)
		if (call.callee is IdentifierExpr as id && id.name == "char") {
			return self.check_char_ctor(node, self.prims().t_char(), call);
		}

		// Check member call queries: T.size(), s.slice(...) or instance/primitive methods
		val callee = call.callee;
		if (callee is MemberExpr as mem) {
			if (mem.member == "size") return self.lower_size_query(node, mem);
			if (mem.member == "slice") return self.check_slice_call(node, mem, call);

			// `Shape.Circle(1.5)`: a payload-enum variant.
			val enum_ty = self.check_enum_ctor_call(node, mem, call);
			if (enum_ty != null) return enum_ty;

			// Instance method call or primitive method call
			val m_ty = self.check_method_call(node, mem, call);
			if (m_ty != null) return m_ty;
		}

		// `Self(...)` builds the value directly, so it never consults a
		// `new` factory (that is what keeps `fn new() => Self(...)` from
		// calling itself again).
		var callee_is_self = false;
		if (callee is IdentifierExpr as id) {
			callee_is_self = (id.name == "Self");
		}

		// Explicit type arguments on a callee identifier (`f<X>(...)`,
		// `List<T>(...)`) inside a shared template body: the declaration pass
		// rewrites such calls outside templates; here they are resolved per
		// instance, without mutating the shared call node.
		if (!call.type_args.empty() && callee is IdentifierExpr as cid) {
			val ft = self.find_fn_template_for(cid.name);
			if (ft != null) {
				val cname = self.instantiate_template_fn(ft, call.type_args);
				val sym = self.symtab.lookup(cname);
				if (sym != null && sym.type_ptr.kind == DataType.FN) {
					self.ensure_callee_ready(sym);
					val new_call = self.arena.call(
						self.arena.identifier(cname, node.line, node.col),
						call.args, List<*AstNode>(), node.line, node.col
					);
					val new_cc = new_call.as_call_expr() as &CallExpr;
					self.set_resolved(node, new_call);
					return self.check_fn_call(new_call, sym.type_ptr, new_cc);
				}
			}
			val st = self.find_struct_template_for(cid.name);
			if (st != null) {
				val cty = self.instantiate_template_struct(st, call.type_args);
				if (cty.kind == DataType.STRUCT) {
					val cname = cty.as_struct().name;
					val new_call = self.arena.call(
						self.arena.identifier(cname, node.line, node.col),
						call.args, List<*AstNode>(), node.line, node.col
					);
					val new_cc = new_call.as_call_expr() as &CallExpr;
					self.set_resolved(node, new_call);
					return self.check_struct_ctor(new_call, cty, new_cc, false);
				}
			}
		}

		if (call.type_args.empty() && callee is IdentifierExpr as cid) {
			val local_sym = self.symtab.lookup(cid.name);
			val is_local_var = local_sym != null && (
				local_sym.kind == SymbolKind.VAR ||
				local_sym.kind == SymbolKind.PARAM
			);
			if (!is_local_var && (local_sym == null || (local_sym.kind != SymbolKind.FN && local_sym.kind != SymbolKind.STRUCT))) {
				val ft = self.find_fn_template_for(cid.name);
				if (ft != null && ft.node.kind == NodeKind.DECL_FN) {
					val inferred_targs = self.infer_type_args_for_fn(ft.node.as_fn_decl(), call.args, false);
					if (!inferred_targs.empty()) {
						val cname = self.instantiate_template_fn(ft, inferred_targs);
						val sym = self.symtab.lookup(cname);
						if (sym != null && sym.type_ptr.kind == DataType.FN) {
							self.ensure_callee_ready(sym);
							val new_call = self.arena.call(
								self.arena.identifier(cname, node.line, node.col),
								call.args, List<*AstNode>(), node.line, node.col
							);
							val new_cc = new_call.as_call_expr() as &CallExpr;
							self.set_resolved(node, new_call);
							return self.check_fn_call(new_call, sym.type_ptr, new_cc);
						}
					} else {
						self.report_error(node, "Cannot infer type arguments for generic function '${cid.name}'; provide them explicitly");
						return self.prims().t_none();
					}
				}
				val st = self.find_struct_template_for(cid.name);
				if (st != null && st.node.kind == NodeKind.DECL_STRUCT) {
					val inferred_targs = self.infer_type_args_for_struct(st.node.as_struct_decl(), call.args);
					if (!inferred_targs.empty()) {
						val cty = self.instantiate_template_struct(st, inferred_targs);
						if (cty.kind == DataType.STRUCT) {
							val cname = cty.as_struct().name;
							val new_call = self.arena.call(
								self.arena.identifier(cname, node.line, node.col),
								call.args, List<*AstNode>(), node.line, node.col
							);
							val new_cc = new_call.as_call_expr() as &CallExpr;
							self.set_resolved(node, new_call);
							return self.check_struct_ctor(new_call, cty, new_cc, false);
						}
					}
				}
			}
		}

		val callee_ty = self.check_expr(call.callee);

		// 1. Function call
		if (callee_ty.kind == DataType.FN) return self.check_fn_call(node, callee_ty, call);

		// 2. Struct construction: Point(1, 2)
		if (callee_ty.kind == DataType.STRUCT) return self.check_struct_ctor(node, callee_ty, call, callee_is_self);

		// 3. Enum construction: HttpMethod("GET"), Status(200)
		if (callee_ty.is_enum() && !callee_ty.as_enum().is_payload) {
			return self.check_enum_value_ctor(node, callee_ty, call);
		}

		self.report_error(node, "Callee is not a function, struct, or enum");
		return self.prims().t_none();
	}

	// `T.size()`. A type parameter of the enclosing instance becomes a
	// `SizeOfParam` node that the backend lowers against the instance's concrete
	// argument. A primitive type name has no C type of its own (`str`, `bool`,
	// ...), so it resolves to its C size literal; otherwise the name is mangled
	// so the backend emits `sizeof(<c_name>)`.
	fn check_enum_value_ctor(var self, node: *AstNode, enum_ty: *Type, call: &CallExpr): *Type {
		val info = enum_ty.as_enum();
		if (call.args.len != 1) {
			self.report_error(node, "Enum constructor '${info.name}' requires exactly 1 argument");
			return enum_ty;
		}

		val under = info.underlying;
		val arg = call.args[0];
		val arg_ty = self.check_expr(arg, under);

		if (!under.can_assign(arg_ty)) {
			self.report_error(
				arg,
				"Cannot initialize enum '${info.name}' with value of type '${self.type_display(arg_ty)}' (expected '${self.type_display(under)}')"
			);
		}

		self.set_resolved(node, arg);
		return enum_ty;
	}

	fn check_char_ctor(var self, node: *AstNode, char_ty: *Type, call: &CallExpr): *Type {
		if (call.args.len != 1) {
			self.report_error(node, "Constructor 'char' requires exactly 1 argument");
			return char_ty;
		}
		val arg = call.args[0];
		val arg_ty = self.check_expr(arg, self.prims().t_i32());
		if (!arg_ty.is_integer()) {
			self.report_error(
				arg,
				"Cannot initialize 'char' with value of type '${self.type_display(arg_ty)}' (expected integer)"
			);
		}
		self.annotate_type(call.callee, char_ty);
		return char_ty;
	}

	fn lower_size_query(var self, node: *AstNode, mem: *MemberExpr): *Type {
		val obj = mem.object;
		if (obj is IdentifierExpr as var id) {
			val idx = self.type_param_index(id.name);
			if (idx >= 0) {
				val arg_ty = if (self.has_decl && (idx as usz) < self.decl.subst_types.len)
					self.decl.subst_types[idx as usz] else null;
				val size_text = self.type_c_size_text(arg_ty);
				self.set_resolved(node, self.arena.size_of_param(idx as usz, size_text, node.line, node.col));
				return self.prims().t_usz();
			}

			val csize = prim_c_size(id.name);
			if (csize > 0) {
				self.set_resolved(node, self.arena.literal(LiteralKind.INT, "${csize}", node.line, node.col));
				return self.prims().t_usz();
			}

			val tsym = self.symtab.lookup(id.name);
			if (tsym != null && tsym.c_name != id.name) {
				self.set_ident_name(obj, tsym.c_name);
			}
		}
		return self.prims().t_usz();
	}

	// `s.slice(a, b)` is validated here; the `lower` pass rewrites it into
	// `kobel_slice(s, a, b)` with defaults (0 and `kobel_slen(s)`).
	fn check_slice_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr): *Type {
		val slice_recv = self.check_expr(mem.object);
		self.ensure(slice_recv.kind == DataType.STR, node, "slice() requires a str receiver");
		for (arg in call.args) {
			val at = self.check_expr(arg);
			self.ensure(at.is_integer(), node, "slice() bounds must be integers");
		}
		return self.prims().t_str();
	}

	// A method may be called with fewer arguments than it declares when the
	// missing tail all has defaults; clone those defaults into the call so the
	// arity check and the backend see the complete argument list.
	fn append_defaults(var self, node: *AstNode, argc: usz, call: &CallExpr): bool {
		if (node is FnDecl as f && argc < f.params.len) {
			for (i in argc..<f.params.len) {
				if (f.params[i].default_val == null) return false;
			}
			for (i in argc..<f.params.len) {
				call.args += self.copy_expr(f.params[i].default_val!);
			}
			return true;
		}
		return false;
	}

	// Overload resolution is by arity, so an exact match wins; otherwise the
	// first candidate whose missing tail is all-default does. `found` is the
	// exact-arity result, already resolved by the caller.
	fn method_with_defaults(var self, name: str, argc: usz, cands: List<*MethodInfo>, call: &CallExpr, found: *MethodInfo?): *MethodInfo? {
		if (found != null) return found;
		for (m in cands) {
			if (m.name != name || m.ast_node == null) continue;
			val ast_n = m.ast_node ?: continue;
			if (!self.append_defaults(ast_n, argc, call)) continue;
			return m;
		}
		return null;
	}

	// Check the arguments and record which method was chosen. Rewriting the call
	// into `c_name(recv, args)` is the `lower` pass's job: it reads
	// `resolved_method` and derives the receiver convention from the types, so
	// the checker never has to build replacement nodes.
	fn bind_method_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr, mi: *MethodInfo, obj_ty: *Type): *Type {
		val fn_info = mi.fn_type.as_fn();

		if (call.args.len + 1 != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
		} else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i + 1];
				val arg_n = call.args[i];
				if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
				val arg_ty = self.check_expr(arg_n, param_ty);
				self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in method call '${mem.member}'");
			}
		}

		if (self.arrow_pending(mi.ast_node)) self.infer_blocked = true;

		var ret_ty = fn_info.return_type;
		if (mem.is_safe) {
			self.ensure(ret_ty.kind == DataType.POINTER || ret_ty.kind == DataType.STR, node, "Safe method call '?.' requires return type to be a pointer or string");
			if (ret_ty.kind == DataType.POINTER) {
				val pt = ret_ty.as_pointer();
				ret_ty = self.arena.nullable_pointer_type(pt.pointee, pt.is_mut);
			}
		}

		self.set_method(node, mi);
		return ret_ty;
	}

	pub fn check_method_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr): *Type? {
		// Instance method call: obj.m(args) -> Struct_m(self, args)
		val obj_raw_ty = self.check_expr(mem.object);
		var obj_ty = obj_raw_ty;
		var obj_is_ptr = false;
		if (obj_ty.kind == DataType.POINTER) {
			obj_is_ptr = true;
			obj_ty = obj_ty.as_pointer().pointee;
		}

		if (obj_is_ptr && mem.member == "addr") {
			if (call.args.len != 0) {
				self.report_error(node, "Method 'addr' takes no arguments");
			}
			return self.prims().t_usz();
		}

		if (obj_raw_ty.kind == DataType.CHAR && mem.member == "code") {
			if (call.args.len != 0) {
				self.report_error(node, "Method 'code' takes no arguments");
			}
			return self.prims().t_i32();
		}

		if (mem.is_safe && !obj_is_ptr) {
			self.report_error(node, "Safe call operator '?.' requires a pointer receiver");
			return self.prims().t_none();
		}
		val argc = call.args.len + 1;

		// `x.m<T>(...)`: a generic method is instantiated here, where the receiver
		// type is known, and the call becomes a plain free-function call.
		if (call.type_args.len > 0) {
			val g_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr);
			if (g_ty != null) return g_ty;
		}

		if (obj_ty.kind == DataType.STRUCT) {
			val s_info = obj_ty.as_struct();
			// Pick the overload whose arity matches; fall back to a name
			// lookup so an arity error still reads as before.
			if (s_info.count_method_arity(mem.member, argc) > 1) {
				self.report_error(
					node,
					"Ambiguous call to '${mem.member}': "
					"overloading by parameter type is not supported"
				);
			}
			val mi = self.method_with_defaults(
				mem.member, argc, s_info.methods, call, s_info.find_method_arity(mem.member, argc)
			) ?: s_info.find_method(mem.member);
			// Struct methods take the receiver by reference.
			if (mi != null) return self.bind_method_call(node, mem, call, mi, obj_ty);
		}

		// Primitive method: x.m(args) -> <prim>_m(x, args), receiver by value.
		val pmi = self.method_with_defaults(
			mem.member, argc, self.symtab.prim_methods_of(obj_ty.kind), call,
			self.symtab.find_prim_method_arity(obj_ty.kind, mem.member, argc)
		) ?: self.symtab.find_prim_method(obj_ty.kind, mem.member);
		// Primitive methods take the receiver by value.
		if (pmi != null) return self.bind_method_call(node, mem, call, pmi, obj_ty);

		if (obj_ty.kind == DataType.STRUCT) {
			val g_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr);
			if (g_ty != null) return g_ty;
			self.report_error(node, "Method '${mem.member}' not found on type '${obj_ty.as_struct().name}'");
			return self.prims().t_none();
		}

		val g_prim_ty = self.check_generic_method_call(node, mem, call, obj_ty, obj_is_ptr);
		if (g_prim_ty != null) return g_prim_ty;

		return null;
	}

	// `x.m<T>(...)` where `m` is a generic method. The template is chosen by
	// receiver type (not by name alone), instantiated with T, and the call is
	// checked as the resulting free function with the receiver as first argument.
	// `lower` emits the replacement node registered in `resolved_node`.
	fn check_generic_method_call(
		var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr,
		obj_ty: *Type, obj_is_ptr: bool
	): *Type? {
		val recv_name = if (obj_ty.kind == DataType.STRUCT) obj_ty.as_struct().name
			else primitive_type_name(obj_ty);
		if (recv_name.empty()) return null;

		var tmpl = self.find_method_template_for(mem.member, recv_name);
		// Inside a shared generic body the receiver is the *instance* type, whose
		// name differs from the template's source name; fall back to a name-only
		// match (the pre-121a335 behavior for cloned bodies).
		if (tmpl == null) tmpl = self.find_method_template_for(mem.member, "");
		if (tmpl == null) return null;

		var targs = call.type_args;
		if (targs.empty() && tmpl.node.kind == NodeKind.DECL_FN) {
			targs = self.infer_type_args_for_fn(tmpl.node.as_fn_decl(), call.args, true);
			if (targs.empty()) return null;
		}

		val cname = self.instantiate_method(tmpl!, targs, obj_ty);
		val sym = self.symtab.lookup(cname);
		if (sym == null || sym.type_ptr.kind != DataType.FN) return null;

		// The clone's return type comes from its body, so that body must be checked
		// before its signature is read.
		self.ensure_callee_ready(sym);
		val fn_info = sym.type_ptr.as_fn();

		// Struct methods take `&receiver` unless the receiver is already a pointer;
		// primitive methods take the receiver by value.
		var args = List<*AstNode>();
		if (obj_ty.kind == DataType.STRUCT && !obj_is_ptr) {
			args += self.arena.unary(TokenType.AMPERSAND, mem.object, node.line, node.col);
		} else {
			args += mem.object;
		}
		for (a in call.args) args += a;

		val new_call = self.arena.call(
			self.arena.identifier(cname, node.line, node.col),
			args, List<*AstNode>(), node.line, node.col
		);

		if (args.len != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
		} else {
			// Argument 0 is the receiver, already checked above.
			for (i in 1..<args.len) {
				val param_ty = fn_info.param_types[i];
				val arg_n = args[i];
				if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
				val arg_ty = self.check_expr(arg_n, param_ty);
				self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in method call '${mem.member}'");
			}
		}

		self.set_resolved(node, new_call);
		return fn_info.return_type;
	}

	// Template lookups and instantiation through the shared declaration pass, so
	// the instance tables stay coherent with this pass (same pattern as
	// `find_method_template_for` / `instantiate_method`).

	fn find_fn_template_for(var self, name: str): *GenTemplate? {
		if (self.has_decl) return self.decl.find_fn_template(name);
		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_fn_template(name);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	fn find_struct_template_for(var self, name: str): *GenTemplate? {
		if (self.has_decl) return self.decl.find_struct_template(name);
		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_struct_template(name);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	fn instantiate_template_fn(var self, tmpl: *GenTemplate, arg_asts: List<*AstNode>): str {
		self.decl.symtab = self.symtab;
		self.decl.current_module = self.symtab.current_module;
		self.decl.current_self_type = self.current_self_type;
		self.decl.errors = self.errors;
		val cname = self.decl.instantiate_fn(tmpl, arg_asts);
		self.symtab = self.decl.symtab;
		self.errors = self.decl.errors;
		return cname;
	}

	fn instantiate_template_struct(var self, tmpl: *GenTemplate, arg_asts: List<*AstNode>): *Type {
		self.decl.symtab = self.symtab;
		self.decl.current_module = self.symtab.current_module;
		self.decl.current_self_type = self.current_self_type;
		self.decl.errors = self.errors;
		val ty = self.decl.instantiate_struct(tmpl, arg_asts);
		self.symtab = self.decl.symtab;
		self.errors = self.decl.errors;
		return ty;
	}

	// A clone's return type comes from checking its body, so a call to a clone
	// whose type is still unknown triggers that check first. During arrow
	// inference the attempt is rolled back instead (see infer_arrow_returns).
	fn ensure_callee_ready(var self, sym: *Symbol?) {
		if (sym == null) return;
		if (sym == null || sym.ast_node == null) return;
		val ast = sym.ast_node!;
		if (!self.arrow_pending(ast)) return;

		// Checking another body must not leak its return type into ours.
		val saved_ret = self.current_fn_return_type;
		self.check_fn(ast);
		self.current_fn_return_type = saved_ret;

		// Still unknown: the callee depends on something unresolved (a cycle), so
		// the current arrow-inference attempt has to be retried later.
		if (self.arrow_pending(ast)) self.infer_blocked = true;
	}

	// `Enum.Variant(args)`: a payload-enum value. Null when the callee's receiver
	// is not a payload enum, which sends the call down the ordinary method path.
	fn check_enum_ctor_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr): *Type? {
		val obj = mem.object;
		if (obj.kind != NodeKind.EXPR_IDENTIFIER) return null;
		val enum_id = obj.as_identifier_expr();
		val ei = self.symtab.find_enum_info(enum_id.name);
		if (ei == null || !ei.is_payload) return null;

		val e_sym = self.symtab.lookup(ei.name);
		if (e_sym == null) return null;

		val mi = ei.find_member(mem.member);
		if (mi == null) {
			self.report_error(node, "Enum '${enum_id.name}' has no variant '${mem.member}'");
			return self.prims().t_none();
		}

		var field_types = List<*Type>();
		if (mi.payload_ty != null) {
			val payload_fields = mi.payload_ty.as_struct().fields;
			for (f in payload_fields) field_types += f.type_ptr;
		}

		if (call.args.len != field_types.len) {
			self.report_error(node,
				"Argument count mismatch in variant '${enum_id.name}.${mem.member}'"
			);
		} else {
			for (i in 0..<call.args.len) {
				val f_ty = field_types[i];
				val arg_n = call.args[i];
				if (f_ty != null && f_ty.is_list()) self.coerce_to_list(arg_n, f_ty);
				val arg_ty = self.check_expr(arg_n, f_ty);
				self.ensure(f_ty.can_assign(arg_ty), node,
					"Field type mismatch in variant '${enum_id.name}.${mem.member}'"
				);
			}
		}

		val payload_path = if (field_types.empty()) "" else mi.payload_path;
		self.set_resolved(node, self.arena.enum_ctor(
			ei.c_name, ei.tag_field, mi.value, payload_path, call.args, node.line, node.col
		));
		return e_sym.type_ptr;
	}

	pub fn check_fn_call(var self, node: *AstNode, callee_ty: *Type, call: &CallExpr): *Type {
		val callee = call.callee;
		if (callee is IdentifierExpr as id) {
			val sym = self.symtab.lookup(id.name);
			if (sym != null) {
				if (sym.ast_node != null) self.append_defaults(sym.ast_node!, call.args.len, call);
				self.ensure_callee_ready(sym);
			}
		}
		val fn_info = callee_ty.as_fn();
		if (call.args.len != fn_info.param_types.len) self.report_error(node, "Argument count mismatch in function call");
		else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i];
				val arg_n = call.args[i];
				if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
				val arg_ty = self.check_expr(arg_n, param_ty);
				if (!param_ty.can_assign(arg_ty)) {
					if (param_ty.kind == DataType.POINTER && arg_ty.kind == DataType.STRUCT) {
						val p_pointee = param_ty.as_pointer().pointee;
						if (p_pointee.equals(arg_ty)) {
							call.args[i] = self.arena.unary(TokenType.AMPERSAND, arg_n, arg_n.line, arg_n.col);
							continue;
						}
					}
					self.report_error(node, "Argument type mismatch in function call");
				}
			}
		}
		return fn_info.return_type;
	}

	pub fn check_struct_ctor(var self, node: *AstNode, callee_ty: *Type, call: &CallExpr, callee_is_self: bool): *Type {
		val s_info = callee_ty.as_struct();

		// Kotlin-style construction: `Type(args)` calls the `new`
		// overload of matching arity when one exists; building from
		// fields is only the fallback.
		if (!callee_is_self) {
			if (s_info.count_method_arity("new", call.args.len) > 1) self.report_error(
				node,
				"Ambiguous call to 'new': "
				"overloading by parameter type is not supported"
			);
			val nm = self.method_with_defaults(
				"new", call.args.len, s_info.methods, call, s_info.find_method_arity("new", call.args.len)
			);
			if (nm != null) {
				val n_info = nm.fn_type.as_fn();
				for (i in 0..<call.args.len) {
					val param_ty = n_info.param_types[i];
					val arg_n = call.args[i];
					if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
					val arg_ty = self.check_expr(arg_n, param_ty);
					self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in call to 'new'");
				}
				// The chosen `new` is recorded, not spliced into the callee: `lower`
				// emits `c_name(args)`. This keeps checking idempotent (a retried
				// check sees the same struct constructor, not a mangled identifier).
				self.set_method(node, nm);
				// The `new` factory's return type may still be pending arrow
				// inference (generic instances are often instantiated lazily). Signal
				// the inference pass to retry instead of caching a `none` result.
				if (self.arrow_pending(nm.ast_node)) self.infer_blocked = true;
				return n_info.return_type;
			}
		}

		// Field construction is only allowed where the type is declared
		// unless every field is `pub`; otherwise the type must expose a
		// `new` constructor (handled above).
		if (
			s_info.has_private &&
			s_info.module != self.symtab.current_module
		) self.report_error(
			node,
			"Cannot construct '${s_info.name}' from its fields: "
			"they are private to module '${s_info.module}'; "
			"add a 'new' constructor"
		);

		if (call.args.len < s_info.fields.len) {
			var all_default = true;
			for (i in call.args.len..<s_info.fields.len) {
				if (s_info.fields[i].default_val == null) {
					all_default = false;
					break;
				}
			}
			if (all_default) {
				for (i in call.args.len..<s_info.fields.len) {
					call.args += self.copy_expr(s_info.fields[i].default_val!);
				}
			}
		}

		if (call.args.len != s_info.fields.len) self.report_error(node, "Argument count mismatch in struct constructor");
		else {
			for (i in 0..<call.args.len) {
				val f_ty = s_info.fields[i].type_ptr;
				val arg_n = call.args[i];
				if (f_ty != null && f_ty.is_list()) self.coerce_to_list(arg_n, f_ty);
				val arg_ty = self.check_expr(arg_n, f_ty);
				self.ensure(f_ty.can_assign(arg_ty), node, "Field type mismatch in struct constructor: '${s_info.c_name}.${s_info.fields[i].name}' expects ${self.type_display(f_ty)} got ${self.type_display(arg_ty)}");
			}
		}

		// Field construction becomes an explicit struct-literal node, so the backend
		// no longer recognises a constructor by the callee's name.
		self.set_resolved(node, self.arena.struct_ctor(s_info.c_name, call.args, node.line, node.col));
		return callee_ty;
	}

fn infer_type_args_for_fn(
		var self,
		fn_decl: *FnDecl,
		call_args: List<*AstNode>,
		is_method: bool
	): List<*AstNode> {
		val type_params = fn_decl.type_params;
		if (type_params.empty()) return List<*AstNode>();

		val num_tparams = type_params.len;
		var inferred = List<*Type>();
		for (k in 0..<num_tparams) inferred.add(self.prims().t_none());

		val params = fn_decl.params;
		for (i in 0..<call_args.len) {
			val param_idx = if (is_method) i + 1 else i;
			if (param_idx >= params.len) break;
			val p = params[param_idx];
			if (p.type_node == null) continue;

			val arg_ty = self.check_expr(call_args[i]);
			if (arg_ty == null || arg_ty.kind == DataType.NONE) continue;

			self.match_type_param(p.type_node!, arg_ty, type_params, inferred.data);
		}

		for (k in 0..<num_tparams) {
			if (inferred[k].kind == DataType.NONE) return List<*AstNode>();
		}

		var result = List<*AstNode>();
		for (k in 0..<num_tparams) {
			result += self.arena.ast_type_from_type(inferred[k]);
		}
		return result;
	}

	fn infer_type_args_for_struct(
		var self,
		decl: *StructDecl,
		call_args: List<*AstNode>
	): List<*AstNode> {
		val type_params = decl.type_params;
		if (type_params.empty()) return List<*AstNode>();

		val num_tparams = type_params.len;
		var inferred = List<*Type>();
		for (k in 0..<num_tparams) inferred.add(self.prims().t_none());

		val fields = decl.fields;
		for (i in 0..<call_args.len) {
			if (i >= fields.len) break;
			val f = fields[i];
			
			val arg_ty = self.check_expr(call_args[i]);
			if (arg_ty == null || arg_ty.kind == DataType.NONE) continue;

			self.match_type_param(f.type_node, arg_ty, type_params, inferred.data);
		}

		for (k in 0..<num_tparams) {
			if (inferred[k].kind == DataType.NONE) return List<*AstNode>();
		}

		var result = List<*AstNode>();
		for (k in 0..<num_tparams) {
			result += self.arena.ast_type_from_type(inferred[k]);
		}
		return result;
	}

	fn match_type_param(
		var self,
		param_ty_node: *AstNode,
		arg_ty: *Type,
		type_params: List<GenericParam>,
		inferred: &*Type
	) {
		if (param_ty_node == null || arg_ty == null) return;

		when (param_ty_node) {
			is NamedType as nt -> {
				if (nt.type_args.empty()) {
					for (k in 0..<type_params.len) {
						if (type_params[k].name == nt.name) {
							if (inferred[k].kind == DataType.NONE) {
								inferred[k] = arg_ty;
							} else if (!inferred[k].equals(arg_ty)) {
								if (inferred[k].is_integer() && arg_ty.is_integer() && arg_ty.size > inferred[k].size) {
									inferred[k] = arg_ty;
								}
							}
							return;
						}
					}
				} else {
					if (arg_ty.kind == DataType.STRUCT) {
						val st = arg_ty.as_struct();
						val rec = self.symtab.gen.find_record_by_cname(st.c_name);
						if (rec != null && rec.args.len == nt.type_args.len) {
							for (j in 0..<nt.type_args.len) {
								self.match_type_param(nt.type_args[j], rec.args[j], type_params, inferred);
							}
						}
					} else if (nt.name == "List" && nt.type_args.len == 1 && arg_ty.kind == DataType.ARRAY) {
						self.match_type_param(nt.type_args[0], arg_ty.as_array().elem, type_params, inferred);
					}
				}
			}
			is PointerType as pt -> {
				if (arg_ty.kind == DataType.POINTER) {
					self.match_type_param(pt.pointee, arg_ty.as_pointer().pointee, type_params, inferred);
				} else {
					self.match_type_param(pt.pointee, arg_ty, type_params, inferred);
				}
			}
			is NullableType as nult -> {
				if (arg_ty.kind == DataType.POINTER) {
					self.match_type_param(nult.inner, arg_ty, type_params, inferred);
				}
			}
			is ArrayType as at -> {
				if (arg_ty.kind == DataType.ARRAY) {
					self.match_type_param(at.element_type, arg_ty.as_array().elem, type_params, inferred);
				}
			}
		}
	}
}
