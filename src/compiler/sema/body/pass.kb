mod compiler.sema.body.pass;

// ============================================================================
// BodyPass - Type Checker & Body Analyzer Core Dispatcher
//
// Coordinates statement and expression checking across AST nodes.
// Specific node checks are factored into:
// - `body/stmt.kb`: statement analysis (blocks, declarations, loops, returns)
// - `body/expr.kb`: expression analysis (operators, accessors, assignments)
// - `body/call.kb`: call resolution, methods, and constructors
// - `body/program.kb`: module, function, and impl declaration drivers
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;
use std.collections.hash_map.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl.pass.*;
use compiler.sema.desugar.interp.*;
use compiler.sema.body.stmt.*;
use compiler.sema.body.expr.*;
use compiler.sema.body.access.*;
use compiler.sema.body.pattern.*;
use compiler.sema.body.interp.*;
use compiler.sema.body.call.*;
use compiler.sema.body.program.*;

use compiler.sema.template.*;
use compiler.sema.instance.*;

use compiler.sema.methods.*;

use compiler.sema.prims.*;

use compiler.sema.decl.type.*;
use compiler.sema.mono.clone.*;

// ============================================================================
// BodyPass Struct Definition
// ============================================================================

pub struct BodyPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_fn_return_type: *Type,
	pub loop_depth: usz,
	pub errors: List<str>,
	// Type being implemented, so `Self` resolves inside an `impl` body.
	pub current_self_type: *Type,
	// true when SymbolTable is preloaded from outside (multiple modules)
	pub has_symtab: bool,
	pub when_depth: usz = 0,
	pub checked_fns: List<*AstNode> = List(),
	pub is_stmt_level: bool = false,
	pub defer_depth: usz = 0,
	// Declaration pass whose type resolver and instance tables this pass reuses,
	// so checking a body never builds a second DeclPass (see `resolve_type`).
	// Held by value: `has_decl` says whether it was populated.
	pub decl: DeclPass = DeclPass(),
	pub has_decl: bool = false,
	// Set while inferring arrow-function return types: the current attempt called
	// a function whose return type is not known yet, so the attempt is rolled
	// back and retried after that function is resolved.
	pub infer_blocked: bool = false,
	// True for the duration of that inference pass, so a call to an unresolved
	// arrow function blocks the attempt instead of checking the callee eagerly.
	pub inferring: bool = false,
	// Function/method instance whose body is being checked (or lowered). Its
	// bodies are the template's shared AST, so every per-instance decision
	// (types, bound methods, replacements) goes into `InstanceRecord.ann`
	// instead of onto the shared nodes. Null for ordinary declarations.
	pub current_rec: *InstanceRecord = null,
	// While checking an instance body, the decl pass's type-parameter env is
	// *replaced* by the instance's own (names->concrete types) so nested
	// instance checks cannot shadow an outer type parameter of the same name.
	pub env_saved_names: List<str> = List(),
	pub env_saved_types: List<*Type> = List(),
	pub has_env_saved: bool = false
}

impl BodyPass {

	pub fn new(): Self {
		var arena = Arena();
		var decl_p = DeclPass();
		val none_ty = decl_p.symtab.prims_of().t_none();
		return Self(decl_p.symtab, arena, none_ty, 0, List<str>(), null, false);
	}

	pub fn new(symtab: SymbolTable): Self {
		var arena = Arena();
		val none_ty = symtab.prims_of().t_none();
		return Self(symtab, arena, none_ty, 0, List<str>(), null, true);
	}

	// Standard construction: reuse the declaration pass of the same compilation
	// for type resolution and generic instantiation.
	pub fn new(symtab: SymbolTable, decl: DeclPass): Self {
		var arena = Arena();
		val none_ty = symtab.prims_of().t_none();
		var bp = Self(symtab, arena, none_ty, 0, List<str>(), null, true);
		bp.decl = decl;
		bp.has_decl = true;
		bp.symtab.prims = decl.symtab.prims_of();
		return bp;
	}

	// Short readable name of a type, for diagnostics.
	pub fn type_display(val self, ty: *Type): str {
		if (ty == null) return "null";
		if (ty.kind == DataType.STRUCT) return ty.as_struct().c_name;
		if (ty.kind == DataType.POINTER) return "*${self.type_display(ty.as_pointer().pointee)}";
		if (ty.kind == DataType.ARRAY) return "[${self.type_display(ty.as_array().elem)}]";
		if (ty.is_enum()) return ty.as_enum().c_name;
		return primitive_type_name(ty);
	}

	// A default argument or field initializer is spliced into a call site as a
	// fresh tree, so each site can carry its own annotations. There is one clone
	// implementation for the whole sema: the declaration pass substitution clone
	// with an empty substitution. Template bodies are never reachable from here
	// (a default value always belongs to the declaration being checked).
	pub fn copy_expr(var self, node: *AstNode): *AstNode => self.decl.clone_expr(node, null);

	// ============================================================================
	// Shorthands
	// ============================================================================

	// Primitive result types: the canonical instance from the symbol table, so
	// two `str` annotations are the same pointer.
	pub fn prims(val self): *PrimTypes => self.symtab.prims_of();

	// Reports `msg` at `node` unless `cond` holds.
	pub fn ensure(var self, cond: bool, node: *AstNode, msg: str) {
		if (!cond) self.report_error(node, msg);
	}

	pub fn enter_module(var self, module: str): str {
		val prev = self.symtab.current_module;
		if (module.len > 0) self.symtab.set_current_module(module);
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.symtab.set_current_module(prev);
	}

	// Evaluates an expression with statement-level context (allowing statement-only constructs like jump Elvis)
	pub fn check_expr_stmt(var self, expr: *AstNode): *Type {
		val prev = self.is_stmt_level;
		self.is_stmt_level = true;
		val ty = self.check_expr(expr);
		self.is_stmt_level = prev;
		return ty;
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		// Prefix the module name (if any) so we know which module an error is in for multi-module builds
		val loc = if (node != null) "Line ${node.line}, Column ${node.col}: ${msg}"
		else msg;

		if (self.symtab.current_module.len > 0) {
			self.errors += "${self.symtab.current_module}: ${loc}";
		} else self.errors += loc;
	}

	pub fn resolve_type(var self, node: *AstNode): *Type {
		if (self.has_decl) {
			// Reuse the declaration pass: same symbol table, arena and instance
			// tables, so an instantiation made while checking a body stays
			// coherent with the ones made while collecting declarations. The
			// table is threaded through by value, so hand the current one over
			// and take back whatever the resolver added.
			self.decl.symtab = self.symtab;
			self.decl.current_module = self.symtab.current_module;
			self.decl.current_self_type = self.current_self_type;
			self.decl.errors = self.errors;
			val ty = self.decl.resolve_ast_type(node);
			self.symtab = self.decl.symtab;
			self.errors = self.decl.errors;
			return ty;
		}

		// Standalone use (tests): resolve through a throwaway pass.
		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val ty = decl_p.resolve_ast_type(node);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return ty;
	}

	// Finds a method template for a receiver whose type the body pass knows, so
	// two structs can declare generic methods with the same name.
	pub fn find_method_template_for(var self, name: str, self_type: str): *GenTemplate {
		if (self.has_decl) return self.decl.find_method_template(name, self_type);

		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val tmpl = decl_p.find_method_template(name, self_type);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return tmpl;
	}

	// Instantiates a generic method with the receiver type in scope, reusing the
	// declaration pass so its instance tables stay coherent with this pass.
	pub fn instantiate_method(var self, tmpl: *GenTemplate, arg_asts: List<*AstNode>, obj_ty: *Type): str {
		if (self.has_decl) {
			self.decl.symtab = self.symtab;
			self.decl.current_module = self.symtab.current_module;
			self.decl.current_self_type = obj_ty;
			self.decl.errors = self.errors;
			val cname = self.decl.instantiate_fn(tmpl, arg_asts);
			self.symtab = self.decl.symtab;
			self.errors = self.decl.errors;
			return cname;
		}

		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, obj_ty
		);
		val cname = decl_p.instantiate_fn(tmpl, arg_asts);
		self.arena = decl_p.arena;
		self.symtab = decl_p.symtab;
		self.errors = decl_p.errors;
		return cname;
	}

	// ============================================================================
	// Top-level Expression Dispatcher
	// ============================================================================

	pub fn check_expr(var self, node: *AstNode): *Type {
		if (node == null) return self.prims().t_none();
		if (node is GroupExpr as g) return self.check_expr(g.expr);

		if (
			node.kind != NodeKind.EXPR_BINARY &&
			node.kind != NodeKind.EXPR_ASSIGN
		) self.is_stmt_level = false;

		val ty = self.check_expr_node(node);
		self.annotate_type(node, ty);
		return ty;
	}

	// Records the resolved type on the expression. Every lowering keeps the
	// value's type, so annotating after the check describes the node codegen
	// will actually see. One channel: the compiler's `*Type` (codegen maps it to
	// C, later sema passes read struct fields and sizes from it). Inside an
	// instance the node is shared with other instances, so the annotation goes
	// into the instance's side table instead.
	fn annotate_type(var self, node: *AstNode, ty: *Type) {
		if (node == null || ty == null) return;
		if (self.current_rec != null) {
			self.ann_entry(node).ty = ty;
			return;
		}
		node.type_ptr = ty as *u8;
	}

	// --- instance annotation plumbing ---------------------------------------
	// The checker writes these decisions per instance; materialization copies
	// them onto the instance's own tree (see mono.template / mono.clone).

	pub fn set_resolved(var self, node: *AstNode, r: *AstNode) {
		if (self.current_rec != null) self.ann_entry(node).resolved = r;
		else node.resolved_node = r;
	}

	pub fn set_method(var self, node: *AstNode, mi: *MethodInfo) {
		if (self.current_rec != null) self.ann_entry(node).method = mi as *u8;
		else node.resolved_method = mi as *u8;
	}

	pub fn set_ann_ty(var self, node: *AstNode, ty: *Type) {
		if (self.current_rec == null) return;
		self.ann_entry(node).ty = ty;
	}

	pub fn set_ann_var_ty(var self, node: *AstNode, ty: *Type) {
		if (self.current_rec == null) return;
		self.ann_entry(node).var_ty = ty;
	}

	pub fn set_ann_obj(var self, node: *AstNode, obj: *AstNode) {
		if (self.current_rec == null) return;
		self.ann_entry(node).obj_replace = obj;
	}

	pub fn set_ann_init_override(var self, node: *AstNode, r: *AstNode) {
		if (self.current_rec == null) return;
		self.ann_entry(node).init_override = r;
	}

	// Renames an identifier to the symbol's mangled C name. When the node belongs
	// to a template body shared by every instance, the name is recorded in the
	// instance's side table instead; materialization applies it to the instance's
	// own copy (see `mono.clone.clone_expr`). This keeps the template AST intact,
	// so two instances can never observe each other's rename.
	pub fn set_ident_name(var self, node: *AstNode, name: str) {
		if (self.current_rec != null) {
			val e = self.ann_entry(node);
			e.ident_name = name;
			e.has_ident_name = true;
			return;
		}
		val id = node.as_identifier_expr() as &IdentifierExpr;
		id.name = name;
	}

	pub fn ann_entry(var self, node: *AstNode): *AnnEntry {
		val rec = self.current_rec;
		val ex = rec.find_ann(node);
		if (ex != null) return ex;
		val e = self.arena.alloc_val<AnnEntry>(AnnEntry(node));
		rec.ann_map.put(node as usz, e);
		return e;
	}

	// Binds the current instance's type parameters for `resolve_type` (the decl
	// pass's resolver). Always paired with `pop_instance_env`.
	pub fn push_instance_env(var self, rec: *InstanceRecord) {
		if (!self.has_decl) return;
		self.env_saved_names = self.decl.subst_names;
		self.env_saved_types = self.decl.subst_types;
		self.has_env_saved = true;
		self.decl.subst_names = rec.template.param_names();
		self.decl.subst_types = rec.args;
	}

	pub fn pop_instance_env(var self) {
		if (!self.has_decl) return;
		if (!self.has_env_saved) return;
		self.decl.subst_names = self.env_saved_names;
		self.decl.subst_types = self.env_saved_types;
		self.has_env_saved = false;
	}

	// Marks `rec` as the instance whose body is being checked: its type arguments
	// replace the declaration pass's env and per-node decisions go to its side
	// table. Returns the previously active record for `pop_instance`. A null
	// record is a no-op, so ordinary declarations can call this unconditionally.
	pub fn push_instance(var self, rec: *InstanceRecord): *InstanceRecord {
		val saved = self.current_rec;
		if (rec == null) return saved;
		self.current_rec = rec;
		self.push_instance_env(rec);
		return saved;
	}

	pub fn pop_instance(var self, saved: *InstanceRecord, rec: *InstanceRecord) {
		if (rec == null) return;
		self.pop_instance_env();
		self.current_rec = saved;
	}

	// Index of a type parameter name in the current instance's env (-1 when it
	// is not a type parameter).
	fn type_param_index(var self, name: str): i64 {
		if (!self.has_decl) return -1;
		for (i in 0..<self.decl.subst_names.len) {
			if (self.decl.subst_names[i] == name) return i as i64;
		}
		return -1;
	}

	fn type_c_size_num(var self, ty: *Type): usz {
		if (ty == null) return 8;
		return when (ty.kind) {
			DataType.NONE -> 0;
			DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
			DataType.I16, DataType.U16 -> 2;
			DataType.I32, DataType.U32, DataType.F32 -> 4;
			DataType.I64, DataType.U64, DataType.ISZ, DataType.USZ, DataType.F64, DataType.STR -> 8;
			DataType.POINTER -> 8;
			DataType.ARRAY -> ty.as_array().length * self.type_c_size_num(ty.as_array().elem);
			DataType.STRUCT -> ty.size;
			else -> 8;
		};
	}

	// C size (bytes) of a resolved type, as decimal literal text. Mirrors the
	// old clone-time `ast_type_size` fold so generated C stays identical (no
	// suffix: `c_format_int_literal` renders it exactly like the old literal).
	fn type_c_size_text(var self, ty: *Type): str {
		val n = self.type_c_size_num(ty);
		return "${n}";
	}

	// True for an arrow-bodied function (`fn f() => expr`) whose return type is
	// still unknown. A call to one of these during inference blocks the attempt.
	fn arrow_pending(val self, ast: *AstNode): bool {
		if (ast == null) return false;
		if (ast.kind != NodeKind.DECL_FN) return false;
		val f = ast.as_fn_decl();
		if (f.return_type != null) return false;
		if (f.body == null) return false;
		return f.body.kind == NodeKind.STMT_EXPR;
	}

	fn check_expr_node(var self, node: *AstNode): *Type => when (node.kind) {
		NodeKind.EXPR_LITERAL -> self.check_literal_expr(node);
		NodeKind.EXPR_IDENTIFIER -> self.check_ident_expr(node);
		NodeKind.EXPR_BINARY -> self.check_binary_expr(node);
		NodeKind.EXPR_UNARY -> self.check_unary_expr(node);
		NodeKind.EXPR_CALL -> self.check_call_expr(node);
		NodeKind.EXPR_MEMBER -> self.check_member_expr(node);
		NodeKind.EXPR_INDEX -> self.check_index_expr(node);
		NodeKind.EXPR_ASSIGN -> self.check_assign_expr(node);
		NodeKind.EXPR_UPDATE -> self.check_update_expr(node);
		NodeKind.EXPR_CAST -> self.check_cast_expr(node);
		NodeKind.EXPR_IF -> self.check_if_expr(node);
		NodeKind.EXPR_WHEN -> self.check_when_expr(node);
		NodeKind.EXPR_ARRAY_LITERAL -> self.check_array_literal_expr(node);
		NodeKind.EXPR_INTERP -> self.check_interp_expr(node);
		NodeKind.EXPR_IS -> self.check_is_expr(node);
		else -> self.prims().t_none();
	};

	// ============================================================================
	// Top-level Statement Dispatcher
	// ============================================================================

	pub fn check_statement(var self, node: *AstNode) {
		if (node == null) return;

		if (node is ExprStmt as es) {
			self.check_expr_stmt(es.expr);
			return;
		}
		if (node is DeferStmt as ds) {
			if (self.defer_depth > 0UZ)
				self.report_error(node, "Nested defer statement is not allowed inside defer");
			self.defer_depth++;
			self.check_statement(ds.body);
			self.defer_depth--;
			return;
		}
		if (node is YieldStmt as ys) {
			if (self.defer_depth > 0UZ)
				self.report_error(node, "Yield statement is not allowed inside defer");
			if (self.when_depth == 0)
				self.report_error(node, "Yield statement outside of when expression");

			if (ys.value != null) self.check_expr(ys.value);
			return;
		}

		when (node.kind) {
			NodeKind.STMT_BLOCK -> self.check_block_stmt(node);
			NodeKind.STMT_VAR_DECL -> self.check_var_decl_stmt(node);
			NodeKind.STMT_IF -> self.check_if_stmt(node);
			NodeKind.STMT_WHILE -> self.check_while_stmt(node);
			NodeKind.STMT_FOR -> self.check_for_stmt(node);
			NodeKind.STMT_RETURN -> self.check_return_stmt(node);
			NodeKind.STMT_BREAK, NodeKind.STMT_CONTINUE -> {
				if (self.defer_depth > 0UZ)
					self.report_error(node, "Break or continue statement is not allowed inside defer");
				if (self.loop_depth == 0)
					self.report_error(node, "Break or continue statement outside of loop");
			}
			NodeKind.STMT_WHEN -> self.check_when_stmt(node);
			else -> {}
		}
	}

}
