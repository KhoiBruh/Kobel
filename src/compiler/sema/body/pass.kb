mod compiler.sema.body;

/*
 * ============================================================================
 * BodyPass - Type Checker & Body Analyzer Core Dispatcher (Compatibility Bridge)
 * Delegates all body checking to compiler.semantic.checker.BodyChecker.
 * ============================================================================
 */

use std.string.*;
use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.lexer.*;
use compiler.sema.*;
use compiler.semantic.types.*;
use compiler.semantic.symbols.*;
use compiler.semantic.resolution.*;
use compiler.semantic.declaration.*;
use compiler.semantic.checker.*;
use compiler.sema.decl.*;
use compiler.sema.desugar.*;

pub struct BodyPass {
	pub symtab: SymbolTable = SymbolTable(),
	pub arena: Arena = Arena(),
	pub current_fn_return_type: *Type? = null,
	pub loop_depth: usz = 0,
	pub errors: List<str> = List(),
	pub current_self_type: *Type? = null,
	pub has_symtab: bool = false,
	pub when_depth: usz = 0,
	pub checked_fns: List<*AstNode> = List(),
	pub is_stmt_level: bool = false,
	pub in_safe_nav_context: bool = false,
	pub defer_depth: usz = 0,
	pub decl: DeclPass = DeclPass(),
	pub has_decl: bool = false,
	pub infer_blocked: bool = false,
	pub inferring: bool = false,
	pub inferring_fn_return: bool = false,
	pub current_rec: *InstanceRecord? = null,
	pub env_saved_names: List<str> = List(),
	pub env_saved_types: List<*Type> = List(),
	pub has_env_saved: bool = false,
	pub warnings: List<str> = List(),
	pub current_trait_name: str = ""
}

impl BodyPass {

	pub init() {
		var arena = Arena();
		var decl_p = DeclPass();
		val none_ty = decl_p.symtab.prims.t_none();
		return Self(decl_p.symtab, arena, none_ty, 0, List<str>(), null, false);
	}

	pub init(symtab: SymbolTable) {
		var arena = Arena();
		val none_ty = symtab.prims.t_none();
		return Self(symtab, arena, none_ty, 0, List<str>(), null, true);
	}

	pub init(symtab: SymbolTable, decl: DeclPass) {
		var arena = Arena();
		val none_ty = symtab.prims.t_none();
		var bp = Self(symtab, arena, none_ty, 0, List<str>(), null, true);
		bp.decl = decl;
		bp.has_decl = true;
		bp.symtab.prims = decl.symtab.prims;
		bp.symtab.sem = decl.symtab.sem;
		return bp;
	}

	pub fn to_checker(val self): BodyChecker {
		var c = BodyChecker(self.symtab, self.decl);
		c.arena = self.arena;
		c.current_fn_return_type = self.current_fn_return_type;
		c.loop_depth = self.loop_depth;
		c.errors = self.errors;
		c.current_self_type = self.current_self_type;
		c.has_symtab = self.has_symtab;
		c.when_depth = self.when_depth;
		c.checked_fns = self.checked_fns;
		c.is_stmt_level = self.is_stmt_level;
		c.in_safe_nav_context = self.in_safe_nav_context;
		c.defer_depth = self.defer_depth;
		c.has_decl = self.has_decl;
		c.infer_blocked = self.infer_blocked;
		c.inferring = self.inferring;
		c.inferring_fn_return = self.inferring_fn_return;
		c.current_rec = self.current_rec;
		c.env_saved_names = self.env_saved_names;
		c.env_saved_types = self.env_saved_types;
		c.has_env_saved = self.has_env_saved;
		c.warnings = self.warnings;
		c.current_trait_name = self.current_trait_name;
		return c;
	}

	pub fn apply_checker(var self, val c: BodyChecker) {
		self.symtab = c.symtab;
		self.arena = c.arena;
		self.current_fn_return_type = c.current_fn_return_type;
		self.loop_depth = c.loop_depth;
		self.errors = c.errors;
		self.current_self_type = c.current_self_type;
		self.has_symtab = c.has_symtab;
		self.when_depth = c.when_depth;
		self.checked_fns = c.checked_fns;
		self.is_stmt_level = c.is_stmt_level;
		self.in_safe_nav_context = c.in_safe_nav_context;
		self.defer_depth = c.defer_depth;
		self.decl = c.decl;
		self.has_decl = c.has_decl;
		self.infer_blocked = c.infer_blocked;
		self.inferring = c.inferring;
		self.inferring_fn_return = c.inferring_fn_return;
		self.current_rec = c.current_rec;
		self.env_saved_names = c.env_saved_names;
		self.env_saved_types = c.env_saved_types;
		self.has_env_saved = c.has_env_saved;
		self.warnings = c.warnings;
		self.current_trait_name = c.current_trait_name;
	}

	pub fn check_program(var self, program_node: *AstNode) {
		var c = self.to_checker();
		c.check_program(program_node);
		self.apply_checker(c);
	}

	pub fn set_resolved(val self, node: *AstNode, r: *AstNode) {
		self.symtab.set_resolved_node(node, r);
	}

}
