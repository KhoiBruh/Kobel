mod compiler.sema.body;

// ============================================================================
// BodyPass - String Interpolation Checking
//
// String interpolation: checking the holes and their Stringer contract.
// The concat chain itself is built by the `lower` pass.
// ============================================================================

use std.memory.*;
use std.collections.*;



use compiler.ast.*;

use compiler.lexer.*;

use compiler.sema.*;
use compiler.sema.decl.*;
use compiler.sema.desugar.*;

impl BodyPass {

	// The `kobel_concat` chain is built by the `lower` pass; checking a hole means
	// checking its expression and requiring a `Stringer` conversion.
	pub fn check_interp_expr(var self, node: *AstNode): *Type {
		if (node is InterpExpr as ie) {
			for (part in ie.parts) {
				when (part) {
					is InterpPart.Literal -> continue;
					is InterpPart.Hole as hole -> {
						val pty = self.check_expr(hole.node);
						self.ensure_to_str(hole.node, pty);
					}
				}
			}
		}
		return self.prims().t_str();
	}

	// A hole is fine when it is `str` or implements the `Stringer` trait;
	// `lower` picks that implementation while rewriting.
	fn ensure_to_str(var self, node: *AstNode, ty: *Type) {
		if (ty == null || ty.kind == DataType.STR) return;

		val trait_to_str = self.symtab.find_trait("Stringer");
		if (trait_to_str != null) {
			var cur_ty = ty;
			if (cur_ty.kind == DataType.POINTER) cur_ty = cur_ty.as_pointer().pointee;

			var tname = "";
			if (cur_ty.kind == DataType.STRUCT) {
				tname = cur_ty.as_struct().name;
			} else {
				val prim = primitive_type_name(cur_ty);
				if (prim != "none") tname = prim;
				else tname = cur_ty.to_str();
			}

			if (trait_to_str.has_impl(tname)) return;
		}

		self.report_error(node, "Interpolated value must implement Stringer");
	}

}
