mod compiler.sema;

/*
 * ============================================================================
 * Backward Compatibility Bridge: BodyPass Lowering
 *
 * Delegates lowering to `compiler.semantic.lowering.LoweringPass`.
 * ============================================================================
 */

use std.memory.*;
use std.collections.*;

use compiler.ast.*;
use compiler.sema.body.*;
use compiler.semantic.lowering.*;

impl BodyPass {

	pub fn lower_program(var self, program_node: *AstNode) {
		var lp = LoweringPass(self.symtab, self.arena, self.decl);
		lp.lower_program(program_node);
		self.symtab = lp.symtab;
		self.arena = lp.arena;
		self.decl = lp.decl;
	}

	pub fn lower_stmt(var self, node: *AstNode): *AstNode {
		var lp = LoweringPass(self.symtab, self.arena, self.decl);
		val res = lp.lower_stmt(node);
		self.symtab = lp.symtab;
		self.arena = lp.arena;
		return res;
	}

	pub fn lower_expr(var self, node: *AstNode): *AstNode {
		var lp = LoweringPass(self.symtab, self.arena, self.decl);
		val res = lp.lower_expr(node);
		self.symtab = lp.symtab;
		self.arena = lp.arena;
		return res;
	}

}
