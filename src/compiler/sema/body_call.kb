mod compiler.sema.body_call;

// ============================================================================
// BodyPass - Call Expression & Constructor Resolution
//
// Resolves function calls, instance and primitive methods, type size queries,
// string slicing, and struct construction (both `new` constructors and field lists).
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;
use compiler.sema.body_pass.*;
use compiler.sema.body_expr.*;

impl BodyPass {

	pub fn check_call_expr(var self, node: *AstNode): *Type {
		val call = node.to<CallExpr>() as &CallExpr;

		// Check member call queries: T.size(), s.slice(...) or instance/primitive methods
		val callee = call.callee;
		if (callee is MemberExpr as mem) {
			if (mem.member == "size") return self.lower_size_query(node, mem);
			if (mem.member == "slice") return self.lower_slice_call(node, mem, call);

			// Instance method call or primitive method call
			val m_ty = self.check_method_call(node, mem, call);
			if (m_ty != null) return m_ty;
		}

		// `Self(...)` builds the value directly, so it never consults a
		// `new` factory (that is what keeps `fn new() => Self(...)` from
		// calling itself again).
		var callee_is_self = false;
		if (callee is IdentifierExpr as id) {
			callee_is_self = (id.name == "Self");
		}

		val callee_ty = self.check_expr(call.callee);

		// 1. Function call
		if (callee_ty.kind == DataType.FN) return self.check_fn_call(node, callee_ty, call);

		// 2. Struct construction: Point(1, 2)
		if (callee_ty.kind == DataType.STRUCT) return self.check_struct_ctor(node, callee_ty, call, callee_is_self);

		self.report_error(node, "Callee is not a function or struct");
		return self.t_none();
	}

	// `T.size()`. A primitive type name has no C type of its own (`str`, `bool`,
	// ...), so fold it to its C size literal; otherwise mangle the name so the
	// backend emits `sizeof(<c_name>)`.
	fn lower_size_query(var self, node: *AstNode, mem: *MemberExpr): *Type {
		val obj = mem.object;
		if (obj is IdentifierExpr as var id) {
			val csize = prim_c_size(id.name);
			if (csize > 0) {
				val lit = self.literal(LiteralKind.INT, "${csize}UZ", node.line, node.col);
				self.replace_node(node, lit);
				return self.t_usz();
			}

			val tsym = self.symtab.lookup(id.name);
			if (tsym != null && tsym.c_name != id.name) {
				id.name = tsym.c_name;
			}
		}
		return self.t_usz();
	}

	// `s.slice(a, b)` lowers to `kobel_slice(s, a, b)`. Both bounds are optional:
	// `a` defaults to 0 and `b` to `kobel_slen(s)`.
	fn lower_slice_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr): *Type {
		val slice_recv = self.check_expr(mem.object);
		self.ensure(slice_recv.kind == DataType.STR, node, "slice() requires a str receiver");
		for (arg in call.args) {
			val at = self.check_expr(arg);
			self.ensure(at.is_integer(), node, "slice() bounds must be integers");
		}

		var sargs = List<*AstNode>();
		sargs += mem.object;
		if (!call.args.empty()) sargs += call.args.first();
		else sargs += self.literal(LiteralKind.INT, "0", node.line, node.col);
		if (call.args.len >= 2) {
			sargs += call.args[1];
		} else {
			var largs = List<*AstNode>();
			largs += mem.object;
			sargs += self.call(self.identifier("kobel_slen", node.line, node.col), largs, List<*AstNode>(), node.line, node.col);
		}
		val sl_call = self.call(self.identifier("kobel_slice", node.line, node.col), sargs, List<*AstNode>(), node.line, node.col);
		self.replace_node(node, sl_call);
		return self.t_str();
	}

	// A method may be called with fewer arguments than it declares when the
	// missing tail all has defaults; clone those defaults into the call so the
	// arity check and the backend see the complete argument list.
	fn append_defaults(var self, node: *AstNode, argc: usz, call: &CallExpr): bool {
		if (node is FnDecl as f && argc < f.params.len) {
			for (i in argc..<f.params.len) {
				if (f.params[i].default_val == null) return false;
			}
			for (i in argc..<f.params.len) {
				call.args += self.clone_expr(f.params[i].default_val);
			}
			return true;
		}
		return false;
	}

	// Overload resolution is by arity, so an exact match wins; otherwise the
	// first candidate whose missing tail is all-default does. `found` is the
	// exact-arity result, already resolved by the caller.
	fn method_with_defaults(var self, name: str, argc: usz, cands: List<*MethodInfo>, call: &CallExpr, found: *MethodInfo): *MethodInfo {
		if (found != null) return found;
		for (m in cands) {
			if (m.name != name || m.ast_node == null) continue;
			val ast_n = (m.ast_node as *AstNode) ?: continue;
			if (!self.append_defaults(ast_n, argc, call)) continue;
			return m;
		}
		return null;
	}

	// An arrow-bodied method (`fn f() => expr`) has no body checked by the
	// declaration pass, so check it here, with `self` bound to the receiver
	// type and the module switched to the one declaring the method.
	fn check_arrow_method_body(var self, mi: *MethodInfo, obj_ty: *Type) {
		val ast_n = (mi.ast_node as *AstNode) ?: return;
		if (ast_n is FnDecl as f && f.body is ExprStmt && f.return_type == null) {
			val prev_self = self.current_self_type;
			val prev_ret = self.current_fn_return_type;
			val prev_mod = self.enter_module(mi.module);
			self.current_self_type = obj_ty;
			self.check_fn_body(ast_n, mi.fn_type);
			self.current_self_type = prev_self;
			self.current_fn_return_type = prev_ret;
			self.leave_module(prev_mod);
		}
	}

	// Check the arguments, then rewrite `recv.m(args)` into `c_name(recv, args)`.
	// `by_ref` says how a non-pointer receiver is passed: `&recv` for a struct
	// method, `recv` itself (deref when the receiver is a pointer) for a
	// primitive method.
	fn lower_method_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr, mi: *MethodInfo, obj_ty: *Type, obj_is_ptr: bool, by_ref: bool): *Type {
		val fn_info = mi.fn_type.as_fn();
		self.check_arrow_method_body(mi, obj_ty);

		if (call.args.len + 1 != fn_info.param_types.len) {
			self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
		} else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i + 1];
				val arg_n = call.args[i];
				if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
				val arg_ty = self.check_expr(arg_n);
				self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in method call '${mem.member}'");
			}
		}

		var new_args = List<*AstNode>();
		if (by_ref == obj_is_ptr) {
			new_args += mem.object;
		} else {
			var op = TokenType.STAR;
			if (by_ref) op = TokenType.AMPERSAND;
			new_args += self.unary(op, mem.object, node.line, node.col);
		}
		for (arg in call.args) new_args += arg;

		var ret_ty = fn_info.return_type;
		if (mem.is_safe) {
			self.ensure(ret_ty.kind == DataType.POINTER || ret_ty.kind == DataType.STR, node, "Safe method call '?.' requires return type to be a pointer or string");

			val call_node = self.call(self.identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
			val cond = self.binary(TokenType.BANG_EQUAL, mem.object, self.literal(LiteralKind.NULL_VAL, "null", node.line, node.col), node.line, node.col);
			val if_node = self.if_expr(cond, call_node, self.literal(LiteralKind.NULL_VAL, "null", node.line, node.col), node.line, node.col);
			self.replace_node(node, if_node);

			if (ret_ty.kind == DataType.POINTER) {
				val pt = ret_ty.as_pointer();
				ret_ty = self.arena.nullable_pointer_type(pt.pointee, pt.is_mut);
			}
			return ret_ty;
		}

		call.args = new_args;
		call.callee = self.identifier(mi.c_name, node.line, node.col);
		return ret_ty;
	}

	pub fn check_method_call(var self, node: *AstNode, mem: *MemberExpr, call: &CallExpr): *Type {
		// Instance method call: obj.m(args) -> Struct_m(self, args)
		val obj_raw_ty = self.check_expr(mem.object);
		var obj_ty = obj_raw_ty;
		var obj_is_ptr = false;
		if (obj_ty.kind == DataType.POINTER) {
			obj_is_ptr = true;
			obj_ty = obj_ty.as_pointer().pointee;
		}
		if (mem.is_safe && !obj_is_ptr) {
			self.report_error(node, "Safe call operator '?.' requires a pointer receiver");
			return self.t_none();
		}
		val argc = call.args.len + 1;

		if (obj_ty.kind == DataType.STRUCT) {
			val s_info = obj_ty.as_struct();
			// Pick the overload whose arity matches; fall back to a name
			// lookup so an arity error still reads as before.
			if (s_info.count_method_arity(mem.member, argc) > 1) {
				self.report_error(
					node,
					"Ambiguous call to '${mem.member}': "
					"overloading by parameter type is not supported"
				);
			}
			val mi = self.method_with_defaults(
				mem.member, argc, s_info.methods, call, s_info.find_method_arity(mem.member, argc)
			) ?: s_info.find_method(mem.member);
			// Struct methods take the receiver by reference.
			if (mi != null) return self.lower_method_call(node, mem, call, mi, obj_ty, obj_is_ptr, true);
		}

		// Primitive method: x.m(args) -> <prim>_m(x, args), receiver by value.
		val pmi = self.method_with_defaults(
			mem.member, argc, self.symtab.prim_methods_of(obj_ty.kind), call,
			self.symtab.find_prim_method_arity(obj_ty.kind, mem.member, argc)
		) ?: self.symtab.find_prim_method(obj_ty.kind, mem.member);
		// Primitive methods take the receiver by value.
		if (pmi != null) return self.lower_method_call(node, mem, call, pmi, obj_ty, obj_is_ptr, false);

		if (obj_ty.kind == DataType.STRUCT) {
			self.report_error(node, "Method '${mem.member}' not found on type '${obj_ty.as_struct().name}'");
			return self.t_none();
		}

		return null;
	}

	pub fn check_fn_call(var self, node: *AstNode, callee_ty: *Type, call: &CallExpr): *Type {
		val fn_info = callee_ty.as_fn();
		val callee = call.callee;
		if (callee is IdentifierExpr as id) {
			val sym = self.symtab.lookup(id.name);
			if (sym != null) { self.append_defaults(sym.ast_node as *AstNode, call.args.len, call); }
		}
		if (call.args.len != fn_info.param_types.len) self.report_error(node, "Argument count mismatch in function call");
		else {
			for (i in 0..<call.args.len) {
				val param_ty = fn_info.param_types[i];
				val arg_n = call.args[i];
				if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
				val arg_ty = self.check_expr(arg_n);
				if (!param_ty.can_assign(arg_ty)) {
					if (param_ty.kind == DataType.POINTER && arg_ty.kind == DataType.STRUCT) {
						val p_pointee = param_ty.as_pointer().pointee;
						if (p_pointee.equals(arg_ty)) {
							call.args[i] = self.unary(TokenType.AMPERSAND, arg_n, arg_n.line, arg_n.col);
							continue;
						}
					}
					self.report_error(node, "Argument type mismatch in function call");
				}
			}
		}
		return fn_info.return_type;
	}

	pub fn check_struct_ctor(var self, node: *AstNode, callee_ty: *Type, call: &CallExpr, callee_is_self: bool): *Type {
		val s_info = callee_ty.as_struct();

		// Kotlin-style construction: `Type(args)` calls the `new`
		// overload of matching arity when one exists; building from
		// fields is only the fallback.
		if (!callee_is_self) {
			if (s_info.count_method_arity("new", call.args.len) > 1) self.report_error(
				node,
				"Ambiguous call to 'new': "
				"overloading by parameter type is not supported"
			);
			val nm = self.method_with_defaults(
				"new", call.args.len, s_info.methods, call, s_info.find_method_arity("new", call.args.len)
			);
			if (nm != null) {
				val n_info = nm.fn_type.as_fn();
				for (i in 0..<call.args.len) {
					val param_ty = n_info.param_types[i];
					val arg_n = call.args[i];
					if (param_ty != null && param_ty.is_list()) self.coerce_to_list(arg_n, param_ty);
					val arg_ty = self.check_expr(arg_n);
					self.ensure(param_ty.can_assign(arg_ty), node, "Argument type mismatch in call to 'new'");
				}
				call.callee = self.identifier(nm.c_name, node.line, node.col);
				return n_info.return_type;
			}
		}

		// Field construction is only allowed where the type is declared
		// unless every field is `pub`; otherwise the type must expose a
		// `new` constructor (handled above).
		if (
			s_info.has_private &&
			s_info.module != self.symtab.current_module
		) self.report_error(
			node,
			"Cannot construct '${s_info.name}' from its fields: "
			"they are private to module '${s_info.module}'; "
			"add a 'new' constructor"
		);

		if (call.args.len < s_info.fields.len) {
			var all_default = true;
			for (i in call.args.len..<s_info.fields.len) {
				if (s_info.fields[i].default_val == null) {
					all_default = false;
					break;
				}
			}
			if (all_default) {
				for (i in call.args.len..<s_info.fields.len) {
					call.args += self.clone_expr(s_info.fields[i].default_val as *AstNode);
				}
			}
		}

		if (call.args.len != s_info.fields.len) self.report_error(node, "Argument count mismatch in struct constructor");
		else {
			for (i in 0..<call.args.len) {
				val f_ty = s_info.fields[i].type_ptr;
				val arg_n = call.args[i];
				if (f_ty != null && f_ty.is_list()) self.coerce_to_list(arg_n, f_ty);
				val arg_ty = self.check_expr(arg_n);
				self.ensure(f_ty.can_assign(arg_ty), node, "Field type mismatch in struct constructor");
			}
		}
		return callee_ty;
	}

}
