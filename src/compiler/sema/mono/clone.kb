mod compiler.sema.mono;

// ============================================================================
// AST cloning - the two remaining roles
//
// 1. `materialize_body`: the "emission copy" of a function/method instance. The
//    checker ran on the template's shared AST and recorded its decisions in
//    `InstanceRecord.ann`; before lowering/emitting, this clones the template
//    body and stamps the per-node annotations onto the copy instead of editing
//    the shared AST.
// 2. `clone_fn` (and the clone_type/clone_expr/clone_stmt family below): still
//    used by `apply_trait` to copy a trait's default method - independent of
//    monomorphization.
//
// No cloning happens at *instantiate* time: instantiate_fn/instantiate_struct
// only build a view + side table (see mono/instantiate.kb).
// ============================================================================

use std.memory.*;
use std.collections.*;

use util.*;

use compiler.lexer.TokenType;

use compiler.ast.*;

use compiler.sema.*;
use compiler.sema.decl.*;

use compiler.ast.StructField as AstStructField;
use compiler.ast.PointerType;
use compiler.ast.ArrayType;
use compiler.sema.StructField;

impl DeclPass {

	// ----------------------------------------------------------------------------
	// AST cloning with type-parameter substitution
	// ----------------------------------------------------------------------------

	// The annotation side-table entry for a node while materializing a function
	// instance (null when not materializing or when the node has no entry).
	fn mat_ann(val self, node: *AstNode?): *AnnEntry? {
		if (node == null || self.mat_rec == null) return null;
		return self.mat_rec.find_ann(node!);
	}

	pub fn clone_type(var self, node: *AstNode?, subst: *GenSubst? = null): *AstNode {
		if (node == null) return null as *AstNode;
		// Inside an instance the checker resolved this type node to a concrete
		// type; materialize that instead of replaying the substitution.
		val e = self.mat_ann(node);
		if (e?.ty != null) return self.arena.ast_type_from_type(e.ty!);
		val target = node;
		return when (target) {
			is NamedType as nt -> {
				val sa = subst?.lookup(nt.name);
				if (sa != null) yield self.clone_type(sa as *AstNode, null);

				if (nt.type_args.len > 0) {
					val tmpl = self.find_struct_template(nt.name);
					if (tmpl != null) {
						var args = List<*AstNode>();
						for (ta in nt.type_args) args += self.clone_type(ta, subst);
						val cty = self.instantiate_struct(tmpl, args);
						yield self.arena.node(NodeData.NamedType(cty.as_struct().name, List<*AstNode>()), node.line, node.col);
					}
				}

				var targs = List<*AstNode>();
				for (ta in nt.type_args) targs += self.clone_type(ta, subst);
				yield self.arena.node(NodeData.NamedType(nt.name, targs), node.line, node.col);
			}

			is PointerType as pt -> self.arena.node(
				NodeData.PointerType(pt.mutable, self.clone_type(pt.pointee, subst)),
				node.line, node.col
			);

			is ArrayType as at -> self.arena.node(
				NodeData.ArrayType(self.clone_type(at.element_type, subst), at.size),
				node.line, node.col
			);

			is NullableType as nt -> self.arena.node(
				NodeData.NullableType(self.clone_type(nt.inner_type, subst)),
				node.line, node.col
			);

			else -> self.arena.node(NodeData.NamedType("none", List<*AstNode>()), node.line, node.col);
		};
	}

	pub fn clone_expr(var self, node: *AstNode?, subst: *GenSubst? = null): *AstNode {
		if (node == null) return null as *AstNode;
		val raw_node = node;
		if (
			raw_node is ReturnStmt ||
			raw_node is BreakStmt ||
			raw_node is ContinueStmt ||
			raw_node is YieldStmt ||
			raw_node is BlockStmt
		) return self.clone_stmt(node, subst);

		val e = self.mat_ann(node);
		// A node the checker already replaced for this instance (an enum member,
		// a bound call, a desugared `for`, `T.size()`, ...): materialize the
		// replacement subtree instead of the shared node itself.
		if (e?.resolved != null) return self.clone_expr(e.resolved!, subst);

		val target = node;
		var out = when (target) {
			is LiteralExpr as l -> self.arena.literal(
				l.literal_kind, l.raw_text,
				node.line, node.col
			);

			is IdentifierExpr as id -> self.arena.identifier(
				// An identifier the checker resolved to a mangled C name (imports,
				// symbols from another module) carries that name in the instance's
				// side table; the shared template node keeps its source name.
				if (e?.has_ident_name) e.ident_name else id.name,
				node.line, node.col
			);

			is BinaryExpr as b -> self.arena.binary(
				b.op,
				self.clone_expr(b.left, subst),
				self.clone_expr(b.right, subst),
				node.line, node.col
			);

			is UnaryExpr as u -> self.arena.unary(
				u.op, self.clone_expr(u.operand, subst),
				node.line, node.col, u.is_postfix
			);

			is CallExpr -> self.clone_call_expr(node!, subst);

			is MemberExpr as m -> {
				val obj_src = e?.obj_replace ?: m.object;
				val cloned_obj = self.clone_expr(obj_src, subst);
				val res = if (m.is_safe)
					self.arena.safe_member(cloned_obj, m.member, node.line, node.col)
				else
					self.arena.member(cloned_obj, m.member, node.line, node.col);
				yield res;
			}

			is IndexExpr as ix -> self.arena.index(
				self.clone_expr(ix.target, subst),
				self.clone_expr(ix.index, subst),
				node.line, node.col
			);

			is AssignExpr as a -> self.arena.compound_assign(
				a.op,
				self.clone_expr(a.target, subst),
				self.clone_expr(a.value, subst),
				node.line, node.col
			);

			is UpdateExpr as u -> self.arena.update(
				u.op,
				self.clone_expr(u.target, subst),
				node.line, node.col
			);

			is CastExpr as cst -> self.arena.cast(
				if (cst.expr != null) self.clone_expr(cst.expr!, subst) else null,
				self.clone_type(cst.target_type, subst),
				node.line, node.col
			);

			is GroupExpr as g -> self.arena.group(
				self.clone_expr(g.expr, subst),
				node.line, node.col
			);

			is IfExpr as ie -> self.arena.if_expr(
				self.clone_expr(ie.condition, subst),
				self.clone_expr(ie.then_branch, subst),
				self.clone_expr(ie.else_branch, subst),
				node.line, node.col
			);

			is ArrayLiteralExpr as al -> {
				var lname = al.list_struct_name;
				var enode = al.elem_type_node;
				if (e != null) {
					if (e.has_list_name) lname = e.list_name;
					if (e.has_elem_node) enode = self.clone_type(e.elem_node!, subst);
				}
				yield self.arena.list_literal(
					self.clone_expr_list(al.elements, subst),
					lname, enode,
					node.line, node.col
				);
			}

			is WhenExpr as we -> self.arena.when_expr(
				if (we.condition != null) self.clone_expr(we.condition!, subst) else null,
				self.clone_when_arms(node!, subst),
				node.line, node.col
			);

			is InterpExpr -> self.arena.interp(
				self.clone_interp_parts(node!, subst),
				node.line, node.col
			);

			is IsExpr as is_e -> {
				val expr_clone = if (is_e.expr != null) self.clone_expr(is_e.expr!, subst) else null;
				val res_is = self.arena.is_expr(expr_clone, self.clone_type(is_e.target_type, subst), node.line, node.col);
				if (!is_e.alias.empty() && res_is is IsExpr as res_e) {
					res_e.alias = is_e.alias;
					res_e.mutable = is_e.mutable;
				}
				yield res_is;
			}

			is StructCtorExpr as sc -> self.arena.node(NodeData.StructCtorExpr(
				sc.c_name,
				self.clone_expr_list(sc.args, subst)
			), node.line, node.col);

			is EnumCtorExpr as ec -> self.arena.node(NodeData.EnumCtorExpr(
				ec.c_name, ec.tag_field, ec.tag_value, ec.payload_path,
				self.clone_expr_list(ec.args, subst)
			), node.line, node.col);

			is SizeOfParam as sop -> self.arena.node(NodeData.SizeOfParam(
				sop.param_index, sop.size_text
			), node.line, node.col);

			else -> self.arena.identifier("<unsupported-expr>", node.line, node.col);
		};

		// Carry this instance's decisions onto the fresh node.
		if (e != null) {
			if (e.ty != null) out.type_ptr = e.ty as *u8;
			if (e.method != null) out.resolved_method = e.method;
		}
		return out;
	}

	// `CALL`: three shapes are rewritten before the generic clone. `T.size()` folds
	// to a literal, a call carrying type arguments instantiates its template, and
	// everything else is cloned caller-first like the original.
	fn clone_call_expr(var self, node: *AstNode, subst: *GenSubst? = null): *AstNode {
		val special = self.clone_size_query(node, subst) ?: self.clone_template_call(node, subst);
		if (special != null) return special;

		if (node is CallExpr as c) {
			val args = self.clone_expr_list(c.args, subst);
			return self.arena.call(self.clone_expr(c.callee, subst), args, List<*AstNode>(), node.line, node.col);
		}
		return node;
	}

	// `T.size()` in generic code: the substituted type's C size is known at compile
	// time, so the call becomes an integer literal. Null when the call is not a
	// `T.size()` on a type parameter.
	fn clone_size_query(var self, node: *AstNode, subst: *GenSubst? = null): *AstNode? {
		if (node is CallExpr as c) {
			if (c.callee is MemberExpr as m) {
				if (m.member == "size" && m.object is IdentifierExpr as obj_id) {
					val sa = subst?.lookup(obj_id.name) ?: return null;
					return self.arena.literal(LiteralKind.INT, "${self.ast_type_size(sa)}", node.line, node.col);
				}
			}
		}
		return null;
	}

	// A call with explicit type arguments instantiates the matching template and is
	// rewritten to a call of the instantiated name (`obj.m<X>(...)`, `Fn<X>(...)`,
	// `Struct<X>(...)`). Null when no template matches, which sends the caller down
	// its generic clone path.
	fn clone_template_call(var self, node: *AstNode, subst: *GenSubst? = null): *AstNode? {
		if (node is CallExpr as c) {
			if (c.type_args.empty()) return null;

		val callee = c.callee;
		if (callee is MemberExpr as mem) {
			var ft: *GenTemplate? = null;
			if (mem.object is IdentifierExpr as id) {
				ft = self.find_method_template(mem.member, id.name);
			}
			if (ft == null) ft = self.find_method_template(mem.member);
			if (ft == null) return null;

			var is_static = false;
			if (ft.node is FnDecl as f) {
				is_static = f.params.empty() || f.params[0].name != "self";
			}

			val mem_obj = self.clone_expr(mem.object, subst);
			val targs = self.clone_type_args(c.type_args, subst);
			var new_args = List<*AstNode>();
			if (!is_static) new_args += mem_obj;
			for (a in c.args) new_args += self.clone_expr(a, subst);
			val cname = self.instantiate_fn(ft!, targs);
			val call_node = self.arena.call(
				self.arena.identifier(cname, node.line, node.col),
				new_args, List<*AstNode>(),
				node.line, node.col
			);

			if (!is_static && mem.is_safe) {
				val cond = self.arena.binary(
					TokenType.BANG_EQUAL, mem_obj,
					self.arena.literal(LiteralKind.NULL_VAL, "null", node.line, node.col),
					node.line, node.col
				);

				return self.arena.if_expr(
					cond, call_node,
					self.arena.literal(LiteralKind.NULL_VAL, "null", node.line, node.col),
					node.line, node.col
				);
			}
			return call_node;
		}

		if (callee is IdentifierExpr as cid) {
			val ft = self.find_fn_template(cid.name);
			if (ft != null) {
				val targs = self.clone_type_args(c.type_args, subst);
				val cname = self.instantiate_fn(ft, targs);
				var cargs = List<*AstNode>();
				for (a in c.args) cargs += self.clone_expr(a, subst);
				return self.arena.call(
					self.arena.identifier(cname, node.line, node.col),
					cargs, List<*AstNode>(), node.line, node.col
				);
			}

			val st = self.find_struct_template(cid.name);
			if (st != null) {
				val targs = self.clone_type_args(c.type_args, subst);
				val cty = self.instantiate_struct(st, targs);
				var cargs = List<*AstNode>();
				for (a in c.args) cargs += self.clone_expr(a, subst);
				return self.arena.call(
					self.arena.identifier(cty.as_struct().name, node.line, node.col),
					cargs, List<*AstNode>(), node.line, node.col
				);
			}
		}
		}

		return null;
	}

	fn clone_expr_list(var self, nodes: List<*AstNode>, subst: *GenSubst? = null): List<*AstNode> {
		var out = List<*AstNode>();
		for (n in nodes) out += self.clone_expr(n, subst);
		return out;
	}

	fn clone_type_args(var self, nodes: List<*AstNode>, subst: *GenSubst? = null): List<*AstNode> {
		var out = List<*AstNode>();
		for (n in nodes) out += self.clone_type(n, subst);
		return out;
	}

	// A `when` arm's patterns are expressions; its body is a block when written as
	// `{ ... }`, otherwise a single expression.
	fn clone_when_arms(var self, node: *AstNode, subst: *GenSubst? = null): List<WhenArm> {
		var arms = List<WhenArm>();
		if (node is WhenExpr as we) {
			for (arm in we.arms) {
				val pats = self.clone_expr_list(arm.patterns, subst);
				val arm_body = if (arm.body is BlockStmt)
					self.clone_stmt(arm.body, subst)
				else
					self.clone_expr(arm.body, subst);
				arms += WhenArm(pats, arm.is_else, arm_body, arm.line, arm.col);
			}
		}
		return arms;
	}

	fn clone_interp_parts(var self, node: *AstNode, subst: *GenSubst? = null): List<InterpPart> {
		var parts = List<InterpPart>();
		if (node is InterpExpr as ie) {
			for (part in ie.parts) {
				when (part) {
					is InterpPart.Literal as lit -> {
						parts += InterpPart.Literal(self.clone_expr(lit.node, subst));
					}
					is InterpPart.Hole as hole -> {
						parts += InterpPart.Hole(self.clone_expr(hole.node, subst));
					}
				}
			}
		}
		return parts;
	}

	pub fn clone_stmt(var self, node: *AstNode?, subst: *GenSubst? = null): *AstNode {
		if (node == null) return null as *AstNode;
		val se = self.mat_ann(node);
		// A node the checker already replaced for this instance (a desugared
		// `for` block, an injected `continue` step block, ...).
		if (se?.resolved != null) return self.clone_stmt(se.resolved!, subst);

		val target = node;
		return when (target) {
			is BlockStmt as b -> {
				var ss = List<*AstNode>();
				for (s in b.statements) ss += self.clone_stmt(s, subst);
				yield self.arena.node(NodeData.BlockStmt(ss), node.line, node.col);
			}

			is ExprStmt as e -> self.arena.node(
				NodeData.ExprStmt(self.clone_expr(e.expr, subst)),
				node.line, node.col
			);

			is VarDeclStmt as v -> {
				var ta = if (v.type_annotation != null) self.clone_type(v.type_annotation!, subst) else null;
				if (se?.var_ty != null && ta == null) ta = self.arena.ast_type_from_type(se.var_ty!);
				var init_src = v.initializer;
				if (se?.init_override != null) init_src = se.init_override;
				val init_expr = if (init_src != null) self.clone_expr(init_src!, subst) else null;
				if (ta != null && init_expr != null) self.propagate_target_type(ta, init_expr);
				yield self.arena.node(NodeData.VarDeclStmt(v.mutable, v.name, ta, init_expr), node.line, node.col);
			}

			is IfStmt as s -> self.arena.node(
				NodeData.IfStmt(
					self.clone_expr(s.condition, subst),
					self.clone_stmt(s.then_branch, subst),
					if (s.else_branch != null) self.clone_stmt(s.else_branch!, subst) else null
				),
				node.line, node.col
			);

			is WhileStmt as w -> self.arena.node(
				NodeData.WhileStmt(
					self.clone_expr(w.condition, subst),
					self.clone_stmt(w.body, subst)
				),
				node.line, node.col
			);

			is ForStmt as f -> self.arena.node(
				NodeData.ForStmt(
					f.var_name, f.is_range, f.is_open, f.is_half_open,
					if (f.iterable != null) self.clone_expr(f.iterable!, subst) else null,
					if (f.range_start != null) self.clone_expr(f.range_start!, subst) else null,
					if (f.range_end != null) self.clone_expr(f.range_end!, subst) else null,
					self.clone_stmt(f.body, subst)
				),
				node.line, node.col
			);

			is ReturnStmt as r -> self.arena.node(
				NodeData.ReturnStmt(if (r.value != null) self.clone_expr(r.value!, subst) else null),
				node.line, node.col
			);

			is YieldStmt as y -> self.arena.node(
				NodeData.YieldStmt(if (y.value != null) self.clone_expr(y.value!, subst) else null),
				node.line, node.col
			);

			is BreakStmt -> self.arena.node(NodeData.BreakStmt, node.line, node.col);

			is ContinueStmt -> self.arena.node(NodeData.ContinueStmt, node.line, node.col);

			is WhenStmt as w -> {
				var arms = List<WhenStmtArm>();
				for (arm in w.arms) {
					var pats = List<*AstNode>();
					for (pat in arm.patterns) pats += self.clone_expr(pat, subst);
					arms += WhenStmtArm(pats, arm.is_else, self.clone_stmt(arm.body, subst), arm.line, arm.col);
				}
				yield self.arena.node(NodeData.WhenStmt(if (w.condition != null) self.clone_expr(w.condition!, subst) else null, arms), node.line, node.col);
			}

			is DeferStmt as d -> self.arena.node(
				NodeData.DeferStmt(self.clone_stmt(d.body, subst)),
				node.line, node.col
			);

			else -> null as *AstNode;
		};
	}

	pub fn clone_fn(var self, node: *AstNode, subst: *GenSubst? = null, new_name: str = ""): *AstNode {
		if (node is FnDecl as f) {
			var params = List<Param>();
			for (p in f.params) {
				val pt = if (p.type_node != null) self.clone_type(p.type_node!, subst) else null;
				val dflt = if (p.default_val != null) self.clone_expr(p.default_val!, subst) else null;
				params += Param(p.name, pt, p.mutable, p.has_val, dflt);
			}
			val rt = if (f.return_type != null) self.clone_type(f.return_type!, subst) else null;
			return self.arena.node(
				NodeData.FnDecl(
					new_name,
					List<GenericParam>(),
					params, rt,
					if (f.body != null) self.clone_stmt(f.body!, subst) else null,
					f.public, f.operator, f.initializer, self.current_module
				),
				node.line, node.col
			);
		}
		return node;
	}


	// Materializes one function/method instance's body: clones the template's
	// shared AST while carrying the instance's per-node annotations over, so the
	// lower pass can run on a private tree. Returns the body statement root.
	pub fn materialize_body(var self, rec: *InstanceRecord): *AstNode {
		val saved = self.mat_rec;
		self.mat_rec = rec;
		var body: *AstNode? = null;
		if (rec.decl is FnDecl as f && f.body != null) {
			body = self.clone_stmt(f.body!, null);
		}
		self.mat_rec = saved;
		return body ?: self.arena.node(NodeData.BlockStmt(List<*AstNode>()), 0, 0);
	}

}