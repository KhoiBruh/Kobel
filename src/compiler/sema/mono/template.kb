mod compiler.sema.mono.template;

// ============================================================================
// Monomorphization - template registry and substitutions
//
// `GenTemplate` records a generic declaration (struct/fn/impl, the module that
// owns it and, for methods, the receiver source name); `GenSubst` maps template
// parameter names to AST type nodes while cloning.
//
// The typed instance registry lives on `GenericReg` in `symbol.kb`; the
// instantiate/rewrite/clone steps live in `mono.instantiate`, `mono.rewrite`
// and `mono.clone`.
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.lexer.token.TokenType;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;
use compiler.sema.symbol.*;

use compiler.sema.types.DataType;
use compiler.sema.types.Type;
use compiler.sema.types.StructField;
use compiler.sema.types.type_none;
use compiler.sema.types.MethodInfo;

use compiler.sema.decl.pass.*;
use compiler.ast.decl.StructField as AstStructField;
// ============================================================================
// Generic Templates & Monomorphization
// ============================================================================

// Which template table a lookup scans: `fn_templates` holds free functions and
// `impl` methods alike (told apart by `GenTemplate.is_method`), while struct
// templates live in their own table.
pub enum TemplateKind {
	FN,
	METHOD,
	STRUCT
}

// A template is a candidate when its name matches and its table kind agrees:
// `FN` never matches an `impl` method, `METHOD` only matches one, `STRUCT`
// ignores the flag.
fn template_matches(kind: TemplateKind, t: *GenTemplate, name: str): bool => when (kind) {
	TemplateKind.FN -> !t.is_method && t.name == name;
	TemplateKind.METHOD -> t.is_method && t.name == name;
	else -> t.name == name;
};

// Substitution context while cloning a template: type parameter -> type node.
pub struct GenSubst {
	pub names: List<str>,
	pub args: List<*AstNode>
}

impl GenSubst {
	pub fn lookup(val self, name: str): *AstNode {
		val idx = self.names.index_of(name);
		if (idx >= 0) return self.args[idx as usz];
		return null;
	}
}

pub fn is_template_decl(node: *AstNode) => decl_is_template(node);

impl GenTemplate {
	pub fn param_names(val self): List<str> {
		var names = List<str>();
		val node = self.node;
		when (node) {
			is StructDecl -> for (tp in node.type_params) names += tp.name;
			is FnDecl -> for (p in node.type_params) names += p.name;
			is ImplDecl -> for (p in node.type_params) names += p.name;
			else -> {}
		}
		return names;
	}

	// The declared generic parameters of a template (empty for an impl template,
	// whose parameters live on the struct it belongs to).
	pub fn params(val self) => when (self.node.kind) {
		NodeKind.DECL_STRUCT -> self.node.as_struct_decl().type_params,
		NodeKind.DECL_FN -> self.node.as_fn_decl().type_params,
		NodeKind.DECL_IMPL -> self.node.as_impl_decl().type_params,
		else -> List<GenericParam>()
	};
}

impl DeclPass {

	pub fn register_template(var self, node: *AstNode) {
		val cur = node;
		when (cur) {
			is StructDecl as s -> {
				if (s.type_params.len > 0) self.symtab.gen.struct_templates += self.gen_template(s.name, node, false);
			}
			is FnDecl as f -> {
				if (f.type_params.len > 0) self.symtab.gen.fn_templates += self.gen_template(f.name, node, false);
			}
			is ImplDecl as im -> {
				if (im.type_params.len > 0) {
					self.symtab.gen.impl_templates += self.gen_template(im.struct_name, node, true);
				} else {
					for (m in im.methods) {
						if (m is FnDecl as f && f.type_params.len > 0) {
							val f_mut = f as &FnDecl;
							for (i in 0..<f.params.len) {
								val p = f.params[i];
								if (p.name == "self" && p.type_node == null) {
									val prim = resolve_primitive_name(self.symtab.prims_of(), im.struct_name);
									val named = self.arena.named_type(im.struct_name, List<*AstNode>(), m.line, m.col);
									val self_ty_node = if (prim != null) named
										else self.arena.pointer_type(p.is_mut, named, m.line, m.col);
									f_mut.params[i] = Param(p.name, self_ty_node, p.is_mut, p.has_val, p.default_val);
								}
							}
							self.symtab.gen.fn_templates += self.gen_template(f.name, m, true, im.struct_name);
						}
					}
				}
			}
			else -> {}
		}
	}

	// self_type is the impl's target type for a method template ("" otherwise),
	// which lets a method be looked up by its receiver instead of by name alone.
	pub fn gen_template(var self, name: str, node: *AstNode, is_method: bool, self_type: str = ""): *GenTemplate {
		val t = self.arena.alloc<GenTemplate>();
		*t = GenTemplate(name, self.current_module, node, is_method, self_type);
		return t;
	}

	pub fn template_in_module(val self, module: str, name: str): bool {
		for (t in self.symtab.gen.struct_templates) {
			if (t.name == name && t.module == module) return true;
		}
		for (f in self.symtab.gen.fn_templates) {
			if (f.name == name && f.module == module) return true;
		}
		return false;
	}

	pub fn find_instance_symbol(val self, name: str) => self.symtab.gen.find_instance_symbol(name);

	// Which table a `TemplateKind` is looked up in.
	fn templates_of(val self, kind: TemplateKind) =>
		if (kind == TemplateKind.STRUCT) self.symtab.gen.struct_templates
		else self.symtab.gen.fn_templates;

	// A method template also has to agree on the receiver type: two structs may
	// declare a generic method with the same name.
	fn template_fits(val self, kind: TemplateKind, t: *GenTemplate, name: str, self_type: str): bool {
		if (!template_matches(kind, t, name)) return false;
		if (self_type.empty()) return true;
		return t.self_type == self_type;
	}

	// Visible from the current module: own module first, then imports (a wildcard
	// import, or an alias that matches `name`), then any module.
	fn find_template(val self, kind: TemplateKind, name: str, self_type: str = ""): *GenTemplate {
		val list = self.templates_of(kind);
		for (t in list) {
			if (self.template_fits(kind, t, name, self_type) && t.module == self.current_module) return t;
		}
		val b = self.symtab.explicit_imports["${self.current_module}::${name}"];
		if (b != null) {
			for (t in list) {
				if (self.template_fits(kind, t, b.symbol_name, self_type) && t.module == b.module_name) return t;
			}
		}
		for (i in 0..<self.symtab.wildcard_owners.len) {
			if (self.symtab.wildcard_owners[i] == self.current_module) {
				val wmod = self.symtab.wildcard_modules[i];
				for (t in list) {
					if (self.template_fits(kind, t, name, self_type) && t.module == wmod) return t;
				}
			}
		}
		for (t in list) {
			if (self.template_fits(kind, t, name, self_type)) return t;
		}
		return null;
	}

	pub fn find_fn_template(val self, name: str) => self.find_template(TemplateKind.FN, name);

	pub fn find_method_template(val self, name: str, self_type: str = "") => self.find_template(TemplateKind.METHOD, name, self_type);

	pub fn find_struct_template(val self, name: str) => self.find_template(TemplateKind.STRUCT, name);

	pub fn type_token(val self, ty: *Type): str => when (ty.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> "ptr_${self.type_token(ty.as_pointer().pointee)}";
		DataType.ARRAY -> {
			val at = ty.as_array();
			yield "arr${at.length}_${self.type_token(at.elem)}";
		}
		DataType.STRUCT -> ty.as_struct().name;
		else -> "x";
	};

	// C-level size of a type node (used to lower `T.size()` during materialization).
	pub fn ast_type_size(var self, node: *AstNode): usz {
		if (node == null) return 8;
		return when (node.kind) {
			NodeKind.TYPE_POINTER -> 8;
			NodeKind.TYPE_ARRAY -> {
				val a = node.as_array_type();
				yield a.size * self.ast_type_size(a.element_type);
			}
			NodeKind.TYPE_NAMED -> {
				val name = node.as_named_type().name;
				if (name == "str") yield 8;
				if (name == "i8" || name == "u8" || name == "bool" || name == "char") yield 1;
				if (name == "i16" || name == "u16") yield 2;
				if (name == "i32" || name == "u32" || name == "f32") yield 4;
				if (name == "i64" || name == "u64" || name == "isz" || name == "usz" || name == "f64") yield 8;
				val sym = self.symtab.lookup(name);
				if (sym != null) yield sym.type_ptr.size;
				yield 8;
			}
			else -> 8;
		};
	}

	// Checks the trait bounds of an instantiation: for every `T: Trait` parameter
	// the concrete argument must be a struct with a matching `impl Trait for`
	// block. Arguments that are not known structs (primitives, pointers, ...) are
	// left alone so no false error is reported for a type we cannot prove.
	pub fn check_bounds(var self, tmpl: *GenTemplate, arg_asts: List<*AstNode>) {
		val params = tmpl.params();
		for (i in 0..<params.len) {
			val gp = params[i];
			if (gp.bounds.empty() || i >= arg_asts.len) continue;

			val arg = arg_asts[i];
			if (arg.kind != NodeKind.TYPE_NAMED) continue;
			val aname = arg.as_named_type().name;
			val asym = self.symtab.lookup(aname) ?: continue;
			if (asym.type_ptr.kind != DataType.STRUCT) continue;

			for (b in gp.bounds) {
				val bt = self.symtab.find_trait(b);
				if (bt == null) {
					self.report_error(arg, "Unknown trait bound '${b}'");
					continue;
				}
				if (!bt.has_impl(aname)) {
					self.report_error(arg, "Type '${aname}' does not implement trait '${b}'");
				}
			}
		}
	}

	pub fn alloc_subst(var self, names: List<str>, args: List<*AstNode>): *GenSubst {
		val s = self.arena.alloc<GenSubst>();
		*s = GenSubst(names, args);
		return s;
	}

	pub fn queue_decl(var self, module: str, node: *AstNode) {
		val marker = self.arena.module_decl(module.split_dots(), module, node.line, node.col);
		// One pair per instance: it is both the declaration to emit and the entry to
		// rewrite (the clone's own generic uses still have to be resolved).
		self.symtab.gen.instances += marker;
		self.symtab.gen.instances += node;
	}

	// Drains the instance worklist. Rewriting an instance can discover further
	// generic uses and queue more instances, so this runs to a fixpoint; each
	// entry is rewritten with its template's module in scope. Function/method
	// instances are *views* whose bodies are the template's shared AST, so they
	// are never rewritten here: their generic uses are resolved while checking
	// (see `BodyPass` instance annotations and the env-based type resolver).
	pub fn drain_instances(var self) {
		var i = 0;
		while (i + 1 < self.symtab.gen.instances.len) {
			val marker = self.symtab.gen.instances[i];
			val decl = self.symtab.gen.instances[i + 1];
			i += 2;
			if (marker is ModuleDecl as m) {
				self.current_module = m.full_path;
				self.symtab.set_current_module(m.full_path);
			}
			if (decl is FnDecl || decl is ImplDecl) continue;
			self.rewrite_generics(decl);
		}
	}

}
