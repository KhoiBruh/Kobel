mod compiler.sema.body_expr;

// ============================================================================
// BodyPass - Expression Type Checking
//
// Analyzes literals, identifiers, unary/binary operations, member/index access,
// assignments, compound updates, conditionals (if/when), and string interpolation.
// ============================================================================

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.ast.builder.to;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;
use compiler.sema.body_pass.*;
use compiler.sema.desugar_interp.*;

use std.collections.list.*;
use std.mem.arena.*;
use util.strutil.*;

impl BodyPass {

	pub fn coerce_to_list(var self, node: *AstNode, list_ty: *Type) {
		if (node == null || list_ty == null) return;
		when (node.kind) {
			NodeKind.EXPR_ARRAY_LITERAL -> {
				val al = node.to<ArrayLiteralExpr>() as &ArrayLiteralExpr;
				val s = list_ty.as_struct();
				al.list_struct_name = s.c_name;

				if (s.fields.is_empty()) return;
				val f0 = s.fields.first();
				if (f0.type_ptr.kind != DataType.POINTER) return;
				val elem_ty = f0.type_ptr.as_pointer().pointee;
				al.elem_type_node = ast_type_from_type(&self.arena, elem_ty);

				for (i in 0..<al.elements.len) {
					val el = al.elements[i];
					if (is_list_type(elem_ty)) {
						self.coerce_to_list(el, elem_ty);
					}
					val el_ty = self.check_expr(el);
					if (!elem_ty.can_assign(el_ty)) {
						self.report_error(el, "Element type mismatch in List literal");
					}
				}
			}
			NodeKind.EXPR_IF -> {
				val ife = node.to<IfExpr>();
				self.coerce_to_list(ife.then_branch, list_ty);
				self.coerce_to_list(ife.else_branch, list_ty);
			}
			NodeKind.EXPR_GROUP -> {
				val grp = node.to<GroupExpr>();
				self.coerce_to_list(grp.expr, list_ty);
			}
			NodeKind.EXPR_WHEN -> {
				val we = node.to<WhenExpr>();
				for (arm in we.arms) {
					self.coerce_to_list(arm.body, list_ty);
				}
			}
			else -> {}
		}
	}

	pub fn check_literal_expr(var self, node: *AstNode): *Type {
		val lit = node.to<LiteralExpr>();
		when (lit.literal_kind) {
			LiteralKind.INT -> return int_literal_type(&self.arena, lit.raw_text);
			LiteralKind.FLOAT -> return alloc_primitive(&self.arena, type_f64());
			LiteralKind.BOOL -> return alloc_primitive(&self.arena, type_bool());
			LiteralKind.STRING -> return alloc_primitive(&self.arena, type_str());
			LiteralKind.CHAR -> return alloc_primitive(&self.arena, type_char());
			LiteralKind.NULL_VAL -> {
				val none_ty = alloc_primitive(&self.arena, type_none());
				return alloc_pointer_type(&self.arena, none_ty, false);
			}
			else -> return alloc_primitive(&self.arena, type_none());
		}
	}

	pub fn check_ident_expr(var self, node: *AstNode): *Type {
		val id = node.to<IdentifierExpr>() as &IdentifierExpr;

		// `Self` names the type being implemented. Renaming it to the C
		// name lets `Self(...)` build a value directly (no `new` factory).
		if (id.name == "Self" && self.current_self_type != null) {
			id.name = self.current_self_type.as_struct().c_name;
			return self.current_self_type;
		}

		val sym = self.symtab.lookup(id.name);
		if (sym == null) {
			self.report_error(node, "Undeclared identifier '${id.name}'");
			return alloc_primitive(&self.arena, type_none());
		}
		// Switch to the mangled C name (import alias, symbol from another module)
		if (sym.c_name != "" && sym.c_name != id.name) id.name = sym.c_name;
		return sym.type_ptr;
	}

	pub fn check_binary_expr(var self, node: *AstNode): *Type {
		val bin = node.to<BinaryExpr>();
		if (bin.op == TokenType.QUESTION_COLON) {
			val lt = self.check_expr(bin.left);
			if (lt.kind != DataType.POINTER && lt.kind != DataType.STR)
				self.report_error(bin.left, "Left-hand side of Elvis operator '?:' must be a pointer or string");

			val is_jump = bin.right.kind == NodeKind.STMT_RETURN ||
				bin.right.kind == NodeKind.STMT_BREAK ||
				bin.right.kind == NodeKind.STMT_CONTINUE;

			if (is_jump) self.check_statement(bin.right);
			else {
				val rt = self.check_expr(bin.right);
				if (!lt.can_assign(rt))
					self.report_error(bin.right, "Right-hand side of Elvis operator '?:' has incompatible type");
			}

			if (lt.kind == DataType.POINTER) {
				val pt = lt.as_pointer();
				if (pt.is_nullable)
					return alloc_pointer_type(&self.arena, pt.pointee, pt.is_mut);
			}
			return lt;
		}

		val lt = self.check_expr(bin.left);
		val rt = self.check_expr(bin.right);

		// 1. Arithmetic operators (+, -, *, /, %)
		when (bin.op) {
			TokenType.PLUS, TokenType.MINUS, TokenType.STAR,
			TokenType.SLASH, TokenType.PERCENT -> {
				if (bin.op == TokenType.PLUS && lt.kind == DataType.STR) {
					// Rewrite `str + str` into a runtime concat call so the C
					// backend does not emit pointer arithmetic.
					var cat_args = List<*AstNode>();
					cat_args.add(bin.left);
					cat_args.add(bin.right);
					val cat_call = self.call(self.identifier("kobel_concat", node.line, node.col), cat_args, List<*AstNode>(), node.line, node.col);
					val cat_n = node as &AstNode;
					cat_n.kind = NodeKind.EXPR_CALL;
					cat_n.data = cat_call.data;
					return alloc_primitive(&self.arena, type_str());
				}
				if (lt.is_numeric() && rt.is_numeric()) return lt;
				self.report_error(node, "Arithmetic operator not supported for these types");
				return lt;
			}
			// 2. Equality comparison (==, !=)
			TokenType.EQUAL_EQUAL,
			TokenType.BANG_EQUAL -> {
				if (lt.kind == DataType.STR && rt.kind == DataType.STR) {
					// Content comparison instead of C pointer comparison.
					val wrapped = make_str_eq(&self.arena, bin.op == TokenType.BANG_EQUAL, bin.left, bin.right, node.line, node.col);
					val eq_n = node as &AstNode;
					eq_n.kind = wrapped.kind;
					eq_n.data = wrapped.data;
					return alloc_primitive(&self.arena, type_bool());
				}
				if (!lt.can_assign(rt) && !rt.can_assign(lt)) self.report_error(node, "Cannot compare different types");
				return alloc_primitive(&self.arena, type_bool());
			}
			// 3. Ordering comparison (<, <=, >, >=)
			TokenType.LESS, TokenType.LESS_EQUAL,
			TokenType.GREATER, TokenType.GREATER_EQUAL -> {
				val is_num_comp = lt.is_numeric() && rt.is_numeric();
				val is_char_comp = lt.kind == DataType.CHAR && rt.kind == DataType.CHAR;
				if (!is_num_comp && !is_char_comp) self.report_error(node, "Comparison requires numeric or char operands");
				return alloc_primitive(&self.arena, type_bool());
			}
			// 4. Logic (&&, ||)
			TokenType.AND_AND,
			TokenType.OR_OR -> {
				if (lt.kind != DataType.BOOL || rt.kind != DataType.BOOL) {
					self.report_error(node, "Logical operators require bool operands");
				}
				return alloc_primitive(&self.arena, type_bool());
			}
			else -> return lt;
		}
	}

	pub fn check_unary_expr(var self, node: *AstNode): *Type {
		val un = node.to<UnaryExpr>();
		val op_ty = self.check_expr(un.operand);

		when (un.op) {
			TokenType.MINUS -> {
				if (!op_ty.is_numeric()) self.report_error(node, "Unary minus requires numeric operand");
				return op_ty;
			}
			TokenType.BANG -> {
				if (op_ty.kind != DataType.BOOL) self.report_error(node, "Logical NOT requires bool operand");
				return alloc_primitive(&self.arena, type_bool());
			}
			TokenType.STAR -> {
				// Pointer dereference (*ptr)
				if (op_ty.kind != DataType.POINTER) {
					self.report_error(node, "Cannot dereference non-pointer type");
					return op_ty;
				}
				val p_info = op_ty.as_pointer();
				return p_info.pointee;
			}
			// Take address (&expr)
			TokenType.AMPERSAND -> return alloc_pointer_type(&self.arena, op_ty, true);
			else -> return op_ty;
		}
	}

	pub fn check_member_expr(var self, node: *AstNode): *Type {
		val mem = node.to<MemberExpr>() as &MemberExpr;

		// Enum member access: `NodeKind.EXPR_LITERAL` -> integer constant.
		if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
			val enum_id = mem.object.to<IdentifierExpr>();
			val ei = self.symtab.find_enum_info(enum_id.name);
			if (ei != null) {
				val mi = ei.find_member(mem.member);
				if (mi == null) {
					self.report_error(node, "Enum '${enum_id.name}' has no member '${mem.member}'");
					return alloc_primitive(&self.arena, type_none());
				}
				// Reuse the node as a plain integer literal for the backend.
				val lit = self.literal(LiteralKind.INT, "${mi.value}", node.line, node.col);
				val n = node as &AstNode;
				n.kind = NodeKind.EXPR_LITERAL;
				n.data = lit.data;
				return ei.underlying;
			}
		}

		var obj_ty = self.check_expr(mem.object);

		// Pointer results that are not plain identifiers cannot be recognized
		// by the backend's name-based pointer tracking, so dereference them
		// here: `p.field` becomes `(*p).field`.
		if (obj_ty.kind == DataType.POINTER && mem.object.kind != NodeKind.EXPR_IDENTIFIER) {
			mem.object = self.unary(TokenType.STAR, mem.object, node.line, node.col);
		}

		// Automatic pointer unwrapping: p.x when p is *Point or &Point
		var obj_was_ptr = false;
		if (obj_ty.kind == DataType.POINTER) {
			obj_was_ptr = true;
			obj_ty = obj_ty.as_pointer().pointee;
		}

		// Enum `.value`: identity on the underlying integer. The node is
		// rewritten to the receiver so the backend emits it unchanged.
		if (mem.member == "value" && !obj_was_ptr && obj_ty.is_enum()) {
			val n = node as &AstNode;
			n.kind = mem.object.kind;
			n.data = mem.object.data;
			return obj_ty.as_enum().underlying;
		}

		if (obj_ty.kind == DataType.STR) {
			if (mem.member == "len" || mem.member == "size") {
				// Lower to a runtime call: the C backend cannot tell that an
				// arbitrary expression has type `str`.
				var len_args = List<*AstNode>();
				len_args.add(mem.object);
				val len_call = self.call(self.identifier("kobel_slen", node.line, node.col), len_args, List<*AstNode>(), node.line, node.col);
				val len_n = node as &AstNode;
				len_n.kind = NodeKind.EXPR_CALL;
				len_n.data = len_call.data;
				return alloc_primitive(&self.arena, type_usz());
			}
			if (mem.member == "cap") {
				return alloc_primitive(&self.arena, type_usz());
			}
			if (mem.member == "c_str") {
				val char_ty = alloc_primitive(&self.arena, type_char());
				val char_ptr = alloc_pointer_type(&self.arena, char_ty, false);
				return alloc_fn_type(&self.arena, List<*Type>(), char_ptr);
			}
			if (mem.member == "data") {
				// `str` lowers to a bare `const char*`, so `.data` is the
				// pointer itself: rewrite the access to its receiver.
				val char_ty = alloc_primitive(&self.arena, type_char());
				val dn = node as &AstNode;
				dn.kind = mem.object.kind;
				dn.data = mem.object.data;
				return alloc_pointer_type(&self.arena, char_ty, false);
			}
		}

		if (obj_ty.kind == DataType.ARRAY) {
			val arr = obj_ty.as_array();
			if (mem.member == "len" || mem.member == "size") {
				// The size of a fixed-size array is known at compile time.
				val lit = self.literal(LiteralKind.INT, "${arr.length}UZ", node.line, node.col);
				val ln = node as &AstNode;
				ln.kind = lit.kind;
				ln.data = lit.data;
				return alloc_primitive(&self.arena, type_usz());
			}
			if (mem.member == "data") {
				// A fixed-size array already is a pointer to its first element.
				val dn = node as &AstNode;
				dn.kind = mem.object.kind;
				dn.data = mem.object.data;
				return alloc_pointer_type(&self.arena, arr.elem, true);
			}
		}

		if (obj_ty.kind != DataType.STRUCT) {
			self.report_error(node, "Member access on non-struct type");
			return alloc_primitive(&self.arena, type_none());
		}

		val s_info = obj_ty.as_struct();
		for (f in s_info.fields) {
			if (f.name != mem.member) continue;
			// A non-pub field is only usable where the type is declared.
			if (!f.is_pub && s_info.module != self.symtab.current_module) {
				self.report_error(node, "Field '${mem.member}' of '${s_info.name}' is private to module '${s_info.module}'");
			}
			return f.type_ptr;
		}

		self.report_error(node, "Struct '${s_info.name}' has no member named '${mem.member}'");
		return alloc_primitive(&self.arena, type_none());
	}

	pub fn check_index_expr(var self, node: *AstNode): *Type {
		val idx = node.to<IndexExpr>();
		val target_ty = self.check_expr(idx.target);
		val index_ty = self.check_expr(idx.index);

		// 1. Raw array [T; N]
		if (target_ty.kind == DataType.ARRAY) {
			if (!index_ty.is_integer()) self.report_error(node, "Index must be integer");
			return target_ty.as_array().elem;
		}

		// 2. String indexing str[i] -> char
		if (target_ty.kind == DataType.STR) {
			if (!index_ty.is_integer()) self.report_error(node, "Index must be integer");
			return alloc_primitive(&self.arena, type_char());
		}

		// 3. Raw pointer indexing *T -> T (e.g. self.data[i])
		if (target_ty.kind == DataType.POINTER) {
			if (!index_ty.is_integer()) self.report_error(node, "Index must be integer");
			return target_ty.as_pointer().pointee;
		}

		// 4. Custom container struct with get(index) method (List<T>, etc.)
		if (target_ty.kind == DataType.STRUCT) {
			val s_info = target_ty.as_struct();
			var mi = s_info.find_method_arity("get", 2);
			if (mi == null) mi = s_info.find_method("get");
			if (mi != null) {
				val fn_info = mi.fn_type.as_fn();
				val param_ty = fn_info.param_types[1];
				if (is_list_type(param_ty)) self.coerce_to_list(idx.index, param_ty);
				if (!param_ty.can_assign(index_ty)) self.report_error(node, "Argument type mismatch in index access");

				var new_args = List<*AstNode>();
				new_args.add(self.unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
				new_args.add(idx.index);

				val call_node = self.call(self.identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
				val n = node as &AstNode;
				n.kind = NodeKind.EXPR_CALL;
				n.data = call_node.data;
				return fn_info.return_type;
			}
		}

		self.report_error(node, "Index access on non-indexable type");
		return alloc_primitive(&self.arena, type_none());
	}

	pub fn check_assign_expr(var self, node: *AstNode): *Type {
		val asgn = node.to<AssignExpr>();

		// Index assignment desugaring: container[i] = val -> container.set(i, val)
		var target_expr = asgn.target;
		while (target_expr.kind == NodeKind.EXPR_GROUP) target_expr = target_expr.to<GroupExpr>().expr;

		if (target_expr.kind == NodeKind.EXPR_INDEX) {
			val idx = target_expr.to<IndexExpr>();
			val target_raw_ty = self.check_expr(idx.target);
			if (target_raw_ty.kind == DataType.STRUCT) {
				val s_info = target_raw_ty.as_struct();
				var mi = s_info.find_method_arity("set", 3);
				if (mi == null) mi = s_info.find_method("set");
				if (mi != null) {
					val fn_info = mi.fn_type.as_fn();
					val idx_param_ty = fn_info.param_types[1];
					val val_param_ty = fn_info.param_types[2];

					var val_expr = asgn.value;
					if (asgn.op != TokenType.EQUAL) {
						val bin_op = when (asgn.op) {
							TokenType.PLUS_EQUAL -> TokenType.PLUS,
							TokenType.MINUS_EQUAL -> TokenType.MINUS,
							TokenType.STAR_EQUAL -> TokenType.STAR,
							TokenType.SLASH_EQUAL -> TokenType.SLASH,
							TokenType.PERCENT_EQUAL -> TokenType.PERCENT,
							else -> TokenType.PLUS
						};
						val get_expr = self.index(idx.target, idx.index, node.line, node.col);
						val_expr = self.binary(bin_op, get_expr, asgn.value, node.line, node.col);
					}

					if (is_list_type(idx_param_ty)) self.coerce_to_list(idx.index, idx_param_ty);
					val idx_ty = self.check_expr(idx.index);
					if (!idx_param_ty.can_assign(idx_ty)) self.report_error(node, "Index type mismatch in index assignment");

					if (is_list_type(val_param_ty)) self.coerce_to_list(val_expr, val_param_ty);
					val val_ty = self.check_expr(val_expr);
					if (!val_param_ty.can_assign(val_ty)) self.report_error(node, "Value type mismatch in index assignment");

					var new_args = List<*AstNode>();
					new_args.add(self.unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
					new_args.add(idx.index);
					new_args.add(val_expr);

					val call_node = self.call(self.identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
					val n = node as &AstNode;
					n.kind = NodeKind.EXPR_CALL;
					n.data = call_node.data;
					return val_param_ty;
				}
			}
		}

		val target_ty = self.check_expr(asgn.target);
		if (is_list_type(target_ty)) self.coerce_to_list(asgn.value, target_ty);
		val val_ty = self.check_expr(asgn.value);

		// String concatenation desugaring: s += str -> s = kobel_concat(s, str)
		if (asgn.op == TokenType.PLUS_EQUAL && target_ty.kind == DataType.STR) {
			var cat_args = List<*AstNode>();
			cat_args.add(asgn.target);
			cat_args.add(asgn.value);
			val cat_call = self.call(self.identifier("kobel_concat", node.line, node.col), cat_args, List<*AstNode>(), node.line, node.col);
			asgn.value = cat_call;
			asgn.op = TokenType.EQUAL;
			return target_ty;
		}

		if (asgn.op != TokenType.EQUAL) {
			if (!target_ty.is_numeric() || !val_ty.is_numeric()) {
				self.report_error(node, "Compound assignment operator requires numeric operands");
			}
		}

		if (!target_ty.can_assign(val_ty)) self.report_error(node, "Type mismatch in assignment");
		return target_ty;
	}

	pub fn check_update_expr(var self, node: *AstNode): *Type {
		val u = node.to<UpdateExpr>();

		var target_expr = u.target;
		while (target_expr.kind == NodeKind.EXPR_GROUP) target_expr = target_expr.to<GroupExpr>().expr;

		if (
			target_expr.kind != NodeKind.EXPR_IDENTIFIER &&
			target_expr.kind != NodeKind.EXPR_MEMBER &&
			target_expr.kind != NodeKind.EXPR_INDEX &&
			target_expr.kind != NodeKind.EXPR_UNARY
		) self.report_error(node, "Invalid target for increment/decrement operator");

		// Index assignment desugaring: container[i]++ -> container.set(i, container.get(i) + 1)
		if (target_expr.kind == NodeKind.EXPR_INDEX) {
			val idx = target_expr.to<IndexExpr>();
			val target_raw_ty = self.check_expr(idx.target);
			if (target_raw_ty.kind == DataType.STRUCT) {
				val s_info = target_raw_ty.as_struct();
				var mi = s_info.find_method_arity("set", 3);
				if (mi == null) mi = s_info.find_method("set");
				if (mi != null) {
					val fn_info = mi.fn_type.as_fn();
					val idx_param_ty = fn_info.param_types[1];
					val val_param_ty = fn_info.param_types[2];

					val bin_op = if (u.op == TokenType.PLUS_PLUS) TokenType.PLUS else TokenType.MINUS;
					val one_node = if (val_param_ty.is_float()) self.literal(LiteralKind.FLOAT, "1.0", node.line, node.col)
					               else self.literal(LiteralKind.INT, "1", node.line, node.col);
					val get_expr = self.index(idx.target, idx.index, node.line, node.col);
					val val_expr = self.binary(bin_op, get_expr, one_node, node.line, node.col);

					if (is_list_type(idx_param_ty)) self.coerce_to_list(idx.index, idx_param_ty);
					val idx_ty = self.check_expr(idx.index);
					if (!idx_param_ty.can_assign(idx_ty)) self.report_error(node, "Index type mismatch in index update");

					val v_ty = self.check_expr(val_expr);
					if (!val_param_ty.can_assign(v_ty)) self.report_error(node, "Value type mismatch in index update");

					var new_args = List<*AstNode>();
					new_args.add(self.unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
					new_args.add(idx.index);
					new_args.add(val_expr);

					val call_node = self.call(self.identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
					val n = node as &AstNode;
					n.kind = NodeKind.EXPR_CALL;
					n.data = call_node.data;
					return val_param_ty;
				}
			}
		}

		val target_ty = self.check_expr(u.target);
		if (!target_ty.is_numeric()) self.report_error(node, "Increment/decrement operator requires numeric operand");
		return target_ty;
	}

	pub fn check_cast_expr(var self, node: *AstNode): *Type {
		val cst = node.to<CastExpr>();
		self.check_expr(cst.expr);
		return self.resolve_type(cst.target_type);
	}

	pub fn check_if_expr(var self, node: *AstNode): *Type {
		val if_e = node.to<IfExpr>();
		val cond_ty = self.check_expr(if_e.condition);
		if (cond_ty.kind != DataType.BOOL) self.report_error(node, "If expression condition must be bool");
		val then_ty = self.check_expr(if_e.then_branch);
		val else_ty = self.check_expr(if_e.else_branch);
		if (!then_ty.can_assign(else_ty)) self.report_error(node, "If expression branches have incompatible types");
		return then_ty;
	}

	pub fn check_when_expr(var self, node: *AstNode): *Type {
		val we = node.to<WhenExpr>();
		if (we.condition != null) self.check_expr(we.condition);

		self.when_depth++;
		var result_ty: *Type = null;
		var has_else = false;
		for (arm in we.arms) {
			if (arm.is_else) has_else = true;
			for (pat in arm.patterns) {
				val p_ty = self.check_expr(pat);
				if (we.condition == null && p_ty.kind != DataType.BOOL)
					self.report_error(pat, "Boolean when arm condition must be bool");
			}

			val body_ty = self.check_when_arm_body(arm.body);
			if (result_ty == null) result_ty = body_ty;
			else if (!result_ty.can_assign(body_ty))
				self.report_error(arm.body, "When arm type does not match previous arms");
		}
		self.when_depth--;

		if (!has_else) {
			self.report_error(node, "when expression requires an 'else' arm");
			return alloc_primitive(&self.arena, type_none());
		}
		if (result_ty == null) return alloc_primitive(&self.arena, type_none());
		return result_ty;
	}

	pub fn check_when_arm_body(var self, body: *AstNode): *Type {
		if (body.kind == NodeKind.STMT_BLOCK) {
			val blk = body.to<BlockStmt>();
			var yield_ty: *Type = null;
			self.symtab.enter_scope(false);
			for (stmt in blk.statements) {
				if (stmt.kind == NodeKind.STMT_YIELD) {
					val ys = stmt.to<YieldStmt>();
					if (ys.value != null) yield_ty = self.check_expr(ys.value);
					else yield_ty = alloc_primitive(&self.arena, type_none());
				} else self.check_statement(stmt);
			}
			self.symtab.exit_scope();
			if (yield_ty == null) {
				self.report_error(body, "When arm block must yield a value");
				return alloc_primitive(&self.arena, type_none());
			}
			return yield_ty;
		}
		return self.check_expr(body);
	}

	pub fn check_array_literal_expr(var self, node: *AstNode): *Type {
		val al = node.to<ArrayLiteralExpr>();

		if (al.list_struct_name != "") {
			val sym = self.symtab.lookup(al.list_struct_name);
			if (sym != null) return sym.type_ptr;
		}

		// The element type comes from the first element; an empty literal
		// has nothing to infer from (use an annotated `[T; 0]` variable).
		if (al.elements.is_empty()) {
			self.report_error(node, "Cannot infer the element type of an empty array literal");
			return alloc_primitive(&self.arena, type_none());
		}

		val elem_ty = self.check_expr(al.elements.first());
		for (i in 1..<al.elements.len) {
			val t = self.check_expr(al.elements[i]);
			if (!elem_ty.can_assign(t)) self.report_error(al.elements[i], "Array literal element type mismatch");
		}
		return alloc_array_type(&self.arena, elem_ty, al.elements.len);
	}

	pub fn check_interp_expr(var self, node: *AstNode): *Type {
		val ie = node.to<InterpExpr>();

		// Fold the parts into a `kobel_concat` chain; every hole is checked
		// once and converted to `str` (see interp_piece).
		var acc: *AstNode = null;
		for (part in ie.parts) {
			var piece = part.expr;
			if (!part.is_literal) {
				val pty = self.check_expr(piece);
				piece = self.interp_piece(node, piece, pty);
				if (piece == null) return alloc_primitive(&self.arena, type_str());
			}
			if (acc == null) acc = piece;
			else acc = interp_concat(&self.arena, acc, piece, node.line, node.col);
		}
		if (acc == null) acc = self.literal(LiteralKind.STRING, "\"\"", node.line, node.col);

		val in_n = node as &AstNode;
		in_n.kind = acc.kind;
		in_n.data = acc.data;
		return alloc_primitive(&self.arena, type_str());
	}

	// Converts one interpolation hole to `str`, or reports an error and returns null.
	pub fn interp_piece(var self, node: *AstNode, expr: *AstNode, ty: *Type): *AstNode {
		if (ty.kind == DataType.STR) return expr;

		// Everything else goes through the `ToStr` trait; std.traits.to_str (loaded
		// by the driver) provides the built-in implementations.
		val pmi = self.symtab.find_prim_method(ty.kind, "to_str");
		if (pmi != null) return interp_call(&self.arena, pmi.c_name, expr, node.line, node.col);

		var cur_ty = ty;
		var is_ptr = false;
		if (cur_ty.kind == DataType.POINTER) {
			is_ptr = true;
			cur_ty = cur_ty.as_pointer().pointee;
		}
		if (cur_ty.kind == DataType.STRUCT) {
			val st_info = cur_ty.as_struct();
			val mi = st_info.find_method("to_str");
			if (mi != null) {
				var arg = expr;
				if (!is_ptr) arg = self.unary(TokenType.AMPERSAND, expr, node.line, node.col);
				return interp_call(&self.arena, mi.c_name, arg, node.line, node.col);
			}
		}

		self.report_error(node, "Interpolated value must implement ToStr");
		return null;
	}

}
