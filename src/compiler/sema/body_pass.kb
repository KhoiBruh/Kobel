mod compiler.sema.body_pass;

// ============================================================================
// BodyPass - Type Checker & Body Analyzer Core Dispatcher
//
// Coordinates statement and expression checking across AST nodes.
// Specific node checks are factored into:
// - `body_stmt.kb`: statement analysis (blocks, declarations, loops, returns)
// - `body_expr.kb`: expression analysis (operators, accessors, assignments)
// - `body_call.kb`: call resolution, methods, and constructors
// - `body_program.kb`: module, function, and impl declaration drivers
// ============================================================================
use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;
use compiler.sema.desugar_interp.*;
use compiler.sema.body_stmt.*;
use compiler.sema.body_expr.*;
use compiler.sema.body_call.*;
use compiler.sema.body_program.*;

// ============================================================================
// BodyPass Struct Definition
// ============================================================================

pub struct BodyPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_fn_return_type: *Type,
	pub loop_depth: usz,
	pub errors: List<str>,
	// Type being implemented, so `Self` resolves inside an `impl` body.
	pub current_self_type: *Type,
	// true when SymbolTable is preloaded from outside (multiple modules)
	pub has_symtab: bool,
	pub when_depth: usz = 0,
	pub checked_fns: List<*AstNode> = List(),
	pub is_stmt_level: bool = false,
	pub defer_depth: usz = 0,
	// Declaration pass whose type resolver and instance tables this pass reuses,
	// so checking a body never builds a second DeclPass (see `resolve_type`).
	// Held by value: `has_decl` says whether it was populated.
	pub decl: DeclPass = DeclPass(),
	pub has_decl: bool = false
}

impl BodyPass {

	pub fn new(): Self {
		var arena = Arena();
		var decl_p = DeclPass();
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(decl_p.symtab, arena, none_ty, 0, List<str>(), null, false);
	}

	pub fn new(symtab: SymbolTable): Self {
		var arena = Arena();
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(symtab, arena, none_ty, 0, List<str>(), null, true);
	}

	// Standard construction: reuse the declaration pass of the same compilation
	// for type resolution and generic instantiation.
	pub fn new(symtab: SymbolTable, decl: DeclPass): Self {
		var arena = Arena();
		val none_ty = alloc_primitive(&arena, type_none());
		var bp = Self(symtab, arena, none_ty, 0, List<str>(), null, true);
		bp.decl = decl;
		bp.has_decl = true;
		bp.symtab.prims = decl.symtab.prims_of();
		return bp;
	}

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz): *AstNode
		=> self.arena.make<LiteralExpr>(LiteralExpr.TAG, LiteralExpr(lk, raw), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz): *AstNode
		=> self.arena.make<IdentifierExpr>(IdentifierExpr.TAG, IdentifierExpr(name), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<BinaryExpr>(BinaryExpr.TAG, BinaryExpr(left, op, right), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<UnaryExpr>(UnaryExpr.TAG, UnaryExpr(op, operand), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<CallExpr>(CallExpr.TAG, CallExpr(callee, args, type_args), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IndexExpr>(IndexExpr.TAG, IndexExpr(target, index), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.make<MemberExpr>(MemberExpr.TAG, MemberExpr(obj, member), line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.make<MemberExpr>(MemberExpr.TAG, MemberExpr(obj, member, true), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IfExpr>(IfExpr.TAG, IfExpr(condition, then_branch, else_branch), line, col);

	pub fn clone_expr(var self, node: *AstNode): *AstNode {
		if (node == null) return null;
		return when (node) {
			is LiteralExpr as lit -> self.arena.make<LiteralExpr>(
				LiteralExpr.TAG, LiteralExpr(lit.literal_kind, lit.raw_text),
				node.line, node.col
			);

			is IdentifierExpr as id -> self.arena.make<IdentifierExpr>(
				IdentifierExpr.TAG, IdentifierExpr(id.name),
				node.line, node.col
			);

			is BinaryExpr as b -> self.arena.make<BinaryExpr>(
				BinaryExpr.TAG, BinaryExpr(self.clone_expr(b.left), b.op, self.clone_expr(b.right)),
				node.line, node.col
			);

			is UnaryExpr as u -> self.arena.make<UnaryExpr>(
				UnaryExpr.TAG, UnaryExpr(u.op, self.clone_expr(u.operand)),
				node.line, node.col
			);

			is CallExpr as c -> {
				var args = List<*AstNode>();
				for (a in c.args) args += self.clone_expr(a);
				var targs = List<*AstNode>();
				for (ta in c.type_args) targs += ta;
				yield self.arena.make<CallExpr>(CallExpr.TAG, CallExpr(self.clone_expr(c.callee), args, targs), node.line, node.col);
			}
			is MemberExpr as m -> self.arena.make<MemberExpr>(
				MemberExpr.TAG, MemberExpr(self.clone_expr(m.object), m.member, m.is_safe),
				node.line, node.col
			);

			is IndexExpr as ix -> self.arena.make<IndexExpr>(
				IndexExpr.TAG, IndexExpr(self.clone_expr(ix.target), self.clone_expr(ix.index)),
				node.line, node.col
			);

			is GroupExpr as g -> self.arena.make<GroupExpr>(
				GroupExpr.TAG, GroupExpr(self.clone_expr(g.expr)),
				node.line, node.col
			);

			is ArrayLiteralExpr as al -> {
				var els = List<*AstNode>();
				for (e in al.elements) els += self.clone_expr(e);
				yield self.arena.make<ArrayLiteralExpr>(
					ArrayLiteralExpr.TAG, ArrayLiteralExpr(els, al.list_struct_name, al.elem_type_node),
					node.line, node.col
				);
			}

			is CastExpr as cst -> self.arena.make<CastExpr>(
				CastExpr.TAG, CastExpr(self.clone_expr(cst.expr), cst.target_type),
				node.line, node.col
			);
			else -> node;
		};
	}

	// ============================================================================
	// Shorthands
	// ============================================================================

	// Primitive result types: the canonical instance from the symbol table, so
	// two `str` annotations are the same pointer.
	pub fn t_none(var self): *Type => self.symtab.prims_of().get(DataType.NONE);
	pub fn t_bool(var self): *Type => self.symtab.prims_of().get(DataType.BOOL);
	pub fn t_char(var self): *Type => self.symtab.prims_of().get(DataType.CHAR);
	pub fn t_str(var self): *Type => self.symtab.prims_of().get(DataType.STR);
	pub fn t_usz(var self): *Type => self.symtab.prims_of().get(DataType.USZ);
	pub fn t_prim(var self, base: Type): *Type => self.symtab.prims_of().get(base.kind) ?: alloc_primitive(&self.arena, base);

	// Reports `msg` at `node` unless `cond` holds.
	pub fn ensure(var self, cond: bool, node: *AstNode, msg: str) {
		if (!cond) self.report_error(node, msg);
	}

	pub fn enter_module(var self, module: str): str {
		val prev = self.symtab.current_module;
		if (module.len > 0) self.symtab.set_current_module(module);
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.symtab.set_current_module(prev);
	}

	// Evaluates an expression with statement-level context (allowing statement-only constructs like jump Elvis)
	pub fn check_expr_stmt(var self, expr: *AstNode): *Type {
		val prev = self.is_stmt_level;
		self.is_stmt_level = true;
		val ty = self.check_expr(expr);
		self.is_stmt_level = prev;
		return ty;
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		// Prefix the module name (if any) so we know which module an error is in for multi-module builds
		val loc = if (node != null) "Line ${node.line}, Column ${node.col}: ${msg}"
		else msg;

		if (self.symtab.current_module.len > 0) {
			self.errors += "${self.symtab.current_module}: ${loc}";
		} else self.errors += loc;
	}

	pub fn resolve_type(var self, node: *AstNode): *Type {
		if (self.has_decl) {
			// Reuse the declaration pass: same symbol table, arena and instance
			// tables, so an instantiation made while checking a body stays
			// coherent with the ones made while collecting declarations. The
			// table is threaded through by value, so hand the current one over
			// and take back whatever the resolver added.
			self.decl.symtab = self.symtab;
			self.decl.current_module = self.symtab.current_module;
			self.decl.current_self_type = self.current_self_type;
			self.decl.errors = self.errors;
			val ty = self.decl.resolve_ast_type(node);
			self.symtab = self.decl.symtab;
			self.errors = self.decl.errors;
			return ty;
		}

		// Standalone use (tests): resolve through a throwaway pass.
		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type
		);
		val ty = decl_p.resolve_ast_type(node);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return ty;
	}

	// ============================================================================
	// Top-level Expression Dispatcher
	// ============================================================================

	pub fn check_expr(var self, node: *AstNode): *Type {
		if (node == null) return self.t_none();
		if (node is GroupExpr as g) return self.check_expr(g.expr);

		if (
			node.kind != NodeKind.EXPR_BINARY &&
			node.kind != NodeKind.EXPR_ASSIGN
		) self.is_stmt_level = false;

		val ty = self.check_expr_node(node);
		self.annotate_type(node, ty);
		return ty;
	}

	// Records the resolved type on the expression. Every lowering keeps the
	// value's type, so annotating after the check describes the node codegen
	// will actually see. Two channels: `resolved_type` for the backend (an AST
	// type node) and `sema_type` for later sema passes (the compiler's `*Type`).
	fn annotate_type(var self, node: *AstNode, ty: *Type) {
		if (node == null || ty == null) return;
		node.resolved_type = self.arena.ast_type_from_type(ty);
		node.sema_type = ty as *u8;
	}

	fn check_expr_node(var self, node: *AstNode): *Type => when (node.kind) {
		NodeKind.EXPR_LITERAL -> self.check_literal_expr(node);
		NodeKind.EXPR_IDENTIFIER -> self.check_ident_expr(node);
		NodeKind.EXPR_BINARY -> self.check_binary_expr(node);
		NodeKind.EXPR_UNARY -> self.check_unary_expr(node);
		NodeKind.EXPR_CALL -> self.check_call_expr(node);
		NodeKind.EXPR_MEMBER -> self.check_member_expr(node);
		NodeKind.EXPR_INDEX -> self.check_index_expr(node);
		NodeKind.EXPR_ASSIGN -> self.check_assign_expr(node);
		NodeKind.EXPR_UPDATE -> self.check_update_expr(node);
		NodeKind.EXPR_CAST -> self.check_cast_expr(node);
		NodeKind.EXPR_IF -> self.check_if_expr(node);
		NodeKind.EXPR_WHEN -> self.check_when_expr(node);
		NodeKind.EXPR_ARRAY_LITERAL -> self.check_array_literal_expr(node);
		NodeKind.EXPR_INTERP -> self.check_interp_expr(node);
		NodeKind.EXPR_IS -> self.check_is_expr(node);
		else -> self.t_none();
	};

	// ============================================================================
	// Top-level Statement Dispatcher
	// ============================================================================

	pub fn check_statement(var self, node: *AstNode) {
		if (node == null) return;

		if (node is ExprStmt as es) {
			self.check_expr_stmt(es.expr);
			return;
		}
		if (node is DeferStmt as ds) {
			if (self.defer_depth > 0UZ)
				self.report_error(node, "Nested defer statement is not allowed inside defer");
			self.defer_depth++;
			self.check_statement(ds.body);
			self.defer_depth--;
			return;
		}
		if (node is YieldStmt as ys) {
			if (self.defer_depth > 0UZ)
				self.report_error(node, "Yield statement is not allowed inside defer");
			if (self.when_depth == 0)
				self.report_error(node, "Yield statement outside of when expression");

			if (ys.value != null) self.check_expr(ys.value);
			return;
		}

		when (node.kind) {
			NodeKind.STMT_BLOCK -> self.check_block_stmt(node);
			NodeKind.STMT_VAR_DECL -> self.check_var_decl_stmt(node);
			NodeKind.STMT_IF -> self.check_if_stmt(node);
			NodeKind.STMT_WHILE -> self.check_while_stmt(node);
			NodeKind.STMT_FOR -> self.check_for_stmt(node);
			NodeKind.STMT_RETURN -> self.check_return_stmt(node);
			NodeKind.STMT_BREAK, NodeKind.STMT_CONTINUE -> {
				if (self.defer_depth > 0UZ)
					self.report_error(node, "Break or continue statement is not allowed inside defer");
				if (self.loop_depth == 0)
					self.report_error(node, "Break or continue statement outside of loop");
			}
			NodeKind.STMT_WHEN -> self.check_when_stmt(node);
			else -> {}
		}
	}

}

// C size (in bytes) of a primitive type name, or 0 when `name` is not one.
// Mirrors `ast_type_size`: `str` is a C pointer, not the 16-byte slice value,
// so an array of `str` has pointer stride.
pub fn prim_c_size(name: str): usz => when (name) {
	"bool", "char", "i8", "u8" -> 1;
	"i16", "u16" -> 2;
	"i32", "u32", "f32" -> 4;
	"i64", "u64", "isz", "usz", "f64", "str" -> 8;
	else -> 0;
};
