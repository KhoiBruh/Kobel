// Disambiguate semantic-type accessors (builder.kb declares AST-named twins).
use compiler.sema.types.as_pointer_type as sem_pointer;
use compiler.sema.types.as_array_type as sem_array;
use compiler.sema.types.as_struct_type as sem_struct;
use compiler.sema.types.as_fn_type as sem_fn;
