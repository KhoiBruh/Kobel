use std.mem.arena.*;

// ============================================================================
// BodyPass - Type Checker & Body Analyzer
// ============================================================================

pub struct BodyPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_fn_return_type: *Type,
	pub loop_depth: usz,
	pub errors: List<str>,
	// Type being implemented, so `Self` resolves inside an `impl` body.
	pub current_self_type: *Type,
	// true when SymbolTable is preloaded from outside (multiple modules)
	pub has_symtab: bool
}

impl BodyPass {
	pub fn new(): BodyPass {
		var arena = Arena(65536);
		var decl_p = DeclPass();
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(decl_p.symtab, arena, none_ty, 0, List<str>(), null, false);
	}

	pub fn new(symtab: SymbolTable): BodyPass {
		var arena = Arena(65536);
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(symtab, arena, none_ty, 0, List<str>(), null, true);
	}
}

// C size (in bytes) of a primitive type name, or 0 when `name` is not one.
// Mirrors `ast_type_size`: `str` is a C pointer, not the 16-byte slice value,
// so an array of `str` has pointer stride.
fn prim_c_size(name: str): usz {
	if (name == "bool" || name == "char" || name == "i8" || name == "u8") return 1;
	if (name == "i16" || name == "u16") return 2;
	if (name == "i32" || name == "u32" || name == "f32") return 4;
	if (name == "i64" || name == "u64" || name == "isz" || name == "usz" || name == "f64") return 8;
	if (name == "str") return 8;
	return 0;
}

pub fn report_error(var self: &BodyPass, node: *AstNode, msg: str) {
	// Prefix the module name (if any) so we know which module an error is in for multi-module builds
	var loc: str = "";
	if (node != null) loc = "Line ${node.line}, Column ${node.col}: ${msg}";
	else loc = msg;

	if (self.symtab.current_module.len > 0) {
		self.errors.add("${self.symtab.current_module}: ${loc}");
	} else self.errors.add(loc);
}

pub fn resolve_type(var self: &BodyPass, node: *AstNode): *Type {
	var decl_p = DeclPass(self.symtab, self.arena, self.symtab.current_module, self.errors, false, self.current_self_type);
	val ty = resolve_ast_type(&decl_p, node);
	self.arena = decl_p.arena;
	self.errors = decl_p.errors;
	return ty;
}

pub fn int_literal_type(var arena: &Arena, raw: str): *Type {
	val len = raw.len;
	if (len >= 2) {
		val last = raw[len - 1];
		val prev = raw[len - 2];
		if (prev == 'U' && last == 'B') return alloc_primitive(arena, type_u8());
		if (prev == 'U' && last == 'S') return alloc_primitive(arena, type_u16());
		if (prev == 'U' && last == 'L') return alloc_primitive(arena, type_u64());
		if (prev == 'U' && last == 'Z') return alloc_primitive(arena, type_usz());
	}
	if (len >= 1) {
		val last = raw[len - 1];
		if (last == 'U') return alloc_primitive(arena, type_u32());
		if (last == 'L') return alloc_primitive(arena, type_i64());
		if (last == 'S') return alloc_primitive(arena, type_i16());
		if (last == 'Z') return alloc_primitive(arena, type_isz());
		if (last == 'B') return alloc_primitive(arena, type_i8());
	}
	return alloc_primitive(arena, type_i32());
}

// ============================================================================
// Expression Type Checking
// ============================================================================

pub fn check_expr(var self: &BodyPass, node: *AstNode): *Type {
	if (node == null) return alloc_primitive(&self.arena, type_none());

	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = as_literal(node);
			when (lit.literal_kind) {
				LiteralKind.INT -> return int_literal_type(&self.arena, lit.raw_text);
				LiteralKind.FLOAT -> return alloc_primitive(&self.arena, type_f64());
				LiteralKind.BOOL -> return alloc_primitive(&self.arena, type_bool());
				LiteralKind.STRING -> return alloc_primitive(&self.arena, type_str());
				LiteralKind.CHAR -> return alloc_primitive(&self.arena, type_char());
				LiteralKind.NULL_VAL -> {
					val none_ty = alloc_primitive(&self.arena, type_none());
					return alloc_pointer_type(&self.arena, none_ty, false);
				}
				else -> return alloc_primitive(&self.arena, type_none());
			}
		}
		NodeKind.EXPR_IDENTIFIER -> {
			val id = as_identifier(node) as &IdentifierExpr;

			// `Self` names the type being implemented. Renaming it to the C
			// name lets `Self(...)` build a value directly (no `new` factory).
			if (id.name == "Self" && self.current_self_type != null) {
				id.name = sem_struct(self.current_self_type).c_name;
				return self.current_self_type;
			}

			val sym = lookup(&self.symtab, id.name);
			if (sym == null) {
				report_error(self, node, "Undeclared identifier '${id.name}'");
				return alloc_primitive(&self.arena, type_none());
			}
			// Switch to the mangled C name (import alias, symbol from another module)
			if (sym.c_name != "" && sym.c_name != id.name) id.name = sym.c_name;
			return sym.type_ptr;
		}
		NodeKind.EXPR_GROUP -> {
			val grp = as_group(node);
			return check_expr(self, grp.expr);
		}
		NodeKind.EXPR_BINARY -> {
			val bin = as_binary(node);
			val lt = check_expr(self, bin.left);
			val rt = check_expr(self, bin.right);

			// 1. Arithmetic operators (+, -, *, /, %)
			when (bin.op) {
				TokenType.PLUS, TokenType.MINUS, TokenType.STAR,
				TokenType.SLASH, TokenType.PERCENT -> {
					if (bin.op == TokenType.PLUS && lt.kind == DataType.STR) {
						// Rewrite `str + str` into a runtime concat call so the C
						// backend does not emit pointer arithmetic.
						var cat_args = List<*AstNode>();
						cat_args.add(bin.left);
						cat_args.add(bin.right);
						val cat_call = alloc_call(&self.arena, alloc_identifier(&self.arena, "kobel_concat", node.line, node.col), cat_args, List<*AstNode>(), node.line, node.col);
						val cat_n = node as &AstNode;
						cat_n.kind = NodeKind.EXPR_CALL;
						cat_n.data = cat_call.data;
						return alloc_primitive(&self.arena, type_str());
					}
					if (is_numeric(lt) && is_numeric(rt)) return lt;
					report_error(self, node, "Arithmetic operator not supported for these types");
					return lt;
				}
				// 2. Equality comparison (==, !=)
				TokenType.EQUAL_EQUAL,
				TokenType.BANG_EQUAL -> {
					if (lt.kind == DataType.STR && rt.kind == DataType.STR) {
						// Content comparison instead of C pointer comparison.
						val wrapped = make_str_eq(&self.arena, bin.op == TokenType.BANG_EQUAL, bin.left, bin.right, node.line, node.col);
						val eq_n = node as &AstNode;
						eq_n.kind = wrapped.kind;
						eq_n.data = wrapped.data;
						return alloc_primitive(&self.arena, type_bool());
					}
					if (!can_assign(lt, rt) && !can_assign(rt, lt)) report_error(self, node, "Cannot compare different types");
					return alloc_primitive(&self.arena, type_bool());
				}
				// 3. Ordering comparison (<, <=, >, >=)
				TokenType.LESS, TokenType.LESS_EQUAL,
				TokenType.GREATER, TokenType.GREATER_EQUAL -> {
					val is_num_comp = is_numeric(lt) && is_numeric(rt);
					val is_char_comp = lt.kind == DataType.CHAR && rt.kind == DataType.CHAR;
					if (!is_num_comp && !is_char_comp) report_error(self, node, "Comparison requires numeric or char operands");
					return alloc_primitive(&self.arena, type_bool());
				}
				// 4. Logic (&&, ||)
				TokenType.AND_AND,
				TokenType.OR_OR -> {
					if (lt.kind != DataType.BOOL || rt.kind != DataType.BOOL) {
						report_error(self, node, "Logical operators require bool operands");
					}
					return alloc_primitive(&self.arena, type_bool());
				}
				else -> return lt;
			}
		}
		NodeKind.EXPR_UNARY -> {
			val un = as_unary(node);
			val op_ty = check_expr(self, un.operand);

			when (un.op) {
				TokenType.MINUS -> {
					if (!is_numeric(op_ty)) report_error(self, node, "Unary minus requires numeric operand");
					return op_ty;
				}
				TokenType.BANG -> {
					if (op_ty.kind != DataType.BOOL) report_error(self, node, "Logical NOT requires bool operand");
					return alloc_primitive(&self.arena, type_bool());
				}
				TokenType.STAR -> {
					// Pointer dereference (*ptr)
					if (op_ty.kind != DataType.POINTER) {
						report_error(self, node, "Cannot dereference non-pointer type");
						return op_ty;
					}
					val p_info = sem_pointer(op_ty);
					return p_info.pointee;
				}
				// Take address (&expr)
				TokenType.AMPERSAND -> return alloc_pointer_type(&self.arena, op_ty, true);
				else -> return op_ty;
			}
		}
		NodeKind.EXPR_CALL -> {
			val call = as_call(node) as &CallExpr;

			// Check the static type size query: T.size()
			if (call.callee.kind == NodeKind.EXPR_MEMBER) {
				val mem = as_member(call.callee);
				if (mem.member == "size") {
					// Mangle the type name so the backend emits sizeof(<c_name>).
					if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
						val id = as_identifier(mem.object) as &IdentifierExpr;

						// A primitive type name has no C type of its own (`str`,
						// `bool`, ...), so fold `.size()` to its C size literal.
						val csize = prim_c_size(id.name);
						if (csize > 0) {
							val lit = alloc_literal(&self.arena, LiteralKind.INT, "${csize}UZ", node.line, node.col);
							val lit_n = node as &AstNode;
							lit_n.kind = lit.kind;
							lit_n.data = lit.data;
							return alloc_primitive(&self.arena, type_usz());
						}

						val tsym = lookup(&self.symtab, id.name);
						if (tsym != null && tsym.c_name != id.name) id.name = tsym.c_name;
					}
					return alloc_primitive(&self.arena, type_usz());
				}

				if (mem.member == "slice") {
					val slice_recv = check_expr(self, mem.object);
					if (slice_recv.kind != DataType.STR) report_error(self, node, "slice() requires a str receiver");
					for (arg in call.args) {
						val at = check_expr(self, arg);
						if (!is_integer(at)) report_error(self, node, "slice() bounds must be integers");
					}
					// Lower to kobel_slice(receiver, start, end); end defaults to length.
					var sargs = List<*AstNode>();
					sargs.add(mem.object);
					if (call.args.len >= 1) sargs.add(call.args.get(0));
					else sargs.add(alloc_literal(&self.arena, LiteralKind.INT, "0", node.line, node.col));
					if (call.args.len >= 2) {
						sargs.add(call.args.get(1));
					} else {
						var largs = List<*AstNode>();
						largs.add(mem.object);
						sargs.add(alloc_call(&self.arena, alloc_identifier(&self.arena, "kobel_slen", node.line, node.col), largs, List<*AstNode>(), node.line, node.col));
					}
					val sl_call = alloc_call(&self.arena, alloc_identifier(&self.arena, "kobel_slice", node.line, node.col), sargs, List<*AstNode>(), node.line, node.col);
					val sl_n = node as &AstNode;
					sl_n.kind = NodeKind.EXPR_CALL;
					sl_n.data = sl_call.data;
					return alloc_primitive(&self.arena, type_str());
				}

				// Instance method call: obj.m(args) -> Struct_m(self, args)
				val obj_raw_ty = check_expr(self, mem.object);
				var obj_ty = obj_raw_ty;
				var obj_is_ptr = false;
				if (obj_ty.kind == DataType.POINTER) {
					obj_is_ptr = true;
					obj_ty = sem_pointer(obj_ty).pointee;
				}
				if (obj_ty.kind == DataType.STRUCT) {
					val s_info = sem_struct(obj_ty);
					// Pick the overload whose arity matches; fall back to a name
					// lookup so an arity error still reads as before.
					if (struct_count_method_arity(s_info, mem.member, call.args.len + 1) > 1) {
						report_error(self, node, "Ambiguous call to '${mem.member}': overloading by parameter type is not supported");
					}
					var mi = struct_find_method_arity(s_info, mem.member, call.args.len + 1);
					if (mi == null) mi = struct_find_method(s_info, mem.member);
					if (mi != null) {
						val fn_info = sem_fn(mi.fn_type);
						if (call.args.len + 1 != fn_info.param_types.len) {
							report_error(self, node, "Argument count mismatch in method call '${mem.member}'");
						} else {
							for (i in 0..<call.args.len) {
								val arg_ty = check_expr(self, call.args.get(i));
								val param_ty = fn_info.param_types.get(i + 1);
								if (!can_assign(param_ty, arg_ty)) report_error(self, node, "Argument type mismatch in method call '${mem.member}'");
							}
						}

						// Desugar to a free-function call with the receiver as first argument.
						var new_args = List<*AstNode>();
						if (obj_is_ptr) new_args.add(mem.object);
						else new_args.add(alloc_unary(&self.arena, TokenType.AMPERSAND, mem.object, node.line, node.col));
						for (arg in call.args) new_args.add(arg);
						call.args = new_args;
						call.callee = alloc_identifier(&self.arena, mi.c_name, node.line, node.col);
						return fn_info.return_type;
					}
				}

				// Primitive method: x.m(args) -> <prim>_m(x, args), receiver by value.
				var pmi = find_prim_method_arity(&self.symtab, obj_ty.kind, mem.member, call.args.len + 1);
				if (pmi == null) pmi = find_prim_method(&self.symtab, obj_ty.kind, mem.member);
				if (pmi != null) {
					val fn_info = sem_fn(pmi.fn_type);
					if (call.args.len + 1 != fn_info.param_types.len) {
						report_error(self, node, "Argument count mismatch in method call '${mem.member}'");
					} else {
						for (i in 0..<call.args.len) {
							val arg_ty = check_expr(self, call.args.get(i));
							val param_ty = fn_info.param_types.get(i + 1);
							if (!can_assign(param_ty, arg_ty)) report_error(self, node, "Argument type mismatch in method call '${mem.member}'");
						}
					}

					var new_args = List<*AstNode>();
					if (obj_is_ptr) new_args.add(alloc_unary(&self.arena, TokenType.STAR, mem.object, node.line, node.col));
					else new_args.add(mem.object);
					for (arg in call.args) new_args.add(arg);
					call.args = new_args;
					call.callee = alloc_identifier(&self.arena, pmi.c_name, node.line, node.col);
					return fn_info.return_type;
				}
			}

			// `Self(...)` builds the value directly, so it never consults a
			// `new` factory (that is what keeps `fn new() => Self(...)` from
			// calling itself again).
			var callee_is_self = false;
			if (call.callee.kind == NodeKind.EXPR_IDENTIFIER && as_identifier(call.callee).name == "Self") callee_is_self = true;

			val callee_ty = check_expr(self, call.callee);

			// 1. Function call
			if (callee_ty.kind == DataType.FN) {
				val fn_info = sem_fn(callee_ty);
				if (call.args.len != fn_info.param_types.len) report_error(self, node, "Argument count mismatch in function call");
				else {
					for (i in 0..<call.args.len) {
						val arg_ty = check_expr(self, call.args.get(i));
						val param_ty = fn_info.param_types.get(i);
						if (!can_assign(param_ty, arg_ty)) report_error(self, node, "Argument type mismatch in function call");
					}
				}
				return fn_info.return_type;
			}

			// 2. Struct construction: Point(1, 2)
			if (callee_ty.kind == DataType.STRUCT) {
				val s_info = sem_struct(callee_ty);

				// Kotlin-style construction: `Type(args)` calls the `new`
				// overload of matching arity when one exists; building from
				// fields is only the fallback.
				if (!callee_is_self) {
					if (struct_count_method_arity(s_info, "new", call.args.len) > 1) {
						report_error(self, node, "Ambiguous call to 'new': overloading by parameter type is not supported");
					}
					val nm = struct_find_method_arity(s_info, "new", call.args.len);
					if (nm != null) {
						val n_info = sem_fn(nm.fn_type);
						for (i in 0..<call.args.len) {
							val arg_ty = check_expr(self, call.args.get(i));
							val param_ty = n_info.param_types.get(i);
							if (!can_assign(param_ty, arg_ty)) report_error(self, node, "Argument type mismatch in call to 'new'");
						}
						call.callee = alloc_identifier(&self.arena, nm.c_name, node.line, node.col);
						return n_info.return_type;
					}
				}

				// Field construction is only allowed where the type is declared
				// unless every field is `pub`; otherwise the type must expose a
				// `new` constructor (handled above).
				if (s_info.has_private && s_info.module != self.symtab.current_module) {
					report_error(self, node, "Cannot construct '${s_info.name}' from its fields: they are private to module '${s_info.module}'; add a 'new' constructor");
				}

				if (call.args.len != s_info.fields.len) report_error(self, node, "Argument count mismatch in struct constructor");
				else {
					for (i in 0..<call.args.len) {
						val arg_ty = check_expr(self, call.args.get(i));
						val f_ty = s_info.fields.get(i).type_ptr;
						if (!can_assign(f_ty, arg_ty)) report_error(self, node, "Field type mismatch in struct constructor");
					}
				}
				return callee_ty;
			}

			report_error(self, node, "Callee is not a function or struct");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_MEMBER -> {
			val mem = as_member(node) as &MemberExpr;

			// Enum member access: `NodeKind.EXPR_LITERAL` -> integer constant.
			if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
				val enum_id = as_identifier(mem.object);
				val ei = find_enum_info(&self.symtab, enum_id.name);
				if (ei != null) {
					val mi = enum_find_member(ei, mem.member);
					if (mi == null) {
						report_error(self, node, "Enum '${enum_id.name}' has no member '${mem.member}'");
						return alloc_primitive(&self.arena, type_none());
					}
					// Reuse the node as a plain integer literal for the backend.
					val lit = alloc_literal(&self.arena, LiteralKind.INT, "${mi.value}", node.line, node.col);
					val n = node as &AstNode;
					n.kind = NodeKind.EXPR_LITERAL;
					n.data = lit.data;
					return ei.underlying;
				}
			}

			var obj_ty = check_expr(self, mem.object);

			// Pointer results that are not plain identifiers cannot be recognized
			// by the backend's name-based pointer tracking, so dereference them
			// here: `p.field` becomes `(*p).field`.
			if (obj_ty.kind == DataType.POINTER && mem.object.kind != NodeKind.EXPR_IDENTIFIER) {
				mem.object = alloc_unary(&self.arena, TokenType.STAR, mem.object, node.line, node.col);
			}

			// Automatic pointer unwrapping: p.x when p is *Point or &Point
			var obj_was_ptr = false;
			if (obj_ty.kind == DataType.POINTER) {
				obj_was_ptr = true;
				obj_ty = sem_pointer(obj_ty).pointee;
			}

			// Enum `.value`: identity on the underlying integer. The node is
			// rewritten to the receiver so the backend emits it unchanged.
			if (mem.member == "value" && !obj_was_ptr && is_enum_type(obj_ty)) {
				val n = node as &AstNode;
				n.kind = mem.object.kind;
				n.data = mem.object.data;
				return as_enum_info(obj_ty).underlying;
			}

			if (obj_ty.kind == DataType.STR) {
				if (mem.member == "len" || mem.member == "size") {
					// Lower to a runtime call: the C backend cannot tell that an
					// arbitrary expression has type `str`.
					var len_args = List<*AstNode>();
					len_args.add(mem.object);
					val len_call = alloc_call(&self.arena, alloc_identifier(&self.arena, "kobel_slen", node.line, node.col), len_args, List<*AstNode>(), node.line, node.col);
					val len_n = node as &AstNode;
					len_n.kind = NodeKind.EXPR_CALL;
					len_n.data = len_call.data;
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "cap") {
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "c_str") {
					val char_ty = alloc_primitive(&self.arena, type_char());
					val char_ptr = alloc_pointer_type(&self.arena, char_ty, false);
					return alloc_fn_type(&self.arena, List<*Type>(), char_ptr);
				}
				if (mem.member == "data") {
					// `str` lowers to a bare `const char*`, so `.data` is the
					// pointer itself: rewrite the access to its receiver.
					val char_ty = alloc_primitive(&self.arena, type_char());
					val dn = node as &AstNode;
					dn.kind = mem.object.kind;
					dn.data = mem.object.data;
					return alloc_pointer_type(&self.arena, char_ty, false);
				}
			}

			if (obj_ty.kind == DataType.ARRAY) {
				val arr = sem_array(obj_ty);
				if (mem.member == "len" || mem.member == "size") {
					// The size of a fixed-size array is known at compile time.
					val lit = alloc_literal(&self.arena, LiteralKind.INT, "${arr.length}UZ", node.line, node.col);
					val ln = node as &AstNode;
					ln.kind = lit.kind;
					ln.data = lit.data;
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "data") {
					// A fixed-size array already is a pointer to its first element.
					val dn = node as &AstNode;
					dn.kind = mem.object.kind;
					dn.data = mem.object.data;
					return alloc_pointer_type(&self.arena, arr.elem, true);
				}
			}

			if (obj_ty.kind != DataType.STRUCT) {
				report_error(self, node, "Member access on non-struct type");
				return alloc_primitive(&self.arena, type_none());
			}

			val s_info = sem_struct(obj_ty);
			for (f in s_info.fields) {
				if (f.name != mem.member) continue;
				// A non-pub field is only usable where the type is declared.
				if (!f.is_pub && s_info.module != self.symtab.current_module) {
					report_error(self, node, "Field '${mem.member}' of '${s_info.name}' is private to module '${s_info.module}'");
				}
				return f.type_ptr;
			}

			report_error(self, node, "Struct '${s_info.name}' has no member named '${mem.member}'");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_INDEX -> {
			val idx = as_index(node);
			val target_ty = check_expr(self, idx.target);
			val index_ty = check_expr(self, idx.index);

			if (!is_integer(index_ty)) report_error(self, node, "Index must be integer");

			if (target_ty.kind == DataType.ARRAY) return sem_array(target_ty).elem;
			if (target_ty.kind == DataType.POINTER) return sem_pointer(target_ty).pointee;
			if (target_ty.kind == DataType.STR) return alloc_primitive(&self.arena, type_char());

			report_error(self, node, "Index access on non-indexable type");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_ASSIGN -> {
			val asgn = as_assign(node);
			val target_ty = check_expr(self, asgn.target);
			val val_ty = check_expr(self, asgn.value);

			if (!can_assign(target_ty, val_ty)) report_error(self, node, "Type mismatch in assignment");
			return target_ty;
		}
		NodeKind.EXPR_CAST -> {
			val cst = as_cast(node);
			check_expr(self, cst.expr);
			return resolve_type(self, cst.target_type);
		}
		NodeKind.EXPR_IF -> {
			val if_e = as_if_expr(node);
			val cond_ty = check_expr(self, if_e.condition);
			if (cond_ty.kind != DataType.BOOL) report_error(self, node, "If expression condition must be bool");
			val then_ty = check_expr(self, if_e.then_branch);
			val else_ty = check_expr(self, if_e.else_branch);
			if (!can_assign(then_ty, else_ty)) report_error(self, node, "If expression branches have incompatible types");
			return then_ty;
		}
		NodeKind.EXPR_WHEN -> {
			val we = as_when_expr(node);
			if (we.condition != null) check_expr(self, we.condition);

			var result_ty: *Type = null;
			var has_else = false;
			for (arm in we.arms) {
				if (arm.is_else) has_else = true;
				for (pat in arm.patterns) {
					val p_ty = check_expr(self, pat);
					if (we.condition == null && p_ty.kind != DataType.BOOL) report_error(self, pat, "Boolean when arm condition must be bool");
				}
				val body_ty = check_expr(self, arm.body);
				if (result_ty == null) result_ty = body_ty;
			}

			if (!has_else) {
				report_error(self, node, "when expression requires an 'else' arm");
				return alloc_primitive(&self.arena, type_none());
			}
			if (result_ty == null) return alloc_primitive(&self.arena, type_none());
			return result_ty;
		}
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = as_array_literal(node);

			// The element type comes from the first element; an empty literal
			// has nothing to infer from (use an annotated `[T; 0]` variable).
			if (al.elements.len == 0) {
				report_error(self, node, "Cannot infer the element type of an empty array literal");
				return alloc_primitive(&self.arena, type_none());
			}

			val elem_ty = check_expr(self, al.elements.get(0));
			for (i in 1..<al.elements.len) {
				val t = check_expr(self, al.elements.get(i));
				if (!can_assign(elem_ty, t)) report_error(self, al.elements.get(i), "Array literal element type mismatch");
			}
			return alloc_array_type(&self.arena, elem_ty, al.elements.len);
		}
		NodeKind.EXPR_INTERP -> {
			val ie = as_interp(node);

			// Fold the parts into a `kobel_concat` chain; every hole is checked
			// once and converted to `str` (see interp_piece).
			var acc: *AstNode = null;
			for (part in ie.parts) {
				var piece = part.expr;
				if (!part.is_literal) {
					val pty = check_expr(self, piece);
					piece = interp_piece(self, node, piece, pty);
					if (piece == null) return alloc_primitive(&self.arena, type_str());
				}
				if (acc == null) acc = piece;
				else acc = interp_concat(&self.arena, acc, piece, node.line, node.col);
			}
			if (acc == null) acc = alloc_literal(&self.arena, LiteralKind.STRING, "\"\"", node.line, node.col);

			val in_n = node as &AstNode;
			in_n.kind = acc.kind;
			in_n.data = acc.data;
			return alloc_primitive(&self.arena, type_str());
		}
		else -> return alloc_primitive(&self.arena, type_none());
	}
}

// ============================================================================
// Statement Type Checking
// ============================================================================

pub fn check_statement(var self: &BodyPass, node: *AstNode) {
	if (node == null) return;

	when (node.kind) {
		NodeKind.STMT_BLOCK -> {
			val blk = as_block_stmt(node);
			enter_scope(&self.symtab, false);
			for (stmt in blk.statements) {
				check_statement(self, stmt);
			}
			exit_scope(&self.symtab);
		}
		NodeKind.STMT_VAR_DECL -> {
			val vd = as_var_decl(node) as &VarDeclStmt;
			var var_ty = alloc_primitive(&self.arena, type_none());

			var has_init = false;
			var init_ty = alloc_primitive(&self.arena, type_none());
			if (vd.initializer != null) {
				has_init = true;
				init_ty = check_expr(self, vd.initializer);
			}

			if (vd.type_annotation != null) {
				var_ty = resolve_type(self, vd.type_annotation);
				if (has_init && !can_assign(var_ty, init_ty)) report_error(self, node, "Type mismatch in variable declaration for '${vd.name}'");
			} else {
				// Type inference (deduce the type automatically from the initializer)
				if (has_init) {
					var_ty = init_ty;
				} else {
					report_error(self, node, "Variable '${vd.name}' without type must have initializer");
				}
			}

			// Give an inferred local an explicit type node so the C backend does
			// not have to re-infer it (it cannot see struct field types).
			if (vd.type_annotation == null && has_init) {
				vd.type_annotation = ast_type_from_type(&self.arena, var_ty);
			}

			val ok = define(&self.symtab, Symbol(vd.name, vd.name, SymbolKind.VAR, var_ty, vd.is_mut, false, node.line, node.col));
			if (!ok) report_error(self, node, "Variable '${vd.name}' is already defined in this scope");
		}
		NodeKind.STMT_IF -> {
			val if_s = as_if_stmt(node);
			val cond_ty = check_expr(self, if_s.condition);
			if (cond_ty.kind != DataType.BOOL) report_error(self, node, "If statement condition must be bool");
			check_statement(self, if_s.then_branch);
			if (if_s.else_branch != null) check_statement(self, if_s.else_branch);
		}
		NodeKind.STMT_WHILE -> {
			val wh = as_while_stmt(node);
			val cond_ty = check_expr(self, wh.condition);
			if (cond_ty.kind != DataType.BOOL) report_error(self, node, "While statement condition must be bool");
			self.loop_depth = self.loop_depth + 1;
			check_statement(self, wh.body);
			self.loop_depth = self.loop_depth - 1;
		}
		NodeKind.STMT_FOR -> {
			val fs = as_for_stmt(node) as &ForStmt;
			if (!fs.is_range && !for_is_lvalue(fs.iterable)) {
				report_error(self, node, "The iterated expression of a 'for' must be a variable or a field");
			}
			// Containers that implement `Iterable` are walked through the trait
			// (`count()` / `at(i)`); `str` and arrays keep the `.len` / `.data`
			// lowering (see desugar_for_iterable).
			var use_iter_trait = false;
			if (!fs.is_range) use_iter_trait = struct_implements_iterable(self, for_iterable_type(self, fs.iterable));

			desugar_for(&self.arena, node, fs, use_iter_trait);
			// `node` now holds the lowered block; check it through the normal path.
			check_statement(self, node);
		}
		NodeKind.STMT_RETURN -> {
			val ret = as_return_stmt(node);
			if (ret.value != null) {
				val val_ty = check_expr(self, ret.value);
				if (!can_assign(self.current_fn_return_type, val_ty)) report_error(self, node, "Return value type does not match function return type");
			} else if (self.current_fn_return_type.kind != DataType.NONE) report_error(self, node, "Non-none function must return a value");
		}
		NodeKind.STMT_BREAK, NodeKind.STMT_CONTINUE -> {
			if (self.loop_depth == 0) report_error(self, node, "Break or continue statement outside of loop");
		}
		NodeKind.STMT_EXPR -> {
			val es = as_expr_stmt(node);
			check_expr(self, es.expr);
		}
		NodeKind.STMT_WHEN -> {
			val ws = as_when_stmt(node);
			if (ws.condition != null) check_expr(self, ws.condition);
			for (arm in ws.arms) {
				for (pat in arm.patterns) {
					val p_ty = check_expr(self, pat);
					if (ws.condition == null && p_ty.kind != DataType.BOOL) report_error(self, pat, "Boolean when arm condition must be bool");
				}
				check_statement(self, arm.body);
			}
		}
	}
}

// ============================================================================
// String interpolation lowering
//
// `"a${x}b"` is lowered here into a `kobel_concat` chain; each hole is converted
// to `str` according to its type. Nothing of this reaches the C backend beyond
// calls to the prelude helpers, so codegen needs no new knowledge.
// ============================================================================

// A call to a prelude helper. Left unchecked on purpose: the prelude is emitted
// by codegen and has no symbol table entry.
pub fn interp_call(var arena: &Arena, name: str, arg: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(arg);
	return alloc_call(arena, alloc_identifier(arena, name, line, col), args, List<*AstNode>(), line, col);
}

pub fn interp_concat(var arena: &Arena, a: *AstNode, b: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(a);
	args.add(b);
	return alloc_call(arena, alloc_identifier(arena, "kobel_concat", line, col), args, List<*AstNode>(), line, col);
}

// Converts one interpolation hole to `str`, or reports an error and returns null.
pub fn interp_piece(var self: &BodyPass, node: *AstNode, expr: *AstNode, ty: *Type): *AstNode {
	if (ty.kind == DataType.STR) return expr;

	// Everything else goes through the `ToStr` trait; std.traits.to_str (loaded
	// by the driver) provides the built-in implementations.
	val pmi = find_prim_method(&self.symtab, ty.kind, "to_str");
	if (pmi != null) return interp_call(&self.arena, pmi.c_name, expr, node.line, node.col);

	var cur_ty = ty;
	var is_ptr = false;
	if (cur_ty.kind == DataType.POINTER) {
		is_ptr = true;
		cur_ty = sem_pointer(cur_ty).pointee;
	}
	if (cur_ty.kind == DataType.STRUCT) {
		val st_info = sem_struct(cur_ty);
		val mi = struct_find_method(st_info, "to_str");
		if (mi != null) {
			var arg = expr;
			if (!is_ptr) arg = alloc_unary(&self.arena, TokenType.AMPERSAND, expr, node.line, node.col);
			return interp_call(&self.arena, mi.c_name, arg, node.line, node.col);
		}
	}

	report_error(self, node, "Interpolated value must implement ToStr");
	return null;
}

// ============================================================================
// `for` lowering
//
// `for` is lowered here into plain while-loops plus hidden locals, so the C
// backend never sees STMT_FOR and needs no new type knowledge. The lowering
// deliberately avoids needing the element type: it only uses the uniform
// `.len` / `.data` members that `str`, `[T; N]` and the std containers expose.
//
// Range lowering is overflow safe: the "is there another element?" test is
// evaluated before the counter is moved, and the counter only moves while that
// test holds, so an unsigned counter never wraps below its end bound.
// ============================================================================

// The iterated expression is re-evaluated on every iteration, so only lvalues
// are accepted: a temporary would dangle and a call would run once per element.
pub fn for_is_lvalue(node: *AstNode): bool {
	if (node == null) return false;
	if (node.kind == NodeKind.EXPR_IDENTIFIER) return true;
	if (node.kind == NodeKind.EXPR_MEMBER) return for_is_lvalue(as_member(node).object);
	if (node.kind == NodeKind.EXPR_GROUP) return for_is_lvalue(as_group(node).expr);
	return false;
}

pub fn for_usz_type(var arena: &Arena, line: usz, col: usz): *AstNode =>
	ast_alloc_named(arena, "usz", List<*AstNode>(), line, col);

pub fn for_id(var arena: &Arena, name: str, line: usz, col: usz): *AstNode =>
	alloc_identifier(arena, name, line, col);

pub fn for_num(var arena: &Arena, text: str, line: usz, col: usz): *AstNode =>
	alloc_literal(arena, LiteralKind.INT, text, line, col);

// `__for_i <cmp> __for_e`
pub fn for_i_cmp(var arena: &Arena, op: TokenType, line: usz, col: usz): *AstNode =>
	alloc_binary(arena, op, for_id(arena, "__for_i", line, col), for_id(arena, "__for_e", line, col), line, col);

// `__for_go = <value>;`
pub fn for_set_go(var arena: &Arena, value: *AstNode, line: usz, col: usz): *AstNode =>
	alloc_expr_stmt(arena, alloc_assign(arena, for_id(arena, "__for_go", line, col), value, line, col), line, col);

// `__for_i = __for_i <+|-> 1;`
pub fn for_bump(var arena: &Arena, op: TokenType, line: usz, col: usz): *AstNode =>
	alloc_expr_stmt(
		arena,
		alloc_assign(
			arena,
			for_id(arena, "__for_i", line, col),
			alloc_binary(arena, op, for_id(arena, "__for_i", line, col), for_num(arena, "1", line, col), line, col),
			line, col
		),
		line, col
	);

// `if (__for_up) { <up_stmt> } else { <down_stmt> }`
pub fn for_by_dir(var arena: &Arena, up_stmt: *AstNode, down_stmt: *AstNode, line: usz, col: usz): *AstNode {
	var up_stmts = List<*AstNode>();
	up_stmts.add(up_stmt);
	var down_stmts = List<*AstNode>();
	down_stmts.add(down_stmt);
	return alloc_if_stmt(
		arena,
		for_id(arena, "__for_up", line, col),
		alloc_block_stmt(arena, up_stmts, line, col),
		alloc_block_stmt(arena, down_stmts, line, col),
		line, col
	);
}

// Replaces every `continue` belonging to this loop with `{ <step>; continue; }`
// so `continue` cannot skip the counter update. Bodies of nested loops are left
// alone: their `continue` targets the inner loop.
pub fn for_inject_step(var arena: &Arena, node: *AstNode, step: &List<*AstNode>) {
	if (node == null) return;

	when (node.kind) {
		NodeKind.STMT_BLOCK -> {
			val b = as_block_stmt(node);
			for (stmt in b.statements) {
				for_inject_step(arena, stmt, step);
			}
		}
		NodeKind.STMT_IF -> {
			val s = as_if_stmt(node);
			for_inject_step(arena, s.then_branch, step);
			for_inject_step(arena, s.else_branch, step);
		}
		NodeKind.STMT_WHEN -> {
			val w = as_when_stmt(node);
			for (arm in w.arms) {
				for_inject_step(arena, arm.body, step);
			}
		}
		NodeKind.STMT_CONTINUE -> {
			var stmts = List<*AstNode>();
			for (s in step) stmts.add(s);
			stmts.add(alloc_continue_stmt(arena, node.line, node.col));
			val blk = alloc_block_stmt(arena, stmts, node.line, node.col);
			val n = node as &AstNode;
			n.kind = NodeKind.STMT_BLOCK;
			n.data = blk.data;
		}
		else -> {}
	}
}

// Best-effort static type of a `for` iterable (a variable or a field chain).
// Reports nothing and rewrites nothing, so it is safe to call before the loop
// is lowered and re-checked.
fn for_iterable_type(self: &BodyPass, node: *AstNode): *Type {
	if (node == null) return null;
	if (node.kind == NodeKind.EXPR_GROUP) return for_iterable_type(self, as_group(node).expr);

	if (node.kind == NodeKind.EXPR_IDENTIFIER) {
		val sym = lookup(&self.symtab, as_identifier(node).name);
		if (sym != null) return sym.type_ptr;
		return null;
	}

	if (node.kind == NodeKind.EXPR_MEMBER) {
		val mem = as_member(node);
		var obj = for_iterable_type(self, mem.object);
		if (obj == null) return null;
		if (obj.kind == DataType.POINTER) obj = sem_pointer(obj).pointee;
		if (obj.kind != DataType.STRUCT) return null;
		val s_mem = sem_struct(obj);
		for (f in s_mem.fields) {
			if (f.name == mem.member) return f.type_ptr;
		}
	}
	return null;
}

// Whether the type is a struct with an `impl Iterable for` block. Such a `for`
// iterates through the trait (`count()` / `at(i)`) instead of the built-in
// `.len` / `.data`, so containment no longer has to look like a flat array.
fn struct_implements_iterable(self: &BodyPass, ty: *Type): bool {
	var cur = ty;
	if (cur != null && cur.kind == DataType.POINTER) cur = sem_pointer(cur).pointee;
	if (cur == null || cur.kind != DataType.STRUCT) return false;
	val t = find_trait(&self.symtab, "Iterable");
	if (t == null) return false;
	return trait_has_impl(t, sem_struct(cur).name);
}

// `for (v in seq)` where `seq` implements `Iterable`: index through the trait.
pub fn desugar_for_iter_method(
	var arena: &Arena,
	pre: &List<*AstNode>,
	head: &List<*AstNode>,
	step: &List<*AstNode>,
	fs: *ForStmt,
	line: usz,
	col: usz
): *AstNode {
	// val __for_n: usz = <iterable>.count();
	val count_call = alloc_call(arena, alloc_member(arena, fs.iterable, "count", line, col), List<*AstNode>(), List<*AstNode>(), line, col);
	pre.add(alloc_var_decl(arena, false, "__for_n", for_usz_type(arena, line, col), count_call, line, col));
	// var __for_i: usz = 0;
	pre.add(alloc_var_decl(arena, true, "__for_i", for_usz_type(arena, line, col),
		for_num(arena, "0UZ", line, col), line, col));

	// val <v> = <iterable>.at(__for_i);
	var at_args = List<*AstNode>();
	at_args.add(for_id(arena, "__for_i", line, col));
	val at_call = alloc_call(arena, alloc_member(arena, fs.iterable, "at", line, col), at_args, List<*AstNode>(), line, col);
	head.add(alloc_var_decl(arena, false, fs.var_name, null, at_call, line, col));

	step.add(for_bump(arena, TokenType.PLUS, line, col));

	// __for_i < __for_n
	return alloc_binary(arena, TokenType.LESS, for_id(arena, "__for_i", line, col), for_id(arena, "__for_n", line, col), line, col);
}

// `for (v in <iterable>)`: index over the container's `.data` storage, caching
// `.len` up front (for `str` that also removes a strlen call per iteration).
pub fn desugar_for_iterable(
	var arena: &Arena,
	pre: &List<*AstNode>,
	head: &List<*AstNode>,
	step: &List<*AstNode>,
	fs: *ForStmt,
	line: usz,
	col: usz
): *AstNode {
	// val __for_n: usz = <iterable>.len;
	pre.add(alloc_var_decl(arena, false, "__for_n", for_usz_type(arena, line, col),
		alloc_member(arena, fs.iterable, "len", line, col), line, col));
	// var __for_i: usz = 0;
	pre.add(alloc_var_decl(arena, true, "__for_i", for_usz_type(arena, line, col),
		for_num(arena, "0UZ", line, col), line, col));

	// val <v> = <iterable>.data[__for_i];
	head.add(alloc_var_decl(arena, false, fs.var_name, null,
		alloc_index(arena, alloc_member(arena, fs.iterable, "data", line, col), for_id(arena, "__for_i", line, col), line, col),
		line, col));

	step.add(for_bump(arena, TokenType.PLUS, line, col));

	// __for_i < __for_n
	return alloc_binary(arena, TokenType.LESS, for_id(arena, "__for_i", line, col), for_id(arena, "__for_n", line, col), line, col);
}

// `for (v in a..b)` (closed) / `for (v in a..<b)` (half-open) /
// `for (v in a>..<b)` (open, exclusive ends).
// An unsuffixed end bound gives the counter its type, so `for (i in 0..n)` with
// `n: usz` iterates unsigned while `for (i in 0..10)` stays i32.
pub fn desugar_for_range(
	var arena: &Arena,
	pre: &List<*AstNode>,
	head: &List<*AstNode>,
	step: &List<*AstNode>,
	fs: *ForStmt,
	line: usz,
	col: usz
): *AstNode {
	// val __for_e = <end>;
	pre.add(alloc_var_decl(arena, false, "__for_e", null, fs.range_end, line, col));
	// var __for_i = __for_e;  then __for_i = <start>; -- the initializer only
	// exists to give the counter the bound's type.
	pre.add(alloc_var_decl(arena, true, "__for_i", null, for_id(arena, "__for_e", line, col), line, col));
	pre.add(alloc_expr_stmt(arena, alloc_assign(arena, for_id(arena, "__for_i", line, col), fs.range_start, line, col), line, col));
	// val __for_up = __for_i <= __for_e;
	pre.add(alloc_var_decl(arena, false, "__for_up", null, for_i_cmp(arena, TokenType.LESS_EQUAL, line, col), line, col));

	if (fs.is_open) {
		// Open range: skip the written start endpoint.
		pre.add(for_by_dir(arena, for_bump(arena, TokenType.PLUS, line, col), for_bump(arena, TokenType.MINUS, line, col), line, col));
	}

	// var __for_go = false;  then the direction-dependent entry test.
	pre.add(alloc_var_decl(arena, true, "__for_go", null, alloc_literal(arena, LiteralKind.BOOL, "false", line, col), line, col));
	if (fs.is_open || fs.is_half_open) {
		pre.add(for_by_dir(arena,
			for_set_go(arena, for_i_cmp(arena, TokenType.LESS, line, col), line, col),
			for_set_go(arena, for_i_cmp(arena, TokenType.GREATER, line, col), line, col),
			line, col));
	} else {
		pre.add(for_by_dir(arena,
			for_set_go(arena, for_i_cmp(arena, TokenType.LESS_EQUAL, line, col), line, col),
			for_set_go(arena, for_i_cmp(arena, TokenType.GREATER_EQUAL, line, col), line, col),
			line, col));
	}

	// val <v> = __for_i;
	head.add(alloc_var_decl(arena, false, fs.var_name, null, for_id(arena, "__for_i", line, col), line, col));

	// Is there another element? Then move the counter (never past the end).
	if (fs.is_open || fs.is_half_open) {
		step.add(for_by_dir(arena,
			for_set_go(arena, alloc_binary(arena, TokenType.LESS,
				alloc_binary(arena, TokenType.PLUS, for_id(arena, "__for_i", line, col), for_num(arena, "1", line, col), line, col),
				for_id(arena, "__for_e", line, col), line, col), line, col),
			for_set_go(arena, alloc_binary(arena, TokenType.GREATER,
				alloc_binary(arena, TokenType.MINUS, for_id(arena, "__for_i", line, col), for_num(arena, "1", line, col), line, col),
				for_id(arena, "__for_e", line, col), line, col), line, col),
			line, col));
	} else {
		step.add(for_by_dir(arena,
			for_set_go(arena, for_i_cmp(arena, TokenType.LESS, line, col), line, col),
			for_set_go(arena, for_i_cmp(arena, TokenType.GREATER, line, col), line, col),
			line, col));
	}
	step.add(alloc_if_stmt(arena, for_id(arena, "__for_go", line, col),
		for_by_dir(arena, for_bump(arena, TokenType.PLUS, line, col), for_bump(arena, TokenType.MINUS, line, col), line, col),
		null, line, col));

	return for_id(arena, "__for_go", line, col);
}

// Lowers `node` (a STMT_FOR) in place into a block holding hidden locals plus a
// while-loop, so every later pass sees an ordinary block.
pub fn desugar_for(var arena: &Arena, node: *AstNode, fs: *ForStmt, use_iter_trait: bool) {
	val line = node.line;
	val col = node.col;

	var pre = List<*AstNode>();
	var head = List<*AstNode>();
	var step = List<*AstNode>();
	var cond: *AstNode = null;

	if (fs.is_range) cond = desugar_for_range(arena, &pre, &head, &step, fs, line, col);
	else if (use_iter_trait) cond = desugar_for_iter_method(arena, &pre, &head, &step, fs, line, col);
	else cond = desugar_for_iterable(arena, &pre, &head, &step, fs, line, col);

	// Body: loop variable, the original statements, then the counter update.
	var body_stmts = List<*AstNode>();
	for (s in head) body_stmts.add(s);
	if (fs.body != null) {
		if (fs.body.kind == NodeKind.STMT_BLOCK) {
			val b = as_block_stmt(fs.body);
	for (s in b.statements) body_stmts.add(s);
		} else body_stmts.add(fs.body);
	}
	for (s in step) body_stmts.add(s);

	// A `continue` inside the body must still advance the counter.
	for_inject_step(arena, fs.body, &step);

	pre.add(alloc_while_stmt(arena, cond, alloc_block_stmt(arena, body_stmts, line, col), line, col));

	val blk = alloc_block_stmt(arena, pre, line, col);
	val n = node as &AstNode;
	n.kind = NodeKind.STMT_BLOCK;
	n.data = blk.data;
}

// Builds an AST type node for a resolved semantic type, so locals can carry an
// explicit annotation the C backend understands.
pub fn ast_type_from_type(var arena: &Arena, ty: *Type): *AstNode {
	if (is_enum_type(ty)) return ast_alloc_named(arena, as_enum_info(ty).c_name, List<*AstNode>(), 0, 0);

	when (ty.kind) {
		DataType.POINTER -> {
			val pt = sem_pointer(ty);
			return ast_alloc_pointer(arena, pt.is_mut, ast_type_from_type(arena, pt.pointee), 0, 0);
		}
		DataType.ARRAY -> {
			val at = sem_array(ty);
			return ast_alloc_array(arena, ast_type_from_type(arena, at.elem), at.length, 0, 0);
		}
		DataType.STRUCT -> {
			val st_info = sem_struct(ty);
			var st_name = st_info.name;
			if (st_info.c_name.len > 0) st_name = st_info.c_name;
			return ast_alloc_named(arena, st_name, List<*AstNode>(), 0, 0);
		}
		DataType.NONE -> return ast_alloc_named(arena, "none", List<*AstNode>(), 0, 0);
		DataType.STR -> return ast_alloc_named(arena, "str", List<*AstNode>(), 0, 0);
		DataType.BOOL -> return ast_alloc_named(arena, "bool", List<*AstNode>(), 0, 0);
		DataType.CHAR -> return ast_alloc_named(arena, "char", List<*AstNode>(), 0, 0);
		DataType.I8 -> return ast_alloc_named(arena, "i8", List<*AstNode>(), 0, 0);
		DataType.I16 -> return ast_alloc_named(arena, "i16", List<*AstNode>(), 0, 0);
		DataType.I32 -> return ast_alloc_named(arena, "i32", List<*AstNode>(), 0, 0);
		DataType.I64 -> return ast_alloc_named(arena, "i64", List<*AstNode>(), 0, 0);
		DataType.ISZ -> return ast_alloc_named(arena, "isz", List<*AstNode>(), 0, 0);
		DataType.U8 -> return ast_alloc_named(arena, "u8", List<*AstNode>(), 0, 0);
		DataType.U16 -> return ast_alloc_named(arena, "u16", List<*AstNode>(), 0, 0);
		DataType.U32 -> return ast_alloc_named(arena, "u32", List<*AstNode>(), 0, 0);
		DataType.U64 -> return ast_alloc_named(arena, "u64", List<*AstNode>(), 0, 0);
		DataType.USZ -> return ast_alloc_named(arena, "usz", List<*AstNode>(), 0, 0);
		DataType.F32 -> return ast_alloc_named(arena, "f32", List<*AstNode>(), 0, 0);
		DataType.F64 -> return ast_alloc_named(arena, "f64", List<*AstNode>(), 0, 0);
		else -> return null;
	}
}

// Builds `kobel_streq(a, b)`, optionally negated, for str equality.
pub fn make_str_eq(var arena: &Arena, is_neq: bool, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode {
	var eargs = List<*AstNode>();
	eargs.add(left);
	eargs.add(right);
	val eq_call = alloc_call(arena, alloc_identifier(arena, "kobel_streq", line, col), eargs, List<*AstNode>(), line, col);
	if (is_neq) return alloc_unary(arena, TokenType.BANG, eq_call, line, col);
	return eq_call;
}

// Renders a signed enum value as decimal text for a synthesized int literal.
