mod compiler.sema.body_pass;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.ast.builder.to;
use compiler.ast.builder.AstBuilder;

use compiler.lexer.token.*;

use compiler.sema.types.*;

// Disambiguate semantic-type accessors (builder.kb declares AST-named twins).
use compiler.sema.types.as_pointer_type as sem_pointer;
use compiler.sema.types.as_array_type as sem_array;
use compiler.sema.types.as_struct_type as sem_struct;
use compiler.sema.types.as_fn_type as sem_fn;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;
use compiler.sema.desugar_for.*;

use std.collections.list.*;
use std.mem.arena.*;
use util.strutil.*;

// ============================================================================
// BodyPass - Type Checker & Body Analyzer
// ============================================================================

pub struct BodyPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_fn_return_type: *Type,
	pub loop_depth: usz,
	pub errors: List<str>,
	// Type being implemented, so `Self` resolves inside an `impl` body.
	pub current_self_type: *Type,
	// true when SymbolTable is preloaded from outside (multiple modules)
	pub has_symtab: bool,
	pub builder: AstBuilder,
	pub when_depth: usz
}

impl BodyPass {
	pub fn new(): BodyPass {
		var arena = Arena(65536);
		var decl_p = DeclPass();
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(decl_p.symtab, arena, none_ty, 0, List<str>(), null, false, AstBuilder(null), 0UZ);
	}

	pub fn new(symtab: SymbolTable): BodyPass {
		var arena = Arena(65536);
		val none_ty = alloc_primitive(&arena, type_none());
		return Self(symtab, arena, none_ty, 0, List<str>(), null, true, AstBuilder(null), 0UZ);
	}

	pub fn b(var self): &AstBuilder {
		self.builder.arena = &self.arena;
		return &self.builder;
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		// Prefix the module name (if any) so we know which module an error is in for multi-module builds
		var loc: str = "";
		if (node != null) loc = "Line ${node.line}, Column ${node.col}: ${msg}";
		else loc = msg;

		if (self.symtab.current_module.len > 0) {
			self.errors.add("${self.symtab.current_module}: ${loc}");
		} else self.errors.add(loc);
	}

	pub fn resolve_type(var self, node: *AstNode): *Type {
		var decl_p = DeclPass(
			self.symtab, self.arena, self.symtab.current_module,
			self.errors, false, self.current_self_type, AstBuilder(null)
		);

		val ty = decl_p.resolve_ast_type(node);
		self.arena = decl_p.arena;
		self.errors = decl_p.errors;
		return ty;
	}
}

// C size (in bytes) of a primitive type name, or 0 when `name` is not one.
// Mirrors `ast_type_size`: `str` is a C pointer, not the 16-byte slice value,
// so an array of `str` has pointer stride.
fn prim_c_size(name: str): usz => when (name) {
	"bool", "char", "i8", "u8" -> 1;
	"i16", "u16" -> 2;
	"i32", "u32", "f32" -> 4;
	"i64", "u64", "isz", "usz", "f64" -> 8;
	else -> 0;
};

pub fn int_literal_type(var arena: &Arena, raw: str): *Type {
	val len = raw.len;
	if (len >= 2) {
		val last = raw[len - 1];
		val prev = raw[len - 2];
		if (prev == 'U' && last == 'B') return alloc_primitive(arena, type_u8());
		if (prev == 'U' && last == 'S') return alloc_primitive(arena, type_u16());
		if (prev == 'U' && last == 'L') return alloc_primitive(arena, type_u64());
		if (prev == 'U' && last == 'Z') return alloc_primitive(arena, type_usz());
	}

	if (len >= 1) {
		val last = raw[len - 1];
		if (last == 'U') return alloc_primitive(arena, type_u32());
		if (last == 'L') return alloc_primitive(arena, type_i64());
		if (last == 'S') return alloc_primitive(arena, type_i16());
		if (last == 'Z') return alloc_primitive(arena, type_isz());
		if (last == 'B') return alloc_primitive(arena, type_i8());
	}

	return alloc_primitive(arena, type_i32());
}

pub fn is_list_type(ty: *Type): bool {
	if (ty == null || ty.kind != DataType.STRUCT) return false;
	val s = sem_struct(ty);
	if (s.module != "std.collections.list") return false;
	return str_starts_with(s.name, "std__collections__list__List") || str_starts_with(s.c_name, "std__collections__list__List");
}

impl BodyPass {

pub fn coerce_to_list(var self, node: *AstNode, list_ty: *Type) {
	if (node == null || list_ty == null) return;
	when (node.kind) {
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = node.to<ArrayLiteralExpr>() as &ArrayLiteralExpr;
			val s = sem_struct(list_ty);
			al.list_struct_name = s.c_name;

			if (s.fields.is_empty()) return;
			val f0 = s.fields.first();
			if (f0.type_ptr.kind != DataType.POINTER) return;
			val elem_ty = sem_pointer(f0.type_ptr).pointee;
			al.elem_type_node = ast_type_from_type(&self.arena, elem_ty);

			for (i in 0..<al.elements.len) {
				val el = al.elements[i];
				if (is_list_type(elem_ty)) {
					self.coerce_to_list(el, elem_ty);
				}
				val el_ty = self.check_expr(el);
				if (!can_assign(elem_ty, el_ty)) {
					self.report_error(el, "Element type mismatch in List literal");
				}
			}
		}
		NodeKind.EXPR_IF -> {
			val ife = node.to<IfExpr>();
			self.coerce_to_list(ife.then_branch, list_ty);
			self.coerce_to_list(ife.else_branch, list_ty);
		}
		NodeKind.EXPR_GROUP -> {
			val grp = node.to<GroupExpr>();
			self.coerce_to_list(grp.expr, list_ty);
		}
		NodeKind.EXPR_WHEN -> {
			val we = node.to<WhenExpr>();
			for (arm in we.arms) {
				self.coerce_to_list(arm.body, list_ty);
			}
		}
		else -> {}
	}
}

// ============================================================================
// Expression Type Checking
// ============================================================================

pub fn check_expr(var self, node: *AstNode): *Type {
	if (node == null) return alloc_primitive(&self.arena, type_none());

	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val lit = node.to<LiteralExpr>();
			when (lit.literal_kind) {
				LiteralKind.INT -> return int_literal_type(&self.arena, lit.raw_text);
				LiteralKind.FLOAT -> return alloc_primitive(&self.arena, type_f64());
				LiteralKind.BOOL -> return alloc_primitive(&self.arena, type_bool());
				LiteralKind.STRING -> return alloc_primitive(&self.arena, type_str());
				LiteralKind.CHAR -> return alloc_primitive(&self.arena, type_char());
				LiteralKind.NULL_VAL -> {
					val none_ty = alloc_primitive(&self.arena, type_none());
					return alloc_pointer_type(&self.arena, none_ty, false);
				}
				else -> return alloc_primitive(&self.arena, type_none());
			}
		}
		NodeKind.EXPR_IDENTIFIER -> {
			val id = node.to<IdentifierExpr>() as &IdentifierExpr;

			// `Self` names the type being implemented. Renaming it to the C
			// name lets `Self(...)` build a value directly (no `new` factory).
			if (id.name == "Self" && self.current_self_type != null) {
				id.name = sem_struct(self.current_self_type).c_name;
				return self.current_self_type;
			}

			val sym = lookup(&self.symtab, id.name);
			if (sym == null) {
				self.report_error(node, "Undeclared identifier '${id.name}'");
				return alloc_primitive(&self.arena, type_none());
			}
			// Switch to the mangled C name (import alias, symbol from another module)
			if (sym.c_name != "" && sym.c_name != id.name) id.name = sym.c_name;
			return sym.type_ptr;
		}
		NodeKind.EXPR_GROUP -> {
			val grp = node.to<GroupExpr>();
			return self.check_expr(grp.expr);
		}
		NodeKind.EXPR_BINARY -> {
			val bin = node.to<BinaryExpr>();
			if (bin.op == TokenType.QUESTION_COLON) {
				val lt = self.check_expr(bin.left);
				if (lt.kind != DataType.POINTER && lt.kind != DataType.STR) {
					self.report_error(bin.left, "Left-hand side of Elvis operator '?:' must be a pointer or string");
				}
				val is_jump = bin.right.kind == NodeKind.STMT_RETURN ||
					bin.right.kind == NodeKind.STMT_BREAK ||
					bin.right.kind == NodeKind.STMT_CONTINUE;

				if (is_jump) {
					self.check_statement(bin.right);
				} else {
					val rt = self.check_expr(bin.right);
					if (!can_assign(lt, rt)) {
						self.report_error(bin.right, "Right-hand side of Elvis operator '?:' has incompatible type");
					}
				}

				if (lt.kind == DataType.POINTER) {
					val pt = sem_pointer(lt);
					if (pt.is_nullable) {
						return alloc_pointer_type(&self.arena, pt.pointee, pt.is_mut);
					}
				}
				return lt;
			}

			val lt = self.check_expr(bin.left);
			val rt = self.check_expr(bin.right);

			// 1. Arithmetic operators (+, -, *, /, %)
			when (bin.op) {
				TokenType.PLUS, TokenType.MINUS, TokenType.STAR,
				TokenType.SLASH, TokenType.PERCENT -> {
					if (bin.op == TokenType.PLUS && lt.kind == DataType.STR) {
						// Rewrite `str + str` into a runtime concat call so the C
						// backend does not emit pointer arithmetic.
						var cat_args = List<*AstNode>();
						cat_args.add(bin.left);
						cat_args.add(bin.right);
						val cat_call = self.b().call(self.b().identifier("kobel_concat", node.line, node.col), cat_args, List<*AstNode>(), node.line, node.col);
						val cat_n = node as &AstNode;
						cat_n.kind = NodeKind.EXPR_CALL;
						cat_n.data = cat_call.data;
						return alloc_primitive(&self.arena, type_str());
					}
					if (is_numeric(lt) && is_numeric(rt)) return lt;
					self.report_error(node, "Arithmetic operator not supported for these types");
					return lt;
				}
				// 2. Equality comparison (==, !=)
				TokenType.EQUAL_EQUAL,
				TokenType.BANG_EQUAL -> {
					if (lt.kind == DataType.STR && rt.kind == DataType.STR) {
						// Content comparison instead of C pointer comparison.
						val wrapped = make_str_eq(&self.arena, bin.op == TokenType.BANG_EQUAL, bin.left, bin.right, node.line, node.col);
						val eq_n = node as &AstNode;
						eq_n.kind = wrapped.kind;
						eq_n.data = wrapped.data;
						return alloc_primitive(&self.arena, type_bool());
					}
					if (!can_assign(lt, rt) && !can_assign(rt, lt)) self.report_error(node, "Cannot compare different types");
					return alloc_primitive(&self.arena, type_bool());
				}
				// 3. Ordering comparison (<, <=, >, >=)
				TokenType.LESS, TokenType.LESS_EQUAL,
				TokenType.GREATER, TokenType.GREATER_EQUAL -> {
					val is_num_comp = is_numeric(lt) && is_numeric(rt);
					val is_char_comp = lt.kind == DataType.CHAR && rt.kind == DataType.CHAR;
					if (!is_num_comp && !is_char_comp) self.report_error(node, "Comparison requires numeric or char operands");
					return alloc_primitive(&self.arena, type_bool());
				}
				// 4. Logic (&&, ||)
				TokenType.AND_AND,
				TokenType.OR_OR -> {
					if (lt.kind != DataType.BOOL || rt.kind != DataType.BOOL) {
						self.report_error(node, "Logical operators require bool operands");
					}
					return alloc_primitive(&self.arena, type_bool());
				}
				else -> return lt;
			}
		}
		NodeKind.EXPR_UNARY -> {
			val un = node.to<UnaryExpr>();
			val op_ty = self.check_expr(un.operand);

			when (un.op) {
				TokenType.MINUS -> {
					if (!is_numeric(op_ty)) self.report_error(node, "Unary minus requires numeric operand");
					return op_ty;
				}
				TokenType.BANG -> {
					if (op_ty.kind != DataType.BOOL) self.report_error(node, "Logical NOT requires bool operand");
					return alloc_primitive(&self.arena, type_bool());
				}
				TokenType.STAR -> {
					// Pointer dereference (*ptr)
					if (op_ty.kind != DataType.POINTER) {
						self.report_error(node, "Cannot dereference non-pointer type");
						return op_ty;
					}
					val p_info = sem_pointer(op_ty);
					return p_info.pointee;
				}
				// Take address (&expr)
				TokenType.AMPERSAND -> return alloc_pointer_type(&self.arena, op_ty, true);
				else -> return op_ty;
			}
		}
		NodeKind.EXPR_CALL -> {
			val call = node.to<CallExpr>() as &CallExpr;

			// Check the static type size query: T.size()
			if (call.callee.kind == NodeKind.EXPR_MEMBER) {
				val mem = call.callee.to<MemberExpr>();
				if (mem.member == "size") {
					// Mangle the type name so the backend emits sizeof(<c_name>).
					if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
						val id = mem.object.to<IdentifierExpr>() as &IdentifierExpr;

						// A primitive type name has no C type of its own (`str`,
						// `bool`, ...), so fold `.size()` to its C size literal.
						val csize = prim_c_size(id.name);
						if (csize > 0) {
							val lit = self.b().literal(LiteralKind.INT, "${csize}UZ", node.line, node.col);
							val lit_n = node as &AstNode;
							lit_n.kind = lit.kind;
							lit_n.data = lit.data;
							return alloc_primitive(&self.arena, type_usz());
						}

						val tsym = lookup(&self.symtab, id.name);
						if (tsym != null && tsym.c_name != id.name) id.name = tsym.c_name;
					}
					return alloc_primitive(&self.arena, type_usz());
				}

				if (mem.member == "slice") {
					val slice_recv = self.check_expr(mem.object);
					if (slice_recv.kind != DataType.STR) self.report_error(node, "slice() requires a str receiver");
					for (arg in call.args) {
						val at = self.check_expr(arg);
						if (!is_integer(at)) self.report_error(node, "slice() bounds must be integers");
					}
					// Lower to kobel_slice(receiver, start, end); end defaults to length.
					var sargs = List<*AstNode>();
					sargs.add(mem.object);
					if (!call.args.is_empty()) sargs.add(call.args.first());
					else sargs.add(self.b().literal(LiteralKind.INT, "0", node.line, node.col));
					if (call.args.len >= 2) {
						sargs.add(call.args[1]);
					} else {
						var largs = List<*AstNode>();
						largs.add(mem.object);
						sargs.add(self.b().call(self.b().identifier("kobel_slen", node.line, node.col), largs, List<*AstNode>(), node.line, node.col));
					}
					val sl_call = self.b().call(self.b().identifier("kobel_slice", node.line, node.col), sargs, List<*AstNode>(), node.line, node.col);
					val sl_n = node as &AstNode;
					sl_n.kind = NodeKind.EXPR_CALL;
					sl_n.data = sl_call.data;
					return alloc_primitive(&self.arena, type_str());
				}

				// Instance method call: obj.m(args) -> Struct_m(self, args)
				val obj_raw_ty = self.check_expr(mem.object);
				var obj_ty = obj_raw_ty;
				var obj_is_ptr = false;
				if (obj_ty.kind == DataType.POINTER) {
					obj_is_ptr = true;
					obj_ty = sem_pointer(obj_ty).pointee;
				}
				if (obj_ty.kind == DataType.STRUCT) {
					val s_info = sem_struct(obj_ty);
					// Pick the overload whose arity matches; fall back to a name
					// lookup so an arity error still reads as before.
					if (struct_count_method_arity(s_info, mem.member, call.args.len + 1) > 1) {
						self.report_error(node, "Ambiguous call to '${mem.member}': overloading by parameter type is not supported");
					}
					var mi = struct_find_method_arity(s_info, mem.member, call.args.len + 1);
					if (mi == null) mi = struct_find_method(s_info, mem.member);
					if (mi != null) {
						val fn_info = sem_fn(mi.fn_type);
						if (call.args.len + 1 != fn_info.param_types.len) {
							self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
						} else {
							for (i in 0..<call.args.len) {
								val param_ty = fn_info.param_types[i + 1];
								val arg_n = call.args[i];
								if (is_list_type(param_ty)) self.coerce_to_list(arg_n, param_ty);
								val arg_ty = self.check_expr(arg_n);
								if (!can_assign(param_ty, arg_ty)) self.report_error(node, "Argument type mismatch in method call '${mem.member}'");
							}
						}

						// Desugar to a free-function call with the receiver as first argument.
						var new_args = List<*AstNode>();
						if (obj_is_ptr) new_args.add(mem.object);
						else new_args.add(self.b().unary(TokenType.AMPERSAND, mem.object, node.line, node.col));
						for (arg in call.args) new_args.add(arg);
						call.args = new_args;
						call.callee = self.b().identifier(mi.c_name, node.line, node.col);
						return fn_info.return_type;
					}
				}

				// Primitive method: x.m(args) -> <prim>_m(x, args), receiver by value.
				var pmi = find_prim_method_arity(&self.symtab, obj_ty.kind, mem.member, call.args.len + 1);
				if (pmi == null) pmi = find_prim_method(&self.symtab, obj_ty.kind, mem.member);
				if (pmi != null) {
					val fn_info = sem_fn(pmi.fn_type);
					if (call.args.len + 1 != fn_info.param_types.len) {
						self.report_error(node, "Argument count mismatch in method call '${mem.member}'");
					} else {
						for (i in 0..<call.args.len) {
							val param_ty = fn_info.param_types[i + 1];
							val arg_n = call.args[i];
							if (is_list_type(param_ty)) self.coerce_to_list(arg_n, param_ty);
							val arg_ty = self.check_expr(arg_n);
							if (!can_assign(param_ty, arg_ty)) self.report_error(node, "Argument type mismatch in method call '${mem.member}'");
						}
					}

					var new_args = List<*AstNode>();
					if (obj_is_ptr) new_args.add(self.b().unary(TokenType.STAR, mem.object, node.line, node.col));
					else new_args.add(mem.object);
					for (arg in call.args) new_args.add(arg);
					call.args = new_args;
					call.callee = self.b().identifier(pmi.c_name, node.line, node.col);
					return fn_info.return_type;
				}
			}

			// `Self(...)` builds the value directly, so it never consults a
			// `new` factory (that is what keeps `fn new() => Self(...)` from
			// calling itself again).
			var callee_is_self = false;
			if (call.callee.kind == NodeKind.EXPR_IDENTIFIER && call.callee.to<IdentifierExpr>().name == "Self") callee_is_self = true;

			val callee_ty = self.check_expr(call.callee);

			// 1. Function call
			if (callee_ty.kind == DataType.FN) {
				val fn_info = sem_fn(callee_ty);
				if (call.args.len != fn_info.param_types.len) self.report_error(node, "Argument count mismatch in function call");
				else {
					for (i in 0..<call.args.len) {
						val param_ty = fn_info.param_types[i];
						val arg_n = call.args[i];
						if (is_list_type(param_ty)) self.coerce_to_list(arg_n, param_ty);
						val arg_ty = self.check_expr(arg_n);
						if (!can_assign(param_ty, arg_ty)) self.report_error(node, "Argument type mismatch in function call");
					}
				}
				return fn_info.return_type;
			}

			// 2. Struct construction: Point(1, 2)
			if (callee_ty.kind == DataType.STRUCT) {
				val s_info = sem_struct(callee_ty);

				// Kotlin-style construction: `Type(args)` calls the `new`
				// overload of matching arity when one exists; building from
				// fields is only the fallback.
				if (!callee_is_self) {
					if (struct_count_method_arity(s_info, "new", call.args.len) > 1) {
						self.report_error(node, "Ambiguous call to 'new': overloading by parameter type is not supported");
					}
					val nm = struct_find_method_arity(s_info, "new", call.args.len);
					if (nm != null) {
						val n_info = sem_fn(nm.fn_type);
						for (i in 0..<call.args.len) {
							val param_ty = n_info.param_types[i];
							val arg_n = call.args[i];
							if (is_list_type(param_ty)) self.coerce_to_list(arg_n, param_ty);
							val arg_ty = self.check_expr(arg_n);
							if (!can_assign(param_ty, arg_ty)) self.report_error(node, "Argument type mismatch in call to 'new'");
						}
						call.callee = self.b().identifier(nm.c_name, node.line, node.col);
						return n_info.return_type;
					}
				}

				// Field construction is only allowed where the type is declared
				// unless every field is `pub`; otherwise the type must expose a
				// `new` constructor (handled above).
				if (s_info.has_private && s_info.module != self.symtab.current_module) {
					self.report_error(node, "Cannot construct '${s_info.name}' from its fields: they are private to module '${s_info.module}'; add a 'new' constructor");
				}

				if (call.args.len != s_info.fields.len) self.report_error(node, "Argument count mismatch in struct constructor");
				else {
					for (i in 0..<call.args.len) {
						val f_ty = s_info.fields[i].type_ptr;
						val arg_n = call.args[i];
						if (is_list_type(f_ty)) self.coerce_to_list(arg_n, f_ty);
						val arg_ty = self.check_expr(arg_n);
						if (!can_assign(f_ty, arg_ty)) self.report_error(node, "Field type mismatch in struct constructor");
					}
				}
				return callee_ty;
			}

			self.report_error(node, "Callee is not a function or struct");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_MEMBER -> {
			val mem = node.to<MemberExpr>() as &MemberExpr;

			// Enum member access: `NodeKind.EXPR_LITERAL` -> integer constant.
			if (mem.object.kind == NodeKind.EXPR_IDENTIFIER) {
				val enum_id = mem.object.to<IdentifierExpr>();
				val ei = find_enum_info(&self.symtab, enum_id.name);
				if (ei != null) {
					val mi = enum_find_member(ei, mem.member);
					if (mi == null) {
						self.report_error(node, "Enum '${enum_id.name}' has no member '${mem.member}'");
						return alloc_primitive(&self.arena, type_none());
					}
					// Reuse the node as a plain integer literal for the backend.
					val lit = self.b().literal(LiteralKind.INT, "${mi.value}", node.line, node.col);
					val n = node as &AstNode;
					n.kind = NodeKind.EXPR_LITERAL;
					n.data = lit.data;
					return ei.underlying;
				}
			}

			var obj_ty = self.check_expr(mem.object);

			// Pointer results that are not plain identifiers cannot be recognized
			// by the backend's name-based pointer tracking, so dereference them
			// here: `p.field` becomes `(*p).field`.
			if (obj_ty.kind == DataType.POINTER && mem.object.kind != NodeKind.EXPR_IDENTIFIER) {
				mem.object = self.b().unary(TokenType.STAR, mem.object, node.line, node.col);
			}

			// Automatic pointer unwrapping: p.x when p is *Point or &Point
			var obj_was_ptr = false;
			if (obj_ty.kind == DataType.POINTER) {
				obj_was_ptr = true;
				obj_ty = sem_pointer(obj_ty).pointee;
			}

			// Enum `.value`: identity on the underlying integer. The node is
			// rewritten to the receiver so the backend emits it unchanged.
			if (mem.member == "value" && !obj_was_ptr && is_enum_type(obj_ty)) {
				val n = node as &AstNode;
				n.kind = mem.object.kind;
				n.data = mem.object.data;
				return as_enum_info(obj_ty).underlying;
			}

			if (obj_ty.kind == DataType.STR) {
				if (mem.member == "len" || mem.member == "size") {
					// Lower to a runtime call: the C backend cannot tell that an
					// arbitrary expression has type `str`.
					var len_args = List<*AstNode>();
					len_args.add(mem.object);
					val len_call = self.b().call(self.b().identifier("kobel_slen", node.line, node.col), len_args, List<*AstNode>(), node.line, node.col);
					val len_n = node as &AstNode;
					len_n.kind = NodeKind.EXPR_CALL;
					len_n.data = len_call.data;
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "cap") {
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "c_str") {
					val char_ty = alloc_primitive(&self.arena, type_char());
					val char_ptr = alloc_pointer_type(&self.arena, char_ty, false);
					return alloc_fn_type(&self.arena, List<*Type>(), char_ptr);
				}
				if (mem.member == "data") {
					// `str` lowers to a bare `const char*`, so `.data` is the
					// pointer itself: rewrite the access to its receiver.
					val char_ty = alloc_primitive(&self.arena, type_char());
					val dn = node as &AstNode;
					dn.kind = mem.object.kind;
					dn.data = mem.object.data;
					return alloc_pointer_type(&self.arena, char_ty, false);
				}
			}

			if (obj_ty.kind == DataType.ARRAY) {
				val arr = sem_array(obj_ty);
				if (mem.member == "len" || mem.member == "size") {
					// The size of a fixed-size array is known at compile time.
					val lit = self.b().literal(LiteralKind.INT, "${arr.length}UZ", node.line, node.col);
					val ln = node as &AstNode;
					ln.kind = lit.kind;
					ln.data = lit.data;
					return alloc_primitive(&self.arena, type_usz());
				}
				if (mem.member == "data") {
					// A fixed-size array already is a pointer to its first element.
					val dn = node as &AstNode;
					dn.kind = mem.object.kind;
					dn.data = mem.object.data;
					return alloc_pointer_type(&self.arena, arr.elem, true);
				}
			}

			if (obj_ty.kind != DataType.STRUCT) {
				self.report_error(node, "Member access on non-struct type");
				return alloc_primitive(&self.arena, type_none());
			}

			val s_info = sem_struct(obj_ty);
			for (f in s_info.fields) {
				if (f.name != mem.member) continue;
				// A non-pub field is only usable where the type is declared.
				if (!f.is_pub && s_info.module != self.symtab.current_module) {
					self.report_error(node, "Field '${mem.member}' of '${s_info.name}' is private to module '${s_info.module}'");
				}
				return f.type_ptr;
			}

			self.report_error(node, "Struct '${s_info.name}' has no member named '${mem.member}'");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_INDEX -> {
			val idx = node.to<IndexExpr>();
			val target_ty = self.check_expr(idx.target);
			val index_ty = self.check_expr(idx.index);

			// 1. Raw array [T; N]
			if (target_ty.kind == DataType.ARRAY) {
				if (!is_integer(index_ty)) self.report_error(node, "Index must be integer");
				return sem_array(target_ty).elem;
			}

			// 2. String indexing str[i] -> char
			if (target_ty.kind == DataType.STR) {
				if (!is_integer(index_ty)) self.report_error(node, "Index must be integer");
				return alloc_primitive(&self.arena, type_char());
			}

			// 3. Raw pointer indexing *T -> T (e.g. self.data[i])
			if (target_ty.kind == DataType.POINTER) {
				if (!is_integer(index_ty)) self.report_error(node, "Index must be integer");
				return sem_pointer(target_ty).pointee;
			}

			// 4. Custom container struct with get(index) method (List<T>, etc.)
			if (target_ty.kind == DataType.STRUCT) {
				val s_info = sem_struct(target_ty);
				var mi = struct_find_method_arity(s_info, "get", 2);
				if (mi == null) mi = struct_find_method(s_info, "get");
				if (mi != null) {
					val fn_info = sem_fn(mi.fn_type);
					val param_ty = fn_info.param_types[1];
					if (is_list_type(param_ty)) self.coerce_to_list(idx.index, param_ty);
					if (!can_assign(param_ty, index_ty)) self.report_error(node, "Argument type mismatch in index access");

					var new_args = List<*AstNode>();
					new_args.add(self.b().unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
					new_args.add(idx.index);

					val call_node = self.b().call(self.b().identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
					val n = node as &AstNode;
					n.kind = NodeKind.EXPR_CALL;
					n.data = call_node.data;
					return fn_info.return_type;
				}
			}

			self.report_error(node, "Index access on non-indexable type");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.EXPR_ASSIGN -> {
			val asgn = node.to<AssignExpr>();

			// Index assignment desugaring: container[i] = val -> container.set(i, val)
			var target_expr = asgn.target;
			while (target_expr.kind == NodeKind.EXPR_GROUP) target_expr = target_expr.to<GroupExpr>().expr;

			if (target_expr.kind == NodeKind.EXPR_INDEX) {
				val idx = target_expr.to<IndexExpr>();
				val target_raw_ty = self.check_expr(idx.target);
				if (target_raw_ty.kind == DataType.STRUCT) {
					val s_info = sem_struct(target_raw_ty);
					var mi = struct_find_method_arity(s_info, "set", 3);
					if (mi == null) mi = struct_find_method(s_info, "set");
					if (mi != null) {
						val fn_info = sem_fn(mi.fn_type);
						val idx_param_ty = fn_info.param_types[1];
						val val_param_ty = fn_info.param_types[2];

						var val_expr = asgn.value;
						if (asgn.op != TokenType.EQUAL) {
							val bin_op = when (asgn.op) {
								TokenType.PLUS_EQUAL -> TokenType.PLUS,
								TokenType.MINUS_EQUAL -> TokenType.MINUS,
								TokenType.STAR_EQUAL -> TokenType.STAR,
								TokenType.SLASH_EQUAL -> TokenType.SLASH,
								TokenType.PERCENT_EQUAL -> TokenType.PERCENT,
								else -> TokenType.PLUS
							};
							val get_expr = self.b().index(idx.target, idx.index, node.line, node.col);
							val_expr = self.b().binary(bin_op, get_expr, asgn.value, node.line, node.col);
						}

						if (is_list_type(idx_param_ty)) self.coerce_to_list(idx.index, idx_param_ty);
						val idx_ty = self.check_expr(idx.index);
						if (!can_assign(idx_param_ty, idx_ty)) self.report_error(node, "Index type mismatch in index assignment");

						if (is_list_type(val_param_ty)) self.coerce_to_list(val_expr, val_param_ty);
						val val_ty = self.check_expr(val_expr);
						if (!can_assign(val_param_ty, val_ty)) self.report_error(node, "Value type mismatch in index assignment");

						var new_args = List<*AstNode>();
						new_args.add(self.b().unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
						new_args.add(idx.index);
						new_args.add(val_expr);

						val call_node = self.b().call(self.b().identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
						val n = node as &AstNode;
						n.kind = NodeKind.EXPR_CALL;
						n.data = call_node.data;
						return val_param_ty;
					}
				}
			}

			val target_ty = self.check_expr(asgn.target);
			if (is_list_type(target_ty)) self.coerce_to_list(asgn.value, target_ty);
			val val_ty = self.check_expr(asgn.value);

			// String concatenation desugaring: s += str -> s = kobel_concat(s, str)
			if (asgn.op == TokenType.PLUS_EQUAL && target_ty.kind == DataType.STR) {
				var cat_args = List<*AstNode>();
				cat_args.add(asgn.target);
				cat_args.add(asgn.value);
				val cat_call = self.b().call(self.b().identifier("kobel_concat", node.line, node.col), cat_args, List<*AstNode>(), node.line, node.col);
				asgn.value = cat_call;
				asgn.op = TokenType.EQUAL;
				return target_ty;
			}

			if (asgn.op != TokenType.EQUAL) {
				if (!is_numeric(target_ty) || !is_numeric(val_ty)) {
					self.report_error(node, "Compound assignment operator requires numeric operands");
				}
			}

			if (!can_assign(target_ty, val_ty)) self.report_error(node, "Type mismatch in assignment");
			return target_ty;
		}
		NodeKind.EXPR_UPDATE -> {
			val u = node.to<UpdateExpr>();

			var target_expr = u.target;
			while (target_expr.kind == NodeKind.EXPR_GROUP) target_expr = target_expr.to<GroupExpr>().expr;

			if (
				target_expr.kind != NodeKind.EXPR_IDENTIFIER &&
				target_expr.kind != NodeKind.EXPR_MEMBER &&
				target_expr.kind != NodeKind.EXPR_INDEX &&
				target_expr.kind != NodeKind.EXPR_UNARY
			) self.report_error(node, "Invalid target for increment/decrement operator");

			// Index assignment desugaring: container[i]++ -> container.set(i, container.get(i) + 1)
			if (target_expr.kind == NodeKind.EXPR_INDEX) {
				val idx = target_expr.to<IndexExpr>();
				val target_raw_ty = self.check_expr(idx.target);
				if (target_raw_ty.kind == DataType.STRUCT) {
					val s_info = sem_struct(target_raw_ty);
					var mi = struct_find_method_arity(s_info, "set", 3);
					if (mi == null) mi = struct_find_method(s_info, "set");
					if (mi != null) {
						val fn_info = sem_fn(mi.fn_type);
						val idx_param_ty = fn_info.param_types[1];
						val val_param_ty = fn_info.param_types[2];

						val bin_op = if (u.op == TokenType.PLUS_PLUS) TokenType.PLUS else TokenType.MINUS;
						val one_node = if (is_float(val_param_ty)) self.b().literal(LiteralKind.FLOAT, "1.0", node.line, node.col)
						               else self.b().literal(LiteralKind.INT, "1", node.line, node.col);
						val get_expr = self.b().index(idx.target, idx.index, node.line, node.col);
						val val_expr = self.b().binary(bin_op, get_expr, one_node, node.line, node.col);

						if (is_list_type(idx_param_ty)) self.coerce_to_list(idx.index, idx_param_ty);
						val idx_ty = self.check_expr(idx.index);
						if (!can_assign(idx_param_ty, idx_ty)) self.report_error(node, "Index type mismatch in index update");

						val v_ty = self.check_expr(val_expr);
						if (!can_assign(val_param_ty, v_ty)) self.report_error(node, "Value type mismatch in index update");

						var new_args = List<*AstNode>();
						new_args.add(self.b().unary(TokenType.AMPERSAND, idx.target, node.line, node.col));
						new_args.add(idx.index);
						new_args.add(val_expr);

						val call_node = self.b().call(self.b().identifier(mi.c_name, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
						val n = node as &AstNode;
						n.kind = NodeKind.EXPR_CALL;
						n.data = call_node.data;
						return val_param_ty;
					}
				}
			}

			val target_ty = self.check_expr(u.target);
			if (!is_numeric(target_ty)) self.report_error(node, "Increment/decrement operator requires numeric operand");
			return target_ty;
		}
		NodeKind.EXPR_CAST -> {
			val cst = node.to<CastExpr>();
			self.check_expr(cst.expr);
			return self.resolve_type(cst.target_type);
		}
		NodeKind.EXPR_IF -> {
			val if_e = node.to<IfExpr>();
			val cond_ty = self.check_expr(if_e.condition);
			if (cond_ty.kind != DataType.BOOL) self.report_error(node, "If expression condition must be bool");
			val then_ty = self.check_expr(if_e.then_branch);
			val else_ty = self.check_expr(if_e.else_branch);
			if (!can_assign(then_ty, else_ty)) self.report_error(node, "If expression branches have incompatible types");
			return then_ty;
		}
		NodeKind.EXPR_WHEN -> {
			val we = node.to<WhenExpr>();
			if (we.condition != null) self.check_expr(we.condition);

			self.when_depth++;
			var result_ty: *Type = null;
			var has_else = false;
			for (arm in we.arms) {
				if (arm.is_else) has_else = true;
				for (pat in arm.patterns) {
					val p_ty = self.check_expr(pat);
					if (we.condition == null && p_ty.kind != DataType.BOOL) self.report_error(pat, "Boolean when arm condition must be bool");
				}
				val body_ty = self.check_when_arm_body(arm.body);
				if (result_ty == null) result_ty = body_ty;
				else if (!can_assign(result_ty, body_ty)) {
					self.report_error(arm.body, "When arm type does not match previous arms");
				}
			}
			self.when_depth--;

			if (!has_else) {
				self.report_error(node, "when expression requires an 'else' arm");
				return alloc_primitive(&self.arena, type_none());
			}
			if (result_ty == null) return alloc_primitive(&self.arena, type_none());
			return result_ty;
		}
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = node.to<ArrayLiteralExpr>();

			if (al.list_struct_name != "") {
				val sym = lookup(&self.symtab, al.list_struct_name);
				if (sym != null) return sym.type_ptr;
			}

			// The element type comes from the first element; an empty literal
			// has nothing to infer from (use an annotated `[T; 0]` variable).
			if (al.elements.is_empty()) {
				self.report_error(node, "Cannot infer the element type of an empty array literal");
				return alloc_primitive(&self.arena, type_none());
			}

			val elem_ty = self.check_expr(al.elements.first());
			for (i in 1..<al.elements.len) {
				val t = self.check_expr(al.elements[i]);
				if (!can_assign(elem_ty, t)) self.report_error(al.elements[i], "Array literal element type mismatch");
			}
			return alloc_array_type(&self.arena, elem_ty, al.elements.len);
		}
		NodeKind.EXPR_INTERP -> {
			val ie = node.to<InterpExpr>();

			// Fold the parts into a `kobel_concat` chain; every hole is checked
			// once and converted to `str` (see interp_piece).
			var acc: *AstNode = null;
			for (part in ie.parts) {
				var piece = part.expr;
				if (!part.is_literal) {
					val pty = self.check_expr(piece);
					piece = self.interp_piece(node, piece, pty);
					if (piece == null) return alloc_primitive(&self.arena, type_str());
				}
				if (acc == null) acc = piece;
				else acc = interp_concat(&self.arena, acc, piece, node.line, node.col);
			}
			if (acc == null) acc = self.b().literal(LiteralKind.STRING, "\"\"", node.line, node.col);

			val in_n = node as &AstNode;
			in_n.kind = acc.kind;
			in_n.data = acc.data;
			return alloc_primitive(&self.arena, type_str());
		}
		else -> return alloc_primitive(&self.arena, type_none());
	}
}

// ============================================================================
// Statement Type Checking
// ============================================================================

pub fn check_statement(var self, node: *AstNode) {
	if (node == null) return;

	when (node.kind) {
		NodeKind.STMT_BLOCK -> {
			val blk = node.to<BlockStmt>();
			enter_scope(&self.symtab, false);
			for (stmt in blk.statements) {
				self.check_statement(stmt);
			}
			exit_scope(&self.symtab);
		}
		NodeKind.STMT_VAR_DECL -> {
			val vd = node.to<VarDeclStmt>() as &VarDeclStmt;
			var var_ty = alloc_primitive(&self.arena, type_none());

			var has_init = false;
			var init_ty = alloc_primitive(&self.arena, type_none());

			if (vd.type_annotation != null) {
				var_ty = self.resolve_type(vd.type_annotation);
				if (vd.initializer != null) {
					has_init = true;
					if (is_list_type(var_ty)) self.coerce_to_list(vd.initializer, var_ty);
					init_ty = self.check_expr(vd.initializer);
					if (!can_assign(var_ty, init_ty)) self.report_error(node, "Type mismatch in variable declaration for '${vd.name}'");
				}
			} else {
				if (vd.initializer != null) {
					has_init = true;
					init_ty = self.check_expr(vd.initializer);
					var_ty = init_ty;
				} else {
					self.report_error(node, "Variable '${vd.name}' without type must have initializer");
				}
			}

			// Give an inferred local an explicit type node so the C backend does
			// not have to re-infer it (it cannot see struct field types).
			if (vd.type_annotation == null && has_init) {
				vd.type_annotation = ast_type_from_type(&self.arena, var_ty);
			}

			val ok = define(&self.symtab, Symbol(vd.name, vd.name, SymbolKind.VAR, var_ty, vd.is_mut, false, node.line, node.col));
			if (!ok) self.report_error(node, "Variable '${vd.name}' is already defined in this scope");
		}
		NodeKind.STMT_IF -> {
			val if_s = node.to<IfStmt>();
			val cond_ty = self.check_expr(if_s.condition);
			if (cond_ty.kind != DataType.BOOL) self.report_error(node, "If statement condition must be bool");
			self.check_statement(if_s.then_branch);
			if (if_s.else_branch != null) self.check_statement(if_s.else_branch);
		}
		NodeKind.STMT_WHILE -> {
			val wh = node.to<WhileStmt>();
			val cond_ty = self.check_expr(wh.condition);
			if (cond_ty.kind != DataType.BOOL) self.report_error(node, "While statement condition must be bool");
			self.loop_depth++;
			self.check_statement(wh.body);
			self.loop_depth--;
		}
		NodeKind.STMT_FOR -> {
			val fs = node.to<ForStmt>() as &ForStmt;
			if (!fs.is_range && !for_is_lvalue(fs.iterable)) {
				self.report_error(node, "The iterated expression of a 'for' must be a variable or a field");
			}
			// Containers that implement `Iterable` are walked through the trait
			// (`count()` / `at(i)`); `str` and arrays keep the `.len` / `.data`
			// lowering (see desugar_for_iterable).
			var use_iter_trait = false;
			if (!fs.is_range) use_iter_trait = self.struct_implements_iterable(self.for_iterable_type(fs.iterable));

			desugar_for(&self.arena, node, fs, use_iter_trait);
			// `node` now holds the lowered block; check it through the normal path.
			self.check_statement(node);
		}
		NodeKind.STMT_RETURN -> {
			val ret = node.to<ReturnStmt>();
			if (ret.value != null) {
				if (is_list_type(self.current_fn_return_type))
					self.coerce_to_list(ret.value, self.current_fn_return_type);

				val val_ty = self.check_expr(ret.value);

				if (!can_assign(self.current_fn_return_type, val_ty))
					self.report_error(node, "Return value type does not match function return type");
			} else if (self.current_fn_return_type.kind != DataType.NONE)
				self.report_error(node, "Non-none function must return a value");
		}
		NodeKind.STMT_BREAK, NodeKind.STMT_CONTINUE -> {
			if (self.loop_depth == 0) self.report_error(node, "Break or continue statement outside of loop");
		}
		NodeKind.STMT_EXPR -> {
			val es = node.to<ExprStmt>();
			self.check_expr(es.expr);
		}
		NodeKind.STMT_WHEN -> {
			val ws = node.to<WhenStmt>();
			if (ws.condition != null) self.check_expr(ws.condition);
			for (arm in ws.arms) {
				for (pat in arm.patterns) {
					val p_ty = self.check_expr(pat);
					if (ws.condition == null && p_ty.kind != DataType.BOOL) self.report_error(pat, "Boolean when arm condition must be bool");
				}
				self.check_statement(arm.body);
			}
		}
		NodeKind.STMT_YIELD -> {
			val ys = node.to<YieldStmt>();
			if (self.when_depth == 0) self.report_error(node, "Yield statement outside of when expression");
			if (ys.value != null) self.check_expr(ys.value);
		}
	}
}

pub fn check_when_arm_body(var self, body: *AstNode): *Type {
	if (body.kind == NodeKind.STMT_BLOCK) {
		val blk = body.to<BlockStmt>();
		var yield_ty: *Type = null;
		enter_scope(&self.symtab, false);
		for (stmt in blk.statements) {
			if (stmt.kind == NodeKind.STMT_YIELD) {
				val ys = stmt.to<YieldStmt>();
				if (ys.value != null) yield_ty = self.check_expr(ys.value);
				else yield_ty = alloc_primitive(&self.arena, type_none());
			} else {
				self.check_statement(stmt);
			}
		}
		exit_scope(&self.symtab);
		if (yield_ty == null) {
			self.report_error(body, "When arm block must yield a value");
			return alloc_primitive(&self.arena, type_none());
		}
		return yield_ty;
	}
	return self.check_expr(body);
}

}

// ============================================================================
// String interpolation lowering
//
// `"a${x}b"` is lowered here into a `kobel_concat` chain; each hole is converted
// to `str` according to its type. Nothing of this reaches the C backend beyond
// calls to the prelude helpers, so codegen needs no new knowledge.
// ============================================================================

// A call to a prelude helper. Left unchecked on purpose: the prelude is emitted
// by codegen and has no symbol table entry.
pub fn interp_call(var arena: &Arena, name: str, arg: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(arg);
	var b = AstBuilder(arena);
	return b.call(b.identifier(name, line, col), args, List<*AstNode>(), line, col);
}

pub fn interp_concat(var arena: &Arena, a: *AstNode, b_node: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(a);
	args.add(b_node);
	var b = AstBuilder(arena);
	return b.call(b.identifier("kobel_concat", line, col), args, List<*AstNode>(), line, col);
}

impl BodyPass {

// Converts one interpolation hole to `str`, or reports an error and returns null.
	pub fn interp_piece(var self, node: *AstNode, expr: *AstNode, ty: *Type): *AstNode {
		if (ty.kind == DataType.STR) return expr;

		// Everything else goes through the `ToStr` trait; std.traits.to_str (loaded
		// by the driver) provides the built-in implementations.
		val pmi = find_prim_method(&self.symtab, ty.kind, "to_str");
		if (pmi != null) return interp_call(&self.arena, pmi.c_name, expr, node.line, node.col);

		var cur_ty = ty;
		var is_ptr = false;
		if (cur_ty.kind == DataType.POINTER) {
			is_ptr = true;
			cur_ty = sem_pointer(cur_ty).pointee;
		}
		if (cur_ty.kind == DataType.STRUCT) {
			val st_info = sem_struct(cur_ty);
			val mi = struct_find_method(st_info, "to_str");
			if (mi != null) {
				var arg = expr;
				if (!is_ptr) arg = self.b().unary(TokenType.AMPERSAND, expr, node.line, node.col);
				return interp_call(&self.arena, mi.c_name, arg, node.line, node.col);
			}
		}

		self.report_error(node, "Interpolated value must implement ToStr");
		return null;
	}

	// ============================================================================
	// `for` lowering
	//
	// `for` is lowered here into plain while-loops plus hidden locals, so the C
	// backend never sees STMT_FOR and needs no new type knowledge. The lowering
	// deliberately avoids needing the element type: it only uses the uniform
	// `.len` / `.data` members that `str`, `[T; N]` and the std containers expose.
	//
	// Range lowering is overflow safe: the "is there another element?" test is
	// evaluated before the counter is moved, and the counter only moves while that
	// test holds, so an unsigned counter never wraps below its end bound.
	// ============================================================================



	// Best-effort static type of a `for` iterable (a variable or a field chain).
	// Reports nothing and rewrites nothing, so it is safe to call before the loop
	// is lowered and re-checked.
	fn for_iterable_type(self, node: *AstNode): *Type => when (node.kind) {
		NodeKind.EXPR_GROUP -> self.for_iterable_type(node.to<GroupExpr>().expr);

		NodeKind.EXPR_IDENTIFIER -> {
			val sym = lookup(&self.symtab, node.to<IdentifierExpr>().name);
			if (sym != null) yield sym.type_ptr;
			yield null;
		}

		NodeKind.EXPR_MEMBER -> {
			val mem = node.to<MemberExpr>();
			var obj = self.for_iterable_type(mem.object);
			if (obj == null) yield null;

			if (obj.kind == DataType.POINTER) obj = sem_pointer(obj).pointee;
			if (obj.kind != DataType.STRUCT) yield null;

			val s_mem = sem_struct(obj);
			for (f in s_mem.fields) {
				if (f.name == mem.member) yield f.type_ptr;
			}
			yield null;
		}

		else -> null;
	};

	// Whether the type is a struct with an `impl Iterable for` block. Such a `for`
	// iterates through the trait (`count()` / `at(i)`) instead of the built-in
	// `.len` / `.data`, so containment no longer has to look like a flat array.
	fn struct_implements_iterable(self, ty: *Type): bool {
		var cur = ty;
		if (cur != null && cur.kind == DataType.POINTER) cur = sem_pointer(cur).pointee;
		if (cur == null || cur.kind != DataType.STRUCT) return false;
		val t = find_trait(&self.symtab, "Iterable");
		if (t == null) return false;
		return trait_has_impl(t, sem_struct(cur).name);
	}

}

// Builds an AST type node for a resolved semantic type, so locals can carry an
// explicit annotation the C backend understands.
pub fn ast_type_from_type(var arena: &Arena, ty: *Type): *AstNode {
	var b = AstBuilder(arena);
	if (is_enum_type(ty)) return b.named_type(as_enum_info(ty).c_name, List<*AstNode>(), 0, 0);

	return when (ty.kind) {
		DataType.POINTER -> {
			val pt = sem_pointer(ty);
			val base_ptr = b.pointer_type(pt.is_mut, ast_type_from_type(arena, pt.pointee), 0, 0);
			if (pt.is_nullable) yield b.nullable_type(base_ptr, 0, 0);
			yield base_ptr;
		}
		DataType.ARRAY -> {
			val at = sem_array(ty);
			yield b.array_type(ast_type_from_type(arena, at.elem), at.length, 0, 0);
		}
		DataType.STRUCT -> {
			val st_info = sem_struct(ty);
			var st_name = st_info.name;
			if (st_info.c_name.len > 0) st_name = st_info.c_name;
			yield b.named_type(st_name, List<*AstNode>(), 0, 0);
		}
		DataType.NONE -> b.named_type("none", List<*AstNode>(), 0, 0);
		DataType.STR -> b.named_type("str", List<*AstNode>(), 0, 0);
		DataType.BOOL -> b.named_type("bool", List<*AstNode>(), 0, 0);
		DataType.CHAR -> b.named_type("char", List<*AstNode>(), 0, 0);
		DataType.I8 -> b.named_type("i8", List<*AstNode>(), 0, 0);
		DataType.I16 -> b.named_type("i16", List<*AstNode>(), 0, 0);
		DataType.I32 -> b.named_type("i32", List<*AstNode>(), 0, 0);
		DataType.I64 -> b.named_type("i64", List<*AstNode>(), 0, 0);
		DataType.ISZ -> b.named_type("isz", List<*AstNode>(), 0, 0);
		DataType.U8 -> b.named_type("u8", List<*AstNode>(), 0, 0);
		DataType.U16 -> b.named_type("u16", List<*AstNode>(), 0, 0);
		DataType.U32 -> b.named_type("u32", List<*AstNode>(), 0, 0);
		DataType.U64 -> b.named_type("u64", List<*AstNode>(), 0, 0);
		DataType.USZ -> b.named_type("usz", List<*AstNode>(), 0, 0);
		DataType.F32 -> b.named_type("f32", List<*AstNode>(), 0, 0);
		DataType.F64 -> b.named_type("f64", List<*AstNode>(), 0, 0);
		else -> null;
	};
}

// Builds `kobel_streq(a, b)`, optionally negated, for str equality.
pub fn make_str_eq(var arena: &Arena, is_neq: bool, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode {
	var eargs = List<*AstNode>();
	eargs.add(left);
	eargs.add(right);
	var b = AstBuilder(arena);
	val eq_call = b.call(b.identifier("kobel_streq", line, col), eargs, List<*AstNode>(), line, col);
	if (is_neq) return b.unary(TokenType.BANG, eq_call, line, col);
	return eq_call;
}
