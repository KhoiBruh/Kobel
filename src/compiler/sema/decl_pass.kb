// ============================================================================
// DeclPass - Top-level Declarations Collector
// ============================================================================

pub struct DeclPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_module: str,
	pub errors: List<str>,
	// Currently collecting declarations inside the `extern "libc" { ... }` block
	pub is_extern: bool = false,
	pub current_self_type: *Type = null,
	pub current_fn_return_type: *AstNode = null
}

pub fn alloc_primitive(var arena: &Arena, base: Type): *Type => arena.primitive_type(base);

// Source names carried by more than one method of an impl, i.e. overloads.
fn overloaded_names(im: &ImplDecl): List<str> {
	var names = List<str>();
	for (a in 0..<im.methods.len) {
		val na = im.methods[a].to<FnDecl>().name;
		if (na in names) continue;
		for (b in (a + 1)..<im.methods.len) {
			if (im.methods[b].to<FnDecl>().name == na) {
				names += na;
				break;
			}
		}
	}
	return names;
}

// Distinct C name of one method: `base`, or `<base>_<argc>` when the method name
// is overloaded, bumped to `<base>_<argc>_<k>` while that name is already taken.
// `taken` holds the owning type's mangled method names so far (struct methods ask
// their `StructType`, primitive methods track theirs locally).
fn method_c_name(base: str, argc: usz, overloaded: bool, taken: List<str>): str {
	var name = base;
	if (overloaded) name = "${base}_${argc}";
	var k: usz = 2;
	while (name in taken) {
		name = "${base}_${argc}_${k}";
		k++;
	}
	return name;
}

// The built-in type named `name`, or null when `name` is not a primitive.
// Primitives are not registered as symbols, so this name table is also how
// `impl <primitive>` blocks are recognized. Returns the canonical instance.
pub fn resolve_primitive_name(prims: *PrimTypes, name: str): *Type => when (name) {
	"none" -> prims.get(DataType.NONE);
	"bool" -> prims.get(DataType.BOOL);
	"char" -> prims.get(DataType.CHAR);
	"i8" -> prims.get(DataType.I8);
	"i16" -> prims.get(DataType.I16);
	"i32" -> prims.get(DataType.I32);
	"i64" -> prims.get(DataType.I64);
	"isz" -> prims.get(DataType.ISZ);
	"u8" -> prims.get(DataType.U8);
	"u16" -> prims.get(DataType.U16);
	"u32" -> prims.get(DataType.U32);
	"u64" -> prims.get(DataType.U64);
	"usz" -> prims.get(DataType.USZ);
	"f32" -> prims.get(DataType.F32);
	"f64" -> prims.get(DataType.F64);
	"str" -> prims.get(DataType.STR);
	else -> null;
};

pub fn parse_decimal_i64(s: str): i64 {
	var v = 0L;
	for (c in s) {
		if (c >= '0' && c <= '9') {
			v = v * 10 + ((c as i32) - 48);
		} else if (c != '_') {
			break;
		}
	}
	return v;
}

// Inserts `m` into `out`, replacing a same-named entry so a derived trait's
// method wins over the base one it inherits.
fn trait_put_method(out: &List<*TraitMethod>, m: *TraitMethod) {
	for (i in 0..<out.len) {
		val e = (*out)[i];
		if (e.name == m.name && e.arity == m.arity) {
			(*out)[i] = m;
			return;
		}
	}
	out += m;
}

pub fn int_literal_type(prims: *PrimTypes, raw: str): *Type {
	// The suffix sets the width. It is read through `num_suffix` so that a hex
	// digit is never mistaken for one: `0xBB` is the i32 187, not `0xB` as an i8.
	val sfx = raw.num_suffix();
	if (sfx == "UB") return prims.get(DataType.U8);
	if (sfx == "US") return prims.get(DataType.U16);
	if (sfx == "UL") return prims.get(DataType.U64);
	if (sfx == "UZ") return prims.get(DataType.USZ);

	if (sfx == "U") return prims.get(DataType.U32);
	if (sfx == "L") return prims.get(DataType.I64);
	if (sfx == "S") return prims.get(DataType.I16);
	if (sfx == "Z") return prims.get(DataType.ISZ);
	if (sfx == "B") return prims.get(DataType.I8);

	return prims.get(DataType.I32);
}

pub fn primitive_type_name(ty: *Type): str => when (ty.kind) {
	DataType.BOOL -> "bool",
	DataType.CHAR -> "char",
	DataType.I8 -> "i8",
	DataType.I16 -> "i16",
	DataType.I32 -> "i32",
	DataType.I64 -> "i64",
	DataType.ISZ -> "isz",
	DataType.U8 -> "u8",
	DataType.U16 -> "u16",
	DataType.U32 -> "u32",
	DataType.U64 -> "u64",
	DataType.USZ -> "usz",
	DataType.F32 -> "f32",
	DataType.F64 -> "f64",
	DataType.STR -> "str",
	else -> "none"
};

impl DeclPass {

	pub fn new() => Self(SymbolTable(), Arena(), "", List<str>());

// Primitive type shorthands: the canonical instance from the symbol table, so
// `i32` is one pointer for the whole compilation.
	pub fn t_none(var self): *Type => self.symtab.prims_of().get(DataType.NONE);
	pub fn t_bool(var self): *Type => self.symtab.prims_of().get(DataType.BOOL);
	pub fn t_char(var self): *Type => self.symtab.prims_of().get(DataType.CHAR);
	pub fn t_str(var self): *Type => self.symtab.prims_of().get(DataType.STR);
	pub fn t_usz(var self): *Type => self.symtab.prims_of().get(DataType.USZ);
	pub fn t_prim(var self, base: Type): *Type => self.symtab.prims_of().get(base.kind) ?: alloc_primitive(&self.arena, base);

	// Switches the module context (both the pass and its symbol table) and
	// returns the previous module so the caller can restore it.
	pub fn enter_module(var self, module: str): str {
		val prev = self.current_module;
		if (module.len > 0) {
			self.current_module = module;
			self.symtab.set_current_module(module);
		}
		return prev;
	}

	pub fn leave_module(var self, prev: str) {
		self.current_module = prev;
		self.symtab.set_current_module(prev);
	}

	pub fn named_type(var self, name: str, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<NamedType>(NamedType.TAG, NamedType(name, type_args), line, col);

	pub fn pointer_type(var self, is_mut: bool, pointee: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<PointerType>(PointerType.TAG, PointerType(is_mut, pointee), line, col);

	pub fn array_type(var self, elem: *AstNode, size: usz, line: usz, col: usz): *AstNode
		=> self.arena.make<ArrayType>(ArrayType.TAG, ArrayType(elem, size), line, col);

	pub fn nullable_type(var self, inner: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<NullableType>(NullableType.TAG, NullableType(inner), line, col);

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz): *AstNode
		=> self.arena.make<LiteralExpr>(LiteralExpr.TAG, LiteralExpr(lk, raw), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz): *AstNode
		=> self.arena.make<IdentifierExpr>(IdentifierExpr.TAG, IdentifierExpr(name), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<BinaryExpr>(BinaryExpr.TAG, BinaryExpr(left, op, right), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<UnaryExpr>(UnaryExpr.TAG, UnaryExpr(op, operand), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<CallExpr>(CallExpr.TAG, CallExpr(callee, args, type_args), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.make<MemberExpr>(MemberExpr.TAG, MemberExpr(obj, member), line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.arena.make<MemberExpr>(MemberExpr.TAG, MemberExpr(obj, member, true), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IndexExpr>(IndexExpr.TAG, IndexExpr(target, index), line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<AssignExpr>(AssignExpr.TAG, AssignExpr(target, op, value), line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<UpdateExpr>(UpdateExpr.TAG, UpdateExpr(op, target), line, col);

	pub fn cast(var self, expr: *AstNode, target_type: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<CastExpr>(CastExpr.TAG, CastExpr(expr, target_type), line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<GroupExpr>(GroupExpr.TAG, GroupExpr(expr), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IfExpr>(IfExpr.TAG, IfExpr(condition, then_branch, else_branch), line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<ArrayLiteralExpr>(ArrayLiteralExpr.TAG, ArrayLiteralExpr(elements, list_struct_name, elem_type_node), line, col);

	pub fn when_expr(var self, condition: *AstNode, arms: List<WhenArm>, line: usz, col: usz): *AstNode
		=> self.arena.make<WhenExpr>(WhenExpr.TAG, WhenExpr(condition, arms), line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz): *AstNode
		=> self.arena.make<InterpExpr>(InterpExpr.TAG, InterpExpr(parts), line, col);

	pub fn is_expr(var self, expr: *AstNode, target_type: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IsExpr>(IsExpr.TAG, IsExpr(expr, target_type), line, col);

	pub fn block_stmt(var self, statements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<BlockStmt>(BlockStmt.TAG, BlockStmt(statements), line, col);

	pub fn expr_stmt(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<ExprStmt>(ExprStmt.TAG, ExprStmt(expr), line, col);

	pub fn var_decl(var self, is_mut: bool, name: str, type_annotation: *AstNode, initializer: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<VarDeclStmt>(VarDeclStmt.TAG, VarDeclStmt(is_mut, name, type_annotation, initializer), line, col);

	pub fn if_stmt(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<IfStmt>(IfStmt.TAG, IfStmt(condition, then_branch, else_branch), line, col);

	pub fn while_stmt(var self, condition: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<WhileStmt>(WhileStmt.TAG, WhileStmt(condition, body), line, col);

	pub fn for_stmt(var self, var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode, range_start: *AstNode, range_end: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<ForStmt>(ForStmt.TAG, ForStmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body), line, col);

	pub fn return_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<ReturnStmt>(ReturnStmt.TAG, ReturnStmt(value), line, col);

	pub fn break_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.make<BreakStmt>(BreakStmt.TAG, BreakStmt(0), line, col);

	pub fn continue_stmt(var self, line: usz, col: usz): *AstNode
		=> self.arena.make<ContinueStmt>(ContinueStmt.TAG, ContinueStmt(0), line, col);

	pub fn when_stmt(var self, condition: *AstNode, arms: List<WhenStmtArm>, line: usz, col: usz): *AstNode
		=> self.arena.make<WhenStmt>(WhenStmt.TAG, WhenStmt(condition, arms), line, col);

	pub fn yield_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<YieldStmt>(YieldStmt.TAG, YieldStmt(value), line, col);

	pub fn defer_stmt(var self, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.arena.make<DeferStmt>(DeferStmt.TAG, DeferStmt(body), line, col);

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz): *AstNode
		=> self.arena.make<ModuleDecl>(ModuleDecl.TAG, ModuleDecl(path, full_path), line, col);

	pub fn fn_decl(var self, name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode, body: *AstNode, is_pub: bool, line: usz, col: usz, is_op: bool = false): *AstNode
		=> self.arena.make<FnDecl>(FnDecl.TAG, FnDecl(name, type_params, params, return_type, body, is_pub, is_op), line, col);

	pub fn struct_decl(var self, name: str, type_params: List<GenericParam>, fields: List<AstStructField>, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.arena.make<StructDecl>(StructDecl.TAG, StructDecl(name, type_params, fields, is_pub), line, col);

	pub fn impl_decl(var self, struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<ImplDecl>(ImplDecl.TAG, ImplDecl(struct_name, type_params, trait_name, methods), line, col);

	pub fn c_name_for(self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return self.current_module.mangle_symbol(name);
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		val loc = "Line ${node.line}, Column ${node.col}: ";
		if (self.current_module.len > 0) {
			self.errors += "${self.current_module}: ${loc}${msg}";
		} else self.errors += loc + msg;
	}

	pub fn resolve_ast_type(var self, node: *AstNode): *Type {
		if (node == null) return self.t_none();

		return when (node) {
			is NamedType as var named -> {
				val name = named.name;

				if (name == "Self" && self.current_self_type != null) {
					val sinfo = self.current_self_type.as_struct();
					if (!sinfo.c_name.empty()) named.name = sinfo.c_name;
					else named.name = sinfo.name;
					yield self.current_self_type;
				}

				val prim = resolve_primitive_name(self.symtab.prims_of(), name);
				if (prim != null) yield prim;

				// Generic struct instantiation: List<i32> -> concrete struct.
				if (named.type_args.len > 0) {
					val tmpl = self.find_struct_template(name);
					if (tmpl != null) {
						val cty = self.instantiate_struct(tmpl, named.type_args);
						named.name = cty.as_struct().name;
						named.type_args = List<*AstNode>();
						yield cty;
					}
				}

				// Look up a user-defined type (Struct / Enum)
				val sym = self.symtab.lookup(name);
				if (sym != null) {
					// Switch to the mangled C name (if any) so the backend emits the right name
					if (sym.c_name != name) named.name = sym.c_name;
					yield sym.type_ptr;
				}

				self.report_error(node, "Unknown type '${name}'");
				yield self.t_none();
			}
			is PointerType as ptr_ast -> {
				val pointee = self.resolve_ast_type(ptr_ast.pointee);
				yield self.arena.pointer_type(pointee, ptr_ast.is_mut);
			}
			is ArrayType as arr_ast -> {
				val elem = self.resolve_ast_type(arr_ast.element_type);
				yield self.arena.array_type(elem, arr_ast.size);
			}
			is NullableType as null_ast -> {
				val inner_ty = self.resolve_ast_type(null_ast.inner);
				var res_ty = inner_ty;
				if (inner_ty.kind == DataType.POINTER) {
					val pt = inner_ty.as_pointer();
					res_ty = self.arena.nullable_pointer_type(pt.pointee, pt.is_mut);
				} else {
					self.report_error(node, "Nullable modifier '?' is only supported on pointer types");
				}
				yield res_ty;
			}
			else -> self.t_none();
		};
	}

// Evaluates a constant enum member value (integer literal, optionally negated).
	pub fn enum_const_i64(var self, expr: *AstNode): i64 {
		if (expr is LiteralExpr as lit) {
			return parse_decimal_i64(lit.raw_text);
		}
		if (expr is UnaryExpr as un && un.op == TokenType.MINUS) {
			return 0 - self.enum_const_i64(un.operand);
		}
		self.report_error(expr, "Enum member value must be an integer constant");
		return 0;
	}

	pub fn collect_impl(var self, node: *AstNode) {
		val im = node.to<ImplDecl>() as &ImplDecl;

		// Generic impls (e.g. `impl List<T>`) are lowered by monomorphization; skip here.
		if (im.type_params.len > 0) return;

		// `impl <primitive> { ... }`: the methods extend a built-in type.
		val prim = resolve_primitive_name(self.symtab.prims_of(), im.struct_name);
		if (prim != null) {
			self.collect_prim_impl(node, im, prim);
			return;
		}

		val st_sym = self.symtab.lookup(im.struct_name);
		if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) {
			self.report_error(node, "Cannot impl methods for unknown type '${im.struct_name}'");
			return;
		}

		val st_type = st_sym.type_ptr;
		val st_c_name = st_sym.c_name;
		val st_info = st_type.as_struct_mut();

		self.current_self_type = st_type;

		// Rename so the backend can learn the receiver type of each method.
		im.struct_name = st_c_name;

		// `impl Trait for Struct`: verify the contract and pull in default methods.
		if (!im.trait_name.empty()) self.apply_trait(node, im, st_info.name);

		// Methods may be overloaded, so each needs a distinct C name.
		val overloaded = overloaded_names(im);
		// C names already owned by this struct (from earlier `impl` blocks too).
		var used_names = List<str>();
		for (m in st_info.methods) used_names += m.c_name;

		for (m_node in im.methods) {
			val f = m_node.to<FnDecl>() as &FnDecl;
			if (f.type_params.len > 0) continue;

			if (f.name == "new") {
				for (p in f.params) {
					if (p.name == "self") {
						self.report_error(m_node,
							"Constructor 'new' cannot have a 'self' "
							"parameter in struct '${st_info.name}'"
						);
					}
				}
			}

			if (f.is_op) {
				if (f.params.len == 0 || f.params[0].name != "self") {
					self.report_error(m_node, "Operator '${f.name}' must have 'self' as its first parameter in struct '${st_info.name}'");
				} else {
					val is_mut_self = f.params[0].is_mut;
					when (f.name) {
						"plus", "minus", "mul", "div", "rem",
						"bit_and", "bit_or", "bit_xor", "shl", "shr",
						"equals", "compare", "contains" -> {
							if (f.params.len != 2) {
								self.report_error(m_node, "Binary operator '${f.name}' must take exactly 1 parameter besides 'self'");
							}
						}
						"plus_assign", "minus_assign", "mul_assign", "div_assign", "rem_assign",
						"bit_and_assign", "bit_or_assign", "bit_xor_assign", "shl_assign", "shr_assign" -> {
							if (!is_mut_self) {
								self.report_error(m_node, "Compound assignment operator '${f.name}' requires a mutable receiver 'var self'");
							}
							if (f.params.len != 2) {
								self.report_error(m_node, "Compound assignment operator '${f.name}' must take exactly 1 parameter besides 'self'");
							}
						}
						"get" -> {
							if (f.params.len < 2) {
								self.report_error(m_node, "Index operator 'get' must take at least 1 parameter besides 'self'");
							}
						}
						"set" -> {
							if (!is_mut_self) {
								self.report_error(m_node, "Index assignment operator 'set' requires a mutable receiver 'var self'");
							}
							if (f.params.len < 3) {
								self.report_error(m_node, "Index assignment operator 'set' must take at least 2 parameters besides 'self' (index and value)");
							}
						}
						"negate", "not" -> {
							if (f.params.len != 1) {
								self.report_error(m_node, "Unary operator '${f.name}' cannot take parameters besides 'self'");
							}
						}
						else -> {}
					}
				}
			}

			var param_types = List<*Type>();

			for (p in f.params) {
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver: `*Struct` for `val self`, `*mut Struct` for `var self`.
					pt = self.arena.pointer_type(st_type, p.is_mut);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types += pt;
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type)
			else self.infer_decl_return_type(f) ?: self.t_none();

			val fn_type = self.arena.fn_type(param_types, ret_type);

			// Two methods with the same name and arity still need distinct names.
			val m_c_name = method_c_name(
				"${st_c_name}_${f.name}", param_types.len, f.name in overloaded, used_names
			);
			used_names += m_c_name;

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type, m_node as *u8, self.current_module, f.is_op);
			st_info.methods += mi;

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}

		self.current_self_type = null;
	}

	pub fn infer_decl_return_type(var self, f: &FnDecl): *Type {
		if (f.body is ExprStmt as es && es.expr != null) {
			val expr = es.expr;

			if (expr is LiteralExpr as lit) {
				when (lit.literal_kind) {
					LiteralKind.INT -> {
						val p_type = int_literal_type(self.symtab.prims_of(), lit.raw_text);
						f.return_type = self.named_type(primitive_type_name(p_type), List<*AstNode>(), f.body.line, f.body.col);
						return p_type;
					}
					LiteralKind.FLOAT -> {
						val raw = lit.raw_text;
						val is_f32 = raw.ends_with("f") || raw.ends_with("F");
						if (is_f32) {
							f.return_type = self.named_type("f32", List<*AstNode>(), f.body.line, f.body.col);
							return self.t_prim(type_f32());
						}
						f.return_type = self.named_type("f64", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_prim(type_f64());
					}
					LiteralKind.BOOL -> {
						f.return_type = self.named_type("bool", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_bool();
					}
					LiteralKind.STRING -> {
						f.return_type = self.named_type("str", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_str();
					}
					LiteralKind.CHAR -> {
						f.return_type = self.named_type("char", List<*AstNode>(), f.body.line, f.body.col);
						return self.t_char();
					}
					else -> {}
				}
			}

			if (expr is MemberExpr as mem && mem.object is IdentifierExpr as id) {
				val sym = self.symtab.lookup(id.name);
				if (sym != null && sym.kind == SymbolKind.ENUM && sym.type_ptr != null && sym.type_ptr.is_enum()) {
					val ei = sym.type_ptr.as_enum();
					if (ei.find_member(mem.member) != null) {
						f.return_type = self.named_type(ei.c_name, List<*AstNode>(), f.body.line, f.body.col);
						return sym.type_ptr;
					}
				}
			}

			if (expr is UpdateExpr as u) {
				if (u.target is IdentifierExpr as id) {
					for (p in f.params) {
						if (p.name == id.name && p.type_node != null) {
							f.return_type = p.type_node;
							return self.resolve_ast_type(p.type_node);
						}
					}
				}
				if (
					u.target is MemberExpr as mem &&
					mem.object is IdentifierExpr as obj_id &&
					obj_id.name == "self" &&
					self.current_self_type != null &&
					self.current_self_type.kind == DataType.STRUCT
				) {
					val s_info = self.current_self_type.as_struct();
					for (fld in s_info.fields) {
						if (fld.name == mem.member) {
							val tname = primitive_type_name(fld.type_ptr);
							if (tname != "none") {
								f.return_type = self.named_type(tname, List<*AstNode>(), f.body.line, f.body.col);
								return fld.type_ptr;
							}
						}
					}
				}
			}
		}

		return null;
	}

// Registers the methods of `impl <primitive> { ... }`. There is no C struct to
// hang them on, so the receiver is typed explicitly as the primitive name (the
// backend then passes it by value), and each method goes into the primitive
// method table so `x.m()` can find it.
	pub fn collect_prim_impl(var self, node: *AstNode, im: &ImplDecl, prim: *Type) {
		val prim_name = im.struct_name;
		// Clear the name so codegen does not treat `self` as a pointer receiver.
		im.struct_name = "";

		if (!im.trait_name.empty()) self.apply_trait(node, im, prim_name);

		val overloaded = overloaded_names(im);
		// C names this impl has handed out so far (the prim table is global, so
		// uniqueness is tracked per impl block).
		var used_names = List<str>();

		for (m_node in im.methods) {
			val f = m_node.to<FnDecl>() as &FnDecl;
			if (f.type_params.len > 0) continue;
			var param_types = List<*Type>();

			for (i in 0..<f.params.len) {
				val p = f.params[i];
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver by value: spell its type so the backend emits `i32 self`.
					pt = prim;
					val rt = self.named_type(prim_name, List<*AstNode>(), node.line, node.col);
					f.params[i] = Param(p.name, rt, p.is_mut, p.has_val, p.default_val);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types += pt;
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type)
			else self.infer_decl_return_type(f) ?: self.t_none();

			val fn_type = self.arena.fn_type(param_types, ret_type);

			val m_c_name = method_c_name(
				"${prim_name}_${f.name}", param_types.len, f.name in overloaded, used_names
			);
			used_names += m_c_name;

			if (self.symtab.find_prim_method_arity(prim.kind, f.name, f.params.len) != null) {
				self.report_error(m_node,
					"Duplicate method '${f.name}' "
					"with ${f.params.len} parameter(s) "
					"for built-in type '${prim_name}'"
				);
			}

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type, m_node as *u8, self.current_module, f.is_op);
			self.symtab.register_prim_method(prim, mi);

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}
	}

// Records that `struct_name` implements `t` and, transitively, every trait that
// `t` inherits: implementing a trait means implementing its base traits too, so
// a `<T: Base>` bound is satisfied by an `impl Derived for T` when
// `Derived : Base`. The already-recorded test also breaks a cyclic base chain.
	pub fn trait_record_impl(var self, t: *TraitInfo, struct_name: str) {
		if (t == null) return;
		if (t.has_impl(struct_name)) return;
		t.impls += struct_name;
		for (bname in t.bases) self.trait_record_impl(self.symtab.find_trait(bname), struct_name);
	}

// Flattens a trait and its base traits into one method list: base traits are
// visited first, so a method declared in a derived trait replaces a same-named
// inherited one. `seen` stops a cycle in a mis-declared `trait A : B` /
// `trait B : A` chain.
	pub fn trait_effective(var self, t: *TraitInfo, out: &List<*TraitMethod>, seen: &HashSet) {
		if (t == null) return;
		if (t.name in seen) return;
		seen += t.name;

		for (bname in t.bases) self.trait_effective(self.symtab.find_trait(bname), out, seen);
		for (m in t.methods) trait_put_method(out, m);
	}

// Applies the trait named by `im.trait_name` to an `impl Trait for Struct`
// block: every required method (one without a body) must be provided, and every
// default method the impl left out is copied in. A copy is an ordinary method
// AST node, so the backend emits it like a hand-written one. Generic impls
// return earlier, so no type substitution is ever needed here.
	pub fn apply_trait(var self, node: *AstNode, im: &ImplDecl, struct_name: str) {
		val t = self.symtab.find_trait(im.trait_name);
		if (t == null) {
			self.report_error(node, "Unknown trait '${im.trait_name}'");
			return;
		}

		// Remember the implementation so a `<T: Trait>` bound can be checked later.
		self.trait_record_impl(t, struct_name);

		// A trait inherits every method of its base traits, so the contract covers
// the flattened set rather than just the methods written in this trait.
		var effective = List<*TraitMethod>();
		var seen = HashSet();
		self.trait_effective(t, &effective, &seen);

		for (tm in effective) {
			var have = false;
			for (m in im.methods) {
				val f = m.to<FnDecl>();
				if (f.name == tm.name && f.params.len == tm.arity) have = true;
			}
			if (have) continue;

			if (!tm.has_default) {
				self.report_error(node,
					"Struct '${struct_name}' does not implement "
					"required trait method '${tm.name}' "
					"of trait '${t.name}'"
				);
				continue;
			}
			im.methods += self.clone_fn(tm.node, null, tm.name);
		}
	}
}
