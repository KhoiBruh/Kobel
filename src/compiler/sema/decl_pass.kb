// ============================================================================
// DeclPass - Top-level Declarations Collector
// ============================================================================

pub struct DeclPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_module: str,
	pub errors: List<str>,
	// Currently collecting declarations inside the `extern "libc" { ... }` block
	pub is_extern: bool,
	pub current_self_type: *Type
}

impl DeclPass {
	pub fn new(): DeclPass {
		var arena = Arena(65536);
		return Self(SymbolTable(), arena, "", List<str>(), false, null);
	}
}

// C name of a top-level declaration: modules get the module name as a prefix
// to avoid name clashes in the flat C file; `main` and libc functions keep their names.
pub fn c_name_for(self: &DeclPass, name: str): str {
	if (self.is_extern || name == "main") return name;
	return str_mangle_symbol(self.current_module, name);
}

pub fn alloc_primitive(var arena: &Arena, base: Type): *Type {
	val ptr = arena_alloc<Type>(arena);
	*ptr = base;
	return ptr;
}

// ============================================================================
// AST Type to Semantic Type Resolution
// ============================================================================

// Report errors with the current module name so when many modules are merged,
// we still know exactly which module the error is in (instead of blaming the entry file).
pub fn report_error(var self: &DeclPass, node: *AstNode, msg: str) {
	val loc = "Line ${node.line}, Column ${node.col}: ";
	if (self.current_module.len > 0) {
		self.errors.add("${self.current_module}: ${loc}${msg}");
	} else self.errors.add(loc + msg);
}

// Source names carried by more than one method of an impl, i.e. overloads.
fn overloaded_names(im: &ImplDecl): List<str> {
	var names = List<str>();
	for (a in 0..<im.methods.len) {
		val na = as_fn_decl(im.methods.get(a)).name;
		if (list_has_str(names, na)) continue;
		for (b in (a + 1)..<im.methods.len) {
			if (as_fn_decl(im.methods.get(b)).name == na) {
				names.add(na);
				break;
			}
		}
	}
	return names;
}

fn list_has_str(list: List<str>, v: str): bool {
	for (x in list) {
		if (x == v) return true;
	}
	return false;
}

// The built-in type named `name`, or null when `name` is not a primitive.
// Primitives are not registered as symbols, so this name table is also how
// `impl <primitive>` blocks are recognized.
pub fn resolve_primitive_name(var arena: &Arena, name: str): *Type {
	when (name) {
		"none" -> return alloc_primitive(arena, type_none());
		"bool" -> return alloc_primitive(arena, type_bool());
		"char" -> return alloc_primitive(arena, type_char());
		"i8" -> return alloc_primitive(arena, type_i8());
		"i16" -> return alloc_primitive(arena, type_i16());
		"i32" -> return alloc_primitive(arena, type_i32());
		"i64" -> return alloc_primitive(arena, type_i64());
		"isz" -> return alloc_primitive(arena, type_isz());
		"u8" -> return alloc_primitive(arena, type_u8());
		"u16" -> return alloc_primitive(arena, type_u16());
		"u32" -> return alloc_primitive(arena, type_u32());
		"u64" -> return alloc_primitive(arena, type_u64());
		"usz" -> return alloc_primitive(arena, type_usz());
		"f32" -> return alloc_primitive(arena, type_f32());
		"f64" -> return alloc_primitive(arena, type_f64());
		"str" -> return alloc_primitive(arena, type_str());
		else -> return null;
	}
}

pub fn resolve_ast_type(var self: &DeclPass, node: *AstNode): *Type {
	if (node == null) return alloc_primitive(&self.arena, type_none());

	when (node.kind) {
		NodeKind.TYPE_NAMED -> {
			val named = as_named_type(node) as &NamedType;
			val name = named.name;

			if (name == "Self" && self.current_self_type != null) {
				val sinfo = sem_struct(self.current_self_type);
				if (sinfo.c_name != "") named.name = sinfo.c_name;
				else named.name = sinfo.name;
				return self.current_self_type;
			}

			val prim = resolve_primitive_name(&self.arena, name);
			if (prim != null) return prim;

			// Generic struct instantiation: List<i32> -> concrete struct.
			if (named.type_args.len > 0) {
				val tmpl = gen_find(self.symtab.gen.struct_templates, name);
				if (tmpl != null) {
					val cty = instantiate_struct(self, tmpl, named.type_args);
					named.name = sem_struct(cty).name;
					named.type_args = List<*AstNode>();
					return cty;
				}
			}

			// Look up a user-defined type (Struct / Enum)
			val sym = lookup(&self.symtab, name);
			if (sym != null) {
				// Switch to the mangled C name (if any) so the backend emits the right name
				if (sym.c_name != name) named.name = sym.c_name;
				return sym.type_ptr;
			}

			report_error(self, node, "Unknown type '${name}'");
			return alloc_primitive(&self.arena, type_none());
		}
		NodeKind.TYPE_POINTER -> {
			val ptr_ast = as_pointer_type(node);
			val pointee = resolve_ast_type(self, ptr_ast.pointee);
			return alloc_pointer_type(&self.arena, pointee, ptr_ast.is_mut);
		}
		NodeKind.TYPE_ARRAY -> {
			val arr_ast = as_array_type(node);
			val elem = resolve_ast_type(self, arr_ast.element_type);
			return alloc_array_type(&self.arena, elem, arr_ast.size);
		}
		else -> return alloc_primitive(&self.arena, type_none());
	}
}


// Evaluates a constant enum member value (integer literal, optionally negated).
pub fn enum_const_i64(var self: &DeclPass, expr: *AstNode): i64 {
	if (expr.kind == NodeKind.EXPR_LITERAL) {
		val lit = as_literal(expr);
		return parse_decimal_i64(lit.raw_text);
	}
	if (expr.kind == NodeKind.EXPR_UNARY) {
		val un = as_unary(expr);
		if (un.op == TokenType.MINUS) return 0 - enum_const_i64(self, un.operand);
	}
	report_error(self, expr, "Enum member value must be an integer constant");
	return 0;
}

pub fn parse_decimal_i64(s: str): i64 {
	var v: i64 = 0;
	for (c in s) {
		if (c >= '0' && c <= '9') {
			v = v * 10 + (((c as i32) - 48) as i64);
		} else if (c != '_') {
			break;
		}
	}
	return v;
}


pub fn collect_impl(var self: &DeclPass, node: *AstNode) {
	val im = as_impl_decl(node) as &ImplDecl;

	// Generic impls (e.g. `impl List<T>`) are lowered by monomorphization; skip here.
	if (im.type_params.len > 0) return;

	// `impl <primitive> { ... }`: the methods extend a built-in type.
	val prim = resolve_primitive_name(&self.arena, im.struct_name);
	if (prim != null) {
		collect_prim_impl(self, node, im, prim);
		return;
	}

	val st_sym = lookup(&self.symtab, im.struct_name);
	if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) {
		report_error(self, node, "Cannot impl methods for unknown type '${im.struct_name}'");
		return;
	}

	val st_type = st_sym.type_ptr;
	val st_c_name = st_sym.c_name;
	val st_info = as_struct_type_mut(st_type);

	self.current_self_type = st_type;

	// Rename so the backend can learn the receiver type of each method.
	im.struct_name = st_c_name;

	// `impl Trait for Struct`: verify the contract and pull in default methods.
	if (im.trait_name != "") apply_trait(self, node, im, st_info.name);

	// Methods may be overloaded, so each needs a distinct C name.
	val overloaded = overloaded_names(im);

	for (m_node in im.methods) {
		val f = as_fn_decl(m_node) as &FnDecl;

		if (f.name == "new") {
			for (p in f.params) {
				if (p.name == "self") {
					report_error(self, m_node, "Constructor 'new' cannot have a 'self' parameter in struct '${st_info.name}'");
				}
			}
		}

		var param_types = List<*Type>();

		for (p in f.params) {
			var pt: *Type = null;
			if (p.name == "self" && p.type_node == null) {
				// Receiver: `*Struct` for `val self`, `*mut Struct` for `var self`.
				pt = alloc_pointer_type(&self.arena, st_type, p.is_mut);
			} else {
				pt = resolve_ast_type(self, p.type_node);
			}
			param_types.add(pt);
		}

		var ret_type = alloc_primitive(&self.arena, type_none());
		if (f.return_type != null) ret_type = resolve_ast_type(self, f.return_type);

		val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);

		val base = str_concat(st_c_name, str_concat("_", f.name));
		var m_c_name = base;
		if (list_has_str(overloaded, f.name)) m_c_name = "${base}_${param_types.len}";
		// Two methods with the same name and arity still need distinct names.
		var k: usz = 2;
		while (struct_find_method_c(st_info, m_c_name) != null) {
			m_c_name = "${base}_${param_types.len}_${k}";
			k = k + 1;
		}

		val mi = arena_alloc<MethodInfo>(&self.arena);
		*mi = MethodInfo(f.name, m_c_name, fn_type);
		st_info.methods.add(mi);

		// Uniquify the AST name so the backend emits the mangled method name.
		f.name = m_c_name;
	}

	self.current_self_type = null;
}


// Registers the methods of `impl <primitive> { ... }`. There is no C struct to
// hang them on, so the receiver is typed explicitly as the primitive name (the
// backend then passes it by value), and each method goes into the primitive
// method table so `x.m()` can find it.
pub fn collect_prim_impl(var self: &DeclPass, node: *AstNode, im: &ImplDecl, prim: *Type) {
	val prim_name = im.struct_name;
	// Clear the name so codegen does not treat `self` as a pointer receiver.
	im.struct_name = "";

	if (im.trait_name != "") apply_trait(self, node, im, prim_name);

	val overloaded = overloaded_names(im);
	var used = List<str>();

	for (m_node in im.methods) {
		val f = as_fn_decl(m_node) as &FnDecl;
		var param_types = List<*Type>();

		for (i in 0..<f.params.len) {
			val p = f.params.get(i);
			var pt: *Type = null;
			if (p.name == "self" && p.type_node == null) {
				// Receiver by value: spell its type so the backend emits `i32 self`.
				pt = prim;
				val rt = alloc_named_type(&self.arena, prim_name, List<*AstNode>(), node.line, node.col);
				f.params.set(i, Param(p.name, rt, p.is_mut, p.has_val));
			} else {
				pt = resolve_ast_type(self, p.type_node);
			}
			param_types.add(pt);
		}

		var ret_type = alloc_primitive(&self.arena, type_none());
		if (f.return_type != null) ret_type = resolve_ast_type(self, f.return_type);

		val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);

		val base = str_concat(prim_name, str_concat("_", f.name));
		var m_c_name = base;
		if (list_has_str(overloaded, f.name)) m_c_name = "${base}_${param_types.len}";
		var k: usz = 2;
		while (list_has_str(used, m_c_name)) {
			m_c_name = "${base}_${param_types.len}_${k}";
			k = k + 1;
		}
		used.add(m_c_name);

		if (find_prim_method_arity(&self.symtab, prim.kind, f.name, f.params.len) != null) {
			report_error(self, m_node, "Duplicate method '${f.name}' with ${f.params.len} parameter(s) for built-in type '${prim_name}'");
		}

		val mi = arena_alloc<MethodInfo>(&self.arena);
		*mi = MethodInfo(f.name, m_c_name, fn_type);
		val pm = arena_alloc<PrimMethod>(&self.arena);
		*pm = PrimMethod(prim.kind, mi);
		register_prim_method(&self.symtab, pm);

		// Uniquify the AST name so the backend emits the mangled method name.
		f.name = m_c_name;
	}
}

// Records that `struct_name` implements `t` and, transitively, every trait that
// `t` inherits: implementing a trait means implementing its base traits too, so
// a `<T: Base>` bound is satisfied by an `impl Derived for T` when
// `Derived : Base`. The already-recorded test also breaks a cyclic base chain.
pub fn trait_record_impl(var self: &DeclPass, t: *TraitInfo, struct_name: str) {
	if (t == null) return;
	if (trait_has_impl(t, struct_name)) return;
	t.impls.add(struct_name);
	for (bname in t.bases) trait_record_impl(self, find_trait(&self.symtab, bname), struct_name);
}

// Inserts `m` into `out`, replacing a same-named entry so a derived trait's
// method wins over the base one it inherits.
fn trait_put_method(out: &List<*TraitMethod>, m: *TraitMethod) {
	for (i in 0..<out.len) {
		val e = out.get(i);
		if (e.name == m.name && e.arity == m.arity) {
			out.set(i, m);
			return;
		}
	}
	out.add(m);
}

// Flattens a trait and its base traits into one method list: base traits are
// visited first, so a method declared in a derived trait replaces a same-named
// inherited one. `seen` stops a cycle in a mis-declared `trait A : B` /
// `trait B : A` chain.
pub fn trait_effective(var self: &DeclPass, t: *TraitInfo, out: &List<*TraitMethod>, seen: &List<str>) {
	if (t == null) return;
	for (name in seen) {
		if (name == t.name) return;
	}
	seen.add(t.name);

	for (bname in t.bases) trait_effective(self, find_trait(&self.symtab, bname), out, seen);
	for (m in t.methods) trait_put_method(out, m);
}

// Applies the trait named by `im.trait_name` to an `impl Trait for Struct`
// block: every required method (one without a body) must be provided, and every
// default method the impl left out is copied in. A copy is an ordinary method
// AST node, so the backend emits it like a hand-written one. Generic impls
// return earlier, so no type substitution is ever needed here.
pub fn apply_trait(var self: &DeclPass, node: *AstNode, im: &ImplDecl, struct_name: str) {
	val t = find_trait(&self.symtab, im.trait_name);
	if (t == null) {
		report_error(self, node, "Unknown trait '${im.trait_name}'");
		return;
	}

	// Remember the implementation so a `<T: Trait>` bound can be checked later.
	trait_record_impl(self, t, struct_name);

	// A trait inherits every method of its base traits, so the contract covers
	// the flattened set rather than just the methods written in this trait.
	var effective = List<*TraitMethod>();
	var seen = List<str>();
	trait_effective(self, t, &effective, &seen);

	for (tm in effective) {
		var have = false;
		for (m in im.methods) {
			val f = as_fn_decl(m);
			if (f.name == tm.name && f.params.len == tm.arity) have = true;
		}
		if (have) continue;

		if (!tm.has_default) {
			report_error(self, node, "Struct '${struct_name}' does not implement required trait method '${tm.name}' of trait '${t.name}'");
			continue;
		}
		im.methods.add(clone_fn(self, tm.node, null, tm.name));
	}
}

// ============================================================================
// Generic Templates & Monomorphization
// ============================================================================

// Substitution context while cloning a template: type parameter -> type node.
pub struct GenSubst {
	pub names: List<str>,
	pub args: List<*AstNode>
}

pub fn subst_lookup(s: *GenSubst, name: str): *AstNode {
	if (s == null) return null;
	for (i in 0..<s.names.len) {
		if (s.names.get(i) == name) return s.args.get(i);
	}
	return null;
}

pub fn is_template_decl(node: *AstNode): bool {
	if (node.kind == NodeKind.DECL_STRUCT) return as_struct_decl(node).type_params.len > 0;
	if (node.kind == NodeKind.DECL_FN) return as_fn_decl(node).type_params.len > 0;
	if (node.kind == NodeKind.DECL_IMPL) return as_impl_decl(node).type_params.len > 0;
	return false;
}

pub fn register_template(var self: &DeclPass, node: *AstNode) {
	if (node.kind == NodeKind.DECL_STRUCT) {
		val s = as_struct_decl(node);
		if (s.type_params.len > 0) self.symtab.gen.struct_templates.add(gen_template(self, s.name, node));
	} else if (node.kind == NodeKind.DECL_FN) {
		val f = as_fn_decl(node);
		if (f.type_params.len > 0) self.symtab.gen.fn_templates.add(gen_template(self, f.name, node));
	} else if (node.kind == NodeKind.DECL_IMPL) {
		val im = as_impl_decl(node);
		if (im.type_params.len > 0) self.symtab.gen.impl_templates.add(gen_template(self, im.struct_name, node));
	}
}

pub fn gen_template(var self: &DeclPass, name: str, node: *AstNode): *GenTemplate {
	val t = arena_alloc<GenTemplate>(&self.arena);
	*t = GenTemplate(name, self.current_module, node);
	return t;
}

pub fn template_in_module(self: &DeclPass, module: str, name: str): bool {
	for (t in self.symtab.gen.struct_templates) {
		if (t.name == name && t.module == module) return true;
	}
	for (f in self.symtab.gen.fn_templates) {
		if (f.name == name && f.module == module) return true;
	}
	return false;
}

pub fn find_inst(self: &DeclPass, name: str): *Symbol {
	for (s in self.symtab.gen.inst_syms) {
		if (s.name == name) return s;
	}
	return null;
}

pub fn type_token(self: &DeclPass, ty: *Type): str {
	when (ty.kind) {
		DataType.NONE -> return "none";
		DataType.BOOL -> return "bool";
		DataType.CHAR -> return "char";
		DataType.I8 -> return "i8";
		DataType.I16 -> return "i16";
		DataType.I32 -> return "i32";
		DataType.I64 -> return "i64";
		DataType.ISZ -> return "isz";
		DataType.U8 -> return "u8";
		DataType.U16 -> return "u16";
		DataType.U32 -> return "u32";
		DataType.U64 -> return "u64";
		DataType.USZ -> return "usz";
		DataType.F32 -> return "f32";
		DataType.F64 -> return "f64";
		DataType.STR -> return "str";
		DataType.POINTER -> return str_concat("ptr_", type_token(self, sem_pointer(ty).pointee));
		DataType.ARRAY -> {
			val at = sem_array(ty);
			return "arr${at.length}_${type_token(self, at.elem)}";
		}
		DataType.STRUCT -> return sem_struct(ty).name;
		else -> return "x";
	}
}

pub fn type_token_list(self: &DeclPass, args: List<*AstNode>): str {
	var res = "";
	for (i in 0..<args.len) {
		if (i > 0) res = str_concat(res, "_");
		res = str_concat(res, ast_type_token(self, args.get(i)));
	}
	return res;
}

// Name token for a type argument, based on the mangled C name so that
// same-named structs from different modules never share an instantiation.
pub fn ast_type_token(self: &DeclPass, node: *AstNode): str {
	if (node == null) return "x";
	when (node.kind) {
		NodeKind.TYPE_NAMED -> {
			resolve_ast_type(self, node);
			return as_named_type(node).name;
		}
		NodeKind.TYPE_POINTER -> return str_concat("ptr_", ast_type_token(self, ast_pointer(node).pointee));
		NodeKind.TYPE_ARRAY -> {
			val a = ast_array(node);
			return "arr${a.size}_${ast_type_token(self, a.element_type)}";
		}
		else -> return "x";
	}
}

// C-level size of a type node (used to lower `T.size()`).
pub fn ast_type_size(self: &DeclPass, node: *AstNode): usz {
	if (node == null) return 8;
	when (node.kind) {
		NodeKind.TYPE_POINTER -> return 8;
		NodeKind.TYPE_ARRAY -> {
			val a = ast_array(node);
			return a.size * ast_type_size(self, a.element_type);
		}
		NodeKind.TYPE_NAMED -> {
			val name = as_named_type(node).name;
			if (name == "str") return 8;
			if (name == "i8" || name == "u8" || name == "bool" || name == "char") return 1;
			if (name == "i16" || name == "u16") return 2;
			if (name == "i32" || name == "u32" || name == "f32") return 4;
			if (name == "i64" || name == "u64" || name == "isz" || name == "usz" || name == "f64") return 8;
			val sym = lookup(&self.symtab, name);
			if (sym != null) return sym.type_ptr.size;
			return 8;
		}
		else -> return 8;
	}
}

pub fn template_param_names(tmpl: *GenTemplate): List<str> {
	var names = List<str>();
	if (tmpl.node.kind == NodeKind.DECL_STRUCT) {
		val s = as_struct_decl(tmpl.node);
		for (tp in s.type_params) names.add(tp.name);
	} else if (tmpl.node.kind == NodeKind.DECL_FN) {
		val f = as_fn_decl(tmpl.node);
		for (p in f.type_params) names.add(p.name);
	} else if (tmpl.node.kind == NodeKind.DECL_IMPL) {
		val im = as_impl_decl(tmpl.node);
		for (p in im.type_params) names.add(p.name);
	}
	return names;
}

// The declared generic parameters of a template (empty for an impl template,
// whose parameters live on the struct it belongs to).
pub fn template_params(tmpl: *GenTemplate): List<GenericParam> {
	if (tmpl.node.kind == NodeKind.DECL_STRUCT) return as_struct_decl(tmpl.node).type_params;
	if (tmpl.node.kind == NodeKind.DECL_FN) return as_fn_decl(tmpl.node).type_params;
	if (tmpl.node.kind == NodeKind.DECL_IMPL) return as_impl_decl(tmpl.node).type_params;
	return List<GenericParam>();
}

// Checks the trait bounds of an instantiation: for every `T: Trait` parameter
// the concrete argument must be a struct with a matching `impl Trait for`
// block. Arguments that are not known structs (primitives, pointers, ...) are
// left alone so no false error is reported for a type we cannot prove.
pub fn check_bounds(var self: &DeclPass, tmpl: *GenTemplate, arg_asts: List<*AstNode>) {
	val params = template_params(tmpl);
	for (i in 0..<params.len) {
		val gp = params.get(i);
		if (gp.bounds.len == 0 || i >= arg_asts.len) continue;

		val arg = arg_asts.get(i);
		if (arg.kind != NodeKind.TYPE_NAMED) continue;
		val aname = as_named_type(arg).name;
		val asym = lookup(&self.symtab, aname);
		if (asym == null || asym.type_ptr.kind != DataType.STRUCT) continue;

		for (b in gp.bounds) {
			val bt = find_trait(&self.symtab, b);
			if (bt == null) {
				report_error(self, arg, "Unknown trait bound '${b}'");
				continue;
			}
			if (!trait_has_impl(bt, aname)) {
				report_error(self, arg, "Type '${aname}' does not implement trait '${b}'");
			}
		}
	}
}

pub fn alloc_subst(var self: &DeclPass, names: List<str>, args: List<*AstNode>): *GenSubst {
	val s = arena_alloc<GenSubst>(&self.arena);
	*s = GenSubst(names, args);
	return s;
}

pub fn queue_decl(var self: &DeclPass, module: str, node: *AstNode) {
	self.symtab.gen.pending.add(alloc_module_decl(&self.arena, str_split_dots(module), module, node.line, node.col));
	self.symtab.gen.pending.add(node);
}

pub fn instantiate_struct(var self: &DeclPass, tmpl: *GenTemplate, arg_asts: List<*AstNode>): *Type {
	check_bounds(self, tmpl, arg_asts);

	val base = str_mangle_symbol(tmpl.module, tmpl.name);
	val cname = str_concat(base, str_concat("_", type_token_list(self, arg_asts)));

	val existing = find_inst(self, cname);
	if (existing != null) return existing.type_ptr;

	self.symtab.gen.inst_names.add(cname);

	val subst = alloc_subst(self, template_param_names(tmpl), arg_asts);

	val sclone = clone_struct(self, tmpl.node, subst, cname);
	collect_struct_as(self, sclone, cname, tmpl.module);

	// A generic type may have several `impl` blocks (an inherent one plus any
	// number of trait impls), so instantiate every matching template.
	for (impl_tmpl in self.symtab.gen.impl_templates) {
		if (impl_tmpl.name != tmpl.name) continue;
		val isubst = alloc_subst(self, template_param_names(impl_tmpl), arg_asts);
		val iclone = clone_impl(self, impl_tmpl.node, isubst, cname);
		collect_impl(self, iclone);
		queue_decl(self, impl_tmpl.module, iclone);
	}

	queue_decl(self, tmpl.module, sclone);

	val sym = find_inst(self, cname);
	if (sym == null) return alloc_primitive(&self.arena, type_none());
	return sym.type_ptr;
}

pub fn instantiate_fn(var self: &DeclPass, tmpl: *GenTemplate, arg_asts: List<*AstNode>): str {
	check_bounds(self, tmpl, arg_asts);

	val base = str_mangle_symbol(tmpl.module, tmpl.name);
	val cname = str_concat(base, str_concat("_", type_token_list(self, arg_asts)));

	if (find_inst(self, cname) != null) return cname;

	self.symtab.gen.inst_names.add(cname);

	val subst = alloc_subst(self, template_param_names(tmpl), arg_asts);
	val fclone = clone_fn(self, tmpl.node, subst, cname);
	collect_fn_as(self, fclone, cname);
	queue_decl(self, tmpl.module, fclone);
	return cname;
}

pub fn collect_struct_as(var self: &DeclPass, node: *AstNode, final_name: str, module: str) {
	val s = as_struct_decl(node) as &StructDecl;
	val s_type = alloc_struct_type(&self.arena, final_name, List<StructField>());
	self.symtab.gen.inst_syms.add(box_symbol(&self.arena, Symbol(final_name, final_name, SymbolKind.STRUCT, s_type, false, s.is_pub, node.line, node.col)));
	s.name = final_name;

	var has_private = false;
	for (f in s.fields) {
		val f_type = resolve_ast_type(self, f.type_node);
		as_struct_type_mut(s_type).fields.add(StructField(f.name, f_type, 0, f.is_pub));
		if (!f.is_pub) has_private = true;
	}
	val st_info = as_struct_type_mut(s_type);
	// A monomorphized instance belongs to the module that declared its template.
	st_info.module = module;
	st_info.has_private = has_private;
	layout_struct(s_type);
}

pub fn collect_fn_as(var self: &DeclPass, node: *AstNode, final_name: str) {
	val f = as_fn_decl(node) as &FnDecl;
	var param_types = List<*Type>();
	for (p in f.params) param_types.add(resolve_ast_type(self, p.type_node));
	var ret_type = alloc_primitive(&self.arena, type_none());
	if (f.return_type != null) ret_type = resolve_ast_type(self, f.return_type);

	val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);
	self.symtab.gen.inst_syms.add(box_symbol(&self.arena, Symbol(final_name, final_name, SymbolKind.FN, fn_type, false, f.is_pub, node.line, node.col)));
	f.name = final_name;
}

// ----------------------------------------------------------------------------
// AST cloning with type-parameter substitution
// ----------------------------------------------------------------------------

pub fn clone_type(var self: &DeclPass, node: *AstNode, subst: *GenSubst): *AstNode {
	if (node == null) return null;
	when (node.kind) {
		NodeKind.TYPE_NAMED -> {
			val nt = as_named_type(node);
			val sa = subst_lookup(subst, nt.name);
			if (sa != null) return clone_type(self, sa, null);

			if (nt.type_args.len > 0) {
				val tmpl = gen_find(self.symtab.gen.struct_templates, nt.name);
				if (tmpl != null) {
					var args = List<*AstNode>();
			for (ta in nt.type_args) args.add(clone_type(self, ta, subst));
					val cty = instantiate_struct(self, tmpl, args);
					return alloc_named_type(&self.arena, sem_struct(cty).name, List<*AstNode>(), node.line, node.col);
				}
			}

			var targs = List<*AstNode>();
			for (ta in nt.type_args) targs.add(clone_type(self, ta, subst));
			return alloc_named_type(&self.arena, nt.name, targs, node.line, node.col);
		}
		NodeKind.TYPE_POINTER -> {
			val pt = ast_pointer(node);
			return ast_alloc_pointer(&self.arena, pt.is_mut, clone_type(self, pt.pointee, subst), node.line, node.col);
		}
		NodeKind.TYPE_ARRAY -> {
			val at = ast_array(node);
			return ast_alloc_array(&self.arena, clone_type(self, at.element_type, subst), at.size, node.line, node.col);
		}
		else -> return alloc_named_type(&self.arena, "none", List<*AstNode>(), node.line, node.col);
	}
}

pub fn clone_expr(var self: &DeclPass, node: *AstNode, subst: *GenSubst): *AstNode {
	if (node == null) return null;
	when (node.kind) {
		NodeKind.EXPR_LITERAL -> {
			val l = as_literal(node);
			return alloc_literal(&self.arena, l.literal_kind, l.raw_text, node.line, node.col);
		}
		NodeKind.EXPR_IDENTIFIER -> {
			val id = as_identifier(node);
			return alloc_identifier(&self.arena, id.name, node.line, node.col);
		}
		NodeKind.EXPR_BINARY -> {
			val b = as_binary(node);
			return alloc_binary(&self.arena, b.op, clone_expr(self, b.left, subst), clone_expr(self, b.right, subst), node.line, node.col);
		}
		NodeKind.EXPR_UNARY -> {
			val u = as_unary(node);
			return alloc_unary(&self.arena, u.op, clone_expr(self, u.operand, subst), node.line, node.col);
		}
		NodeKind.EXPR_CALL -> {
			val c = as_call(node);

			// `T.size()` -> integer literal sized for the C representation.
			if (c.callee.kind == NodeKind.EXPR_MEMBER) {
				val m = as_member(c.callee);
				if (m.member == "size" && m.object.kind == NodeKind.EXPR_IDENTIFIER) {
					val sa = subst_lookup(subst, as_identifier(m.object).name);
					if (sa != null) return alloc_literal(&self.arena, LiteralKind.INT, "${ast_type_size(self, sa)}", node.line, node.col);
				}
			}

			if (c.callee.kind == NodeKind.EXPR_MEMBER && c.type_args.len > 0) {
				val mem = as_member(c.callee);
				if (mem.member == "to") {
					val mem_obj = clone_expr(self, mem.object, subst);
					var new_type_args = List<*AstNode>();
					for (ta in c.type_args) new_type_args.add(clone_type(self, ta, subst));
					var new_args = List<*AstNode>();
					new_args.add(mem_obj);
					for (a in c.args) new_args.add(clone_expr(self, a, subst));
					val ft = gen_find(self.symtab.gen.fn_templates, "to");
					if (ft != null) {
						val cname = instantiate_fn(self, ft, new_type_args);
						return alloc_call(&self.arena, alloc_identifier(&self.arena, cname, node.line, node.col), new_args, List<*AstNode>(), node.line, node.col);
					}
				}
			}

			if (c.callee.kind == NodeKind.EXPR_IDENTIFIER && c.type_args.len > 0) {
				val cid = as_identifier(c.callee);
				val ft = gen_find(self.symtab.gen.fn_templates, cid.name);
				if (ft != null) {
					var args = List<*AstNode>();
			for (ta in c.type_args) args.add(clone_type(self, ta, subst));
					val cname = instantiate_fn(self, ft, args);
					var cargs = List<*AstNode>();
			for (a in c.args) cargs.add(clone_expr(self, a, subst));
					return alloc_call(&self.arena, alloc_identifier(&self.arena, cname, node.line, node.col), cargs, List<*AstNode>(), node.line, node.col);
				}
				val st = gen_find(self.symtab.gen.struct_templates, cid.name);
				if (st != null) {
					var args2 = List<*AstNode>();
			for (ta in c.type_args) args2.add(clone_type(self, ta, subst));
					val cty = instantiate_struct(self, st, args2);
					var cargs2 = List<*AstNode>();
			for (a in c.args) cargs2.add(clone_expr(self, a, subst));
					return alloc_call(&self.arena, alloc_identifier(&self.arena, sem_struct(cty).name, node.line, node.col), cargs2, List<*AstNode>(), node.line, node.col);
				}
			}

			var cargs3 = List<*AstNode>();
			for (a in c.args) cargs3.add(clone_expr(self, a, subst));
			return alloc_call(&self.arena, clone_expr(self, c.callee, subst), cargs3, List<*AstNode>(), node.line, node.col);
		}
		NodeKind.EXPR_MEMBER -> {
			val m = as_member(node);
			return alloc_member(&self.arena, clone_expr(self, m.object, subst), m.member, node.line, node.col);
		}
		NodeKind.EXPR_INDEX -> {
			val ix = as_index(node);
			return alloc_index(&self.arena, clone_expr(self, ix.target, subst), clone_expr(self, ix.index, subst), node.line, node.col);
		}
		NodeKind.EXPR_ASSIGN -> {
			val a = as_assign(node);
			return alloc_assign(&self.arena, clone_expr(self, a.target, subst), clone_expr(self, a.value, subst), node.line, node.col);
		}
		NodeKind.EXPR_CAST -> {
			val cst = as_cast(node);
			return alloc_cast(&self.arena, clone_expr(self, cst.expr, subst), clone_type(self, cst.target_type, subst), node.line, node.col);
		}
		NodeKind.EXPR_GROUP -> {
			val g = as_group(node);
			return alloc_group(&self.arena, clone_expr(self, g.expr, subst), node.line, node.col);
		}
		NodeKind.EXPR_IF -> {
			val ie = as_if_expr(node);
			return alloc_if_expr(&self.arena, clone_expr(self, ie.condition, subst), clone_expr(self, ie.then_branch, subst), clone_expr(self, ie.else_branch, subst), node.line, node.col);
		}
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = as_array_literal(node);
			var els = List<*AstNode>();
			for (e in al.elements) els.add(clone_expr(self, e, subst));
			return alloc_array_literal(&self.arena, els, node.line, node.col);
		}
		NodeKind.EXPR_WHEN -> {
			val we = as_when_expr(node);
			var arms = List<WhenArm>();
			for (arm in we.arms) {
				var pats = List<*AstNode>();
				for (pat in arm.patterns) pats.add(clone_expr(self, pat, subst));
				arms.add(WhenArm(pats, arm.is_else, clone_expr(self, arm.body, subst), arm.line, arm.col));
			}
			return alloc_when_expr(&self.arena, clone_expr(self, we.condition, subst), arms, node.line, node.col);
		}
		NodeKind.EXPR_INTERP -> {
			val ie = as_interp(node);
			var parts = List<InterpPart>();
			for (part in ie.parts) {
				parts.add(InterpPart(clone_expr(self, part.expr, subst), part.is_literal));
			}
			return alloc_interp(&self.arena, parts, node.line, node.col);
		}
		else -> return alloc_identifier(&self.arena, "<unsupported-expr>", node.line, node.col);
	}
}

pub fn clone_stmt(var self: &DeclPass, node: *AstNode, subst: *GenSubst): *AstNode {
	if (node == null) return null;
	when (node.kind) {
		NodeKind.STMT_BLOCK -> {
			val b = as_block_stmt(node);
			var ss = List<*AstNode>();
			for (s in b.statements) ss.add(clone_stmt(self, s, subst));
			return alloc_block_stmt(&self.arena, ss, node.line, node.col);
		}
		NodeKind.STMT_EXPR -> {
			val e = as_expr_stmt(node);
			return alloc_expr_stmt(&self.arena, clone_expr(self, e.expr, subst), node.line, node.col);
		}
		NodeKind.STMT_VAR_DECL -> {
			val v = as_var_decl(node);
			var ta: *AstNode = null;
			if (v.type_annotation != null) ta = clone_type(self, v.type_annotation, subst);
			return alloc_var_decl(&self.arena, v.is_mut, v.name, ta, clone_expr(self, v.initializer, subst), node.line, node.col);
		}
		NodeKind.STMT_IF -> {
			val s = as_if_stmt(node);
			return alloc_if_stmt(&self.arena, clone_expr(self, s.condition, subst), clone_stmt(self, s.then_branch, subst), clone_stmt(self, s.else_branch, subst), node.line, node.col);
		}
		NodeKind.STMT_WHILE -> {
			val w = as_while_stmt(node);
			return alloc_while_stmt(&self.arena, clone_expr(self, w.condition, subst), clone_stmt(self, w.body, subst), node.line, node.col);
		}
		NodeKind.STMT_FOR -> {
			val f = as_for_stmt(node);
			return alloc_for_stmt(
				&self.arena, f.var_name, f.is_range, f.is_open, f.is_half_open,
				clone_expr(self, f.iterable, subst),
				clone_expr(self, f.range_start, subst),
				clone_expr(self, f.range_end, subst),
				clone_stmt(self, f.body, subst),
				node.line, node.col
			);
		}
		NodeKind.STMT_RETURN -> {
			val r = as_return_stmt(node);
			return alloc_return_stmt(&self.arena, clone_expr(self, r.value, subst), node.line, node.col);
		}
		NodeKind.STMT_BREAK -> return alloc_break_stmt(&self.arena, node.line, node.col);
		NodeKind.STMT_CONTINUE -> return alloc_continue_stmt(&self.arena, node.line, node.col);
		NodeKind.STMT_WHEN -> {
			val w = as_when_stmt(node);
			var arms = List<WhenStmtArm>();
			for (arm in w.arms) {
				var pats = List<*AstNode>();
				for (pat in arm.patterns) pats.add(clone_expr(self, pat, subst));
				arms.add(WhenStmtArm(pats, arm.is_else, clone_stmt(self, arm.body, subst), arm.line, arm.col));
			}
			return alloc_when_stmt(&self.arena, clone_expr(self, w.condition, subst), arms, node.line, node.col);
		}
		else -> return null;
	}
}

pub fn clone_fn(var self: &DeclPass, node: *AstNode, subst: *GenSubst, new_name: str): *AstNode {
	val f = as_fn_decl(node);
	var params = List<Param>();
	for (p in f.params) {
		var pt: *AstNode = null;
		if (p.type_node != null) pt = clone_type(self, p.type_node, subst);
		params.add(Param(p.name, pt, p.is_mut, p.has_val));
	}
	var rt: *AstNode = null;
	if (f.return_type != null) rt = clone_type(self, f.return_type, subst);
	return alloc_fn_decl(&self.arena, new_name, List<GenericParam>(), params, rt, clone_stmt(self, f.body, subst), f.is_pub, node.line, node.col);
}

pub fn clone_struct(var self: &DeclPass, node: *AstNode, subst: *GenSubst, new_name: str): *AstNode {
	val s = as_struct_decl(node);
	var fields = List<AstStructField>();
	for (f in s.fields) {
		fields.add(AstStructField(f.name, clone_type(self, f.type_node, subst), f.is_pub));
	}
	return alloc_struct_decl(&self.arena, new_name, List<GenericParam>(), fields, s.is_pub, node.line, node.col);
}

pub fn clone_impl(var self: &DeclPass, node: *AstNode, subst: *GenSubst, new_struct_name: str): *AstNode {
	val im = as_impl_decl(node);
	var methods = List<*AstNode>();
	for (m in im.methods) {
		val mf = as_fn_decl(m);
		// Keep the source method name: collect_impl mangles it against the
		// concrete struct name and registers it for method lookup.
		methods.add(clone_fn(self, m, subst, mf.name));
	}
	// Keep the trait name: a monomorphized `impl Trait for List<T>` must still
	// be checked against the trait and pick up its default methods.
	return alloc_impl_decl(&self.arena, new_struct_name, List<GenericParam>(), im.trait_name, methods, node.line, node.col);
}

// ----------------------------------------------------------------------------
// Generic-use rewriting over non-template declarations
// ----------------------------------------------------------------------------

pub fn rewrite_generics(var self: &DeclPass, node: *AstNode) {
	if (node == null) return;

	when (node.kind) {
		NodeKind.TYPE_NAMED -> {
			val nt = as_named_type(node) as &NamedType;
			if (nt.type_args.len > 0) {
				val tmpl = gen_find(self.symtab.gen.struct_templates, nt.name);
				if (tmpl != null) {
					val cty = instantiate_struct(self, tmpl, nt.type_args);
					nt.name = sem_struct(cty).name;
					nt.type_args = List<*AstNode>();
					return;
				}
			}
			for (ta in nt.type_args) rewrite_generics(self, ta);
		}
		NodeKind.TYPE_POINTER -> rewrite_generics(self, as_pointer_type(node).pointee);
		NodeKind.TYPE_ARRAY -> rewrite_generics(self, as_array_type(node).element_type);

		NodeKind.EXPR_CALL -> {
			val c = as_call(node) as &CallExpr;
			if (c.callee.kind == NodeKind.EXPR_MEMBER && c.type_args.len > 0) {
				val mem = as_member(c.callee);
				if (mem.member == "to") {
					val mem_obj = mem.object;
					c.callee = alloc_identifier(&self.arena, "to", node.line, node.col);
					var new_args = List<*AstNode>();
					new_args.add(mem_obj);
					for (a in c.args) new_args.add(a);
					c.args = new_args;
				}
			}
			if (c.callee.kind == NodeKind.EXPR_IDENTIFIER && c.type_args.len > 0) {
				val cid = as_identifier(c.callee) as &IdentifierExpr;
				val ft = gen_find(self.symtab.gen.fn_templates, cid.name);
				if (ft != null) {
					val cname = instantiate_fn(self, ft, c.type_args);
					cid.name = cname;
					c.type_args = List<*AstNode>();
				} else {
					val st = gen_find(self.symtab.gen.struct_templates, cid.name);
					if (st != null) {
						val cty = instantiate_struct(self, st, c.type_args);
						cid.name = sem_struct(cty).name;
						c.type_args = List<*AstNode>();
					}
				}
			}
			rewrite_generics(self, c.callee);
			for (a in c.args) rewrite_generics(self, a);
		}
		NodeKind.EXPR_BINARY -> {
			val b = as_binary(node);
			rewrite_generics(self, b.left);
			rewrite_generics(self, b.right);
		}
		NodeKind.EXPR_UNARY -> rewrite_generics(self, as_unary(node).operand);
		NodeKind.EXPR_MEMBER -> rewrite_generics(self, as_member(node).object);
		NodeKind.EXPR_INDEX -> {
			val ix = as_index(node);
			rewrite_generics(self, ix.target);
			rewrite_generics(self, ix.index);
		}
		NodeKind.EXPR_ASSIGN -> {
			val a = as_assign(node);
			rewrite_generics(self, a.target);
			rewrite_generics(self, a.value);
		}
		NodeKind.EXPR_CAST -> {
			val cst = as_cast(node);
			rewrite_generics(self, cst.expr);
			rewrite_generics(self, cst.target_type);
		}
		NodeKind.EXPR_GROUP -> rewrite_generics(self, as_group(node).expr);
		NodeKind.EXPR_IF -> {
			val ie = as_if_expr(node);
			rewrite_generics(self, ie.condition);
			rewrite_generics(self, ie.then_branch);
			rewrite_generics(self, ie.else_branch);
		}
		NodeKind.EXPR_ARRAY_LITERAL -> {
			val al = as_array_literal(node);
			for (e in al.elements) rewrite_generics(self, e);
		}
		NodeKind.EXPR_WHEN -> {
			val we = as_when_expr(node);
			rewrite_generics(self, we.condition);
			for (arm in we.arms) {
				for (pat in arm.patterns) rewrite_generics(self, pat);
				rewrite_generics(self, arm.body);
			}
		}
		NodeKind.EXPR_INTERP -> {
			val ie = as_interp(node);
			for (part in ie.parts) rewrite_generics(self, part.expr);
		}

		NodeKind.STMT_BLOCK -> {
			val b = as_block_stmt(node);
			for (s in b.statements) rewrite_generics(self, s);
		}
		NodeKind.STMT_EXPR -> rewrite_generics(self, as_expr_stmt(node).expr);
		NodeKind.STMT_VAR_DECL -> {
			val v = as_var_decl(node);
			rewrite_generics(self, v.type_annotation);
			rewrite_generics(self, v.initializer);
		}
		NodeKind.STMT_IF -> {
			val s = as_if_stmt(node);
			rewrite_generics(self, s.condition);
			rewrite_generics(self, s.then_branch);
			rewrite_generics(self, s.else_branch);
		}
		NodeKind.STMT_WHILE -> {
			val w = as_while_stmt(node);
			rewrite_generics(self, w.condition);
			rewrite_generics(self, w.body);
		}
		NodeKind.STMT_FOR -> {
			val f = as_for_stmt(node);
			rewrite_generics(self, f.iterable);
			rewrite_generics(self, f.range_start);
			rewrite_generics(self, f.range_end);
			rewrite_generics(self, f.body);
		}
		NodeKind.STMT_RETURN -> rewrite_generics(self, as_return_stmt(node).value);
		NodeKind.STMT_WHEN -> {
			val w = as_when_stmt(node);
			rewrite_generics(self, w.condition);
			for (arm in w.arms) {
				for (pat in arm.patterns) rewrite_generics(self, pat);
				rewrite_generics(self, arm.body);
			}
		}

		NodeKind.DECL_STRUCT -> {
			val s = as_struct_decl(node);
			for (fld in s.fields) rewrite_generics(self, fld.type_node);
		}
		NodeKind.DECL_FN -> {
			val f = as_fn_decl(node);
			for (p in f.params) rewrite_generics(self, p.type_node);
			rewrite_generics(self, f.return_type);
			rewrite_generics(self, f.body);
		}
		NodeKind.DECL_IMPL -> {
			val im = as_impl_decl(node);
			for (m in im.methods) rewrite_generics(self, m);
		}
		NodeKind.DECL_CONST -> {
			val c = as_const_decl(node);
			rewrite_generics(self, c.type_node);
			rewrite_generics(self, c.value);
		}
		NodeKind.DECL_EXTERN_BLOCK -> {
			val ext = as_extern_block(node);
			for (d in ext) rewrite_generics(self, d);
		}
		else -> {}
	}
}
