// ============================================================================
// DeclPass - Top-level Declarations Collector
// ============================================================================

pub struct DeclPass {
	pub symtab: SymbolTable,
	pub arena: Arena,
	pub current_module: str,
	pub errors: List<str>,
	// Currently collecting declarations inside the `extern "libc" { ... }` block
	pub is_extern: bool,
	pub current_self_type: *Type
}

pub fn alloc_primitive(var arena: &Arena, base: Type): *Type => arena.primitive_type(base);

// Source names carried by more than one method of an impl, i.e. overloads.
fn overloaded_names(im: &ImplDecl): List<str> {
	var names = List<str>();
	for (a in 0..<im.methods.len) {
		val na = im.methods[a].to<FnDecl>().name;
		if (list_has_str(names, na)) continue;
		for (b in (a + 1)..<im.methods.len) {
			if (im.methods[b].to<FnDecl>().name == na) {
				names.add(na);
				break;
			}
		}
	}
	return names;
}

fn list_has_str(list: List<str>, v: str): bool {
	for (x in list) {
		if (x == v) return true;
	}
	return false;
}

// The built-in type named `name`, or null when `name` is not a primitive.
// Primitives are not registered as symbols, so this name table is also how
// `impl <primitive>` blocks are recognized.
pub fn resolve_primitive_name(var arena: &Arena, name: str): *Type => when (name) {
	"none" -> alloc_primitive(arena, type_none());
	"bool" -> alloc_primitive(arena, type_bool());
	"char" -> alloc_primitive(arena, type_char());
	"i8" -> alloc_primitive(arena, type_i8());
	"i16" -> alloc_primitive(arena, type_i16());
	"i32" -> alloc_primitive(arena, type_i32());
	"i64" -> alloc_primitive(arena, type_i64());
	"isz" -> alloc_primitive(arena, type_isz());
	"u8" -> alloc_primitive(arena, type_u8());
	"u16" -> alloc_primitive(arena, type_u16());
	"u32" -> alloc_primitive(arena, type_u32());
	"u64" -> alloc_primitive(arena, type_u64());
	"usz" -> alloc_primitive(arena, type_usz());
	"f32" -> alloc_primitive(arena, type_f32());
	"f64" -> alloc_primitive(arena, type_f64());
	"str" -> alloc_primitive(arena, type_str());
	else -> null;
};

pub fn parse_decimal_i64(s: str): i64 {
	var v: i64 = 0;
	for (c in s) {
		if (c >= '0' && c <= '9') {
			v = v * 10 + (((c as i32) - 48) as i64);
		} else if (c != '_') {
			break;
		}
	}
	return v;
}

// Inserts `m` into `out`, replacing a same-named entry so a derived trait's
// method wins over the base one it inherits.
fn trait_put_method(out: &List<*TraitMethod>, m: *TraitMethod) {
	for (i in 0..<out.len) {
		val e = (*out)[i];
		if (e.name == m.name && e.arity == m.arity) {
			(*out)[i] = m;
			return;
		}
	}
	out.add(m);
}

impl DeclPass {

	pub fn new(): DeclPass {
		var arena = Arena(65536);
		return Self(SymbolTable(), arena, "", List<str>(), false, null);
	}

	pub fn make<T>(var self, kind: NodeKind, data: T, line: usz, col: usz): *AstNode
		=> self.arena.alloc_node<T>(kind, data, line, col);

	pub fn named_type(var self, name: str, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.make<NamedType>(NodeKind.TYPE_NAMED, NamedType(name, type_args), line, col);

	pub fn pointer_type(var self, is_mut: bool, pointee: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<PointerType>(NodeKind.TYPE_POINTER, PointerType(is_mut, pointee), line, col);

	pub fn array_type(var self, elem: *AstNode, size: usz, line: usz, col: usz): *AstNode
		=> self.make<ArrayType>(NodeKind.TYPE_ARRAY, ArrayType(elem, size), line, col);

	pub fn nullable_type(var self, inner: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<NullableType>(NodeKind.TYPE_NULLABLE, NullableType(inner), line, col);

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz): *AstNode
		=> self.make<LiteralExpr>(NodeKind.EXPR_LITERAL, LiteralExpr(lk, raw), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz): *AstNode
		=> self.make<IdentifierExpr>(NodeKind.EXPR_IDENTIFIER, IdentifierExpr(name), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<BinaryExpr>(NodeKind.EXPR_BINARY, BinaryExpr(left, op, right), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<UnaryExpr>(NodeKind.EXPR_UNARY, UnaryExpr(op, operand), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.make<CallExpr>(NodeKind.EXPR_CALL, CallExpr(callee, args, type_args), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz): *AstNode
		=> self.make<MemberExpr>(NodeKind.EXPR_MEMBER, MemberExpr(obj, member), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<IndexExpr>(NodeKind.EXPR_INDEX, IndexExpr(target, index), line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<AssignExpr>(NodeKind.EXPR_ASSIGN, AssignExpr(target, op, value), line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<UpdateExpr>(NodeKind.EXPR_UPDATE, UpdateExpr(op, target), line, col);

	pub fn cast(var self, expr: *AstNode, target_type: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<CastExpr>(NodeKind.EXPR_CAST, CastExpr(expr, target_type), line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<GroupExpr>(NodeKind.EXPR_GROUP, GroupExpr(expr), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<IfExpr>(NodeKind.EXPR_IF, IfExpr(condition, then_branch, else_branch), line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<ArrayLiteralExpr>(NodeKind.EXPR_ARRAY_LITERAL, ArrayLiteralExpr(elements, list_struct_name, elem_type_node), line, col);

	pub fn when_expr(var self, condition: *AstNode, arms: List<WhenArm>, line: usz, col: usz): *AstNode
		=> self.make<WhenExpr>(NodeKind.EXPR_WHEN, WhenExpr(condition, arms), line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz): *AstNode
		=> self.make<InterpExpr>(NodeKind.EXPR_INTERP, InterpExpr(parts), line, col);

	pub fn block_stmt(var self, statements: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.make<BlockStmt>(NodeKind.STMT_BLOCK, BlockStmt(statements), line, col);

	pub fn expr_stmt(var self, expr: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<ExprStmt>(NodeKind.STMT_EXPR, ExprStmt(expr), line, col);

	pub fn var_decl(var self, is_mut: bool, name: str, type_annotation: *AstNode, initializer: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<VarDeclStmt>(NodeKind.STMT_VAR_DECL, VarDeclStmt(is_mut, name, type_annotation, initializer), line, col);

	pub fn if_stmt(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<IfStmt>(NodeKind.STMT_IF, IfStmt(condition, then_branch, else_branch), line, col);

	pub fn while_stmt(var self, condition: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<WhileStmt>(NodeKind.STMT_WHILE, WhileStmt(condition, body), line, col);

	pub fn for_stmt(var self, var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode, range_start: *AstNode, range_end: *AstNode, body: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<ForStmt>(NodeKind.STMT_FOR, ForStmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body), line, col);

	pub fn return_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<ReturnStmt>(NodeKind.STMT_RETURN, ReturnStmt(value), line, col);

	pub fn break_stmt(var self, line: usz, col: usz): *AstNode
		=> self.make<BreakStmt>(NodeKind.STMT_BREAK, BreakStmt(0), line, col);

	pub fn continue_stmt(var self, line: usz, col: usz): *AstNode
		=> self.make<ContinueStmt>(NodeKind.STMT_CONTINUE, ContinueStmt(0), line, col);

	pub fn when_stmt(var self, condition: *AstNode, arms: List<WhenStmtArm>, line: usz, col: usz): *AstNode
		=> self.make<WhenStmt>(NodeKind.STMT_WHEN, WhenStmt(condition, arms), line, col);

	pub fn yield_stmt(var self, value: *AstNode, line: usz, col: usz): *AstNode
		=> self.make<YieldStmt>(NodeKind.STMT_YIELD, YieldStmt(value), line, col);

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz): *AstNode
		=> self.make<ModuleDecl>(NodeKind.DECL_MODULE, ModuleDecl(path, full_path), line, col);

	pub fn fn_decl(var self, name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode, body: *AstNode, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.make<FnDecl>(NodeKind.DECL_FN, FnDecl(name, type_params, params, return_type, body, is_pub), line, col);

	pub fn struct_decl(var self, name: str, type_params: List<GenericParam>, fields: List<AstStructField>, is_pub: bool, line: usz, col: usz): *AstNode
		=> self.make<StructDecl>(NodeKind.DECL_STRUCT, StructDecl(name, type_params, fields, is_pub), line, col);

	pub fn impl_decl(var self, struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.make<ImplDecl>(NodeKind.DECL_IMPL, ImplDecl(struct_name, type_params, trait_name, methods), line, col);

	pub fn c_name_for(self, name: str): str {
		if (self.is_extern || name == "main") return name;
		return str_mangle_symbol(self.current_module, name);
	}

	pub fn report_error(var self, node: *AstNode, msg: str) {
		val loc = "Line ${node.line}, Column ${node.col}: ";
		if (self.current_module.len > 0) {
			self.errors.add("${self.current_module}: ${loc}${msg}");
		} else self.errors.add(loc + msg);
	}

	pub fn resolve_ast_type(var self, node: *AstNode): *Type {
		if (node == null) return alloc_primitive(&self.arena, type_none());

		return when (node.kind) {
			NodeKind.TYPE_NAMED -> {
				val named = node.to<NamedType>() as &NamedType;
				val name = named.name;

				if (name == "Self" && self.current_self_type != null) {
					val sinfo = self.current_self_type.as_struct();
					if (sinfo.c_name != "") named.name = sinfo.c_name;
					else named.name = sinfo.name;
					yield self.current_self_type;
				}

				val prim = resolve_primitive_name(&self.arena, name);
				if (prim != null) yield prim;

				// Generic struct instantiation: List<i32> -> concrete struct.
				if (named.type_args.len > 0) {
					val tmpl = self.find_struct_template(name);
					if (tmpl != null) {
						val cty = self.instantiate_struct(tmpl, named.type_args);
						named.name = cty.as_struct().name;
						named.type_args = List<*AstNode>();
						yield cty;
					}
				}

				// Look up a user-defined type (Struct / Enum)
				val sym = self.symtab.lookup(name);
				if (sym != null) {
					// Switch to the mangled C name (if any) so the backend emits the right name
					if (sym.c_name != name) named.name = sym.c_name;
					yield sym.type_ptr;
				}

				self.report_error(node, "Unknown type '${name}'");
				yield alloc_primitive(&self.arena, type_none());
			}
			NodeKind.TYPE_POINTER -> {
				val ptr_ast = node.to<PointerType>();
				val pointee = self.resolve_ast_type(ptr_ast.pointee);
				yield alloc_pointer_type(&self.arena, pointee, ptr_ast.is_mut);
			}
			NodeKind.TYPE_ARRAY -> {
				val arr_ast = node.to<ArrayType>();
				val elem = self.resolve_ast_type(arr_ast.element_type);
				yield alloc_array_type(&self.arena, elem, arr_ast.size);
			}
			NodeKind.TYPE_NULLABLE -> {
				val null_ast = node.to<NullableType>();
				val inner_ty = self.resolve_ast_type(null_ast.inner);
				var res_ty = inner_ty;
				if (inner_ty.kind == DataType.POINTER) {
					val pt = inner_ty.as_pointer();
					res_ty = alloc_nullable_pointer_type(&self.arena, pt.pointee, pt.is_mut);
				} else {
					self.report_error(node, "Nullable modifier '?' is only supported on pointer types");
				}
				yield res_ty;
			}
			else -> alloc_primitive(&self.arena, type_none());
		};
	}

// Evaluates a constant enum member value (integer literal, optionally negated).
	pub fn enum_const_i64(var self, expr: *AstNode): i64 {
		if (expr.kind == NodeKind.EXPR_LITERAL) {
			val lit = expr.to<LiteralExpr>();
			return parse_decimal_i64(lit.raw_text);
		}
		if (expr.kind == NodeKind.EXPR_UNARY) {
			val un = expr.to<UnaryExpr>();
			if (un.op == TokenType.MINUS) return 0 - self.enum_const_i64(un.operand);
		}
		self.report_error(expr, "Enum member value must be an integer constant");
		return 0;
	}

	pub fn collect_impl(var self, node: *AstNode) {
		val im = node.to<ImplDecl>() as &ImplDecl;

		// Generic impls (e.g. `impl List<T>`) are lowered by monomorphization; skip here.
		if (im.type_params.len > 0) return;

		// `impl <primitive> { ... }`: the methods extend a built-in type.
		val prim = resolve_primitive_name(&self.arena, im.struct_name);
		if (prim != null) {
			self.collect_prim_impl(node, im, prim);
			return;
		}

		val st_sym = self.symtab.lookup(im.struct_name);
		if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) {
			self.report_error(node, "Cannot impl methods for unknown type '${im.struct_name}'");
			return;
		}

		val st_type = st_sym.type_ptr;
		val st_c_name = st_sym.c_name;
		val st_info = st_type.as_struct_mut();

		self.current_self_type = st_type;

		// Rename so the backend can learn the receiver type of each method.
		im.struct_name = st_c_name;

		// `impl Trait for Struct`: verify the contract and pull in default methods.
		if (im.trait_name != "") self.apply_trait(node, im, st_info.name);

		// Methods may be overloaded, so each needs a distinct C name.
		val overloaded = overloaded_names(im);

		for (m_node in im.methods) {
			val f = m_node.to<FnDecl>() as &FnDecl;
			if (f.type_params.len > 0) continue;

			if (f.name == "new") {
				for (p in f.params) {
					if (p.name == "self") {
						self.report_error(m_node, "Constructor 'new' cannot have a 'self' parameter in struct '${st_info.name}'");
					}
				}
			}

			var param_types = List<*Type>();

			for (p in f.params) {
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver: `*Struct` for `val self`, `*mut Struct` for `var self`.
					pt = alloc_pointer_type(&self.arena, st_type, p.is_mut);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types.add(pt);
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type) else alloc_primitive(&self.arena, type_none());

			val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);

			val base = "${st_c_name}_${f.name}";
			var m_c_name = base;
			if (list_has_str(overloaded, f.name)) m_c_name = "${base}_${param_types.len}";
			// Two methods with the same name and arity still need distinct names.
			var k: usz = 2;
			while (st_info.find_method_c(m_c_name) != null) {
				m_c_name = "${base}_${param_types.len}_${k}";
				k++;
			}

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type);
			st_info.methods.add(mi);

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}

		self.current_self_type = null;
	}


// Registers the methods of `impl <primitive> { ... }`. There is no C struct to
// hang them on, so the receiver is typed explicitly as the primitive name (the
// backend then passes it by value), and each method goes into the primitive
// method table so `x.m()` can find it.
	pub fn collect_prim_impl(var self, node: *AstNode, im: &ImplDecl, prim: *Type) {
		val prim_name = im.struct_name;
		// Clear the name so codegen does not treat `self` as a pointer receiver.
		im.struct_name = "";

		if (im.trait_name != "") self.apply_trait(node, im, prim_name);

		val overloaded = overloaded_names(im);
		var used = List<str>();

		for (m_node in im.methods) {
			val f = m_node.to<FnDecl>() as &FnDecl;
			if (f.type_params.len > 0) continue;
			var param_types = List<*Type>();

			for (i in 0..<f.params.len) {
				val p = f.params[i];
				var pt: *Type = null;
				if (p.name == "self" && p.type_node == null) {
					// Receiver by value: spell its type so the backend emits `i32 self`.
					pt = prim;
					val rt = self.named_type(prim_name, List<*AstNode>(), node.line, node.col);
					f.params[i] = Param(p.name, rt, p.is_mut, p.has_val);
				} else {
					pt = self.resolve_ast_type(p.type_node);
				}
				param_types.add(pt);
			}

			val ret_type = if (f.return_type != null) self.resolve_ast_type(f.return_type) else alloc_primitive(&self.arena, type_none());

			val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);

			val base = "${prim_name}_${f.name}";
			var m_c_name = base;
			if (list_has_str(overloaded, f.name)) m_c_name = "${base}_${param_types.len}";
			var k: usz = 2;
			while (list_has_str(used, m_c_name)) {
				m_c_name = "${base}_${param_types.len}_${k}";
				k++;
			}
			used.add(m_c_name);

			if (self.symtab.find_prim_method_arity(prim.kind, f.name, f.params.len) != null) {
				self.report_error(m_node, "Duplicate method '${f.name}' with ${f.params.len} parameter(s) for built-in type '${prim_name}'");
			}

			val mi = self.arena.alloc<MethodInfo>();
			*mi = MethodInfo(f.name, m_c_name, fn_type);
			val pm = self.arena.alloc<PrimMethod>();
			*pm = PrimMethod(prim.kind, mi);
			self.symtab.register_prim_method(pm);

			// Uniquify the AST name so the backend emits the mangled method name.
			f.name = m_c_name;
		}
	}

// Records that `struct_name` implements `t` and, transitively, every trait that
// `t` inherits: implementing a trait means implementing its base traits too, so
// a `<T: Base>` bound is satisfied by an `impl Derived for T` when
// `Derived : Base`. The already-recorded test also breaks a cyclic base chain.
	pub fn trait_record_impl(var self, t: *TraitInfo, struct_name: str) {
		if (t == null) return;
		if (t.has_impl(struct_name)) return;
		t.impls.add(struct_name);
		for (bname in t.bases) self.trait_record_impl(self.symtab.find_trait(bname), struct_name);
	}

// Flattens a trait and its base traits into one method list: base traits are
// visited first, so a method declared in a derived trait replaces a same-named
// inherited one. `seen` stops a cycle in a mis-declared `trait A : B` /
// `trait B : A` chain.
	pub fn trait_effective(var self, t: *TraitInfo, out: &List<*TraitMethod>, seen: &List<str>) {
		if (t == null) return;
		for (name in seen) {
			if (name == t.name) return;
		}
		seen.add(t.name);

		for (bname in t.bases) self.trait_effective(self.symtab.find_trait(bname), out, seen);
		for (m in t.methods) trait_put_method(out, m);
	}

// Applies the trait named by `im.trait_name` to an `impl Trait for Struct`
// block: every required method (one without a body) must be provided, and every
// default method the impl left out is copied in. A copy is an ordinary method
// AST node, so the backend emits it like a hand-written one. Generic impls
// return earlier, so no type substitution is ever needed here.
	pub fn apply_trait(var self, node: *AstNode, im: &ImplDecl, struct_name: str) {
		val t = self.symtab.find_trait(im.trait_name);
		if (t == null) {
			self.report_error(node, "Unknown trait '${im.trait_name}'");
			return;
		}

		// Remember the implementation so a `<T: Trait>` bound can be checked later.
		self.trait_record_impl(t, struct_name);

		// A trait inherits every method of its base traits, so the contract covers
		// the flattened set rather than just the methods written in this trait.
		var effective = List<*TraitMethod>();
		var seen = List<str>();
		self.trait_effective(t, &effective, &seen);

		for (tm in effective) {
			var have = false;
			for (m in im.methods) {
				val f = m.to<FnDecl>();
				if (f.name == tm.name && f.params.len == tm.arity) have = true;
			}
			if (have) continue;

			if (!tm.has_default) {
				self.report_error(node, "Struct '${struct_name}' does not implement required trait method '${tm.name}' of trait '${t.name}'");
				continue;
			}
			im.methods.add(self.clone_fn(tm.node, null, tm.name));
		}
	}
}
