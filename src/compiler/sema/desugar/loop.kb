mod compiler.sema.desugar.loop;

// ============================================================================
// Body checker helper - `for` desugaring
//
// Rewrites `for (x in seq)` (Iterable vs `.len`/`.data`) and the three range
// forms into a block + `while`, keeping `continue` semantics (step injection)
// and unsigned-safe counters. Called from `body.stmt` while checking.
// ============================================================================

use std.mem.arena.*;
use std.collections.list.*;

use compiler.ast.node.*;
use compiler.ast.stmt.*;
use compiler.ast.expr.*;
use compiler.ast.types.*;
use compiler.ast.builder.*;
use compiler.lexer.token.*;
use compiler.sema.body.pass.BodyPass;

// ============================================================================
// For-loop AST Lowering (Desugaring)
// ============================================================================

// The iterated expression is re-evaluated on every iteration, so only lvalues
// are accepted: a temporary would dangle and a call would run once per element.
pub fn for_is_lvalue(node: *AstNode): bool => when (node) {
	is MemberExpr -> if (node.is_safe) false else for_is_lvalue(node.object);
	is GroupExpr -> for_is_lvalue(node.expr);
	is IdentifierExpr -> true;
	else -> false;
};

impl Arena {
	pub fn for_usz_type(var self, line: usz, col: usz) =>
		self.named_type("usz", List<*AstNode>(), line, col);

	pub fn for_id(var self, name: str, line: usz, col: usz) =>
		self.identifier(name, line, col);

	pub fn for_num(var self, text: str, line: usz, col: usz) =>
		self.literal(LiteralKind.INT, text, line, col);

	// `__for_i <cmp> __for_e`
	pub fn for_i_cmp(var self, op: TokenType, line: usz, col: usz) => self.binary(
		op, self.for_id("__for_i", line, col),
		self.for_id("__for_e", line, col), line, col
	);

	// `__for_go = <value>;`
	pub fn for_set_go(var self, value: *AstNode, line: usz, col: usz) => self.expr_stmt(
		self.assign(self.for_id("__for_go", line, col), value, line, col),
		line, col
	);

	// `__for_i = __for_i <+|-> 1;`
	pub fn for_bump(var self, op: TokenType, line: usz, col: usz) => self.expr_stmt(
		self.assign(
			self.for_id("__for_i", line, col),
			self.binary(op,
				self.for_id("__for_i", line, col),
				self.for_num("1", line, col), line, col
			),
			line, col
		),
		line, col
	);

	// `if (__for_up) { <up_stmt> } else { <down_stmt> }`
	pub fn for_by_dir(var self, up_stmt: *AstNode, down_stmt: *AstNode, line: usz, col: usz): *AstNode {
		var up_stmts = List<*AstNode>();
		up_stmts += up_stmt;
		var down_stmts = List<*AstNode>();
		down_stmts += down_stmt;
		return self.if_stmt(
			self.for_id("__for_up", line, col),
			self.block_stmt(up_stmts, line, col),
			self.block_stmt(down_stmts, line, col),
			line, col
		);
	}

	// Replaces every `continue` belonging to this loop with `{ <step>; continue; }`
	// so `continue` cannot skip the counter update. Bodies of nested loops are left
	// alone: their `continue` targets the inner loop. When `bp` is set (an
	// instance body is being checked), the replacement is recorded per instance
	// instead of on the shared continue node.
	pub fn for_inject_step(var self, node: *AstNode, step: &List<*AstNode>, bp: *BodyPass = null) {
		if (node == null) return;

		val target = node;
		when (target) {
			is BlockStmt -> for (stmt in target.statements) self.for_inject_step(stmt, step, bp);
			is IfStmt -> {
				self.for_inject_step(target.then_branch, step, bp);
				self.for_inject_step(target.else_branch, step, bp);
			}
			is WhenStmt -> for (arm in target.arms) self.for_inject_step(arm.body, step, bp);
			is VarDeclStmt -> self.for_inject_step_expr(target.initializer, step, bp);
			is ExprStmt -> self.for_inject_step_expr(target.expr, step, bp);
			is ContinueStmt -> {
				var stmts = List<*AstNode>();
				for (s in step) stmts += s;
				stmts += self.continue_stmt(node.line, node.col);
				val block = self.block_stmt(stmts, node.line, node.col);
				if (bp != null) bp.set_resolved(node, block);
				else node.resolved_node = block;
			}
		}
	}

	fn for_inject_step_expr(var self, expr: *AstNode, step: &List<*AstNode>, bp: *BodyPass = null) {
		if (expr == null) return;
		var cur = expr;
		while (cur != null) {
			if (cur is GroupExpr as g) cur = g.expr;
			else break;
		}
		if (cur == null) return;
		if (cur is BinaryExpr as bin && bin.op == TokenType.QUESTION_COLON) {
			self.for_inject_step(bin.right, step, bp);
		} else if (cur is AssignExpr as asg) {
			self.for_inject_step_expr(asg.value, step, bp);
		}
	}

	// `for (v in seq)` where `seq` implements `Iterable`: index through the trait.
	pub fn desugar_for_iter_method(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_n: usz = <iterable>.count();
		val count_call = self.call(self.member(fs.iterable, "count", line, col), List<*AstNode>(), List<*AstNode>(), line, col);
		pre += self.var_decl(false, "__for_n", self.for_usz_type(line, col), count_call, line, col);
		// var __for_i: usz = 0;
		pre += self.var_decl(true, "__for_i", self.for_usz_type(line, col),
			self.for_num("0", line, col), line, col);

		// val <v> = <iterable>.at(__for_i);
		var at_args = List<*AstNode>();
		at_args += self.for_id("__for_i", line, col);
		val at_call = self.call(self.member(fs.iterable, "at", line, col), at_args, List<*AstNode>(), line, col);
		head += self.var_decl(false, fs.var_name, null, at_call, line, col);

		step += self.for_bump(TokenType.PLUS, line, col);

		// __for_i < __for_n
		return self.binary(TokenType.LESS, self.for_id("__for_i", line, col), self.for_id("__for_n", line, col), line, col);
	}

	// `for (v in <iterable>)`: index over the container's `.data` storage, caching
	// `.len` up front (for `str` that also removes a strlen call per iteration).
	pub fn desugar_for_iterable(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_n: usz = <iterable>.len;
		pre += self.var_decl(false, "__for_n", self.for_usz_type(line, col),
			self.member(fs.iterable, "len", line, col), line, col);
		// var __for_i: usz = 0;
		pre += self.var_decl(true, "__for_i", self.for_usz_type(line, col),
			self.for_num("0", line, col), line, col);

		// val <v> = <iterable>.data[__for_i];
		head += self.var_decl(false, fs.var_name, null,
			self.index(self.member(fs.iterable, "data", line, col), self.for_id("__for_i", line, col), line, col),
			line, col);

		step += self.for_bump(TokenType.PLUS, line, col);

		// __for_i < __for_n
		return self.binary(TokenType.LESS, self.for_id("__for_i", line, col), self.for_id("__for_n", line, col), line, col);
	}

	// `for (v in a..b)` (closed) / `for (v in a..<b)` (half-open) /
	// `for (v in a>..<b)` (open, exclusive ends).
	pub fn desugar_for_range(
		var self,
		pre: &List<*AstNode>,
		head: &List<*AstNode>,
		step: &List<*AstNode>,
		fs: *ForStmt,
		line: usz,
		col: usz
	): *AstNode {
		// val __for_e = <end>;
		pre += self.var_decl(false, "__for_e", null, fs.range_end, line, col);
		// var __for_i = __for_e;  then __for_i = <start>;
		pre += self.var_decl(true, "__for_i", null, self.for_id("__for_e", line, col), line, col);
		pre += self.expr_stmt(self.assign(self.for_id("__for_i", line, col), fs.range_start, line, col), line, col);
		// val __for_up = __for_i <= __for_e;
		pre += self.var_decl(false, "__for_up", null, self.for_i_cmp(TokenType.LESS_EQUAL, line, col), line, col);

		if (fs.is_open) {
			pre += self.for_by_dir(self.for_bump(TokenType.PLUS, line, col), self.for_bump(TokenType.MINUS, line, col), line, col);
		}

		pre += self.var_decl(true, "__for_go", null, self.literal(LiteralKind.BOOL, "false", line, col), line, col);
		if (fs.is_open || fs.is_half_open) {
			pre += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER, line, col), line, col),
				line, col);
		} else {
			pre += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS_EQUAL, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER_EQUAL, line, col), line, col),
				line, col);
		}

		// val <v> = __for_i;
		head += self.var_decl(false, fs.var_name, null, self.for_id("__for_i", line, col), line, col);

		// Is there another element? Then move the counter (never past the end).
		if (fs.is_open || fs.is_half_open) {
			step += self.for_by_dir(
				self.for_set_go(self.binary(TokenType.LESS,
					self.binary(TokenType.PLUS, self.for_id("__for_i", line, col), self.for_num("1", line, col), line, col),
					self.for_id("__for_e", line, col), line, col), line, col),
				self.for_set_go(self.binary(TokenType.GREATER,
					self.binary(TokenType.MINUS, self.for_id("__for_i", line, col), self.for_num("1", line, col), line, col),
					self.for_id("__for_e", line, col), line, col), line, col),
				line, col);
		} else {
			step += self.for_by_dir(
				self.for_set_go(self.for_i_cmp(TokenType.LESS, line, col), line, col),
				self.for_set_go(self.for_i_cmp(TokenType.GREATER, line, col), line, col),
				line, col);
		}
		step += self.if_stmt(self.for_id("__for_go", line, col),
			self.for_by_dir(self.for_bump(TokenType.PLUS, line, col), self.for_bump(TokenType.MINUS, line, col), line, col),
			null, line, col);

		return self.for_id("__for_go", line, col);
	}

	// Builds the block that replaces a STMT_FOR: hidden locals plus a while-loop.
	// The checker stores it as `resolved_node` and checks that block directly;
	// `lower` installs it, so nothing swaps a node's kind here.
	pub fn desugar_for(var self, node: *AstNode, fs: *ForStmt, use_iter_trait: bool, bp: *BodyPass = null): *AstNode {
		val line = node.line;
		val col = node.col;

		var pre = List<*AstNode>();
		var head = List<*AstNode>();
		var step = List<*AstNode>();
		val cond = when {
			fs.is_range -> self.desugar_for_range(&pre, &head, &step, fs, line, col);
			use_iter_trait -> self.desugar_for_iter_method(&pre, &head, &step, fs, line, col);
			else -> self.desugar_for_iterable(&pre, &head, &step, fs, line, col);
		};

		// Body: loop variable, the original statements, then the counter update.
		var body_stmts = List<*AstNode>();
		for (s in head) body_stmts += s;
		val fbody = fs.body;
		if (fbody is BlockStmt as b) {
			for (s in b.statements) body_stmts += s;
		} else if (fbody != null) body_stmts += fbody;
		for (s in step) body_stmts += s;

		// A `continue` inside the body must still advance the counter.
		self.for_inject_step(fs.body, &step, bp);

		pre += self.while_stmt(cond, self.block_stmt(body_stmts, line, col), line, col);

		return self.block_stmt(pre, line, col);
	}
}

