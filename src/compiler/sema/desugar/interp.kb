mod compiler.sema.desugar.interp;

// ============================================================================
// Body checker helper - string interpolation
//
// Lowers string interpolation into `kobel_concat` chains: each hole is checked
// against `ToStr` and the concat tree is built on the arena. Type annotations
// live in `sema.type_ast`, equality helpers in `sema.lower`.
// ============================================================================

use std.mem.arena.Arena;
use std.collections.list.List;

use compiler.lexer.token.TokenType;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.builder.*;

use compiler.sema.types.*;

// ============================================================================
// String interpolation lowering
//
// `"a${x}b"` is lowered here into a `kobel_concat` chain; each hole is converted
// to `str` according to its type. Nothing of this reaches the C backend beyond
// calls to the prelude helpers, so codegen needs no new knowledge.
// ============================================================================

impl Arena {
	// A call to a prelude helper. Left unchecked on purpose: the prelude is emitted
	// by codegen and has no symbol table entry.
	pub fn interp_call(var self, name: str, arg: *AstNode, line: usz, col: usz): *AstNode {
		var args = List<*AstNode>();
		args += arg;
		return self.call(self.identifier(name, line, col), args, List<*AstNode>(), line, col);
	}

	pub fn interp_concat(var self, a: *AstNode, b_node: *AstNode, line: usz, col: usz): *AstNode {
		var args = List<*AstNode>();
		args += a;
		args += b_node;
		return self.call(self.identifier("kobel_concat", line, col), args, List<*AstNode>(), line, col);
	}

}
