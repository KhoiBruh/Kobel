mod compiler.sema.decl_collect;

use compiler.lexer.token.*;
use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;

use compiler.sema.types.*;
use compiler.sema.types.StructField;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;

use util.strutil.*;

use std.collections.list.*;
use std.mem.arena.*;


// ============================================================================
// Top-Level Collectors
// ============================================================================

pub fn collect_module(var self: &DeclPass, node: *AstNode) {
	val m = as_module_decl(node);
	self.current_module = m.full_path;
	set_current_module(&self.symtab, m.full_path);
}

// `use a.b.c.Sym as Alias;` -> writes an ImportBinding:
// the name `Alias` (or `Sym` when there is no alias) resolves to `Sym` of the module.
// `use a.b.c.*;` -> wildcard import of the whole module a.b.c
pub fn collect_use(var self: &DeclPass, node: *AstNode) {
	val u = as_use_decl(node);

	if (u.is_wildcard) {
		val w_mod = str_join_dots(u.path, u.path.len);
		if (!module_exists(&self.symtab, w_mod)) return;
		add_import(&self.symtab, w_mod, "", "", true);
		return;
	}

	// The last segment of the path is the symbol name, the rest is the module path
	if (u.path.len < 2) return;
	val mod_name = str_join_dots(u.path, u.path.len - 1);

	// Missing/failed module was already reported by ModuleLoader
	if (!module_exists(&self.symtab, mod_name)) return;

	val target = lookup_in_module(&self.symtab, mod_name, u.symbol_name);
	if (target == null) {
		// Generic struct/function templates are not registered as symbols.
		if (template_in_module(self, mod_name, u.symbol_name)) return;
		report_error(self, node, "Symbol '" + u.symbol_name + "' not found in module '" + mod_name + "'");
		return;
	}

	var local_name = u.symbol_name;
	if (u.alias != "") local_name = u.alias;
	add_import(&self.symtab, mod_name, u.symbol_name, local_name, false);
}

pub fn collect_struct(var self: &DeclPass, node: *AstNode) {
	val s = as_struct_decl(node) as &StructDecl;
	// Generic structs are registered as templates and instantiated on use.
	if (s.type_params.len > 0) return;
	val c_name = c_name_for(self, s.name);
	val s_type = alloc_struct_type(&self.arena, s.name, List<StructField>());
	as_struct_type_mut(s_type).c_name = c_name;
	val ok = define_global(&self.symtab, Symbol(s.name, c_name, SymbolKind.STRUCT, s_type, false, s.is_pub, node.line, node.col));
	if (!ok) report_error(self, node, "Duplicate struct declaration '" + s.name + "'");

	// Rename the AST node to the C name so the backend emits a unique name
	s.name = c_name;

	var has_private = false;
	for (f in s.fields) {
		val f_type = resolve_ast_type(self, f.type_node);
		val s_info = as_struct_type_mut(s_type);
		s_info.fields.add(StructField(f.name, f_type, 0, f.is_pub));
		if (!f.is_pub) has_private = true;
	}
	val st_info = as_struct_type_mut(s_type);
	st_info.module = self.current_module;
	st_info.has_private = has_private;
	layout_struct(s_type);
}

pub fn collect_fn(var self: &DeclPass, node: *AstNode) {
	val f = as_fn_decl(node) as &FnDecl;
	// Generic functions are registered as templates and instantiated on use.
	if (f.type_params.len > 0) return;
	var param_types = List<*Type>();

	for (p in f.params) {
		val p_type = resolve_ast_type(self, p.type_node);
		param_types.add(p_type);
	}

	var ret_type = alloc_primitive(&self.arena, type_none());
	if (f.return_type != null) ret_type = resolve_ast_type(self, f.return_type);

	val fn_type = alloc_fn_type(&self.arena, param_types, ret_type);
	val c_name = c_name_for(self, f.name);
	val ok = define_global(&self.symtab, Symbol(f.name, c_name, SymbolKind.FN, fn_type, false, f.is_pub, node.line, node.col));
	if (!ok) report_error(self, node, "Duplicate function declaration '" + f.name + "'");

	// Rename the AST node to the C name so the backend emits a unique name
	f.name = c_name;
}

pub fn collect_enum(var self: &DeclPass, node: *AstNode) {
	val e = as_enum_decl(node) as &EnumDecl;
	var under_type = alloc_primitive(&self.arena, type_i32());
	if (e.underlying_type != null) under_type = resolve_ast_type(self, e.underlying_type);

	// Resolve member values: implicit members continue from the previous value.
	var members = List<*EnumMemberInfo>();
	var next_val: i64 = 0;
	for (m in e.members) {
		var v: i64 = next_val;
		if (m.value != null) v = enum_const_i64(self, m.value);

		val mi = arena_alloc<EnumMemberInfo>(&self.arena);
		*mi = EnumMemberInfo(m.name, v);
		members.add(mi);

		next_val = v + 1;
	}

	val c_name = c_name_for(self, e.name);

	val info = arena_alloc<EnumInfo>(&self.arena);
	*info = EnumInfo(e.name, c_name, under_type, members);

	// The symbol's type is an integer type that carries the EnumInfo, so enum
	// values stay usable in arithmetic/comparisons while `.value` is recognized.
	val carrier = arena_alloc<Type>(&self.arena);
	*carrier = Type(under_type.kind, under_type.size, under_type.align, info as *u8);

	val ok = define_global(&self.symtab, Symbol(e.name, c_name, SymbolKind.ENUM, carrier, false, e.is_pub, node.line, node.col));
	if (!ok) report_error(self, node, "Duplicate enum declaration '" + e.name + "'");

	register_enum_info(&self.symtab, info);

	e.name = c_name;
}

pub fn collect_const(var self: &DeclPass, node: *AstNode) {
	val c = as_const_decl(node) as &ConstDecl;
	var c_type = alloc_primitive(&self.arena, type_i32());
	if (c.type_node != null) c_type = resolve_ast_type(self, c.type_node);

	val c_name = c_name_for(self, c.name);
	val ok = define_global(&self.symtab, Symbol(c.name, c_name, SymbolKind.CONST, c_type, false, c.is_pub, node.line, node.col));
	if (!ok) report_error(self, node, "Duplicate const declaration '" + c.name + "'");

	c.name = c_name;
}

pub fn collect_extern_block(var self: &DeclPass, node: *AstNode) {
	val ext = as_extern_block(node);
	val prev_is_extern = self.is_extern;
	self.is_extern = true;
	for (d in ext) collect_declaration(self, d);
	self.is_extern = prev_is_extern;
}

// A trait may declare overloads, so a method is identified by name + arity.
fn trait_method_in(list: List<*TraitMethod>, name: str, arity: usz): *TraitMethod {
	for (m in list) {
		if (m.name == name && m.arity == arity) return m;
	}
	return null;
}

// Records a `trait` declaration so `impl Trait for Struct` blocks can be
// checked against it and pick up its default methods. Method signatures are
// resolved lazily; only the method names and whether each one has a body are
// kept here.
pub fn collect_trait(var self: &DeclPass, node: *AstNode) {
	val t = as_trait_decl(node);
	if (find_trait(&self.symtab, t.name) != null) {
		report_error(self, node, "Duplicate trait declaration '${t.name}'");
		return;
	}

	var methods = List<*TraitMethod>();
	for (m in t.methods) {
		val f = as_fn_decl(m);
		if (trait_method_in(methods, f.name, f.params.len) != null) {
			report_error(self, m, "Duplicate method '${f.name}' with ${f.params.len} parameter(s) in trait '${t.name}'");
			continue;
		}
		val tm = arena_alloc<TraitMethod>(&self.arena);
		*tm = TraitMethod(f.name, f.params.len, f.body != null, m);
		methods.add(tm);
	}

	val ti = arena_alloc<TraitInfo>(&self.arena);
	*ti = TraitInfo(t.name, t.bases, methods, List<str>());
	register_trait(&self.symtab, ti);
}

pub fn collect_declaration(var self: &DeclPass, node: *AstNode) {
	when (node.kind) {
		NodeKind.DECL_MODULE -> collect_module(self, node);
		NodeKind.DECL_USE -> collect_use(self, node);
		NodeKind.DECL_STRUCT -> collect_struct(self, node);
		NodeKind.DECL_FN -> collect_fn(self, node);
		NodeKind.DECL_ENUM -> collect_enum(self, node);
		NodeKind.DECL_CONST -> collect_const(self, node);
		NodeKind.DECL_IMPL -> collect_impl(self, node);
		NodeKind.DECL_TRAIT -> {} // already recorded in Pass 0
		NodeKind.DECL_EXTERN_BLOCK -> collect_extern_block(self, node);
		else -> {}
	}
}

pub fn collect_program(var self: &DeclPass, program_node: *AstNode) {
	val prog = as_program(program_node);

	// Pass 0: register generic templates so any use can instantiate them.
	// Module markers are processed here too, so each template records its module.
	for (d0 in prog) {
		if (d0.kind == NodeKind.DECL_MODULE) collect_module(self, d0);
		else if (d0.kind == NodeKind.DECL_TRAIT) collect_trait(self, d0);
		else register_template(self, d0);
	}

	// Pass 1: collect ordinary declarations (templates are skipped).
	for (d1 in prog) collect_declaration(self, d1);

	// Pass 2: rewrite generic uses across signatures and bodies, instantiating
	// concrete structs / functions / methods as needed. Module markers are
	// replayed so each declaration resolves names in its own module.
	for (d in prog) {
		if (d.kind == NodeKind.DECL_MODULE) {
			val m2 = as_module_decl(d);
			self.current_module = m2.full_path;
			set_current_module(&self.symtab, m2.full_path);
		} else if (!is_template_decl(d)) {
			rewrite_generics(self, d);
		}
	}

	// Pass 3: place the monomorphized declarations first. Their struct
	// definitions must precede the structs that embed them (e.g. a field of
	// type List<T>), and each carries its own module marker.
	if (self.symtab.gen.pending.len > 0) {
		val combined = List<*AstNode>();
		for (pn in self.symtab.gen.pending) combined.add(pn);
		for (d in prog) combined.add(d);
		val p_info = as_program(program_node) as &Program;
		p_info.declarations = combined;
	}
}
