mod compiler.sema.body_program;

// ============================================================================
// BodyPass - Function & Program Entry Points
//
// Driver layer of the body checker: walks the merged program and dispatches
// each function / impl method to the core checker in `body_pass`.
// ============================================================================

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.ast.builder.as_program;
use compiler.ast.builder.as_fn_decl;
use compiler.ast.builder.as_module_decl;
use compiler.ast.builder.as_block_stmt;
use compiler.ast.builder.as_expr_stmt;
use compiler.ast.builder.as_impl_decl;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.types.as_fn_type as sem_fn;
use compiler.sema.types.as_struct_type as sem_struct;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.new_decl_pass;
use compiler.sema.decl_collect.collect_program;

use compiler.sema.body_pass.*;

use std.collections.list.*;
use std.mem.arena.*;

pub fn check_fn(var self: &BodyPass, fn_node: *AstNode) {
	val f = as_fn_decl(fn_node);
	val sym = lookup(&self.symtab, f.name);
	if (sym == null || sym.type_ptr.kind != DataType.FN) return;
	check_fn_body(self, fn_node, sym.type_ptr);
}

// Shared body checker: works for free functions and impl methods. `fn_type`
// is the signature already built by DeclPass (methods have no global symbol).
pub fn check_fn_body(var self: &BodyPass, fn_node: *AstNode, fn_type: *Type) {
	val f = as_fn_decl(fn_node);

	val fn_info = sem_fn(fn_type);
	self.current_fn_return_type = fn_info.return_type;

	enter_scope(&self.symtab, true);

	// Register parameters into the function scope
	for (i in 0..<f.params.len) {
		val p = f.params.get(i);
		val p_ty = fn_info.param_types.get(i);
		define(&self.symtab, Symbol(p.name, p.name, SymbolKind.PARAM, p_ty, p.is_mut, false, fn_node.line, fn_node.col));
	}

	// Analyze the function body
	if (f.body != null) {
		if (f.body.kind == NodeKind.STMT_BLOCK) {
			val blk = as_block_stmt(f.body);
			for (stmt in blk.statements) {
				check_statement(self, stmt);
			}
		} else if (f.body.kind == NodeKind.STMT_EXPR) {
			// Expression body: => expr;
			val es = as_expr_stmt(f.body);
			val body_ty = check_expr(self, es.expr);
			if (f.return_type == null) {
				val fn_info_mut = as_fn_type_mut(fn_type);
				fn_info_mut.return_type = body_ty;
				self.current_fn_return_type = body_ty;
			} else if (!can_assign(self.current_fn_return_type, body_ty)) {
				report_error(self, fn_node, "Expression body type does not match function return type");
			}
		}
	}

	exit_scope(&self.symtab);
}

pub fn check_impl(var self: &BodyPass, node: *AstNode) {
	val im = as_impl_decl(node);

	// A primitive impl has no struct name; find its methods by mangled name.
	if (im.struct_name == "") {
		for (m_node in im.methods) {
			val f = as_fn_decl(m_node);
			val mi = find_prim_method_c(&self.symtab, f.name);
			if (mi != null) check_fn_body(self, m_node, mi.fn_type);
		}
		return;
	}

	val st_sym = lookup(&self.symtab, im.struct_name);
	if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) return;
	val st_info = sem_struct(st_sym.type_ptr);

	for (m_node in im.methods) {
		val f = as_fn_decl(m_node);
		val mi = struct_find_method_c(st_info, f.name);
		if (mi != null) check_fn_body(self, m_node, mi.fn_type);
	}
}

pub fn check_program(var self: &BodyPass, program_node: *AstNode) {
	// Step 1: Collect top-level declarations via DeclPass.
	// When symtab is already preloaded from ModuleLoader (multiple modules), skip this
	// step so declarations are not collected/renamed twice.
	if (!self.has_symtab) {
		var decl_p = new_decl_pass();
		collect_program(&decl_p, program_node);

		// Inherit SymbolTable and merge errors from DeclPass
		self.symtab = decl_p.symtab;
		for (msg in decl_p.errors) self.errors.add(msg);
	}

	// Step 2: Analyze each function body of each module (program already merged)
	val prog = as_program(program_node);
	for (decl in prog.declarations) {
		if (decl.kind == NodeKind.DECL_MODULE) {
			val m = as_module_decl(decl);
			set_current_module(&self.symtab, m.full_path);
		} else if (decl.kind == NodeKind.DECL_FN) check_fn(self, decl);
		else if (decl.kind == NodeKind.DECL_IMPL) check_impl(self, decl);
	}
}
