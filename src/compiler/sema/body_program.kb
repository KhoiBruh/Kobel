mod compiler.sema.body_program;

// ============================================================================
// BodyPass - Function & Program Entry Points
//
// Driver layer of the body checker: walks the merged program and dispatches
// each function / impl method to the core checker in `body_pass`.
// ============================================================================

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;

use compiler.sema.symbol.*;
use compiler.sema.decl_pass.DeclPass;
use compiler.sema.decl_collect.*;
use compiler.sema.desugar_interp.*;
use compiler.sema.body_pass.*;
use compiler.sema.body_expr.*;

use std.collections.list.*;
use std.mem.arena.*;

impl BodyPass {

	pub fn check_fn(var self, fn_node: *AstNode) {
		val f = fn_node.to<FnDecl>();
		val sym = self.symtab.lookup(f.name);
		if (sym == null || sym.type_ptr.kind != DataType.FN) return;
		self.check_fn_body(fn_node, sym.type_ptr);
	}

	// Shared body checker: works for free functions and impl methods. `fn_type`
	// is the signature already built by DeclPass (methods have no global symbol).
	pub fn check_fn_body(var self, fn_node: *AstNode, fn_type: *Type) {
		for (n in self.checked_fns) {
			if (n == fn_node) return;
		}
		self.checked_fns.add(fn_node);

		val f = fn_node.to<FnDecl>() as &FnDecl;

		val fn_info = fn_type.as_fn();
		self.current_fn_return_type = fn_info.return_type;

		self.symtab.enter_scope(true);

		// Register parameters into the function scope
		for (i in 0..<f.params.len) {
			val p = f.params[i];
			val p_ty = fn_info.param_types[i];
			self.symtab.define(
				Symbol(p.name, p.name, SymbolKind.PARAM, p_ty, p.is_mut, false, fn_node.line, fn_node.col)
			);
		}

		// Analyze the function body
		if (f.body != null) {
			when (f.body.kind) {
				NodeKind.STMT_BLOCK -> {
					val blk = f.body.to<BlockStmt>();
					for (stmt in blk.statements) {
						self.check_statement(stmt);
					}
				}
				NodeKind.STMT_EXPR -> {
					// Expression body: => expr;
					val es = f.body.to<ExprStmt>();
					if (
						f.return_type != null &&
						(self.current_fn_return_type != null && self.current_fn_return_type.is_list())
					) self.coerce_to_list(es.expr, self.current_fn_return_type);

					val body_ty = self.check_expr(es.expr);
					if (f.return_type == null) {
						val fn_info_mut = fn_type.as_fn_mut();
						fn_info_mut.return_type = body_ty;
						self.current_fn_return_type = body_ty;
						f.return_type = self.arena.ast_type_from_type(body_ty);
					} else if (!self.current_fn_return_type.can_assign(body_ty)) {
						self.report_error(fn_node, "Expression body type does not match function return type");
					}
				}
				else -> {}
			}
		}

		self.symtab.exit_scope();
	}

	pub fn check_impl(var self, node: *AstNode) {
		val im = node.to<ImplDecl>();

		// A primitive impl has no struct name; find its methods by mangled name.
		if (im.struct_name == "") {
			for (m_node in im.methods) {
				val f = m_node.to<FnDecl>();
				if (f.type_params.len > 0) continue;
				val mi = self.symtab.find_prim_method_c(f.name);
				if (mi != null) self.check_fn_body(m_node, mi.fn_type);
			}
			return;
		}

		val st_sym = self.symtab.lookup(im.struct_name);
		if (st_sym == null || st_sym.type_ptr.kind != DataType.STRUCT) return;
		val st_info = st_sym.type_ptr.as_struct();

		// Make `Self` resolve to this struct inside every method body.
		self.current_self_type = st_sym.type_ptr;
		for (m_node in im.methods) {
			val f = m_node.to<FnDecl>();
			if (f.type_params.len > 0) continue;
			val mi = st_info.find_method_c(f.name);
			if (mi != null) self.check_fn_body(m_node, mi.fn_type);
		}
		self.current_self_type = null;
	}

	pub fn check_program(var self, program_node: *AstNode) {
		// Step 1: Collect top-level declarations via DeclPass.
		// When symtab is already preloaded from ModuleLoader (multiple modules), skip this
		// step so declarations are not collected/renamed twice.
		if (!self.has_symtab) {
			var decl_p = DeclPass();
			decl_p.collect_program(program_node);

			// Inherit SymbolTable and merge errors from DeclPass
			self.symtab = decl_p.symtab;
			for (msg in decl_p.errors) self.errors.add(msg);
		}

		// Step 2: Analyze each function body of each module (program already merged)
		val prog = program_node.to<Program>();
		for (decl in prog) {
			when (decl.kind) {
				NodeKind.DECL_MODULE -> {
					val m = decl.to<ModuleDecl>();
					self.symtab.set_current_module(m.full_path);
				}
				NodeKind.DECL_FN -> self.check_fn(decl);
				NodeKind.DECL_IMPL -> self.check_impl(decl);
				else -> {}
			}
		}
	}

}
