mod compiler.sema.type_ast;

// ============================================================================
// Resolved type -> AST annotation
//
// `ast_type_from_type` materializes a resolved `*Type` as an AST type node, so
// synthesized locals and instance signatures can carry an explicit annotation
// the C backend understands. Kept apart from the checker: no pass state is
// involved, only the arena and the type model.
// ============================================================================

use std.collections.list.*;
use std.mem.arena.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;
use compiler.ast.builder.*;

use compiler.sema.types.*;

impl Arena {

	// Builds an AST type node for a resolved semantic type, so locals can carry an
	// explicit annotation the C backend understands.
	pub fn ast_type_from_type(var self, ty: *Type): *AstNode {
		if (ty.is_enum()) return self.named_type(ty.as_enum().c_name, List<*AstNode>(), 0, 0);

		return when (ty.kind) {
			DataType.POINTER -> {
				val pt = ty.as_pointer();
				val base_ptr = self.pointer_type(pt.is_mut, self.ast_type_from_type(pt.pointee), 0, 0);
				if (pt.is_nullable) yield self.nullable_type(base_ptr, 0, 0);
				yield base_ptr;
			}
			DataType.ARRAY -> {
				val at = ty.as_array();
				yield self.array_type(self.ast_type_from_type(at.elem), at.length, 0, 0);
			}
			DataType.STRUCT -> {
				val st_info = ty.as_struct();
				var st_name = st_info.name;
				if (st_info.c_name.len > 0) st_name = st_info.c_name;
				yield self.named_type(st_name, List<*AstNode>(), 0, 0);
			}
			DataType.NONE -> self.named_type("none", List<*AstNode>(), 0, 0);
			DataType.STR -> self.named_type("str", List<*AstNode>(), 0, 0);
			DataType.BOOL -> self.named_type("bool", List<*AstNode>(), 0, 0);
			DataType.CHAR -> self.named_type("char", List<*AstNode>(), 0, 0);
			DataType.I8 -> self.named_type("i8", List<*AstNode>(), 0, 0);
			DataType.I16 -> self.named_type("i16", List<*AstNode>(), 0, 0);
			DataType.I32 -> self.named_type("i32", List<*AstNode>(), 0, 0);
			DataType.I64 -> self.named_type("i64", List<*AstNode>(), 0, 0);
			DataType.ISZ -> self.named_type("isz", List<*AstNode>(), 0, 0);
			DataType.U8 -> self.named_type("u8", List<*AstNode>(), 0, 0);
			DataType.U16 -> self.named_type("u16", List<*AstNode>(), 0, 0);
			DataType.U32 -> self.named_type("u32", List<*AstNode>(), 0, 0);
			DataType.U64 -> self.named_type("u64", List<*AstNode>(), 0, 0);
			DataType.USZ -> self.named_type("usz", List<*AstNode>(), 0, 0);
			DataType.F32 -> self.named_type("f32", List<*AstNode>(), 0, 0);
			DataType.F64 -> self.named_type("f64", List<*AstNode>(), 0, 0);
			else -> null;
		};
	}
}
