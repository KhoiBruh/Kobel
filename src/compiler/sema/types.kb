mod compiler.sema.types;

use std.collections.list.*;
use std.mem.arena.Arena;
use std.traits.to_str.*;
use util.strutil.*;

pub enum DataType {
	NONE,
	BOOL,
	CHAR,
	I8, I16, I32, I64, ISZ,
	U8, U16, U32, U64, USZ,
	F32, F64,
	STR,
	POINTER,
	ARRAY,
	STRUCT,
	FN
}

pub struct Type {
	pub kind: DataType,
	pub size: usz,
	pub align: usz,
	pub data: *u8
}

pub struct PointerType {
	pub pointee: *Type,
	pub is_mut: bool,
	pub is_nullable: bool
}

pub struct ArrayType {
	pub elem: *Type,
	pub length: usz
}

pub struct StructField {
	pub name: str,
	pub type_ptr: *Type,
	pub offset: usz,
	pub is_pub: bool
}

// A method collected from an `impl` block.
// For instance methods `fn_type.param_types[0]` is the receiver
// (`*Struct` for `val self`, `*mut Struct` for `var self`).
pub struct MethodInfo {
	pub name: str,
	pub c_name: str,
	pub fn_type: *Type
}

pub struct StructType {
	pub name: str,
	// Mangled C name; equal to `name` for monomorphized instances.
	pub c_name: str,
	pub fields: List<StructField>,
	pub methods: List<*MethodInfo>,
	// Module that declared the type, so field visibility is enforced across
	// module boundaries.
	pub module: str,
	// True when some field is not `pub`: another module may not build the
	// struct from its fields and must go through a `new` constructor.
	pub has_private: bool
}

pub struct FnType {
	pub param_types: List<*Type>,
	pub return_type: *Type
}

// A single enum member with its resolved integer value.
pub struct EnumMemberInfo {
	pub name: str,
	pub value: i64
}

// Payload registered for every `enum` declaration. The enum symbol's type is
// its underlying integer type, so `EnumInfo` carries the member values.
pub struct EnumInfo {
	pub name: str,
	pub c_name: str,
	pub underlying: *Type,
	pub members: List<*EnumMemberInfo>
}

impl EnumInfo {
	pub fn find_member(self, name: str): *EnumMemberInfo {
		for (m in self.members) {
			if (m.name == name) return m;
		}
		return null;
	}
}

// Recomputes field offsets, size and alignment of a struct type from its
// current field list (fields are added after the type is allocated).
pub fn layout_struct(ty: *Type) {
	if (ty != null) ty.layout_struct();
}

impl PointerType {
	pub fn data_type(val self): DataType => DataType.POINTER;
	pub fn type_size(val self): usz => 8UZ;
	pub fn type_align(val self): usz => 8UZ;
}

impl ArrayType {
	pub fn data_type(val self): DataType => DataType.ARRAY;
	pub fn type_size(val self): usz => self.elem.size * self.length;
	pub fn type_align(val self): usz => self.elem.align;
}

impl FnType {
	pub fn data_type(val self): DataType => DataType.FN;
	pub fn type_size(val self): usz => 8UZ;
	pub fn type_align(val self): usz => 8UZ;
}

impl StructType {
	pub fn data_type(val self): DataType => DataType.STRUCT;

	pub fn find_method(val self, name: str): *MethodInfo {
		for (m in self.methods) {
			if (m.name == name) return m;
		}
		return null;
	}

	pub fn find_method_arity(val self, name: str, argc: usz): *MethodInfo {
		for (m in self.methods) {
			if (m.name == name && m.fn_type.as_fn().param_types.len == argc) return m;
		}
		return null;
	}

	pub fn count_method_arity(val self, name: str, argc: usz): usz {
		var n: usz = 0;
		for (m in self.methods) {
			if (m.name == name && m.fn_type.as_fn().param_types.len == argc) n++;
		}
		return n;
	}

	pub fn find_method_c(val self, c_name: str): *MethodInfo {
		for (m in self.methods) {
			if (m.c_name == c_name) return m;
		}
		return null;
	}
}

// ============================================================================
// Primitive Types Constructors
// ============================================================================

pub fn make_primitive(kind: DataType, size: usz, align: usz) => Type(kind, size, align, null);

pub fn type_primitive(kind: DataType): Type {
	val size: usz = when (kind) {
		DataType.NONE -> 0;
		DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64 -> 8;
		DataType.STR -> 16;
		else -> 8;
	};
	val align: usz = when (kind) {
		DataType.NONE, DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64, DataType.STR -> 8;
		else -> 8;
	};
	return Type(kind, size, align, null);
}

pub fn type_none() => type_primitive(DataType.NONE);
pub fn type_bool() => type_primitive(DataType.BOOL);
pub fn type_char() => type_primitive(DataType.CHAR);

pub fn type_i8() => type_primitive(DataType.I8);
pub fn type_i16() => type_primitive(DataType.I16);
pub fn type_i32() => type_primitive(DataType.I32);
pub fn type_i64() => type_primitive(DataType.I64);
pub fn type_isz() => type_primitive(DataType.ISZ);

pub fn type_u8() => type_primitive(DataType.U8);
pub fn type_u16() => type_primitive(DataType.U16);
pub fn type_u32() => type_primitive(DataType.U32);
pub fn type_u64() => type_primitive(DataType.U64);
pub fn type_usz() => type_primitive(DataType.USZ);

pub fn type_f32() => type_primitive(DataType.F32);
pub fn type_f64() => type_primitive(DataType.F64);

pub fn type_str() => type_primitive(DataType.STR);

// ============================================================================
// Complex Type Allocators (impl Arena Extension)
// ============================================================================

impl Arena {
	pub fn alloc_type<T>(var self, size: usz, align: usz, info: T): *Type {
		val info_ptr = self.alloc_val<T>(info);
		return self.alloc_val<Type>(Type(info.data_type(), size, align, info_ptr as *u8));
	}

	pub fn make_type<T>(var self, info: T): *Type {
		val info_ptr = self.alloc_val<T>(info);
		return self.alloc_val<Type>(Type(info.data_type(), info.type_size(), info.type_align(), info_ptr as *u8));
	}

	pub fn primitive_type(var self, base: Type): *Type => self.alloc_val<Type>(base);

	pub fn pointer_type(var self, pointee: *Type, is_mut: bool): *Type
		=> self.make_type<PointerType>(PointerType(pointee, is_mut, false));

	pub fn nullable_pointer_type(var self, pointee: *Type, is_mut: bool): *Type
		=> self.make_type<PointerType>(PointerType(pointee, is_mut, true));

	pub fn array_type(var self, elem: *Type, length: usz): *Type
		=> self.make_type<ArrayType>(ArrayType(elem, length));

	pub fn fn_type(var self, param_types: List<*Type>, return_type: *Type): *Type
		=> self.make_type<FnType>(FnType(param_types, return_type));

	pub fn struct_type(var self, name: str, fields: List<StructField>): *Type {
		var max_align: usz = 1UZ;
		var current_offset: usz = 0UZ;

		for (i in 0..<fields.len) {
			var f = fields[i];
			val f_align = f.type_ptr.align;
			if (f_align > max_align) max_align = f_align;

			val rem = current_offset % f_align;
			if (rem != 0UZ) current_offset += (f_align - rem);

			f.offset = current_offset;
			fields[i] = f;
			current_offset += f.type_ptr.size;
		}

		val total_rem = current_offset % max_align;
		if (total_rem != 0UZ) current_offset += (max_align - total_rem);

		val struct_info = StructType(name, name, fields, List<*MethodInfo>(), "", false);
		return self.alloc_type<StructType>(current_offset, max_align, struct_info);
	}
}

// ============================================================================
impl Type {
	pub fn to<T>(val self): *T => self.data as *T;
	pub fn to_mut<T>(val self): &T => self.data as &T;

	pub fn as_type<T>(self): *T => self.to<T>();

	pub fn as_pointer(self): *PointerType => self.to<PointerType>();
	pub fn as_array(self): *ArrayType => self.to<ArrayType>();
	pub fn as_struct(self): *StructType => self.to<StructType>();
	pub fn as_struct_mut(self): &StructType => self.to_mut<StructType>();
	pub fn as_fn(self): *FnType => self.to<FnType>();
	pub fn as_fn_mut(self): &FnType => self.to_mut<FnType>();
	pub fn as_enum(self): *EnumInfo => self.to<EnumInfo>();

	pub fn alloc_pointer(self, var arena: &Arena, is_mut: bool): *Type => arena.pointer_type(self as *Type, is_mut);
	pub fn alloc_nullable_pointer(self, var arena: &Arena, is_mut: bool): *Type => arena.nullable_pointer_type(self as *Type, is_mut);
	pub fn alloc_array(self, var arena: &Arena, length: usz): *Type => arena.array_type(self as *Type, length);

	pub fn is_signed_integer(val self) => when (self.kind) {
		DataType.I8, DataType.I16, DataType.I32,
		DataType.I64, DataType.ISZ -> true;
		else -> false;
	};

	pub fn is_unsigned_integer(val self) => when (self.kind) {
		DataType.U8, DataType.U16, DataType.U32,
		DataType.U64, DataType.USZ -> true;
		else -> false;
	};

	pub fn is_integer(val self) => self.is_signed_integer() || self.is_unsigned_integer();

	pub fn is_float(val self) => when (self.kind) {
		DataType.F32, DataType.F64 -> true;
		else -> false;
	};

	pub fn is_char(val self) => self.kind == DataType.CHAR;

	pub fn is_enum(val self): bool {
		if (self.data == null) return false;
		return when (self.kind) {
			DataType.I8, DataType.I16, DataType.I32,
			DataType.I64, DataType.ISZ, DataType.U8,
			DataType.U16, DataType.U32, DataType.U64,
			DataType.USZ -> true;
			else -> false;
		};
	}

	pub fn is_numeric(val self) => self.is_integer() || self.is_float();

	pub fn is_list(val self): bool {
		if (self.kind != DataType.STRUCT) return false;
		val s = self.as_struct();
		if (s.module != "std.collections.list") return false;
		return s.name.starts_with("std__collections__list__List") ||
			s.c_name.starts_with("std__collections__list__List");
	}

	pub fn layout_struct(var self) {
		val st = self.as_struct_mut();
		var max_align: usz = 1UZ;
		var off: usz = 0UZ;
		for (i in 0..<st.fields.len) {
			val f = st.fields[i];
			val fa = f.type_ptr.align;
			if (fa > max_align) max_align = fa;
			val rem = off % fa;
			if (rem != 0UZ) off += (fa - rem);
			f.offset = off;
			st.fields[i] = f;
			off += f.type_ptr.size;
		}
		val tr = off % max_align;
		if (tr != 0UZ) off += (max_align - tr);

		self.size = off;
		self.align = max_align;
	}

	pub fn equals(val self, b: *Type): bool {
		if (self == b) return true;
		if (self.kind != b.kind) return false;

		return when (self.kind) {
			DataType.POINTER -> {
				val p_a = self.as_pointer();
				val p_b = b.as_pointer();
				yield p_a.is_mut == p_b.is_mut &&
					p_a.is_nullable == p_b.is_nullable &&
					p_a.pointee.equals(p_b.pointee);
			}
			DataType.ARRAY -> {
				val arr_a = self.as_array();
				val arr_b = b.as_array();
				yield arr_a.length == arr_b.length && arr_a.elem.equals(arr_b.elem);
			}
			DataType.STRUCT -> {
				val s_a = self.as_struct();
				val s_b = b.as_struct();
				yield s_a.name == s_b.name;
			}
			DataType.FN -> {
				val f_a = self.as_fn();
				val f_b = b.as_fn();
				if (f_a.param_types.len != f_b.param_types.len) yield false;
				if (!f_a.return_type.equals(f_b.return_type)) yield false;

				for (i in 0..<f_a.param_types.len) {
					if (!f_a.param_types[i].equals(f_b.param_types[i])) yield false;
				}
				yield true;
			}
			else -> true;
		};
	}

	pub fn can_assign(val self, source: *Type): bool {
		if (self.equals(source)) return true;

		// 1. Allow assignment between integer types (integer coercion / literal assignment)
		if (self.is_integer() && source.is_integer()) return true;

		// 2. Allow assignment between float types
		if (self.is_float() && source.is_float()) return true;

		// 3. Allow passing/assigning str to *char, &char, *u8, &u8, *none
		if (self.kind == DataType.POINTER && source.kind == DataType.STR) {
			val t_ptr = self.as_pointer();
			if (
				t_ptr.pointee.kind == DataType.CHAR ||
				t_ptr.pointee.kind == DataType.U8 ||
				t_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		// 4. Allow assigning a char/u8 pointer to str
		if (self.kind == DataType.STR && source.kind == DataType.POINTER) {
			val s_ptr = source.as_pointer();
			if (s_ptr.is_nullable) return false;
			if (
				s_ptr.pointee.kind == DataType.CHAR ||
				s_ptr.pointee.kind == DataType.U8
			) return true;
		}

		// 5. Allow assigning a mutable pointer to an immutable pointer: *mut T -> *T,
		// and allow assigning a non-nullable pointer to a nullable pointer: *T -> *T?
		if (self.kind == DataType.POINTER && source.kind == DataType.POINTER) {
			val t_ptr = self.as_pointer();
			val s_ptr = source.as_pointer();

			// Nullable pointer cannot be assigned to non-nullable pointer
			if (s_ptr.is_nullable && !t_ptr.is_nullable) return false;

			if (
				(!t_ptr.is_mut || s_ptr.is_mut) &&
				t_ptr.pointee.equals(s_ptr.pointee)
			) return true;

			// Allow none pointer (or u8 pointer / null pointer) to be compatible with other pointers
			if (
				t_ptr.pointee.kind == DataType.U8 ||
				t_ptr.pointee.kind == DataType.NONE ||
				s_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		return false;
	}

}

impl ToStr for Type {

	pub fn to_str(val self): str => when (self.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> {
			val ptr = self.as_pointer();
			val q = if (ptr.is_nullable) "?" else "";
			if (ptr.is_mut) yield "*mut ${ptr.pointee.to_str()}${q}";
			yield "*${ptr.pointee.to_str()}${q}";
		}
		DataType.ARRAY -> {
			val arr = self.as_array();
			yield "[${arr.elem.to_str()}]";
		}
		DataType.STRUCT -> {
			val s = self.as_struct();
			yield s.name;
		}
		DataType.FN -> "fn(...)";
		else -> "unknown";
	};

}
