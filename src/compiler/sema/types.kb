mod compiler.sema.types;

use std.collections.list.*;
use std.mem.arena.Arena;
use std.traits.to_str.*;

pub enum DataType {
	NONE,
	BOOL,
	CHAR,
	I8, I16, I32, I64, ISZ,
	U8, U16, U32, U64, USZ,
	F32, F64,
	STR,
	POINTER,
	ARRAY,
	STRUCT,
	FN
}

pub struct Type {
	pub kind: DataType,
	pub size: usz,
	pub align: usz,
	pub data: *u8
}

pub struct PointerType {
	pub pointee: *Type,
	pub is_mut: bool,
	pub is_nullable: bool
}

pub struct ArrayType {
	pub elem: *Type,
	pub length: usz
}

pub struct StructField {
	pub name: str,
	pub type_ptr: *Type,
	pub offset: usz,
	pub is_pub: bool
}

// A method collected from an `impl` block.
// For instance methods `fn_type.param_types[0]` is the receiver
// (`*Struct` for `val self`, `*mut Struct` for `var self`).
pub struct MethodInfo {
	pub name: str,
	pub c_name: str,
	pub fn_type: *Type
}

pub struct StructType {
	pub name: str,
	// Mangled C name; equal to `name` for monomorphized instances.
	pub c_name: str,
	pub fields: List<StructField>,
	pub methods: List<*MethodInfo>,
	// Module that declared the type, so field visibility is enforced across
	// module boundaries.
	pub module: str,
	// True when some field is not `pub`: another module may not build the
	// struct from its fields and must go through a `new` constructor.
	pub has_private: bool
}

pub struct FnType {
	pub param_types: List<*Type>,
	pub return_type: *Type
}

// A single enum member with its resolved integer value.
pub struct EnumMemberInfo {
	pub name: str,
	pub value: i64
}

// Payload registered for every `enum` declaration. The enum symbol's type is
// its underlying integer type, so `EnumInfo` carries the member values.
pub struct EnumInfo {
	pub name: str,
	pub c_name: str,
	pub underlying: *Type,
	pub members: List<*EnumMemberInfo>
}

impl EnumInfo {
	pub fn find_member(self, name: str): *EnumMemberInfo {
		for (m in self.members) {
			if (m.name == name) return m;
		}
		return null;
	}
}

// ============================================================================
// Downcast Helper Functions
// ============================================================================

pub fn as_struct_type(ty: *Type): *StructType => ty.as_struct();
pub fn as_struct_type_mut(ty: *Type): &StructType => ty.as_struct_mut();
pub fn as_fn_type(ty: *Type): *FnType => ty.as_fn();
pub fn as_fn_type_mut(ty: *Type): &FnType => ty.as_fn_mut();
pub fn as_enum_info(ty: *Type): *EnumInfo => ty.as_enum();

// Recomputes field offsets, size and alignment of a struct type from its
// current field list (fields are added after the type is allocated).
pub fn layout_struct(ty: *Type) {
	val st = as_struct_type_mut(ty);
	var max_align: usz = 1;
	var off: usz = 0;
	for (i in 0..<st.fields.len) {
		val f = st.fields[i];
		val fa = f.type_ptr.align;
		if (fa > max_align) max_align = fa;
		val rem = off % fa;
		if (rem != 0) off += (fa - rem);
		f.offset = off;
		st.fields[i] = f;
		off += f.type_ptr.size;
	}
	val tr = off % max_align;
	if (tr != 0) off += (max_align - tr);

	val t = ty as &Type;
	t.size = off;
	t.align = max_align;
}

impl StructType {
	pub fn find_method(val self, name: str): *MethodInfo {
		for (m in self.methods) {
			if (m.name == name) return m;
		}
		return null;
	}

	pub fn find_method_arity(val self, name: str, argc: usz): *MethodInfo {
		for (m in self.methods) {
			if (m.name == name && as_fn_type(m.fn_type).param_types.len == argc) return m;
		}
		return null;
	}

	pub fn count_method_arity(val self, name: str, argc: usz): usz {
		var n: usz = 0;
		for (m in self.methods) {
			if (m.name == name && as_fn_type(m.fn_type).param_types.len == argc) n++;
		}
		return n;
	}

	pub fn find_method_c(val self, c_name: str): *MethodInfo {
		for (m in self.methods) {
			if (m.c_name == c_name) return m;
		}
		return null;
	}
}

// ============================================================================
// Primitive Types Constructors
// ============================================================================

pub fn make_primitive(kind: DataType, size: usz, align: usz) => Type(kind, size, align, null);

pub fn type_primitive(kind: DataType): Type {
	val size: usz = when (kind) {
		DataType.NONE -> 0;
		DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64 -> 8;
		DataType.STR -> 16;
		else -> 8;
	};
	val align: usz = when (kind) {
		DataType.NONE, DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64, DataType.STR -> 8;
		else -> 8;
	};
	return Type(kind, size, align, null);
}

pub fn type_none() => type_primitive(DataType.NONE);
pub fn type_bool() => type_primitive(DataType.BOOL);
pub fn type_char() => type_primitive(DataType.CHAR);

pub fn type_i8() => type_primitive(DataType.I8);
pub fn type_i16() => type_primitive(DataType.I16);
pub fn type_i32() => type_primitive(DataType.I32);
pub fn type_i64() => type_primitive(DataType.I64);
pub fn type_isz() => type_primitive(DataType.ISZ);

pub fn type_u8() => type_primitive(DataType.U8);
pub fn type_u16() => type_primitive(DataType.U16);
pub fn type_u32() => type_primitive(DataType.U32);
pub fn type_u64() => type_primitive(DataType.U64);
pub fn type_usz() => type_primitive(DataType.USZ);

pub fn type_f32() => type_primitive(DataType.F32);
pub fn type_f64() => type_primitive(DataType.F64);

pub fn type_str() => type_primitive(DataType.STR);

// ============================================================================
// Complex Type Allocators
// ============================================================================

pub fn alloc_pointer_type(
	var arena: &Arena,
	pointee: *Type,
	is_mut: bool
): *Type {
	val ptr_info = arena_alloc<PointerType>(arena);
	*ptr_info = PointerType(pointee, is_mut, false);

	val t_ptr = arena_alloc<Type>(arena);
	*t_ptr = Type(DataType.POINTER, 8, 8, ptr_info as *u8);
	return t_ptr;
}

pub fn alloc_nullable_pointer_type(
	var arena: &Arena,
	pointee: *Type,
	is_mut: bool
): *Type {
	val ptr_info = arena_alloc<PointerType>(arena);
	*ptr_info = PointerType(pointee, is_mut, true);

	val t_ptr = arena_alloc<Type>(arena);
	*t_ptr = Type(DataType.POINTER, 8, 8, ptr_info as *u8);
	return t_ptr;
}

pub fn alloc_array_type(
	var arena: &Arena,
	elem: *Type,
	length: usz
): *Type {
	val arr_info = arena_alloc<ArrayType>(arena);
	*arr_info = ArrayType(elem, length);

	val t_ptr = arena_alloc<Type>(arena);
	*t_ptr = Type(DataType.ARRAY, elem.size * length, elem.align, arr_info as *u8);
	return t_ptr;
}

pub fn alloc_struct_type(
	var arena: &Arena,
	name: str,
	fields: List<StructField>
): *Type {
	var max_align: usz = 1;
	var current_offset: usz = 0;

	for (i in 0..<fields.len) {
		var f = fields[i];
		val f_align = f.type_ptr.align;
		if (f_align > max_align) max_align = f_align;

		// Align current_offset theo f_align
		val rem = current_offset % f_align;
		if (rem != 0) current_offset += (f_align - rem);

		f.offset = current_offset;
		fields[i] = f;
		current_offset += f.type_ptr.size;
	}

	// Final struct padding to max_align
	val total_rem = current_offset % max_align;
	if (total_rem != 0) current_offset += (max_align - total_rem);

	val struct_info = arena_alloc<StructType>(arena);
	*struct_info = StructType(name, name, fields, List<*MethodInfo>(), "", false);

	val t_ptr = arena_alloc<Type>(arena);
	*t_ptr = Type(DataType.STRUCT, current_offset, max_align, struct_info as *u8);
	return t_ptr;
}

pub fn alloc_fn_type(
	var arena: &Arena,
	param_types: List<*Type>,
	return_type: *Type
): *Type {
	val fn_info = arena_alloc<FnType>(arena);
	*fn_info = FnType(param_types, return_type);

	val t_ptr = arena_alloc<Type>(arena);
	*t_ptr = Type(DataType.FN, 8, 8, fn_info as *u8);
	return t_ptr;
}

// ============================================================================
impl Type {
	pub fn as_type<T>(self): *T => self.data as *T;
	pub fn to_mut<T>(self): &T => self.data as &T;

	pub fn as_pointer(self): *PointerType => self.data as *PointerType;
	pub fn as_array(self): *ArrayType => self.data as *ArrayType;
	pub fn as_struct(self): *StructType => self.as_type<StructType>();
	pub fn as_struct_mut(self): &StructType => self.to_mut<StructType>();
	pub fn as_fn(self): *FnType => self.as_type<FnType>();
	pub fn as_fn_mut(self): &FnType => self.to_mut<FnType>();
	pub fn as_enum(self): *EnumInfo => self.as_type<EnumInfo>();

	pub fn alloc_pointer(self, var arena: &Arena, is_mut: bool): *Type => alloc_pointer_type(arena, self as *Type, is_mut);
	pub fn alloc_nullable_pointer(self, var arena: &Arena, is_mut: bool): *Type => alloc_nullable_pointer_type(arena, self as *Type, is_mut);
	pub fn alloc_array(self, var arena: &Arena, length: usz): *Type => alloc_array_type(arena, self as *Type, length);

	pub fn is_signed_integer(val self) => when (self.kind) {
		DataType.I8, DataType.I16, DataType.I32,
		DataType.I64, DataType.ISZ -> true;
		else -> false;
	};

	pub fn is_unsigned_integer(val self) => when (self.kind) {
		DataType.U8, DataType.U16, DataType.U32,
		DataType.U64, DataType.USZ -> true;
		else -> false;
	};

	pub fn is_integer(val self) => self.is_signed_integer() || self.is_unsigned_integer();

	pub fn is_float(self) => when (self.kind) {
		DataType.F32, DataType.F64 -> true;
		else -> false;
	};

	pub fn is_char(self) => self.kind == DataType.CHAR;

	pub fn is_enum(self): bool {
		if (self.data == null) return false;
		return when (self.kind) {
			DataType.I8, DataType.I16, DataType.I32,
			DataType.I64, DataType.ISZ, DataType.U8,
			DataType.U16, DataType.U32, DataType.U64,
			DataType.USZ -> true;
			else -> false;
		};
	}

	pub fn is_numeric(self) => self.is_integer() || self.is_float();

	pub fn equals(self, other: *Type) => type_equals(self as *Type, other);

	pub fn can_assign_from(self, source: *Type) => can_assign(self as *Type, source);

}

impl ToStr for Type {

	pub fn to_str(val self): str => when (self.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> {
			val ptr = self.as_pointer();
			val q = if (ptr.is_nullable) "?" else "";
			if (ptr.is_mut) yield "*mut ${ptr.pointee.to_str}${q}";
			yield "*${ptr.pointee.to_str}${q}";
		}
		DataType.ARRAY -> {
			val arr = self.as_array();
			yield "[${arr.elem.to_str}]";
		}
		DataType.STRUCT -> {
			val s = self.as_struct();
			yield s.name;
		}
		DataType.FN -> "fn(...)";
		else -> "unknown";
	};

}

pub fn type_equals(a: *Type, b: *Type): bool {
	if (a == b) return true;
	if (a.kind != b.kind) return false;

	return when (a.kind) {
		DataType.POINTER -> {
			val p_a = a.as_pointer();
			val p_b = b.as_pointer();
			yield (p_a.is_mut == p_b.is_mut) && (p_a.is_nullable == p_b.is_nullable) && type_equals(p_a.pointee, p_b.pointee);
		}
		DataType.ARRAY -> {
			val arr_a = a.as_array();
			val arr_b = b.as_array();
			yield (arr_a.length == arr_b.length) && type_equals(arr_a.elem, arr_b.elem);
		}
		DataType.STRUCT -> {
			val s_a = as_struct_type(a);
			val s_b = as_struct_type(b);
			yield s_a.name == s_b.name;
		}
		DataType.FN -> {
			val f_a = as_fn_type(a);
			val f_b = as_fn_type(b);
			if (f_a.param_types.len != f_b.param_types.len) yield false;
			if (!type_equals(f_a.return_type, f_b.return_type)) yield false;

			for (i in 0..<f_a.param_types.len) {
				if (!type_equals(f_a.param_types[i], f_b.param_types[i])) yield false;
			}
			yield true;
		}
		else -> true;
	};
}

pub fn can_assign(target: *Type, source: *Type): bool {
	if (type_equals(target, source)) return true;

	// 1. Allow assignment between integer types (integer coercion / literal assignment)
	if (target.is_integer() && source.is_integer()) return true;

	// 2. Allow assignment between float types
	if (target.is_float() && source.is_float()) return true;

	// 3. Allow passing/assigning str to *char, &char, *u8, &u8, *none
	if (source.kind == DataType.STR && target.kind == DataType.POINTER) {
		val t_ptr = target.as_pointer();
		if (
			t_ptr.pointee.kind == DataType.CHAR ||
			t_ptr.pointee.kind == DataType.U8 ||
			t_ptr.pointee.kind == DataType.NONE
		) return true;
	}

	// 4. Allow assigning a char/u8 pointer to str
	if (target.kind == DataType.STR && source.kind == DataType.POINTER) {
		val s_ptr = source.as_pointer();
		if (s_ptr.is_nullable) return false;
		if (
			s_ptr.pointee.kind == DataType.CHAR ||
			s_ptr.pointee.kind == DataType.U8
		) return true;
	}

	// 5. Allow assigning a mutable pointer to an immutable pointer: *mut T -> *T,
	// and allow assigning a non-nullable pointer to a nullable pointer: *T -> *T?
	if (target.kind == DataType.POINTER && source.kind == DataType.POINTER) {
		val t_ptr = target.as_pointer();
		val s_ptr = source.as_pointer();

		// Nullable pointer cannot be assigned to non-nullable pointer
		if (s_ptr.is_nullable && !t_ptr.is_nullable) return false;

		if (
			(!t_ptr.is_mut || s_ptr.is_mut) &&
			type_equals(t_ptr.pointee, s_ptr.pointee)
		) return true;

		// Allow none pointer (or u8 pointer / null pointer) to be compatible with other pointers
		if (
			t_ptr.pointee.kind == DataType.U8 ||
			t_ptr.pointee.kind == DataType.NONE ||
			s_ptr.pointee.kind == DataType.NONE
		) return true;
	}

	return false;
}
