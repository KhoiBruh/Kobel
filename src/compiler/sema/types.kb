mod compiler.sema.types;

use std.collections.list.*;
use std.mem.arena.Arena;

// ============================================================================
// DataType Enumeration
// ============================================================================

pub enum DataType {
	NONE,
	BOOL,
	CHAR,
	I8, I16, I32, I64, ISZ,
	U8, U16, U32, U64, USZ,
	F32, F64,
	STR,
	POINTER,
	ARRAY,
	STRUCT,
	FN
}

// ============================================================================
// Type Representation (Tagged Type)
// ============================================================================

pub struct Type {
	pub kind: DataType,
	pub size: usz,
	pub align: usz,
	pub data: *u8
}

pub struct PointerType {
	pub pointee: *Type,
	pub is_mut: bool
}

pub struct ArrayType {
	pub elem: *Type,
	pub length: usz
}

pub struct StructField {
	pub name: str,
	pub type_ptr: *Type,
	pub offset: usz
}

// A method collected from an `impl` block.
// For instance methods `fn_type.param_types[0]` is the receiver
// (`*Struct` for `val self`, `*mut Struct` for `var self`).
pub struct MethodInfo {
	pub name: str,
	pub c_name: str,
	pub fn_type: *Type
}

pub struct StructType {
	pub name: str,
	// Mangled C name; equal to `name` for monomorphized instances.
	pub c_name: str,
	pub fields: List<StructField>,
	pub methods: List<*MethodInfo>
}

pub struct FnType {
	pub param_types: List<*Type>,
	pub return_type: *Type
}

// A single enum member with its resolved integer value.
pub struct EnumMemberInfo {
	pub name: str,
	pub value: i64
}

// Payload registered for every `enum` declaration. The enum symbol's type is
// its underlying integer type, so `EnumInfo` carries the member values.
pub struct EnumInfo {
	pub name: str,
	pub c_name: str,
	pub underlying: *Type,
	pub members: List<*EnumMemberInfo>
}

pub fn enum_find_member(e: *EnumInfo, name: str): *EnumMemberInfo {
	var i: usz = 0;
	while (i < e.members.len) {
		val m = e.members.get(i);
		if (m.name == name) return m;
		i = i + 1;
	}
	return null;
}

// ============================================================================
// Downcast Helper Functions
// ============================================================================

pub fn as_pointer_type(ty: *Type): *PointerType => ty.data as *PointerType;
pub fn as_array_type(ty: *Type): *ArrayType => ty.data as *ArrayType;
pub fn as_struct_type(ty: *Type): *StructType => ty.data as *StructType;
pub fn as_struct_type_mut(ty: *Type): &StructType => ty.data as &StructType;
pub fn as_fn_type(ty: *Type): *FnType => ty.data as *FnType;
pub fn as_fn_type_mut(ty: *Type): &FnType => ty.data as &FnType;

// Recomputes field offsets, size and alignment of a struct type from its
// current field list (fields are added after the type is allocated).
pub fn layout_struct(ty: *Type) {
	val st = as_struct_type_mut(ty);
	var max_align: usz = 1;
	var off: usz = 0;
	var i: usz = 0;
	while (i < st.fields.len) {
		val f = st.fields.get(i);
		val fa = f.type_ptr.align;
		if (fa > max_align) max_align = fa;
		val rem = off % fa;
		if (rem != 0) off = off + (fa - rem);
		f.offset = off;
		st.fields.set(i, f);
		off = off + f.type_ptr.size;
		i = i + 1;
	}
	val tr = off % max_align;
	if (tr != 0) off = off + (max_align - tr);

	val t = ty as &Type;
	t.size = off;
	t.align = max_align;
}

// Look up a method by its source name (e.g. "peek").
pub fn struct_find_method(st: *StructType, name: str): *MethodInfo {
	var i: usz = 0;
	while (i < st.methods.len) {
		val m = st.methods.get(i);
		if (m.name == name) return m;
		i = i + 1;
	}
	return null;
}

// Look up a method by its mangled C name (used when re-visiting an `impl`).
pub fn struct_find_method_c(st: *StructType, c_name: str): *MethodInfo {
	var i: usz = 0;
	while (i < st.methods.len) {
		val m = st.methods.get(i);
		if (m.c_name == c_name) return m;
		i = i + 1;
	}
	return null;
}

// ============================================================================
// Primitive Types Constructors
// ============================================================================

pub fn make_primitive(kind: DataType, size: usz, align: usz) => Type(kind, size, align, null);

pub fn type_none() => make_primitive(DataType.NONE, 0, 1);
pub fn type_bool() => make_primitive(DataType.BOOL, 1, 1);
pub fn type_char() => make_primitive(DataType.CHAR, 1, 1);

pub fn type_i8() => make_primitive(DataType.I8, 1, 1);
pub fn type_i16() => make_primitive(DataType.I16, 2, 2);
pub fn type_i32() => make_primitive(DataType.I32, 4, 4);
pub fn type_i64() => make_primitive(DataType.I64, 8, 8);
pub fn type_isz() => make_primitive(DataType.ISZ, 8, 8);

pub fn type_u8() => make_primitive(DataType.U8, 1, 1);
pub fn type_u16() => make_primitive(DataType.U16, 2, 2);
pub fn type_u32() => make_primitive(DataType.U32, 4, 4);
pub fn type_u64() => make_primitive(DataType.U64, 8, 8);
pub fn type_usz() => make_primitive(DataType.USZ, 8, 8);

pub fn type_f32() => make_primitive(DataType.F32, 4, 4);
pub fn type_f64() => make_primitive(DataType.F64, 8, 8);

pub fn type_str() => make_primitive(DataType.STR, 16, 8);

// ============================================================================
// Complex Type Allocators
// ============================================================================

pub fn alloc_pointer_type(
	var arena: &Arena,
	pointee: *Type,
	is_mut: bool
): *Type {
	val payload_mem = arena.alloc_bytes(PointerType.size(), 8);
	val ptr_info = payload_mem as *PointerType;
	*ptr_info = PointerType(pointee, is_mut);

	val type_mem = arena.alloc_bytes(Type.size(), 8);
	val t_ptr = type_mem as *Type;
	*t_ptr = Type(DataType.POINTER, 8, 8, payload_mem);
	return t_ptr;
}

pub fn alloc_array_type(
	var arena: &Arena,
	elem: *Type,
	length: usz
): *Type {
	val payload_mem = arena.alloc_bytes(ArrayType.size(), 8);
	val arr_info = payload_mem as *ArrayType;
	*arr_info = ArrayType(elem, length);

	val type_mem = arena.alloc_bytes(Type.size(), 8);
	val t_ptr = type_mem as *Type;
	*t_ptr = Type(DataType.ARRAY, elem.size * length, elem.align, payload_mem);
	return t_ptr;
}

pub fn alloc_struct_type(
	var arena: &Arena,
	name: str,
	fields: List<StructField>
): *Type {
	var max_align: usz = 1;
	var current_offset: usz = 0;

	var i: usz = 0;
	while (i < fields.len) {
		var f = fields.get(i);
		val f_align = f.type_ptr.align;
		if (f_align > max_align) max_align = f_align;

		// Align current_offset theo f_align
		val rem = current_offset % f_align;
		if (rem != 0) current_offset = current_offset + (f_align - rem);

		f.offset = current_offset;
		fields.set(i, f);
		current_offset = current_offset + f.type_ptr.size;
		i = i + 1;
	}

	// Final struct padding to max_align
	val total_rem = current_offset % max_align;
	if (total_rem != 0) current_offset = current_offset + (max_align - total_rem);

	val payload_mem = arena.alloc_bytes(StructType.size(), 8);
	val struct_info = payload_mem as *StructType;
	*struct_info = StructType(name, name, fields, new_list<*MethodInfo>());

	val type_mem = arena.alloc_bytes(Type.size(), 8);
	val t_ptr = type_mem as *Type;
	*t_ptr = Type(DataType.STRUCT, current_offset, max_align, payload_mem);
	return t_ptr;
}

pub fn alloc_fn_type(
	var arena: &Arena,
	param_types: List<*Type>,
	return_type: *Type
): *Type {
	val payload_mem = arena.alloc_bytes(FnType.size(), 8);
	val fn_info = payload_mem as *FnType;
	*fn_info = FnType(param_types, return_type);

	val type_mem = arena.alloc_bytes(Type.size(), 8);
	val t_ptr = type_mem as *Type;
	*t_ptr = Type(DataType.FN, 8, 8, payload_mem);
	return t_ptr;
}

// ============================================================================
// Type Inspection & Semantic Queries
// ============================================================================

pub fn is_signed_integer(ty: *Type): bool {
	when (ty.kind) {
		DataType.I8,
		DataType.I16,
		DataType.I32,
		DataType.I64,
		DataType.ISZ -> return true;
		else -> return false;
	}
}

pub fn is_unsigned_integer(ty: *Type) => when (ty.kind) {
	DataType.U8, DataType.U16, DataType.U32,
	DataType.U64, DataType.USZ -> true;
	else -> false;
};

pub fn is_integer(ty: *Type) => is_signed_integer(ty) || is_unsigned_integer(ty);

pub fn is_float(ty: *Type) => when (ty.kind) {
	DataType.F32, DataType.F64 -> true;
	else -> false;
};

pub fn is_char(ty: *Type) => ty.kind == DataType.CHAR;

// An enum value carries its `EnumInfo` in `data` while keeping an integer `kind`.
pub fn is_enum_type(ty: *Type): bool {
	if (ty.data == null) return false;
	return when (ty.kind) {
		DataType.I8, DataType.I16, DataType.I32, DataType.I64, DataType.ISZ,
		DataType.U8, DataType.U16, DataType.U32, DataType.U64, DataType.USZ -> true;
		else -> false;
	};
}

pub fn as_enum_info(ty: *Type): *EnumInfo => ty.data as *EnumInfo;

pub fn is_numeric(ty: *Type) => is_integer(ty) || is_float(ty);

pub fn type_equals(a: *Type, b: *Type): bool {
	if (a == b) return true;
	if (a.kind != b.kind) return false;

	when (a.kind) {
		DataType.POINTER -> {
			val p_a = as_pointer_type(a);
			val p_b = as_pointer_type(b);
			return (p_a.is_mut == p_b.is_mut) && type_equals(p_a.pointee, p_b.pointee);
		}
		DataType.ARRAY -> {
			val arr_a = as_array_type(a);
			val arr_b = as_array_type(b);
			return (arr_a.length == arr_b.length) && type_equals(arr_a.elem, arr_b.elem);
		}
		DataType.STRUCT -> {
			val s_a = as_struct_type(a);
			val s_b = as_struct_type(b);
			return s_a.name == s_b.name;
		}
		DataType.FN -> {
			val f_a = as_fn_type(a);
			val f_b = as_fn_type(b);
			if (f_a.param_types.len != f_b.param_types.len) return false;
			if (!type_equals(f_a.return_type, f_b.return_type)) return false;

			var i: usz = 0;
			while (i < f_a.param_types.len) {
				if (!type_equals(f_a.param_types.get(i), f_b.param_types.get(i))) return false;
				i = i + 1;
			}
			return true;
		}
		else -> return true;
	}
}

pub fn can_assign(target: *Type, source: *Type): bool {
	if (type_equals(target, source)) return true;

	// 1. Allow assignment between integer types (integer coercion / literal assignment)
	if (is_integer(target) && is_integer(source)) return true;

	// 2. Allow assignment between float types
	if (is_float(target) && is_float(source)) return true;

	// 3. Allow passing/assigning str to *char, &char, *u8, &u8, *none
	if (source.kind == DataType.STR && target.kind == DataType.POINTER) {
		val t_ptr = as_pointer_type(target);
		if (
			t_ptr.pointee.kind == DataType.CHAR ||
			t_ptr.pointee.kind == DataType.U8 ||
			t_ptr.pointee.kind == DataType.NONE
		) return true;
	}

	// 4. Allow assigning a char/u8 pointer to str
	if (target.kind == DataType.STR && source.kind == DataType.POINTER) {
		val s_ptr = as_pointer_type(source);
		if (
			s_ptr.pointee.kind == DataType.CHAR ||
			s_ptr.pointee.kind == DataType.U8
		) return true;
	}

	// 5. Allow assigning a mutable pointer to an immutable pointer: *mut T -> *T
	if (target.kind == DataType.POINTER && source.kind == DataType.POINTER) {
		val t_ptr = as_pointer_type(target);
		val s_ptr = as_pointer_type(source);
		if (!t_ptr.is_mut && s_ptr.is_mut) return type_equals(t_ptr.pointee, s_ptr.pointee);
	}

	// 6. Allow none pointer (or u8 pointer / null pointer) to be compatible with other pointers
	if (target.kind == DataType.POINTER && source.kind == DataType.POINTER) {
		val t_ptr = as_pointer_type(target);
		val s_ptr = as_pointer_type(source);
		if (
			t_ptr.pointee.kind == DataType.U8 ||
			t_ptr.pointee.kind == DataType.NONE ||
			s_ptr.pointee.kind == DataType.NONE
		) return true;
	}

	return false;
}

pub fn type_to_string(ty: *Type): str {
	when (ty.kind) {
		DataType.NONE -> return "none";
		DataType.BOOL -> return "bool";
		DataType.CHAR -> return "char";
		DataType.I8 -> return "i8";
		DataType.I16 -> return "i16";
		DataType.I32 -> return "i32";
		DataType.I64 -> return "i64";
		DataType.ISZ -> return "isz";
		DataType.U8 -> return "u8";
		DataType.U16 -> return "u16";
		DataType.U32 -> return "u32";
		DataType.U64 -> return "u64";
		DataType.USZ -> return "usz";
		DataType.F32 -> return "f32";
		DataType.F64 -> return "f64";
		DataType.STR -> return "str";
		DataType.POINTER -> {
			val ptr = as_pointer_type(ty);
			if (ptr.is_mut) return "*mut " + type_to_string(ptr.pointee);
			return "*" + type_to_string(ptr.pointee);
		}
		DataType.ARRAY -> {
			val arr = as_array_type(ty);
			return "[" + type_to_string(arr.elem) + "]";
		}
		DataType.STRUCT -> {
			val s = as_struct_type(ty);
			return s.name;
		}
		DataType.FN -> return "fn(...)";
		else -> return "unknown";
	}
}
