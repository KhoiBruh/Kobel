mod compiler.sema.types;

// ============================================================================
// Type model
//
// `Type` plus its payload enum (Pointer/Array/Struct/Fn/Enum), struct layout,
// function and method types, enum info, and the canonical primitive singletons
// (`PrimTypes`). Equality is structural; structs compare their mangled C name so
// same-named types in different modules stay distinct.
// ============================================================================

use std.collections.list.*;
use std.mem.arena.Arena;
use std.traits.to_str.*;

use compiler.ast.node.*;
use compiler.sema.methods.*;
use compiler.sema.structs.*;
use compiler.sema.enums.*;

use util.strutil.*;

pub enum DataType {
	NONE,
	BOOL,
	CHAR,
	I8, I16, I32, I64, ISZ,
	U8, U16, U32, U64, USZ,
	F32, F64,
	STR,
	POINTER,
	ARRAY,
	STRUCT,
	FN
}



// The pointer/array/fn payload structs are defined below, after `TypePayload`;
// the forward declarations let the enum name them first.
struct PointerType;
struct ArrayType;
struct FnType;

// What a `Type` carries besides kind/size/align. `None` covers primitives, and
// a payload enum keeps the variant (and its accessors) checked.
pub enum TypePayload {
	NONE,
	Pointer(inner: *PointerType),
	Array(inner: *ArrayType),
	Struct(inner: *StructType),
	Fn(inner: *FnType),
	Enum(inner: *EnumInfo)
}

pub struct Type {
	pub kind: DataType,
	pub size: usz,
	pub align: usz,
	pub data: TypePayload,
	// Methods of a built-in type (`impl i32 { ... }`). Null for every non-primitive
	// type and for primitives built by `type_primitive`, which are not canonical.
	pub methods: *PrimMethods = null
}

pub struct PointerType {
	pub const TAG = DataType.POINTER;
	pub pointee: *Type,
	pub is_mut: bool,
	pub is_nullable: bool
}

pub struct ArrayType {
	pub const TAG = DataType.ARRAY;
	pub elem: *Type,
	pub length: usz
}

pub struct FnType {
	pub const TAG = DataType.FN;
	pub param_types: List<*Type>,
	pub return_type: *Type
}

impl PointerType {
	pub fn type_size(val self): usz => 8;
	pub fn type_align(val self): usz => 8;
}

impl ArrayType {
	pub fn type_size(val self): usz => self.elem.size * self.length;
	pub fn type_align(val self): usz => self.elem.align;
}

impl FnType {
	pub fn type_size(val self): usz => 8;
	pub fn type_align(val self): usz => 8;
}

// ============================================================================
// Primitive Types Constructors
// ============================================================================

pub fn type_primitive(kind: DataType): Type {
	val size: usz = when (kind) {
		DataType.NONE -> 0;
		DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64 -> 8;
		DataType.STR -> 16;
		else -> 8;
	};
	val align: usz = when (kind) {
		DataType.NONE, DataType.BOOL, DataType.CHAR, DataType.I8, DataType.U8 -> 1;
		DataType.I16, DataType.U16 -> 2;
		DataType.I32, DataType.U32, DataType.F32 -> 4;
		DataType.I64, DataType.ISZ, DataType.U64, DataType.USZ, DataType.F64, DataType.STR -> 8;
		else -> 8;
	};
	return Type(kind, size, align, TypePayload.NONE);
}

pub fn type_none() => type_primitive(DataType.NONE);
pub fn type_bool() => type_primitive(DataType.BOOL);
pub fn type_char() => type_primitive(DataType.CHAR);

pub fn type_i8() => type_primitive(DataType.I8);
pub fn type_i16() => type_primitive(DataType.I16);
pub fn type_i32() => type_primitive(DataType.I32);
pub fn type_i64() => type_primitive(DataType.I64);
pub fn type_isz() => type_primitive(DataType.ISZ);

pub fn type_u8() => type_primitive(DataType.U8);
pub fn type_u16() => type_primitive(DataType.U16);
pub fn type_u32() => type_primitive(DataType.U32);
pub fn type_u64() => type_primitive(DataType.U64);
pub fn type_usz() => type_primitive(DataType.USZ);

pub fn type_f32() => type_primitive(DataType.F32);
pub fn type_f64() => type_primitive(DataType.F64);

pub fn type_str() => type_primitive(DataType.STR);

// ============================================================================
// Complex Type Allocators (impl Arena Extension)
// ============================================================================

impl Arena {
	pub fn type_payload(var self, kind: DataType, size: usz, align: usz, data: TypePayload): *Type {
		return self.alloc_val<Type>(Type(kind, size, align, data));
	}

	pub fn primitive_type(var self, base: Type) => self.alloc_val<Type>(base);

	pub fn pointer_type(var self, pointee: *Type, is_mut: bool): *Type {
		val inner = self.alloc_val<PointerType>(PointerType(pointee, is_mut, false));
		return self.type_payload(PointerType.TAG, 8, 8, TypePayload.Pointer(inner));
	}

	pub fn nullable_pointer_type(var self, pointee: *Type, is_mut: bool): *Type {
		val inner = self.alloc_val<PointerType>(PointerType(pointee, is_mut, true));
		return self.type_payload(PointerType.TAG, 8, 8, TypePayload.Pointer(inner));
	}

	pub fn array_type(var self, elem: *Type, length: usz): *Type {
		val inner = self.alloc_val<ArrayType>(ArrayType(elem, length));
		return self.type_payload(ArrayType.TAG, elem.size * length, elem.align, TypePayload.Array(inner));
	}

	pub fn fn_type(var self, param_types: List<*Type>, return_type: *Type): *Type {
		val inner = self.alloc_val<FnType>(FnType(param_types, return_type));
		return self.type_payload(FnType.TAG, 8, 8, TypePayload.Fn(inner));
	}

}

// ============================================================================
// Payload accessors. A wrong-kind accessor returns null instead of casting an
// unrelated payload; callers branch on `kind` first.
impl Type {
	// The payload is bound to a local first: arm aliases bind subjects by name.
	pub fn as_pointer(val self): *PointerType {
		val data = self.data;
		return when (data) {
			is TypePayload.Pointer as p -> p.inner;
			else -> null;
		};
	}

	pub fn as_array(val self): *ArrayType {
		val data = self.data;
		return when (data) {
			is TypePayload.Array as p -> p.inner;
			else -> null;
		};
	}

	pub fn as_struct(val self): *StructType {
		val data = self.data;
		return when (data) {
			is TypePayload.Struct as p -> p.inner;
			else -> null;
		};
	}

	pub fn as_struct_mut(val self): &StructType {
		val data = self.data;
		return when (data) {
			is TypePayload.Struct as p -> p.inner as &StructType;
			else -> null;
		};
	}

	pub fn as_fn(val self): *FnType {
		val data = self.data;
		return when (data) {
			is TypePayload.Fn as p -> p.inner;
			else -> null;
		};
	}

	pub fn as_fn_mut(val self): &FnType {
		val data = self.data;
		return when (data) {
			is TypePayload.Fn as p -> p.inner as &FnType;
			else -> null;
		};
	}

	pub fn as_enum(val self): *EnumInfo {
		val data = self.data;
		return when (data) {
			is TypePayload.Enum as p -> p.inner;
			else -> null;
		};
	}

	// Methods of a built-in type. Called through the canonical instance from
	// `PrimTypes`, so `i32` accumulates exactly one method list.
	pub fn add_method(var self, mi: *MethodInfo) {
		if (self.methods == null) return;
		self.methods.list += mi;
	}

	// The method list, empty when this type has no payload (a non-canonical
	// primitive built by `type_primitive`, a pointer, an array, ...).
	pub fn method_list(val self): List<*MethodInfo> {
		if (self.methods == null) return List<*MethodInfo>();
		return self.methods.list;
	}

	pub fn method_named(val self, name: str): *MethodInfo {
		val list = self.method_list();
		for (m in list) {
			if (m.name == name) return m;
		}
		return null;
	}

	pub fn method_arity(val self, name: str, argc: usz): *MethodInfo {
		val list = self.method_list();
		for (m in list) {
			if (m.name == name && m.fn_type.as_fn().param_types.len == argc) return m;
		}
		return null;
	}

	pub fn method_by_c_name(val self, c_name: str): *MethodInfo {
		val list = self.method_list();
		for (m in list) {
			if (m.c_name == c_name) return m;
		}
		return null;
	}

	pub fn is_signed_integer(val self) => when (self.kind) {
		DataType.I8, DataType.I16, DataType.I32,
		DataType.I64, DataType.ISZ -> true;
		else -> false;
	};

	pub fn is_unsigned_integer(val self) => when (self.kind) {
		DataType.U8, DataType.U16, DataType.U32,
		DataType.U64, DataType.USZ -> true;
		else -> false;
	};

	pub fn is_integer(val self) => self.is_signed_integer() || self.is_unsigned_integer();

	pub fn is_float(val self) => when (self.kind) {
		DataType.F32, DataType.F64 -> true;
		else -> false;
	};

	pub fn is_enum(val self): bool => when (self.data) {
		is TypePayload.Enum -> true;
		else -> false;
	};

	pub fn is_numeric(val self) => self.is_integer() || self.is_float();

	pub fn is_list(val self): bool {
		if (self.kind != DataType.STRUCT) return false;
		val s = self.as_struct();
		if (s.module != "std.collections.list") return false;
		return s.name.starts_with("std__collections__list__List") ||
			s.c_name.starts_with("std__collections__list__List");
	}

	pub fn layout_struct(var self) {
		val st = self.as_struct_mut();
		var max_align: usz = 1;
		var off: usz = 0;
		for (i in 0..<st.fields.len) {
			val f = st.fields[i];
			val fa = f.type_ptr.align;
			if (fa > max_align) max_align = fa;
			val rem = off % fa;
			if (rem != 0) off += (fa - rem);
			f.offset = off;
			st.fields[i] = f;
			off += f.type_ptr.size;
		}
		val tr = off % max_align;
		if (tr != 0) off += (max_align - tr);

		self.size = off;
		self.align = max_align;
	}

	pub fn equals(val self, b: *Type): bool {
		if (self == b) return true;
		if (self.kind != b.kind) return false;

		if (self.is_enum() || b.is_enum()) {
			if (!self.is_enum() || !b.is_enum()) return false;
			val ea = self.as_enum();
			val eb = b.as_enum();
			val n_a = if (ea.c_name.empty()) ea.name else ea.c_name;
			val n_b = if (eb.c_name.empty()) eb.name else eb.c_name;
			return n_a == n_b;
		}

		return when (self.kind) {
			DataType.POINTER -> {
				val p_a = self.as_pointer();
				val p_b = b.as_pointer();
				yield p_a.is_mut == p_b.is_mut &&
					p_a.is_nullable == p_b.is_nullable &&
					p_a.pointee.equals(p_b.pointee);
			}
			DataType.ARRAY -> {
				val arr_a = self.as_array();
				val arr_b = b.as_array();
				yield arr_a.length == arr_b.length && arr_a.elem.equals(arr_b.elem);
			}
			DataType.STRUCT -> {
				// Struct names are only unique per module: compare the mangled C name
				// when there is one, so `a::Item` and `b::Item` stay distinct.
				val s_a = self.as_struct();
				val s_b = b.as_struct();
				val n_a = if (s_a.c_name.empty()) s_a.name else s_a.c_name;
				val n_b = if (s_b.c_name.empty()) s_b.name else s_b.c_name;
				yield n_a == n_b;
			}
			DataType.FN -> {
				val f_a = self.as_fn();
				val f_b = b.as_fn();
				if (f_a.param_types.len != f_b.param_types.len) yield false;
				if (!f_a.return_type.equals(f_b.return_type)) yield false;

				for (i in 0..<f_a.param_types.len) {
					if (!f_a.param_types[i].equals(f_b.param_types[i])) yield false;
				}
				yield true;
			}
			else -> true;
		};
	}

	pub op equals(val self, b: Type): bool => self.equals(&b);

	pub fn can_assign(val self, source: *Type): bool {
		if (self.equals(source)) return true;

		// Enum raw-value coercion: an enum with an underlying primitive can coerce
		// to and from that primitive type.
		if (self.is_enum() && !self.as_enum().is_payload) {
			if (!source.is_enum() && self.as_enum().underlying.can_assign(source)) return true;
		}
		if (source.is_enum() && !source.as_enum().is_payload) {
			if (!self.is_enum() && self.can_assign(source.as_enum().underlying)) return true;
		}

		// 1. Allow assignment between integer types (integer coercion / literal assignment)
		if (self.is_integer() && source.is_integer()) return true;

		// 2. Allow assignment between float types
		if (self.is_float() && source.is_float()) return true;
		if (self.is_float() && source.is_integer()) return true;

		// 3. Allow passing/assigning str to *char, &char, *u8, &u8, *none
		if (self.kind == DataType.POINTER && source.kind == DataType.STR) {
			val t_ptr = self.as_pointer();
			if (
				t_ptr.pointee.kind == DataType.CHAR ||
				t_ptr.pointee.kind == DataType.U8 ||
				t_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		// 4. Allow assigning a char/u8 pointer to str
		if (self.kind == DataType.STR && source.kind == DataType.POINTER) {
			val s_ptr = source.as_pointer();
			if (s_ptr.is_nullable) return false;
			if (
				s_ptr.pointee.kind == DataType.CHAR ||
				s_ptr.pointee.kind == DataType.U8
			) return true;
		}

		// 5. Allow assigning a mutable pointer to an immutable pointer: *mut T -> *T,
		// and allow assigning a non-nullable pointer to a nullable pointer: *T -> *T?
		if (self.kind == DataType.POINTER && source.kind == DataType.POINTER) {
			val t_ptr = self.as_pointer();
			val s_ptr = source.as_pointer();

			// Nullable pointer cannot be assigned to non-nullable pointer
			if (s_ptr.is_nullable && !t_ptr.is_nullable) return false;

			if (
				(!t_ptr.is_mut || s_ptr.is_mut) &&
				t_ptr.pointee.equals(s_ptr.pointee)
			) return true;

			// Allow none pointer (or u8 pointer / null pointer) to be compatible with other pointers
			if (
				t_ptr.pointee.kind == DataType.U8 ||
				t_ptr.pointee.kind == DataType.NONE ||
				s_ptr.pointee.kind == DataType.NONE
			) return true;
		}

		return false;
	}

}

impl ToStr for Type {

	pub fn to_str(val self): str => when (self.kind) {
		DataType.NONE -> "none";
		DataType.BOOL -> "bool";
		DataType.CHAR -> "char";
		DataType.I8 -> "i8";
		DataType.I16 -> "i16";
		DataType.I32 -> "i32";
		DataType.I64 -> "i64";
		DataType.ISZ -> "isz";
		DataType.U8 -> "u8";
		DataType.U16 -> "u16";
		DataType.U32 -> "u32";
		DataType.U64 -> "u64";
		DataType.USZ -> "usz";
		DataType.F32 -> "f32";
		DataType.F64 -> "f64";
		DataType.STR -> "str";
		DataType.POINTER -> {
			val ptr = self.as_pointer();
			val q = if (ptr.is_nullable) "?" else "";
			if (ptr.is_mut) yield "*mut ${ptr.pointee.to_str()}${q}";
			yield "*${ptr.pointee.to_str()}${q}";
		}
		DataType.ARRAY -> {
			val arr = self.as_array();
			yield "[${arr.elem.to_str()}]";
		}
		DataType.STRUCT -> {
			val s = self.as_struct();
			yield s.name;
		}
		DataType.FN -> "fn(...)";
		else -> "unknown";
	};

}
