mod compiler.sema.desugar_interp;

use compiler.lexer.token.TokenType;

use compiler.ast.node.AstNode;
use compiler.ast.types.*;
use compiler.ast.builder.AstBuilder;

use compiler.sema.types.*;
use compiler.sema.types.as_pointer_type as sem_pointer;
use compiler.sema.types.as_array_type as sem_array;
use compiler.sema.types.as_struct_type as sem_struct;

use std.collections.list.List;
use std.mem.arena.Arena;

// ============================================================================
// String interpolation lowering
//
// `"a${x}b"` is lowered here into a `kobel_concat` chain; each hole is converted
// to `str` according to its type. Nothing of this reaches the C backend beyond
// calls to the prelude helpers, so codegen needs no new knowledge.
// ============================================================================

// A call to a prelude helper. Left unchecked on purpose: the prelude is emitted
// by codegen and has no symbol table entry.
pub fn interp_call(var arena: &Arena, name: str, arg: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(arg);
	var b = AstBuilder(arena);
	return b.call(b.identifier(name, line, col), args, List<*AstNode>(), line, col);
}

pub fn interp_concat(var arena: &Arena, a: *AstNode, b_node: *AstNode, line: usz, col: usz): *AstNode {
	var args = List<*AstNode>();
	args.add(a);
	args.add(b_node);
	var b = AstBuilder(arena);
	return b.call(b.identifier("kobel_concat", line, col), args, List<*AstNode>(), line, col);
}

// Builds an AST type node for a resolved semantic type, so locals can carry an
// explicit annotation the C backend understands.
pub fn ast_type_from_type(var arena: &Arena, ty: *Type): *AstNode {
	var b = AstBuilder(arena);
	if (is_enum_type(ty)) return b.named_type(as_enum_info(ty).c_name, List<*AstNode>(), 0, 0);

	return when (ty.kind) {
		DataType.POINTER -> {
			val pt = sem_pointer(ty);
			val base_ptr = b.pointer_type(pt.is_mut, ast_type_from_type(arena, pt.pointee), 0, 0);
			if (pt.is_nullable) yield b.nullable_type(base_ptr, 0, 0);
			yield base_ptr;
		}
		DataType.ARRAY -> {
			val at = sem_array(ty);
			yield b.array_type(ast_type_from_type(arena, at.elem), at.length, 0, 0);
		}
		DataType.STRUCT -> {
			val st_info = sem_struct(ty);
			var st_name = st_info.name;
			if (st_info.c_name.len > 0) st_name = st_info.c_name;
			yield b.named_type(st_name, List<*AstNode>(), 0, 0);
		}
		DataType.NONE -> b.named_type("none", List<*AstNode>(), 0, 0);
		DataType.STR -> b.named_type("str", List<*AstNode>(), 0, 0);
		DataType.BOOL -> b.named_type("bool", List<*AstNode>(), 0, 0);
		DataType.CHAR -> b.named_type("char", List<*AstNode>(), 0, 0);
		DataType.I8 -> b.named_type("i8", List<*AstNode>(), 0, 0);
		DataType.I16 -> b.named_type("i16", List<*AstNode>(), 0, 0);
		DataType.I32 -> b.named_type("i32", List<*AstNode>(), 0, 0);
		DataType.I64 -> b.named_type("i64", List<*AstNode>(), 0, 0);
		DataType.ISZ -> b.named_type("isz", List<*AstNode>(), 0, 0);
		DataType.U8 -> b.named_type("u8", List<*AstNode>(), 0, 0);
		DataType.U16 -> b.named_type("u16", List<*AstNode>(), 0, 0);
		DataType.U32 -> b.named_type("u32", List<*AstNode>(), 0, 0);
		DataType.U64 -> b.named_type("u64", List<*AstNode>(), 0, 0);
		DataType.USZ -> b.named_type("usz", List<*AstNode>(), 0, 0);
		DataType.F32 -> b.named_type("f32", List<*AstNode>(), 0, 0);
		DataType.F64 -> b.named_type("f64", List<*AstNode>(), 0, 0);
		else -> null;
	};
}

// Builds `kobel_streq(a, b)`, optionally negated, for str equality.
pub fn make_str_eq(var arena: &Arena, is_neq: bool, left: *AstNode, right: *AstNode, line: usz, col: usz): *AstNode {
	var eargs = List<*AstNode>();
	eargs.add(left);
	eargs.add(right);
	var b = AstBuilder(arena);
	val eq_call = b.call(b.identifier("kobel_streq", line, col), eargs, List<*AstNode>(), line, col);
	if (is_neq) return b.unary(TokenType.BANG, eq_call, line, col);
	return eq_call;
}
