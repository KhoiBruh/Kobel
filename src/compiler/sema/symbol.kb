mod compiler.sema.symbol;

use std.mem.arena.*;
use std.collections.list.*;
use std.collections.hash_map.*;
use std.traits.iterable.Iterable;

use compiler.sema.types.Type;
use compiler.sema.types.DataType;
use compiler.sema.types.MethodInfo;
use compiler.sema.types.EnumInfo;
use compiler.sema.types.PrimTypes;
use compiler.ast.node.AstNode;
// ============================================================================
// SymbolKind Enumeration
// ============================================================================

pub enum SymbolKind {
	VAR,
	CONST,
	PARAM,
	FN,
	STRUCT,
	ENUM,
	MODULE,
	TYPE_ALIAS
}

// ============================================================================
// Symbol Representation
// ============================================================================

pub struct Symbol {
	pub name: str,
	pub c_name: str,
	pub kind: SymbolKind,
	pub type_ptr: *Type,
	pub is_mut: bool,
	pub is_pub: bool,
	pub line: usz,
	pub col: usz,
	pub ast_node: *u8 = null
}

// ============================================================================
// Lexical Scope
// ============================================================================

pub struct Scope {
	pub parent: *Scope = null,
	pub symbols: List<*Symbol> = List<*Symbol>(),
	pub is_fn_boundary: bool = false
}

impl Scope {
	pub fn lookup(self, name: str): *Symbol {
		for (sym in self.symbols) {
			if (sym.name == name) return sym;
		}
		return null;
	}

	pub op get(val self, name: str): *Symbol => self.lookup(name);

	pub op contains(val self, name: str): bool => self.lookup(name) != null;

	pub op plus_assign(var self, sym: *Symbol) {
		self.symbols += sym;
	}
}

impl Iterable for Scope {
	pub fn count(val self) => self.symbols.len;
	pub fn at(val self, i: usz) => self.symbols[i];
}

// ============================================================================
// Module Scope & Imports
// ============================================================================

// A `use` that resolved to a symbol of another module.
// When `is_wildcard` = true, every symbol of `module_name` is usable.
// `owner_module` is the module the `use` was written in, so imports stay
// scoped: two modules importing the same name do not affect each other.
pub struct ImportBinding {
	pub module_name: str,
	pub symbol_name: str,
	pub local_name: str,
	pub is_wildcard: bool,
	pub owner_module: str
}

pub struct ModuleScope {
	pub name: str,
	pub symbols: List<*Symbol> = List<*Symbol>(),
	pub sym_map: HashMap<*Symbol> = HashMap<*Symbol>()
}

impl ModuleScope {
	pub fn lookup(self, name: str): *Symbol => self.sym_map.get_or(name, null);

	pub op get(val self, name: str): *Symbol => self.lookup(name);

	pub op contains(val self, name: str): bool => name in self.sym_map;

	pub op plus_assign(var self, sym: *Symbol) {
		self.symbols += sym;
		self.sym_map[sym.name] = sym;
	}
}

impl Iterable for ModuleScope {
	pub fn count(val self) => self.symbols.len;
	pub fn at(val self, i: usz) => self.symbols[i];
}

// A generic declaration kept as a template until instantiated.
pub struct GenTemplate {
	pub name: str,
	pub module: str,
	pub node: *AstNode,
	pub is_method: bool
}

// A method declared inside a `trait` block. `has_default` is true when the
// trait provides a body (so the implementing type may leave it out).
pub struct TraitMethod {
	pub name: str,
	// Parameter count (receiver included): two methods may share a name when
	// they differ here, which is how overloaded trait methods are told apart.
	pub arity: usz,
	pub has_default: bool,
	pub node: *AstNode
}

// A collected `trait` declaration: its name, direct base traits (`trait A : B`)
// and its methods. Kept as raw AST so signature resolution stays lazy.
pub struct TraitInfo {
	pub name: str,
	pub bases: List<str>,
	pub methods: List<*TraitMethod>,
	// Source names of the structs with an `impl Trait for Struct` block.
	pub impls: List<str>
}

impl TraitInfo {
	pub fn find_method(self, name: str): *TraitMethod {
		for (m in self.methods) {
			if (m.name == name) return m;
		}
		return null;
	}

	pub fn has_impl(self, struct_name: str) => struct_name in self.impls;
}

// Monomorphization state, shared through the (single) SymbolTable.
pub struct GenericReg {
	pub struct_templates: List<*GenTemplate> = List<*GenTemplate>(),
	pub fn_templates: List<*GenTemplate> = List<*GenTemplate>(),
	pub impl_templates: List<*GenTemplate> = List<*GenTemplate>(),
	pub inst_syms: List<*Symbol> = List<*Symbol>(),
	pub inst_map: HashMap<*Symbol> = HashMap<*Symbol>(),
	// Declarations produced by instantiation, as `module marker, decl` pairs in
	// creation order (a dependency always precedes the instance that needs it).
	// The same list is the rewrite worklist: each instance still gets a fixpoint
	// pass so generic uses inside it are instantiated too.
	pub instances: List<*AstNode> = List<*AstNode>()
}

impl GenericReg {
	pub fn add_inst(var self, sym: *Symbol) {
		self.inst_syms += sym;
		self.inst_map[sym.name] = sym;
	}

	pub fn find_struct(val self, name: str): *GenTemplate {
		for (t in self.struct_templates) {
			if (t.name == name) return t;
		}
		return null;
	}

	pub fn find_fn(val self, name: str): *GenTemplate {
		for (t in self.fn_templates) {
			if (t.name == name) return t;
		}
		return null;
	}

	pub fn find_impl(val self, name: str): *GenTemplate {
		for (t in self.impl_templates) {
			if (t.name == name) return t;
		}
		return null;
	}

	pub fn find_inst(val self, name: str): *Symbol => self.inst_map.get_or(name, null);
}

pub fn box_symbol(var arena: &Arena, sym: Symbol) => arena.alloc_val<Symbol>(sym);

// ============================================================================
// Symbol Table
// ============================================================================

pub struct SymbolTable {
	pub current_scope: *Scope,
	pub arena: Arena,
	pub current_module: str = "",
	// NOTE: List<*ModuleScope> rather than List<ModuleScope>:
	// `List.get` returns a COPY of the value (val), so any change through the copy
	// (e.g. `sc.symbols += ...`) will not be visible on the next access.
	// Keep pointers so define/lookup work correctly on both v0 and v1.
	pub modules: List<*ModuleScope> = List<*ModuleScope>(),
	pub module_map: HashMap<*ModuleScope> = HashMap<*ModuleScope>(),
	pub imports: List<ImportBinding> = List<ImportBinding>(),
	// Enum member tables, keyed by source name / mangled C name.
	pub enums: List<*EnumInfo> = List<*EnumInfo>(),
	pub enum_map: HashMap<*EnumInfo> = HashMap<*EnumInfo>(),
	// Collected `trait` declarations, by source name.
	pub traits: List<*TraitInfo> = List<*TraitInfo>(),
	pub trait_map: HashMap<*TraitInfo> = HashMap<*TraitInfo>(),
	// Methods extending the built-in (primitive) types live on the canonical
	// `Type` of each kind (see `PrimTypes`); these helpers are the read side.
	pub c_name_map: HashMap<*Symbol> = HashMap<*Symbol>(),
	pub struct_const_map: HashMap<*Symbol> = HashMap<*Symbol>(),
	pub explicit_imports: HashMap<ImportBinding> = HashMap<ImportBinding>(),
	pub wildcard_owners: List<str> = List<str>(),
	pub wildcard_modules: List<str> = List<str>(),
	pub gen: GenericReg = GenericReg(),
	// Canonical primitive types, built on first use from this table's arena.
	pub prims: *PrimTypes = null
}

impl SymbolTable {
	pub fn new(): Self {
		val arena = Arena();
		val root_scope = arena.alloc_val<Scope>(Scope());
		var st = Self(root_scope, arena);
		// Build the canonical primitives eagerly so every copy of this table
		// shares the same type instances.
		st.prims = arena.alloc<PrimTypes>();
		*st.prims = PrimTypes(&arena);
		return st;
	}

	pub fn prims_of(val self): *PrimTypes => self.prims;

	// Register a method of a built-in type on its canonical instance.
	pub fn register_prim_method(var self, prim: *Type, mi: *MethodInfo) {
		var target = prim;
		target.add_method(mi);
	}

	// Method of a primitive type by its source name (used by `x.m()` resolution).
	pub fn find_prim_method(val self, kind: DataType, name: str): *MethodInfo {
		val t = self.prims.get(kind);
		if (t == null) return null;
		return t.method_named(name);
	}

	// Overload-aware variant of `find_prim_method` (parameter count includes the
	// receiver). Null when no overload matches, so the caller can fall back.
	pub fn find_prim_method_arity(val self, kind: DataType, name: str, argc: usz): *MethodInfo {
		val t = self.prims.get(kind);
		if (t == null) return null;
		return t.method_arity(name, argc);
	}

	// Every method of a primitive kind, in declaration order (default-argument
	// resolution walks this list like it walks `StructType.methods`).
	pub fn prim_methods_of(val self, kind: DataType): List<*MethodInfo> {
		val t = self.prims.get(kind);
		if (t == null) return List<*MethodInfo>();
		return t.method_list();
	}

	// Primitive method by its mangled C name (used when re-visiting an impl).
	pub fn find_prim_method_c(val self, c_name: str): *MethodInfo {
		for (t in self.prims.types) {
			val m = t.method_by_c_name(c_name);
			if (m != null) return m;
		}
		return null;
	}

	pub fn register_trait(var self, info: *TraitInfo) {
		self.traits += info;
		self.trait_map[info.name] = info;
	}

	pub fn find_trait(val self, name: str): *TraitInfo => self.trait_map.get_or(name, null);

	pub fn register_enum_info(var self, info: *EnumInfo) {
		self.enums += info;
		self.enum_map[info.name] = info;
		if (!info.c_name.empty() && info.c_name != info.name) {
			self.enum_map[info.c_name] = info;
		}
	}

	pub fn find_enum_info(val self, name: str): *EnumInfo => self.enum_map.get_or(name, null);

	pub fn enter_scope(var self, is_fn_boundary: bool): *Scope {
		val new_sc = self.arena.alloc_val<Scope>(Scope(self.current_scope, List<*Symbol>(), is_fn_boundary));
		self.current_scope = new_sc;
		return new_sc;
	}

	pub fn exit_scope(var self) {
		if (self.current_scope.parent != null) {
			self.current_scope = self.current_scope.parent;
		}
	}

	pub fn is_in_function(var self): bool {
		var curr = self.current_scope;
		while (curr != null) {
			if (curr.is_fn_boundary) return true;
			curr = curr.parent;
		}
		return false;
	}

	pub fn lookup_current(var self, name: str): *Symbol {
		val scope = self.current_scope;
		for (sym in scope) {
			if (sym.name == name) return sym;
		}
		return null;
	}

	// Name lookup: local scope -> declarations of the current module -> imports of
	// the current module -> mangled C name (so re-resolution gives the same result).
	pub fn lookup(var self, name: str): *Symbol {
		var curr = self.current_scope;
		while (curr != null) {
			for (sym in curr) {
				if (sym.name == name) return sym;
			}
			curr = curr.parent;
		}

		// 2. Top-level declarations of the current module
		val own = self.lookup_in_module(self.current_module, name);
		if (own != null) return own;

		// 3. Explicit imports (by original name or alias), scoped to this module
		val b = self.explicit_imports["${self.current_module}::${name}"];
		if (b != null) {
			val found = self.lookup_in_module(b.module_name, b.symbol_name);
			if (found != null) return found;
		}

		// 4. Wildcard imports, scoped to this module
		for (i in 0..<self.wildcard_owners.len) {
			if (self.wildcard_owners[i] == self.current_module) {
				val found = self.lookup_in_module(self.wildcard_modules[i], name);
				if (found != null) return found;
			}
		}

		// 5. Instantiated generic symbols (or fallback to mangled C name)
		return self.gen.find_inst(name) ?: self.lookup_c_name(name);
	}

	pub fn define(var self, sym: Symbol): bool {
		// Check for duplicate definitions in the same scope
		val existing = self.lookup_current(sym.name);
		if (existing != null) return false;

		val sym_ptr = self.arena.alloc_val<Symbol>(sym);

		self.current_scope += sym_ptr;
		return true;
	}

	pub fn set_current_module(var self, name: str) => self.current_module = name;

	pub fn find_module(val self, name: str): *ModuleScope => self.module_map.get_or(name, null);

	pub fn module_exists(val self, name: str) => name in self.module_map;

	// Define a top-level declaration into the scope of the given module.
	pub fn define_in_module(var self, module_name: str, sym: Symbol): bool {
		val sc = self.find_module(module_name);
		if (sc != null) {
			if (sym.name in sc) return false;
			val sym_ptr = self.arena.alloc_val<Symbol>(sym);
			sc += sym_ptr;
			if (!sym.c_name.empty() && sym.c_name != sym.name) {
				self.c_name_map[sym.c_name] = sym_ptr;
			}
			if (sym.kind == SymbolKind.CONST) {
				self.struct_const_map[sym.name] = sym_ptr;
			}
			return true;
		}

		// Module scope does not exist yet -> create it (via pointer) then add the symbol
		val fresh = self.arena.alloc_val<ModuleScope>(ModuleScope(module_name));
		val sym_ptr2 = self.arena.alloc_val<Symbol>(sym);
		fresh += sym_ptr2;
		self.modules += fresh;
		self.module_map[module_name] = fresh;
		if (!sym.c_name.empty() && sym.c_name != sym.name) {
			self.c_name_map[sym.c_name] = sym_ptr2;
		}
		if (sym.kind == SymbolKind.CONST) {
			self.struct_const_map[sym.name] = sym_ptr2;
		}
		return true;
	}

	// Define a top-level declaration into the module currently being collected.
	pub fn define_global(var self, sym: Symbol) => self.define_in_module(self.current_module, sym);

	pub fn add_import(var self, module_name: str, symbol_name: str, local_name: str, is_wildcard: bool) {
		val binding = ImportBinding(module_name, symbol_name, local_name, is_wildcard, self.current_module);
		self.imports += binding;
		if (is_wildcard) {
			self.wildcard_owners += self.current_module;
			self.wildcard_modules += module_name;
		} else {
			self.explicit_imports["${self.current_module}::${local_name}"] = binding;
		}
	}

	pub fn lookup_in_module(val self, module_name: str, name: str): *Symbol {
		val sc = self.find_module(module_name) ?: return null;
		return sc.lookup(name);
	}

	// Look up by generated C name (used when re-resolving a mangled name).
	pub fn lookup_c_name(val self, c_name: str): *Symbol {
		if (c_name.len == 0) return null;
		return self.c_name_map.get_or(c_name, null);
	}

	pub fn lookup_struct_const(val self, struct_name: str, member_name: str): *Symbol {
		val direct = "${struct_name}__${member_name}";
		val s = self.struct_const_map.get_or(direct, null);
		if (s != null) return s;
		for (sc in self.modules) {
			val sc_s = sc.lookup(direct);
			if (sc_s != null && sc_s.kind == SymbolKind.CONST) return sc_s;
		}
		return null;
	}
}
