mod compiler.sema.symbol;

use compiler.sema.types.Type;
use compiler.sema.types.EnumInfo;
use compiler.ast.node.AstNode;

use std.collections.list.*;
use std.mem.arena.*;

// ============================================================================
// SymbolKind Enumeration
// ============================================================================

pub enum SymbolKind {
	VAR,
	CONST,
	PARAM,
	FN,
	STRUCT,
	ENUM,
	MODULE,
	TYPE_ALIAS
}

// ============================================================================
// Symbol Representation
// ============================================================================

pub struct Symbol {
	pub name: str,
	pub c_name: str,
	pub kind: SymbolKind,
	pub type_ptr: *Type,
	pub is_mut: bool,
	pub is_pub: bool,
	pub line: usz,
	pub col: usz
}

// ============================================================================
// Lexical Scope
// ============================================================================

pub struct Scope {
	pub parent: *Scope,
	pub symbols: List<*Symbol>,
	pub is_fn_boundary: bool
}

// ============================================================================
// Module Scope & Imports
// ============================================================================

pub struct ModuleScope {
	pub name: str,
	pub symbols: List<*Symbol>
}

pub fn new_module_scope(name: str): ModuleScope {
	return ModuleScope(name, new_list<*Symbol>());
}

// A `use` that resolved to a symbol of another module.
// When `is_wildcard` = true, every symbol of `module_name` is usable.
// `owner_module` is the module the `use` was written in, so imports stay
// scoped: two modules importing the same name do not affect each other.
pub struct ImportBinding {
	pub module_name: str,
	pub symbol_name: str,
	pub local_name: str,
	pub is_wildcard: bool,
	pub owner_module: str
}

// A generic declaration kept as a template until instantiated.
pub struct GenTemplate {
	pub name: str,
	pub module: str,
	pub node: *AstNode
}

// Monomorphization state, shared through the (single) SymbolTable.
pub struct GenericReg {
	pub struct_templates: List<*GenTemplate>,
	pub fn_templates: List<*GenTemplate>,
	pub impl_templates: List<*GenTemplate>,
	pub inst_syms: List<*Symbol>,
	pub inst_names: List<str>,
	pub pending: List<*AstNode>
}

pub fn gen_find(list: List<*GenTemplate>, name: str): *GenTemplate {
	var i: usz = 0;
	while (i < list.len) {
		val t = list.get(i);
		if (t.name == name) return t;
		i = i + 1;
	}
	return null;
}

pub fn box_symbol(var arena: &Arena, sym: Symbol): *Symbol {
	val p = arena_alloc<Symbol>(arena);
	*p = sym;
	return p;
}

// ============================================================================
// Symbol Table
// ============================================================================

pub struct SymbolTable {
	pub current_scope: *Scope,
	pub arena: Arena,
	pub current_module: str,
	// NOTE: List<*ModuleScope> rather than List<ModuleScope>:
	// `List.get` returns a COPY of the value (val), so any change through the copy
	// (e.g. `sc.symbols.add(...)`) will not be visible on the next access.
	// Keep pointers so define/lookup work correctly on both v0 and v1.
	pub modules: List<*ModuleScope>,
	pub imports: List<ImportBinding>,
	// Enum member tables, keyed by source name / mangled C name.
	pub enums: List<*EnumInfo>,
	pub gen: GenericReg
}

pub fn new_symbol_table(): SymbolTable {
	var arena = new_arena(65536);
	val root_scope = arena_alloc<Scope>(&arena);
	*root_scope = Scope(null, new_list<*Symbol>(), false);

	val gen = GenericReg(
		new_list<*GenTemplate>(),
		new_list<*GenTemplate>(),
		new_list<*GenTemplate>(),
		new_list<*Symbol>(),
		new_list<str>(),
		new_list<*AstNode>()
	);

	return SymbolTable(root_scope, arena, "", new_list<*ModuleScope>(), new_list<ImportBinding>(), new_list<*EnumInfo>(), gen);
}

pub fn register_enum_info(var self: &SymbolTable, info: *EnumInfo) {
	self.enums.add(info);
}

pub fn find_enum_info(self: &SymbolTable, name: str): *EnumInfo {
	var i: usz = 0;
	while (i < self.enums.len) {
		val e = self.enums.get(i);
		if (e.name == name || e.c_name == name) return e;
		i = i + 1;
	}
	return null;
}

pub fn enter_scope(var self: &SymbolTable, is_fn_boundary: bool): *Scope {
	val new_sc = arena_alloc<Scope>(&self.arena);
	*new_sc = Scope(self.current_scope, new_list<*Symbol>(), is_fn_boundary);
	self.current_scope = new_sc;
	return new_sc;
}

pub fn exit_scope(var self: &SymbolTable) {
	if (self.current_scope.parent != null) {
		self.current_scope = self.current_scope.parent;
	}
}

pub fn is_in_function(var self: &SymbolTable): bool {
	var curr = self.current_scope;
	while (curr != null) {
		if (curr.is_fn_boundary) return true;
		curr = curr.parent;
	}
	return false;
}

pub fn lookup_current(var self: &SymbolTable, name: str): *Symbol {
	val scope = self.current_scope;
	var i: usz = 0;
	while (i < scope.symbols.len) {
		val sym = scope.symbols.get(i);
		if (sym.name == name) return sym;
		i = i + 1;
	}
	return null;
}

// Name lookup: local scope -> declarations of the current module -> imports of
// the current module -> mangled C name (so re-resolution gives the same result).
pub fn lookup(var self: &SymbolTable, name: str): *Symbol {
	var curr = self.current_scope;
	while (curr != null) {
		var i: usz = 0;
		while (i < curr.symbols.len) {
			val sym = curr.symbols.get(i);
			if (sym.name == name) return sym;
			i = i + 1;
		}
		curr = curr.parent;
	}

	// 2. Top-level declarations of the current module
	val own = lookup_in_module(self, self.current_module, name);
	if (own != null) return own;

	// 3. Explicit imports (by original name or alias), scoped to this module
	var k: usz = 0;
	while (k < self.imports.len) {
		val b = self.imports.get(k);
		if (!b.is_wildcard && b.local_name == name && b.owner_module == self.current_module) {
			return lookup_in_module(self, b.module_name, b.symbol_name);
		}
		k = k + 1;
	}

	// 4. Wildcard imports, scoped to this module
	var w: usz = 0;
	while (w < self.imports.len) {
		val b2 = self.imports.get(w);
		if (b2.is_wildcard && b2.owner_module == self.current_module) {
			val found = lookup_in_module(self, b2.module_name, name);
			if (found != null) return found;
		}
		w = w + 1;
	}

	// 5. Instantiated generic symbols (their name already equals the mangled C name)
	var g: usz = 0;
	while (g < self.gen.inst_syms.len) {
		val isym = self.gen.inst_syms.get(g);
		if (isym.name == name) return isym;
		g = g + 1;
	}

	// 6. Mangled C name (idempotent on repeated resolution)
	return lookup_c_name(self, name);
}

pub fn define(var self: &SymbolTable, sym: Symbol): bool {
	// Check for duplicate definitions in the same scope
	val existing = lookup_current(self, sym.name);
	if (existing != null) return false;

	val sym_ptr = arena_alloc<Symbol>(&self.arena);
	*sym_ptr = sym;

	self.current_scope.symbols.add(sym_ptr);
	return true;
}

// ============================================================================
// Module Scopes & Imports
// ============================================================================

pub fn set_current_module(var self: &SymbolTable, name: str) {
	self.current_module = name;
}

pub fn module_exists(self: &SymbolTable, name: str): bool {
	var m: usz = 0;
	while (m < self.modules.len) {
		if (self.modules.get(m).name == name) return true;
		m = m + 1;
	}
	return false;
}

// Define a top-level declaration into the scope of the given module.
pub fn define_in_module(var self: &SymbolTable, module_name: str, sym: Symbol): bool {
	var m: usz = 0;
	while (m < self.modules.len) {
		// get() returns a COPY of ModuleScope; after modifying you must set() it back,
		// otherwise len/cap of the original in self.modules diverge -> heap corruption.
		val sc = self.modules.get(m);
		if (sc.name == module_name) {
			var i: usz = 0;
			while (i < sc.symbols.len) {
				if (sc.symbols.get(i).name == sym.name) return false;
				i = i + 1;
			}
			val sym_ptr = arena_alloc<Symbol>(&self.arena);
			*sym_ptr = sym;
			sc.symbols.add(sym_ptr);
			self.modules.set(m, sc);
			return true;
		}
		m = m + 1;
	}

	// Module scope does not exist yet -> create it (via pointer) then add the symbol
	val fresh = arena_alloc<ModuleScope>(&self.arena);
	*fresh = new_module_scope(module_name);
	val sym_ptr2 = arena_alloc<Symbol>(&self.arena);
	*sym_ptr2 = sym;
	fresh.symbols.add(sym_ptr2);
	self.modules.add(fresh);
	return true;
}

// Define a top-level declaration into the module currently being collected.
pub fn define_global(var self: &SymbolTable, sym: Symbol): bool {
	return define_in_module(self, self.current_module, sym);
}

pub fn add_import(var self: &SymbolTable, module_name: str, symbol_name: str, local_name: str, is_wildcard: bool) {
	self.imports.add(ImportBinding(module_name, symbol_name, local_name, is_wildcard, self.current_module));
}

pub fn lookup_in_module(self: &SymbolTable, module_name: str, name: str): *Symbol {
	var m: usz = 0;
	while (m < self.modules.len) {
		val sc = self.modules.get(m);
		if (sc.name == module_name) {
			var i: usz = 0;
			while (i < sc.symbols.len) {
				val sym = sc.symbols.get(i);
				if (sym.name == name) return sym;
				i = i + 1;
			}
			return null;
		}
		m = m + 1;
	}
	return null;
}

// Look up by generated C name (used when re-resolving a mangled name).
pub fn lookup_c_name(self: &SymbolTable, c_name: str): *Symbol {
	if (c_name.len == 0) return null;
	var m: usz = 0;
	while (m < self.modules.len) {
		val sc = self.modules.get(m);
		var i: usz = 0;
		while (i < sc.symbols.len) {
			val sym = sc.symbols.get(i);
			if (sym.c_name == c_name && sym.c_name != sym.name) return sym;
			i = i + 1;
		}
		m = m + 1;
	}
	return null;
}
