mod compiler.sema.symbol;

use compiler.sema.types.Type;
use compiler.sema.types.DataType;
use compiler.sema.types.MethodInfo;
use compiler.sema.types.EnumInfo;
use compiler.ast.node.AstNode;

use std.collections.list.*;
use std.mem.arena.*;
use std.traits.iterable.Iterable;

// ============================================================================
// SymbolKind Enumeration
// ============================================================================

pub enum SymbolKind {
	VAR,
	CONST,
	PARAM,
	FN,
	STRUCT,
	ENUM,
	MODULE,
	TYPE_ALIAS
}

// ============================================================================
// Symbol Representation
// ============================================================================

pub struct Symbol {
	pub name: str,
	pub c_name: str,
	pub kind: SymbolKind,
	pub type_ptr: *Type,
	pub is_mut: bool,
	pub is_pub: bool,
	pub line: usz,
	pub col: usz
}

// ============================================================================
// Lexical Scope
// ============================================================================

pub struct Scope {
	pub parent: *Scope,
	pub symbols: List<*Symbol>,
	pub is_fn_boundary: bool
}

impl Scope {
	pub fn lookup(self, name: str): *Symbol {
		for (sym in self.symbols) {
			if (sym.name == name) return sym;
		}
		return null;
	}
}

impl Iterable for Scope {
	pub fn count(val self): usz => self.symbols.len;
	pub fn at(val self, i: usz): *Symbol => self.symbols[i];
}

// ============================================================================
// Module Scope & Imports
// ============================================================================

pub struct ModuleScope {
	pub name: str,
	pub symbols: List<*Symbol>
}

impl ModuleScope {
	pub fn new(name: str): ModuleScope => Self(name, List<*Symbol>());

	pub fn lookup(self, name: str): *Symbol {
		for (sym in self.symbols) {
			if (sym.name == name) return sym;
		}
		return null;
	}
}

impl Iterable for ModuleScope {
	pub fn count(val self): usz => self.symbols.len;
	pub fn at(val self, i: usz): *Symbol => self.symbols[i];
}

// A `use` that resolved to a symbol of another module.
// When `is_wildcard` = true, every symbol of `module_name` is usable.
// `owner_module` is the module the `use` was written in, so imports stay
// scoped: two modules importing the same name do not affect each other.
pub struct ImportBinding {
	pub module_name: str,
	pub symbol_name: str,
	pub local_name: str,
	pub is_wildcard: bool,
	pub owner_module: str
}

// A generic declaration kept as a template until instantiated.
pub struct GenTemplate {
	pub name: str,
	pub module: str,
	pub node: *AstNode,
	pub is_method: bool
}

// A method declared inside a `trait` block. `has_default` is true when the
// trait provides a body (so the implementing type may leave it out).
pub struct TraitMethod {
	pub name: str,
	// Parameter count (receiver included): two methods may share a name when
	// they differ here, which is how overloaded trait methods are told apart.
	pub arity: usz,
	pub has_default: bool,
	pub node: *AstNode
}

// A collected `trait` declaration: its name, direct base traits (`trait A : B`)
// and its methods. Kept as raw AST so signature resolution stays lazy.
pub struct TraitInfo {
	pub name: str,
	pub bases: List<str>,
	pub methods: List<*TraitMethod>,
	// Source names of the structs with an `impl Trait for Struct` block.
	pub impls: List<str>
}

impl TraitInfo {
	pub fn find_method(self, name: str): *TraitMethod {
		for (m in self.methods) {
			if (m.name == name) return m;
		}
		return null;
	}

	pub fn has_impl(self, struct_name: str): bool {
		for (s in self.impls) {
			if (s == struct_name) return true;
		}
		return false;
	}
}

// A method declared by an `impl <primitive> { ... }` block. Primitives are not
// structs, so their methods live here keyed by the built-in kind instead of on
// a `StructType`.
pub struct PrimMethod {
	pub kind: DataType,
	pub info: *MethodInfo
}

// Monomorphization state, shared through the (single) SymbolTable.
pub struct GenericReg {
	pub struct_templates: List<*GenTemplate>,
	pub fn_templates: List<*GenTemplate>,
	pub impl_templates: List<*GenTemplate>,
	pub inst_syms: List<*Symbol>,
	pub inst_names: List<str>,
	pub pending: List<*AstNode>
}

pub fn gen_find(list: List<*GenTemplate>, name: str): *GenTemplate {
	for (t in list) {
		if (t.name == name) return t;
	}
	return null;
}

pub fn box_symbol(var arena: &Arena, sym: Symbol): *Symbol => arena.alloc_val<Symbol>(sym);

// ============================================================================
// Symbol Table
// ============================================================================

pub struct SymbolTable {
	pub current_scope: *Scope,
	pub arena: Arena,
	pub current_module: str,
	// NOTE: List<*ModuleScope> rather than List<ModuleScope>:
	// `List.get` returns a COPY of the value (val), so any change through the copy
	// (e.g. `sc.symbols.add(...)`) will not be visible on the next access.
	// Keep pointers so define/lookup work correctly on both v0 and v1.
	pub modules: List<*ModuleScope>,
	pub imports: List<ImportBinding>,
	// Enum member tables, keyed by source name / mangled C name.
	pub enums: List<*EnumInfo>,
	// Collected `trait` declarations, by source name.
	pub traits: List<*TraitInfo>,
	// Methods extending the built-in (primitive) types.
	pub prim_methods: List<*PrimMethod>,
	pub gen: GenericReg
}

impl SymbolTable {
	pub fn new(): SymbolTable {
		var arena = Arena(65536);
		val root_scope = arena.alloc_val<Scope>(Scope(null, List<*Symbol>(), false));

		val gen = GenericReg(
			List<*GenTemplate>(),
			List<*GenTemplate>(),
			List<*GenTemplate>(),
			List<*Symbol>(),
			List<str>(),
			List<*AstNode>()
		);

		return Self(
			root_scope, arena, "",
			List<*ModuleScope>(),
			List<ImportBinding>(),
			List<*EnumInfo>(),
			List<*TraitInfo>(),
			List<*PrimMethod>(),
			gen
		);
	}

	pub fn register_prim_method(var self, pm: *PrimMethod) {
		self.prim_methods.add(pm);
	}

	// Method of a primitive type by its source name (used by `x.m()` resolution).
	pub fn find_prim_method(val self, kind: DataType, name: str): *MethodInfo {
		for (pm in self.prim_methods) {
			if (pm.kind == kind && pm.info.name == name) return pm.info;
		}
		return null;
	}

	// Overload-aware variant of `find_prim_method` (parameter count includes the
	// receiver). Null when no overload matches, so the caller can fall back.
	pub fn find_prim_method_arity(val self, kind: DataType, name: str, argc: usz): *MethodInfo {
		for (pm in self.prim_methods) {
			if (
				pm.kind == kind &&
				pm.info.name == name &&
				pm.info.fn_type.as_fn().param_types.len == argc
			) return pm.info;
		}
		return null;
	}

	// Primitive method by its mangled C name (used when re-visiting an impl).
	pub fn find_prim_method_c(val self, c_name: str): *MethodInfo {
		for (pm in self.prim_methods) {
			if (pm.info.c_name == c_name) return pm.info;
		}
		return null;
	}

	pub fn register_trait(var self, info: *TraitInfo) {
		self.traits.add(info);
	}

	pub fn find_trait(val self, name: str): *TraitInfo {
		for (t in self.traits) {
			if (t.name == name) return t;
		}
		return null;
	}

	pub fn register_enum_info(var self, info: *EnumInfo) {
		self.enums.add(info);
	}

	pub fn find_enum_info(val self, name: str): *EnumInfo {
		for (e in self.enums) {
			if (e.name == name || e.c_name == name) return e;
		}
		return null;
	}

	pub fn enter_scope(var self, is_fn_boundary: bool): *Scope {
		val new_sc = self.arena.alloc_val<Scope>(Scope(self.current_scope, List<*Symbol>(), is_fn_boundary));
		self.current_scope = new_sc;
		return new_sc;
	}

	pub fn exit_scope(var self) {
		if (self.current_scope.parent != null) {
			self.current_scope = self.current_scope.parent;
		}
	}

	pub fn is_in_function(var self): bool {
		var curr = self.current_scope;
		while (curr != null) {
			if (curr.is_fn_boundary) return true;
			curr = curr.parent;
		}
		return false;
	}

	pub fn lookup_current(var self, name: str): *Symbol {
		val scope = self.current_scope;
		for (sym in scope) {
			if (sym.name == name) return sym;
		}
		return null;
	}

	// Name lookup: local scope -> declarations of the current module -> imports of
	// the current module -> mangled C name (so re-resolution gives the same result).
	pub fn lookup(var self, name: str): *Symbol {
		var curr = self.current_scope;
		while (curr != null) {
			for (sym in curr) {
				if (sym.name == name) return sym;
			}
			curr = curr.parent;
		}

		// 2. Top-level declarations of the current module
		val own = self.lookup_in_module(self.current_module, name);
		if (own != null) return own;

		// 3. Explicit imports (by original name or alias), scoped to this module
		for (b in self.imports) {
			if (
				!b.is_wildcard &&
				b.local_name == name &&
				b.owner_module == self.current_module
			) return self.lookup_in_module(b.module_name, b.symbol_name);
		}

		// 4. Wildcard imports, scoped to this module
		for (b2 in self.imports) {
			if (b2.is_wildcard && b2.owner_module == self.current_module) {
				val found = self.lookup_in_module(b2.module_name, name);
				if (found != null) return found;
			}
		}

		// 5. Instantiated generic symbols (their name already equals the mangled C name)
		for (isym in self.gen.inst_syms) {
			if (isym.name == name) return isym;
		}

		// 6. Mangled C name (idempotent on repeated resolution)
		return self.lookup_c_name(name);
	}

	pub fn define(var self, sym: Symbol): bool {
		// Check for duplicate definitions in the same scope
		val existing = self.lookup_current(sym.name);
		if (existing != null) return false;

		val sym_ptr = self.arena.alloc_val<Symbol>(sym);

		self.current_scope.symbols.add(sym_ptr);
		return true;
	}

	pub fn set_current_module(var self, name: str) {
		self.current_module = name;
	}

	pub fn module_exists(val self, name: str): bool {
		for (sc in self.modules) {
			if (sc.name == name) return true;
		}
		return false;
	}

	// Define a top-level declaration into the scope of the given module.
	pub fn define_in_module(var self, module_name: str, sym: Symbol): bool {
		for (m in 0..<self.modules.len) {
			val sc = self.modules[m];
			if (sc.name == module_name) {
				for (existing in sc) {
					if (existing.name == sym.name) return false;
				}
				val sym_ptr = self.arena.alloc_val<Symbol>(sym);
				sc.symbols.add(sym_ptr);
				self.modules[m] = sc;
				return true;
			}
		}

		// Module scope does not exist yet -> create it (via pointer) then add the symbol
		val fresh = self.arena.alloc_val<ModuleScope>(ModuleScope(module_name));
		val sym_ptr2 = self.arena.alloc_val<Symbol>(sym);
		fresh.symbols.add(sym_ptr2);
		self.modules.add(fresh);
		return true;
	}

	// Define a top-level declaration into the module currently being collected.
	pub fn define_global(var self, sym: Symbol): bool => self.define_in_module(self.current_module, sym);

	pub fn add_import(var self, module_name: str, symbol_name: str, local_name: str, is_wildcard: bool) {
		self.imports.add(ImportBinding(module_name, symbol_name, local_name, is_wildcard, self.current_module));
	}

	pub fn lookup_in_module(val self, module_name: str, name: str): *Symbol {
		for (sc in self.modules) {
			if (sc.name == module_name) {
				for (sym in sc) {
					if (sym.name == name) return sym;
				}
				return null;
			}
		}
		return null;
	}

	// Look up by generated C name (used when re-resolving a mangled name).
	pub fn lookup_c_name(val self, c_name: str): *Symbol {
		if (c_name.len == 0) return null;
		for (sc in self.modules) {
			for (sym in sc) {
				if (sym.c_name == c_name && sym.c_name != sym.name) return sym;
			}
		}
		return null;
	}
}
