mod compiler.sema.body_stmt;

// ============================================================================
// BodyPass - Statement Type Checking
//
// Analyzes statement nodes (blocks, variables, loops, conditionals, returns).
// Handles lowering for `for` loops through `Iterable`.
// ============================================================================
use std.mem.arena.*;
use std.collections.list.*;

use util.strutil.*;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.*;

use compiler.sema.types.*;
use compiler.sema.symbol.*;
use compiler.sema.decl_pass.*;
use compiler.sema.desugar_for.*;
use compiler.sema.desugar_interp.*;
use compiler.sema.body_pass.*;
use compiler.sema.body_expr.*;

impl BodyPass {

	pub fn check_block_stmt(var self, node: *AstNode) {
		val blk = node.to<BlockStmt>();
		self.symtab.enter_scope(false);
		defer self.symtab.exit_scope();
		for (stmt in blk.statements) self.check_statement(stmt);
	}

	pub fn check_var_decl_stmt(var self, node: *AstNode) {
		val vd = node.to<VarDeclStmt>() as &VarDeclStmt;
		var var_ty = self.t_none();
		var has_init = false;

		if (vd.type_annotation != null) {
			var_ty = self.resolve_type(vd.type_annotation);
			if (vd.initializer != null) {
				has_init = true;
				if (var_ty != null && var_ty.is_list()) self.coerce_to_list(vd.initializer, var_ty);
				val init_ty = self.check_expr_stmt(vd.initializer);
				self.ensure(var_ty.can_assign(init_ty), node, "Type mismatch in variable declaration for '${vd.name}'");
			}
		} else {
			if (vd.initializer != null) {
				has_init = true;
				var_ty = self.check_expr_stmt(vd.initializer);
			} else {
				self.report_error(node, "Variable '${vd.name}' without type must have initializer");
			}
		}

		// Give an inferred local an explicit type node so the C backend does
		// not have to re-infer it (it cannot see struct field types).
		if (vd.type_annotation == null && has_init)
			vd.type_annotation = self.arena.ast_type_from_type(var_ty);

		val ok = self.symtab.define(Symbol(vd.name, vd.name, SymbolKind.VAR, var_ty, vd.is_mut, false, node.line, node.col, null));
		self.ensure(ok, node, "Variable '${vd.name}' is already defined in this scope");
	}

	fn collect_and_conditions(var self, expr: *AstNode): List<*AstNode> {
		var res = List<*AstNode>();
		if (expr == null) return res;
		val cur = self.unwrap_group(expr) ?: return res;

		if (cur is BinaryExpr as bin && bin.op == TokenType.AND_AND) {
			val left = self.collect_and_conditions(bin.left);
			val right = self.collect_and_conditions(bin.right);
			for (l in left) res += l;
			for (r in right) res += r;
			return res;
		}

		res += cur;
		return res;
	}

	fn is_null_literal(var self, node: *AstNode): bool {
		if (node == null) return false;
		val cur = self.unwrap_group(node);
		if (cur is LiteralExpr) return cur.literal_kind == LiteralKind.NULL_VAL;
		return false;
	}

	fn check_null_guard(var self, left: *AstNode, right: *AstNode) {
		val l = self.unwrap_group(left);
		val r = self.unwrap_group(right);
		var var_name = "";
		if (self.is_null_literal(r) && l is IdentifierExpr as l_id) {
			var_name = l_id.name;
		} else if (self.is_null_literal(l) && r is IdentifierExpr as r_id) {
			var_name = r_id.name;
		}
		if (var_name.empty()) return;

		val sym = self.symtab.lookup(var_name);
		if (sym == null || sym.type_ptr == null) return;
		if (sym.type_ptr.kind != DataType.POINTER) return;
		val ptr_ty = sym.type_ptr.as_pointer();
		if (!ptr_ty.is_nullable) return;

		val non_null_ty = self.arena.pointer_type(ptr_ty.pointee, ptr_ty.is_mut);
		self.symtab.define(Symbol(var_name, sym.c_name, sym.kind, non_null_ty, sym.is_mut, sym.is_pub, 0, 0));
	}

	pub fn check_if_stmt(var self, node: *AstNode) {
		val if_s = node.to<IfStmt>();
		val conds = self.collect_and_conditions(if_s.condition);

		self.symtab.enter_scope(false);

		var no_alias_syms = List<str>();
		var no_alias_tys = List<*Type>();
		var no_alias_muts = List<bool>();

		for (c in conds) {
			val c_ty = self.check_expr(c);
			self.ensure(c_ty.kind == DataType.BOOL, c, "If statement condition must be bool");

			val unwrapped_c = self.unwrap_group(c);
			if (unwrapped_c is IsExpr as is_e) {
				val subj_ty = self.check_expr(is_e.expr);
				val cast_ty = self.check_is_pattern(is_e.expr, subj_ty, unwrapped_c);
				if (cast_ty != null) {
					if (!is_e.alias.empty()) {
						self.symtab.define(Symbol(is_e.alias, is_e.alias, SymbolKind.VAR, cast_ty, is_e.is_mut, false, 0, 0));
					} else if (is_e.expr is IdentifierExpr as id) {
						val subj_sym = self.symtab.lookup(id.name);
						val is_mut = if (subj_sym != null) subj_sym.is_mut else false;
						no_alias_syms += id.name;
						no_alias_tys += cast_ty;
						no_alias_muts += is_mut;
					}
				}
			}

			if (unwrapped_c is BinaryExpr as bin && bin.op == TokenType.BANG_EQUAL) {
				self.check_null_guard(bin.left, bin.right);
			}
		}

		for (i in 0..<no_alias_syms.len) {
			self.symtab.define(Symbol(no_alias_syms[i], no_alias_syms[i], SymbolKind.VAR, no_alias_tys[i], no_alias_muts[i], false, 0, 0));
		}

		self.check_statement(if_s.then_branch);
		self.symtab.exit_scope();

		if (if_s.else_branch != null) {
			var else_null_guard = false;
			val single_c = self.unwrap_group(if_s.condition);
			if (single_c is BinaryExpr as eq_bin && eq_bin.op == TokenType.EQUAL_EQUAL) {
				self.symtab.enter_scope(false);
				self.check_null_guard(eq_bin.left, eq_bin.right);
				else_null_guard = true;
			}

			self.check_statement(if_s.else_branch);

			if (else_null_guard) {
				self.symtab.exit_scope();
			}
		}
	}

	pub fn check_while_stmt(var self, node: *AstNode) {
		val wh = node.to<WhileStmt>();
		val conds = self.collect_and_conditions(wh.condition);

		self.loop_depth++;
		defer self.loop_depth--;
		self.symtab.enter_scope(false);
		defer self.symtab.exit_scope();

		for (c in conds) {
			val c_ty = self.check_expr(c);
			self.ensure(c_ty.kind == DataType.BOOL, c, "While statement condition must be bool");

			val unwrapped_c = self.unwrap_group(c);
			if (unwrapped_c is BinaryExpr as bin && bin.op == TokenType.BANG_EQUAL) {
				self.check_null_guard(bin.left, bin.right);
			}
		}

		self.check_statement(wh.body);
	}

	pub fn check_for_stmt(var self, node: *AstNode) {
		val fs = node.to<ForStmt>() as &ForStmt;
		self.ensure(fs.is_range || for_is_lvalue(fs.iterable), node, "The iterated expression of a 'for' must be a variable or a field");
		// Containers that implement `Iterable` are walked through the trait
		// (`count()` / `at(i)`); `str` and arrays keep the `.len` / `.data`
		// lowering (see desugar_for_iterable).
		var use_iter_trait = false;
		if (!fs.is_range) use_iter_trait = self.struct_implements_iterable(self.for_iterable_type(fs.iterable));

		// `desugar_for` builds the replacement block without installing it: check
		// that block directly and let `lower` put it in place of the `for`.
		val block = self.arena.desugar_for(node, fs, use_iter_trait);
		node.resolved_node = block;
		self.check_statement(block);
	}

	pub fn check_return_stmt(var self, node: *AstNode) {
		if (self.defer_depth > 0UZ)
			self.report_error(node, "Return statement is not allowed inside defer");
		val ret = node.to<ReturnStmt>();
		if (ret.value != null) {
			if (
				self.current_fn_return_type != null &&
				self.current_fn_return_type.is_list()
			) self.coerce_to_list(ret.value, self.current_fn_return_type);

			val val_ty = self.check_expr(ret.value);
			self.ensure(self.current_fn_return_type.can_assign(val_ty), node, "Return value type does not match function return type");
		} else {
			self.ensure(self.current_fn_return_type.kind == DataType.NONE, node, "Non-none function must return a value");
		}
	}

	pub fn check_when_stmt(var self, node: *AstNode) {
		val ws = node.to<WhenStmt>();
		val cond_ty = if (ws.condition != null) self.check_expr(ws.condition) else null;

		for (arm in ws.arms) {
			val smart_cast_ty = self.resolve_arm_patterns(arm.patterns, ws.condition, cond_ty);
			val sym = self.arm_smart_cast_sym(arm.patterns, ws.condition);
			val is_mut = self.arm_smart_cast_is_mut(arm.patterns, ws.condition);

			if (!sym.empty() && smart_cast_ty != null) {
				self.symtab.enter_scope(false);
				self.symtab.define(Symbol(sym, sym, SymbolKind.VAR, smart_cast_ty, is_mut, false, 0, 0));
				self.check_statement(arm.body);
				self.symtab.exit_scope();
			} else self.check_statement(arm.body);
		}
	}

	// Best-effort static type of a `for` iterable (a variable or a field chain).
	// Reports nothing and rewrites nothing, so it is safe to call before the loop
	// is lowered and re-checked.
	fn for_iterable_type(var self, node: *AstNode): *Type => when (node) {
		is GroupExpr as g -> self.for_iterable_type(g.expr),

		is IdentifierExpr as id -> {
			val sym = self.symtab.lookup(id.name) ?: yield null;
			yield sym.type_ptr;
		}

		is MemberExpr as mem -> {
			var obj = self.for_iterable_type(mem.object) ?: yield null;

			if (obj.kind == DataType.POINTER) obj = obj.as_pointer().pointee;
			if (obj.kind != DataType.STRUCT) yield null;

			val s_mem = obj.as_struct();
			for (f in s_mem.fields) {
				if (f.name == mem.member) yield f.type_ptr;
			}
			yield null;
		}

		else -> null;
	};

	// Whether the type is a struct with an `impl Iterable for` block. Such a `for`
	// iterates through the trait (`count()` / `at(i)`) instead of the built-in
	// `.len` / `.data`, so containment no longer has to look like a flat array.
	fn struct_implements_iterable(self, ty: *Type): bool {
		var cur = ty;
		if (cur != null && cur.kind == DataType.POINTER) cur = cur.as_pointer().pointee;
		if (cur == null || cur.kind != DataType.STRUCT) return false;
		val t = self.symtab.find_trait("Iterable") ?: return false;
		return t.has_impl(cur.as_struct().name);
	}

}
