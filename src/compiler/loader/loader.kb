mod compiler.loader;

use std.memory.*;
use std.filesystem.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.parser.Parser;

/*
 * ============================================================================
 * compiler.loader — Module and package resolution, lexing, and parsing
 *
 * Loads the entry point's source file, registers every source buffer in
 * `SourceMap` with a unique `file_id`, and follows every `use a.b.c.Sym;` to
 * load dependent modules recursively without duplicates. Produces a merged AST
 * `Program` where each module is preceded by `mod <module name>;`.
 *
 * File lookup order:
 *   1. Entry file directory
 *   2. Extra roots passed via `-I`
 *   3. `lib/` (standard library)
 *   4. `src/` (compiler source)
 *   5. Auto-detected project root (`kobel.toml`)
 * ============================================================================
 */

pub struct LoadedModule {
	pub name: str,
	pub path: str,
	pub program: ?*AstNode = null,
	pub file_id: u32 = 0
}

pub struct ModuleFile {
	pub found: bool,
	pub path: str,
	pub source: str
}

impl ModuleFile {

	pub op unpack(*self, path: &str, source: &str) {
		path.write(self.path);
		source.write(self.source);
	}

	pub op unpack(*self, found: &bool, path: &str, source: &str) {
		found.write(self.found);
		path.write(self.path);
		source.write(self.source);
	}

}

pub struct ModuleLoader {
	pub roots: List<str>,
	pub modules: List<LoadedModule>,
	pub ordered: List<LoadedModule>,
	pub errors: List<Diagnostic>,
	pub arena: Arena,
	known: HashSet<str>,
	pub sources: SourceMap
}

pub fn detect_project_root(start_dir: str): str {
	var curr = Path(start_dir);
	var count = 0;
	while (!curr.empty() && count < 10) {
		val man_p = curr.join("kobel.toml");
		if (man_p.exists()) return curr.raw;

		val test_p = curr.join("lib/std/io.kb");
		if (test_p.exists()) return curr.raw;

		val parent = curr.parent();
		if (parent.raw == curr.raw || parent.empty()) break;

		curr = parent;
		count++;
	}

	return "";
}

fn str_less(a: str, b: str): bool {
	val min_len = if (a.len < b.len) a.len else b.len;
	for (i in 0..<min_len) {
		if (a[i] < b[i]) return true;
		if (a[i] > b[i]) return false;
	}
	return a.len < b.len;
}

fn sort_strings(var items: List<str>) {
	for (i in 0..<items.len) {
		for (j in (i + 1)..<items.len) {
			if (str_less(items[j], items[i])) {
				val tmp = items[i];
				items[i] = items[j];
				items[j] = tmp;
			}
		}
	}
}

impl ModuleLoader {

	pub init(entry_dir: str, extra_roots: List<str>) {
		return ModuleLoader(entry_dir, extra_roots, Arena(524288));
	}

	pub init(entry_dir: str, extra_roots: List<str>, arena: Arena) {
		var roots = List<str>();
		if (!entry_dir.empty()) roots += entry_dir;

		roots.extend(extra_roots);

		// Default roots: the standard library (lib/) and the compiler source (src/)
		roots += "lib";
		roots += "src";

		// Auto-detect project root if entry_dir is within a Kobel project tree
		val proj = detect_project_root(entry_dir);
		if (!proj.empty()) {
			val proj_p = Path(proj);
			roots += proj;
			roots += proj_p.join("lib").raw;
			roots += proj_p.join("src").raw;
		}

		return Self(
			roots,
			List<LoadedModule>(),
			List<LoadedModule>(),
			List<Diagnostic>(),
			arena,
			HashSet<str>(),
			SourceMap()
		);
	}

	pub fn module_decl(&self, path: List<str>, full_path: str, line: usz, col: usz)
		=> self.arena.node(NodeData.ModuleDecl(path, full_path), line, col);

	pub fn program(&self, declarations: List<*AstNode>, line: usz, col: usz)
		=> self.arena.node(NodeData.Program(declarations), line, col);

	pub fn count(*self) => self.ordered.len;

	pub fn find_source_file(*self, file_id: u32): ?*SourceFile
		=> self.sources.get_file(file_id);

	// ============================================================================
	// Parsing
	// ============================================================================

	pub fn parse_source(&self, path: str, source: str, module_name: str = ""): ?*AstNode {
		val file_id = self.sources.add_file(path, source, module_name);
		var lexer = Lexer(source, file_id);
		val tokens = lexer.tokenize();
		defer tokens.free();

		if (!lexer.errors.empty()) {
			for (d in lexer.errors) {
				var diag = d;
				diag.file_path = path;
				self.errors += diag;
			}
			return null;
		}

		var parser = Parser(tokens, self.arena);
		val prog = parser.parse_program();

		if (!parser.errors.empty()) {
			for (d in parser.errors) {
				var diag = d;
				diag.file_path = path;
				self.errors += diag;
			}
			return null;
		}

		return prog;
	}

	// ============================================================================
	// File Resolution
	// ============================================================================

	pub fn find_module_files(*self, module_name: str): List<ModuleFile> {
		var list = List<ModuleFile>();
		val rel_file = "${module_name.module_to_rel()}.kb";
		val rel_dir = module_name.module_to_rel();

		for (root in self.roots) {
			val root_p = Path(root);
			// 1. Single-file module: <root>/<rel>.kb
			val cand_p = root_p.join(rel_file);
			val src = cand_p.read_text();
			if (!src.empty()) list += ModuleFile(true, cand_p.raw, src);

			// 2. Folder-as-package: <root>/<rel>/
			val dir_p = root_p.join(rel_dir);
			val entries = dir_p.list_dir();
			if (!entries.empty()) {
				var kb_files = entries.filter { e -> e.ends_with(".kb") };
				sort_strings(kb_files);

				for (f in kb_files) {
					val f_p = dir_p.join(f);
					val already = list.any { m -> m.path == f_p.raw };
					if (!already) {
						val f_src = f_p.read_text();
						if (!f_src.empty()) list += ModuleFile(true, f_p.raw, f_src);
					}
				}
			}

			if (!list.empty()) return list;
		}

		return list;
	}

	pub fn find_module(*self, module_name: str): ModuleFile {
		val files = self.find_module_files(module_name);
		if (files.empty()) return ModuleFile(false, "", "");
		return files[0];
	}

	pub fn is_known(*self, module_name: str) => module_name in self.known;

	pub fn ensure_module(&self, module_name: str, line: usz = 0, col: usz = 0, parent_mod: str = "") {
		if (self.is_known(module_name)) return;

		self.known += module_name;
		self.modules += LoadedModule(module_name, "", null, 0);

		val files = self.find_module_files(module_name);
		if (files.empty()) {
			self.errors += Diagnostic.error(
				Span(0, line, col, 1), parent_mod,
				"Module '${module_name}' not found "
				"(searched the entry directory, -I roots, lib/, src/)"
			);
			return;
		}

		for ((f_path, f_src) in files) {
			val prog = self.parse_source(f_path, f_src, module_name) ?: continue;

			var declared = "";
			if (prog is Program as p) declared = p.declared_module_name();
			if (!declared.empty() && declared != module_name) {
				val context = if (!parent_mod.empty()) " (imported from '${parent_mod}')" else "";
				self.errors += Diagnostic.error(
					Span(0, line as u32, col as u32, 1), f_path,
					"module declared as '${declared}' but imported as '${module_name}'${context}"
				);
				continue;
			}

			self.process_uses(prog, module_name);
			self.ordered += LoadedModule(module_name, f_path, prog, prog.span.file_id);
		}
	}

	pub fn process_uses(&self, program_node: *AstNode, parent_mod: str) {
		if (program_node is Program as prog) {
			for (decl in prog) {
				if (decl is UseDecl as u) {
					val mod_name = when (u) {
						.wildcard -> str_join_dots(u.path, u.path.len);
						.path.len >= 2 -> str_join_dots(u.path, u.path.len - 1);
						else -> "";
					};
					if (!mod_name.empty()) self.ensure_module(mod_name, decl.line, decl.col, parent_mod);
				}
			}
		}
	}

	// ============================================================================
	// Entry Point
	// ============================================================================

	pub fn load_program(&self, entry_path: str, entry_source: str): ?*AstNode {
		val prog = self.parse_source(entry_path, entry_source) ?: return null;

		var entry_name = "";
		if (prog is Program as p) entry_name = p.declared_module_name();
		if (entry_name.empty()) entry_name = entry_path.base_name().path_to_module();

		val entry_sf = self.sources.get_file(prog.span.file_id);
		if (entry_sf != null && entry_sf.module_name.empty()) {
			entry_sf.module_name = entry_name;
		}

		self.known += entry_name;
		self.modules += LoadedModule(entry_name, entry_path, prog, prog.span.file_id);
		self.process_uses(prog, entry_name);
		self.ordered += LoadedModule(entry_name, entry_path, prog, prog.span.file_id);

		return self.build_merged_program();
	}

	// Merges every module (dependencies first, entry last) into a single Program.
	pub fn build_merged_program(&self): *AstNode {
		var decls = List<*AstNode>();

		for (lm in self.ordered) {
			val prog = lm.program ?: continue;
			// Insert `mod <module name>;` so the passes know which symbol belongs to which module
			decls += self.module_decl(lm.name.split('.'), lm.name, 0, 0);

			if (prog is Program as p) {
				for (d in p) decls += d;
			}
		}

		return self.program(decls, 0, 0);
	}

	pub fn cleanup(&self) {
		self.ordered.clear();
		self.modules.clear();
		self.known.clear();
	}

}
