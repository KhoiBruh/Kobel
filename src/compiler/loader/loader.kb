mod compiler.loader.loader;

// ============================================================================
// ModuleLoader
//
// Loads the entry point's source file, then follows every `use a.b.c.Sym;` to
// load the dependent modules (recursively, without duplicates). The result is a
// merged AST `Program`: each module is inserted with a `mod <module name>;`
// declaration so DeclPass/BodyPass know which symbol belongs to which module.
//
// File lookup rules (same as v0): module `a.b.c` -> `<root>/a/b/c.kb` with roots
// in order: the entry file's directory -> extra roots passed in (-I) -> "lib"
// (standard library) -> "src" (compiler source).
// ============================================================================

use compiler.lexer.lexer.*;

use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.decl.*;

use compiler.parser.parser.Parser;
use compiler.parser.decl.parse_program;

use util.strutil.*;

use std.io.read_file;
use std.collections.list.*;
use std.mem.arena.*;

pub struct LoadedModule {
	pub name: str,
	pub path: str,
	pub program: *AstNode
}

pub struct ModuleFile {
	pub found: bool,
	pub path: str,
	pub source: str
}

pub struct ModuleLoader {
	pub roots: List<str>,
	pub modules: List<LoadedModule>,
	pub ordered: List<LoadedModule>,
	pub errors: List<str>,
	pub arena: Arena
}

pub fn detect_project_root(start_dir: str): str {
	var curr = start_dir;
	var count: usz = 0UZ;
	while (curr.len > 0UZ && count < 10UZ) {
		val test_file = curr.join_path("lib/std/io.kb");
		val test_content = read_file(test_file);
		if (test_content.len > 0UZ) return curr;
		val parent = curr.dir_of();
		if (parent == curr || parent.len == 0UZ) break;
		curr = parent;
		count++;
	}
	return "";
}

impl ModuleLoader {

	pub fn new(entry_dir: str, extra_roots: List<str>): Self {
		var roots = List<str>();
		if (entry_dir.len > 0) roots.add(entry_dir);

		for (r in extra_roots) roots.add(r);

		// Default roots: the standard library (lib/) and the compiler source (src/)
		roots.add("lib");
		roots.add("src");

		// Auto-detect project root if entry_dir is within a Kobel project tree
		val proj = detect_project_root(entry_dir);
		if (proj.len > 0UZ) {
			roots.add(proj);
			roots.add(proj.join_path("lib"));
			roots.add(proj.join_path("src"));
		}

		return Self(
			roots,
			List<LoadedModule>(),
			List<LoadedModule>(),
			List<str>(),
			Arena(524288)
		);
	}

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz): *AstNode
		=> self.arena.make<ModuleDecl>(ModuleDecl.TAG, ModuleDecl(path, full_path), line, col);

	pub fn program(var self, declarations: List<*AstNode>, line: usz, col: usz): *AstNode
		=> self.arena.make<Program>(Program.TAG, Program(declarations), line, col);

	pub fn count(val self) => self.ordered.len;

	// ============================================================================
	// Parsing
	// ============================================================================

	pub fn parse_source(var self, path: str, source: str): *AstNode {
		var lexer = Lexer(source);
		val tokens = lexer.tokenize();

		var parser = Parser(tokens);
		val prog = parser.parse_program();

		if (parser.errors.len > 0) {
			for (msg in parser.errors) self.errors.add("${path}: ${msg}");
			return null;
		}

		return prog;
	}

	// ============================================================================
	// File Resolution
	// ============================================================================

	pub fn find_module(var self, module_name: str): ModuleFile {
		val rel = "${module_name.module_to_rel()}.kb";
		for (root in self.roots) {
			val candidate = root.join_path(rel);
			val src = read_file(candidate);
			if (src.len > 0) return ModuleFile(true, candidate, src);
		}
		return ModuleFile(false, "", "");
	}

	pub fn is_known(val self, module_name: str): bool {
		for (lm in self.modules) {
			if (lm.name == module_name) return true;
		}
		return false;
	}

	// Loads a module (and every module it `use`s) if not already loaded.
	pub fn ensure_module(var self, module_name: str) {
		self.ensure_module_at(module_name, 0UZ, 0UZ, "");
	}

	pub fn ensure_module_at(var self, module_name: str, line: usz, col: usz, parent_mod: str) {
		if (self.is_known(module_name)) return;

		// Mark it first to avoid infinite recursion when imports form a cycle
		self.modules.add(LoadedModule(module_name, "", null));

		val file = self.find_module(module_name);
		if (!file.found) {
			val prefix = if (parent_mod.len > 0UZ) "${parent_mod}: " else "";
			val msg = if (line > 0UZ) {
				"${prefix}Line ${line}, Column ${col}: Module '${module_name}' not found (searched the entry directory, -I roots, lib/, src/)"
			} else {
				"${prefix}Module '${module_name}' not found (searched the entry directory, -I roots, lib/, src/)"
			};
			self.errors.add(msg);
			return;
		}

		val prog = self.parse_source(file.path, file.source);
		if (prog == null) return;

		val declared = prog.to<Program>().declared_module_name();
		if (declared.len > 0 && declared != module_name) {
			val prefix = if (parent_mod.len > 0UZ) "${parent_mod}: " else "";
			val msg = if (line > 0UZ) {
				"${prefix}Line ${line}, Column ${col}: ${file.path}: module declared as '${declared}' but imported as '${module_name}'"
			} else {
				"${prefix}${file.path}: module declared as '${declared}' but imported as '${module_name}'"
			};
			self.errors.add(msg);
			return;
		}

		// Load dependencies first, then add this module to the merge order
		self.process_uses(prog, module_name);
		self.ordered.add(LoadedModule(module_name, file.path, prog));
	}

	pub fn process_uses(var self, program_node: *AstNode, parent_mod: str) {
		val prog = program_node.to<Program>();
		for (decl in prog) {
			if (decl is UseDecl as u) {
				val mod_name = when {
					u.is_wildcard -> str_join_dots(u.path, u.path.len),
					u.path.len >= 2 -> str_join_dots(u.path, u.path.len - 1),
					else -> ""
				};
				if (mod_name.len > 0) self.ensure_module_at(mod_name, decl.line, decl.col, parent_mod);
			}
		}
	}

	// ============================================================================
	// Entry Point
	// ============================================================================

	pub fn load_program(var self, entry_path: str, entry_source: str): *AstNode {
		val prog = self.parse_source(entry_path, entry_source);
		if (prog == null) return null;

		var entry_name = prog.to<Program>().declared_module_name();
		if (entry_name.len == 0) entry_name = entry_path.base_name().path_to_module();

		self.modules.add(LoadedModule(entry_name, entry_path, prog));
		self.process_uses(prog, entry_name);
		self.ordered.add(LoadedModule(entry_name, entry_path, prog));

		return self.build_merged_program();
	}

	// Merges every module (dependencies first, entry last) into a single Program.
	pub fn build_merged_program(var self): *AstNode {
		var decls = List<*AstNode>();

		for (lm in self.ordered) {
			if (lm.program != null) {
				// Insert `mod <module name>;` so the passes know which symbol belongs to which module
				decls.add(self.module_decl(lm.name.split_dots(), lm.name, 0, 0));

				val p = lm.program.to<Program>();
				for (d in p) decls.add(d);
			}
		}

		return self.program(decls, 0, 0);
	}

}

