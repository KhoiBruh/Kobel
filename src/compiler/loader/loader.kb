mod compiler.loader;

use std.memory.*;
use std.filesystem.*;
use std.collections.*;

use compiler.core.*;
use compiler.lexer.*;
use compiler.ast.*;
use compiler.parser.Parser;

/*
 * ============================================================================
 * compiler.loader — Module and package resolution, lexing, and parsing
 *
 * Loads the entry point's source file, registers every source buffer in
 * `SourceMap` with a unique `file_id`, and follows every `use a.b.c.Sym;` to
 * load dependent modules recursively without duplicates. Produces a merged AST
 * `Program` where each module is preceded by `mod <module name>;`.
 *
 * File lookup order:
 *   1. Entry file directory
 *   2. Extra roots passed via `-I`
 *   3. `lib/` (standard library)
 *   4. `src/` (compiler source)
 *   5. Auto-detected project root (`kobel.toml`)
 * ============================================================================
 */

pub fault LoaderErr {
	ModuleNotFound("Module not found in search paths"),
	ProjectRootNotFound("Could not detect Kobel project root"),
	IoError("Filesystem failure while reading module source"),
	LexFailed("Lexical analysis failed"),
	ParseFailed("Syntax analysis failed")
}

pub struct LoadedModule {
	pub name: str,
	pub path: str,
	pub program: ?&AstNode = null,
	pub file_id: u32 = 0
}

pub struct ModuleFile {
	pub path: str,
	pub source: str
}

impl ModuleFile {

	pub op unpack(*self, path: &str, source: &str) {
		path.write(self.path);
		source.write(self.source);
	}

}

/*
 * ============================================================================
 * SourceCache — Persistent VFS & Disk File Cache for Long-Lived Processes
 *
 * Lives on the default (persistent) heap and caches disk files keyed by
 * normalized path with `(mtime, size)` validation, plus unsaved live editor
 * overrides. Replaced buffers are queued in `retired` and freed via
 * `flush_retired()` once no live analysis snapshot references them.
 * ============================================================================
 */
pub struct CachedSource {
	pub path: str = "",
	pub mtime: i64 = -1,
	pub size: i64 = -1,
	pub text: str = ""
}

struct OverrideEntry {
	pub key: str = "",
	pub text: str = ""
}

pub struct SourceCache {
	overrides: HashMap<str, OverrideEntry> = HashMap(),
	disk_files: HashMap<str, CachedSource> = HashMap(),
	retired: List<str> = List()
}

impl SourceCache {

	pub init() => Self(
		HashMap<str, OverrideEntry>(),
		HashMap<str, CachedSource>(),
		List<str>()
	);

	pub fn set_override(&self, path: str, text: str) {
		val norm = path.normalize_path();
		val existing = self.overrides.get(norm);
		val prev = HeapPool.push_default();
		if (existing != null) {
			val cur = existing.read();
			Heap.drop_str(cur.text);
			val dup_text = Heap.dup_str(text);
			self.overrides[cur.key] = OverrideEntry(cur.key, dup_text);
		} else {
			val dup_key = Heap.dup_str(norm);
			val dup_text = Heap.dup_str(text);
			self.overrides[dup_key] = OverrideEntry(dup_key, dup_text);
		}
		HeapPool.pop(prev);
	}

	pub fn remove_override(&self, path: str) {
		val norm = path.normalize_path();
		val existing = self.overrides.get(norm) ?: return;
		val cur = existing.read();
		val prev = HeapPool.push_default();
		self.overrides.remove(cur.key);
		Heap.drop_str(cur.text);
		Heap.drop_str(cur.key);
		HeapPool.pop(prev);
	}

	pub fn invalidate_disk(&self, path: str) {
		val norm = path.normalize_path();
		val existing = self.disk_files.get(norm) ?: return;
		val cur = existing.read();
		val prev = HeapPool.push_default();
		self.disk_files.remove(cur.path);
		Heap.drop_str(cur.text);
		Heap.drop_str(cur.path);
		HeapPool.pop(prev);
	}

	pub fn read_file(&self, path: str): str ! LoaderErr {
		val norm = path.normalize_path();
		val ov_p = self.overrides.get(norm);
		if (ov_p != null) return ov_p.read().text;

		val p = Path(path);
		val mt = p.mtime();
		val sz = p.file_size();
		val existing = self.disk_files.get(norm);
		if (existing != null) {
			val cur = existing.read();
			if (mt >= 0 && cur.mtime == mt && cur.size == sz) return cur.text;
		}

		val raw = p.read_text() !: return LoaderErr.IoError;
		val prev = HeapPool.push_default();
		val dup_text = Heap.dup_str(raw);
		if (existing != null) {
			val cur = existing.read();
			if (!cur.text.empty()) self.retired += cur.text;
			self.disk_files[cur.path] = CachedSource(cur.path, mt, sz, dup_text);
		} else {
			val dup_key = Heap.dup_str(norm);
			self.disk_files[dup_key] = CachedSource(dup_key, mt, sz, dup_text);
		}
		HeapPool.pop(prev);
		return dup_text;
	}

	pub fn flush_retired(&self) {
		if (self.retired.empty()) return;
		val prev = HeapPool.push_default();
		for (s in self.retired) Heap.drop_str(s);
		self.retired.clear();
		HeapPool.pop(prev);
	}

	pub fn file_count(*self) => self.disk_files.len;

	pub fn total_bytes(*self): usz {
		var total: usz = 0;
		for ((_, cs) in self.disk_files) total += cs.text.len;
		for ((_, ov) in self.overrides) total += ov.text.len;
		return total;
	}

	pub fn free(&self) {
		val prev = HeapPool.push_default();
		for ((_, ov) in self.overrides) {
			Heap.drop_str(ov.text);
			Heap.drop_str(ov.key);
		}

		self.overrides.free();
		self.overrides = HashMap();

		for ((_, cs) in self.disk_files) {
			Heap.drop_str(cs.text);
			Heap.drop_str(cs.path);
		}

		self.disk_files.free();
		self.disk_files = HashMap();

		for (s in self.retired) Heap.drop_str(s);

		self.retired.free();
		self.retired = List();

		HeapPool.pop(prev);
	}

}

pub struct ModuleLoader {
	pub roots: List<str>,
	pub modules: List<LoadedModule>,
	pub ordered: List<LoadedModule>,
	pub errors: List<Diagnostic>,
	pub arena: Arena,
	known: HashSet<str>,
	pub sources: SourceMap,
	pub cache: ?&SourceCache = null
}

pub fn detect_project_root(start_dir: str): str ! LoaderErr {
	var curr = Path(start_dir);
	var count = 0;
	while (!curr.empty() && count < 10) {
		val man_p = curr.join("kobel.toml");
		if (man_p.exists()) return curr.raw;

		val test_p = curr.join("lib/std/io.kb");
		if (test_p.exists()) return curr.raw;

		val parent = curr.parent();
		if (parent.raw == curr.raw || parent.empty()) break;

		curr = parent;
		count++;
	}

	return LoaderErr.ProjectRootNotFound;
}

fn str_less(a: str, b: str): bool {
	val min_len = if (a.len < b.len) a.len else b.len;
	for (i in 0..<min_len) {
		if (a[i] < b[i]) return true;
		if (a[i] > b[i]) return false;
	}
	return a.len < b.len;
}

fn sort_strings(items: &List<str>) {
	for (i in 0..<items.len) {
		for (j in (i + 1)..<items.len) {
			if (str_less((*items)[j], (*items)[i])) {
				val tmp = (*items)[i];
				(*items)[i] = (*items)[j];
				(*items)[j] = tmp;
			}
		}
	}
}

impl ModuleLoader {

	pub init(entry_dir: str, extra_roots: List<str>, arena: Arena = Arena(524288)) {
		var roots = List<str>();
		if (!entry_dir.empty()) roots += entry_dir;

		roots.extend(extra_roots);

		// Default roots: the standard library (lib/) and the compiler source (src/)
		roots += "lib";
		roots += "src";

		// Auto-detect project root if entry_dir is within a Kobel project tree
		val proj = detect_project_root(entry_dir) !: "";
		if (!proj.empty()) {
			val proj_p = Path(proj);
			roots += proj;
			roots += proj_p.join("lib").raw;
			roots += proj_p.join("src").raw;
		}

		return Self(
			roots,
			List<LoadedModule>(),
			List<LoadedModule>(),
			List<Diagnostic>(),
			arena,
			HashSet<str>(),
			SourceMap()
		);
	}

	pub fn free_buffers(self) {
		self.roots.free();
		self.modules.free();
		self.ordered.free();
		self.errors.free();
		self.known.free();
		self.sources.free();
	}

	pub fn module_decl(&self, path: List<str>, full_path: str, line: usz, col: usz)
		=> self.arena.node(NodeData.ModuleDecl(path, full_path), line, col);

	pub fn program(&self, declarations: List<&AstNode>, line: usz, col: usz)
		=> self.arena.node(NodeData.Program(declarations), line, col);

	pub fn count(*self) => self.ordered.len;

	pub fn find_source_file(*self, file_id: u32): ?*SourceFile
		=> self.sources.get_file(file_id);

	// ============================================================================
	// Parsing
	// ============================================================================

	pub fn parse_source(&self, path: str, source: str, module_name: str = ""): &AstNode ! LoaderErr {
		val file_id = self.sources.add_file(path, source, module_name);
		var lexer = Lexer(source, file_id);
		val tokens = lexer.tokenize();
		defer tokens.free();

		if (!lexer.errors.empty()) {
			for (d in lexer.errors) {
				var diag = d;
				diag.file_path = path;
				self.errors += diag;
			}
			return LoaderErr.LexFailed;
		}

		var parser = Parser(tokens, self.arena);
		val prog = parser.parse_program();

		if (!parser.errors.empty()) {
			for (d in parser.errors) {
				var diag = d;
				diag.file_path = path;
				self.errors += diag;
			}
			return LoaderErr.ParseFailed;
		}

		return prog;
	}

	// ============================================================================
	// File Resolution
	// ============================================================================

	fn read_source_file(*self, p: Path): str ! LoaderErr {
		val c = self.cache;
		if (c != null) return c.read_file(p.raw);
		return p.read_text() !: return LoaderErr.IoError;
	}

	pub fn find_module_files(*self, module_name: str): List<ModuleFile> ! LoaderErr {
		var list = List<ModuleFile>();
		val rel_file = "${module_name.module_to_rel()}.kb";
		val rel_dir = module_name.module_to_rel();

		for (root in self.roots) {
			val root_p = Path(root);
			// 1. Single-file module: <root>/<rel>.kb
			val cand_p = root_p.join(rel_file);
			if (cand_p.is_file()) {
				val src = self.read_source_file(cand_p)?;
				list += ModuleFile(cand_p.raw, src);
			}

			// 2. Folder-as-package: <root>/<rel>/
			val dir_p = root_p.join(rel_dir);
			if (dir_p.is_dir()) {
				val entries = dir_p.list_dir() !: return LoaderErr.IoError;
				var kb_files = entries.filter { e -> e.ends_with(".kb") };
				sort_strings(&kb_files);

				for (f in kb_files) {
					val f_p = dir_p.join(f);
					val already = list.any { m -> m.path == f_p.raw };
					if (!already) {
						val f_src = self.read_source_file(f_p)?;
						list += ModuleFile(f_p.raw, f_src);
					}
				}
			}

			if (!list.empty()) return list;
		}

		return LoaderErr.ModuleNotFound;
	}

	pub fn find_module(*self, module_name: str): ModuleFile ! LoaderErr {
		val files = self.find_module_files(module_name)?;
		if (files.empty()) return LoaderErr.ModuleNotFound;
		return files[0];
	}

	pub fn has_module(*self, module_name: str): bool => self.find_module(module_name) is ModuleFile;

	pub fn is_known(*self, module_name: str) => module_name in self.known;

	pub fn ensure_module(&self, module_name: str, line: usz = 0, col: usz = 0, parent_mod: str = "") {
		if (self.is_known(module_name)) return;

		self.known += module_name;
		self.modules += LoadedModule(module_name, "", null, 0);

		val files = self.find_module_files(module_name) !: err -> {
			val msg = when (err) {
				is .IoError -> "Failed to read module '${module_name}' from disk";
				else -> "Module '${module_name}' not found "
					"(searched the entry directory, -I roots, lib/, src/)";
			};
			self.errors += Diagnostic.error(Span(0, line, col, 1), parent_mod, msg);
			return;
		};

		for ((f_path, f_src) in files) {
			val prog = self.parse_source(f_path, f_src, module_name) !: continue;

			var declared = "";
			if (prog is Program as p) declared = p.declared_module_name();
			if (!declared.empty() && declared != module_name) {
				val context = if (!parent_mod.empty()) " (imported from '${parent_mod}')" else "";
				self.errors += Diagnostic.error(
					Span(0, line as u32, col as u32, 1), f_path,
					"module declared as '${declared}' but imported as '${module_name}'${context}"
				);
				continue;
			}

			self.process_uses(prog, module_name);
			self.ordered += LoadedModule(module_name, f_path, prog, prog.span.file_id);
		}
	}

	pub fn process_uses(&self, program_node: *AstNode, parent_mod: str) {
		if (program_node is Program as prog) {
			for (decl in prog) {
				if (decl is UseDecl as u) {
					val mod_name = when (u) {
						.wildcard -> str_join_dots(u.path, u.path.len);
						.path.len >= 2 -> str_join_dots(u.path, u.path.len - 1);
						else -> "";
					};
					if (!mod_name.empty()) self.ensure_module(mod_name, decl.line, decl.col, parent_mod);
				}
			}
		}
	}

	// ============================================================================
	// Entry Point
	// ============================================================================

	pub fn load_program(&self, entry_path: str, entry_source: str): &AstNode ! LoaderErr {
		val prog = self.parse_source(entry_path, entry_source)?;

		var entry_name = "";
		if (prog is Program as p) entry_name = p.declared_module_name();
		if (entry_name.empty()) entry_name = entry_path.base_name().path_to_module();

		val entry_sf = self.sources.get_file_mut(prog.span.file_id);
		if (entry_sf != null && entry_sf.module_name.empty()) {
			entry_sf.module_name = entry_name;
		}

		self.known += entry_name;
		self.modules += LoadedModule(entry_name, entry_path, prog, prog.span.file_id);
		self.process_uses(prog, entry_name);
		self.ordered += LoadedModule(entry_name, entry_path, prog, prog.span.file_id);

		return self.build_merged_program();
	}

	// Merges every module (dependencies first, entry last) into a single Program.
	pub fn build_merged_program(&self): &AstNode {
		var decls = List<&AstNode>();

		for (lm in self.ordered) {
			val prog = lm.program ?: continue;
			// Insert `mod <module name>;` so the passes know which symbol belongs to which module
			decls += self.module_decl(lm.name.split('.'), lm.name, 0, 0);

			if (prog is Program as p) {
				for (d in p) decls += d;
			}
		}

		return self.program(decls, 0, 0);
	}

	pub fn cleanup(&self) {
		self.ordered.clear();
		self.modules.clear();
		self.known.clear();
	}

}
