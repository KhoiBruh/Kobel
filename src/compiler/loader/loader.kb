mod compiler.loader.loader;

// ============================================================================
// ModuleLoader
//
// Loads the entry point's source file, then follows every `use a.b.c.Sym;` to
// load the dependent modules (recursively, without duplicates). The result is a
// merged AST `Program`: each module is inserted with a `mod <module name>;`
// declaration so DeclPass/BodyPass know which symbol belongs to which module.
//
// File lookup rules (same as v0): module `a.b.c` -> `<root>/a/b/c.kb` with roots
// in order: the entry file's directory -> extra roots passed in (-I) -> "lib"
// (standard library) -> "src" (compiler source).
// ============================================================================

use compiler.lexer.lexer.*;

use compiler.ast.builder.*;
use compiler.ast.node.*;
use compiler.ast.decl.*;

use compiler.parser.parser.Parser;
use compiler.parser.parser.new_parser;
use compiler.parser.decl.parse_program;

use compiler.util.strutil.*;

use std.io.read_file;
use std.collections.list.*;
use std.mem.arena.*;

pub struct LoadedModule {
	pub name: str,
	pub path: str,
	pub program: *AstNode
}

pub struct ModuleFile {
	pub found: bool,
	pub path: str,
	pub source: str
}

pub struct ModuleLoader {
	pub roots: List<str>,
	pub modules: List<LoadedModule>,
	pub ordered: List<LoadedModule>,
	pub errors: List<str>,
	pub arena: Arena
}

pub fn new_module_loader(entry_dir: str, extra_roots: List<str>): ModuleLoader {
	var roots = new_list<str>();
	if (entry_dir.len > 0) roots.add(entry_dir);

	var i: usz = 0;
	while (i < extra_roots.len) {
		roots.add(extra_roots.get(i));
		i = i + 1;
	}

	// Default roots: the standard library (lib/) and the compiler source (src/)
	roots.add("lib");
	roots.add("src");

	return ModuleLoader(
		roots,
		new_list<LoadedModule>(),
		new_list<LoadedModule>(),
		new_list<str>(),
		new_arena(524288)
	);
}

pub fn loaded_module_count(self: &ModuleLoader): usz => self.ordered.len;

// ============================================================================
// Parsing
// ============================================================================

pub fn parse_source(var self: &ModuleLoader, path: str, source: str): *AstNode {
	var lexer = new_lexer(source);
	val tokens = lexer.tokenize();

	var parser = new_parser(tokens);
	val prog = parse_program(&parser);

	if (parser.errors.len > 0) {
		var i: usz = 0;
		while (i < parser.errors.len) {
			self.errors.add(str_concat3(path, ": ", parser.errors.get(i)));
			i = i + 1;
		}
		return null;
	}

	return prog;
}

// Module name declared in the file (`mod a.b.c;`), "" when the file declares none.
pub fn declared_module_name(program_node: *AstNode): str {
	if (program_node == null) return "";
	val prog = as_program(program_node);
	var i: usz = 0;
	while (i < prog.declarations.len) {
		val decl = prog.declarations.get(i);
		if (decl.kind == NodeKind.DECL_MODULE) return as_module_decl(decl).full_path;
		i = i + 1;
	}
	return "";
}

// ============================================================================
// File Resolution
// ============================================================================

pub fn find_module(var self: &ModuleLoader, module_name: str): ModuleFile {
	val rel = str_concat(str_module_to_rel(module_name), ".kb");
	var i: usz = 0;
	while (i < self.roots.len) {
		val candidate = str_join_path(self.roots.get(i), rel);
		val src = read_file(candidate);
		if (src.len > 0) return ModuleFile(true, candidate, src);
		i = i + 1;
	}
	return ModuleFile(false, "", "");
}

pub fn is_known(self: &ModuleLoader, module_name: str): bool {
	var i: usz = 0;
	while (i < self.modules.len) {
		if (self.modules.get(i).name == module_name) return true;
		i = i + 1;
	}
	return false;
}

// Loads a module (and every module it `use`s) if not already loaded.
pub fn ensure_module(var self: &ModuleLoader, module_name: str) {
	if (is_known(self, module_name)) return;

	// Mark it first to avoid infinite recursion when imports form a cycle
	self.modules.add(LoadedModule(module_name, "", null));

	val file = find_module(self, module_name);
	if (!file.found) {
		val msg = str_concat3("Module '", module_name, "' not found (searched the entry directory, -I roots, lib/, src/)");
		self.errors.add(msg);
		return;
	}

	val prog = parse_source(self, file.path, file.source);
	if (prog == null) return;

	val declared = declared_module_name(prog);
	if (declared.len > 0 && declared != module_name) {
		val msg = str_concat3(file.path, ": module declared as '", declared);
		self.errors.add(str_concat3(msg, "' but imported as '", str_concat(module_name, "'")));
		return;
	}

	// Load dependencies first, then add this module to the merge order
	process_uses(self, prog);
	self.ordered.add(LoadedModule(module_name, file.path, prog));
}

pub fn process_uses(var self: &ModuleLoader, program_node: *AstNode) {
	val prog = as_program(program_node);
	var i: usz = 0;
	while (i < prog.declarations.len) {
		val decl = prog.declarations.get(i);
		if (decl.kind == NodeKind.DECL_USE) {
			val u = as_use_decl(decl);
			var mod_name = "";
			if (u.is_wildcard) mod_name = str_join_dots(u.path, u.path.len);
			else if (u.path.len >= 2) mod_name = str_join_dots(u.path, u.path.len - 1);
			if (mod_name.len > 0) ensure_module(self, mod_name);
		}
		i = i + 1;
	}
}

// ============================================================================
// Entry Point
// ============================================================================

pub fn load_program(var self: &ModuleLoader, entry_path: str, entry_source: str): *AstNode {
	val prog = parse_source(self, entry_path, entry_source);
	if (prog == null) return null;

	var entry_name = declared_module_name(prog);
	if (entry_name.len == 0) entry_name = str_path_to_module(str_base_name(entry_path));

	self.modules.add(LoadedModule(entry_name, entry_path, prog));
	process_uses(self, prog);
	self.ordered.add(LoadedModule(entry_name, entry_path, prog));

	return build_merged_program(self);
}

// Merges every module (dependencies first, entry last) into a single Program.
pub fn build_merged_program(var self: &ModuleLoader): *AstNode {
	var decls = new_list<*AstNode>();

	var i: usz = 0;
	while (i < self.ordered.len) {
		val lm = self.ordered.get(i);
		if (lm.program != null) {
			// Insert `mod <module name>;` so the passes know which symbol belongs to which module
			decls.add(alloc_module_decl(&self.arena, str_split_dots(lm.name), lm.name, 0, 0));

			val p = as_program(lm.program);
			var j: usz = 0;
			while (j < p.declarations.len) {
				decls.add(p.declarations.get(j));
				j = j + 1;
			}
		}
		i = i + 1;
	}

	return alloc_program(&self.arena, decls, 0, 0);
}
