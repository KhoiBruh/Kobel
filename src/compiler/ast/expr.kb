mod compiler.ast.expr;

use std.collections.List;

use compiler.ast.node.*;

use compiler.lexer.TokenType;

pub enum LiteralKind {
	INT,
	FLOAT,
	BOOL,
	CHAR,
	STRING,
	NULL_VAL
}

pub struct LiteralExpr {
	pub literal_kind: LiteralKind,
	pub raw_text: str
}

pub struct IdentifierExpr {
	pub name: str
}

pub struct BinaryExpr {
	pub left: *AstNode,
	pub op: TokenType,
	pub right: *AstNode
}

pub struct UnaryExpr {
	pub op: TokenType,
	pub operand: *AstNode,
	pub is_postfix: bool = false
}

pub struct CallExpr {
	pub callee: *AstNode,
	pub args: List<*AstNode> = List(),
	pub type_args: List<*AstNode> = List()
}

pub struct MemberExpr {
	pub object: *AstNode,
	pub member: str,
	pub is_safe: bool = false
}

pub struct IndexExpr {
	pub target: *AstNode,
	pub index: *AstNode
}

pub struct AssignExpr {
	pub target: *AstNode,
	pub op: TokenType,
	pub value: *AstNode
}

pub struct UpdateExpr {
	pub op: TokenType,
	pub target: *AstNode
}

pub struct CastExpr {
	pub expr: *AstNode? = null,
	pub target_type: *AstNode
}

pub struct GroupExpr {
	pub expr: *AstNode
}

pub struct ArrayLiteralExpr {
	pub elements: List<*AstNode>,
	pub list_struct_name: str = "",
	pub elem_type_node: *AstNode? = null
}

pub struct IfExpr {
	pub condition: *AstNode,
	pub then_branch: *AstNode,
	pub else_branch: *AstNode
}

pub struct WhenArm {
	pub patterns: List<*AstNode>,
	pub is_else: bool,
	pub body: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct WhenExpr {
	pub condition: *AstNode? = null,
	pub arms: List<WhenArm>
}

// One piece of an interpolated string: either a literal chunk (`is_literal`,
// in which case `expr` is a STRING literal) or a `${...}` hole expression.
pub struct InterpPart {
	pub expr: *AstNode? = null,
	pub is_literal: bool
}

pub struct InterpExpr {
	pub parts: List<InterpPart>
}

pub struct IsExpr {
	pub expr: *AstNode? = null,
	pub target_type: *AstNode,
	pub alias: str = "",
	pub tag_field: str = "",
	pub base_c_name: str = "",
	pub is_ptr: bool = false,
	pub mutable: bool = false,
	// Field path of an inline payload inside the subject, for a payload-enum
	// variant pattern (`is Shape.Circle` reads `subject.u.Circle`) and for an
	// AstNode pattern (`data.u.LiteralExpr`).
	pub payload_path: str = "",
	// True when the payload member is a pointer field (AstNode's `data.u.X`),
	// false when it is an inline variant struct to take the address of.
	pub payload_ptr: bool = false,
	// C name of the tag constant this pattern compares against (filled by sema).
	pub tag_const: str = ""
}

// `T.size()` where `T` is a type parameter of the generic function being
// instantiated. Sema creates this node in place of the call, and the backend
// emits the C size of the current instance's type argument as an integer literal.
pub struct SizeOfParam {
	// Index into the current instance's resolved type-argument list.
	pub param_index: usz,
	// The C size (bytes) of that argument, as decimal text (`4UZ`), so the
	// backend emits the constant without any type lookup at emit time.
	pub size_text: str
}

// A struct value built from its fields: `Point(1, 2)` when the type has no
// matching `new` (or `Self(...)`, which always builds raw). Sema creates this
// node so the backend never has to guess a constructor from the callee's name.
pub struct StructCtorExpr {
	pub c_name: str,
	pub args: List<*AstNode> = List()
}

// A payload-enum value built by the checker: `Shape.Circle(1.5)` becomes a C
// compound literal that sets the tag and the variant's union member.
pub struct EnumCtorExpr {
	pub c_name: str,
	pub tag_field: str,
	pub tag_value: i64,
	// Union member path of the variant's payload ("" for a tag-only variant).
	pub payload_path: str = "",
	pub args: List<*AstNode> = List()
}
