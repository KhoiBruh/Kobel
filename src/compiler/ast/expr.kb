mod compiler.ast.expr;

use std.collections.list.List;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;
use compiler.lexer.token.TokenType;

pub enum LiteralKind {
	INT,
	FLOAT,
	BOOL,
	CHAR,
	STRING,
	NULL_VAL
}

pub struct LiteralExpr {
	pub const TAG = NodeKind.EXPR_LITERAL;
	pub literal_kind: LiteralKind,
	pub raw_text: str
}

pub struct IdentifierExpr {
	pub const TAG = NodeKind.EXPR_IDENTIFIER;
	pub name: str
}

pub struct BinaryExpr {
	pub const TAG = NodeKind.EXPR_BINARY;
	pub left: *AstNode,
	pub op: TokenType,
	pub right: *AstNode
}

pub struct UnaryExpr {
	pub const TAG = NodeKind.EXPR_UNARY;
	pub op: TokenType,
	pub operand: *AstNode
}

pub struct CallExpr {
	pub const TAG = NodeKind.EXPR_CALL;
	pub callee: *AstNode,
	pub args: List<*AstNode> = List(),
	pub type_args: List<*AstNode> = List()
}

pub struct MemberExpr {
	pub const TAG = NodeKind.EXPR_MEMBER;
	pub object: *AstNode,
	pub member: str,
	pub is_safe: bool = false
}

pub struct IndexExpr {
	pub const TAG = NodeKind.EXPR_INDEX;
	pub target: *AstNode,
	pub index: *AstNode
}

pub struct AssignExpr {
	pub const TAG = NodeKind.EXPR_ASSIGN;
	pub target: *AstNode,
	pub op: TokenType,
	pub value: *AstNode
}

pub struct UpdateExpr {
	pub const TAG = NodeKind.EXPR_UPDATE;
	pub op: TokenType,
	pub target: *AstNode
}

pub struct CastExpr {
	pub const TAG = NodeKind.EXPR_CAST;
	pub expr: *AstNode,
	pub target_type: *AstNode
}

pub struct GroupExpr {
	pub const TAG = NodeKind.EXPR_GROUP;
	pub expr: *AstNode
}

pub struct ArrayLiteralExpr {
	pub const TAG = NodeKind.EXPR_ARRAY_LITERAL;
	pub elements: List<*AstNode>,
	pub list_struct_name: str = "",
	pub elem_type_node: *AstNode = null
}

pub struct IfExpr {
	pub const TAG = NodeKind.EXPR_IF;
	pub condition: *AstNode,
	pub then_branch: *AstNode,
	pub else_branch: *AstNode
}

pub struct WhenArm {
	pub patterns: List<*AstNode>,
	pub is_else: bool,
	pub body: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct WhenExpr {
	pub const TAG = NodeKind.EXPR_WHEN;
	pub condition: *AstNode,
	pub arms: List<WhenArm>
}

// One piece of an interpolated string: either a literal chunk (`is_literal`,
// in which case `expr` is a STRING literal) or a `${...}` hole expression.
pub struct InterpPart {
	pub expr: *AstNode,
	pub is_literal: bool
}

pub struct InterpExpr {
	pub const TAG = NodeKind.EXPR_INTERP;
	pub parts: List<InterpPart>
}

pub struct IsExpr {
	pub const TAG = NodeKind.EXPR_IS;
	pub expr: *AstNode,
	pub target_type: *AstNode,
	pub alias: str = "",
	pub tag_field: str = "",
	pub has_data: bool = false,
	pub base_c_name: str = "",
	pub is_ptr: bool = false,
	pub is_mut: bool = false,
	// Field path of an inline payload inside the subject, for a payload-enum
	// variant pattern (`is Shape.Circle` reads `subject.u.Circle`).
	pub payload_path: str = ""
}

// A struct value built from its fields: `Point(1, 2)` when the type has no
// matching `new` (or `Self(...)`, which always builds raw). Sema creates this
// node so the backend never has to guess a constructor from the callee's name.
pub struct StructCtorExpr {
	pub const TAG = NodeKind.EXPR_STRUCT_CTOR;
	pub c_name: str,
	pub args: List<*AstNode> = List()
}

// A payload-enum value built by the checker: `Shape.Circle(1.5)` becomes a C
// compound literal that sets the tag and the variant's union member.
pub struct EnumCtorExpr {
	pub const TAG = NodeKind.EXPR_ENUM_CTOR;
	pub c_name: str,
	pub tag_field: str,
	pub tag_value: i64,
	// Union member path of the variant's payload ("" for a tag-only variant).
	pub payload_path: str = "",
	pub args: List<*AstNode> = List()
}
