mod compiler.ast.expr;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;
use compiler.lexer.token.TokenType;
use std.collections.list.List;

pub enum LiteralKind {
	INT,
	FLOAT,
	BOOL,
	CHAR,
	STRING,
	NULL_VAL
}

pub struct LiteralExpr {
	pub literal_kind: LiteralKind,
	pub raw_text: str
}

impl LiteralExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_LITERAL;
}

pub struct IdentifierExpr {
	pub name: str
}

impl IdentifierExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_IDENTIFIER;
}

pub struct BinaryExpr {
	pub left: *AstNode,
	pub op: TokenType,
	pub right: *AstNode
}

impl BinaryExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_BINARY;
}

pub struct UnaryExpr {
	pub op: TokenType,
	pub operand: *AstNode
}

impl UnaryExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_UNARY;
}

pub struct CallExpr {
	pub callee: *AstNode,
	pub args: List<*AstNode> = List<*AstNode>(),
	pub type_args: List<*AstNode> = List<*AstNode>()
}

impl CallExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_CALL;
}

pub struct MemberExpr {
	pub object: *AstNode,
	pub member: str
}

impl MemberExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_MEMBER;
}

pub struct IndexExpr {
	pub target: *AstNode,
	pub index: *AstNode
}

impl IndexExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_INDEX;
}

pub struct AssignExpr {
	pub target: *AstNode,
	pub op: TokenType,
	pub value: *AstNode
}

impl AssignExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_ASSIGN;
}

pub struct UpdateExpr {
	pub op: TokenType,
	pub target: *AstNode
}

impl UpdateExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_UPDATE;
}

pub struct CastExpr {
	pub expr: *AstNode,
	pub target_type: *AstNode
}

impl CastExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_CAST;
}

pub struct GroupExpr {
	pub expr: *AstNode
}

impl GroupExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_GROUP;
}

pub struct ArrayLiteralExpr {
	pub elements: List<*AstNode>,
	pub list_struct_name: str = "",
	pub elem_type_node: *AstNode = null
}

impl ArrayLiteralExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_ARRAY_LITERAL;
}

pub struct IfExpr {
	pub condition: *AstNode,
	pub then_branch: *AstNode,
	pub else_branch: *AstNode
}

impl IfExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_IF;
}

pub struct WhenArm {
	pub patterns: List<*AstNode>,
	pub is_else: bool,
	pub body: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct WhenExpr {
	pub condition: *AstNode,
	pub arms: List<WhenArm>
}

impl WhenExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_WHEN;
}

// One piece of an interpolated string: either a literal chunk (`is_literal`,
// in which case `expr` is a STRING literal) or a `${...}` hole expression.
pub struct InterpPart {
	pub expr: *AstNode,
	pub is_literal: bool
}

pub struct InterpExpr {
	pub parts: List<InterpPart>
}

impl InterpExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_INTERP;
}

pub struct IsExpr {
	pub expr: *AstNode,
	pub target_type: *AstNode,
	pub tag_field: str = ""
}

impl IsExpr {
	pub fn node_kind(val self) => NodeKind.EXPR_IS;
}
