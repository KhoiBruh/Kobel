mod compiler.ast;

use std.collections.List;

use compiler.lexer.TokenType;

pub enum LiteralKind {
	INT,
	FLOAT,
	BOOL,
	CHAR,
	STRING,
	NULL_VAL
}

pub struct WhenArm {
	pub patterns: List<*AstNode>,
	pub is_else: bool,
	pub body: *AstNode,
	pub line: usz,
	pub col: usz
}

// One piece of an interpolated string: either a literal chunk (STRING literal)
// or a `${...}` hole expression.
pub enum InterpPart {
	Literal(node: *AstNode),
	Hole(node: *AstNode)
}
