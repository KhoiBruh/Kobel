mod compiler.ast.types;

use std.collections.List;

use compiler.ast.node.*;

pub struct NamedType {
	pub name: str,
	pub type_args: List<*AstNode> = List()
}

pub struct PointerType {
	pub mutable: bool,
	pub pointee: *AstNode
}

pub struct ArrayType {
	pub element_type: *AstNode,
	pub size: usz
}

pub struct NullableType {
	pub inner: *AstNode
}
