mod compiler.ast.types;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;
use std.collections.list.List;

pub struct NamedType {
	pub name: str,
	pub type_args: List<*AstNode>
}

impl NamedType {
	pub fn node_kind(val self): NodeKind => NodeKind.TYPE_NAMED;
}

pub struct PointerType {
	pub is_mut: bool,
	pub pointee: *AstNode
}

impl PointerType {
	pub fn node_kind(val self): NodeKind => NodeKind.TYPE_POINTER;
}

pub struct ArrayType {
	pub element_type: *AstNode,
	pub size: usz
}

impl ArrayType {
	pub fn node_kind(val self): NodeKind => NodeKind.TYPE_ARRAY;
}

pub struct NullableType {
	pub inner: *AstNode
}

impl NullableType {
	pub fn node_kind(val self): NodeKind => NodeKind.TYPE_NULLABLE;
}
