mod compiler.ast.types;

use std.collections.list.List;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;

pub struct NamedType {
	pub const TAG = NodeKind.TYPE_NAMED;
	pub name: str,
	pub type_args: List<*AstNode> = List<*AstNode>()
}

pub struct PointerType {
	pub const TAG = NodeKind.TYPE_POINTER;
	pub is_mut: bool,
	pub pointee: *AstNode
}

pub struct ArrayType {
	pub const TAG = NodeKind.TYPE_ARRAY;
	pub element_type: *AstNode,
	pub size: usz
}

pub struct NullableType {
	pub const TAG = NodeKind.TYPE_NULLABLE;
	pub inner: *AstNode
}
