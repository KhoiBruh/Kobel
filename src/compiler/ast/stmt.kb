mod compiler.ast.stmt;

use compiler.ast.node.AstNode;
use std.collections.list.List;

pub struct BlockStmt {
	pub statements: List<*AstNode>
}

pub struct ExprStmt {
	pub expr: *AstNode
}

pub struct VarDeclStmt {
	pub is_mut: bool,
	pub name: str,
	pub type_annotation: *AstNode,
	pub initializer: *AstNode
}

pub struct IfStmt {
	pub condition: *AstNode,
	pub then_branch: *AstNode,
	pub else_branch: *AstNode
}

pub struct WhileStmt {
	pub condition: *AstNode,
	pub body: *AstNode
}

// `for (name in <iterable>)` or `for (name in <start>..<end>)`.
// The range forms keep the bounds here instead of an `iterable` expression, so
// the parser does not need a first-class range expression node. Exactly one of
// `is_open` (`a>..<b`, exclusive on both ends) and `is_half_open` (`a..<b`,
// exclusive on the end only) is set; both false means the closed `a..b` form.
pub struct ForStmt {
	pub var_name: str,
	pub is_range: bool,
	pub is_open: bool,
	pub is_half_open: bool,
	pub iterable: *AstNode,
	pub range_start: *AstNode,
	pub range_end: *AstNode,
	pub body: *AstNode
}

pub struct ReturnStmt {
	pub value: *AstNode
}

pub struct BreakStmt {
	pub dummy: i32
}

pub struct ContinueStmt {
	pub dummy: i32
}

pub struct WhenStmtArm {
	pub patterns: List<*AstNode>,
	pub is_else: bool,
	pub body: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct WhenStmt {
	pub condition: *AstNode,
	pub arms: List<WhenStmtArm>
}
