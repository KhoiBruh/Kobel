mod compiler.ast.node;

use std.mem.arena.Arena;

pub enum NodeKind {
	// Syntactic Types
	TYPE_NAMED,
	TYPE_POINTER,
	TYPE_ARRAY,
	TYPE_NULLABLE,

	// Expressions
	EXPR_LITERAL,
	EXPR_IDENTIFIER,
	EXPR_BINARY,
	EXPR_UNARY,
	EXPR_CALL,
	EXPR_MEMBER,
	EXPR_INDEX,
	EXPR_ASSIGN,
	EXPR_UPDATE,
	EXPR_CAST,
	EXPR_GROUP,
	EXPR_ARRAY_LITERAL,
	EXPR_IF,
	EXPR_WHEN,
	EXPR_INTERP,

	// Statements
	STMT_BLOCK,
	STMT_EXPR,
	STMT_VAR_DECL,
	STMT_IF,
	STMT_WHEN,
	STMT_WHILE,
	STMT_RETURN,
	STMT_BREAK,
	STMT_CONTINUE,
	STMT_FOR,
	STMT_YIELD,
	STMT_DEFER,

	// Declarations
	DECL_MODULE,
	DECL_USE,
	DECL_FN,
	DECL_STRUCT,
	DECL_TRAIT,
	DECL_IMPL,
	DECL_ENUM,
	DECL_CONST,
	DECL_EXTERN_BLOCK,
	PROGRAM,
	EXPR_IS,
	// A struct value built from its fields, e.g. `Point(1, 2)` -> `(Point){1, 2}`.
	// Never produced by the parser: sema creates it when construction is resolved.
	EXPR_STRUCT_CTOR,
	// A payload-enum value: `Shape.Circle(1.5)` -> `(Shape){ .tag = 0, ... }`.
	// Also created by sema, never by the parser.
	EXPR_ENUM_CTOR,
	// `T.size()` inside a generic function body: sema resolves the type-parameter
	// index against the current instance, and the backend lowers it to the C size
	// of that instance's concrete type argument. Never produced by the parser.
	EXPR_SIZE_OF_PARAM
}

// Every node payload is declared here as an opaque type, so the payload enum
// below can name it; the definitions live in ast.types / ast.expr / ast.stmt /
// ast.decl, which import this module. Cross-module forward declarations keep
// that a DAG instead of a cycle.
pub struct NamedType;
pub struct PointerType;
pub struct ArrayType;
pub struct NullableType;
pub struct LiteralExpr;
pub struct IdentifierExpr;
pub struct BinaryExpr;
pub struct UnaryExpr;
pub struct CallExpr;
pub struct MemberExpr;
pub struct IndexExpr;
pub struct AssignExpr;
pub struct UpdateExpr;
pub struct CastExpr;
pub struct GroupExpr;
pub struct ArrayLiteralExpr;
pub struct IfExpr;
pub struct WhenExpr;
pub struct InterpExpr;
pub struct IsExpr;
pub struct StructCtorExpr;
pub struct EnumCtorExpr;
pub struct SizeOfParam;
pub struct BlockStmt;
pub struct ExprStmt;
pub struct VarDeclStmt;
pub struct IfStmt;
pub struct WhileStmt;
pub struct ForStmt;
pub struct ReturnStmt;
pub struct BreakStmt;
pub struct ContinueStmt;
pub struct WhenStmt;
pub struct YieldStmt;
pub struct DeferStmt;
pub struct ModuleDecl;
pub struct UseDecl;
pub struct FnDecl;
pub struct StructDecl;
pub struct TraitDecl;
pub struct ImplDecl;
pub struct EnumDecl;
pub struct ConstDecl;
pub struct ExternBlock;
pub struct Program;

// The payload of an `AstNode`: one variant per node shape, checked by the
// type system instead of reinterpreted through a `*u8`.
pub enum NodeData {
	NONE,
	NamedType(inner: *NamedType),
	PointerType(inner: *PointerType),
	ArrayType(inner: *ArrayType),
	NullableType(inner: *NullableType),
	LiteralExpr(inner: *LiteralExpr),
	IdentifierExpr(inner: *IdentifierExpr),
	BinaryExpr(inner: *BinaryExpr),
	UnaryExpr(inner: *UnaryExpr),
	CallExpr(inner: *CallExpr),
	MemberExpr(inner: *MemberExpr),
	IndexExpr(inner: *IndexExpr),
	AssignExpr(inner: *AssignExpr),
	UpdateExpr(inner: *UpdateExpr),
	CastExpr(inner: *CastExpr),
	GroupExpr(inner: *GroupExpr),
	ArrayLiteralExpr(inner: *ArrayLiteralExpr),
	IfExpr(inner: *IfExpr),
	WhenExpr(inner: *WhenExpr),
	InterpExpr(inner: *InterpExpr),
	IsExpr(inner: *IsExpr),
	StructCtorExpr(inner: *StructCtorExpr),
	EnumCtorExpr(inner: *EnumCtorExpr),
	SizeOfParam(inner: *SizeOfParam),
	BlockStmt(inner: *BlockStmt),
	ExprStmt(inner: *ExprStmt),
	VarDeclStmt(inner: *VarDeclStmt),
	IfStmt(inner: *IfStmt),
	WhileStmt(inner: *WhileStmt),
	ForStmt(inner: *ForStmt),
	ReturnStmt(inner: *ReturnStmt),
	BreakStmt(inner: *BreakStmt),
	ContinueStmt(inner: *ContinueStmt),
	WhenStmt(inner: *WhenStmt),
	YieldStmt(inner: *YieldStmt),
	DeferStmt(inner: *DeferStmt),
	ModuleDecl(inner: *ModuleDecl),
	UseDecl(inner: *UseDecl),
	FnDecl(inner: *FnDecl),
	StructDecl(inner: *StructDecl),
	TraitDecl(inner: *TraitDecl),
	ImplDecl(inner: *ImplDecl),
	EnumDecl(inner: *EnumDecl),
	ConstDecl(inner: *ConstDecl),
	ExternBlock(inner: *ExternBlock),
	Program(inner: *Program),
}

pub struct AstNode {
	pub kind: NodeKind,
	pub line: usz,
	pub col: usz,
	pub data: NodeData,
	// Resolved semantic type of an expression (the compiler's `*Type`, kept
	// untyped so `ast` stays a leaf). Sema fills it; codegen and `lower` read it.
	// Null on declarations and on nodes that desugaring synthesises.
	pub type_ptr: *u8? = null,
	// Method or operator the checker picked for this node (`*MethodInfo`, again
	// untyped). `lower` needs it to spell the C call without repeating the
	// overload/trait resolution the checker already did.
	pub resolved_method: *u8? = null,
	// A leaf the checker resolved directly: an enum member becomes an integer
	// literal, a struct constant becomes its mangled identifier. `lower` uses it
	// as the node's replacement.
	pub resolved_node: *AstNode? = null,
	// For a function/method *instance* (a generic function whose body shares the
	// template's AST), the `InstanceRecord` that carries this declaration's
	// per-instance annotations. Null for ordinary declarations and templates.
	pub instance: *u8? = null
}

impl AstNode {
	pub fn as_named_type(val self): *NamedType => (self as? NamedType) as *NamedType;
	pub fn as_pointer_type(val self): *PointerType => (self as? PointerType) as *PointerType;
	pub fn as_array_type(val self): *ArrayType => (self as? ArrayType) as *ArrayType;
	pub fn as_nullable_type(val self): *NullableType => (self as? NullableType) as *NullableType;
	pub fn as_literal_expr(val self): *LiteralExpr => (self as? LiteralExpr) as *LiteralExpr;
	pub fn as_identifier_expr(val self): *IdentifierExpr => (self as? IdentifierExpr) as *IdentifierExpr;
	pub fn as_binary_expr(val self): *BinaryExpr => (self as? BinaryExpr) as *BinaryExpr;
	pub fn as_unary_expr(val self): *UnaryExpr => (self as? UnaryExpr) as *UnaryExpr;
	pub fn as_call_expr(val self): *CallExpr => (self as? CallExpr) as *CallExpr;
	pub fn as_member_expr(val self): *MemberExpr => (self as? MemberExpr) as *MemberExpr;
	pub fn as_index_expr(val self): *IndexExpr => (self as? IndexExpr) as *IndexExpr;
	pub fn as_assign_expr(val self): *AssignExpr => (self as? AssignExpr) as *AssignExpr;
	pub fn as_update_expr(val self): *UpdateExpr => (self as? UpdateExpr) as *UpdateExpr;
	pub fn as_cast_expr(val self): *CastExpr => (self as? CastExpr) as *CastExpr;
	pub fn as_group_expr(val self): *GroupExpr => (self as? GroupExpr) as *GroupExpr;
	pub fn as_array_literal_expr(val self): *ArrayLiteralExpr => (self as? ArrayLiteralExpr) as *ArrayLiteralExpr;
	pub fn as_if_expr(val self): *IfExpr => (self as? IfExpr) as *IfExpr;
	pub fn as_when_expr(val self): *WhenExpr => (self as? WhenExpr) as *WhenExpr;
	pub fn as_interp_expr(val self): *InterpExpr => (self as? InterpExpr) as *InterpExpr;
	pub fn as_is_expr(val self): *IsExpr => (self as? IsExpr) as *IsExpr;
	pub fn as_struct_ctor_expr(val self): *StructCtorExpr => (self as? StructCtorExpr) as *StructCtorExpr;
	pub fn as_enum_ctor_expr(val self): *EnumCtorExpr => (self as? EnumCtorExpr) as *EnumCtorExpr;
	pub fn as_size_of_param(val self): *SizeOfParam => (self as? SizeOfParam) as *SizeOfParam;
	pub fn as_block_stmt(val self): *BlockStmt => (self as? BlockStmt) as *BlockStmt;
	pub fn as_expr_stmt(val self): *ExprStmt => (self as? ExprStmt) as *ExprStmt;
	pub fn as_var_decl_stmt(val self): *VarDeclStmt => (self as? VarDeclStmt) as *VarDeclStmt;
	pub fn as_if_stmt(val self): *IfStmt => (self as? IfStmt) as *IfStmt;
	pub fn as_while_stmt(val self): *WhileStmt => (self as? WhileStmt) as *WhileStmt;
	pub fn as_for_stmt(val self): *ForStmt => (self as? ForStmt) as *ForStmt;
	pub fn as_return_stmt(val self): *ReturnStmt => (self as? ReturnStmt) as *ReturnStmt;
	pub fn as_break_stmt(val self): *BreakStmt => (self as? BreakStmt) as *BreakStmt;
	pub fn as_continue_stmt(val self): *ContinueStmt => (self as? ContinueStmt) as *ContinueStmt;
	pub fn as_when_stmt(val self): *WhenStmt => (self as? WhenStmt) as *WhenStmt;
	pub fn as_yield_stmt(val self): *YieldStmt => (self as? YieldStmt) as *YieldStmt;
	pub fn as_defer_stmt(val self): *DeferStmt => (self as? DeferStmt) as *DeferStmt;
	pub fn as_module_decl(val self): *ModuleDecl => (self as? ModuleDecl) as *ModuleDecl;
	pub fn as_use_decl(val self): *UseDecl => (self as? UseDecl) as *UseDecl;
	pub fn as_fn_decl(val self): *FnDecl => (self as? FnDecl) as *FnDecl;
	pub fn as_struct_decl(val self): *StructDecl => (self as? StructDecl) as *StructDecl;
	pub fn as_trait_decl(val self): *TraitDecl => (self as? TraitDecl) as *TraitDecl;
	pub fn as_impl_decl(val self): *ImplDecl => (self as? ImplDecl) as *ImplDecl;
	pub fn as_enum_decl(val self): *EnumDecl => (self as? EnumDecl) as *EnumDecl;
	pub fn as_const_decl(val self): *ConstDecl => (self as? ConstDecl) as *ConstDecl;
	pub fn as_extern_block(val self): *ExternBlock => (self as? ExternBlock) as *ExternBlock;
	pub fn as_program(val self): *Program => (self as? Program) as *Program;
}

impl Arena {
	pub fn alloc_node(
		var self, kind: NodeKind, data: NodeData,
		line: usz, col: usz
	) => self.alloc_val(AstNode(kind, line, col, data));
}
