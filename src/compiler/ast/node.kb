mod compiler.ast.node;

pub enum NodeKind {
	// Syntactic Types
	TYPE_NAMED,
	TYPE_POINTER,
	TYPE_ARRAY,

	// Expressions
	EXPR_LITERAL,
	EXPR_IDENTIFIER,
	EXPR_BINARY,
	EXPR_UNARY,
	EXPR_CALL,
	EXPR_MEMBER,
	EXPR_INDEX,
	EXPR_ASSIGN,
	EXPR_CAST,
	EXPR_GROUP,
	EXPR_ARRAY_LITERAL,
	EXPR_IF,
	EXPR_WHEN,

	// Statements
	STMT_BLOCK,
	STMT_EXPR,
	STMT_VAR_DECL,
	STMT_IF,
	STMT_WHEN,
	STMT_WHILE,
	STMT_RETURN,
	STMT_BREAK,
	STMT_CONTINUE,

	// Declarations
	DECL_MODULE,
	DECL_USE,
	DECL_FN,
	DECL_STRUCT,
	DECL_TRAIT,
	DECL_IMPL,
	DECL_ENUM,
	DECL_CONST,
	DECL_EXTERN_BLOCK,
	PROGRAM
}

pub struct AstNode {
	pub kind: NodeKind,
	pub line: usz,
	pub col: usz,
	pub data: *u8
}

pub fn new_node(kind: NodeKind, line: usz, col: usz, data: *u8): AstNode =>
	AstNode(kind, line, col, data);

pub fn node_kind_name(k: NodeKind): str => when (k) {
	NodeKind.TYPE_NAMED -> "TYPE_NAMED",
	NodeKind.TYPE_POINTER -> "TYPE_POINTER",
	NodeKind.TYPE_ARRAY -> "TYPE_ARRAY",

	NodeKind.EXPR_LITERAL -> "EXPR_LITERAL",
	NodeKind.EXPR_IDENTIFIER -> "EXPR_IDENTIFIER",
	NodeKind.EXPR_BINARY -> "EXPR_BINARY",
	NodeKind.EXPR_UNARY -> "EXPR_UNARY",
	NodeKind.EXPR_CALL -> "EXPR_CALL",
	NodeKind.EXPR_MEMBER -> "EXPR_MEMBER",
	NodeKind.EXPR_INDEX -> "EXPR_INDEX",
	NodeKind.EXPR_ASSIGN -> "EXPR_ASSIGN",
	NodeKind.EXPR_CAST -> "EXPR_CAST",
	NodeKind.EXPR_GROUP -> "EXPR_GROUP",
	NodeKind.EXPR_ARRAY_LITERAL -> "EXPR_ARRAY_LITERAL",
	NodeKind.EXPR_IF -> "EXPR_IF",
	NodeKind.EXPR_WHEN -> "EXPR_WHEN",

	NodeKind.STMT_BLOCK -> "STMT_BLOCK",
	NodeKind.STMT_EXPR -> "STMT_EXPR",
	NodeKind.STMT_VAR_DECL -> "STMT_VAR_DECL",
	NodeKind.STMT_IF -> "STMT_IF",
	NodeKind.STMT_WHEN -> "STMT_WHEN",
	NodeKind.STMT_WHILE -> "STMT_WHILE",
	NodeKind.STMT_RETURN -> "STMT_RETURN",
	NodeKind.STMT_BREAK -> "STMT_BREAK",
	NodeKind.STMT_CONTINUE -> "STMT_CONTINUE",

	NodeKind.DECL_MODULE -> "DECL_MODULE",
	NodeKind.DECL_USE -> "DECL_USE",
	NodeKind.DECL_FN -> "DECL_FN",
	NodeKind.DECL_STRUCT -> "DECL_STRUCT",
	NodeKind.DECL_TRAIT -> "DECL_TRAIT",
	NodeKind.DECL_IMPL -> "DECL_IMPL",
	NodeKind.DECL_ENUM -> "DECL_ENUM",
	NodeKind.DECL_CONST -> "DECL_CONST",
	NodeKind.DECL_EXTERN_BLOCK -> "DECL_EXTERN_BLOCK",
	NodeKind.PROGRAM -> "PROGRAM",
	else -> "UNKNOWN"
};
