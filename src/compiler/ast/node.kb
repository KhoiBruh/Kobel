mod compiler.ast;

use std.memory.Arena;
use std.collections.List;
use std.traits.Hash;

use compiler.core.Span;
use compiler.lexer.*;

/*
 * ============================================================================
 * compiler.ast.node — Pure syntax tree node and strongly-typed NodeId
 *
 * `AstNode` is strictly syntactic: it stores only its `NodeId`, source `Span`
 * (and `line`/`col`), and `NodeData` variant payload. All semantic analysis
 * results (types, resolved methods, lowered replacements, generic instances)
 * live in `SemanticTable` side-tables in the semantic layer, never as untyped
 * pointers on `AstNode`.
 * ============================================================================
 */

pub struct NodeId {
	pub id: u32 = 0
}

impl NodeId {

	pub fn invalid() => NodeId(0);

	pub fn is_valid(*self) => self.id != 0;

	pub op equals(*self, other: NodeId) => self.id == other.id;

}

impl Hash for NodeId {
	pub fn hash(*self) => self.id.hash();
}

pub enum NodeData {
	NONE,
	// Type annotations
	NamedType(name: str, type_args: List<*AstNode>),
	PointerType(mutable: bool, nullable: bool, pointee: *AstNode),
	ArrayType(element_type: *AstNode, size: usz),
	VariadicType(element_type: *AstNode),
	FnType(param_types: List<*AstNode>, return_type: *AstNode),

	// Expressions
	LiteralExpr(literal_kind: Literal, raw_text: str),
	IdentifierExpr(name: str),
	BinaryExpr(left: *AstNode, op: TokenType, right: *AstNode),
	UnaryExpr(op: TokenType, operand: *AstNode, is_postfix: bool),
	CallExpr(callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>),
	MemberExpr(object: *AstNode, member: str, is_safe: bool),
	IndexExpr(target: *AstNode, index: *AstNode),
	AssignExpr(target: *AstNode, op: TokenType, value: *AstNode),
	UpdateExpr(op: TokenType, target: *AstNode),
	CastExpr(expr: ?*AstNode, target_type: *AstNode),
	GroupExpr(expr: *AstNode),
	ArrayLiteralExpr(elements: List<*AstNode>),
	IfExpr(condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode),
	WhenExpr(condition: ?*AstNode, arms: List<WhenArm>),
	InterpExpr(parts: List<InterpPart>),
	IsExpr(expr: ?*AstNode, target_type: *AstNode, alias: str),
	LambdaExpr(params: List<Param>, body: *AstNode, is_trailing: bool, had_empty_parens: bool),
	StructCtorExpr(c_name: str, args: List<*AstNode>),
	EnumCtorExpr(c_name: str, tag_field: str, tag_value: i64, payload_path: str, args: List<*AstNode>),
	SizeOfParam(param_index: usz, size_text: str),

	// Statements
	BlockStmt(statements: List<*AstNode>),
	ExprStmt(expr: *AstNode),
	VarDeclStmt(mutable: bool, name: str, type_annotation: ?*AstNode, initializer: ?*AstNode),
	DestructDeclStmt(mutable: bool, names: List<str>, initializer: *AstNode),
	IfStmt(condition: *AstNode, then_branch: *AstNode, else_branch: ?*AstNode),
	WhileStmt(condition: *AstNode, body: *AstNode),
	ForStmt(var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: ?*AstNode, range_start: ?*AstNode, range_end: ?*AstNode, body: *AstNode),
	ReturnStmt(value: ?*AstNode),
	BreakStmt,
	ContinueStmt,
	WhenStmt(condition: ?*AstNode, arms: List<WhenArm>),
	YieldStmt(value: ?*AstNode),
	DeferStmt(body: *AstNode),

	// Declarations
	ModuleDecl(path: List<str>, full_path: str),
	UseDecl(path: List<str>, full_path: str, symbol_name: str, alias: str, wildcard: bool),
	FnDecl(name: str, type_params: List<GenericParam>, params: List<Param>, return_type: ?*AstNode, body: ?*AstNode, public: bool, operator: bool, initializer: bool, module: str),
	StructDecl(name: str, type_params: List<GenericParam>, fields: List<StructField>, public: bool, forward: bool, emit_typedef: bool),
	TraitDecl(name: str, type_params: List<GenericParam>, bases: List<str>, methods: List<*AstNode>, public: bool, assoc_types: List<str>),
	ImplDecl(struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, assoc_bindings: List<AssocBinding>),
	EnumDecl(name: str, underlying_type: ?*AstNode, members: List<EnumMember>, public: bool),
	ConstDecl(name: str, type_node: ?*AstNode, value: ?*AstNode, public: bool),
	ExternBlock(abi: str, declarations: List<*AstNode>),
	Program(declarations: List<*AstNode>)
}

pub struct AstNode {
	pub line: usz,
	pub col: usz,
	pub data: NodeData,
	pub id: NodeId = NodeId(0),
	pub span: Span = Span.empty()
}

impl AstNode {

	pub op unpack(*self, line: &usz, col: &usz) {
		line.write(self.line);
		col.write(self.col);
	}

}

impl Arena {

	pub fn node(
		&self, data: NodeData,
		line: usz = 0, col: usz = 0
	): *AstNode {
		val span = Span(0, line as u32, col as u32, 0);
		var node = self.create_val(AstNode(line, col, data, NodeId(0), span));
		val raw_id = (node.addr() / 8) as u32;
		node.id = NodeId(if (raw_id == 0) 1 else raw_id);
		return node;
	}

	pub fn node_spanned(
		&self, data: NodeData,
		span: Span, id: NodeId = NodeId(0)
	) => self.create_val(
		AstNode(span.line, span.col, data, id, span)
	);

}
