mod compiler.ast;

use std.memory.Arena;
use std.collections.List;
use compiler.lexer.*;

// The payload of an `AstNode`: one variant per node shape, checked by the
// type system instead of reinterpreted through a `*u8`.
pub enum NodeData {
	NONE,
	NamedType(name: str, type_args: List<*AstNode>),
	PointerType(mutable: bool, pointee: *AstNode),
	ArrayType(element_type: *AstNode, size: usz),
	NullableType(inner_type: *AstNode),
	LiteralExpr(literal_kind: LiteralKind, raw_text: str),
	IdentifierExpr(name: str),
	BinaryExpr(left: *AstNode, op: TokenType, right: *AstNode),
	UnaryExpr(op: TokenType, operand: *AstNode, is_postfix: bool),
	CallExpr(callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>),
	MemberExpr(object: *AstNode, member: str, is_safe: bool),
	IndexExpr(target: *AstNode, index: *AstNode),
	AssignExpr(target: *AstNode, op: TokenType, value: *AstNode),
	UpdateExpr(op: TokenType, target: *AstNode),
	CastExpr(expr: *AstNode?, target_type: *AstNode),
	GroupExpr(expr: *AstNode),
	ArrayLiteralExpr(elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode?),
	IfExpr(condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode),
	WhenExpr(condition: *AstNode?, arms: List<WhenArm>),
	InterpExpr(parts: List<InterpPart>),
	IsExpr(expr: *AstNode?, target_type: *AstNode, alias: str, tag_field: str, base_c_name: str, is_ptr: bool, mutable: bool, payload_path: str, payload_ptr: bool, tag_const: str),
	StructCtorExpr(c_name: str, args: List<*AstNode>),
	EnumCtorExpr(c_name: str, tag_field: str, tag_value: i64, payload_path: str, args: List<*AstNode>),
	SizeOfParam(param_index: usz, size_text: str),
	BlockStmt(statements: List<*AstNode>),
	ExprStmt(expr: *AstNode),
	VarDeclStmt(mutable: bool, name: str, type_annotation: *AstNode?, initializer: *AstNode?),
	IfStmt(condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode?),
	WhileStmt(condition: *AstNode, body: *AstNode),
	ForStmt(var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode?, range_start: *AstNode?, range_end: *AstNode?, body: *AstNode),
	ReturnStmt(value: *AstNode?),
	BreakStmt,
	ContinueStmt,
	WhenStmt(condition: *AstNode?, arms: List<WhenStmtArm>),
	YieldStmt(value: *AstNode?),
	DeferStmt(body: *AstNode),
	ModuleDecl(path: List<str>, full_path: str),
	UseDecl(path: List<str>, full_path: str, symbol_name: str, alias: str, wildcard: bool),
	FnDecl(name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode?, body: *AstNode?, public: bool, operator: bool, initializer: bool, module: str),
	StructDecl(name: str, type_params: List<GenericParam>, fields: List<StructField>, public: bool, forward: bool, emit_typedef: bool),
	TraitDecl(name: str, type_params: List<GenericParam>, bases: List<str>, methods: List<*AstNode>, public: bool, assoc_types: List<str>),
	ImplDecl(struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, assoc_bindings: List<AssocBinding>),
	EnumDecl(name: str, underlying_type: *AstNode?, members: List<EnumMember>, public: bool),
	ConstDecl(name: str, type_node: *AstNode?, value: *AstNode?, public: bool),
	ExternBlock(abi: str, declarations: List<*AstNode>),
	Program(declarations: List<*AstNode>),
}

pub struct AstNode {
	pub line: usz,
	pub col: usz,
	pub data: NodeData,
	// Resolved semantic type of an expression (the compiler's `*Type`, kept
	// untyped so `ast` stays a leaf). Sema fills it; codegen and `lower` read it.
	// Null on declarations and on nodes that desugaring synthesises.
	pub type_ptr: *u8? = null,
	// Method or operator the checker picked for this node (`*MethodInfo`, again
	// untyped). `lower` needs it to spell the C call without repeating the
	// overload/trait resolution the checker already did.
	pub resolved_method: *u8? = null,
	// A leaf the checker resolved directly: an enum member becomes an integer
	// literal, a struct constant becomes its mangled identifier. `lower` uses it
	// as the node's replacement.
	pub resolved_node: *AstNode? = null,
	// For a function/method *instance* (a generic function whose body shares the
	// template's AST), the `InstanceRecord` that carries this declaration's
	// per-instance annotations. Null for ordinary declarations and templates.
	pub instance: *u8? = null
}

impl AstNode {
	pub fn as_named_type(val self): *NamedType {
		if (self is NamedType as d) return d;
		return null as *NamedType;
	}
	pub fn as_pointer_type(val self): *PointerType {
		if (self is PointerType as d) return d;
		return null as *PointerType;
	}
	pub fn as_array_type(val self): *ArrayType {
		if (self is ArrayType as d) return d;
		return null as *ArrayType;
	}
	pub fn as_nullable_type(val self): *NullableType {
		if (self is NullableType as d) return d;
		return null as *NullableType;
	}
	pub fn as_literal_expr(val self): *LiteralExpr {
		if (self is LiteralExpr as d) return d;
		return null as *LiteralExpr;
	}
	pub fn as_identifier_expr(val self): *IdentifierExpr {
		if (self is IdentifierExpr as d) return d;
		return null as *IdentifierExpr;
	}
	pub fn as_binary_expr(val self): *BinaryExpr {
		if (self is BinaryExpr as d) return d;
		return null as *BinaryExpr;
	}
	pub fn as_unary_expr(val self): *UnaryExpr {
		if (self is UnaryExpr as d) return d;
		return null as *UnaryExpr;
	}
	pub fn as_call_expr(val self): *CallExpr {
		if (self is CallExpr as d) return d;
		return null as *CallExpr;
	}
	pub fn as_member_expr(val self): *MemberExpr {
		if (self is MemberExpr as d) return d;
		return null as *MemberExpr;
	}
	pub fn as_index_expr(val self): *IndexExpr {
		if (self is IndexExpr as d) return d;
		return null as *IndexExpr;
	}
	pub fn as_assign_expr(val self): *AssignExpr {
		if (self is AssignExpr as d) return d;
		return null as *AssignExpr;
	}
	pub fn as_update_expr(val self): *UpdateExpr {
		if (self is UpdateExpr as d) return d;
		return null as *UpdateExpr;
	}
	pub fn as_cast_expr(val self): *CastExpr {
		if (self is CastExpr as d) return d;
		return null as *CastExpr;
	}
	pub fn as_group_expr(val self): *GroupExpr {
		if (self is GroupExpr as d) return d;
		return null as *GroupExpr;
	}
	pub fn as_array_literal_expr(val self): *ArrayLiteralExpr {
		if (self is ArrayLiteralExpr as d) return d;
		return null as *ArrayLiteralExpr;
	}
	pub fn as_if_expr(val self): *IfExpr {
		if (self is IfExpr as d) return d;
		return null as *IfExpr;
	}
	pub fn as_when_expr(val self): *WhenExpr {
		if (self is WhenExpr as d) return d;
		return null as *WhenExpr;
	}
	pub fn as_interp_expr(val self): *InterpExpr {
		if (self is InterpExpr as d) return d;
		return null as *InterpExpr;
	}
	pub fn as_is_expr(val self): *IsExpr {
		if (self is IsExpr as d) return d;
		return null as *IsExpr;
	}
	pub fn as_struct_ctor_expr(val self): *StructCtorExpr {
		if (self is StructCtorExpr as d) return d;
		return null as *StructCtorExpr;
	}
	pub fn as_enum_ctor_expr(val self): *EnumCtorExpr {
		if (self is EnumCtorExpr as d) return d;
		return null as *EnumCtorExpr;
	}
	pub fn as_size_of_param(val self): *SizeOfParam {
		if (self is SizeOfParam as d) return d;
		return null as *SizeOfParam;
	}
	pub fn as_block_stmt(val self): *BlockStmt {
		if (self is BlockStmt as d) return d;
		return null as *BlockStmt;
	}
	pub fn as_expr_stmt(val self): *ExprStmt {
		if (self is ExprStmt as d) return d;
		return null as *ExprStmt;
	}
	pub fn as_var_decl_stmt(val self): *VarDeclStmt {
		if (self is VarDeclStmt as d) return d;
		return null as *VarDeclStmt;
	}
	pub fn as_if_stmt(val self): *IfStmt {
		if (self is IfStmt as d) return d;
		return null as *IfStmt;
	}
	pub fn as_while_stmt(val self): *WhileStmt {
		if (self is WhileStmt as d) return d;
		return null as *WhileStmt;
	}
	pub fn as_for_stmt(val self): *ForStmt {
		if (self is ForStmt as d) return d;
		return null as *ForStmt;
	}
	pub fn as_return_stmt(val self): *ReturnStmt {
		if (self is ReturnStmt as d) return d;
		return null as *ReturnStmt;
	}
	pub fn as_break_stmt(val self): *BreakStmt {
		if (self is BreakStmt as d) return d;
		return null as *BreakStmt;
	}
	pub fn as_continue_stmt(val self): *ContinueStmt {
		if (self is ContinueStmt as d) return d;
		return null as *ContinueStmt;
	}
	pub fn as_when_stmt(val self): *WhenStmt {
		if (self is WhenStmt as d) return d;
		return null as *WhenStmt;
	}
	pub fn as_yield_stmt(val self): *YieldStmt {
		if (self is YieldStmt as d) return d;
		return null as *YieldStmt;
	}
	pub fn as_defer_stmt(val self): *DeferStmt {
		if (self is DeferStmt as d) return d;
		return null as *DeferStmt;
	}
	pub fn as_module_decl(val self): *ModuleDecl {
		if (self is ModuleDecl as d) return d;
		return null as *ModuleDecl;
	}
	pub fn as_use_decl(val self): *UseDecl {
		if (self is UseDecl as d) return d;
		return null as *UseDecl;
	}
	pub fn as_fn_decl(val self): *FnDecl {
		if (self is FnDecl as d) return d;
		return null as *FnDecl;
	}
	pub fn as_struct_decl(val self): *StructDecl {
		if (self is StructDecl as d) return d;
		return null as *StructDecl;
	}
	pub fn as_trait_decl(val self): *TraitDecl {
		if (self is TraitDecl as d) return d;
		return null as *TraitDecl;
	}
	pub fn as_impl_decl(val self): *ImplDecl {
		if (self is ImplDecl as d) return d;
		return null as *ImplDecl;
	}
	pub fn as_enum_decl(val self): *EnumDecl {
		if (self is EnumDecl as d) return d;
		return null as *EnumDecl;
	}
	pub fn as_const_decl(val self): *ConstDecl {
		if (self is ConstDecl as d) return d;
		return null as *ConstDecl;
	}
	pub fn as_extern_block(val self): *ExternBlock {
		if (self is ExternBlock as d) return d;
		return null as *ExternBlock;
	}
	pub fn as_program(val self): *Program {
		if (self is Program as d) return d;
		return null as *Program;
	}
}

impl Arena {
	pub fn node(
		var self, data: NodeData,
		line: usz = 0, col: usz = 0
	): *AstNode => self.create_val(AstNode(line, col, data));
}
