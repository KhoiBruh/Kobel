mod compiler.ast.node;

use std.mem.arena.Arena;

pub enum NodeKind {
	// Syntactic Types
	TYPE_NAMED,
	TYPE_POINTER,
	TYPE_ARRAY,
	TYPE_NULLABLE,

	// Expressions
	EXPR_LITERAL,
	EXPR_IDENTIFIER,
	EXPR_BINARY,
	EXPR_UNARY,
	EXPR_CALL,
	EXPR_MEMBER,
	EXPR_INDEX,
	EXPR_ASSIGN,
	EXPR_UPDATE,
	EXPR_CAST,
	EXPR_GROUP,
	EXPR_ARRAY_LITERAL,
	EXPR_IF,
	EXPR_WHEN,
	EXPR_INTERP,

	// Statements
	STMT_BLOCK,
	STMT_EXPR,
	STMT_VAR_DECL,
	STMT_IF,
	STMT_WHEN,
	STMT_WHILE,
	STMT_RETURN,
	STMT_BREAK,
	STMT_CONTINUE,
	STMT_FOR,
	STMT_YIELD,
	STMT_DEFER,

	// Declarations
	DECL_MODULE,
	DECL_USE,
	DECL_FN,
	DECL_STRUCT,
	DECL_TRAIT,
	DECL_IMPL,
	DECL_ENUM,
	DECL_CONST,
	DECL_EXTERN_BLOCK,
	PROGRAM,
	EXPR_IS,
	// A struct value built from its fields, e.g. `Point(1, 2)` -> `(Point){1, 2}`.
	// Never produced by the parser: sema creates it when construction is resolved.
	EXPR_STRUCT_CTOR,
	// A payload-enum value: `Shape.Circle(1.5)` -> `(Shape){ .tag = 0, ... }`.
	// Also created by sema, never by the parser.
	EXPR_ENUM_CTOR,
	// `T.size()` inside a generic function body: sema resolves the type-parameter
	// index against the current instance, and the backend lowers it to the C size
	// of that instance's concrete type argument. Never produced by the parser.
	EXPR_SIZE_OF_PARAM
}

// Every node payload is declared here as an opaque type, so the payload enum
// below can name it; the definitions live in ast.types / ast.expr / ast.stmt /
// ast.decl, which import this module. Cross-module forward declarations keep
// that a DAG instead of a cycle.
pub struct NamedType;
pub struct PointerType;
pub struct ArrayType;
pub struct NullableType;
pub struct LiteralExpr;
pub struct IdentifierExpr;
pub struct BinaryExpr;
pub struct UnaryExpr;
pub struct CallExpr;
pub struct MemberExpr;
pub struct IndexExpr;
pub struct AssignExpr;
pub struct UpdateExpr;
pub struct CastExpr;
pub struct GroupExpr;
pub struct ArrayLiteralExpr;
pub struct IfExpr;
pub struct WhenExpr;
pub struct InterpExpr;
pub struct IsExpr;
pub struct StructCtorExpr;
pub struct EnumCtorExpr;
pub struct SizeOfParam;
pub struct BlockStmt;
pub struct ExprStmt;
pub struct VarDeclStmt;
pub struct IfStmt;
pub struct WhileStmt;
pub struct ForStmt;
pub struct ReturnStmt;
pub struct BreakStmt;
pub struct ContinueStmt;
pub struct WhenStmt;
pub struct YieldStmt;
pub struct DeferStmt;
pub struct ModuleDecl;
pub struct UseDecl;
pub struct FnDecl;
pub struct StructDecl;
pub struct TraitDecl;
pub struct ImplDecl;
pub struct EnumDecl;
pub struct ConstDecl;
pub struct ExternBlock;
pub struct Program;

// The payload of an `AstNode`: one variant per node shape, checked by the
// type system instead of reinterpreted through a `*u8`.
pub enum NodeData {
	NONE,
	NamedType(inner: *NamedType),
	PointerType(inner: *PointerType),
	ArrayType(inner: *ArrayType),
	NullableType(inner: *NullableType),
	LiteralExpr(inner: *LiteralExpr),
	IdentifierExpr(inner: *IdentifierExpr),
	BinaryExpr(inner: *BinaryExpr),
	UnaryExpr(inner: *UnaryExpr),
	CallExpr(inner: *CallExpr),
	MemberExpr(inner: *MemberExpr),
	IndexExpr(inner: *IndexExpr),
	AssignExpr(inner: *AssignExpr),
	UpdateExpr(inner: *UpdateExpr),
	CastExpr(inner: *CastExpr),
	GroupExpr(inner: *GroupExpr),
	ArrayLiteralExpr(inner: *ArrayLiteralExpr),
	IfExpr(inner: *IfExpr),
	WhenExpr(inner: *WhenExpr),
	InterpExpr(inner: *InterpExpr),
	IsExpr(inner: *IsExpr),
	StructCtorExpr(inner: *StructCtorExpr),
	EnumCtorExpr(inner: *EnumCtorExpr),
	SizeOfParam(inner: *SizeOfParam),
	BlockStmt(inner: *BlockStmt),
	ExprStmt(inner: *ExprStmt),
	VarDeclStmt(inner: *VarDeclStmt),
	IfStmt(inner: *IfStmt),
	WhileStmt(inner: *WhileStmt),
	ForStmt(inner: *ForStmt),
	ReturnStmt(inner: *ReturnStmt),
	BreakStmt(inner: *BreakStmt),
	ContinueStmt(inner: *ContinueStmt),
	WhenStmt(inner: *WhenStmt),
	YieldStmt(inner: *YieldStmt),
	DeferStmt(inner: *DeferStmt),
	ModuleDecl(inner: *ModuleDecl),
	UseDecl(inner: *UseDecl),
	FnDecl(inner: *FnDecl),
	StructDecl(inner: *StructDecl),
	TraitDecl(inner: *TraitDecl),
	ImplDecl(inner: *ImplDecl),
	EnumDecl(inner: *EnumDecl),
	ConstDecl(inner: *ConstDecl),
	ExternBlock(inner: *ExternBlock),
	Program(inner: *Program),
}

pub struct AstNode {
	pub kind: NodeKind,
	pub line: usz,
	pub col: usz,
	pub data: NodeData,
	// Resolved semantic type of an expression (the compiler's `*Type`, kept
	// untyped so `ast` stays a leaf). Sema fills it; codegen and `lower` read it.
	// Null on declarations and on nodes that desugaring synthesises.
	pub type_ptr: *u8 = null,
	// Method or operator the checker picked for this node (`*MethodInfo`, again
	// untyped). `lower` needs it to spell the C call without repeating the
	// overload/trait resolution the checker already did.
	pub resolved_method: *u8 = null,
	// A leaf the checker resolved directly: an enum member becomes an integer
	// literal, a struct constant becomes its mangled identifier. `lower` uses it
	// as the node's replacement.
	pub resolved_node: *AstNode = null,
	// For a function/method *instance* (a generic function whose body shares the
	// template's AST), the `InstanceRecord` that carries this declaration's
	// per-instance annotations. Null for ordinary declarations and templates.
	pub instance: *u8 = null
}

impl AstNode {
	pub fn as_named_type(val self): *NamedType {
		val data = self.data;
		return when (data) {
			is NodeData.NamedType as d -> d.inner;
			else -> null;
		};
	}

	pub fn as_pointer_type(val self): *PointerType {
		val data = self.data;
		return when (data) {
