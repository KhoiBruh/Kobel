mod compiler.ast.node;

use std.mem.arena.Arena;

pub enum NodeKind {
	// Syntactic Types
	TYPE_NAMED,
	TYPE_POINTER,
	TYPE_ARRAY,
	TYPE_NULLABLE,

	// Expressions
	EXPR_LITERAL,
	EXPR_IDENTIFIER,
	EXPR_BINARY,
	EXPR_UNARY,
	EXPR_CALL,
	EXPR_MEMBER,
	EXPR_INDEX,
	EXPR_ASSIGN,
	EXPR_UPDATE,
	EXPR_CAST,
	EXPR_GROUP,
	EXPR_ARRAY_LITERAL,
	EXPR_IF,
	EXPR_WHEN,
	EXPR_INTERP,

	// Statements
	STMT_BLOCK,
	STMT_EXPR,
	STMT_VAR_DECL,
	STMT_IF,
	STMT_WHEN,
	STMT_WHILE,
	STMT_RETURN,
	STMT_BREAK,
	STMT_CONTINUE,
	STMT_FOR,
	STMT_YIELD,

	// Declarations
	DECL_MODULE,
	DECL_USE,
	DECL_FN,
	DECL_STRUCT,
	DECL_TRAIT,
	DECL_IMPL,
	DECL_ENUM,
	DECL_CONST,
	DECL_EXTERN_BLOCK,
	PROGRAM
}

pub struct AstNode {
	pub kind: NodeKind,
	pub line: usz,
	pub col: usz,
	pub data: *u8
}

pub struct DummyTemplateDecl {
	pub name: str,
	pub type_params_data: *u8,
	pub type_params_len: usz,
	pub type_params_cap: usz
}

impl AstNode {
	pub fn to<T>(val self) => self.data as *T;

	pub fn is_template(val self) => when (self.kind) {
		NodeKind.DECL_STRUCT -> self.to<DummyTemplateDecl>().type_params_len > 0;
		NodeKind.DECL_FN -> self.to<DummyTemplateDecl>().type_params_len > 0;
		NodeKind.DECL_IMPL -> self.to<DummyTemplateDecl>().type_params_len > 0;
		else -> false;
	};
}

impl Arena {
	pub fn alloc_node<T>(var self, kind: NodeKind, data: T, line: usz, col: usz): *AstNode {
		val data_ptr = self.alloc_val<T>(data);
		return self.alloc_val<AstNode>(AstNode(kind, line, col, data_ptr as *u8));
	}

	pub fn make<T>(var self, data: T, line: usz, col: usz) => self.alloc_node<T>(data.node_kind(), data, line, col);
}

