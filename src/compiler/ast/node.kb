mod compiler.ast.node;

use std.mem.arena.Arena;

pub enum NodeKind {
	// Syntactic Types
	TYPE_NAMED,
	TYPE_POINTER,
	TYPE_ARRAY,
	TYPE_NULLABLE,

	// Expressions
	EXPR_LITERAL,
	EXPR_IDENTIFIER,
	EXPR_BINARY,
	EXPR_UNARY,
	EXPR_CALL,
	EXPR_MEMBER,
	EXPR_INDEX,
	EXPR_ASSIGN,
	EXPR_UPDATE,
	EXPR_CAST,
	EXPR_GROUP,
	EXPR_ARRAY_LITERAL,
	EXPR_IF,
	EXPR_WHEN,
	EXPR_INTERP,

	// Statements
	STMT_BLOCK,
	STMT_EXPR,
	STMT_VAR_DECL,
	STMT_IF,
	STMT_WHEN,
	STMT_WHILE,
	STMT_RETURN,
	STMT_BREAK,
	STMT_CONTINUE,
	STMT_FOR,
	STMT_YIELD,
	STMT_DEFER,

	// Declarations
	DECL_MODULE,
	DECL_USE,
	DECL_FN,
	DECL_STRUCT,
	DECL_TRAIT,
	DECL_IMPL,
	DECL_ENUM,
	DECL_CONST,
	DECL_EXTERN_BLOCK,
	PROGRAM,
	EXPR_IS
}

pub struct AstNode {
	pub kind: NodeKind,
	pub line: usz,
	pub col: usz,
	pub data: *u8,
	// Resolved semantic type of an expression, filled in by sema and read by
	// codegen. Keeping it on the node means the backend never has to re-derive
	// a type from the node's shape or from variable names. Null on declarations
	// and on nodes that desugaring synthesises.
	pub resolved_type: *AstNode = null,
	// The same type as the compiler's own `*Type` (untyped here so `ast` stays a
	// leaf module). Passes that need struct fields, sizes or method tables read
	// this one; codegen keeps using `resolved_type`.
	pub sema_type: *u8 = null,
	// Method or operator the checker picked for this node (`*MethodInfo`, again
	// untyped). `lower` needs it to spell the C call without repeating the
	// overload/trait resolution the checker already did.
	pub resolved_method: *u8 = null,
	// A leaf the checker resolved directly: an enum member becomes an integer
	// literal, a struct constant becomes its mangled identifier. `lower` uses it
	// as the node's replacement.
	pub resolved_node: *AstNode = null
}

pub struct DummyTemplateDecl {
	pub name: str,
	pub type_params_data: *u8,
	pub type_params_len: usz,
	pub type_params_cap: usz
}

impl AstNode {
	pub fn to<T>(val self) => self.data as *T;

	pub fn is_template(val self) => when (self.kind) {
		NodeKind.DECL_STRUCT -> self.to<DummyTemplateDecl>().type_params_len > 0;
		NodeKind.DECL_FN -> self.to<DummyTemplateDecl>().type_params_len > 0;
		NodeKind.DECL_IMPL -> self.to<DummyTemplateDecl>().type_params_len > 0;
		else -> false;
	};
}

impl Arena {
	pub fn alloc_node<T>(var self, kind: NodeKind, data: T, line: usz, col: usz): *AstNode {
		val data_ptr = self.alloc_val<T>(data);
		return self.alloc_val<AstNode>(AstNode(kind, line, col, data_ptr as *u8));
	}

	pub fn make<T>(var self, kind: NodeKind, data: T, line: usz, col: usz) => self.alloc_node<T>(kind, data, line, col);
}
