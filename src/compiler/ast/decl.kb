mod compiler.ast.decl;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;
use std.collections.list.List;
use std.traits.iterable.Iterable;

pub struct ModuleDecl {
	pub const TAG = NodeKind.DECL_MODULE;
	pub path: List<str>,
	pub full_path: str
}

pub struct UseDecl {
	pub const TAG = NodeKind.DECL_USE;
	pub path: List<str>,
	pub full_path: str,
	pub symbol_name: str,
	pub alias: str,
	pub is_wildcard: bool
}

pub struct Param {
	pub name: str,
	pub type_node: *AstNode,
	pub is_mut: bool,
	pub has_val: bool,
	pub default_val: *AstNode = null
}

pub struct GenericParam {
	pub name: str,
	pub bounds: List<str>
}

pub struct FnDecl {
	pub const TAG = NodeKind.DECL_FN;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub params: List<Param>,
	pub return_type: *AstNode,
	pub body: *AstNode,
	pub is_pub: bool
}

pub struct StructField {
	pub name: str,
	pub type_node: *AstNode,
	pub is_pub: bool,
	pub default_val: *AstNode = null
}

pub struct StructDecl {
	pub const TAG = NodeKind.DECL_STRUCT;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub fields: List<StructField>,
	pub is_pub: bool
}

pub struct TraitDecl {
	pub const TAG = NodeKind.DECL_TRAIT;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub bases: List<str>,
	pub methods: List<*AstNode>,
	pub is_pub: bool
}

pub struct ImplDecl {
	pub const TAG = NodeKind.DECL_IMPL;
	pub struct_name: str,
	pub type_params: List<GenericParam>,
	pub trait_name: str,
	pub methods: List<*AstNode>
}

pub struct EnumMember {
	pub name: str,
	pub value: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct EnumDecl {
	pub const TAG = NodeKind.DECL_ENUM;
	pub name: str,
	pub underlying_type: *AstNode,
	pub members: List<EnumMember>,
	pub is_pub: bool
}

pub struct ConstDecl {
	pub const TAG = NodeKind.DECL_CONST;
	pub name: str,
	pub type_node: *AstNode,
	pub value: *AstNode,
	pub is_pub: bool
}

pub struct ExternBlock {
	pub const TAG = NodeKind.DECL_EXTERN_BLOCK;
	pub abi: str,
	pub declarations: List<*AstNode>
}

pub struct Program {
	pub const TAG = NodeKind.PROGRAM;
	pub declarations: List<*AstNode>
}

impl Program {
	pub fn declared_module_name(val self): str {
		for (decl in self.declarations) {
			when (decl) {
				is ModuleDecl as m -> return m.full_path;
			}
		}
		return "";
	}
}

impl Iterable for ExternBlock {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

impl Iterable for Program {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}
