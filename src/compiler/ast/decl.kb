mod compiler.ast;

use std.collections.List;
use std.traits.Iterable;

pub struct Param {
	pub name: str,
	pub type_node: *AstNode? = null,
	pub mutable: bool,
	pub has_val: bool,
	pub default_val: *AstNode? = null
}

pub struct GenericParam {
	pub name: str,
	pub bounds: List<str>
}

pub struct StructField {
	pub name: str,
	pub type_node: *AstNode,
	pub public: bool,
	pub default_val: *AstNode? = null
}

// One `type Name = Type;` binding in an impl of a trait with associated types.
pub struct AssocBinding {
	pub name: str,
	pub type_node: *AstNode
}

// One named field of an enum variant's payload: `Circle(radius: f64)`.
pub struct EnumField {
	pub name: str,
	pub type_node: *AstNode
}

pub struct EnumMember {
	pub name: str,
	pub value: *AstNode? = null,
	pub line: usz,
	pub col: usz,
	// Empty for a plain (integer) enum member; non-empty when the member carries
	// data, which makes the whole declaration a payload enum.
	pub payload: List<EnumField> = List()
}

impl Program {
	pub fn declared_module_name(val self): str {
		for (decl in self.declarations) if (decl is ModuleDecl) return decl.full_path;
		return "";
	}
}

impl Iterable for ExternBlock {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

impl Iterable for Program {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

// Whether a declaration carries generic parameters (`struct S<T>`, `fn f<T>`,
// `impl S<T>`). Lives here, next to the payload structs, so it reads their real
// fields instead of type-punning the node payload.
pub fn decl_is_template(node: *AstNode) => when (node) {
	is StructDecl as s -> s.type_params.len > 0;
	is FnDecl as f -> f.type_params.len > 0;
	is ImplDecl as i -> i.type_params.len > 0;
	else -> false;
};
