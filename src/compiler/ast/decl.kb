mod compiler.ast.decl;

use compiler.ast.node.AstNode;
use compiler.ast.node.NodeKind;
use std.collections.list.List;
use std.traits.iterable.Iterable;

pub struct ModuleDecl {
	pub path: List<str>,
	pub full_path: str
}

impl ModuleDecl {
	pub fn node_kind(val self) => NodeKind.DECL_MODULE;
}

pub struct UseDecl {
	pub path: List<str>,
	pub full_path: str,
	pub symbol_name: str,
	pub alias: str,
	pub is_wildcard: bool
}

impl UseDecl {
	pub fn node_kind(val self) => NodeKind.DECL_USE;
}

pub struct Param {
	pub name: str,
	pub type_node: *AstNode,
	pub is_mut: bool,
	pub has_val: bool
}

pub struct GenericParam {
	pub name: str,
	pub bounds: List<str>
}

pub struct FnDecl {
	pub name: str,
	pub type_params: List<GenericParam>,
	pub params: List<Param>,
	pub return_type: *AstNode,
	pub body: *AstNode,
	pub is_pub: bool
}

impl FnDecl {
	pub fn node_kind(val self) => NodeKind.DECL_FN;
}

pub struct StructField {
	pub name: str,
	pub type_node: *AstNode,
	pub is_pub: bool
}

pub struct StructDecl {
	pub name: str,
	pub type_params: List<GenericParam>,
	pub fields: List<StructField>,
	pub is_pub: bool
}

impl StructDecl {
	pub fn node_kind(val self) => NodeKind.DECL_STRUCT;
}

pub struct TraitDecl {
	pub name: str,
	pub type_params: List<GenericParam>,
	pub bases: List<str>,
	pub methods: List<*AstNode>,
	pub is_pub: bool
}

impl TraitDecl {
	pub fn node_kind(val self) => NodeKind.DECL_TRAIT;
}

pub struct ImplDecl {
	pub struct_name: str,
	pub type_params: List<GenericParam>,
	pub trait_name: str,
	pub methods: List<*AstNode>
}

impl ImplDecl {
	pub fn node_kind(val self) => NodeKind.DECL_IMPL;
}

pub struct EnumMember {
	pub name: str,
	pub value: *AstNode,
	pub line: usz,
	pub col: usz
}

pub struct EnumDecl {
	pub name: str,
	pub underlying_type: *AstNode,
	pub members: List<EnumMember>,
	pub is_pub: bool
}

impl EnumDecl {
	pub fn node_kind(val self) => NodeKind.DECL_ENUM;
}

pub struct ConstDecl {
	pub name: str,
	pub type_node: *AstNode,
	pub value: *AstNode,
	pub is_pub: bool
}

impl ConstDecl {
	pub fn node_kind(val self) => NodeKind.DECL_CONST;
}

pub struct ExternBlock {
	pub abi: str,
	pub declarations: List<*AstNode>
}

impl ExternBlock {
	pub fn node_kind(val self) => NodeKind.DECL_EXTERN_BLOCK;
}

pub struct Program {
	pub declarations: List<*AstNode>
}

impl Program {
	pub fn node_kind(val self) => NodeKind.PROGRAM;

	pub fn declared_module_name(val self): str {
		for (decl in self.declarations) {
			if (decl.kind == NodeKind.DECL_MODULE) return decl.to<ModuleDecl>().full_path;
		}
		return "";
	}
}

impl Iterable for ExternBlock {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

impl Iterable for Program {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}
