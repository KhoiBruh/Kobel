mod compiler.ast.decl;

use std.collections.list.List;
use std.traits.iterable.Iterable;

use compiler.ast.node.*;

pub struct ModuleDecl {
	pub const TAG = NodeKind.DECL_MODULE;
	pub path: List<str>,
	pub full_path: str
}

pub struct UseDecl {
	pub const TAG = NodeKind.DECL_USE;
	pub path: List<str>,
	pub full_path: str,
	pub symbol_name: str,
	pub alias: str,
	pub is_wildcard: bool
}

pub struct Param {
	pub name: str,
	pub type_node: *AstNode,
	pub is_mut: bool,
	pub has_val: bool,
	pub default_val: *AstNode = null
}

pub struct GenericParam {
	pub name: str,
	pub bounds: List<str>
}

pub struct FnDecl {
	pub const TAG = NodeKind.DECL_FN;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub params: List<Param>,
	pub return_type: *AstNode,
	pub body: *AstNode,
	pub is_pub: bool,
	pub is_op: bool = false,
	// Set on instantiated clones (monomorphization): the module the template was
	// declared in, so its body is checked with the right names in scope.
	pub module: str = ""
}

pub struct StructField {
	pub name: str,
	pub type_node: *AstNode,
	pub is_pub: bool,
	pub default_val: *AstNode = null
}

pub struct StructDecl {
	pub const TAG = NodeKind.DECL_STRUCT;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub fields: List<StructField>,
	pub is_pub: bool,
	// `struct A;` — declares the name without a body. The definition (`struct A
	// { ... }`) is merged into the same type during declaration collection.
	pub is_forward: bool = false,
	// False when a forward declaration already emitted this type's C typedef, so
	// the backend emits it exactly once.
	pub emit_typedef: bool = true
}

pub struct TraitDecl {
	pub const TAG = NodeKind.DECL_TRAIT;
	pub name: str,
	pub type_params: List<GenericParam>,
	pub bases: List<str>,
	pub methods: List<*AstNode>,
	pub is_pub: bool,
	// `type Item;` declarations: names only, the impl supplies the type.
	pub assoc_types: List<str> = List()
}

// One `type Name = Type;` binding in an impl of a trait with associated types.
pub struct AssocBinding {
	pub name: str,
	pub type_node: *AstNode
}

pub struct ImplDecl {
	pub const TAG = NodeKind.DECL_IMPL;
	pub struct_name: str,
	pub type_params: List<GenericParam>,
	pub trait_name: str,
	pub methods: List<*AstNode>,
	pub assoc_bindings: List<AssocBinding> = List()
}

// One named field of an enum variant's payload: `Circle(radius: f64)`.
pub struct EnumField {
	pub name: str,
	pub type_node: *AstNode
}

pub struct EnumMember {
	pub name: str,
	pub value: *AstNode,
	pub line: usz,
	pub col: usz,
	// Empty for a plain (integer) enum member; non-empty when the member carries
	// data, which makes the whole declaration a payload enum.
	pub payload: List<EnumField> = List()
}

pub struct EnumDecl {
	pub const TAG = NodeKind.DECL_ENUM;
	pub name: str,
	pub underlying_type: *AstNode,
	pub members: List<EnumMember>,
	pub is_pub: bool
}

pub struct ConstDecl {
	pub const TAG = NodeKind.DECL_CONST;
	pub name: str,
	pub type_node: *AstNode,
	pub value: *AstNode,
	pub is_pub: bool
}

pub struct ExternBlock {
	pub const TAG = NodeKind.DECL_EXTERN_BLOCK;
	pub abi: str,
	pub declarations: List<*AstNode>
}

pub struct Program {
	pub const TAG = NodeKind.PROGRAM;
	pub declarations: List<*AstNode>
}

impl Program {
	pub fn declared_module_name(val self): str {
		for (decl in self.declarations) if (decl is ModuleDecl) return decl.full_path;
		return "";
	}
}

impl Iterable for ExternBlock {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

impl Iterable for Program {
	pub fn count(val self) => self.declarations.len;
	pub fn at(val self, i: usz) => self.declarations[i];
}

// Whether a declaration carries generic parameters (`struct S<T>`, `fn f<T>`,
// `impl S<T>`). Lives here, next to the payload structs, so it reads their real
// fields instead of type-punning the node payload.
pub fn decl_is_template(node: *AstNode) => when (node.kind) {
	NodeKind.DECL_STRUCT -> node.as_struct_decl().type_params.len > 0;
	NodeKind.DECL_FN -> node.as_fn_decl().type_params.len > 0;
	NodeKind.DECL_IMPL -> node.as_impl_decl().type_params.len > 0;
	else -> false;
};
