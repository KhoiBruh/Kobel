mod compiler.ast;

/*
 * ============================================================================
 * compiler.ast.statement — Statement and node category predicates
 * ============================================================================
 */

impl AstNode {

	pub fn is_statement(*self) => when (self) {
		is BlockStmt, ExprStmt, VarDeclStmt, DestructDeclStmt,
		IfStmt, WhileStmt, ForStmt,
		ReturnStmt, BreakStmt, ContinueStmt,
		WhenStmt, YieldStmt, DeferStmt -> true;
		else -> false;
	};

	pub fn is_control_flow(*self) => when (self) {
		is ReturnStmt, BreakStmt, ContinueStmt,
		YieldStmt, BlockStmt -> true;
		else -> false;
	};

	pub fn is_declaration(*self) => when (self) {
		is ModuleDecl, UseDecl, FnDecl,
		StructDecl, TraitDecl, ImplDecl,
		EnumDecl, ConstDecl, ExternBlock,
		Program -> true;
		else -> false;
	};

	pub fn is_type_node(*self) => when (self) {
		is NamedType, PointerType, ArrayType, NullableType, VariadicType, FnType -> true;
		else -> false;
	};

	pub fn is_expression(*self) => !self.is_statement()
		&& !self.is_declaration()
		&& !self.is_type_node();

}
