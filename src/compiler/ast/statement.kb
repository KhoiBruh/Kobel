mod compiler.ast;

/*
 * ============================================================================
 * compiler.ast.statement — Statement and node category predicates
 * ============================================================================
 */

impl AstNode {

	pub fn is_statement(*self) => self is [
		BlockStmt, ExprStmt, VarDeclStmt, DestructDeclStmt,
		IfStmt, WhileStmt, ForStmt,
		ReturnStmt, BreakStmt, ContinueStmt,
		WhenStmt, YieldStmt, DeferStmt
	];

	pub fn is_control_flow(*self) => self is [
		ReturnStmt, BreakStmt, ContinueStmt,
		YieldStmt, BlockStmt
	];

	pub fn is_declaration(*self) => self is [
		ModuleDecl, UseDecl, FnDecl,
		StructDecl, TraitDecl, ImplDecl,
		EnumDecl, FaultDecl, ConstDecl, ExternBlock,
		Program
	];

	pub fn is_type_node(*self) => self is [
		NamedType, PointerType, ArrayType,
		VariadicType, FnType, ErrorUnionType
	];

	pub fn is_expression(*self) => !self.is_statement()
		&& !self.is_declaration()
		&& !self.is_type_node();

}
