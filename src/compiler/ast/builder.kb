mod compiler.ast;

use std.memory.Arena;
use std.collections.List;

use compiler.lexer.TokenType;

// ============================================================================
// Arena AST Extension Methods
// ============================================================================

impl Arena {
	// ------------------------------------------------------------------------
	// Types
	// ------------------------------------------------------------------------

	pub fn named_type(var self, name: str, type_args: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.NamedType(name, type_args), line, col);

	pub fn pointer_type(var self, mutable: bool, pointee: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.PointerType(mutable, pointee), line, col);

	pub fn array_type(var self, elem: *AstNode, size: usz, line: usz, col: usz)
		=> self.build_node(NodeData.ArrayType(elem, size), line, col);

	pub fn nullable_type(var self, inner_type: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.NullableType(inner_type), line, col);

	// ------------------------------------------------------------------------
	// Expressions
	// ------------------------------------------------------------------------

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz)
		=> self.build_node(NodeData.LiteralExpr(lk, raw), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz)
		=> self.build_node(NodeData.IdentifierExpr(name), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.BinaryExpr(left, op, right), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz, is_postfix: bool = false)
		=> self.build_node(NodeData.UnaryExpr(op, operand, is_postfix), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.CallExpr(callee, args, type_args), line, col);

	// A struct value built from its fields (`Point(1, 2)`), created by sema.
	pub fn struct_ctor(var self, c_name: str, args: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.StructCtorExpr(c_name, args), line, col);

	// A payload-enum value (`Shape.Circle(...)`), created by sema.
	pub fn enum_ctor(var self, c_name: str, tag_field: str, tag_value: i64, payload_path: str, args: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.EnumCtorExpr(c_name, tag_field, tag_value, payload_path, args), line, col);

	// `T.size()` in generic code, created by sema; the backend lowers it.
	pub fn size_of_param(var self, param_index: usz, size_text: str, line: usz, col: usz)
		=> self.build_node(NodeData.SizeOfParam(param_index, size_text), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz)
		=> self.build_node(NodeData.MemberExpr(obj, member, false), line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz)
		=> self.build_node(NodeData.MemberExpr(obj, member, true), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.IndexExpr(target, index), line, col);

	pub fn assign(var self, target: *AstNode, value: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.AssignExpr(target, TokenType.EQUAL, value), line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.AssignExpr(target, op, value), line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.UpdateExpr(op, target), line, col);

	pub fn cast(var self, expr: *AstNode? = null, target_type: *AstNode, line: usz = 0, col: usz = 0)
		=> self.build_node(NodeData.CastExpr(expr, target_type), line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.GroupExpr(expr), line, col);

	pub fn array_literal(var self, elements: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.ArrayLiteralExpr(elements, "", null), line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode? = null, line: usz = 0, col: usz = 0)
		=> self.build_node(NodeData.ArrayLiteralExpr(elements, list_struct_name, elem_type_node), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.IfExpr(condition, then_branch, else_branch), line, col);

	pub fn when_expr(var self, condition: *AstNode?, arms: List<WhenArm>, line: usz, col: usz)
		=> self.build_node(NodeData.WhenExpr(condition, arms), line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz)
		=> self.build_node(NodeData.InterpExpr(parts), line, col);

	pub fn is_expr(var self, expr: *AstNode? = null, target_type: *AstNode, line: usz = 0, col: usz = 0)
		=> self.build_node(NodeData.IsExpr(expr, target_type, "", "", "", false, false, "", false, ""), line, col);

	// ------------------------------------------------------------------------
	// Statements
	// ------------------------------------------------------------------------

	pub fn block_stmt(var self, statements: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.BlockStmt(statements), line, col);

	pub fn expr_stmt(var self, expr: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.ExprStmt(expr), line, col);

	pub fn var_decl(var self, mutable: bool, name: str, type_annotation: *AstNode?, initializer: *AstNode?, line: usz, col: usz)
		=> self.build_node(NodeData.VarDeclStmt(mutable, name, type_annotation, initializer), line, col);

	pub fn if_stmt(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode?, line: usz, col: usz)
		=> self.build_node(NodeData.IfStmt(condition, then_branch, else_branch), line, col);

	pub fn while_stmt(var self, condition: *AstNode, body: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.WhileStmt(condition, body), line, col);

	pub fn for_stmt(var self, var_name: str, is_range: bool, is_open: bool, is_half_open: bool, iterable: *AstNode?, range_start: *AstNode?, range_end: *AstNode?, body: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.ForStmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body), line, col);

	pub fn return_stmt(var self, value: *AstNode?, line: usz, col: usz)
		=> self.build_node(NodeData.ReturnStmt(value), line, col);

	pub fn break_stmt(var self, line: usz, col: usz)
		=> self.build_node(NodeData.BreakStmt, line, col);

	pub fn continue_stmt(var self, line: usz, col: usz)
		=> self.build_node(NodeData.ContinueStmt, line, col);

	pub fn when_stmt(var self, condition: *AstNode?, arms: List<WhenStmtArm>, line: usz, col: usz)
		=> self.build_node(NodeData.WhenStmt(condition, arms), line, col);

	pub fn yield_stmt(var self, value: *AstNode?, line: usz, col: usz)
		=> self.build_node(NodeData.YieldStmt(value), line, col);

	pub fn defer_stmt(var self, body: *AstNode, line: usz, col: usz)
		=> self.build_node(NodeData.DeferStmt(body), line, col);

	// ------------------------------------------------------------------------
	// Declarations
	// ------------------------------------------------------------------------

	pub fn module_decl(var self, path: List<str>, full_path: str, line: usz, col: usz)
		=> self.build_node(NodeData.ModuleDecl(path, full_path), line, col);

	pub fn use_decl(var self, path: List<str>, full_path: str, symbol_name: str, alias: str, wildcard: bool, line: usz, col: usz)
		=> self.build_node(NodeData.UseDecl(path, full_path, symbol_name, alias, wildcard), line, col);

	pub fn fn_decl(var self, name: str, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode? = null, body: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0, operator: bool = false, initializer: bool = false)
		=> self.build_node(NodeData.FnDecl(self.create_val(FnDecl(name, type_params, params, return_type, body, public, operator, initializer))), line, col);

	pub fn init_decl(var self, type_params: List<GenericParam>, params: List<Param>, return_type: *AstNode? = null, body: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0)
		=> self.fn_decl("init", type_params, params, return_type, body, public, line, col, false, true);

	pub fn struct_decl(var self, name: str, type_params: List<GenericParam>, fields: List<StructField>, public: bool, line: usz, col: usz)
		=> self.build_node(NodeData.StructDecl(name, type_params, fields, public, false, true), line, col);

	// `struct Name;` — an opaque declaration whose definition may follow later.
	pub fn struct_decl_forward(var self, name: str, type_params: List<GenericParam>, public: bool, line: usz, col: usz)
		=> self.build_node(NodeData.StructDecl(name, type_params, List<StructField>(), public, true, true), line, col);

	pub fn trait_decl(var self, name: str, type_params: List<GenericParam>, bases: List<str>, methods: List<*AstNode>, public: bool, line: usz, col: usz, assoc_types: List<str> = List())
		=> self.build_node(NodeData.TraitDecl(name, type_params, bases, methods, public, assoc_types), line, col);

	pub fn impl_decl(var self, struct_name: str, type_params: List<GenericParam>, trait_name: str, methods: List<*AstNode>, line: usz, col: usz, assoc_bindings: List<AssocBinding> = List())
		=> self.build_node(NodeData.ImplDecl(struct_name, type_params, trait_name, methods, assoc_bindings), line, col);

	pub fn enum_decl(var self, name: str, underlying_type: *AstNode? = null, members: List<EnumMember> = List(), public: bool = false, line: usz = 0, col: usz = 0)
		=> self.build_node(NodeData.EnumDecl(name, underlying_type, members, public), line, col);

	pub fn const_decl(var self, name: str, type_node: *AstNode? = null, value: *AstNode? = null, public: bool = false, line: usz = 0, col: usz = 0)
		=> self.build_node(NodeData.ConstDecl(name, type_node, value, public), line, col);

	pub fn extern_block(var self, abi: str, declarations: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.ExternBlock(abi, declarations), line, col);

	pub fn program(var self, declarations: List<*AstNode>, line: usz, col: usz)
		=> self.build_node(NodeData.Program(declarations), line, col);
}
