	raw: str,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<LiteralExpr>(arena);
	*ptr = LiteralExpr(lk, raw);
	return alloc_node(arena, NodeKind.EXPR_LITERAL, line, col, ptr as *u8);
}

