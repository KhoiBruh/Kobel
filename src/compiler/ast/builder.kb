	pub fn trait_decl(
		var self: &AstBuilder,
		name: str,
		type_params: List<GenericParam>,
		bases: List<str>,
		methods: List<*AstNode>,
		is_pub: bool,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<TraitDecl>(self.arena);
		*ptr = TraitDecl(name, type_params, bases, methods, is_pub);
		return self.node(NodeKind.DECL_TRAIT, line, col, ptr as *u8);
