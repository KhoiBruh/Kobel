	val ptr = arena_alloc<VarDeclStmt>(arena);
	*ptr = VarDeclStmt(is_mut, name, type_annotation, initializer);
	return alloc_node(arena, NodeKind.STMT_VAR_DECL, line, col, ptr as *u8);
}

