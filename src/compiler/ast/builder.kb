	val ptr = arena_alloc<IdentifierExpr>(arena);
	*ptr = IdentifierExpr(name);
	return alloc_node(arena, NodeKind.EXPR_IDENTIFIER, line, col, ptr as *u8);
}

pub fn alloc_binary(
	var arena: &Arena,
