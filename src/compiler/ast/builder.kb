pub fn as_group(node: *AstNode): *GroupExpr => node.as_group();
pub fn as_array_literal(node: *AstNode): *ArrayLiteralExpr => node.as_array_literal();
pub fn as_if_expr(node: *AstNode): *IfExpr => node.as_if_expr();
pub fn as_when_expr(node: *AstNode): *WhenExpr => node.as_when_expr();
pub fn as_interp(node: *AstNode): *InterpExpr => node.as_interp();

pub fn as_block_stmt(node: *AstNode): *BlockStmt => node.as_block_stmt();
pub fn as_expr_stmt(node: *AstNode): *ExprStmt => node.as_expr_stmt();
pub fn as_var_decl(node: *AstNode): *VarDeclStmt => node.as_var_decl();
pub fn as_if_stmt(node: *AstNode): *IfStmt => node.as_if_stmt();
pub fn as_while_stmt(node: *AstNode): *WhileStmt => node.as_while_stmt();
pub fn as_for_stmt(node: *AstNode): *ForStmt => node.as_for_stmt();
pub fn as_return_stmt(node: *AstNode): *ReturnStmt => node.as_return_stmt();
pub fn as_break_stmt(node: *AstNode): *BreakStmt => node.as_break_stmt();
pub fn as_continue_stmt(node: *AstNode): *ContinueStmt => node.as_continue_stmt();
pub fn as_when_stmt(node: *AstNode): *WhenStmt => node.as_when_stmt();

pub fn as_fn_decl(node: *AstNode): *FnDecl => node.as_fn_decl();
pub fn as_struct_decl(node: *AstNode): *StructDecl => node.as_struct_decl();
pub fn as_trait_decl(node: *AstNode): *TraitDecl => node.as_trait_decl();
pub fn as_impl_decl(node: *AstNode): *ImplDecl => node.as_impl_decl();
pub fn as_enum_decl(node: *AstNode): *EnumDecl => node.as_enum_decl();
pub fn as_const_decl(node: *AstNode): *ConstDecl => node.as_const_decl();
pub fn as_module_decl(node: *AstNode): *ModuleDecl => node.as_module_decl();
pub fn as_use_decl(node: *AstNode): *UseDecl => node.as_use_decl();
pub fn as_extern_block(node: *AstNode): *ExternBlock => node.as_extern_block();
pub fn as_program(node: *AstNode): *Program => node.as_program();
