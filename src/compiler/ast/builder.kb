// ----------------------------------------------------------------------------
// Declaration Allocators
// ----------------------------------------------------------------------------

pub fn alloc_module_decl(
	var arena: &Arena,
	path: List<str>,
	full_path: str,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<ModuleDecl>(arena);
	*ptr = ModuleDecl(path, full_path);
	return alloc_node(arena, NodeKind.DECL_MODULE, line, col, ptr as *u8);
}

pub fn alloc_use_decl(
	var arena: &Arena,
	path: List<str>,
	full_path: str,
	symbol_name: str,
	alias: str,
	is_wildcard: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<UseDecl>(arena);
	*ptr = UseDecl(path, full_path, symbol_name, alias, is_wildcard);
	return alloc_node(arena, NodeKind.DECL_USE, line, col, ptr as *u8);
}

pub fn alloc_fn_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	params: List<Param>,
	return_type: *AstNode,
	body: *AstNode,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<FnDecl>(arena);
	*ptr = FnDecl(name, type_params, params, return_type, body, is_pub);
	return alloc_node(arena, NodeKind.DECL_FN, line, col, ptr as *u8);
}

pub fn alloc_struct_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	fields: List<StructField>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<StructDecl>(arena);
	*ptr = StructDecl(name, type_params, fields, is_pub);
	return alloc_node(arena, NodeKind.DECL_STRUCT, line, col, ptr as *u8);
}

pub fn alloc_trait_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	bases: List<str>,
	methods: List<*AstNode>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<TraitDecl>(arena);
	*ptr = TraitDecl(name, type_params, bases, methods, is_pub);
	return alloc_node(arena, NodeKind.DECL_TRAIT, line, col, ptr as *u8);
}

pub fn alloc_impl_decl(
	var arena: &Arena,
	struct_name: str,
	type_params: List<GenericParam>,
	trait_name: str,
	methods: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<ImplDecl>(arena);
	*ptr = ImplDecl(struct_name, type_params, trait_name, methods);
	return alloc_node(arena, NodeKind.DECL_IMPL, line, col, ptr as *u8);
}

pub fn alloc_enum_decl(
	var arena: &Arena,
	name: str,
	underlying_type: *AstNode,
	members: List<EnumMember>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<EnumDecl>(arena);
	*ptr = EnumDecl(name, underlying_type, members, is_pub);
	return alloc_node(arena, NodeKind.DECL_ENUM, line, col, ptr as *u8);
}

pub fn alloc_const_decl(
	var arena: &Arena,
	name: str,
	type_node: *AstNode,
	value: *AstNode,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<ConstDecl>(arena);
	*ptr = ConstDecl(name, type_node, value, is_pub);
	return alloc_node(arena, NodeKind.DECL_CONST, line, col, ptr as *u8);
}

pub fn alloc_extern_block(
	var arena: &Arena,
	abi: str,
	declarations: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<ExternBlock>(arena);
	*ptr = ExternBlock(abi, declarations);
	return alloc_node(arena, NodeKind.DECL_EXTERN_BLOCK, line, col, ptr as *u8);
}

pub fn alloc_program(
	var arena: &Arena,
	declarations: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<Program>(arena);
	*ptr = Program(declarations);
	return alloc_node(arena, NodeKind.PROGRAM, line, col, ptr as *u8);
}

// ============================================================================
// Downcast Helper Functions (as<T>)
// ============================================================================

pub fn as_named_type(node: *AstNode): *NamedType => node.data as *NamedType;
pub fn as_pointer_type(node: *AstNode): *PointerType => node.data as *PointerType;
pub fn as_array_type(node: *AstNode): *ArrayType => node.data as *ArrayType;

pub fn as_literal(node: *AstNode): *LiteralExpr => node.data as *LiteralExpr;
pub fn as_identifier(node: *AstNode): *IdentifierExpr => node.data as *IdentifierExpr;
pub fn as_binary(node: *AstNode): *BinaryExpr => node.data as *BinaryExpr;
pub fn as_unary(node: *AstNode): *UnaryExpr => node.data as *UnaryExpr;
pub fn as_call(node: *AstNode): *CallExpr => node.data as *CallExpr;
pub fn as_member(node: *AstNode): *MemberExpr => node.data as *MemberExpr;
pub fn as_index(node: *AstNode): *IndexExpr => node.data as *IndexExpr;
pub fn as_assign(node: *AstNode): *AssignExpr => node.data as *AssignExpr;
pub fn as_cast(node: *AstNode): *CastExpr => node.data as *CastExpr;
pub fn as_group(node: *AstNode): *GroupExpr => node.data as *GroupExpr;
pub fn as_array_literal(node: *AstNode): *ArrayLiteralExpr => node.data as *ArrayLiteralExpr;
pub fn as_if_expr(node: *AstNode): *IfExpr => node.data as *IfExpr;
pub fn as_when_expr(node: *AstNode): *WhenExpr => node.data as *WhenExpr;

pub fn as_block_stmt(node: *AstNode): *BlockStmt => node.data as *BlockStmt;
pub fn as_expr_stmt(node: *AstNode): *ExprStmt => node.data as *ExprStmt;
pub fn as_var_decl(node: *AstNode): *VarDeclStmt => node.data as *VarDeclStmt;
pub fn as_if_stmt(node: *AstNode): *IfStmt => node.data as *IfStmt;
pub fn as_while_stmt(node: *AstNode): *WhileStmt => node.data as *WhileStmt;
pub fn as_return_stmt(node: *AstNode): *ReturnStmt => node.data as *ReturnStmt;
pub fn as_break_stmt(node: *AstNode): *BreakStmt => node.data as *BreakStmt;
pub fn as_continue_stmt(node: *AstNode): *ContinueStmt => node.data as *ContinueStmt;
pub fn as_when_stmt(node: *AstNode): *WhenStmt => node.data as *WhenStmt;

pub fn as_fn_decl(node: *AstNode): *FnDecl => node.data as *FnDecl;
pub fn as_struct_decl(node: *AstNode): *StructDecl => node.data as *StructDecl;
pub fn as_trait_decl(node: *AstNode): *TraitDecl => node.data as *TraitDecl;
pub fn as_impl_decl(node: *AstNode): *ImplDecl => node.data as *ImplDecl;
pub fn as_enum_decl(node: *AstNode): *EnumDecl => node.data as *EnumDecl;
pub fn as_const_decl(node: *AstNode): *ConstDecl => node.data as *ConstDecl;
pub fn as_module_decl(node: *AstNode): *ModuleDecl => node.data as *ModuleDecl;
pub fn as_use_decl(node: *AstNode): *UseDecl => node.data as *UseDecl;
pub fn as_extern_block(node: *AstNode): *ExternBlock => node.data as *ExternBlock;
pub fn as_program(node: *AstNode): *Program => node.data as *Program;
