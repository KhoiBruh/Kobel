	// ------------------------------------------------------------------------
	// Declarations
	// ------------------------------------------------------------------------

	pub fn module_decl(
		var self: &AstBuilder,
		path: List<str>,
		full_path: str,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<ModuleDecl>(self.arena);
		*ptr = ModuleDecl(path, full_path);
		return self.node(NodeKind.DECL_MODULE, line, col, ptr as *u8);
	}

	pub fn use_decl(
		var self: &AstBuilder,
		path: List<str>,
		full_path: str,
		symbol_name: str,
		alias: str,
		is_wildcard: bool,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<UseDecl>(self.arena);
		*ptr = UseDecl(path, full_path, symbol_name, alias, is_wildcard);
		return self.node(NodeKind.DECL_USE, line, col, ptr as *u8);
