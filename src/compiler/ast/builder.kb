mod compiler.ast.builder;

use compiler.ast.node.*;
use compiler.ast.types.*;
use compiler.ast.expr.*;
use compiler.ast.stmt.*;
use compiler.ast.decl.*;

use compiler.lexer.token.TokenType;
use std.collections.list.List;
use std.mem.arena.Arena;

// ============================================================================
// Node Allocator Helpers
// ============================================================================

pub fn alloc_node(
	var arena: &Arena,
	kind: NodeKind,
	line: usz,
	col: usz,
	data: *u8
): *AstNode {
	val ptr = arena_alloc<AstNode>(arena);
	*ptr = AstNode(kind, line, col, data);
	return ptr;
}

// ----------------------------------------------------------------------------
// Type Allocators
// ----------------------------------------------------------------------------

pub fn alloc_named_type(
	var arena: &Arena,
	name: str,
	type_args: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<NamedType>(arena);
	*ptr = NamedType(name, type_args);
	return alloc_node(arena, NodeKind.TYPE_NAMED, line, col, ptr as *u8);
}

pub fn alloc_pointer_type(
	var arena: &Arena,
	is_mut: bool,
	pointee: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<PointerType>(arena);
	*ptr = PointerType(is_mut, pointee);
	return alloc_node(arena, NodeKind.TYPE_POINTER, line, col, ptr as *u8);
}

pub fn alloc_array_type(
	var arena: &Arena,
	elem: *AstNode,
	size: usz,
	line: usz,
	col: usz
): *AstNode {
	val ptr = arena_alloc<ArrayType>(arena);
	*ptr = ArrayType(elem, size);
	return alloc_node(arena, NodeKind.TYPE_ARRAY, line, col, ptr as *u8);
}

