	): *AstNode {
		val ptr = arena_alloc<ContinueStmt>(self.arena);
		*ptr = ContinueStmt(0);
		return self.node(NodeKind.STMT_CONTINUE, line, col, ptr as *u8);
	}

	pub fn when_stmt(
		var self: &AstBuilder,
		condition: *AstNode,
		arms: List<WhenStmtArm>,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<WhenStmt>(self.arena);
		*ptr = WhenStmt(condition, arms);
		return self.node(NodeKind.STMT_WHEN, line, col, ptr as *u8);
