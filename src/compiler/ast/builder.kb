	pub fn for_stmt(
		var self: &AstBuilder,
		var_name: str,
		is_range: bool,
		is_open: bool,
		is_half_open: bool,
		iterable: *AstNode,
		range_start: *AstNode,
		range_end: *AstNode,
		body: *AstNode,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<ForStmt>(self.arena);
		*ptr = ForStmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body);
		return self.node(NodeKind.STMT_FOR, line, col, ptr as *u8);
	}

	pub fn return_stmt(
		var self: &AstBuilder,
		value: *AstNode,
		line: usz,
