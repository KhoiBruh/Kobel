	pub fn fn_decl(
		var self: &AstBuilder,
		name: str,
		type_params: List<GenericParam>,
		params: List<Param>,
		return_type: *AstNode,
		body: *AstNode,
		is_pub: bool,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<FnDecl>(self.arena);
		*ptr = FnDecl(name, type_params, params, return_type, body, is_pub);
		return self.node(NodeKind.DECL_FN, line, col, ptr as *u8);
	}

	pub fn struct_decl(
		var self: &AstBuilder,
		name: str,
		type_params: List<GenericParam>,
		fields: List<StructField>,
		is_pub: bool,
		line: usz,
		col: usz
	): *AstNode {
		val ptr = arena_alloc<StructDecl>(self.arena);
		*ptr = StructDecl(name, type_params, fields, is_pub);
		return self.node(NodeKind.DECL_STRUCT, line, col, ptr as *u8);
