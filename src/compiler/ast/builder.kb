mod compiler.ast;

use std.memory.Arena;
use std.collections.List;

use compiler.lexer.TokenType;

// ============================================================================
// Arena AST Extension Methods
// ============================================================================

impl Arena {
	// ------------------------------------------------------------------------
	// Expressions
	// ------------------------------------------------------------------------

	pub fn literal(var self, lk: LiteralKind, raw: str, line: usz, col: usz)
		=> self.node(NodeData.LiteralExpr(lk, raw), line, col);

	pub fn identifier(var self, name: str, line: usz, col: usz)
		=> self.node(NodeData.IdentifierExpr(name), line, col);

	pub fn binary(var self, op: TokenType, left: *AstNode, right: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.BinaryExpr(left, op, right), line, col);

	pub fn unary(var self, op: TokenType, operand: *AstNode, line: usz, col: usz, is_postfix: bool = false)
		=> self.node(NodeData.UnaryExpr(op, operand, is_postfix), line, col);

	pub fn call(var self, callee: *AstNode, args: List<*AstNode>, type_args: List<*AstNode>, line: usz, col: usz)
		=> self.node(NodeData.CallExpr(callee, args, type_args), line, col);

	pub fn member(var self, obj: *AstNode, member: str, line: usz, col: usz)
		=> self.node(NodeData.MemberExpr(obj, member, false), line, col);

	pub fn safe_member(var self, obj: *AstNode, member: str, line: usz, col: usz)
		=> self.node(NodeData.MemberExpr(obj, member, true), line, col);

	pub fn index(var self, target: *AstNode, index: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.IndexExpr(target, index), line, col);

	pub fn assign(var self, target: *AstNode, value: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.AssignExpr(target, TokenType.EQUAL, value), line, col);

	pub fn compound_assign(var self, op: TokenType, target: *AstNode, value: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.AssignExpr(target, op, value), line, col);

	pub fn update(var self, op: TokenType, target: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.UpdateExpr(op, target), line, col);

	pub fn cast(var self, expr: *AstNode? = null, target_type: *AstNode, line: usz = 0, col: usz = 0)
		=> self.node(NodeData.CastExpr(expr, target_type), line, col);

	pub fn group(var self, expr: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.GroupExpr(expr), line, col);

	pub fn array_literal(var self, elements: List<*AstNode>, line: usz, col: usz)
		=> self.node(NodeData.ArrayLiteralExpr(elements, "", null), line, col);

	pub fn list_literal(var self, elements: List<*AstNode>, list_struct_name: str, elem_type_node: *AstNode? = null, line: usz = 0, col: usz = 0)
		=> self.node(NodeData.ArrayLiteralExpr(elements, list_struct_name, elem_type_node), line, col);

	pub fn if_expr(var self, condition: *AstNode, then_branch: *AstNode, else_branch: *AstNode, line: usz, col: usz)
		=> self.node(NodeData.IfExpr(condition, then_branch, else_branch), line, col);

	pub fn when_expr(var self, condition: *AstNode?, arms: List<WhenArm>, line: usz, col: usz)
		=> self.node(NodeData.WhenExpr(condition, arms), line, col);

	pub fn interp(var self, parts: List<InterpPart>, line: usz, col: usz)
		=> self.node(NodeData.InterpExpr(parts), line, col);

	pub fn is_expr(var self, expr: *AstNode? = null, target_type: *AstNode, line: usz = 0, col: usz = 0)
		=> self.node(NodeData.IsExpr(expr, target_type, "", "", "", false, false, "", false, ""), line, col);
}
