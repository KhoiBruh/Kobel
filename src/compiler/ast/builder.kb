	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.while_stmt(condition, body, line, col);
}

pub fn alloc_for_stmt(
	var arena: &Arena,
	var_name: str,
	is_range: bool,
	is_open: bool,
	is_half_open: bool,
	iterable: *AstNode,
	range_start: *AstNode,
	range_end: *AstNode,
	body: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.for_stmt(var_name, is_range, is_open, is_half_open, iterable, range_start, range_end, body, line, col);
}

pub fn alloc_return_stmt(
	var arena: &Arena,
	value: *AstNode,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.return_stmt(value, line, col);
}

pub fn alloc_break_stmt(
	var arena: &Arena,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.break_stmt(line, col);
}

pub fn alloc_continue_stmt(
	var arena: &Arena,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.continue_stmt(line, col);
}

pub fn alloc_when_stmt(
	var arena: &Arena,
	condition: *AstNode,
	arms: List<WhenStmtArm>,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.when_stmt(condition, arms, line, col);
}

pub fn alloc_module_decl(
	var arena: &Arena,
	path: List<str>,
	full_path: str,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.module_decl(path, full_path, line, col);
}

pub fn alloc_use_decl(
	var arena: &Arena,
	path: List<str>,
	full_path: str,
	symbol_name: str,
	alias: str,
	is_wildcard: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.use_decl(path, full_path, symbol_name, alias, is_wildcard, line, col);
}

pub fn alloc_fn_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	params: List<Param>,
	return_type: *AstNode,
	body: *AstNode,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.fn_decl(name, type_params, params, return_type, body, is_pub, line, col);
}

pub fn alloc_struct_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	fields: List<StructField>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.struct_decl(name, type_params, fields, is_pub, line, col);
}

pub fn alloc_trait_decl(
	var arena: &Arena,
	name: str,
	type_params: List<GenericParam>,
	bases: List<str>,
	methods: List<*AstNode>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.trait_decl(name, type_params, bases, methods, is_pub, line, col);
}

pub fn alloc_impl_decl(
	var arena: &Arena,
	struct_name: str,
	type_params: List<GenericParam>,
	trait_name: str,
	methods: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.impl_decl(struct_name, type_params, trait_name, methods, line, col);
}

pub fn alloc_enum_decl(
	var arena: &Arena,
	name: str,
	underlying_type: *AstNode,
	members: List<EnumMember>,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.enum_decl(name, underlying_type, members, is_pub, line, col);
}

pub fn alloc_const_decl(
	var arena: &Arena,
	name: str,
	type_node: *AstNode,
	value: *AstNode,
	is_pub: bool,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.const_decl(name, type_node, value, is_pub, line, col);
}

pub fn alloc_extern_block(
	var arena: &Arena,
	abi: str,
	declarations: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.extern_block(abi, declarations, line, col);
}

pub fn alloc_program(
	var arena: &Arena,
	declarations: List<*AstNode>,
	line: usz,
	col: usz
): *AstNode {
	var b = AstBuilder(arena);
	return b.program(declarations, line, col);
}

// ============================================================================
// AstNode Downcast Methods (impl AstNode)
// ============================================================================

impl AstNode {
	pub fn as_named_type(val self): *NamedType => self.data as *NamedType;
	pub fn as_pointer_type(val self): *PointerType => self.data as *PointerType;
	pub fn as_array_type(val self): *ArrayType => self.data as *ArrayType;

	pub fn as_literal(val self): *LiteralExpr => self.data as *LiteralExpr;
	pub fn as_identifier(val self): *IdentifierExpr => self.data as *IdentifierExpr;
	pub fn as_binary(val self): *BinaryExpr => self.data as *BinaryExpr;
	pub fn as_unary(val self): *UnaryExpr => self.data as *UnaryExpr;
	pub fn as_call(val self): *CallExpr => self.data as *CallExpr;
	pub fn as_member(val self): *MemberExpr => self.data as *MemberExpr;
	pub fn as_index(val self): *IndexExpr => self.data as *IndexExpr;
	pub fn as_assign(val self): *AssignExpr => self.data as *AssignExpr;
	pub fn as_cast(val self): *CastExpr => self.data as *CastExpr;
	pub fn as_group(val self): *GroupExpr => self.data as *GroupExpr;
	pub fn as_array_literal(val self): *ArrayLiteralExpr => self.data as *ArrayLiteralExpr;
	pub fn as_if_expr(val self): *IfExpr => self.data as *IfExpr;
	pub fn as_when_expr(val self): *WhenExpr => self.data as *WhenExpr;
	pub fn as_interp(val self): *InterpExpr => self.data as *InterpExpr;

	pub fn as_block_stmt(val self): *BlockStmt => self.data as *BlockStmt;
	pub fn as_expr_stmt(val self): *ExprStmt => self.data as *ExprStmt;
	pub fn as_var_decl(val self): *VarDeclStmt => self.data as *VarDeclStmt;
	pub fn as_if_stmt(val self): *IfStmt => self.data as *IfStmt;
	pub fn as_while_stmt(val self): *WhileStmt => self.data as *WhileStmt;
	pub fn as_for_stmt(val self): *ForStmt => self.data as *ForStmt;
	pub fn as_return_stmt(val self): *ReturnStmt => self.data as *ReturnStmt;
	pub fn as_break_stmt(val self): *BreakStmt => self.data as *BreakStmt;
	pub fn as_continue_stmt(val self): *ContinueStmt => self.data as *ContinueStmt;
	pub fn as_when_stmt(val self): *WhenStmt => self.data as *WhenStmt;

	pub fn as_fn_decl(val self): *FnDecl => self.data as *FnDecl;
	pub fn as_struct_decl(val self): *StructDecl => self.data as *StructDecl;
	pub fn as_trait_decl(val self): *TraitDecl => self.data as *TraitDecl;
	pub fn as_impl_decl(val self): *ImplDecl => self.data as *ImplDecl;
	pub fn as_enum_decl(val self): *EnumDecl => self.data as *EnumDecl;
	pub fn as_const_decl(val self): *ConstDecl => self.data as *ConstDecl;
	pub fn as_module_decl(val self): *ModuleDecl => self.data as *ModuleDecl;
	pub fn as_use_decl(val self): *UseDecl => self.data as *UseDecl;
	pub fn as_extern_block(val self): *ExternBlock => self.data as *ExternBlock;
	pub fn as_program(val self): *Program => self.data as *Program;
}

// ============================================================================
// Standalone Downcast Helper Functions (forwarding to node.as_*())
// ============================================================================

pub fn as_named_type(node: *AstNode): *NamedType => node.as_named_type();
pub fn as_pointer_type(node: *AstNode): *PointerType => node.as_pointer_type();
pub fn as_array_type(node: *AstNode): *ArrayType => node.as_array_type();

pub fn as_literal(node: *AstNode): *LiteralExpr => node.as_literal();
pub fn as_identifier(node: *AstNode): *IdentifierExpr => node.as_identifier();
