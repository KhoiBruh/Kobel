mod config;

use std.io.*;
use std.filesystem.*;

// ============================================================================
// Mini-TOML Parser and Project Configuration
//
// Parses a lightweight subset of TOML sufficient for project manifests
// like `kobel.toml`:
//   [section]
//   key = "value"
//   key = value
// ============================================================================

pub struct ProjectConfig {
	pub name: str = "kobel",
	pub version: str = "1.0.0",
	pub entry: str = "src/main.kb",
	pub output: str = "build/kobel.exe",
	pub cc: str = "cl",
	pub test_dir: str = "tests"
}

impl ProjectConfig {

	pub init(manifest_path: str) {
		var self = Self();
		val manifest_p = Path(manifest_path);
		if (!manifest_p.exists()) return self;

		val content = manifest_p.read_text();
		if (content.empty()) return self;

		val doc = Toml(content);

		var package_entry = "";
		var build_entry = "";
		for ((key, val_str) in doc) {
			if (val_str.empty()) continue;
			when (key) {
				"package.name" -> self.name = val_str;
				"package.version" -> self.version = val_str;
				"package.entry" -> package_entry = val_str;
				"build.entry" -> build_entry = val_str;
				"build.output" -> self.output = val_str;
				"build.cc" -> self.cc = val_str;
				"test.dir" -> self.test_dir = val_str;
			}
		}
		if (!package_entry.empty()) self.entry = package_entry;
		else if (!build_entry.empty()) self.entry = build_entry;

		return self;
	}

}
