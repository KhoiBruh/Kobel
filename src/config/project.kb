mod config;

use std.io.*;
use std.filesystem.*;

// ============================================================================
// Mini-TOML Parser and Project Configuration
//
// Parses a lightweight subset of TOML sufficient for project manifests
// like `kobel.toml`:
//   [section]
//   key = "value"
//   key = value
// ============================================================================

pub struct ProjectConfig {
	pub name: str = "kobel",
	pub version: str = "1.0.0",
	pub entry: str = "src/main.kb",
	pub output: str = "build/kobel.exe",
	pub cc: str = "cl",
	pub test_dir: str = "tests"
}

impl ProjectConfig {

	pub init(manifest_path: str) {
		var self = Self();
		val manifest_p = Path(manifest_path);
		if (!manifest_p.exists()) return self;

		val content = manifest_p.read_text();
		if (content.empty()) return self;

		val doc = Toml(content);

		val name = doc["package.name"];
		if (!name.empty()) self.name = name;

		val ver = doc["package.version"];
		if (!ver.empty()) self.version = ver;

		val entry = doc.get("package.entry", doc["build.entry"]);
		if (!entry.empty()) self.entry = entry;

		val output = doc["build.output"];
		if (!output.empty()) self.output = output;

		val cc = doc["build.cc"];
		if (!cc.empty()) self.cc = cc;

		val test_dir = doc["test.dir"];
		if (!test_dir.empty()) self.test_dir = test_dir;

		return self;
	}

}
