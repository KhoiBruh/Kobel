mod config.project;

use std.io.*;
use std.collections.list.List;
use std.collections.hash_map.HashMap;
use util.strutil.*;

// ============================================================================
// Mini-TOML Parser and Project Configuration
//
// Parses a lightweight subset of TOML sufficient for project manifests
// like `kobel.toml`:
//   [section]
//   key = "value"
//   key = value
// ============================================================================

pub struct TomlDoc {
	pub entries: HashMap<str> = HashMap()
}

impl TomlDoc {
	pub fn get(val self, key: str, default_val: str) => self.entries.get_or(key, default_val);
}

pub fn parse_mini_toml(content: str): TomlDoc {
	var doc = TomlDoc();
	val lines = content.split_lines();
	var current_section = "";

	for (line in lines) {
		val trimmed = line.trim();
		if (trimmed.empty() || trimmed.starts_with("#")) continue;

		if (
			trimmed.starts_with("[") &&
			trimmed.ends_with("]") &&
			trimmed.len >= 2
		) {
			current_section = trimmed.slice(1UZ, trimmed.len - 1UZ).trim();
			continue;
		}

		val eq_pos = trimmed.index_of("=");
		if (eq_pos > 0) {
			val key_raw = trimmed.slice(0, eq_pos).trim();
			val val_raw = trimmed.slice(eq_pos + 1, trimmed.len).trim();

			// Unquote string literals if surrounded by quotes
			var val_clean = val_raw;
			if (val_raw.len >= 2) {
				if (
					(val_raw.starts_with("\"") && val_raw.ends_with("\"")) ||
					(val_raw.starts_with("'") && val_raw.ends_with("'"))
				) val_clean = val_raw.slice(1, val_raw.len - 1);
			}

			val full_key = if (!current_section.empty()) "${current_section}.${key_raw}"
			else key_raw;

			doc.entries.put(full_key, val_clean);
		}
	}

	return doc;
}

pub struct ProjectConfig {
	pub name: str,
	pub version: str,
	pub entry: str,
	pub output: str,
	pub cc: str,
	pub test_dir: str
}

impl ProjectConfig {
	pub fn new(): Self => Self(
		"kobel",
		"1.0.0",
		"src/main.kb",
		"build/kobel.exe",
		"cl",
		"tests"
	);
}

pub fn load_project_config(manifest_path: str): ProjectConfig {
	var cfg = ProjectConfig();
	if (!file_exists(manifest_path)) return cfg;

	val content = read_file(manifest_path);
	if (content.empty()) return cfg;

	val doc = parse_mini_toml(content);

	val name = doc.get("package.name", "");
	if (!name.empty()) cfg.name = name;

	val ver = doc.get("package.version", "");
	if (!ver.empty()) cfg.version = ver;

	val entry = doc.get("package.entry", doc.get("build.entry", ""));
	if (!entry.empty()) cfg.entry = entry;

	val output = doc.get("build.output", "");
	if (!output.empty()) cfg.output = output;

	val cc = doc.get("build.cc", "");
	if (!cc.empty()) cfg.cc = cc;

	val test_dir = doc.get("test.dir", "");
	if (!test_dir.empty()) cfg.test_dir = test_dir;

	return cfg;
}
