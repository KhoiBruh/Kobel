mod config;

use std.io.*;
use std.filesystem.*;

// ============================================================================
// Mini-TOML Parser and Project Configuration
//
// Parses a lightweight subset of TOML sufficient for project manifests
// like `kobel.toml`:
//   [section]
//   key = "value"
//   key = value
// ============================================================================

pub struct ProjectConfig {
	pub name: str = "kobel",
	pub version: str = "1.0.0",
	pub entry: str = "src/main.kb",
	pub output: str = "build/kobel.exe",
	pub cc: str = "cl",
	pub test_dir: str = "tests"
}

impl ProjectConfig {

	pub fn load(manifest_path: str): ProjectConfig ! ConfigErr {
		var cfg = ProjectConfig();
		val manifest_p = Path(manifest_path);
		if (!manifest_p.exists()) return ConfigErr.ManifestNotFound;

		val content = manifest_p.read_text() !: return ConfigErr.ReadFailed;
		if (content.blank()) return ConfigErr.EmptyManifest;

		val doc = Toml.parse(content)?;

		var package_entry = "";
		var build_entry = "";
		for ((key, val_str) in doc) {
			if (val_str.empty()) continue;
			when (key) {
				"package.name" -> cfg.name = val_str;
				"package.version" -> cfg.version = val_str;
				"package.entry" -> package_entry = val_str;
				"build.entry" -> build_entry = val_str;
				"build.output" -> cfg.output = val_str;
				"build.cc" -> cfg.cc = val_str;
				"test.dir" -> cfg.test_dir = val_str;
			}
		}
		if (!package_entry.empty()) cfg.entry = package_entry;
		else if (!build_entry.empty()) cfg.entry = build_entry;

		return cfg;
	}

}
