mod config;

use std.traits.Iterable;
use std.collections.List;
use std.collections.HashMap;

pub struct Toml {
	pub entries: HashMap<str, str> = HashMap()
}

impl Toml {

	pub fn parse(content: str): Toml ! ConfigErr {
		var res = Toml();
		val lines = content.split_lines();
		defer lines.free();
		var current_section = "";

		for (line in lines) {
			val trimmed = line.trim();
			if (trimmed.empty() || trimmed.starts_with("#")) continue;

			if (trimmed.starts_with("[")) {
				if (!trimmed.ends_with("]") || trimmed.len < 3) return ConfigErr.MalformedHeader;
				current_section = trimmed.slice(1, trimmed.len - 1).trim();
				if (current_section.empty()) return ConfigErr.MalformedHeader;
				continue;
			}

			val eq_pos = trimmed.index_of("=") !: return ConfigErr.MalformedLine;
			val key_raw = trimmed.slice(0, eq_pos).trim();
			if (key_raw.empty()) return ConfigErr.EmptyKey;
			val val_raw = trimmed.slice(eq_pos + 1, trimmed.len).trim();

			// Unquote string literals if surrounded by matching quotes; reject stray opening quote.
			var val_clean = val_raw;
			if (!val_raw.empty() && val_raw[0] in ['"', '\'']) {
				val q = val_raw[0];
				if (val_raw.len < 2 || val_raw[val_raw.len - 1] != q) {
					return ConfigErr.UnterminatedString;
				}
				val_clean = val_raw.slice(1, val_raw.len - 1);
			}

			val full_key = if (!current_section.empty()) "${current_section}.${key_raw}"
			else key_raw;

			res.entries[full_key] = val_clean;
		}

		return res;
	}

	pub fn get(*self, key: str, default_val: str) => self.entries.get_or(key, default_val);

	pub fn try_get(*self, key: str): str ! ConfigErr {
		val p = self.entries[key] ?: return ConfigErr.KeyNotFound;
		return *p;
	}

	pub op set(&self, key: str, value: str) {
		self.entries[key] = value;
	}

	pub op contains(*self, key: str) => key in self.entries;

}

impl Iterable for Toml {

	pub fn count(*self) => self.entries.count();

	pub fn at(*self, i: usz) => self.entries.at(i);

}
