mod config;

use std.traits.Iterable;
use std.collections.List;
use std.collections.HashMap;

pub struct Toml {
	pub entries: HashMap<str, str> = HashMap()
}

impl Toml {

	pub init(content: str) {
		var self = Self();
		val lines = content.split_lines();
		var current_section = "";

		for (line in lines) {
			val trimmed = line.trim();
			if (trimmed.empty() || trimmed.starts_with("#")) continue;

			if (
				trimmed.starts_with("[") &&
				trimmed.ends_with("]") &&
				trimmed.len >= 2
			) {
				current_section = trimmed.slice(1, trimmed.len - 1).trim();
				continue;
			}

			val eq_pos = trimmed.index_of("=");
			if (eq_pos > 0) {
				val key_raw = trimmed.slice(0, eq_pos).trim();
				val val_raw = trimmed.slice(eq_pos + 1, trimmed.len).trim();

				// Unquote string literals if surrounded by quotes
				val val_clean = if (
					val_raw.len >= 2 &&
					val_raw[0] in ['"', '\''] &&
					val_raw[0] == val_raw[val_raw.len - 1]
				) val_raw.slice(1, val_raw.len - 1)
				else val_raw;

				val full_key = if (!current_section.empty()) "${current_section}.${key_raw}"
				else key_raw;

				self.entries[full_key] = val_clean;
			}
		}

		return self;
	}

	pub fn get(*self, key: str, default_val: str) => self.entries.get_or(key, default_val);

	pub op get(*self, key: str) => self.entries.get_or(key, "");

	pub op set(&self, key: str, value: str) {
		self.entries[key] = value;
	}

	pub op contains(*self, key: str) => key in self.entries;

}

impl Iterable for Toml {

	pub fn count(*self) => self.entries.count();

	pub fn at(*self, i: usz) => self.entries.at(i);

}
