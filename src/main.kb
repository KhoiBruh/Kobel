use std.io.*;
use std.collections.list.*;

use config.project.*;
use compiler.driver.pipeline.*;
use compiler.driver.commands.*;
use util.strutil.*;
use fmt.options.*;
use fmt.formatter.*;
use lsp.server.*;

fn print_usage() {
	println("============================================================");
	println("  Kobel Compiler v1.0.0 (Self-Hosted compiler C99 Backend)  ");
	println("============================================================");
	println("Usage: kobel <command> [args]");
	println("");
	println("Commands:");
	println("  build             Build project (kobel.toml)");
	println("  run [args...]     Run project (rebuilds if changed)");
	println("  test [filter]     Run test suite");
	println("  emit-c [file]     Emit generated C99 source (default: dist/bootstrap.c)");
	println("  fmt [-w] <files>  Format Kobel source code");
	println("  lsp               Start Language Server Protocol server");
	println("  version           Display compiler version");
}

fn run_build(): i32 => cmd_build("kobel.toml");

fn run_project(argc: i32, argv: &*char): i32 {
	val extra_args = List<str>();
	var i = 2;
	while (i < argc) {
		extra_args.add(cstr_to_str(argv[i]));
		i++;
	}
	return cmd_run("kobel.toml", extra_args);
}

fn run_test_suite(argc: i32, argv: &*char): i32 {
	val filter = if (argc >= 3) cstr_to_str(argv[2]) else "";
	return cmd_test("kobel.toml", filter);
}

fn run_emit_c(argc: i32, argv: &*char): i32 {
	val cfg = if (file_exists("kobel.toml")) load_project_config("kobel.toml") else ProjectConfig();
	val out_path = if (argc >= 3) cstr_to_str(argv[2]) else "dist/bootstrap.c";

	val opts = CompileOptions();
	opts.input_path = cfg.entry;
	opts.emit_c_path = out_path;
	opts.only_emit_c = true;
	return compile_pipeline(opts);
}

fn run_fmt(argc: i32, argv: &*char): i32 {
	if (argc < 3) {
		println("Usage: kobel fmt [-w] <files...>");
		return 1;
	}

	var write_in_place = false;
	val files = List<str>();

	var i = 2;
	while (i < argc) {
		val arg = cstr_to_str(argv[i]);
		when (arg) {
			"-w", "--write" -> write_in_place = true;
			"-h", "--help" -> {
				println("Usage: kobel fmt [-w] <files...>");
				return 0;
			}
			else -> files.add(arg);
		}
		i++;
	}

	if (files.len == 0) {
		println("Error: No files specified to format");
		return 1;
	}

	val options = FormatOptions();
	for (fpath in files) {
		val src = read_file(fpath);
		if (src.len == 0) continue;

		val formatted = format_source(src, options);
		if (write_in_place) {
			val ok = write_file(fpath, formatted);
			if (!ok) {
				print("Error: Failed to write to ");
				println(fpath);
				return 1;
			}
			print("Formatted: ");
			println(fpath);
		} else print(formatted);
	}

	return 0;
}

fn run_compiler(argc: i32, argv: &*char): i32 {
	val opts = CompileOptions();

	var i = 1;
	while (i < argc) {
		val arg = cstr_to_str(argv[i]);
		when (arg) {
			"-o" -> {
				i++;
				if (i < argc) opts.output_bin = cstr_to_str(argv[i]);
			}
			"-emit-c" -> {
				i++;
				if (i < argc) {
					opts.emit_c_path = cstr_to_str(argv[i]);
					opts.only_emit_c = true;
				}
			}
			else -> {
				if (arg.len > 0 && arg[0] != '-') {
					opts.input_path = arg;
				}
			}
		}
		i++;
	}

	if (opts.input_path.len == 0) {
		print_usage();
		return 1;
	}

	return compile_pipeline(opts);
}

fn print_version(): i32 {
	println("Kobel Compiler v1.0.0 (Self-Hosted compiler C99 Backend)");
	return 0;
}

fn print_help(): i32 {
	print_usage();
	return 0;
}

fn main(argc: i32, argv: &*char): i32 {
	if (argc < 2) {
		print_usage();
		return 0;
	}

	val first_arg = cstr_to_str(argv[1]);
	return when (first_arg) {
		"build" -> run_build();
		"run" -> run_project(argc, argv);
		"test" -> run_test_suite(argc, argv);
		"emit-c" -> run_emit_c(argc, argv);
		"fmt" -> run_fmt(argc, argv);
		"lsp" -> run_server();
		"version", "-v", "--version" -> print_version();
		"help", "-h", "--help" -> print_help();
		else -> run_compiler(argc, argv);
	};
}
