use std.io.*;
use std.sys.exec;
use std.collections.list.*;

use compiler.sema.decl_pass.*;
use compiler.sema.decl_collect.*;
use compiler.sema.body_pass.*;
use compiler.sema.body_program.*;

use compiler.codegen.c_codegen.*;
use compiler.codegen.c_program.*;

use compiler.loader.loader.*;

use compiler.lexer.token.usz_to_str;
use compiler.util.strutil.str_dir_of;

// ============================================================================
// Libc and Memory Utilities
// ============================================================================

extern "libc" {
	fn strlen(s: *char): usz;
	fn malloc(size: usz): &u8;
	fn free(ptr: &u8): none;
}

struct StringRaw {
	pub data: *char,
	pub len: usz,
	pub cap: usz
}

fn cstr_to_str(s: *char): str {
	val len: usz = strlen(s);
	val raw_mem = malloc(24);
	val r = raw_mem as &StringRaw;
	r.data = s;
	r.len = len;
	r.cap = len;
	val sp: *str = r as *str;
	val res: str = *sp;
	free(raw_mem);
	return res;
}

fn get_stem(path: str): str {
	val len = path.len;
	if (len > 3 && path[len - 3] == '.' && path[len - 2] == 'k' && path[len - 1] == 'b') {
		val new_len = len - 3;
		val buf = malloc(new_len + 1);
		var j: usz = 0;
		while (j < new_len) {
			buf[j] = path[j] as u8;
			j = j + 1;
		}
		buf[new_len] = 0;
		val raw_mem = malloc(24);
		val r = raw_mem as &StringRaw;
		r.data = buf as *char;
		r.len = new_len;
		r.cap = new_len + 1;
		val sp: *str = r as *str;
		val res: str = *sp;
		free(raw_mem);
		return res;
	}
	return path;
}

fn print_usage() {
	println("============================================================");
	println("  Kobel Compiler v1.0.0 (Self-Hosted compiler C99 Backend)  ");
	println("============================================================");
	println("Usage: kobel [options] <source.kb>");
	println("");
	println("Options:");
	println("  -o <file>        Specify output executable binary name");
	println("  -emit-c <file>   Emit generated C99 source code and exit");
	println("  --cc <compiler>  Specify backend C compiler (default: cl)");
	println("  -I <dir>         Add directory to module search path");
	println("  -v, --version    Display compiler version");
	println("  -h, --help       Display this help message");
}

fn print_error_list(errors: List<str>) {
	var e: usz = 0;
	while (e < errors.len) {
		print("  [ERROR] ");
		println(errors.get(e));
		e = e + 1;
	}
}

// ============================================================================
// Main Entry Point
// ============================================================================

fn main(argc: i32, argv: &*char): i32 {
	if (argc < 2) {
		print_usage();
		return 1;
	}

	var input_path = "";
	var output_bin = "";
	var emit_c_path = "";
	var c_compiler = "cl";
	var only_emit_c = false;
	var extra_roots = new_list<str>();

	var i: i32 = 1;
	while (i < argc) {
		val arg = cstr_to_str(argv[i]);
		if (arg == "-h" || arg == "--help") {
			print_usage();
			return 0;
		}
		if (arg == "-v" || arg == "--version") {
			println("Kobel Compiler v1.0.0 (Self-Hosted compiler C99 Backend)");
			return 0;
		}
		if (arg == "-o") {
			i = i + 1;
			if (i < argc) {
				output_bin = cstr_to_str(argv[i]);
			} else {
				println("Error: Missing argument after '-o'");
				return 1;
			}
		} else if (arg == "-emit-c") {
			i = i + 1;
			if (i < argc) {
				emit_c_path = cstr_to_str(argv[i]);
				only_emit_c = true;
			} else {
				println("Error: Missing argument after '-emit-c'");
				return 1;
			}
		} else if (arg == "--cc") {
			i = i + 1;
			if (i < argc) {
				c_compiler = cstr_to_str(argv[i]);
			} else {
				println("Error: Missing argument after '--cc'");
				return 1;
			}
		} else if (arg == "-I") {
			i = i + 1;
			if (i < argc) {
				extra_roots.add(cstr_to_str(argv[i]));
			} else {
				println("Error: Missing argument after '-I'");
				return 1;
			}
		} else if (arg.len > 0 && arg[0] == '-') {
			print("Error: Unknown option '");
			print(arg);
			println("'");
			return 1;
		} else input_path = arg;
		i = i + 1;
	}

	if (input_path.len == 0) {
		println("Error: No input file specified");
		return 1;
	}

	// 1. Read source
	val src = read_file(input_path);
	if (src.len == 0) {
		print("Error: Could not read source file or file is empty: ");
		println(input_path);
		return 1;
	}

	println("[1/4] Loading modules (lex + parse)...");
	var loader = new_module_loader(str_dir_of(input_path), extra_roots);
	val prog = load_program(&loader, input_path, src);
	if (loader.errors.len > 0) {
		print("Module Errors in ");
		print(input_path);
		println(":");
		print_error_list(loader.errors);
		return 1;
	}
	if (prog == null) {
		print("Error: Could not parse source file: ");
		println(input_path);
		return 1;
	}
	print("  ");
	print(usz_to_str(loaded_module_count(&loader)));
	println(" module(s) loaded");

	println("[2/4] Semantic analysis (declarations)...");
	var decl_p = new_decl_pass();
	collect_program(&decl_p, prog);
	if (decl_p.errors.len > 0) {
		print("Semantic Declaration Errors in ");
		print(input_path);
		println(":");
		print_error_list(decl_p.errors);
		return 1;
	}

	println("[3/4] Semantic analysis (bodies)...");
	var body_p = new_body_pass_with_symtab(decl_p.symtab);
	check_program(&body_p, prog);
	if (body_p.errors.len > 0) {
		print("Semantic Type Errors in ");
		print(input_path);
		println(":");
		print_error_list(body_p.errors);
		return 1;
	}

	println("[4/4] Generating C99 code...");
	var codegen = new_c_codegen();
	val c_code = gen_program(&codegen, prog);

	if (only_emit_c) {
		val ok = write_file(emit_c_path, c_code);
		if (!ok) {
			print("Error: Failed to write output file: ");
			println(emit_c_path);
			return 1;
		}
		print("[SUCCESS] C99 source written to ");
		println(emit_c_path);
		return 0;
	}

	// Native binary compilation
	var out_path = output_bin;
	if (out_path.len == 0) out_path = get_stem(input_path) + ".exe";

	val c_tmp_path = get_stem(input_path) + ".tmp.c";
	val write_ok = write_file(c_tmp_path, c_code);
	if (!write_ok) {
		print("Error: Failed to write temporary C file: ");
		println(c_tmp_path);
		return 1;
	}

	print("[BUILDING] Invoking backend compiler (");
	print(c_compiler);
	println(")...");

	var compile_cmd = "";
	if (c_compiler == "clang" || c_compiler == "gcc") {
		compile_cmd = c_compiler + " -O2 -o \"" + out_path + "\" \"" + c_tmp_path + "\"";
	} else {
		// MSVC cl.exe: ensure environment is set up if not already in PATH
		compile_cmd = "where cl >nul 2>nul || (if exist \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" (call \"C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul 2>nul) else (call \"C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\VC\\Auxiliary\\Build\\vcvars64.bat\" >nul 2>nul)) & cl.exe /nologo /O2 /Fe:\"" + out_path + "\" \"" + c_tmp_path + "\"";
	}

	val exit_code = exec(compile_cmd);
	if (exit_code != 0) {
		print("Error: Backend C compiler failed with error code ");
		println("1");
		return exit_code;
	}

	// Clean up temporary C file
	val del_c = "del \"" + c_tmp_path + "\" 2>nul";
	exec(del_c);

	print("[SUCCESS] Executable created: ");
	println(out_path);
	return 0;
}