{
  "name": "kobel",
  "displayName": "Kobel Language Support",
  "description": "Rich Kobel language support: LSP diagnostics, hover, go-to-definition, cross-file references & rename, code actions, signature help, highlights, workspace symbols, formatting, and autocompletion",
  "version": "0.2.0",
  "publisher": "kobel-lang",
  "engines": {
    "vscode": "^1.70.0"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:kobel"
  ],
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "contributes": {
    "languages": [
      {
        "id": "kobel",
        "aliases": [
          "Kobel",
          "kobel"
        ],
        "extensions": [
          ".kb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "kobel",
        "scopeName": "source.kobel",
        "path": "./Syntaxes/Kobel.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "kobel.format",
        "title": "Kobel: Format Document"
      },
      {
        "command": "kobel.restartServer",
        "title": "Kobel: Restart Language Server"
      }
    ],
    "keybindings": [
      {
        "command": "kobel.format",
        "key": "shift+alt+f",
        "when": "editorTextFocus && editorLangId == kobel"
      }
    ],
    "configuration": {
      "title": "Kobel",
      "properties": {
        "kobel.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Absolute or workspace-relative path to the Kobel compiler executable (e.g. build/kobel.exe). When empty, auto-detects build/kobel.exe, build/seed/kobel_seed.exe, kobel_v1.exe, kobel.exe, or 'kobel' on PATH."
        }
      }
    }
  }
}
