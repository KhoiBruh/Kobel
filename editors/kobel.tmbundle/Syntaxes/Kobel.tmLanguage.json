{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Kobel",
  "scopeName": "source.kobel",
  "fileTypes": ["kb", "kobel"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#characters" },
    { "include": "#attributes" },
    { "include": "#enums" },
    { "include": "#enum-access" },
    { "include": "#member-access" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#special-types" },
    { "include": "#generics" },
    { "include": "#function-calls" },
    { "include": "#types" },
    { "include": "#numbers" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kobel",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kobel",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.kobel",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-interpolation" }
          ]
        },
        {
          "name": "string.quoted.double.kobel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "include": "#string-escapes" },
            { "include": "#string-interpolation" }
          ]
        }
      ]
    },
    "string-escapes": {
      "patterns": [
        {
          "name": "constant.character.escape.kobel",
          "match": "\\\\(?:[\\\\\"'nrt0$]|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4})"
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.template.expression.kobel",
          "begin": "\\$\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.template-expression.begin.kobel" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.definition.template-expression.end.kobel" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "characters": {
      "patterns": [
        {
          "name": "string.quoted.single.kobel",
          "match": "'(?:\\\\[\\\\\"'nrt0]|\\\\x[0-9a-fA-F]{2}|[^'\\\\])'"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.kobel",
          "match": "@(?:operator|infix|[a-zA-Z_][a-zA-Z0-9_]*)"
        }
      ]
    },
    "enums": {
      "patterns": [
        {
          "name": "meta.enum.kobel",
          "begin": "(?:\\b(pub)\\s+)?\\b(enum)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(:)\\s*([a-zA-Z_][a-zA-Z0-9_]*))?\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.modifier.kobel" },
            "2": { "name": "keyword.declaration.enum.kobel" },
            "3": { "name": "entity.name.type.enum.kobel" },
            "4": { "name": "punctuation.separator.kobel" },
            "5": { "name": "support.type.kobel entity.name.class.kobel" },
            "6": { "name": "punctuation.section.block.begin.kobel" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.kobel" }
          },
          "patterns": [
            { "include": "#comments" },
            { "include": "#numbers" },
            {
              "name": "constant.other.enum.kobel",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b(?=\\s*(?:\\(|=|,|\\}|//|/\\*|$))"
            },
            { "include": "$self" }
          ]
        }
      ]
    },
    "enum-access": {
      "patterns": [
        {
          "match": "\\b([A-Z][a-zA-Z0-9_]*)\\s*(\\.)\\s*([A-Z][A-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "entity.name.type.kobel" },
            "2": { "name": "punctuation.accessor.kobel" },
            "3": { "name": "constant.other.enum.kobel" }
          }
        },
        {
          "name": "constant.other.caps.kobel",
          "match": "\\b[A-Z][A-Z0-9_]{1,}\\b"
        }
      ]
    },
    "member-access": {
      "patterns": [
        {
          "match": "\\b(self)\\s*(\\??\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "variable.language.self.kobel" },
            "2": { "name": "punctuation.accessor.kobel" },
            "3": { "name": "entity.name.function.member.kobel" }
          }
        },
        {
          "match": "\\b(self)\\s*(\\??\\.)\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "variable.language.self.kobel" },
            "2": { "name": "punctuation.accessor.kobel" },
            "3": { "name": "variable.other.property.kobel" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|op)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.kobel" },
            "2": { "name": "entity.name.function.kobel" }
          }
        },
        {
          "match": "\\b(init)\\b(?=\\s*\\()",
          "captures": {
            "1": { "name": "keyword.declaration.init.kobel" }
          }
        },
        {
          "match": "\\b(struct|trait)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.kobel" },
            "2": { "name": "entity.name.type.kobel" }
          }
        },
        {
          "match": "\\b(mod)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.module.kobel" },
            "2": { "name": "entity.name.namespace.kobel" }
          }
        },
        {
          "match": "\\b(use)\\s+([a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*(?:\\.\\*)?)",
          "captures": {
            "1": { "name": "keyword.control.import.kobel" },
            "2": { "name": "entity.name.namespace.kobel" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kobel",
          "match": "\\b(if|else|when|for|in|while|loop|break|continue|return|yield|defer)\\b"
        },
        {
          "name": "keyword.declaration.kobel",
          "match": "\\b(val|var|const|pub|extern|fn|op|init|impl|struct|enum|trait|mod|use|type|fault|alias)\\b"
        },
        {
          "name": "keyword.operator.word.kobel",
          "match": "\\b(as\\?|as|is)\\b"
        },
        {
          "name": "constant.language.kobel",
          "match": "\\b(null|true|false)\\b"
        },
        {
          "name": "variable.language.self.kobel",
          "match": "\\b(self)\\b"
        }
      ]
    },
    "special-types": {
      "patterns": [
        {
          "name": "support.type.builtin.kobel",
          "match": "\\b(Self|List|Iterable|Stringer|Iterator|Range|StringBuilder|Arena)\\b"
        }
      ]
    },
    "generics": {
      "patterns": [
        {
          "begin": "(?<=[a-zA-Z0-9_])<(?=[a-zA-Z0-9_&*,\\s<>\\[\\]]+>)",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.begin.kobel" }
          },
          "end": ">",
          "endCaptures": {
            "0": { "name": "punctuation.definition.typeparameters.end.kobel" }
          },
          "patterns": [
            { "include": "#primitive-types" },
            { "include": "#special-types" },
            { "include": "#generics" },
            {
              "name": "entity.name.type.parameter.kobel",
              "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
            },
            {
              "name": "punctuation.separator.kobel",
              "match": "[,&*?]"
            }
          ]
        },
        {
          "name": "entity.name.type.parameter.kobel",
          "match": "\\b[A-Z]\\b"
        }
      ]
    },
    "primitive-types": {
      "patterns": [
        {
          "name": "support.type.primitive.kobel",
          "match": "\\b(i8|i16|i32|i64|isz|u8|u16|u32|u64|usz|f16|f32|f64|bool|char|str|none)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        { "include": "#primitive-types" },
        {
          "name": "support.class.kobel",
          "match": "\\b(Array|Slice|Map|HashMap|HashSet|Pair|Option|Result)\\b"
        },
        {
          "name": "entity.name.type.kobel",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kobel",
          "match": "\\b0[xX][0-9a-fA-F_]+(?:_?(?:US|UL|UB|UZ|U|S|L|B|Z))?\\b"
        },
        {
          "name": "constant.numeric.binary.kobel",
          "match": "\\b0[bB][01_]+(?:_?(?:US|UL|UB|UZ|U|S|L|B|Z))?\\b"
        },
        {
          "name": "constant.numeric.octal.kobel",
          "match": "\\b0[oO][0-7_]+(?:_?(?:US|UL|UB|UZ|U|S|L|B|Z))?\\b"
        },
        {
          "name": "constant.numeric.float.kobel",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?(?:[FD])?\\b"
        },
        {
          "name": "constant.numeric.integer.kobel",
          "match": "\\b[0-9][0-9_]*(?:_?(?:US|UL|UB|UZ|U|S|L|B|Z|F|D))?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.kobel",
          "match": "(=>|->)"
        },
        {
          "name": "keyword.operator.range.kobel",
          "match": "(\\.\\.<|\\.\\.)"
        },
        {
          "name": "keyword.operator.null-safety.kobel",
          "match": "(\\?\\.|\\?:|!:)"
        },
        {
          "name": "keyword.operator.comparison.kobel",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.kobel",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.assignment.kobel",
          "match": "(\\+=|-=|\\*=|/=|%=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.kobel",
          "match": "(\\+\\+|--|\\+|-|\\*|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.kobel",
          "match": "(&|\\||\\^|~|<<|>>|\\?)"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.kobel",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*(?:<[^>]+>)?\\s*\\()"
        }
      ]
    }
  }
}
